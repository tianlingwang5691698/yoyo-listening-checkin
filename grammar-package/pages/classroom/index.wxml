<view class="theme-{{theme}} language-{{language}} classroom-page">
  <grammar-word-loader wx:if="{{loaderKind === 'word'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-pronoun-loader wx:if="{{loaderKind === 'pronoun'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-word-formation-loader wx:if="{{loaderKind === 'word-formation'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-verb-loader wx:if="{{loaderKind === 'verb'}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-numeral-loader wx:if="{{loaderKind === 'numeral'}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-article-loader wx:if="{{loaderKind === 'article'}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-adjective-loader wx:if="{{loaderKind === 'adjective'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-adverb-loader wx:if="{{loaderKind === 'adverb'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-relation-loader wx:if="{{loaderKind === 'relation'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-sentence-elements-loader wx:if="{{loaderKind === 'sentence-elements'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-basic-patterns-loader wx:if="{{loaderKind === 'basic-patterns'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-predicate-system-loader wx:if="{{loaderKind === 'predicate-system'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-nonfinite-system-loader wx:if="{{loaderKind === 'nonfinite-system'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-special-structures-loader wx:if="{{loaderKind === 'special-structures'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-coordination-loader wx:if="{{loaderKind === 'coordination'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-noun-clauses-loader wx:if="{{loaderKind === 'noun-clauses'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-relative-clauses-loader wx:if="{{loaderKind === 'relative-clauses'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-adverbial-clauses-loader wx:if="{{loaderKind === 'adverbial-clauses'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-reported-speech-loader wx:if="{{loaderKind === 'reported-speech'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-cohesion-reference-loader wx:if="{{loaderKind === 'cohesion-reference'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-information-order-loader wx:if="{{loaderKind === 'information-order'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-punctuation-loader wx:if="{{loaderKind === 'punctuation'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />
  <grammar-common-expression-loader wx:if="{{loaderKind === 'common-expression'}}" topic="{{selectedTopic}}" language="{{language}}" bindloaded="onCourseLoaded" bindloaderror="onCourseLoadError" />

  <view class="page-topbar">
    <view class="topbar-back" bindtap="handleTopBack"><text class="topbar-chevron">‹</text><text class="topbar-back-text">{{ui.back}}</text></view>
    <view class="topbar-title">{{language === 'en' ? 'Grammar Classroom' : '语法课堂'}}</view>
    <view class="topbar-space"></view>
  </view>

  <view class="debug-card" wx:if="{{debugMessage}}">
    <view>{{debugMessage}}</view>
    <view class="debug-back" bindtap="handleTopBack">{{ui.loadError}} · {{ui.back}}</view>
  </view>

  <view class="classroom-shell">
    <view class="hero-card" wx:if="{{screen === 'system'}}">
      <view class="hero-eyebrow">{{ui.eyebrow}}</view>
      <view class="hero-title">{{ui.title}}</view>
      <view class="hero-copy">{{ui.copy}}</view>
      <view class="syntax-demo">
        <view class="syntax-chip role-subject"><text>{{language === 'en' ? 'Subject' : '主语'}}</text><text>S</text></view>
        <view class="syntax-chip role-predicate"><text>{{language === 'en' ? 'Verb' : '谓语'}}</text><text>V</text></view>
        <view class="syntax-chip role-object"><text>{{language === 'en' ? 'Object' : '宾语'}}</text><text>O</text></view>
      </view>
    </view>

    <view class="content-card" wx:if="{{screen === 'system'}}">
      <view class="section-kicker">{{ui.systemTitle}}</view>
      <view class="section-title">{{ui.systemCopy}}</view>
      <view class="domain-grid">
        <view class="domain-item" wx:for="{{ui.domains}}" wx:key="id" data-domain="{{item.id}}" bindtap="selectDomain">
          <view class="domain-code">{{item.code}}</view>
          <view class="topic-main">
            <view class="topic-title">{{item.title}}</view>
            <view class="topic-meta">{{item.meta}}</view>
          </view>
          <view class="row-arrow">›</view>
        </view>
      </view>
    </view>

    <view class="content-card" wx:elif="{{screen === 'domain-map'}}">
      <view class="inline-back" bindtap="backToSystem">{{ui.backSystem}}</view>
      <view class="section-kicker">{{domainTitle}}</view>
      <view class="section-title">{{domainCopy}}</view>
      <view class="domain-course-list">
        <view class="domain-course-item {{item.ready ? 'is-ready' : 'is-planned'}}" wx:for="{{domainItems}}" wx:key="id" data-item="{{item.id}}" bindtap="selectDomainItem">
          <view class="topic-main">
            <view class="topic-title">{{item.title}}</view>
            <view class="topic-meta">{{item.meta}}</view>
            <view class="topic-count">{{item.status}}</view>
          </view>
          <view class="row-arrow" wx:if="{{item.ready}}">›</view>
        </view>
      </view>
    </view>

    <view class="content-card" wx:elif="{{screen === 'directory'}}">
      <view class="inline-back" bindtap="backToDomainMap">{{ui.backMorphology}}</view>
      <view class="section-kicker">{{ui.directory}}</view>
      <view class="section-title">{{ui.directoryCopy}}</view>
      <view class="topic-grid">
        <view class="topic-item" wx:for="{{ui.topics}}" wx:key="id" data-topic="{{item.id}}" bindtap="selectTopic">
          <view class="topic-main">
            <view class="topic-title">{{item.title}}</view>
            <view class="topic-meta">{{item.meta}}</view>
            <view class="topic-count">{{item.countText}}</view>
          </view>
          <view class="row-arrow">›</view>
        </view>
      </view>
    </view>

    <view class="content-card" wx:elif="{{screen === 'section-map'}}">
      <view class="inline-back" bindtap="backFromSectionMap">{{selectedDomain !== 'morphology' ? domainBackText : (selectedTopic === 'word-formation' ? ui.backMorphology : ui.backDirectory)}}</view>
      <view class="section-kicker">{{courseTitle}}</view>
      <view class="section-title">{{courseCopy}}</view>
      <view class="section-map-list">
        <view class="section-map-item" wx:for="{{sections}}" wx:key="id" data-section="{{item.id}}" bindtap="openSection">
          <view class="section-map-no">{{item.no}}</view>
          <view class="topic-main">
            <view class="topic-title">{{item.title}}</view>
            <view class="topic-meta">{{item.copy}}</view>
            <view class="section-map-meta">{{item.countText}} · {{item.levelText}}</view>
          </view>
          <view class="row-arrow">›</view>
        </view>
      </view>
    </view>

    <view class="content-card" wx:elif="{{screen === 'course-map'}}">
      <view class="inline-back" bindtap="backFromCourseMap">{{hasSectionMap ? ui.backSections : (selectedDomain !== 'morphology' ? domainBackText : (selectedTopic === 'word-formation' ? ui.backMorphology : ui.backDirectory))}}</view>
      <view class="section-kicker">{{activeSectionTitle || courseTitle}}</view>
      <view class="section-title">{{activeSectionCopy || courseCopy}}</view>
      <view class="course-group" wx:for="{{groups}}" wx:key="id" wx:for-item="group">
        <view class="course-group-title">{{group.title}}</view>
        <view class="course-group-copy">{{group.copy}}</view>
        <view class="lesson-row" wx:for="{{group.lessons}}" wx:key="id" wx:for-item="lesson" data-lesson="{{lesson.id}}" bindtap="openLesson">
          <view class="lesson-no">{{lesson.no}}</view>
          <view class="topic-main">
            <view class="topic-title">{{lesson.title}}</view>
            <view class="topic-meta">{{lesson.meta}}</view>
            <view class="lesson-level level-{{lesson.level}}">{{lesson.level === 'advanced' ? ui.advancedLevel : ui.coreLevel}}</view>
          </view>
          <view class="row-arrow">›</view>
        </view>
      </view>
    </view>

    <view class="content-card lesson-card" wx:elif="{{screen === 'lesson' && activeLesson}}">
      <view class="inline-back" bindtap="backToCourseMap">{{ui.backCourse}}</view>
      <view class="lesson-progress">{{lessonPosition}} / {{course.length}}</view>
      <view class="lesson-title">{{activeLesson.title}}</view>
      <view class="lesson-meta">{{activeLesson.meta}}</view>

      <view class="sentence-list" wx:if="{{activeLesson.analyses && activeLesson.analyses.length}}">
        <view class="sentence-card" wx:for="{{activeLesson.analyses}}" wx:key="index" wx:for-item="sentence" wx:for-index="sentenceIndex">
          <view class="sentence-parts">
            <view class="sentence-part role-{{part.role}}" wx:for="{{sentence}}" wx:key="text" wx:for-item="part">
              <view class="part-text">{{part.text}}</view>
              <view class="part-label">{{part.label}}</view>
            </view>
          </view>
          <view class="sentence-note mode-{{activeLesson.exampleNotes[sentenceIndex].mode}}" wx:if="{{activeLesson.exampleNotes && activeLesson.exampleNotes[sentenceIndex] && activeLesson.exampleNotes[sentenceIndex].visible}}">
            <view class="note-title" wx:if="{{activeLesson.exampleNotes[sentenceIndex].title}}">{{activeLesson.exampleNotes[sentenceIndex].title}}</view>
            <view class="note-body">{{activeLesson.exampleNotes[sentenceIndex].body}}</view>
            <view class="note-detail" wx:if="{{activeLesson.exampleNotes[sentenceIndex].detail}}">{{activeLesson.exampleNotes[sentenceIndex].detail}}</view>
          </view>
        </view>
      </view>
      <view class="plain-example-list" wx:else>
        <view class="sentence-card" wx:for="{{activeLesson.examples}}" wx:key="index" wx:for-index="exampleIndex">
          <view class="plain-example">{{item}}</view>
          <view class="sentence-note mode-{{activeLesson.exampleNotes[exampleIndex].mode}}" wx:if="{{activeLesson.exampleNotes && activeLesson.exampleNotes[exampleIndex] && activeLesson.exampleNotes[exampleIndex].visible}}">
            <view class="note-title" wx:if="{{activeLesson.exampleNotes[exampleIndex].title}}">{{activeLesson.exampleNotes[exampleIndex].title}}</view>
            <view class="note-body">{{activeLesson.exampleNotes[exampleIndex].body}}</view>
            <view class="note-detail" wx:if="{{activeLesson.exampleNotes[exampleIndex].detail}}">{{activeLesson.exampleNotes[exampleIndex].detail}}</view>
          </view>
        </view>
      </view>

      <view class="rule-card" wx:if="{{!activeLesson.hideRuleCard}}">
        <view class="rule-label">{{ui.core}}</view>
        <view class="rule-line" wx:for="{{activeLesson.rules}}" wx:key="index">{{index + 1}}. {{item}}</view>
      </view>

      <view class="exercise-count">{{questionIndex + 1}} / {{activeLesson.questions.length}}</view>
      <view class="question-text">{{activeQuestion.question}}</view>
      <view class="option-list">
        <view class="option-item {{answer && option.key === activeQuestion.answer ? 'is-correct' : ''}} {{answer === option.key && result === 'wrong' ? 'is-wrong' : ''}}" wx:for="{{activeQuestion.options}}" wx:key="key" wx:for-item="option" data-answer="{{option.key}}" bindtap="chooseAnswer">
          <text class="option-key">{{option.key}}</text><text>{{option.text}}</text>
        </view>
      </view>
      <view class="feedback {{result}}" wx:if="{{result}}">
        <view>{{result === 'correct' ? activeQuestion.correct : activeQuestion.wrong}}</view>
        <view class="retry" wx:if="{{result === 'wrong'}}" bindtap="retry">{{ui.retry}}</view>
      </view>
      <view class="footer-actions">
        <view class="footer-button back-button" bindtap="backToCourseMap">{{ui.back}}</view>
        <view class="footer-button next-button {{result === 'correct' ? '' : 'is-disabled'}}" bindtap="continueLesson">{{result === 'correct' ? (!isLastQuestion ? ui.nextQuestion : (isLastLesson ? ui.finish : ui.nextLesson)) : ui.answerFirst}}</view>
      </view>
    </view>
  </view>
</view>
