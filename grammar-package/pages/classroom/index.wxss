.narration-button, .narration-control { width: 100%; min-width: 0; min-height: 68rpx; margin: 0; padding: 0 8rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border: 0; font-size: 23rpx; font-weight: 720; line-height: 1.2; white-space: nowrap; }
.narration-button { gap: 8rpx; border-radius: 34rpx; background: var(--accent); color: #fff; }
.narration-control { overflow: hidden; gap: 2rpx; border: 1rpx solid var(--line); border-radius: 34rpx; background: rgba(255,255,255,.9); box-shadow: 0 4rpx 12rpx rgba(47,103,136,.08); color: var(--accent); text-align: center; }
