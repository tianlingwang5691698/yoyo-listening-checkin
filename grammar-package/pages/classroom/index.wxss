.footer-button { min-height: 86rpx; padding: 0 16rpx; display: flex; align-items: center; justify-content: center; border-radius: 17rpx; text-align: center; font-size: 25rpx; font-weight: 700; }
.back-button { border: 1rpx solid var(--line); background: rgba(255,255,255,.9); color: var(--muted); }
.next-button { background: var(--accent); color: #fff; }
