.role-attribute .part-label, .role-modifier .part-label, .role-appositive .part-label, .role-apposition .part-label, .role-clause .part-label, .role-dependent .part-label, .role-nounClause .part-label, .role-nonfinite .part-label, .role-infinitive .part-label, .role-gerund .part-label, .role-presentParticiple .part-label, .role-pastParticiple .part-label, .role-focus .part-label, .role-parenthetical .part-label, .role-quote .part-label, .role-reported .part-label, .role-title .part-label, .role-sentence .part-label { color: #715b88; }
