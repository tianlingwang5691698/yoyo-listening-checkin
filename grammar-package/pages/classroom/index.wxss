.debug-card { margin: 10rpx 24rpx; padding: 18rpx; border: 2rpx solid #d87a70; border-radius: 14rpx; background: #fff0ed; color: #923e36; font-size: 22rpx; line-height: 1.45; word-break: break-all; }
.debug-back { margin-top: 10rpx; font-weight: 750; }

.theme-library { --bg: #f7f0e2; --card: #fffaf0; --line: #d8c8aa; --ink: #2f302b; --muted: #655e52; --accent: #876a3c; --soft: #f1e5ce; background-image: linear-gradient(rgba(121,91,46,.025) 1rpx, transparent 1rpx); background-size: 100% 34rpx; }
