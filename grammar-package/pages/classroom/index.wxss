page { background: #f4fafc; }
.classroom-page { --bg: #f4fafc; --card: rgba(255,255,255,.84); --line: #d8e8ef; --ink: #17344b; --muted: #5a7282; --accent: #2f6788; --soft: #edf6fa; min-height: 100vh; padding-bottom: 44rpx; background: var(--bg); color: var(--ink); box-sizing: border-box; }
