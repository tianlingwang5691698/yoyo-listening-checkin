.role-coordinand .part-label, .role-independent .part-label, .role-item .part-label, .role-keyword .part-label, .role-lexical .part-label, .role-substitute .part-label, .role-word .part-label { color: #356b72; }
.sentence-note { margin-top: 16rpx; padding: 14rpx 16rpx; border-left: 5rpx solid #8e7aae; background: rgba(245,242,250,.76); }
.sentence-note.mode-spelling { border-left-color: #6c9b7b; }
.sentence-note.mode-sound { border-left-color: #5d8bb1; }
.sentence-note.mode-structure { border-left-color: #b18c46; }
.note-title { font-size: 23rpx; font-weight: 720; }
.note-body, .note-detail { margin-top: 6rpx; color: var(--ink); font-size: 26rpx; line-height: 1.65; font-weight: 520; }
.rule-card { margin-top: 20rpx; padding: 20rpx; border-left: 5rpx solid #75a89d; background: rgba(226,239,235,.72); border-radius: 4rpx 16rpx 16rpx 4rpx; }
.rule-label { margin-bottom: 10rpx; color: #527b72; font-size: 23rpx; font-weight: 750; }
.rule-line { font-size: 26rpx; line-height: 1.65; }
