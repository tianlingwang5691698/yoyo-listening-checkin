<view class="custom-tabbar theme-{{theme}}">
  <block wx:for="{{list}}" wx:key="pagePath">
    <view class="tabbar-item {{selected === index ? 'is-active' : ''}}" data-index="{{index}}" bindtap="switchTab">
      <view class="tabbar-icon">{{item.icon}}</view>
      <view class="tabbar-text">{{item.text}}</view>
    </view>
  </block>
</view>
