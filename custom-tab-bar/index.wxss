@import "../styles/theme-current.wxss";

.custom-tabbar {
  position: fixed;
  left: 56rpx;
  right: 56rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 999;
  height: 118rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(226, 240, 247, 0.74)),
    rgba(235, 246, 251, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 42rpx;
  box-shadow: 0 20rpx 50rpx rgba(77, 107, 132, 0.14);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  backdrop-filter: blur(18rpx);
}

.tabbar-item {
  min-width: 0;
  height: 98rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  color: #728196;
  font-family: var(--font-body-family);
  font-size: var(--font-caption-size);
  font-weight: 500;
}

.tabbar-item.is-active {
  color: #17314f;
}

.tabbar-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  color: currentColor;
}

.tabbar-icon::before,
.tabbar-icon::after,
.tabbar-icon view,
.tabbar-icon view::before,
.tabbar-icon view::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.tabbar-item.is-active .tabbar-icon {
  filter: drop-shadow(0 6rpx 10rpx rgba(31, 59, 90, 0.12));
}

.tabbar-item.is-active .tabbar-icon::after {
  background: #df8068;
}

.tabbar-icon-0::before {
  left: 8rpx;
  top: 15rpx;
  width: 24rpx;
  height: 20rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 4rpx;
}

.tabbar-icon-0 view {
  left: 8rpx;
  top: 7rpx;
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  transform: rotate(45deg);
  border-radius: 4rpx 0 0 0;
}

.tabbar-icon-0::after,
.tabbar-icon-1::after,
.tabbar-icon-2::after,
.tabbar-icon-3::after {
  left: 50%;
  bottom: -9rpx;
  width: 8rpx;
  height: 8rpx;
  margin-left: -4rpx;
  border-radius: 50%;
  background: transparent;
}

.tabbar-icon-1 view,
.tabbar-icon-1 view::before,
.tabbar-icon-1 view::after {
  bottom: 6rpx;
  width: 5rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.tabbar-icon-1 view {
  left: 7rpx;
  height: 18rpx;
}

.tabbar-icon-1 view::before {
  left: 12rpx;
  height: 30rpx;
}

.tabbar-icon-1 view::after {
  left: 24rpx;
  height: 24rpx;
}

.tabbar-icon-1::before {
  right: 4rpx;
  top: 8rpx;
  width: 10rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: currentColor;
  opacity: 0.38;
}

.tabbar-icon-2::before {
  left: 6rpx;
  right: 6rpx;
  top: 8rpx;
  bottom: 7rpx;
  border: 4rpx solid currentColor;
  border-radius: 6rpx;
}

.tabbar-icon-2 view,
.tabbar-icon-2 view::before,
.tabbar-icon-2 view::after {
  left: 13rpx;
  width: 14rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.tabbar-icon-2 view {
  top: 15rpx;
}

.tabbar-icon-2 view::before {
  top: 8rpx;
  left: 0;
}

.tabbar-icon-2 view::after {
  top: 16rpx;
  left: 0;
}

.tabbar-icon-3::before {
  left: 8rpx;
  top: 6rpx;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.tabbar-icon-3 view {
  left: 5rpx;
  bottom: 3rpx;
  width: 30rpx;
  height: 17rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 22rpx 22rpx 0 0;
}

.tabbar-text {
  font-size: 22rpx;
  line-height: 1;
}

.custom-tabbar.theme-library {
  left: 54rpx;
  right: 54rpx;
  height: 116rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid rgba(250, 245, 234, 0.2);
  border-radius: 40rpx;
  background: rgba(12, 17, 22, 0.78);
  box-shadow: 0 16rpx 34rpx rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(18rpx);
}

.custom-tabbar.theme-library .tabbar-item {
  height: 96rpx;
  gap: 8rpx;
  color: rgba(250, 245, 234, 0.66);
  font-family: "Songti SC", "STSong", serif;
}

.custom-tabbar.theme-library .tabbar-item.is-active {
  color: #f1cf95;
}

.custom-tabbar.theme-library .tabbar-item.is-active .tabbar-icon {
  filter: none;
}

.custom-tabbar.theme-library .tabbar-item.is-active .tabbar-icon::after {
  width: 22rpx;
  margin-left: -11rpx;
  border-radius: 0;
  background: #f1cf95;
}

.custom-tabbar.theme-voyage {
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(94rpx + env(safe-area-inset-bottom));
  padding: 7rpx 18rpx calc(5rpx + env(safe-area-inset-bottom));
  border: 0;
  border-top: 4rpx solid #9a6a2f;
  border-radius: 28rpx 28rpx 0 0;
  background:
    linear-gradient(180deg, rgba(255, 252, 237, 0.98), rgba(244, 229, 196, 0.98)),
    #fff8e8;
  box-shadow: 0 -14rpx 32rpx rgba(52, 78, 84, 0.2);
  backdrop-filter: none;
}

.custom-tabbar.theme-voyage::before {
  content: "";
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: 5rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: repeating-linear-gradient(90deg, #c49a58 0 12rpx, #81582b 12rpx 17rpx);
  opacity: 0.72;
}

.custom-tabbar.theme-voyage .tabbar-item {
  height: 80rpx;
  gap: 4rpx;
  color: #665642;
  font-family: "Songti SC", "STSong", serif;
  font-weight: 700;
}

.custom-tabbar.theme-voyage .tabbar-item.is-active {
  color: #176a99;
}

.custom-tabbar.theme-voyage .tabbar-item.is-active .tabbar-icon {
  filter: drop-shadow(0 5rpx 7rpx rgba(23, 106, 153, 0.22));
}

.custom-tabbar.theme-voyage .tabbar-icon {
  width: 40rpx;
  height: 40rpx;
  transform: scale(0.82);
}

.custom-tabbar.theme-voyage .tabbar-icon::before,
.custom-tabbar.theme-voyage .tabbar-icon::after,
.custom-tabbar.theme-voyage .tabbar-icon view,
.custom-tabbar.theme-voyage .tabbar-icon view::before,
.custom-tabbar.theme-voyage .tabbar-icon view::after {
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  transform: none;
  opacity: 1;
}

.custom-tabbar.theme-voyage .tabbar-icon-0::before {
  left: 6rpx;
  top: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  box-shadow: inset 0 0 0 5rpx #fff4d6;
}

.custom-tabbar.theme-voyage .tabbar-icon-0::after {
  left: 20rpx;
  top: 20rpx;
  width: 8rpx;
  height: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  background: #d5a64b;
}

.custom-tabbar.theme-voyage .tabbar-icon-0 view,
.custom-tabbar.theme-voyage .tabbar-icon-0 view::before,
.custom-tabbar.theme-voyage .tabbar-icon-0 view::after {
  left: 22rpx;
  top: 1rpx;
  width: 4rpx;
  height: 46rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform-origin: center;
}

.custom-tabbar.theme-voyage .tabbar-icon-0 view::before {
  left: 0;
  top: 0;
  transform: rotate(60deg);
}

.custom-tabbar.theme-voyage .tabbar-icon-0 view::after {
  left: 0;
  top: 0;
  transform: rotate(120deg);
}

.custom-tabbar.theme-voyage .tabbar-icon-1 view {
  left: 7rpx;
  top: 19rpx;
  width: 35rpx;
  height: 12rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
  background: #e6b858;
  transform: rotate(-18deg);
}

.custom-tabbar.theme-voyage .tabbar-icon-1::before {
  left: 3rpx;
  top: 15rpx;
  width: 11rpx;
  height: 20rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
  background: #f7dd9d;
  transform: rotate(-18deg);
  opacity: 1;
}

.custom-tabbar.theme-voyage .tabbar-icon-1::after {
  left: 34rpx;
  top: 14rpx;
  width: 10rpx;
  height: 22rpx;
  border: 3rpx solid currentColor;
  border-radius: 3rpx;
  background: #176a99;
  transform: rotate(-18deg);
}

.custom-tabbar.theme-voyage .tabbar-icon-2::before {
  left: 5rpx;
  top: 5rpx;
  width: 38rpx;
  height: 38rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  background: #fff4d6;
  box-shadow: inset 0 0 0 3rpx #d5a64b;
}

.custom-tabbar.theme-voyage .tabbar-icon-2 view {
  left: 21rpx;
  top: 10rpx;
  width: 7rpx;
  height: 29rpx;
  border-radius: 70% 20% 70% 20%;
  background: #bf4938;
  transform: rotate(38deg);
}

.custom-tabbar.theme-voyage .tabbar-icon-2::after {
  left: 21rpx;
  top: 21rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: currentColor;
}

.custom-tabbar.theme-voyage .tabbar-icon-3::before {
  left: 5rpx;
  top: 17rpx;
  width: 38rpx;
  height: 26rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
  background: #c78a3c;
  box-shadow: inset 0 -6rpx 0 rgba(112, 66, 25, 0.18);
}

.custom-tabbar.theme-voyage .tabbar-icon-3 view {
  left: 5rpx;
  top: 7rpx;
  width: 38rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-radius: 18rpx 18rpx 3rpx 3rpx;
  background: #e6b858;
}

.custom-tabbar.theme-voyage .tabbar-icon-3::after {
  left: 21rpx;
  top: 24rpx;
  width: 7rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: #fff4d6;
}

.custom-tabbar.theme-voyage .tabbar-text {
  font-size: 21rpx;
}

.custom-tabbar.theme-dragon { left: 0; right: 0; bottom: 0; height: calc(104rpx + env(safe-area-inset-bottom)); padding: 8rpx 22rpx calc(7rpx + env(safe-area-inset-bottom)); border: 0; border-top: 5rpx solid #102e62; border-radius: 0; background: #fffdf1; box-shadow: 0 -9rpx 0 #f45a16; backdrop-filter: none; }
.custom-tabbar.theme-dragon .tabbar-item { height: 84rpx; gap: 4rpx; color: #687185; font-weight: 700; }
.custom-tabbar.theme-dragon .tabbar-item.is-active { color: #f45a16; }
.custom-tabbar.theme-dragon .tabbar-item.is-active .tabbar-icon { filter: none; }
.custom-tabbar.theme-dragon .tabbar-icon { width: 42rpx; height: 42rpx; transform: scale(0.88); }
.custom-tabbar.theme-dragon .tabbar-icon::before,
.custom-tabbar.theme-dragon .tabbar-icon::after,
.custom-tabbar.theme-dragon .tabbar-icon view,
.custom-tabbar.theme-dragon .tabbar-icon view::before,
.custom-tabbar.theme-dragon .tabbar-icon view::after { margin: 0; border-radius: 0; background: transparent; transform: none; opacity: 1; }
.custom-tabbar.theme-dragon .tabbar-icon-0::before { left: 3rpx; top: 3rpx; width: 36rpx; height: 36rpx; border: 4rpx solid currentColor; border-radius: 50%; background: #ff9e19; box-shadow: inset 0 0 0 4rpx #ffd83d; }
.custom-tabbar.theme-dragon .tabbar-icon-0::after { content: "★"; left: 5rpx; top: 3rpx; width: 32rpx; height: 36rpx; color: #c92818; font-size: 23rpx; line-height: 36rpx; text-align: center; }
.custom-tabbar.theme-dragon .tabbar-icon-0 view { display: none; }
.custom-tabbar.theme-dragon .tabbar-icon-1::before { left: 3rpx; top: 6rpx; width: 36rpx; height: 28rpx; border: 4rpx solid currentColor; border-radius: 8rpx; }
.custom-tabbar.theme-dragon .tabbar-icon-1 view,
.custom-tabbar.theme-dragon .tabbar-icon-1 view::before,
.custom-tabbar.theme-dragon .tabbar-icon-1 view::after { bottom: 9rpx; width: 5rpx; border-radius: 3rpx; background: currentColor; }
.custom-tabbar.theme-dragon .tabbar-icon-2::before { left: 4rpx; top: 5rpx; width: 34rpx; height: 32rpx; border: 4rpx solid currentColor; border-radius: 7rpx; }
.custom-tabbar.theme-dragon .tabbar-icon-2 view,
.custom-tabbar.theme-dragon .tabbar-icon-2 view::before,
.custom-tabbar.theme-dragon .tabbar-icon-2 view::after { left: 10rpx; width: 20rpx; height: 4rpx; border-radius: 3rpx; background: currentColor; }
.custom-tabbar.theme-dragon .tabbar-icon-3::before { left: 8rpx; top: 3rpx; width: 26rpx; height: 26rpx; border: 4rpx solid currentColor; border-radius: 50%; }
.custom-tabbar.theme-dragon .tabbar-icon-3 view { left: 4rpx; bottom: 1rpx; width: 34rpx; height: 17rpx; border: 4rpx solid currentColor; border-bottom: 0; border-radius: 22rpx 22rpx 0 0; }
.custom-tabbar.theme-dragon .tabbar-text { font-size: 20rpx; }
