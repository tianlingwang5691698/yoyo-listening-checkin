@import "./styles/theme-current.wxss";
@import "./styles/base.wxss";

page {
  min-height: 100%;
  background-color: #F6FBFD;
}

.language-en,
.language-en view,
.language-en text,
.language-en button {
  word-break: normal;
  overflow-wrap: normal;
}

.language-en button {
  white-space: normal;
  line-height: 1.2;
}

.language-en .type-page-title,
.language-en .type-card-title,
.language-en .type-section-title {
  letter-spacing: 0;
}

.hierarchy-back.hierarchy-back {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 0 22rpx;
  border: 2rpx solid currentColor;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 750;
  line-height: 1.2;
}
