        "endMs": 46700
      },
      "last": {
        "lineId": "track-unlock4workbookthirdedition-u06-2-line-4",
        "text": "We need to overcome the drawbacks around expense, for one thing.",
        "startMs": 51680,
        "endMs": 58062
