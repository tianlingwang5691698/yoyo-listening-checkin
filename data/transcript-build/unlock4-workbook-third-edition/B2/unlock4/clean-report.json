    "track-unlock4workbookthirdedition-u01-2": {
      "first": {
        "lineId": "track-unlock4workbookthirdedition-u01-2-line-1",
        "text": "Interviewer: Good morning, Sally.",
        "startMs": 2920,
        "endMs": 4320
      },
      "middle": {
        "lineId": "track-unlock4workbookthirdedition-u01-2-line-24",
        "text": "Food scientist: It is, and these days this type of produce is becoming even more critical, as farming conditions are expected to get worse in many areas due to the effects of rising temperatures and climate change.",
        "startMs": 156420,
        "endMs": 170120
