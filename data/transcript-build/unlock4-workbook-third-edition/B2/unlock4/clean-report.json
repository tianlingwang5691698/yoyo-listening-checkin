    "track-unlock4workbookthirdedition-u06-2": {
      "first": {
        "lineId": "track-unlock4workbookthirdedition-u06-2-line-1",
        "text": "Well, we all know non-renewable energy sources are declining and most of us have heard about solar, wind and hydro energy, but what about the power of algae?",
