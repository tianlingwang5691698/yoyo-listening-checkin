view,
text,
button,
navigator,
input {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1.2;
}

button::after {
  border: none;
}

.page-shell {
  min-height: 100vh;
  padding: 28rpx var(--space-page-x) 48rpx;
  background: var(--bg-cream);
  color: var(--text-main);
}

.page-container {
  min-height: 100vh;
  padding: 28rpx var(--space-page-x) 48rpx;
  background: var(--bg-cream);
  color: var(--text-main);
}

.section-title {
  font-family: var(--font-title-family);
  font-size: var(--font-section-title-size);
  font-weight: var(--font-section-heading-weight);
  color: var(--text-main);
}

.section-copy {
  margin-top: 8rpx;
  font-size: var(--font-body-size);
  line-height: var(--line-body);
  color: var(--text-muted);
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
  line-height: 1.25;
}

.card {
  border-radius: var(--radius-xl);
  background: var(--surface-raised);
  border: 1rpx solid var(--border-soft);
  box-shadow: var(--shadow-card);
}

.card-main {
  border-radius: var(--radius-xl);
  background: var(--surface-raised);
  border: 1rpx solid var(--border-soft);
  box-shadow: var(--shadow-card);
}

.card-subtle {
  border: 1rpx solid var(--border-soft);
  border-radius: var(--radius-lg);
  background: var(--surface-glass);
}

.data-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.data-cell {
  min-width: 0;
  padding: 22rpx 10rpx;
  border-radius: var(--radius-lg);
  text-align: center;
  background: var(--surface-glass);
}

.data-value {
  display: block;
  font-family: var(--font-number-family);
  font-size: var(--font-brand-size);
  font-weight: var(--font-strong-number-weight);
  color: var(--text-strong);
}

.data-label {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-caption-size);
  color: var(--text-muted);
}

.button-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: var(--accent-contrast);
  font-family: var(--font-title-family);
  font-size: var(--font-section-title-size);
  font-weight: var(--font-title-weight);
  box-shadow: var(--shadow-accent);
}

.button-primary[disabled] {
  opacity: 0.55;
}

.button-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-family: var(--font-title-family);
  font-size: var(--font-control-size);
  font-weight: var(--font-section-weight);
}

.button-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  border-radius: 999rpx;
  background: var(--growth-soft);
  color: var(--growth-deep);
  font-family: var(--font-title-family);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.form-input {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-lg);
  background: var(--surface-subtle);
  color: var(--text-main);
  font-size: var(--font-body-size);
}

.status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--text-muted);
  font-family: var(--font-title-family);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.status-badge.is-muted {
  background: var(--control-muted-bg);
  color: var(--text-muted);
}

.status-badge.is-warn {
  background: var(--warning-soft);
  color: var(--warning);
}

.empty-state,
.error-state {
  padding: 28rpx;
  border-radius: var(--radius-lg);
  text-align: center;
  background: var(--surface-glass);
  color: var(--text-muted);
  font-size: var(--font-body-size);
  line-height: var(--line-body);
}

.error-state {
  background: var(--danger-soft);
  color: var(--danger);
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.muted {
  color: var(--text-muted);
}

.type-brand {
  color: var(--text-strong);
  font-family: var(--font-title-family);
  font-size: var(--font-brand-size);
  line-height: var(--line-title);
  font-weight: var(--font-brand-weight);
  letter-spacing: 0;
}

.type-page-title {
  color: var(--text-strong);
  font-family: var(--font-title-family);
  font-size: var(--font-page-title-size);
  line-height: var(--line-title);
  font-weight: var(--font-title-weight);
  letter-spacing: 0;
}

.type-card-title {
  color: var(--text-strong);
  font-family: var(--font-title-family);
  font-size: var(--font-card-title-size);
  line-height: var(--line-title);
  font-weight: var(--font-title-weight);
  letter-spacing: 0;
}

.type-section-title {
  color: var(--text-main);
  font-family: var(--font-title-family);
  font-size: var(--font-section-title-size);
  line-height: var(--line-section);
  font-weight: var(--font-section-weight);
}

.type-body {
  color: var(--text-muted);
  font-family: var(--font-body-family);
  font-size: var(--font-body-size);
  line-height: var(--line-body);
  font-weight: var(--font-body-weight);
}

.type-caption {
  color: var(--text-muted);
  font-family: var(--font-body-family);
  font-size: var(--font-caption-size);
  line-height: var(--line-caption);
  font-weight: var(--font-caption-weight);
}

.text-strong {
  color: var(--text-strong);
}

.text-muted {
  color: var(--text-muted);
}

.product-hero {
  position: relative;
  overflow: hidden;
  padding: 36rpx 32rpx;
  border-radius: var(--radius-xl);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.product-eyebrow {
  color: var(--accent-deep);
  font-family: var(--font-title-family);
  font-size: var(--font-eyebrow-size);
  font-weight: var(--font-section-weight);
  line-height: 1.2;
}

.product-title {
  margin-top: 12rpx;
  color: var(--text-strong);
  font-family: var(--font-title-family);
  font-size: var(--font-page-title-size);
  line-height: var(--line-title);
  font-weight: var(--font-title-weight);
}

.product-copy {
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: var(--font-product-copy-size);
  line-height: var(--line-body);
}

.section-panel {
  margin-top: 24rpx;
  padding: var(--space-card);
  border-radius: var(--radius-xl);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.form-panel {
  margin-top: 24rpx;
  padding: var(--space-card);
  border-radius: var(--radius-xl);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.program-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.program-card {
  position: relative;
  overflow: hidden;
  min-width: 0;
  padding: 26rpx;
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--border-soft);
  background: var(--surface-glass);
}

.program-card.tone-peppa {
  background: var(--surface);
}

.program-card.tone-unlock {
  background: var(--surface);
}

.program-card.tone-song {
  background: var(--surface);
}

.task-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  border: 1rpx solid var(--border-soft);
  border-radius: var(--radius-lg);
  background: var(--surface-glass);
}

.stat-tile {
  min-width: 0;
  padding: 24rpx 18rpx;
  border-radius: var(--radius-lg);
  background: var(--surface-glass);
  border: 1rpx solid var(--border-soft);
}

.stat-tile-value {
  color: var(--text-strong);
  font-family: var(--font-number-family);
  font-size: var(--font-brand-size);
  line-height: 1.1;
  font-weight: var(--font-strong-number-weight);
}

.stat-tile-label {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.35;
}

.progress-rail {
  width: 100%;
  height: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--control-strong-bg);
}

.progress-rail-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--growth) 0%, var(--accent) 100%);
}

.action-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.home-brand,
.profile-name,
.record-title,
.lesson-title,
.stage-title,
.product-title,
.section-title,
.row-title,
.slide-name,
.slide-title,
.slide-task-title,
.media-title,
.transcript-empty-title,
.completion-card-title,
.report-title,
.catchup-title,
.stage-row-title,
.group-name,
.detail-title,
.family-row .row-title,
.member-name {
  font-family: var(--font-title-family);
}

.metric-value,
.summary-value,
.data-value,
.stat-tile-value,
.student-code,
.total-value {
  font-family: var(--font-number-family);
}
