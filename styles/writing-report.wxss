.shared-writing-report {
  color: #203a5f;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 26rpx;
  line-height: 1.72;
  letter-spacing: 0;
}

.shared-writing-report-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 22rpx;
  border-bottom: 2rpx solid rgba(32, 58, 95, 0.16);
}

.shared-writing-report-title {
  font-size: 32rpx;
  font-weight: 800;
}

.shared-writing-report-score {
  margin-top: 6rpx;
  font-family: "DIN Alternate", "Arial", sans-serif;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #df633f;
}

.shared-writing-report-estimate,
.shared-writing-report-rubric {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: #68778d;
}

.shared-writing-report-level {
  flex: 0 0 auto;
  padding: 8rpx 12rpx;
  border: 2rpx solid rgba(32, 58, 95, 0.24);
  font-family: "DIN Alternate", "Arial", sans-serif;
  font-size: 23rpx;
  font-weight: 800;
}

.shared-writing-report-note,
.shared-writing-report-summary,
.shared-writing-report-notice,
.shared-writing-test-estimate {
  margin-top: 18rpx;
}

.shared-writing-report-summary {
  padding-left: 16rpx;
  border-left: 6rpx solid #df7f68;
}

.shared-writing-report-notice {
  padding: 16rpx 18rpx;
  border: 2rpx solid rgba(70, 101, 111, 0.35);
  background: rgba(255, 249, 225, 0.76);
  font-size: 23rpx;
  line-height: 1.58;
}

.shared-writing-test-estimate {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 6rpx 16rpx;
  padding: 16rpx 18rpx;
  border-left: 6rpx solid #2f7d62;
  background: rgba(237, 247, 242, 0.82);
  font-size: 23rpx;
  line-height: 1.5;
}

.shared-writing-test-score {
  grid-row: 1 / span 2;
  grid-column: 2;
  align-self: center;
  font-family: "DIN Alternate", "Arial", sans-serif;
  font-size: 32rpx;
  font-weight: 800;
}

.shared-writing-criterion,
.shared-writing-list,
.shared-writing-polished,
.shared-writing-band-panel,
.shared-writing-band-sample {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(32, 58, 95, 0.14);
}

.shared-writing-section-title {
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
}

.shared-writing-comment {
  margin-bottom: 14rpx;
}

.shared-writing-evidence,
.shared-writing-descriptor,
.shared-writing-limiters,
.shared-writing-actions,
.shared-writing-target {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  background: rgba(255, 248, 226, 0.78);
  font-size: 23rpx;
  line-height: 1.58;
}

.shared-writing-limiters {
  border-left: 5rpx solid #df7f68;
}

.shared-writing-actions {
  border-left: 5rpx solid #2f7d62;
}

.shared-writing-subtitle {
  margin-bottom: 6rpx;
  font-weight: 800;
}

.shared-writing-correction {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-left: 5rpx solid #df7f68;
  background: rgba(255, 248, 226, 0.72);
  font-size: 23rpx;
  line-height: 1.58;
}

.shared-writing-correction .is-revised {
  color: #24694f;
}

.shared-writing-correction .is-reason {
  color: #68778d;
}

.shared-writing-polished,
.shared-writing-band-sample {
  font-family: Georgia, "Times New Roman", serif;
  white-space: pre-wrap;
}

.shared-writing-polished .shared-writing-section-title,
.shared-writing-band-sample .shared-writing-section-title,
.shared-writing-band-sample .shared-writing-subtitle {
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

.shared-writing-band-head,
.shared-writing-band-buttons {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.shared-writing-band-copy {
  font-size: 23rpx;
  line-height: 1.58;
  color: #68778d;
}

.shared-writing-band-buttons {
  margin-top: 14rpx;
}

.shared-writing-band-buttons button {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  border: 2rpx solid #203a5f;
  border-radius: 4rpx;
  background: #fffdf7;
  color: #203a5f;
  font-size: 23rpx;
  line-height: 64rpx;
}

.shared-writing-band-buttons button.is-strong {
  background: #203a5f;
  color: #fff;
}

.shared-writing-download {
  width: 100%;
  height: 76rpx;
  margin-top: 30rpx;
  border: 0;
  border-radius: 4rpx;
  background: #df633f;
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.shared-writing-download[disabled] {
  opacity: 0.58;
}

.theme-library .shared-writing-report {
  color: #4f392f;
}

.theme-library .shared-writing-report-score,
.theme-library .shared-writing-section-title {
  color: #6f5140;
}

.theme-voyage .shared-writing-download {
  background: #cf4f3d;
}

.theme-voyage .shared-writing-report-score {
  color: #b94535;
}

.theme-dragon .shared-writing-report-score,
.theme-dragon .shared-writing-section-title {
  color: #dc5b25;
}

.history-writing-report {
  padding-top: 10rpx;
}
