.theme-library,
.custom-tabbar.theme-library {
  --bg-cream: #faf5ea;
  --bg-warm: #f3e8d4;
  --surface: #fffdf7;
  --surface-soft: #f3e8d4;
  --surface-subtle: #f8f0df;
  --surface-glass: rgba(250, 245, 234, 0.92);
  --surface-raised: #fffdf7;
  --control-muted-bg: rgba(184, 149, 98, 0.14);
  --control-strong-bg: rgba(184, 149, 98, 0.28);
  --text-main: #2b211b;
  --text-strong: #14283a;
  --text-muted: #6f675f;
  --text-soft: #847a71;
  --text-inverse: #faf5ea;
  --accent: #b89562;
  --accent-deep: #14283a;
  --accent-soft: rgba(184, 149, 98, 0.14);
  --accent-contrast: #fffdf7;
  --growth: #7f8c78;
  --growth-deep: #596954;
  --growth-soft: #e5e8df;
  --reward: #b89562;
  --reward-soft: rgba(184, 149, 98, 0.16);
  --calendar-cell-bg: #f8f0df;
  --calendar-cell-text: #6f675f;
  --calendar-completed-bg: #7f8c78;
  --calendar-completed-text: #fffdf7;
  --calendar-selected-ring: rgba(184, 149, 98, 0.54);
  --calendar-catchup-ring: rgba(154, 94, 82, 0.32);
  --warning: #b89562;
  --warning-soft: rgba(184, 149, 98, 0.16);
  --danger: #9a5e52;
  --danger-soft: #f7e8e3;
  --border-soft: rgba(184, 149, 98, 0.28);
  --border-strong: rgba(43, 33, 27, 0.24);
  --shadow-soft: 0 8rpx 20rpx rgba(43, 33, 27, 0.08);
  --shadow-card: 0 12rpx 28rpx rgba(43, 33, 27, 0.12);
  --shadow-accent: 0 12rpx 22rpx rgba(184, 149, 98, 0.2);
  --radius-xl: 12rpx;
  --radius-lg: 10rpx;
  --radius-md: 8rpx;
  --radius-sm: 6rpx;
  --radius-pill: 999rpx;
  --space-page-x: 28rpx;
  --space-card: 28rpx;
  --tabbar-bg: #14283a;
  --tabbar-text: rgba(250, 245, 234, 0.7);
  --tabbar-active: #f1cf95;
  --tabbar-border: rgba(184, 149, 98, 0.36);
  --font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-body-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-title-family: "Songti SC", "STSong", serif;
  --font-number-family: "DIN Alternate", "Helvetica Neue", sans-serif;
  --font-english-serif-family: Georgia, "Times New Roman", serif;
  --font-english-sans-family: "Helvetica Neue", Arial, sans-serif;
  --font-brand-size: 38rpx;
  --font-page-title-size: 38rpx;
  --font-card-title-size: 34rpx;
  --font-section-title-size: 28rpx;
  --font-body-size: 26rpx;
  --font-caption-size: 22rpx;
  --font-control-size: 28rpx;
  --font-eyebrow-size: 20rpx;
  --font-product-copy-size: 25rpx;
  --font-code-size: 68rpx;
  --font-display-size: 104rpx;
  --result-score-size: 48rpx;
  --result-title-size: 32rpx;
  --result-section-size: 28rpx;
  --result-body-size: 26rpx;
  --result-support-size: 23rpx;
  --result-meta-size: 21rpx;
  --result-line-body: 1.72;
  --result-line-support: 1.58;
  --font-brand-weight: 600;
  --font-title-weight: 600;
  --font-section-weight: 600;
  --font-section-heading-weight: 600;
  --font-body-weight: 400;
  --font-caption-weight: 500;
  --font-badge-weight: 700;
  --font-strong-number-weight: 800;
  --line-title: 1.25;
  --line-section: 1.3;
  --line-body: 1.55;
  --line-caption: 1.35;
  background: var(--bg-cream);
  color: var(--text-main);
  font-family: var(--font-body-family);
}

.theme-library {
  background-color: var(--bg-cream);
  color: var(--text-main);
}
