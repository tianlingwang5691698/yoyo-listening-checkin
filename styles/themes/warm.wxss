page,
.theme-warm,
.theme-current,
.custom-tabbar.theme-warm {
  --bg-cream: #f7f3ec;
  --bg-warm: #efe8dc;
  --surface: #fffdf8;
  --surface-soft: #f3ede4;
  --surface-subtle: #faf7f1;
  --surface-glass: rgba(255, 253, 248, 0.82);
  --surface-raised: rgba(255, 253, 248, 0.98);
  --control-muted-bg: rgba(112, 94, 72, 0.08);
  --control-strong-bg: rgba(112, 94, 72, 0.14);
  --text-main: #34302a;
  --text-strong: #4b4035;
  --text-muted: #81786c;
  --text-soft: #aaa297;
  --text-inverse: #fffdf8;
  --accent: #6f5b46;
  --accent-deep: #9b640f;
  --accent-soft: #efe6d8;
  --accent-contrast: #fffdf8;
  --growth: #6fa57d;
  --growth-deep: #4f8460;
  --growth-soft: #edf7ef;
  --reward: #9b640f;
  --reward-soft: #efe6d8;
  --calendar-cell-bg: #eee7dd;
  --calendar-cell-text: #81776b;
  --calendar-completed-bg: #6f5b46;
  --calendar-completed-text: #fffdf8;
  --calendar-selected-ring: rgba(155, 100, 15, 0.38);
  --calendar-catchup-ring: rgba(155, 100, 15, 0.28);
  --warning: #a8782b;
  --warning-soft: #f5ead7;
  --danger: #bd5b4e;
  --danger-soft: #fff0ee;
  --border-soft: rgba(80, 68, 55, 0.08);
  --border-strong: rgba(80, 68, 55, 0.13);
  --shadow-soft: 0 8rpx 22rpx rgba(70, 58, 44, 0.025);
  --shadow-card: 0 12rpx 30rpx rgba(70, 58, 44, 0.038);
  --shadow-accent: 0 14rpx 28rpx rgba(111, 91, 70, 0.14);
  --radius-xl: 22rpx;
  --radius-lg: 18rpx;
  --radius-md: 16rpx;
  --radius-sm: 14rpx;
  --space-page-x: 24rpx;
  --space-card: 30rpx;
  --tabbar-bg: #fbf8f2;
  --tabbar-text: #8b8175;
  --tabbar-active: #6f5b46;
  --tabbar-border: rgba(78, 62, 44, 0.08);
  --font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-body-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-title-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-number-family: "DIN Alternate", "Helvetica Neue", sans-serif;
  --font-brand-size: 38rpx;
  --font-page-title-size: 38rpx;
  --font-card-title-size: 34rpx;
  --font-section-title-size: 28rpx;
  --font-body-size: 26rpx;
  --font-caption-size: 22rpx;
  --font-control-size: 28rpx;
  --font-eyebrow-size: 20rpx;
  --font-product-copy-size: 25rpx;
  --font-code-size: 68rpx;
  --font-display-size: 104rpx;
  --font-brand-weight: 700;
  --font-title-weight: 700;
  --font-section-weight: 600;
  --font-section-heading-weight: 700;
  --font-body-weight: 400;
  --font-caption-weight: 500;
  --font-badge-weight: 700;
  --font-strong-number-weight: 800;
  --line-title: 1.25;
  --line-section: 1.3;
  --line-body: 1.55;
  --line-caption: 1.35;
  background: var(--bg-cream);
  color: var(--text-main);
  font-family: var(--font-body-family);
}
