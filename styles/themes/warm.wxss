page,
.theme-warm,
.theme-current,
.custom-tabbar.theme-warm {
  --bg-cream: #f6f2ea;
  --bg-warm: #eee8de;
  --surface: #fffdf8;
  --surface-soft: #f1ece3;
  --surface-subtle: #faf7f1;
  --surface-glass: rgba(255, 253, 248, 0.82);
  --surface-raised: rgba(255, 253, 248, 0.98);
  --control-muted-bg: rgba(186, 121, 54, 0.09);
  --control-strong-bg: rgba(186, 121, 54, 0.16);
  --text-main: #34312c;
  --text-strong: #4b4338;
  --text-muted: #7d776d;
  --text-soft: #aaa39a;
  --text-inverse: #fffdf8;
  --accent: #b87936;
  --accent-deep: #8f5d29;
  --accent-soft: #f4e5d2;
  --accent-contrast: #fffdf8;
  --growth: #c7833f;
  --growth-deep: #9a642d;
  --growth-soft: #f5e7d5;
  --reward: #b87936;
  --reward-soft: #f1e6d4;
  --calendar-cell-bg: #eee8df;
  --calendar-cell-text: #7f776c;
  --calendar-completed-bg: #b87936;
  --calendar-completed-text: #fffdf8;
  --calendar-selected-ring: rgba(186, 121, 54, 0.36);
  --calendar-catchup-ring: rgba(186, 121, 54, 0.24);
  --warning: #a66d32;
  --warning-soft: #f5ead7;
  --danger: #bd5b4e;
  --danger-soft: #fff0ee;
  --border-soft: rgba(78, 72, 64, 0.08);
  --border-strong: rgba(78, 72, 64, 0.13);
  --shadow-soft: 0 8rpx 22rpx rgba(70, 62, 52, 0.025);
  --shadow-card: 0 12rpx 30rpx rgba(70, 62, 52, 0.038);
  --shadow-accent: 0 14rpx 28rpx rgba(186, 121, 54, 0.13);
  --radius-xl: 22rpx;
  --radius-lg: 18rpx;
  --radius-md: 16rpx;
  --radius-sm: 14rpx;
  --space-page-x: 24rpx;
  --space-card: 30rpx;
  --tabbar-bg: #fbf8f2;
  --tabbar-text: #898278;
  --tabbar-active: #b87936;
  --tabbar-border: rgba(78, 72, 64, 0.08);
  --font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-body-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-title-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-number-family: "DIN Alternate", "Helvetica Neue", sans-serif;
  --font-brand-size: 38rpx;
  --font-page-title-size: 38rpx;
  --font-card-title-size: 34rpx;
  --font-section-title-size: 28rpx;
  --font-body-size: 26rpx;
  --font-caption-size: 22rpx;
  --font-control-size: 28rpx;
  --font-eyebrow-size: 20rpx;
  --font-product-copy-size: 25rpx;
  --font-code-size: 68rpx;
  --font-display-size: 104rpx;
  --font-brand-weight: 700;
  --font-title-weight: 700;
  --font-section-weight: 600;
  --font-section-heading-weight: 700;
  --font-body-weight: 400;
  --font-caption-weight: 500;
  --font-badge-weight: 700;
  --font-strong-number-weight: 800;
  --line-title: 1.25;
  --line-section: 1.3;
  --line-body: 1.55;
  --line-caption: 1.35;
  background: var(--bg-cream);
  color: var(--text-main);
  font-family: var(--font-body-family);
}
