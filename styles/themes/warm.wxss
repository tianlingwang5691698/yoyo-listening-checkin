page,
.theme-warm,
.theme-current,
.custom-tabbar.theme-warm {
  --bg-cream: #fff8ee;
  --bg-warm: #f7eee2;
  --surface: #ffffff;
  --surface-soft: #fff1e1;
  --surface-subtle: #fff7ee;
  --surface-glass: rgba(255, 250, 244, 0.82);
  --surface-raised: rgba(255, 255, 255, 0.96);
  --control-muted-bg: rgba(139, 100, 43, 0.09);
  --control-strong-bg: rgba(139, 100, 43, 0.16);
  --text-main: #302d28;
  --text-strong: #4f4236;
  --text-muted: #7f776d;
  --text-soft: #aaa195;
  --text-inverse: #fffaf3;
  --accent: #6f5b46;
  --accent-deep: #9b640f;
  --accent-soft: #fff0dc;
  --accent-contrast: #fffaf3;
  --growth: #6fa57d;
  --growth-deep: #4f8460;
  --growth-soft: #edf7ef;
  --reward: #9b640f;
  --reward-soft: #fff0dc;
  --calendar-cell-bg: #f5ede4;
  --calendar-cell-text: #81776b;
  --calendar-completed-bg: #6f5b46;
  --calendar-completed-text: #fffaf3;
  --calendar-selected-ring: rgba(155, 100, 15, 0.38);
  --calendar-catchup-ring: rgba(155, 100, 15, 0.28);
  --warning: #a8782b;
  --warning-soft: #fff3df;
  --danger: #bd5b4e;
  --danger-soft: #fff0ee;
  --border-soft: rgba(78, 62, 44, 0.08);
  --border-strong: rgba(78, 62, 44, 0.14);
  --shadow-soft: 0 8rpx 22rpx rgba(85, 62, 35, 0.032);
  --shadow-card: 0 14rpx 36rpx rgba(85, 62, 35, 0.052);
  --shadow-accent: 0 16rpx 34rpx rgba(111, 91, 70, 0.16);
  --radius-xl: 22rpx;
  --radius-lg: 18rpx;
  --radius-md: 16rpx;
  --radius-sm: 14rpx;
  --space-page-x: 24rpx;
  --space-card: 30rpx;
  --tabbar-bg: #fffaf3;
  --tabbar-text: #8b8175;
  --tabbar-active: #6f5b46;
  --tabbar-border: rgba(78, 62, 44, 0.08);
  --font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-body-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-title-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-number-family: "DIN Alternate", "Helvetica Neue", sans-serif;
  --font-brand-size: 38rpx;
  --font-page-title-size: 38rpx;
  --font-card-title-size: 34rpx;
  --font-section-title-size: 28rpx;
  --font-body-size: 26rpx;
  --font-caption-size: 22rpx;
  --font-control-size: 28rpx;
  --font-eyebrow-size: 20rpx;
  --font-product-copy-size: 25rpx;
  --font-code-size: 68rpx;
  --font-display-size: 104rpx;
  --font-brand-weight: 700;
  --font-title-weight: 700;
  --font-section-weight: 600;
  --font-section-heading-weight: 700;
  --font-body-weight: 400;
  --font-caption-weight: 500;
  --font-badge-weight: 700;
  --font-strong-number-weight: 800;
  --line-title: 1.25;
  --line-section: 1.3;
  --line-body: 1.55;
  --line-caption: 1.35;
  background: var(--bg-cream);
  color: var(--text-main);
  font-family: var(--font-body-family);
}
