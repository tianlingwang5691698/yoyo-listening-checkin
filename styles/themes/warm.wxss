page,
.theme-warm,
.theme-current,
.custom-tabbar.theme-warm {
  --bg-cream: #f6fbfd;
  --bg-warm: #edf6fa;
  --surface: #ffffff;
  --surface-soft: #edf6fa;
  --surface-subtle: #f3f9fc;
  --surface-glass: rgba(246, 251, 253, 0.82);
  --surface-raised: rgba(255, 255, 255, 0.94);
  --control-muted-bg: rgba(141, 183, 212, 0.16);
  --control-strong-bg: rgba(141, 183, 212, 0.28);
  --text-main: #17314f;
  --text-strong: #17314f;
  --text-muted: #607087;
  --text-soft: #728196;
  --text-inverse: #f6fbfd;
  --accent: #df8068;
  --accent-deep: #17314f;
  --accent-soft: rgba(221, 238, 248, 0.72);
  --accent-contrast: #fffafa;
  --growth: #668f84;
  --growth-deep: #486d64;
  --growth-soft: #dde7e3;
  --reward: #8db7d4;
  --reward-soft: rgba(191, 215, 232, 0.32);
  --calendar-cell-bg: #edf6fa;
  --calendar-cell-text: #607087;
  --calendar-completed-bg: #668f84;
  --calendar-completed-text: #fbfaf6;
  --calendar-selected-ring: rgba(184, 115, 96, 0.3);
  --calendar-catchup-ring: rgba(189, 162, 103, 0.28);
  --warning: #df8068;
  --warning-soft: rgba(242, 161, 142, 0.18);
  --danger: #b7635e;
  --danger-soft: #fff0ee;
  --border-soft: rgba(141, 183, 212, 0.16);
  --border-strong: rgba(96, 112, 135, 0.2);
  --shadow-soft: 0 10rpx 26rpx rgba(78, 112, 139, 0.06);
  --shadow-card: 0 18rpx 44rpx rgba(78, 112, 139, 0.1);
  --shadow-accent: 0 16rpx 28rpx rgba(223, 128, 104, 0.18);
  --radius-xl: 22rpx;
  --radius-lg: 18rpx;
  --radius-md: 16rpx;
  --radius-sm: 14rpx;
  --radius-pill: 999rpx;
  --space-page-x: 24rpx;
  --space-card: 30rpx;
  --tabbar-bg: #eaf5fa;
  --tabbar-text: #728196;
  --tabbar-active: #17314f;
  --tabbar-border: rgba(141, 183, 212, 0.16);
  --font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-body-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-title-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-number-family: "DIN Alternate", "Helvetica Neue", sans-serif;
  --font-brand-size: 38rpx;
  --font-page-title-size: 38rpx;
  --font-card-title-size: 34rpx;
  --font-section-title-size: 28rpx;
  --font-body-size: 26rpx;
  --font-caption-size: 22rpx;
  --font-control-size: 28rpx;
  --font-eyebrow-size: 20rpx;
  --font-product-copy-size: 25rpx;
  --font-code-size: 68rpx;
  --font-display-size: 104rpx;
  --font-brand-weight: 700;
  --font-title-weight: 700;
  --font-section-weight: 600;
  --font-section-heading-weight: 700;
  --font-body-weight: 400;
  --font-caption-weight: 500;
  --font-badge-weight: 700;
  --font-strong-number-weight: 800;
  --line-title: 1.25;
  --line-section: 1.3;
  --line-body: 1.55;
  --line-caption: 1.35;
  background: var(--bg-cream);
  color: var(--text-main);
  font-family: var(--font-body-family);
}
