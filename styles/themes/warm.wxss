page,
.theme-warm,
.theme-current,
.custom-tabbar.theme-warm {
  --bg-cream: #fdf9f3;
  --bg-warm: #faf4ec;
  --surface: #fffdfa;
  --surface-soft: #faf2ea;
  --surface-subtle: #fdf9f3;
  --surface-glass: rgba(255, 255, 255, 0.68);
  --surface-raised: rgba(255, 253, 250, 0.94);
  --control-muted-bg: rgba(37, 35, 33, 0.06);
  --control-strong-bg: rgba(37, 35, 33, 0.12);
  --text-main: #252321;
  --text-strong: #181715;
  --text-muted: #85807a;
  --text-soft: #aaa49c;
  --text-inverse: #fffaf6;
  --accent: #e89170;
  --accent-deep: #c96f50;
  --accent-soft: #fff3ec;
  --accent-contrast: #fffaf6;
  --growth: #66b985;
  --growth-deep: #428f62;
  --growth-soft: #edf9ef;
  --reward: #74b87c;
  --reward-soft: #edf9ef;
  --calendar-cell-bg: #f8f1ea;
  --calendar-cell-text: #85807a;
  --calendar-completed-bg: #e89170;
  --calendar-completed-text: #fffaf6;
  --calendar-selected-ring: rgba(201, 111, 80, 0.58);
  --calendar-catchup-ring: rgba(232, 145, 112, 0.5);
  --warning: #d98f45;
  --warning-soft: #fff5e7;
  --danger: #c85f50;
  --danger-soft: #fff0ee;
  --border-soft: rgba(84, 57, 45, 0.08);
  --border-strong: rgba(84, 57, 45, 0.14);
  --shadow-soft: 0 8rpx 24rpx rgba(40, 36, 30, 0.04);
  --shadow-card: 0 10rpx 32rpx rgba(40, 36, 30, 0.06);
  --radius-xl: 28rpx;
  --radius-lg: 24rpx;
  --radius-md: 20rpx;
  --radius-sm: 14rpx;
  --space-page-x: 24rpx;
  --space-card: 30rpx;
  --tabbar-bg: #fdf9f3;
  --tabbar-text: #8c7e72;
  --tabbar-active: #2f2b27;
  --tabbar-border: rgba(37, 35, 33, 0.08);
  --font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-body-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-title-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-number-family: "DIN Alternate", "Helvetica Neue", sans-serif;
  --font-brand-size: 38rpx;
  --font-page-title-size: 42rpx;
  --font-card-title-size: 40rpx;
  --font-section-title-size: 30rpx;
  --font-body-size: 24rpx;
  --font-caption-size: 22rpx;
  --font-control-size: 28rpx;
  --font-eyebrow-size: 20rpx;
  --font-product-copy-size: 25rpx;
  --font-code-size: 68rpx;
  --font-display-size: 104rpx;
  --font-brand-weight: 700;
  --font-title-weight: 700;
  --font-section-weight: 700;
  --font-section-heading-weight: 800;
  --font-body-weight: 400;
  --font-caption-weight: 500;
  --font-badge-weight: 800;
  --font-strong-number-weight: 900;
  --line-title: 1.25;
  --line-section: 1.3;
  --line-body: 1.55;
  --line-caption: 1.35;
  background: var(--bg-cream);
  color: var(--text-main);
  font-family: var(--font-body-family);
}
