page,
.theme-current,
.custom-tabbar {
  --bg-cream: #101214;
  --bg-warm: #15181b;
  --surface: #191d21;
  --surface-soft: #20252a;
  --surface-subtle: #171a1e;
  --text-main: #ebe6de;
  --text-strong: #fff8ef;
  --text-muted: #a99f94;
  --text-soft: #776f68;
  --accent: #f2a65a;
  --accent-deep: #d98b3b;
  --accent-soft: #332518;
  --growth: #6fc58e;
  --growth-deep: #87d9a2;
  --growth-soft: #1d3326;
  --reward: #79c891;
  --reward-soft: #1d3326;
  --warning: #e2b35e;
  --warning-soft: #342a18;
  --danger: #e07a6c;
  --danger-soft: #351f1e;
  --border-soft: rgba(255, 248, 239, 0.08);
  --border-strong: rgba(255, 248, 239, 0.14);
  --shadow-soft: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
  --shadow-card: 0 10rpx 32rpx rgba(0, 0, 0, 0.24);
  --radius-xl: 28rpx;
  --radius-lg: 24rpx;
  --radius-md: 20rpx;
  --radius-sm: 14rpx;
  --space-page-x: 24rpx;
  --space-card: 30rpx;
  --tabbar-bg: #101214;
  --tabbar-text: #a99f94;
  --tabbar-active: #fff8ef;
  --tabbar-border: rgba(255, 248, 239, 0.08);
  --font-family: "SF Pro Display", "PingFang SC", "Helvetica Neue", sans-serif;
  --font-brand-size: 36rpx;
  --font-page-title-size: 40rpx;
  --font-card-title-size: 38rpx;
  --font-section-title-size: 29rpx;
  --font-body-size: 24rpx;
  --font-caption-size: 21rpx;
  --font-control-size: 27rpx;
  --font-eyebrow-size: 19rpx;
  --font-product-copy-size: 24rpx;
  --font-brand-weight: 600;
  --font-title-weight: 600;
  --font-section-weight: 600;
  --font-section-heading-weight: 700;
  --font-body-weight: 400;
  --font-caption-weight: 400;
  --font-badge-weight: 700;
  --font-strong-number-weight: 800;
  background: var(--bg-cream);
  color: var(--text-main);
  font-family: var(--font-family);
}
