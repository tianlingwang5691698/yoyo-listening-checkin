.theme-fresh,
.custom-tabbar.theme-fresh {
  --bg-cream: #f6fcf9;
  --bg-warm: #eaf7f1;
  --surface: #ffffff;
  --surface-soft: #e9f7f1;
  --surface-subtle: #f4fbf8;
  --surface-glass: rgba(244, 251, 248, 0.78);
  --surface-raised: rgba(255, 255, 255, 0.98);
  --control-muted-bg: rgba(61, 143, 112, 0.1);
  --control-strong-bg: rgba(61, 143, 112, 0.18);
  --text-main: #21302c;
  --text-strong: #101816;
  --text-muted: #71817b;
  --text-soft: #9ba9a4;
  --text-inverse: #ffffff;
  --accent: #5ab894;
  --accent-deep: #3d8f70;
  --accent-soft: #edf8f3;
  --accent-contrast: #ffffff;
  --growth: #4fbd8a;
  --growth-deep: #2f8f66;
  --growth-soft: #e7f8ef;
  --reward: #58b894;
  --reward-soft: #e7f8ef;
  --calendar-cell-bg: #e6f3ee;
  --calendar-cell-text: #61756e;
  --calendar-completed-bg: #5ab894;
  --calendar-completed-text: #ffffff;
  --calendar-selected-ring: rgba(61, 143, 112, 0.56);
  --calendar-catchup-ring: rgba(90, 184, 148, 0.48);
  --warning: #c99035;
  --warning-soft: #fff6df;
  --danger: #c85f50;
  --danger-soft: #fff0ee;
  --border-soft: rgba(61, 143, 112, 0.12);
  --border-strong: rgba(61, 143, 112, 0.2);
  --shadow-soft: 0 8rpx 24rpx rgba(28, 89, 69, 0.04);
  --shadow-card: 0 14rpx 38rpx rgba(28, 89, 69, 0.08);
  --radius-xl: 28rpx;
  --radius-lg: 24rpx;
  --radius-md: 20rpx;
  --radius-sm: 14rpx;
  --space-page-x: 24rpx;
  --space-card: 30rpx;
  --tabbar-bg: #f3faf7;
  --tabbar-text: #71817b;
  --tabbar-active: #101816;
  --tabbar-border: rgba(33, 86, 69, 0.1);
  --font-family: "Kaiti SC", "STKaiti", "Songti SC", "PingFang SC", serif;
  --font-body-family: "Kaiti SC", "STKaiti", "Songti SC", "PingFang SC", serif;
  --font-title-family: "Kaiti SC", "STKaiti", "Songti SC", "PingFang SC", serif;
  --font-number-family: "Georgia", "Times New Roman", serif;
  --font-brand-size: 46rpx;
  --font-page-title-size: 48rpx;
  --font-card-title-size: 44rpx;
  --font-section-title-size: 33rpx;
  --font-body-size: 27rpx;
  --font-caption-size: 23rpx;
  --font-control-size: 30rpx;
  --font-eyebrow-size: 22rpx;
  --font-product-copy-size: 26rpx;
  --font-code-size: 72rpx;
  --font-display-size: 112rpx;
  --font-brand-weight: 400;
  --font-title-weight: 500;
  --font-section-weight: 500;
  --font-section-heading-weight: 600;
  --font-body-weight: 400;
  --font-caption-weight: 500;
  --font-badge-weight: 600;
  --font-strong-number-weight: 700;
  --line-title: 1.34;
  --line-section: 1.42;
  --line-body: 1.78;
  --line-caption: 1.48;
  background: var(--bg-cream);
  color: var(--text-main);
  font-family: var(--font-body-family);
}
