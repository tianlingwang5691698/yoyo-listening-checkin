page,
.theme-current,
.custom-tabbar {
  --bg-cream: #eef8f4;
  --bg-warm: #e4f3ed;
  --surface: #ffffff;
  --surface-soft: #e7f4ef;
  --surface-subtle: #f4fbf8;
  --text-main: #21302c;
  --text-strong: #101816;
  --text-muted: #71817b;
  --text-soft: #9ba9a4;
  --accent: #35a87c;
  --accent-deep: #247d5e;
  --accent-soft: #e4f7ef;
  --growth: #4fbd8a;
  --growth-deep: #2f8f66;
  --growth-soft: #e7f8ef;
  --reward: #58b894;
  --reward-soft: #e7f8ef;
  --warning: #c99035;
  --warning-soft: #fff6df;
  --danger: #c85f50;
  --danger-soft: #fff0ee;
  --border-soft: rgba(33, 86, 69, 0.1);
  --border-strong: rgba(33, 86, 69, 0.18);
  --shadow-soft: 0 8rpx 24rpx rgba(24, 65, 54, 0.04);
  --shadow-card: 0 10rpx 32rpx rgba(24, 65, 54, 0.06);
  --radius-xl: 28rpx;
  --radius-lg: 24rpx;
  --radius-md: 20rpx;
  --radius-sm: 14rpx;
  --space-page-x: 24rpx;
  --space-card: 30rpx;
  --tabbar-bg: #eef8f4;
  --tabbar-text: #71817b;
  --tabbar-active: #101816;
  --tabbar-border: rgba(33, 86, 69, 0.1);
  --font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-brand-size: 40rpx;
  --font-page-title-size: 44rpx;
  --font-card-title-size: 40rpx;
  --font-section-title-size: 30rpx;
  --font-body-size: 25rpx;
  --font-caption-size: 22rpx;
  --font-control-size: 29rpx;
  --font-eyebrow-size: 21rpx;
  --font-product-copy-size: 25rpx;
  --font-brand-weight: 600;
  --font-title-weight: 600;
  --font-section-weight: 600;
  --font-section-heading-weight: 700;
  --font-body-weight: 400;
  --font-caption-weight: 500;
  --font-badge-weight: 700;
  --font-strong-number-weight: 800;
  background: var(--bg-cream);
  color: var(--text-main);
  font-family: var(--font-family);
}
