.theme-voyage,
.custom-tabbar.theme-voyage {
  --bg-cream: #f4e7c8;
  --bg-warm: #e7d1a6;
  --surface: #fff4d6;
  --surface-soft: #ead5aa;
  --surface-subtle: #f8edcf;
  --surface-glass: rgba(255, 244, 214, 0.92);
  --surface-raised: #fff9e8;
  --control-muted-bg: rgba(29, 106, 151, 0.12);
  --control-strong-bg: rgba(29, 106, 151, 0.24);
  --text-main: #263642;
  --text-strong: #102f43;
  --text-muted: #6c5d49;
  --text-soft: #87745a;
  --text-inverse: #fff8e7;
  --accent: #bf4938;
  --accent-deep: #164d70;
  --accent-soft: rgba(191, 73, 56, 0.13);
  --accent-contrast: #fff8e7;
  --growth: #318d7b;
  --growth-deep: #1d655b;
  --growth-soft: #d9eee5;
  --reward: #c49338;
  --reward-soft: rgba(196, 147, 56, 0.18);
  --calendar-cell-bg: #f1dfb9;
  --calendar-cell-text: #6c5d49;
  --calendar-completed-bg: #24849b;
  --calendar-completed-text: #fff8e7;
  --calendar-selected-ring: rgba(196, 147, 56, 0.56);
  --calendar-catchup-ring: rgba(191, 73, 56, 0.4);
  --warning: #c49338;
  --warning-soft: rgba(196, 147, 56, 0.18);
  --danger: #a93e33;
  --danger-soft: #f8ded2;
  --border-soft: rgba(126, 91, 43, 0.2);
  --border-strong: rgba(89, 60, 27, 0.38);
  --shadow-soft: 0 8rpx 20rpx rgba(66, 45, 22, 0.1);
  --shadow-card: 0 14rpx 30rpx rgba(66, 45, 22, 0.16);
  --shadow-accent: 0 12rpx 24rpx rgba(191, 73, 56, 0.24);
  --radius-xl: 18rpx;
  --radius-lg: 14rpx;
  --radius-md: 10rpx;
  --radius-sm: 8rpx;
  --radius-pill: 999rpx;
  --space-page-x: 24rpx;
  --space-card: 28rpx;
  --tabbar-bg: #fff8e8;
  --tabbar-text: #64543f;
  --tabbar-active: #176a99;
  --tabbar-border: rgba(126, 91, 43, 0.34);
  --font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-body-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-title-family: "Songti SC", "STSong", serif;
  --font-number-family: "DIN Alternate", "Helvetica Neue", sans-serif;
  --font-brand-size: 38rpx;
  --font-page-title-size: 38rpx;
  --font-card-title-size: 34rpx;
  --font-section-title-size: 28rpx;
  --font-body-size: 26rpx;
  --font-caption-size: 22rpx;
  --font-control-size: 28rpx;
  --font-eyebrow-size: 20rpx;
  --font-product-copy-size: 25rpx;
  --font-code-size: 68rpx;
  --font-display-size: 104rpx;
  --font-brand-weight: 700;
  --font-title-weight: 700;
  --font-section-weight: 700;
  --font-section-heading-weight: 700;
  --font-body-weight: 400;
  --font-caption-weight: 600;
  --font-badge-weight: 700;
  --font-strong-number-weight: 800;
  --line-title: 1.25;
  --line-section: 1.3;
  --line-body: 1.55;
  --line-caption: 1.35;
  background: var(--bg-cream);
  color: var(--text-main);
  font-family: var(--font-body-family);
}

.theme-voyage {
  background-color: var(--bg-cream);
  color: var(--text-main);
}

/* Shared voyage page language: sea horizon, parchment, brass, and coral actions. */
.theme-voyage.page-shell,
.theme-voyage.page-container {
  background:
    linear-gradient(180deg, rgba(74, 185, 229, 0.96) 0, rgba(218, 241, 239, 0.9) 230rpx, transparent 231rpx),
    repeating-linear-gradient(12deg, rgba(95, 68, 33, 0.025) 0 2rpx, transparent 2rpx 24rpx),
    #f3e4c2;
  color: var(--text-main);
}

.theme-voyage .card,
.theme-voyage .card-main,
.theme-voyage .section-panel,
.theme-voyage .form-panel,
.theme-voyage .task-cell,
.theme-voyage .directory-row,
.theme-voyage .task-row,
.theme-voyage .stage-row,
.theme-voyage .report-row,
.theme-voyage .catchup-row,
.theme-voyage .profile-row,
.theme-voyage .student-row,
.theme-voyage .trend-row,
.theme-voyage .completed-card,
.theme-voyage .completed-row-main,
.theme-voyage .study-area-card,
.theme-voyage .wordbook-card,
.theme-voyage .test-card,
.theme-voyage .fixed-card,
.theme-voyage .selected-row,
.theme-voyage .episode-row,
.theme-voyage .task-group-row,
.theme-voyage .program-card {
  border: 3rpx solid rgba(142, 94, 43, 0.54);
  border-radius: 8rpx;
  background:
    repeating-linear-gradient(0deg, rgba(91, 61, 31, 0.026) 0 2rpx, transparent 2rpx 15rpx),
    linear-gradient(100deg, #ead19b, #fff3ce 8%, #f7e7ba 88%, #dabb7d);
  box-shadow: 0 14rpx 28rpx rgba(45, 71, 75, 0.18), inset 0 0 24rpx rgba(104, 67, 31, 0.1);
}

.theme-voyage .type-brand,
.theme-voyage .type-page-title,
.theme-voyage .type-card-title,
.theme-voyage .type-section-title,
.theme-voyage .section-title,
.theme-voyage .home-brand,
.theme-voyage .profile-name {
  color: #14384f;
  font-family: "Songti SC", "STSong", serif;
  font-weight: 800;
}

.theme-voyage .button-primary,
.theme-voyage .plan-action,
.theme-voyage .choice-action,
.theme-voyage .start-review,
.theme-voyage .highlight-button {
  border: 4rpx solid #c1843c;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #cf4d3e, #a92f2b);
  box-shadow: inset 0 3rpx rgba(255, 255, 255, 0.2), 0 7rpx 0 #743a25;
  color: #fff7df;
  font-family: "Songti SC", "STSong", serif;
  font-weight: 800;
}

.theme-voyage .button-ghost,
.theme-voyage .button-secondary,
.theme-voyage .mini-button,
.theme-voyage .mini-action,
.theme-voyage .row-action,
.theme-voyage .detail-link,
.theme-voyage .step-control,
.theme-voyage .stepper-btn {
  border: 2rpx solid rgba(148, 98, 43, 0.54);
  border-radius: 7rpx;
  background: linear-gradient(180deg, #fff6d8, #e6ca91);
  color: #214e68;
  box-shadow: 0 5rpx 0 rgba(105, 64, 29, 0.2);
}

.theme-voyage .pill,
.theme-voyage .status-badge,
.theme-voyage .theme-chip,
.theme-voyage .level-tab,
.theme-voyage .metric-tab,
.theme-voyage .review-tab,
.theme-voyage .study-tab,
.theme-voyage .admin-tab {
  border: 2rpx solid rgba(148, 98, 43, 0.38);
  border-radius: 7rpx;
  background: rgba(255, 246, 216, 0.9);
  color: #315a6e;
}

.theme-voyage .level-tab.is-active,
.theme-voyage .metric-tab.is-active,
.theme-voyage .review-tab.is-active,
.theme-voyage .study-tab.is-active,
.theme-voyage .admin-tab.is-active,
.theme-voyage .theme-chip.is-active {
  border-color: #c49338;
  background: #176a99;
  color: #fff8e7;
  box-shadow: 0 5rpx 0 #8a5a2a;
}

.theme-voyage .form-input,
.theme-voyage input,
.theme-voyage textarea {
  border: 2rpx solid rgba(142, 94, 43, 0.4);
  border-radius: 7rpx;
  background: rgba(255, 249, 228, 0.92);
  color: #263642;
}

.theme-voyage .progress-rail,
.theme-voyage .meter-track {
  background: rgba(112, 76, 37, 0.18);
}

.theme-voyage .progress-rail-fill,
.theme-voyage .meter-fill {
  background: linear-gradient(90deg, #176a99, #2e9caa);
}

.theme-voyage .empty-state,
.theme-voyage .error-state {
  border: 3rpx dashed rgba(142, 94, 43, 0.46);
  border-radius: 8rpx;
  background: rgba(255, 244, 214, 0.9);
}
