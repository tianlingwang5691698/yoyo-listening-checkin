.theme-sky,
.custom-tabbar.theme-sky {
  --bg-cream: #f7faff;
  --bg-warm: #f0f5fd;
  --surface: #ffffff;
  --surface-soft: #f0f5ff;
  --surface-subtle: #fbfdff;
  --surface-glass: rgba(255, 255, 255, 0.78);
  --surface-raised: rgba(255, 255, 255, 0.96);
  --control-muted-bg: rgba(39, 88, 156, 0.08);
  --control-strong-bg: rgba(39, 88, 156, 0.16);
  --text-main: #263141;
  --text-strong: #121a27;
  --text-muted: #708096;
  --text-soft: #a4afbd;
  --text-inverse: #ffffff;
  --accent: #70a4eb;
  --accent-deep: #477dcc;
  --accent-soft: #eef5ff;
  --accent-contrast: #ffffff;
  --growth: #54a6a2;
  --growth-deep: #2f837f;
  --growth-soft: #e5f6f4;
  --reward: #60a7b7;
  --reward-soft: #e7f5f8;
  --calendar-cell-bg: #eef3fb;
  --calendar-cell-text: #63758e;
  --calendar-completed-bg: #70a4eb;
  --calendar-completed-text: #ffffff;
  --calendar-selected-ring: rgba(71, 125, 204, 0.58);
  --calendar-catchup-ring: rgba(222, 139, 58, 0.62);
  --warning: #c98935;
  --warning-soft: #fff4df;
  --danger: #c85f50;
  --danger-soft: #fff0ee;
  --border-soft: rgba(39, 88, 156, 0.1);
  --border-strong: rgba(39, 88, 156, 0.18);
  --shadow-soft: 0 8rpx 24rpx rgba(30, 70, 125, 0.04);
  --shadow-card: 0 10rpx 32rpx rgba(30, 70, 125, 0.07);
  --radius-xl: 22rpx;
  --radius-lg: 18rpx;
  --radius-md: 16rpx;
  --radius-sm: 12rpx;
  --space-page-x: 24rpx;
  --space-card: 28rpx;
  --tabbar-bg: #f7faff;
  --tabbar-text: #708096;
  --tabbar-active: #121a27;
  --tabbar-border: rgba(39, 88, 156, 0.1);
  --font-family: "Avenir Next", "Arial", "PingFang SC", sans-serif;
  --font-body-family: "Avenir Next", "Arial", "PingFang SC", sans-serif;
  --font-title-family: "Songti SC", "STSong", "PingFang SC", serif;
  --font-number-family: "Avenir Next Condensed", "DIN Alternate", "Arial", sans-serif;
  --font-brand-size: 39rpx;
  --font-page-title-size: 39rpx;
  --font-card-title-size: 37rpx;
  --font-section-title-size: 29rpx;
  --font-body-size: 23rpx;
  --font-caption-size: 20rpx;
  --font-control-size: 27rpx;
  --font-eyebrow-size: 18rpx;
  --font-product-copy-size: 24rpx;
  --font-code-size: 66rpx;
  --font-display-size: 100rpx;
  --font-brand-weight: 600;
  --font-title-weight: 600;
  --font-section-weight: 600;
  --font-section-heading-weight: 700;
  --font-body-weight: 400;
  --font-caption-weight: 500;
  --font-badge-weight: 700;
  --font-strong-number-weight: 800;
  --line-title: 1.16;
  --line-section: 1.22;
  --line-body: 1.42;
  --line-caption: 1.24;
  background: var(--bg-cream);
  color: var(--text-main);
  font-family: var(--font-body-family);
}
