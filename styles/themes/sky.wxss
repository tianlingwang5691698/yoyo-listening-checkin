.theme-sky,
.custom-tabbar.theme-sky {
  --bg-cream: #f8fbff;
  --bg-warm: #edf5ff;
  --surface: #ffffff;
  --surface-soft: #edf5ff;
  --surface-subtle: #f5f9ff;
  --surface-glass: rgba(245, 249, 255, 0.8);
  --surface-raised: rgba(255, 255, 255, 0.98);
  --control-muted-bg: rgba(71, 125, 204, 0.1);
  --control-strong-bg: rgba(71, 125, 204, 0.2);
  --text-main: #263141;
  --text-strong: #4f4236;
  --text-muted: #708096;
  --text-soft: #a4afbd;
  --text-inverse: #ffffff;
  --accent: #70a4eb;
  --accent-deep: #477dcc;
  --accent-soft: #eef5ff;
  --accent-contrast: #ffffff;
  --growth: #54a6a2;
  --growth-deep: #2f837f;
  --growth-soft: #e5f6f4;
  --reward: #60a7b7;
  --reward-soft: #e7f5f8;
  --calendar-cell-bg: #eef3fb;
  --calendar-cell-text: #63758e;
  --calendar-completed-bg: #70a4eb;
  --calendar-completed-text: #ffffff;
  --calendar-selected-ring: rgba(71, 125, 204, 0.58);
  --calendar-catchup-ring: rgba(222, 139, 58, 0.62);
  --warning: #c98935;
  --warning-soft: #fff4df;
  --danger: #c85f50;
  --danger-soft: #fff0ee;
  --border-soft: rgba(71, 125, 204, 0.12);
  --border-strong: rgba(71, 125, 204, 0.2);
  --shadow-soft: 0 8rpx 24rpx rgba(37, 79, 140, 0.04);
  --shadow-card: 0 14rpx 38rpx rgba(37, 79, 140, 0.08);
  --shadow-accent: 0 14rpx 32rpx rgba(71, 125, 204, 0.2);
  --radius-xl: 22rpx;
  --radius-lg: 18rpx;
  --radius-md: 16rpx;
  --radius-sm: 12rpx;
  --space-page-x: 24rpx;
  --space-card: 28rpx;
  --tabbar-bg: #f7faff;
  --tabbar-text: #708096;
  --tabbar-active: #4f4236;
  --tabbar-border: rgba(39, 88, 156, 0.1);
  --font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-body-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-title-family: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-number-family: "DIN Alternate", "Helvetica Neue", sans-serif;
  --font-brand-size: 38rpx;
  --font-page-title-size: 38rpx;
  --font-card-title-size: 34rpx;
  --font-section-title-size: 28rpx;
  --font-body-size: 26rpx;
  --font-caption-size: 22rpx;
  --font-control-size: 28rpx;
  --font-eyebrow-size: 20rpx;
  --font-product-copy-size: 24rpx;
  --font-code-size: 66rpx;
  --font-display-size: 100rpx;
  --font-brand-weight: 600;
  --font-title-weight: 700;
  --font-section-weight: 600;
  --font-section-heading-weight: 700;
  --font-body-weight: 400;
  --font-caption-weight: 500;
  --font-badge-weight: 700;
  --font-strong-number-weight: 800;
  --line-title: 1.25;
  --line-section: 1.3;
  --line-body: 1.55;
  --line-caption: 1.35;
  background: var(--bg-cream);
  color: var(--text-main);
  font-family: var(--font-body-family);
}
