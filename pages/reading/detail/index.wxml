<block wx:if="{{theme === 'library'}}">
  <view class="theme-{{theme}} language-{{language}} page-shell library-reading-detail">
    <view class="library-desk-light"></view>

    <view class="library-loading-paper" wx:if="{{loading && !passage}}">
      <view class="loading-paper-title"></view>
      <view class="loading-paper-line"></view>
      <view class="loading-paper-line"></view>
      <view class="loading-paper-line short"></view>
    </view>

    <block wx:elif="{{passage}}">
      <view class="library-desk-header">
        <view class="desk-kicker">{{texts.title}}</view>
        <view class="desk-title">{{passage.headerTitle}}</view>
        <view class="desk-meta">{{passage.year}} · {{passage.district}} · {{passage.examType}} · {{passage.sectionDisplay}} · {{passage.difficultyDisplay}}</view>
      </view>

      <view class="library-article-paper">
        <view class="article-margin-line"></view>
        <view class="article-page-corner"></view>
        <view class="article-page-number">READING</view>
        <view class="highlight-actions library-answer-index" wx:if="{{submitted && review}}">
          <block wx:for="{{highlightButtons}}" wx:key="key">
            <view wx:if="{{!passage.isClozePassage || item.key !== 'answer'}}" class="highlight-button highlight-{{item.key}} {{activeHighlight === item.key ? 'is-active' : ''}} {{loadingStudySection ? 'is-loading' : ''}}" data-mode="{{item.key}}" bindtap="selectHighlight">
              <text>{{item.label}}</text>
              <text class="button-dot" wx:if="{{activeHighlight === item.key}}"></text>
            </view>
          </block>
        </view>
        <view class="reading-mark-toolbar" wx:if="{{!submitted}}">
          <text class="reading-mark-hint">{{readingMarkHint}}</text>
          <text class="reading-mark-clear" wx:if="{{readingMarkCount}}" bindtap="clearReadingMarks">{{clearReadingMarksText}}</text>
        </view>
        <view class="paper-body library-article-body">
          <view class="reading-source-structure" wx:if="{{passage.hasStructuredHeader}}">
            <view class="reading-section-heading" wx:if="{{passage.sectionHeading}}">{{passage.sectionHeading}}</view>
            <view class="reading-directions" wx:if="{{passage.directions}}">{{passage.directions}}</view>
            <view class="reading-article-title" wx:if="{{passage.articleTitle}}">{{passage.articleTitle}}</view>
            <view class="reading-article-subtitle" wx:if="{{passage.articleSubtitle}}">{{passage.articleSubtitle}}</view>
          </view>
          <block wx:if="{{passage.isClozePassage}}">
            <view class="cloze-passage-stack" wx:if="{{!submitted}}">
              <view wx:for="{{passage.clozePassageParagraphs}}" wx:key="index" wx:for-item="paragraph" class="passage-paragraph {{paragraph.isSubtitle ? 'is-subtitle' : ''}}">
                <view class="passage-paragraph-label" wx:if="{{paragraph.label && !paragraph.hasOriginalSourceLabel}}">{{paragraph.label}}</view>
                <text class="passage-source-label" wx:if="{{paragraph.hasOriginalSourceLabel}}">{{paragraph.sourceLabelText}}</text>
                <view class="passage-paragraph-content">
                  <view class="passage-paragraph-main cloze-passage-text library-cloze-text">
                    <block wx:for="{{paragraph.parts}}" wx:key="index" wx:for-item="part">
                      <text wx:if="{{part.type === 'text'}}" class="cloze-reading-fragment">
                        <text wx:for="{{part.tokens}}" wx:key="index" wx:for-item="token" class="cloze-reading-token {{readingSentenceMarks[token.sentenceKey] ? 'reading-mark-sentence-token' : ''}} {{readingTokenMarks[token.markKey] ? 'reading-mark-' + readingTokenMarks[token.markKey] : ''}}" data-is-word="{{token.isWord}}" data-word="{{token.word}}" data-mark-key="{{token.markKey}}" data-word-index="{{token.wordIndex}}" data-sentence-key="{{token.sentenceKey}}" data-start="{{token.sentenceStart}}" data-end="{{token.sentenceEnd}}" catchtap="handleReadingTokenTap" catchlongpress="handleReadingSentenceLongPress">{{token.text}}</text>
                      </text>
                      <view wx:else class="cloze-inline library-cloze-inline">
                        <text class="cloze-inline-initial" wx:if="{{part.initial}}">{{part.initial}}</text>
                        <input class="cloze-inline-input {{part.isCorrect === true ? 'is-correct' : ''}} {{part.isCorrect === false ? 'is-wrong' : ''}}" value="{{part.inputValue}}" disabled="{{submitted}}" data-number="{{part.number}}" bindinput="inputAnswer" placeholder="{{part.number}}" />
                      </view>
                    </block>
                  </view>
                </view>
              </view>
            </view>
            <view class="passage-text cloze-highlight-text" wx:else>
              <view wx:for="{{passageParagraphs}}" wx:key="index" wx:for-item="paragraph" class="passage-paragraph {{paragraph.isSubtitle ? 'is-subtitle' : ''}}">
                <view class="passage-paragraph-label" wx:if="{{paragraph.label && !paragraph.hasOriginalSourceLabel}}">{{paragraph.label}}</view>
                <text class="passage-source-label" wx:if="{{paragraph.hasOriginalSourceLabel}}">{{paragraph.sourceLabelText}}</text>
                <view class="passage-paragraph-content">
                  <view class="passage-paragraph-main">
                <view wx:for="{{paragraph.segments}}" wx:key="index" wx:for-item="segment" class="passage-segment segment-{{segment.tone}} {{!submitted && readingSentenceMarks[segment.markKey] ? 'reading-mark-sentence' : ''}}" data-mark-key="{{segment.markKey}}" data-start="{{segment.start}}" data-end="{{segment.end}}" bindlongpress="translatePassageSentence">
                  <block wx:if="{{segment.chunks && segment.chunks.length}}">
                    <text wx:for="{{segment.chunks}}" wx:key="index" wx:for-item="chunk" class="{{chunk.className}}">
                      <text wx:for="{{chunk.tokens}}" wx:key="index" wx:for-item="token" class="{{submitted && token.isWord ? 'tap-word' : ''}} {{!submitted && readingSentenceMarks[token.sentenceKey] ? 'reading-mark-sentence-token' : ''}} {{!submitted && readingTokenMarks[token.markKey] ? 'reading-mark-' + readingTokenMarks[token.markKey] : ''}}" data-is-word="{{token.isWord}}" data-word="{{token.word}}" data-mark-key="{{token.markKey}}" data-word-index="{{token.wordIndex}}" data-sentence-key="{{token.sentenceKey}}" catchtap="handleReadingTokenTap">{{token.text}}</text>
                    </text>
                  </block>
                  <block wx:else>
                    <text wx:if="{{segment.label}}" class="segment-label">{{segment.label}}</text>
                    <text wx:for="{{segment.tokens}}" wx:key="index" wx:for-item="token" class="{{submitted && token.isWord ? 'tap-word' : ''}} {{!submitted && readingSentenceMarks[token.sentenceKey] ? 'reading-mark-sentence-token' : ''}} {{!submitted && readingTokenMarks[token.markKey] ? 'reading-mark-' + readingTokenMarks[token.markKey] : ''}}" data-is-word="{{token.isWord}}" data-word="{{token.word}}" data-mark-key="{{token.markKey}}" data-word-index="{{token.wordIndex}}" data-sentence-key="{{token.sentenceKey}}" catchtap="handleReadingTokenTap">{{token.text}}</text>
                    <text wx:if="{{segment.note}}" class="segment-note">{{segment.note}}</text>
                  </block>
                  <view class="sentence-translation-inline {{sentenceTranslating ? 'is-loading' : ''}}" wx:if="{{selectedSentenceStart === segment.start}}">
                    {{sentenceTranslating ? texts.translating : selectedSentenceTranslation}}
                  </view>
                </view>
                  </view>
                </view>
              </view>
            </view>
          </block>
          <view class="passage-text" wx:else>
            <block wx:if="{{passageParagraphs.length}}">
              <view wx:for="{{passageParagraphs}}" wx:key="index" wx:for-item="paragraph" class="passage-paragraph {{paragraph.isSubtitle ? 'is-subtitle' : ''}}">
                <view class="passage-paragraph-label" wx:if="{{paragraph.label && !paragraph.hasOriginalSourceLabel}}">{{paragraph.label}}</view>
                <text class="passage-source-label" wx:if="{{paragraph.hasOriginalSourceLabel}}">{{paragraph.sourceLabelText}}</text>
                <view class="passage-paragraph-content">
                  <view class="passage-paragraph-main">
                <view wx:for="{{paragraph.segments}}" wx:key="index" wx:for-item="segment" class="passage-segment segment-{{segment.tone}} {{!submitted && readingSentenceMarks[segment.markKey] ? 'reading-mark-sentence' : ''}}" data-mark-key="{{segment.markKey}}" data-start="{{segment.start}}" data-end="{{segment.end}}" bindlongpress="translatePassageSentence">
                  <block wx:if="{{segment.chunks && segment.chunks.length}}">
                    <text wx:for="{{segment.chunks}}" wx:key="index" wx:for-item="chunk" class="{{chunk.className}}">
                      <text wx:for="{{chunk.tokens}}" wx:key="index" wx:for-item="token" class="{{submitted && token.isWord ? 'tap-word' : ''}} {{!submitted && readingSentenceMarks[token.sentenceKey] ? 'reading-mark-sentence-token' : ''}} {{!submitted && readingTokenMarks[token.markKey] ? 'reading-mark-' + readingTokenMarks[token.markKey] : ''}}" data-is-word="{{token.isWord}}" data-word="{{token.word}}" data-mark-key="{{token.markKey}}" data-word-index="{{token.wordIndex}}" data-sentence-key="{{token.sentenceKey}}" catchtap="handleReadingTokenTap">{{token.text}}</text>
                    </text>
                  </block>
                  <block wx:else>
                    <text wx:if="{{segment.label}}" class="segment-label">{{segment.label}}</text>
                    <text wx:for="{{segment.tokens}}" wx:key="index" wx:for-item="token" class="{{submitted && token.isWord ? 'tap-word' : ''}} {{!submitted && readingSentenceMarks[token.sentenceKey] ? 'reading-mark-sentence-token' : ''}} {{!submitted && readingTokenMarks[token.markKey] ? 'reading-mark-' + readingTokenMarks[token.markKey] : ''}}" data-is-word="{{token.isWord}}" data-word="{{token.word}}" data-mark-key="{{token.markKey}}" data-word-index="{{token.wordIndex}}" data-sentence-key="{{token.sentenceKey}}" catchtap="handleReadingTokenTap">{{token.text}}</text>
                    <text wx:if="{{segment.note}}" class="segment-note">{{segment.note}}</text>
                  </block>
                  <view class="sentence-translation-inline {{sentenceTranslating ? 'is-loading' : ''}}" wx:if="{{selectedSentenceStart === segment.start}}">
                    {{sentenceTranslating ? texts.translating : selectedSentenceTranslation}}
                  </view>
                </view>
                  </view>
                </view>
              </view>
            </block>
            <block wx:else>
              <view wx:for="{{passageSegments}}" wx:key="index" class="passage-segment segment-{{item.tone}} {{!submitted && readingSentenceMarks[item.markKey] ? 'reading-mark-sentence' : ''}}" data-mark-key="{{item.markKey}}" data-start="{{item.start}}" data-end="{{item.end}}" bindlongpress="translatePassageSentence">
                <block wx:if="{{item.chunks && item.chunks.length}}">
                  <text wx:for="{{item.chunks}}" wx:key="index" wx:for-item="chunk" class="{{chunk.className}}">
                      <text wx:for="{{chunk.tokens}}" wx:key="index" wx:for-item="token" class="{{submitted && token.isWord ? 'tap-word' : ''}} {{!submitted && readingSentenceMarks[token.sentenceKey] ? 'reading-mark-sentence-token' : ''}} {{!submitted && readingTokenMarks[token.markKey] ? 'reading-mark-' + readingTokenMarks[token.markKey] : ''}}" data-is-word="{{token.isWord}}" data-word="{{token.word}}" data-mark-key="{{token.markKey}}" data-word-index="{{token.wordIndex}}" data-sentence-key="{{token.sentenceKey}}" catchtap="handleReadingTokenTap">{{token.text}}</text>
                  </text>
                </block>
                <block wx:else>
                  <text wx:if="{{item.label}}" class="segment-label">{{item.label}}</text>
                  <text wx:for="{{item.tokens}}" wx:key="index" wx:for-item="token" class="{{submitted && token.isWord ? 'tap-word' : ''}} {{!submitted && readingSentenceMarks[token.sentenceKey] ? 'reading-mark-sentence-token' : ''}} {{!submitted && readingTokenMarks[token.markKey] ? 'reading-mark-' + readingTokenMarks[token.markKey] : ''}}" data-is-word="{{token.isWord}}" data-word="{{token.word}}" data-mark-key="{{token.markKey}}" data-word-index="{{token.wordIndex}}" data-sentence-key="{{token.sentenceKey}}" catchtap="handleReadingTokenTap">{{token.text}}</text>
                  <text wx:if="{{item.note}}" class="segment-note">{{item.note}}</text>
                </block>
                <view class="sentence-translation-inline {{sentenceTranslating ? 'is-loading' : ''}}" wx:if="{{selectedSentenceStart === item.start}}">
                  {{sentenceTranslating ? texts.translating : selectedSentenceTranslation}}
                </view>
              </view>
            </block>
          </view>
          <view class="passage-source-images" wx:if="{{passage.images && passage.images.length}}">
            <image class="passage-source-image" wx:for="{{passage.images}}" wx:key="src" src="{{item.src}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
          </view>
        </view>
      </view>

      <view class="review-card library-receipt {{readingCelebrating ? 'is-celebrating' : ''}}" wx:if="{{submitted}}">
        <view class="reading-result-effect" wx:if="{{readingCelebrating}}">
          <view class="reading-effect-line"></view>
          <view class="reading-effect-dot dot-one"></view>
          <view class="reading-effect-dot dot-two"></view>
        </view>
        <view class="receipt-label">{{texts.receipt}}</view>
        <view class="review-score" wx:if="{{hasScore}}">{{scoreText}}</view>
        <view class="review-score" wx:else>{{texts.completed}}</view>
        <view class="review-copy">{{reviewSummary || texts.resultReady}}</view>
      </view>

      <view class="cloze-review-card library-proof-panel" wx:if="{{submitted && passage.isClozePassage}}">
        <view class="review-title">{{texts.review}}</view>
        <view class="cloze-review-list">
          <view class="cloze-review-item {{item.isCorrect ? 'is-correct' : 'is-wrong'}}" wx:for="{{passage.questions}}" wx:key="number">
            <view class="cloze-review-head">
              <view class="cloze-review-number">{{texts.blankPrefix}}{{item.number}}{{texts.blankSuffix}}</view>
              <view class="{{item.isCorrect ? 'cloze-review-state is-correct' : 'cloze-review-state is-wrong'}}">{{item.isCorrect ? texts.correct : texts.correction}}</view>
            </view>
            <view class="cloze-answer-grid">
              <view class="cloze-answer-box">
                <view class="cloze-answer-label">{{texts.yourAnswer}}</view>
                <view class="cloze-answer-value {{item.isCorrect ? 'is-correct' : 'is-wrong'}}">{{item.selectedDisplay || texts.emptyAnswer}}</view>
              </view>
              <view class="cloze-answer-box is-standard-answer">
                <view class="cloze-answer-label">{{texts.correctAnswer}}</view>
                <view class="cloze-answer-value is-correct">{{item.answerDisplay || texts.pending}}</view>
              </view>
            </view>
            <view class="cloze-analysis-text" wx:if="{{item.reviewAnalysis && item.reviewAnalysis.text}}">{{item.reviewAnalysis.text}}</view>
            <view wx:if="{{item.reviewAnalysis && item.reviewAnalysis.answerSentence}}" class="cloze-evidence">
              <view class="cloze-evidence-label">{{texts.evidence}}</view>
              <view class="cloze-evidence-text">{{item.reviewAnalysis.answerSentence.text}}</view>
              <view wx:if="{{item.reviewAnalysis.answerSentence.translation}}" class="cloze-evidence-translation">{{item.reviewAnalysis.answerSentence.translation}}</view>
            </view>
          </view>
        </view>
      </view>

      <block wx:if="{{!passage.isClozePassage}}">
        <view class="question-side-notes library-question-notes">
          <view class="question-card library-question-slip" wx:for="{{passage.questions}}" wx:key="number">
            <view class="reading-question-source-pages" wx:if="{{item.sourceImages && item.sourceImages.length}}">
              <image class="reading-question-source-page" wx:for="{{item.sourceImages}}" wx:for-item="sourceImage" wx:key="cloudPath" src="{{sourceImage.src}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
            </view>
            <view class="answer-locator"></view>
            <view class="reading-question-group-head" wx:if="{{item.showGroupHeader}}">
              <view class="reading-question-group-range">{{item.groupRangeTitle}}</view>
              <view class="reading-question-group-title" wx:if="{{item.groupTitle}}">{{item.groupTitle}}</view>
              <view class="reading-question-group-instruction" wx:if="{{item.groupInstruction}}">{{item.groupInstruction}}</view>
            </view>
            <view class="reading-note-heading" wx:if="{{item.showNoteHeading}}">{{item.noteHeading}}</view>
            <view class="library-question-number">{{texts.questionPrefix}}{{item.number}}{{texts.questionSuffix}}</view>
            <view class="question-title">
              <block wx:if="{{submitted}}">
                <text wx:for="{{item.promptTokens}}" wx:key="index" wx:for-item="token" class="{{token.isWord ? 'tap-word' : ''}}" data-word="{{token.word}}" catchtap="lookupPassageWord">{{token.text}}</text>
              </block>
              <text wx:else>{{item.prompt}}</text>
            </view>
            <view class="option-list" wx:if="{{item.type === 'choice'}}">
              <view class="option-row {{option.selected ? 'is-selected' : ''}} {{option.correct ? 'is-correct' : ''}} {{option.wrong ? 'is-wrong' : ''}} {{submitted || submitting ? 'is-locked' : ''}}" wx:for="{{item.optionsList}}" wx:key="key" wx:for-item="option" data-number="{{item.number}}" data-option="{{option.key}}" bindtap="selectOption">
                <view class="option-mark">
                  <text class="option-key">{{option.key}}</text>
                  <text class="option-badge" wx:if="{{option.correct}}">{{texts.correct}}</text>
                  <text class="option-badge wrong" wx:elif="{{option.wrong}}">{{texts.yours}}</text>
                </view>
                <view class="option-text">
                  <image class="option-source-image" wx:if="{{option.image && option.image.src}}" src="{{option.image.src}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
                  <block wx:if="{{submitted}}">
                    <text wx:for="{{option.tokens}}" wx:key="index" wx:for-item="token" class="{{token.isWord ? 'tap-word' : ''}}" data-word="{{token.word}}" catchtap="lookupPassageWord">{{token.text}}</text>
                  </block>
                  <text wx:else>{{option.text}}</text>
                </view>
              </view>
            </view>
            <view class="blank-answer-box" wx:else>
              <input class="blank-input {{item.isCorrect === true ? 'is-correct' : ''}} {{item.isCorrect === false ? 'is-wrong' : ''}}" value="{{item.inputValue}}" disabled="{{submitted || submitting}}" data-number="{{item.number}}" bindinput="inputAnswer" placeholder="{{texts.answerPlaceholder}}" />
              <view class="blank-answer" wx:if="{{submitted}}">{{texts.correctAnswer}}: {{item.answerDisplay || texts.pending}}</view>
            </view>
            <view class="analysis-item inline-analysis library-analysis-proof" wx:if="{{submitted && item.reviewAnalysis}}">
              <view class="analysis-head">
                <text>{{texts.analysis}}</text>
                <text class="{{item.reviewAnalysis.correct ? 'analysis-state is-correct' : 'analysis-state is-wrong'}}">{{item.reviewAnalysis.correct ? texts.correct : texts.correction}}</text>
              </view>
              <view class="analysis-text">{{item.reviewAnalysis.text}}</view>
              <view wx:if="{{item.reviewAnalysis.answerSentence}}" class="answer-sentence">
                <view class="answer-sentence-label">{{texts.evidence}}</view>
                <view class="answer-sentence-text">{{item.reviewAnalysis.answerSentence.text}}</view>
                <view wx:if="{{item.reviewAnalysis.answerSentence.translation}}" class="answer-sentence-translation">{{item.reviewAnalysis.answerSentence.translation}}</view>
              </view>
            </view>
          </view>
        </view>
      </block>

      <button class="button-primary submit-button library-submit-button" wx:if="{{!submitted}}" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? texts.submitting : texts.submit}}</button>
      <view class="retry-card library-proof-error" wx:if="{{analysisErrorText && !submitted}}">
        <text>{{analysisErrorText}}</text>
        <button class="retry-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="retrySubmit">{{texts.retry}}</button>
      </view>

      <view class="reading-ai-action {{questionAnalysisReady ? 'is-ready' : ''}}" wx:if="{{submitted}}" bindtap="requestQuestionAnalysis">{{questionAnalysisLoading ? texts.loadingAnalysis : (questionAnalysisReady ? texts.regenerateAnalysis : texts.viewAnalysis)}}</view>
      <view class="reading-ai-message" wx:if="{{questionAnalysisMessage}}">{{questionAnalysisMessage}}</view>
      <view class="reading-analysis-debug" wx:if="{{readingDebugLines.length}}">
        <text selectable="{{true}}" wx:for="{{readingDebugLines}}" wx:key="*this">{{item}}</text>
      </view>

      <view class="review-card study-pack-panel library-study-drawer" wx:if="{{review && showReviewDetails}}">
        <view class="review-title">{{texts.studyPack}}</view>
        <view class="review-tabs library-drawer-tabs">
          <view class="review-tab tab-{{item.tone}} {{activeReviewTab === item.key ? 'is-active' : ''}} {{loadingStudySection === item.key ? 'is-loading' : ''}}" wx:for="{{reviewTabs}}" wx:key="key" data-tab="{{item.key}}" bindtap="selectReviewTab">
            <text>{{item.label}}</text>
            <text class="button-dot" wx:if="{{activeReviewTab === item.key}}"></text>
          </view>
        </view>
        <view class="study-error-tip" wx:if="{{studyErrorText}}">
          <text>{{studyErrorText}}</text>
          <button class="retry-button" bindtap="retryStudySection">{{texts.retry}}</button>
        </view>

        <view class="card-list" wx:if="{{activeReviewTab === 'vocabulary'}}">
          <view class="word-card library-study-note" wx:for="{{wordCards}}" wx:key="word">
            <view class="word-head">
              <view class="word-pronounce {{speakingWord === ('word:' + item.word) ? 'is-speaking' : ''}}" data-type="word" data-text="{{item.word}}" bindtap="speakStudyAudio">
                <view class="card-title-line">
                  <text class="card-index">{{item.groupIndex}}</text>
                  <text class="word-text">{{item.word}}</text>
                  <text class="sound-wave {{speakingWord === ('word:' + item.word) ? 'is-speaking' : ''}}" wx:if="{{item.canSpeak}}">♪</text>
                </view>
                <text class="phonetic" wx:if="{{item.phonetic}}">{{item.phonetic}}</text>
              </view>
              <view class="word-actions">
                <button class="mini-action strong" data-type="word" data-text="{{item.word}}" bindtap="addStudyCardToLibrary">{{studyDictionaryAddedMap[item.flashcardKey] || studyDictionaryAddedMap[item.word] ? texts.added : texts.add}}</button>
              </view>
            </view>
            <view class="card-meaning">{{item.meaning}}</view>
            <view class="card-example" wx:if="{{item.example}}">{{item.example}}</view>
            <view class="card-example-meaning" wx:if="{{item.exampleMeaning}}">{{item.exampleMeaning}}</view>
          </view>
          <view class="empty-inline" wx:if="{{!wordCards.length}}">
            <view>{{loadingStudySection === 'vocabulary' || loadingStudySection === 'cards' ? texts.wordCards : texts.noWords}}</view>
            <button loading="{{loadingStudySection === 'vocabulary' || loadingStudySection === 'cards'}}" disabled="{{loadingStudySection === 'vocabulary' || loadingStudySection === 'cards'}}" data-tab="vocabulary" bindtap="selectReviewTab">{{texts.createWords}}</button>
          </view>
        </view>

        <view class="card-list" wx:elif="{{activeReviewTab === 'phrases'}}">
          <view class="phrase-card library-study-note" wx:for="{{phraseCards}}" wx:key="text">
            <view class="word-head">
              <view class="word-pronounce {{speakingWord === ('phrase:' + item.text) ? 'is-speaking' : ''}}" data-type="phrase" data-text="{{item.text}}" bindtap="speakStudyAudio">
                <view class="card-title-line">
                  <text class="card-index">{{item.groupIndex}}</text>
                  <text class="phrase-text">{{item.text}}</text>
                  <text class="sound-wave {{speakingWord === ('phrase:' + item.text) ? 'is-speaking' : ''}}" wx:if="{{item.canSpeak}}">♪</text>
                </view>
              </view>
              <view class="word-actions">
                <button class="mini-action strong" data-type="phrase" data-text="{{item.text}}" bindtap="addStudyCardToLibrary">{{studyDictionaryAddedMap[item.flashcardKey] || studyDictionaryAddedMap[item.text] ? texts.added : texts.add}}</button>
              </view>
            </view>
            <view class="card-meaning">{{item.meaning}}</view>
            <view class="card-example" wx:if="{{item.example}}">{{item.example}}</view>
          </view>
          <view class="empty-inline" wx:if="{{!phraseCards.length}}">
            <view>{{loadingStudySection === 'phrases' || loadingStudySection === 'cards' ? texts.phraseCards : texts.noPhrases}}</view>
            <button loading="{{loadingStudySection === 'phrases' || loadingStudySection === 'cards'}}" disabled="{{loadingStudySection === 'phrases' || loadingStudySection === 'cards'}}" data-tab="phrases" bindtap="selectReviewTab">{{texts.createPhrases}}</button>
          </view>
        </view>

        <view class="card-list" wx:elif="{{activeReviewTab === 'patterns'}}">
          <view class="pattern-card library-study-note" wx:for="{{sentencePatternCards}}" wx:key="pattern">
            <view class="word-head">
              <view class="card-title-line">
                <text class="card-index">{{item.groupIndex}}</text>
                <text class="pattern-text">{{item.pattern}}</text>
              </view>
              <view class="word-actions">
                <button class="mini-action strong" data-type="pattern" data-text="{{item.pattern}}" bindtap="addStudyCardToLibrary">{{studyDictionaryAddedMap[item.flashcardKey] || studyDictionaryAddedMap[item.pattern] ? texts.added : texts.add}}</button>
              </view>
            </view>
            <view class="card-meaning">{{item.meaning}}</view>
            <view class="card-example" wx:if="{{item.example}}">{{item.example}}</view>
            <view class="card-example-meaning" wx:if="{{item.exampleMeaning}}">{{item.exampleMeaning}}</view>
