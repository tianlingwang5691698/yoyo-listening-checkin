<view class="theme-{{theme}} page-shell reading-detail">
  <block wx:if="{{passage}}">
    <view class="passage-card card">
      <view class="passage-meta">{{passage.year}} · {{passage.district}} · {{passage.examType}} · {{passage.sectionDisplay}} · {{passage.difficultyDisplay}}</view>
      <view class="passage-title">{{passage.title}}</view>
      <view class="highlight-actions" wx:if="{{submitted && review}}">
        <view class="highlight-button {{activeHighlight === item.key ? 'is-active' : ''}} {{loadingStudySection ? 'is-loading' : ''}}" wx:for="{{highlightButtons}}" wx:key="key" data-mode="{{item.key}}" bindtap="selectHighlight">
          <text>{{item.label}}</text>
          <text class="button-dot" wx:if="{{activeHighlight === item.key}}"></text>
        </view>
      </view>
      <block wx:if="{{passage.isClozePassage}}">
        <view class="cloze-passage-text" wx:if="{{!submitted}}">
          <block wx:for="{{passage.clozePassageParts}}" wx:key="index">
            <text wx:if="{{item.type === 'text'}}">{{item.text}}</text>
            <view wx:else class="cloze-inline">
              <text class="cloze-inline-initial" wx:if="{{item.initial}}">{{item.initial}}</text>
              <input class="cloze-inline-input {{item.isCorrect === true ? 'is-correct' : ''}} {{item.isCorrect === false ? 'is-wrong' : ''}}" value="{{item.inputValue}}" disabled="{{submitted}}" data-number="{{item.number}}" bindinput="inputAnswer" placeholder="{{item.number}}" />
            </view>
          </block>
        </view>
        <view class="passage-text cloze-highlight-text" wx:else>
          <view wx:for="{{passageSegments}}" wx:key="index" class="passage-segment segment-{{item.tone}}" data-start="{{item.start}}" data-end="{{item.end}}" bindlongpress="translatePassageSentence">
            <block wx:if="{{item.chunks && item.chunks.length}}">
              <text wx:for="{{item.chunks}}" wx:key="index" wx:for-item="chunk" class="{{chunk.className}}">
                <text wx:for="{{chunk.tokens}}" wx:key="index" wx:for-item="token" class="{{submitted && token.isWord ? 'tap-word' : ''}}" data-word="{{submitted ? token.word : ''}}" catchtap="lookupPassageWord">{{token.text}}</text>
              </text>
            </block>
            <block wx:else>
              <text wx:if="{{item.label}}" class="segment-label">{{item.label}}</text>
              <text wx:for="{{item.tokens}}" wx:key="index" wx:for-item="token" class="{{submitted && token.isWord ? 'tap-word' : ''}}" data-word="{{submitted ? token.word : ''}}" catchtap="lookupPassageWord">{{token.text}}</text>
              <text wx:if="{{item.note}}" class="segment-note">{{item.note}}</text>
            </block>
            <view class="sentence-translation-inline {{sentenceTranslating ? 'is-loading' : ''}}" wx:if="{{selectedSentenceStart === item.start}}">
              {{sentenceTranslating ? '翻译中...' : selectedSentenceTranslation}}
            </view>
          </view>
        </view>
      </block>
      <view class="passage-text" wx:else>
        <view wx:for="{{passageSegments}}" wx:key="index" class="passage-segment segment-{{item.tone}}" data-start="{{item.start}}" data-end="{{item.end}}" bindlongpress="translatePassageSentence">
          <block wx:if="{{item.chunks && item.chunks.length}}">
            <text wx:for="{{item.chunks}}" wx:key="index" wx:for-item="chunk" class="{{chunk.className}}">
              <text wx:for="{{chunk.tokens}}" wx:key="index" wx:for-item="token" class="{{submitted && token.isWord ? 'tap-word' : ''}}" data-word="{{submitted ? token.word : ''}}" catchtap="lookupPassageWord">{{token.text}}</text>
            </text>
          </block>
          <block wx:else>
            <text wx:if="{{item.label}}" class="segment-label">{{item.label}}</text>
            <text wx:for="{{item.tokens}}" wx:key="index" wx:for-item="token" class="{{submitted && token.isWord ? 'tap-word' : ''}}" data-word="{{submitted ? token.word : ''}}" catchtap="lookupPassageWord">{{token.text}}</text>
            <text wx:if="{{item.note}}" class="segment-note">{{item.note}}</text>
          </block>
          <view class="sentence-translation-inline {{sentenceTranslating ? 'is-loading' : ''}}" wx:if="{{selectedSentenceStart === item.start}}">
            {{sentenceTranslating ? '翻译中...' : selectedSentenceTranslation}}
          </view>
        </view>
      </view>
    </view>

    <view class="review-card card" wx:if="{{submitted}}">
      <view class="review-score" wx:if="{{hasScore}}">{{scoreText}}</view>
      <view class="review-score" wx:else>已完成</view>
      <view class="review-copy">{{reviewSummary || '解析已生成。'}}</view>
    </view>

    <view class="cloze-review-card card" wx:if="{{submitted && passage.isClozePassage}}">
      <view class="review-title">逐题订正</view>
      <view class="cloze-review-list">
        <view class="cloze-review-item {{item.isCorrect ? 'is-correct' : 'is-wrong'}}" wx:for="{{passage.questions}}" wx:key="number">
          <view class="cloze-review-head">
            <view class="cloze-review-number">第{{item.number}}空</view>
            <view class="{{item.isCorrect ? 'cloze-review-state is-correct' : 'cloze-review-state is-wrong'}}">{{item.isCorrect ? '正确' : '订正'}}</view>
          </view>
          <view class="cloze-answer-grid">
            <view class="cloze-answer-box">
              <view class="cloze-answer-label">你的答案</view>
              <view class="cloze-answer-value {{item.isCorrect ? 'is-correct' : 'is-wrong'}}">{{item.selectedDisplay || '未填'}}</view>
            </view>
            <view class="cloze-answer-box">
              <view class="cloze-answer-label">正确答案</view>
              <view class="cloze-answer-value is-correct">{{item.answerDisplay || '待补充'}}</view>
            </view>
          </view>
          <view class="cloze-analysis-text" wx:if="{{item.reviewAnalysis && item.reviewAnalysis.text}}">{{item.reviewAnalysis.text}}</view>
          <view wx:if="{{item.reviewAnalysis && item.reviewAnalysis.answerSentence}}" class="cloze-evidence">
            <view class="cloze-evidence-label">答案句</view>
            <view class="cloze-evidence-text">{{item.reviewAnalysis.answerSentence.text}}</view>
            <view wx:if="{{item.reviewAnalysis.answerSentence.translation}}" class="cloze-evidence-translation">{{item.reviewAnalysis.answerSentence.translation}}</view>
          </view>
        </view>
      </view>
    </view>

    <block wx:if="{{!passage.isClozePassage}}">
      <view class="question-card card" wx:for="{{passage.questions}}" wx:key="number">
        <view class="question-title">
          <text>{{item.number}}. </text>
          <block wx:if="{{submitted}}">
            <text wx:for="{{item.promptTokens}}" wx:key="index" wx:for-item="token" class="{{token.isWord ? 'tap-word' : ''}}" data-word="{{token.word}}" catchtap="lookupPassageWord">{{token.text}}</text>
          </block>
          <text wx:else>{{item.prompt}}</text>
        </view>
        <view class="option-list" wx:if="{{item.type === 'choice'}}">
          <view class="option-row {{option.selected ? 'is-selected' : ''}} {{option.correct ? 'is-correct' : ''}} {{option.wrong ? 'is-wrong' : ''}} {{submitted || submitting ? 'is-locked' : ''}}" wx:for="{{item.optionsList}}" wx:key="key" wx:for-item="option" data-number="{{item.number}}" data-option="{{option.key}}" bindtap="selectOption">
            <view class="option-mark">
              <text class="option-key">{{option.key}}</text>
              <text class="option-badge" wx:if="{{option.correct}}">正确</text>
              <text class="option-badge wrong" wx:elif="{{option.wrong}}">你的</text>
            </view>
            <view class="option-text">
              <block wx:if="{{submitted}}">
                <text wx:for="{{option.tokens}}" wx:key="index" wx:for-item="token" class="{{token.isWord ? 'tap-word' : ''}}" data-word="{{token.word}}" catchtap="lookupPassageWord">{{token.text}}</text>
              </block>
              <text wx:else>{{option.text}}</text>
            </view>
          </view>
        </view>
        <view class="blank-answer-box" wx:else>
          <input class="blank-input {{item.isCorrect === true ? 'is-correct' : ''}} {{item.isCorrect === false ? 'is-wrong' : ''}}" value="{{item.inputValue}}" disabled="{{submitted || submitting}}" data-number="{{item.number}}" bindinput="inputAnswer" placeholder="填写答案" />
          <view class="blank-answer" wx:if="{{submitted}}">正确答案：{{item.answerDisplay || '待补充'}}</view>
        </view>
        <view class="analysis-item inline-analysis" wx:if="{{submitted && item.reviewAnalysis}}">
          <view class="analysis-head">
            <text>解析</text>
            <text class="{{item.reviewAnalysis.correct ? 'analysis-state is-correct' : 'analysis-state is-wrong'}}">{{item.reviewAnalysis.correct ? '正确' : '订正'}}</text>
          </view>
          <view class="analysis-text">{{item.reviewAnalysis.text}}</view>
          <view wx:if="{{item.reviewAnalysis.answerSentence}}" class="answer-sentence">
            <view class="answer-sentence-label">答案句</view>
            <view class="answer-sentence-text">{{item.reviewAnalysis.answerSentence.text}}</view>
            <view wx:if="{{item.reviewAnalysis.answerSentence.translation}}" class="answer-sentence-translation">{{item.reviewAnalysis.answerSentence.translation}}</view>
          </view>
        </view>
      </view>
    </block>

    <button class="button-primary submit-button" wx:if="{{!submitted}}" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '生成解析中' : '提交阅读'}}</button>
    <view class="retry-card" wx:if="{{analysisErrorText && !submitted}}">
      <text>{{analysisErrorText}}</text>
      <button class="retry-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="retrySubmit">重试</button>
    </view>

    <view class="review-card card" wx:if="{{review && showReviewDetails}}">
      <view class="review-title">学习包</view>
      <view class="review-tabs">
        <view class="review-tab tab-{{item.tone}} {{activeReviewTab === item.key ? 'is-active' : ''}} {{loadingStudySection === item.key ? 'is-loading' : ''}}" wx:for="{{reviewTabs}}" wx:key="key" data-tab="{{item.key}}" bindtap="selectReviewTab">
          <text>{{item.label}}</text>
          <text class="button-dot" wx:if="{{activeReviewTab === item.key}}"></text>
        </view>
      </view>
      <view class="study-error-tip" wx:if="{{studyErrorText}}">
        <text>{{studyErrorText}}</text>
        <button class="retry-button" bindtap="retryStudySection">重试</button>
      </view>

      <view class="card-list" wx:if="{{activeReviewTab === 'vocabulary'}}">
        <view class="word-card" wx:for="{{wordCards}}" wx:key="word">
          <view class="word-head">
            <view class="word-pronounce {{speakingWord === ('word:' + item.word) ? 'is-speaking' : ''}}" data-type="word" data-text="{{item.word}}" bindtap="speakStudyAudio">
              <view class="card-title-line">
                <text class="card-index">{{item.groupIndex}}</text>
                <text class="word-text">{{item.word}}</text>
                <text class="sound-wave {{speakingWord === ('word:' + item.word) ? 'is-speaking' : ''}}" wx:if="{{item.canSpeak}}">♪</text>
              </view>
              <text class="phonetic" wx:if="{{item.phonetic}}">{{item.phonetic}}</text>
            </view>
            <view class="word-actions">
              <button class="mini-action strong" data-word="{{item.word}}" bindtap="toggleWordUnfamiliar">{{unfamiliarMap[item.flashcardKey] ? '已加入' : '不熟'}}</button>
            </view>
          </view>
          <view class="card-meaning">{{item.meaning}}</view>
          <view class="card-example" wx:if="{{item.example}}">{{item.example}}</view>
          <view class="card-example-meaning" wx:if="{{item.exampleMeaning}}">{{item.exampleMeaning}}</view>
        </view>
        <view class="empty-inline" wx:if="{{!wordCards.length && loadingStudySection !== 'vocabulary' && loadingStudySection !== 'cards'}}">
          <view>还没有生成生词。</view>
          <button wx:if="{{loadingStudySection !== 'vocabulary' && loadingStudySection !== 'cards'}}" data-tab="vocabulary" bindtap="selectReviewTab">生成生词</button>
        </view>
      </view>

      <view class="card-list" wx:elif="{{activeReviewTab === 'phrases'}}">
        <view class="phrase-card" wx:for="{{phraseCards}}" wx:key="text">
          <view class="word-head">
            <view class="word-pronounce {{speakingWord === ('phrase:' + item.text) ? 'is-speaking' : ''}}" data-type="phrase" data-text="{{item.text}}" bindtap="speakStudyAudio">
              <view class="card-title-line">
                <text class="card-index">{{item.groupIndex}}</text>
                <text class="phrase-text">{{item.text}}</text>
                <text class="sound-wave {{speakingWord === ('phrase:' + item.text) ? 'is-speaking' : ''}}" wx:if="{{item.canSpeak}}">♪</text>
              </view>
            </view>
            <view class="word-actions">
              <button class="mini-action strong" data-text="{{item.text}}" bindtap="togglePhraseUnfamiliar">{{unfamiliarMap[item.flashcardKey] ? '已加入' : '不熟'}}</button>
            </view>
          </view>
          <view class="card-meaning">{{item.meaning}}</view>
          <view class="card-example" wx:if="{{item.example}}">{{item.example}}</view>
        </view>
        <view class="empty-inline" wx:if="{{!phraseCards.length && loadingStudySection !== 'phrases' && loadingStudySection !== 'cards'}}">
          <view>还没有生成短语。</view>
          <button wx:if="{{loadingStudySection !== 'phrases' && loadingStudySection !== 'cards'}}" data-tab="phrases" bindtap="selectReviewTab">生成短语</button>
        </view>
      </view>

      <view class="card-list" wx:elif="{{activeReviewTab === 'patterns'}}">
        <view class="pattern-card" wx:for="{{sentencePatternCards}}" wx:key="pattern">
          <view class="card-title-line">
            <text class="card-index">{{item.groupIndex}}</text>
            <text class="pattern-text">{{item.pattern}}</text>
          </view>
          <view class="card-meaning">{{item.meaning}}</view>
          <view class="card-example" wx:if="{{item.example}}">{{item.example}}</view>
          <view class="card-example-meaning" wx:if="{{item.exampleMeaning}}">{{item.exampleMeaning}}</view>
        </view>
        <view class="empty-inline" wx:if="{{!sentencePatternCards.length && loadingStudySection !== 'patterns' && loadingStudySection !== 'cards'}}">
          <view>还没有生成句型。</view>
          <button wx:if="{{loadingStudySection !== 'patterns' && loadingStudySection !== 'cards'}}" data-tab="patterns" bindtap="selectReviewTab">生成句型</button>
        </view>
      </view>
    </view>

    <view class="dictionary-mask" wx:if="{{dictionaryVisible}}" catchtap="closeDictionary"></view>
    <view class="dictionary-sheet" wx:if="{{dictionaryVisible}}">
      <view class="dictionary-head">
        <view>
          <view class="dictionary-word">{{dictionaryEntry.word || dictionaryWord}}</view>
          <view class="dictionary-phonetic" wx:if="{{dictionaryEntry.phonetic}}">/{{dictionaryEntry.phonetic}}/</view>
        </view>
        <button class="dictionary-audio {{dictionaryAudioLoading ? 'is-loading' : ''}}" disabled="{{dictionaryLoading || dictionaryAudioLoading}}" bindtap="playDictionaryWord">♪</button>
      </view>
      <button class="dictionary-add" loading="{{dictionaryAdding}}" bindtap="addDictionaryWordToLibrary">加入词库</button>
      <block wx:if="{{!dictionaryLoading}}">
        <view class="dictionary-definition" wx:for="{{dictionaryEntry.definitions}}" wx:key="*this">· {{item}}</view>
        <view class="dictionary-empty" wx:if="{{!dictionaryEntry.definitions || !dictionaryEntry.definitions.length}}">暂无释义。</view>
      </block>
    </view>
  </block>

  <view class="empty-state" wx:else>暂无阅读内容。</view>
</view>
