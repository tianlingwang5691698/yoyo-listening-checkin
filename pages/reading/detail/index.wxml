          <view class="empty-inline" wx:if="{{!phraseCards.length}}">
            <view>{{loadingStudySection === 'phrases' || loadingStudySection === 'cards' ? texts.phraseCards : texts.noPhrases}}</view>
            <button loading="{{loadingStudySection === 'phrases' || loadingStudySection === 'cards'}}" disabled="{{loadingStudySection === 'phrases' || loadingStudySection === 'cards'}}" data-tab="phrases" bindtap="selectReviewTab">{{texts.createPhrases}}</button>
          </view>
        </view>

        <view class="card-list" wx:elif="{{activeReviewTab === 'patterns'}}">
          <view class="pattern-card" wx:for="{{sentencePatternCards}}" wx:key="pattern">
            <view class="word-head">
              <view class="card-title-line">
                <text class="card-index">{{item.groupIndex}}</text>
                <text class="pattern-text">{{item.pattern}}</text>
              </view>
              <view class="word-actions">
                <button class="mini-action strong" data-type="pattern" data-text="{{item.pattern}}" bindtap="addStudyCardToLibrary">{{studyDictionaryAddedMap[item.flashcardKey] || studyDictionaryAddedMap[item.pattern] ? texts.added : texts.add}}</button>
              </view>
            </view>
            <view class="card-meaning">{{item.meaning}}</view>
            <view class="card-example" wx:if="{{item.example}}">{{item.example}}</view>
            <view class="card-example-meaning" wx:if="{{item.exampleMeaning}}">{{item.exampleMeaning}}</view>
          </view>
          <view class="empty-inline" wx:if="{{!sentencePatternCards.length}}">
            <view>{{loadingStudySection === 'patterns' || loadingStudySection === 'cards' ? texts.patternCards : texts.noPatterns}}</view>
            <button loading="{{loadingStudySection === 'patterns' || loadingStudySection === 'cards'}}" disabled="{{loadingStudySection === 'patterns' || loadingStudySection === 'cards'}}" data-tab="patterns" bindtap="selectReviewTab">{{texts.createPatterns}}</button>
          </view>
        </view>
      </view>

      <view class="dictionary-mask" wx:if="{{dictionaryVisible}}" catchtap="closeDictionary"></view>
      <view class="dictionary-sheet" wx:if="{{dictionaryVisible}}">
        <view class="dictionary-head">
          <view>
            <view class="dictionary-word">{{dictionaryEntry.word || dictionaryWord}}</view>
            <view class="dictionary-phonetic" wx:if="{{dictionaryEntry.phonetic}}">/{{dictionaryEntry.phonetic}}/</view>
          </view>
          <button class="dictionary-audio {{dictionaryAudioLoading ? 'is-loading' : ''}}" disabled="{{dictionaryLoading || dictionaryAudioLoading}}" bindtap="playDictionaryWord">♪</button>
        </view>
        <button class="dictionary-add" loading="{{dictionaryAdding}}" bindtap="addDictionaryWordToLibrary">{{texts.addLibrary}}</button>
        <block wx:if="{{!dictionaryLoading}}">
          <view class="dictionary-definition" wx:for="{{dictionaryEntry.definitions}}" wx:key="*this">· {{item}}</view>
          <view class="dictionary-empty" wx:if="{{!dictionaryEntry.definitions || !dictionaryEntry.definitions.length}}">{{texts.noDefinition}}</view>
        </block>
      </view>
    </block>

    <view class="empty-state" wx:else>{{texts.empty}}</view>
  </view>
</block>
