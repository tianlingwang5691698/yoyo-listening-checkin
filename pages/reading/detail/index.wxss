.theme-dragon .blank-answer,
.theme-dragon .answer-sentence,
.theme-dragon .cloze-answer-box {
  border: 2rpx solid rgba(16, 46, 98, 0.28);
  border-radius: 6rpx;
  background: #fff3c4;
}

.theme-dragon .submit-button,
.theme-dragon .button-primary {
  border: 4rpx solid #102e62;
  border-radius: 7rpx;
  background: #f45a16;
  color: #ffffff;
  box-shadow: 0 7rpx 0 #a92e0a;
}

.theme-dragon .reading-ai-action {
  border: 3rpx solid #102e62;
  border-radius: 7rpx;
  background: #ffd83d;
  color: #102e62;
  font-weight: 800;
}

.theme-dragon .reading-result-card {
  border-color: #102e62;
  background: #fff3c4;
}

.reading-question-source-pages {
  width: 100%;
  margin: 0 0 24rpx;
}

.reading-question-source-page {
  display: block;
  width: 100%;
  background: #fff;
  border: 1rpx solid rgba(38, 48, 58, 0.14);
}

/* Four-theme review hierarchy. */
.library-reading-detail .receipt-label,
.theme-voyage.reading-detail .review-kicker,
.theme-dragon.reading-detail .review-kicker {
