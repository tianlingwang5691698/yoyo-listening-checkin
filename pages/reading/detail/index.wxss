  border-radius: 5rpx;
  background: rgba(255,248,224,.76);
  box-shadow: inset 0 -3rpx rgba(118,77,34,.08);
}

.theme-voyage .option-mark {
  align-self: stretch;
  border-right: 3rpx solid #b58a52;
  background: linear-gradient(180deg, #d7ad5c, #b77b35);
  color: #fff4d0;
}
.theme-voyage .option-key { color: inherit; font-family: Georgia, serif; font-weight: 800; }
.theme-voyage .option-row.is-selected { border-color: #1e6788; background: #d8e8e7; }
.theme-voyage .option-row.is-correct { border-color: #4d8165; background: #dce9d2; }
.theme-voyage .option-row.is-wrong { border-color: #a84d43; background: #efd5ca; }

.theme-voyage .submit-button,
.theme-voyage .button-primary {
  border: 4rpx solid #c28a42;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #c94a3c, #a42f2b);
  box-shadow: 0 7rpx 0 #733a22;
  color: #fff4d2;
  font-weight: 800;
}

.theme-voyage .reading-result-card {
  overflow: hidden;
  text-align: center;
  background:
    radial-gradient(circle at 50% 20%, rgba(230,187,85,.26), transparent 38%),
    #f5e2b5;
}
.theme-voyage .reading-result-card::before {
  content: "★";
  display: block;
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 16rpx;
  border: 7rpx double #a56c2e;
  border-radius: 50%;
  background: #1d6481;
  color: #f1cf69;
  font-size: 48rpx;
  line-height: 82rpx;
}
.theme-voyage .review-score { color: var(--voyage-red); font-family: Georgia, serif; }

.theme-voyage .dictionary-sheet {
  border: 5rpx solid #8c572c;
  border-radius: 8rpx 8rpx 0 0;
  background: #f7e8c3;
  box-shadow: 0 -18rpx 44rpx rgba(35,48,42,.28);
}
.theme-voyage .dictionary-audio,
.theme-voyage .dictionary-add { border-radius: 5rpx; background: #1c5c79; color: #fff2cb; }

/* Dragon: warm training paper with low-glare contrast for long-form reading. */
.theme-dragon.reading-detail {
  min-height: 100vh;
  padding: 34rpx 24rpx 150rpx;
  background:
    repeating-linear-gradient(135deg, rgba(16, 46, 98, 0.018) 0 3rpx, transparent 3rpx 28rpx),
    #fff2c8;
  color: #12346c;
}

.theme-dragon .detail-atmosphere { display: none; }

.theme-dragon .reading-paper {
  padding: 34rpx 28rpx 38rpx 34rpx;
  border: 4rpx solid #102e62;
  border-radius: 10rpx;
  background: #fff8dd;
  box-shadow: 0 9rpx 0 rgba(16, 46, 98, 0.16);
}

.theme-dragon .paper-corner {
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid #102e62;
  border-top: 0;
  border-right: 0;
  border-radius: 0 6rpx 0 10rpx;
  background: #ffd83d;
  box-shadow: none;
}

.theme-dragon .paper-margin-line {
  left: 18rpx;
  background: linear-gradient(180deg, transparent, rgba(244, 90, 22, 0.42), transparent);
}

.theme-dragon .passage-head {
  padding-right: 58rpx;
  padding-bottom: 20rpx;
  border-bottom: 3rpx solid rgba(16, 46, 98, 0.24);
}

.theme-dragon .passage-meta { color: #6b6680; }
.theme-dragon .passage-title { color: #102e62; font-weight: 800; }
.theme-dragon .reading-section-heading {
  color: #102e62;
}
.theme-dragon .reading-source-structure {
  border-bottom-color: rgba(16, 46, 98, 0.28);
}
.theme-dragon .reading-directions {
  border-left-color: #f45a16;
  background: #fff3c4;
  color: #244573;
}
.theme-dragon .reading-article-title {
  color: #102e62;
}
.theme-dragon .reading-article-subtitle {
  color: #655f73;
}
.theme-dragon .cloze-inline {
  min-width: 132rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}
.theme-dragon .cloze-inline-input {
  padding: 0 10rpx;
  border: 3rpx solid #102e62;
  border-radius: 7rpx;
  background: #fffef7;
  color: #102e62;
}

.theme-dragon .paper-body {
  border: 2rpx solid rgba(16, 46, 98, 0.22);
  border-radius: 8rpx;
  background:
    repeating-linear-gradient(180deg, transparent 0 60rpx, rgba(16, 46, 98, 0.045) 61rpx),
    #fffdf1;
  box-shadow: none;
}

.theme-dragon .passage-text,
.theme-dragon .cloze-passage-text { color: #17355f; }

.theme-dragon .passage-paragraph {
  border: 2rpx solid rgba(16, 46, 98, 0.20);
  border-radius: 8rpx;
  background: rgba(255, 250, 229, 0.86);
}

.theme-dragon .passage-paragraph-label {
  border-radius: 5rpx;
  background: rgba(255, 216, 61, 0.34);
  color: #244573;
}

.theme-dragon .reading-mark-toolbar {
  border: 2rpx solid rgba(16, 46, 98, 0.22);
  border-radius: 7rpx;
  background: #fff3c4;
}

.theme-dragon .reading-mark-hint,
.theme-dragon .reading-mark-clear { color: #244573; }

.theme-dragon .question-side-notes::before {
  background: linear-gradient(180deg, #ffd83d, #f45a16, #ffd83d);
}

.theme-dragon .question-card,
.theme-dragon .cloze-review-card,
.theme-dragon .review-card,
