}

.reading-result-effect {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 90;
}

.reading-effect-line {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 180rpx;
  background: linear-gradient(100deg, transparent 0%, rgba(255, 255, 255, 0.78) 48%, transparent 100%);
  transform: translateX(-160rpx);
  animation: readingResultShine 1.25s ease-out forwards;
}

.reading-effect-dot {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #df7f68;
  opacity: 0;
  animation: readingResultDot 1.12s ease-out forwards;
}

.reading-effect-dot.dot-one {
  top: 24%;
  right: 18%;
}

.reading-effect-dot.dot-two {
  top: 32%;
  right: 10%;
  background: #8db7d4;
  animation-delay: 0.1s;
}

@keyframes readingResultLift {
  0% {
    transform: translateY(10rpx);
  }
  100% {
    transform: translateY(0);
  }
}

@keyframes readingResultShine {
  0% {
    transform: translateX(-160rpx);
  }
  100% {
    transform: translateX(900rpx);
  }
}

@keyframes readingResultDot {
  0% {
    opacity: 0;
    transform: translateY(10rpx) scale(0.8);
  }
  35% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translateY(-24rpx) scale(1);
  }
}

