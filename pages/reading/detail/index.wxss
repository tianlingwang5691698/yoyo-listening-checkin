  margin-top: 22rpx;
  padding: 22rpx 0 0;
  border: 0;
  border-top: 2rpx solid rgba(16, 46, 98, 0.28);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.library-reading-detail .answer-sentence,
.library-reading-detail .cloze-evidence,
.theme-voyage.reading-detail .answer-sentence,
