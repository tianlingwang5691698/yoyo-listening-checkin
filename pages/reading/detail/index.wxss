.library-reading-detail .cloze-analysis-text,
.library-reading-detail .analysis-text.is-primary,
.theme-voyage.reading-detail .cloze-analysis-text,
.theme-voyage.reading-detail .analysis-text.is-primary,
.theme-dragon.reading-detail .cloze-analysis-text,
.theme-dragon.reading-detail .analysis-text.is-primary {
  font-size: var(--result-body-size);
