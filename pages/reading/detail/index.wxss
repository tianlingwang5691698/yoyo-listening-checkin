/* Grand Voyage: article log, captain question slips, brass controls. */
.theme-voyage.reading-detail {
  --voyage-ink: #173a50;
  --voyage-paper: #f8e9c4;
  --voyage-paper-deep: #ead19d;
  --voyage-brass: #af7832;
  --voyage-red: #a83b31;
  min-height: 100vh;
  padding: 58rpx 26rpx 150rpx;
  background:
    linear-gradient(180deg, #45b4df 0 130rpx, #0e7ead 131rpx 190rpx, #e7d1a2 191rpx, #f2e5c6 100%);
  color: var(--voyage-ink);
}

.theme-voyage .detail-atmosphere { display: none; }

.theme-voyage .reading-paper {
  padding: 42rpx 38rpx 48rpx;
  border: 5rpx solid #8d572c;
  border-radius: 7rpx;
  background:
    repeating-linear-gradient(0deg, rgba(103,69,32,.025) 0 2rpx, transparent 2rpx 18rpx),
    linear-gradient(100deg, #e6c98e, #fff1ca 8%, #f7e8c1 91%, #dfbd7d);
