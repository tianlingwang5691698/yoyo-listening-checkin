/* Reading study color system: words / phrases / patterns / answer sentences. */
.reading-detail .highlight-word,
.reading-detail .tab-word,
.reading-detail .word-text { color: #3f7f70; }
.reading-detail .highlight-phrase,
.reading-detail .tab-phrase,
.reading-detail .phrase-text { color: #3f6fa4; }
.reading-detail .highlight-pattern,
.reading-detail .tab-pattern,
