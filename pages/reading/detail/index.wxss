}

.theme-dragon .option-row {
  border: 3rpx solid rgba(16, 46, 98, 0.42);
  border-left-width: 7rpx;
  border-radius: 6rpx;
  background: #fffef7;
  color: #102e62;
}

.theme-dragon .option-key {
  border: 2rpx solid #102e62;
  border-radius: 4rpx;
  background: #ffd83d;
  color: #102e62;
}

.theme-dragon .option-row.is-selected {
  border-color: #f45a16;
  background: #fff0c0;
  color: #102e62;
}

.theme-dragon .option-row.is-correct {
  border-color: #28784c;
  background: #dff0d6;
  color: #185f39;
}

.theme-dragon .option-row.is-wrong {
  border-color: #b83b20;
  background: #f8d8c8;
  color: #8b2c18;
}

.theme-dragon .blank-input,
.theme-dragon .cloze-input {
  border: 3rpx solid #102e62;
  border-radius: 6rpx;
  background: #fffef7;
