}

.theme-dragon.reading-detail .answer-sentence,
.theme-dragon.reading-detail .cloze-evidence {
  border-left: 4rpx solid rgba(244, 90, 22, 0.72);
}

.library-reading-detail .answer-sentence-text,
.library-reading-detail .answer-sentence-translation,
.library-reading-detail .cloze-evidence-text,
.library-reading-detail .cloze-evidence-translation,
.theme-voyage.reading-detail .answer-sentence-text,
.theme-voyage.reading-detail .answer-sentence-translation,
.theme-voyage.reading-detail .cloze-evidence-text,
.theme-voyage.reading-detail .cloze-evidence-translation,
.theme-dragon.reading-detail .answer-sentence-text,
.theme-dragon.reading-detail .answer-sentence-translation,
.theme-dragon.reading-detail .cloze-evidence-text,
