.reading-detail {
  position: relative;
  width: 100vw;
  max-width: 100vw;
  min-height: 100vh;
  padding-top: 28rpx;
  padding-bottom: 132rpx;
  background: linear-gradient(180deg, #f6fbfd 0%, #edf6fa 46%, #f8fbfd 100%);
  color: #17314f;
  overflow-x: hidden;
}

.detail-atmosphere {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  overflow: hidden;
}

.detail-light {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(2rpx);
}

.detail-light.light-one {
  top: -118rpx;
  right: -126rpx;
  width: 420rpx;
  height: 420rpx;
  background: rgba(191, 215, 232, 0.42);
}

.detail-light.light-two {
  top: 620rpx;
  left: -190rpx;
  width: 460rpx;
  height: 460rpx;
  background: rgba(242, 161, 142, 0.1);
}

.passage-card,
.question-card,
.review-card,
.cloze-review-card,
.retry-card,
.empty-state {
  position: relative;
  z-index: 1;
}

.reading-paper {
  width: 100%;
  max-width: 100%;
  margin-bottom: 24rpx;
  padding: 32rpx 24rpx 30rpx 34rpx;
  border-radius: 18rpx 34rpx 34rpx 18rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(249, 253, 254, 0.94));
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 24rpx 60rpx rgba(91, 132, 160, 0.14);
  overflow: hidden;
}

.paper-corner {
  position: absolute;
  top: 0;
  right: 0;
  width: 58rpx;
  height: 58rpx;
  border-radius: 0 34rpx 0 18rpx;
  background: linear-gradient(135deg, rgba(191, 215, 232, 0.58), rgba(255, 255, 255, 0.98));
  box-shadow: -10rpx 10rpx 18rpx rgba(91, 132, 160, 0.07);
}

.paper-margin-line {
  position: absolute;
  top: 34rpx;
  bottom: 34rpx;
  left: 18rpx;
  width: 1rpx;
  background: linear-gradient(180deg, transparent, rgba(242, 161, 142, 0.34), rgba(141, 183, 212, 0.34), transparent);
}

.passage-head {
  padding: 4rpx 42rpx 0 6rpx;
}

.passage-meta {
  color: #728196;
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 500;
}

.passage-title {
  margin-top: 12rpx;
  color: #17314f;
  font-size: 38rpx;
  line-height: 1.22;
  font-weight: 600;
}

.paper-body {
  margin-top: 24rpx;
  padding: 34rpx 28rpx 34rpx 34rpx;
  border-radius: 10rpx 26rpx 26rpx 10rpx;
  background:
    linear-gradient(90deg, rgba(141, 183, 212, 0.13) 0 2rpx, transparent 2rpx),
    linear-gradient(180deg, #ffffff, #fafdfe);
  border: 1rpx solid rgba(191, 215, 232, 0.28);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
}

.reading-mark-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 64rpx;
  margin-top: 20rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(23, 49, 79, 0.14);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
  box-sizing: border-box;
}

.reading-mark-hint {
  flex: 1;
  color: #60738a;
  font-size: 22rpx;
  line-height: 1.45;
}

.reading-mark-clear {
  flex: none;
  min-height: 48rpx;
  padding: 0 14rpx;
  color: #17314f;
  font-size: 23rpx;
  line-height: 48rpx;
  font-weight: 700;
}

.reading-mark-word,
.reading-mark-phrase,
.reading-mark-sentence-token {
  -webkit-box-decoration-break: clone;
  box-decoration-break: clone;
  border-radius: 5rpx;
}

.reading-mark-word {
  background: rgba(255, 210, 69, 0.58);
  box-shadow: inset 0 -2rpx 0 rgba(211, 148, 0, 0.34);
}

.reading-mark-phrase {
  background: rgba(91, 169, 233, 0.34);
  box-shadow: inset 0 -3rpx 0 rgba(31, 105, 172, 0.34);
}

.passage-segment.reading-mark-sentence {
  background: rgba(92, 177, 119, 0.20);
  box-shadow: inset 4rpx 0 0 rgba(46, 129, 77, 0.48);
}

.reading-mark-sentence-token {
  background: rgba(92, 177, 119, 0.22);
}

.cloze-reading-token {
  position: relative;
}

.passage-text {
  color: #17314f;
  font-size: 32rpx;
  line-height: 1.82;
  white-space: pre-wrap;
  word-break: normal;
  overflow-wrap: break-word;
}

.reading-source-structure {
  margin-bottom: 30rpx;
  padding-bottom: 26rpx;
  border-bottom: 1rpx solid rgba(141, 183, 212, 0.34);
}

.reading-section-heading {
  margin-bottom: 14rpx;
  color: #587087;
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 700;
  letter-spacing: 0;
}

.reading-directions {
  margin-bottom: 22rpx;
  padding: 16rpx 18rpx;
  border-left: 6rpx solid #8db7d4;
  background: rgba(141, 183, 212, 0.10);
  color: #4b6479;
  font-size: 26rpx;
  line-height: 1.65;
  font-style: italic;
  font-family: "Kaiti SC", KaiTi, serif;
  letter-spacing: 0;
}

.reading-article-title {
  color: #17314f;
  font-size: 40rpx;
  line-height: 1.38;
  font-weight: 800;
  font-family: Georgia, "Songti SC", STSong, serif;
  text-align: center;
  letter-spacing: 0;
}

.reading-article-subtitle {
  margin-top: 10rpx;
  color: #657789;
  font-size: 27rpx;
  line-height: 1.5;
  font-style: italic;
  font-family: Georgia, "Kaiti SC", KaiTi, serif;
  text-align: center;
  letter-spacing: 0;
}

.theme-warm.reading-detail .reading-section-heading {
  color: #8f5f56;
}

.theme-warm.reading-detail .reading-source-structure {
  border-bottom-color: #efc8bd;
}

.theme-warm.reading-detail .reading-directions {
  border-left-color: #df8068;
  background: #fff5f0;
  color: #614f4b;
}

.theme-warm.reading-detail .reading-article-title {
  color: #17314f;
}

.theme-warm.reading-detail .reading-article-subtitle {
  color: #8a6a65;
}

.theme-warm.reading-detail .cloze-inline {
  min-width: 128rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.theme-warm.reading-detail .cloze-inline-input {
  padding: 0 10rpx;
  border: 2rpx solid #d99a89;
  border-radius: 8rpx;
  background: #fffdfb;
}

.passage-paragraph {
  margin-bottom: 28rpx;
  padding: 18rpx 16rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.32);
  border-radius: 18rpx;
  background: rgba(247, 251, 253, 0.82);
}

.passage-paragraph:last-child {
  margin-bottom: 0;
}

.passage-paragraph.is-subtitle {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
  border-color: transparent;
  background: transparent;
  text-align: center;
  font-style: italic;
}

.passage-paragraph-label {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  margin-bottom: 10rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.18);
  color: #52738f;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.passage-paragraph-content {
  display: block;
  width: 100%;
  min-width: 0;
}

.passage-paragraph-main {
  width: 100%;
  min-width: 0;
}

.passage-source-label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 42rpx;
  min-height: 42rpx;
  margin-bottom: 12rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.18);
  box-sizing: border-box;
  color: #17648f;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 800;
  text-align: center;
}

.passage-paragraph .passage-segment {
  padding-left: 0;
}

.passage-paragraph .passage-segment::before {
  display: none;
}

.passage-source-images {
  margin-top: 24rpx;
}

.passage-source-image {
  display: block;
  width: 100%;
  height: auto;
  margin-top: 16rpx;
  background: #ffffff;
  border: 1rpx solid rgba(141, 183, 212, 0.24);
  border-radius: 8rpx;
}

.cloze-passage-text {
  color: #17314f;
  font-size: 32rpx;
  line-height: 1.82;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.cloze-inline {
  display: inline-flex;
  align-items: center;
  min-width: 150rpx;
  height: 54rpx;
  margin: 0 6rpx;
  padding: 0 10rpx;
  border-radius: 14rpx;
  background: rgba(237, 246, 250, 0.72);
  border: 1rpx solid rgba(141, 183, 212, 0.24);
  vertical-align: -12rpx;
}

.cloze-inline-initial {
  flex-shrink: 0;
  color: #17314f;
  font-size: 30rpx;
  font-weight: 600;
}

.cloze-inline-input {
  width: 108rpx;
  height: 52rpx;
  padding: 0;
  color: #17314f;
  font-size: 28rpx;
  background: transparent;
}

.cloze-inline-input.is-correct {
  color: #5f8b82;
}

.cloze-inline-input.is-wrong {
  color: #df7f68;
}

.highlight-actions,
.review-tabs {
  width: 100%;
  max-width: 100%;
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  padding: 0;
  border-radius: 22rpx;
  background: rgba(237, 246, 250, 0.76);
  border: 1rpx solid rgba(191, 215, 232, 0.38);
  overflow: hidden;
}

.highlight-button,
.review-tab {
  width: 33.333333%;
  flex: 0 0 33.333333%;
  min-width: 0;
  min-height: 66rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 0;
  border-radius: 0;
  border-right: 1rpx solid rgba(141, 183, 212, 0.16);
  background: transparent;
  box-shadow: none;
  color: #607087;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.highlight-button:nth-child(3n),
.review-tab:last-child {
  border-right: 0;
}

.highlight-button:nth-last-child(-n + 3) {
  border-bottom: 0;
}

.highlight-button.is-active,
.review-tab.is-active.tab-word,
.review-tab.is-active.tab-phrase,
.review-tab.is-active.tab-pattern {
  background: rgba(141, 183, 212, 0.2);
  color: #17314f;
}

.highlight-button.is-loading,
.review-tab.is-loading {
  opacity: 0.72;
}

.button-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #df7f68;
}

.passage-segment {
  position: relative;
  display: block;
  max-width: 100%;
  padding: 5rpx 0 5rpx 16rpx;
  border-radius: 10rpx;
  background: transparent;
  word-break: normal;
  overflow-wrap: break-word;
}

.passage-segment::before {
  content: "";
  position: absolute;
  left: 0;
  top: 17rpx;
  bottom: 17rpx;
  width: 3rpx;
  border-radius: 999rpx;
  background: rgba(191, 215, 232, 0.28);
}

.passage-segment:active {
  background: rgba(237, 246, 250, 0.72);
}

.segment-answer,
.segment-word,
.segment-phrase,
.segment-pattern {
  -webkit-box-decoration-break: clone;
  box-decoration-break: clone;
}

.passage-chunk.segment-word,
.passage-chunk.segment-phrase,
.passage-chunk.segment-pattern {
  display: inline;
  padding: 2rpx 6rpx;
  margin: 0 2rpx;
}

.segment-answer {
  background: rgba(242, 161, 142, 0.2);
  color: #9b604f;
  border-radius: 8rpx;
  box-shadow: inset 0 -2rpx 0 rgba(242, 161, 142, 0.28);
}

.segment-word {
  background: rgba(134, 170, 161, 0.18);
  color: #5f8b82;
  border-radius: 8rpx;
  box-shadow: inset 0 -2rpx 0 rgba(134, 170, 161, 0.22);
}

.segment-phrase {
  background: rgba(141, 183, 212, 0.2);
  color: #577f9d;
  border-radius: 8rpx;
  box-shadow: inset 0 -2rpx 0 rgba(141, 183, 212, 0.22);
}

.segment-pattern {
  background: rgba(191, 215, 232, 0.24);
  color: #415f78;
  border-radius: 8rpx;
  box-shadow: inset 0 -2rpx 0 rgba(141, 183, 212, 0.18);
}

.segment-label,
.segment-note {
  display: inline-block;
  margin-right: 6rpx;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.35;
  font-weight: 600;
  vertical-align: 4rpx;
}

.segment-note {
  max-width: 100%;
  margin-right: 0;
  margin-left: 6rpx;
  color: #607087;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.segment-answer .segment-label {
  background: rgba(242, 161, 142, 0.18);
  color: #9b604f;
}

.segment-answer .segment-note {
  display: block;
  max-width: calc(100vw - 112rpx);
  margin: 8rpx 0 0;
  padding: 8rpx 12rpx;
  line-height: 1.45;
}

.segment-word .segment-note {
  background: rgba(134, 170, 161, 0.13);
  color: #5f8b82;
}

.segment-phrase .segment-note,
.segment-pattern .segment-note {
  background: rgba(141, 183, 212, 0.15);
  color: #577f9d;
}

.sentence-translation-inline {
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(237, 246, 250, 0.86);
  color: #607087;
  font-size: 25rpx;
  line-height: 1.45;
}

.question-card,
.review-card,
.cloze-review-card {
  width: 100%;
  max-width: 100%;
  margin-bottom: 18rpx;
  padding: 24rpx 22rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.66);
  border: 1rpx solid rgba(191, 215, 232, 0.34);
  box-shadow: 0 14rpx 34rpx rgba(91, 132, 160, 0.09);
  overflow: hidden;
}

.question-side-notes {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  padding-left: 28rpx;
}

.question-side-notes::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 18rpx;
  bottom: 32rpx;
  width: 2rpx;
  background: linear-gradient(180deg, rgba(141, 183, 212, 0.18), rgba(242, 161, 142, 0.28), rgba(141, 183, 212, 0.18));
}

.question-card {
  margin-bottom: 16rpx;
  padding: 22rpx 20rpx 22rpx 24rpx;
  border-radius: 10rpx 24rpx 24rpx 10rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.72), rgba(237, 246, 250, 0.48));
  border-color: rgba(191, 215, 232, 0.28);
  box-shadow: none;
}

.answer-locator {
  position: absolute;
  left: -28rpx;
  top: 34rpx;
  width: 28rpx;
  height: 2rpx;
  background: rgba(242, 161, 142, 0.42);
}

.answer-locator::after {
  content: "";
  position: absolute;
  left: -7rpx;
  top: -5rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #f2a18e;
}

.question-title {
  color: #17314f;
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 600;
}

.reading-question-group-head {
  margin: 0 0 20rpx;
  padding: 18rpx 20rpx;
  border-left: 6rpx solid #f2a18e;
  background: rgba(237, 246, 250, 0.72);
}

.reading-question-group-range {
  color: #17314f;
  font-size: 25rpx;
  line-height: 1.3;
  font-weight: 700;
}

.reading-question-group-title {
  margin-top: 8rpx;
  color: #17314f;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 700;
}

.reading-question-group-instruction {
  margin-top: 8rpx;
  color: #607087;
  font-size: 24rpx;
  line-height: 1.5;
}

.reading-note-heading {
  margin-bottom: 16rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid rgba(242, 161, 142, 0.36);
  color: #17314f;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 700;
}

.option-list {
  width: 100%;
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: stretch;
}

.option-row {
  width: 100%;
  max-width: 100%;
  min-height: 76rpx;
  margin: 0;
  padding: 16rpx 18rpx;
  border-radius: 14rpx 18rpx 18rpx 14rpx;
  background: rgba(255, 255, 255, 0.62);
  border-left: 4rpx solid rgba(141, 183, 212, 0.24);
  color: #17314f;
  display: grid;
  grid-template-columns: 64rpx minmax(0, 1fr);
  align-items: start;
  column-gap: 16rpx;
  text-align: left;
  box-sizing: border-box;
}

.option-row::after {
  border: 0;
}

.option-row.is-selected {
  background: rgba(141, 183, 212, 0.16);
  border-left-color: rgba(141, 183, 212, 0.72);
  color: #17314f;
}

.option-row.is-correct {
  background: rgba(134, 170, 161, 0.18);
  border-left-color: rgba(134, 170, 161, 0.78);
  color: #5f8b82;
}

.option-row.is-wrong {
  background: rgba(242, 161, 142, 0.18);
  border-left-color: rgba(242, 161, 142, 0.74);
  color: #b86d59;
}

.option-row.is-locked {
  opacity: 1;
}

.option-mark {
  width: 64rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.option-key {
  width: 44rpx;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 600;
  text-align: center;
}

.option-text {
  min-width: 0;
  font-size: 27rpx;
  line-height: 1.48;
  word-break: normal;
  overflow-wrap: break-word;
  text-align: left;
}

.option-source-image {
  display: block;
  width: 100%;
  height: auto;
  margin: 0 0 8rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.24);
  border-radius: 8rpx;
  background: #ffffff;
}

.option-badge {
  max-width: 64rpx;
  padding: 4rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(134, 170, 161, 0.18);
  color: #5f8b82;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 600;
  text-align: center;
}

.option-badge.wrong {
  background: rgba(242, 161, 142, 0.2);
  color: #b86d59;
}

.blank-answer-box {
  margin-top: 18rpx;
}

.blank-input {
  width: 100%;
  min-height: 78rpx;
  padding: 0 22rpx;
  border-radius: 14rpx 18rpx 18rpx 14rpx;
  background: rgba(255, 255, 255, 0.68);
  border-left: 4rpx solid rgba(141, 183, 212, 0.28);
  color: #17314f;
  font-size: 28rpx;
  box-sizing: border-box;
}

.blank-input.is-correct {
  background: rgba(134, 170, 161, 0.18);
  color: #5f8b82;
}

.blank-input.is-wrong {
  background: rgba(242, 161, 142, 0.18);
  color: #b86d59;
}

.blank-answer {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(134, 170, 161, 0.16);
  color: #5f8b82;
  font-size: 26rpx;
  line-height: 1.45;
}

.submit-button {
  position: relative;
  z-index: 1;
  min-height: 92rpx;
  margin: 14rpx 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f2a18e, #df7f68);
  box-shadow: 0 18rpx 34rpx rgba(223, 127, 104, 0.18);
}

.reading-ai-action {
  position: relative;
  z-index: 1;
  margin: 18rpx 0;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(88, 123, 152, 0.28);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #587b98;
  font-size: 26rpx;
  line-height: 1.35;
  text-align: center;
}

.reading-ai-action.is-ready {
  border-color: rgba(134, 170, 161, 0.36);
  color: #4f776e;
}

.reading-ai-message {
  position: relative;
  z-index: 1;
  margin: -4rpx 0 18rpx;
  color: #607087;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.reading-analysis-debug {
  position: relative;
  z-index: 1;
  margin: 14rpx 0 20rpx;
  padding: 18rpx;
  border: 1rpx dashed rgba(155, 95, 84, 0.48);
  border-radius: 8rpx;
  background: rgba(255, 253, 247, 0.9);
  color: #9b5f54;
}

.reading-analysis-debug text {
  display: block;
  font-size: 22rpx;
  line-height: 1.55;
  word-break: break-all;
}

.reading-result-card {
  position: relative;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.86), rgba(237, 246, 250, 0.68));
}

.reading-result-card.is-celebrating {
