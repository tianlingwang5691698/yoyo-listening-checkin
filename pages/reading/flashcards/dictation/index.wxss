.dictation-nav { position: fixed; left: 0; right: 0; top: 0; z-index: 90; background: rgba(246,251,253,.94); border-bottom: 1rpx solid rgba(141,183,212,.18); backdrop-filter: blur(22rpx); }
.dictation-back { position: absolute; left: 24rpx; bottom: 12rpx; width: 56rpx; height: 56rpx; font-size: 60rpx; line-height: 48rpx; text-align: center; }
.dictation-nav-title { position: absolute; left: 140rpx; right: 140rpx; bottom: 20rpx; font-size: 32rpx; font-weight: 600; text-align: center; }
.dictation-page { box-sizing: border-box; min-height: 100vh; padding: 40rpx 28rpx calc(60rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg,#f6fbfd,#edf6fa); color: #17314f; }
.dictation-preview, .dictation-debug { margin-bottom: 20rpx; padding: 16rpx 20rpx; border-radius: 16rpx; }
.dictation-preview { background: #fff3cf; color: #785d22; text-align: center; }
.dictation-debug { background: #fff1ef; color: #9a4038; font-size: 22rpx; line-height: 1.6; }
.dictation-debug text { display: block; }
.dictation-hero { margin-bottom: 28rpx; }
.dictation-kicker { font-size: 20rpx; letter-spacing: 3rpx; color: #7895a7; }
.dictation-title { margin-top: 10rpx; font-size: 42rpx; font-weight: 700; }
.dictation-menu, .dictation-card, .dictation-complete, .dictation-today { box-sizing: border-box; border: 1rpx solid rgba(255,255,255,.8); border-radius: 28rpx; background: rgba(255,255,255,.78); box-shadow: 0 18rpx 44rpx rgba(71,112,138,.11); backdrop-filter: blur(22rpx); }
.dictation-menu, .dictation-card { padding: 28rpx; }
.dictation-menu > view, .dictation-menu > button { box-sizing: border-box; width: 100%; }
.dictation-today { margin: 0 0 20rpx; padding: 22rpx; }
.dictation-today > view:first-child { display: flex; justify-content: space-between; }
.dictation-today-bar { height: 10rpx; margin-top: 18rpx; border-radius: 10rpx; background: #dceaf0; overflow: hidden; }
.dictation-today-bar view { height: 100%; background: #5f91aa; }
.dictation-count-picker { margin: 0 0 24rpx; padding: 22rpx 22rpx 18rpx; border-radius: 22rpx; background: rgba(230,240,245,.72); }
.dictation-count-head { display: flex; align-items: center; justify-content: space-between; color: #66808f; font-size: 24rpx; }
.dictation-count-total { color: #315d73; font-size: 30rpx; font-weight: 700; }
.dictation-count-controls { display: flex; align-items: center; justify-content: center; gap: 28rpx; margin-top: 20rpx; }
.dictation-count-controls button { width: 66rpx; height: 66rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: #fff; color: #315d73; font-size: 34rpx; line-height: 66rpx; }
.dictation-count-controls view { min-width: 130rpx; text-align: center; }
.dictation-count-controls text { display: block; }
.dictation-count-controls text:first-child { font-size: 42rpx; font-weight: 700; }
.dictation-count-controls text:last-child { margin-top: 4rpx; color: #78909e; font-size: 21rpx; }
.dictation-count-slider { margin: 16rpx -10rpx 0; }
.dictation-count-hint { margin-top: -4rpx; color: #8ba0ad; font-size: 20rpx; text-align: center; }
.dictation-action, .dictation-history, .dictation-change-mode, .dictation-wrong-actions button, .dictation-play { box-sizing: border-box; margin: 18rpx 0 0; border: 0; border-radius: 18rpx; font-size: 28rpx; }
.dictation-action::after, .dictation-history::after, .dictation-change-mode::after, .dictation-wrong-actions button::after, .dictation-play::after { border: 0; }
.dictation-action.primary { display: flex; align-items: center; justify-content: center; width: 100%; height: 92rpx; margin: 0; padding: 0 24rpx; line-height: 1.2; background: #315d73; color: #fff; text-align: center; }
.dictation-card > .dictation-action.primary { margin-top: 24rpx; }
.dictation-wrong-actions { display: flex; gap: 16rpx; margin-top: 18rpx; }
.dictation-wrong-actions button { flex: 1; min-width: 0; min-height: 84rpx; margin: 0; padding: 12rpx; background: #dcebf1; color: #244c60; }
.dictation-history { width: 100%; height: 76rpx; margin: 8rpx 0 0; padding: 0; line-height: 76rpx; background: transparent; color: #315d73; text-align: center; }
.dictation-change-mode { width: 100%; height: 76rpx; margin: 12rpx 0 0; padding: 0; line-height: 76rpx; background: transparent; color: #315d73; text-align: center; }
.dictation-progress { text-align: right; color: #7895a7; }
.dictation-play { display: flex; align-items: center; justify-content: center; width: 240rpx; height: 82rpx; margin: 30rpx auto; padding: 0 20rpx; line-height: 1.2; background: #dcebf1; color: #244c60; text-align: center; }
.dictation-audio-hint { margin: -10rpx 0 22rpx; padding: 18rpx 20rpx; border-radius: 16rpx; background: #fff3cf; color: #785d22; font-size: 24rpx; line-height: 1.55; text-align: center; }
.dictation-audio-hint text { display: block; }
.dictation-audio-hint text:last-child { margin-top: 6rpx; color: #17314f; font-size: 28rpx; font-weight: 600; }
.dictation-input { box-sizing: border-box; width: 100%; height: 96rpx; padding: 0 24rpx; border: 2rpx solid #b8d0dc; border-radius: 20rpx; background: #fff; font-size: 34rpx; text-align: center; }
.dictation-input.is-correct { border-color: #5d9b78; }
.dictation-input.is-wrong { border-color: #bf6b62; }
.dictation-answer { margin-top: 24rpx; padding: 22rpx; border-radius: 20rpx; background: #edf5f8; }
.dictation-answer > view { display: flex; justify-content: space-between; margin-top: 12rpx; }
.dictation-answer > view:first-child { margin-top: 0; }
.dictation-answer-word { font-weight: 700; }
.dictation-result.is-correct { color: #397b58; }
.dictation-result.is-wrong { color: #a54e46; }
.dictation-meaning { display: block !important; color: #587487; line-height: 1.7; }
.study { text-align: center; }
.study-word { margin-top: 30rpx; font-size: 54rpx; font-weight: 700; }
.study-phonetic { margin-top: 12rpx; color: #6e8a9a; }
.study-meaning { margin-top: 24rpx; font-size: 30rpx; line-height: 1.7; }
.study-wrong { margin-top: 18rpx; color: #a54e46; }
.dictation-complete { position: relative; overflow: hidden; padding: 48rpx 28rpx; text-align: center; }
.complete-mark { position: relative; z-index: 2; margin: auto; width: 100rpx; height: 100rpx; border-radius: 50%; background: #5d9b78; color: #fff; font-size: 58rpx; line-height: 100rpx; animation: vocabCompletePop .88s cubic-bezier(.2,1.35,.28,1) both; }
.complete-title { margin-top: 24rpx; font-size: 40rpx; font-weight: 700; }
.complete-numbers { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(4,1fr); gap: 12rpx; margin: 40rpx 0; }
.complete-numbers view { display: flex; flex-direction: column; }
.complete-numbers text:first-child { font-size: 40rpx; font-weight: 700; }
.complete-numbers text:last-child { margin-top: 8rpx; color: #6e8a9a; }
.celebrate-burst { position: absolute; top: 18rpx; left: 50%; z-index: 1; width: 240rpx; height: 240rpx; transform: translateX(-50%); pointer-events: none; animation: vocabBurstFade 1.5s ease-out both; }
.celebrate-burst text { position: absolute; top: 50%; left: 50%; width: 8rpx; height: 76rpx; border-radius: 999rpx; background: rgba(239,178,103,.58); transform-origin: 50% 100%; }
.celebrate-burst text:nth-child(1){transform:translate(-50%,-100%) rotate(0deg)}.celebrate-burst text:nth-child(2){transform:translate(-50%,-100%) rotate(60deg)}.celebrate-burst text:nth-child(3){transform:translate(-50%,-100%) rotate(120deg)}.celebrate-burst text:nth-child(4){transform:translate(-50%,-100%) rotate(180deg)}.celebrate-burst text:nth-child(5){transform:translate(-50%,-100%) rotate(240deg)}.celebrate-burst text:nth-child(6){transform:translate(-50%,-100%) rotate(300deg)}
.confetti-layer { position: absolute; inset: 0; z-index: 1; overflow: hidden; pointer-events: none; }
.confetti { position: absolute; top: -36rpx; width: 12rpx; height: 30rpx; border-radius: 4rpx; opacity: 0; animation: vocabConfettiFall 2.6s ease-in-out infinite; }
.confetti-1{left:8%;background:#8db7d4}.confetti-2{left:16%;background:#efb267;animation-delay:.18s}.confetti-3{left:25%;background:#86aaa1;animation-delay:.34s}.confetti-4{left:34%;background:#c57d2d;animation-delay:.08s}.confetti-5{left:43%;background:#8db7d4;animation-delay:.5s}.confetti-6{left:52%;background:#efb267;animation-delay:.26s}.confetti-7{left:60%;background:#86aaa1;animation-delay:.62s}.confetti-8{left:68%;background:#c57d2d;animation-delay:.42s}.confetti-9{left:76%;background:#8db7d4;animation-delay:.12s}.confetti-10{left:84%;background:#efb267;animation-delay:.56s}.confetti-11{left:91%;background:#86aaa1;animation-delay:.3s}.confetti-12{left:47%;background:#c57d2d;animation-delay:.72s}
@keyframes vocabCompletePop{0%{opacity:0;transform:scale(.72)}70%{opacity:1;transform:scale(1.08)}100%{opacity:1;transform:scale(1)}}
@keyframes vocabBurstFade{0%{opacity:0;transform:translateX(-50%) scale(.55) rotate(-12deg)}35%{opacity:1}100%{opacity:0;transform:translateX(-50%) scale(1.25) rotate(8deg)}}
@keyframes vocabConfettiFall{0%{opacity:0;transform:translateY(-20rpx) rotate(0)}18%{opacity:1}100%{opacity:0;transform:translateY(620rpx) rotate(420deg)}}
.theme-library.dictation-page { background: #eee7d8; color: #2f2924; }
.theme-library .dictation-menu, .theme-library .dictation-card, .theme-library .dictation-complete, .theme-library .dictation-today { border-color: rgba(69,54,42,.12); background: rgba(249,245,234,.88); box-shadow: 0 16rpx 36rpx rgba(62,49,38,.12); }
.theme-library .dictation-action.primary { background: #4b6571; }
.theme-library .dictation-play { border: 1rpx solid rgba(87,68,48,.12); background: #e6dac6; color: #594c3f; }
.theme-library .dictation-audio-hint { border: 1rpx solid rgba(111,87,65,.18); border-radius: 6rpx; background: #eadfcd; color: #7b6547; }
.theme-library .dictation-audio-hint text:last-child { color: #2f2924; }
.theme-library .dictation-input { border-color: #b9aa91; background: #fffdf7; }
.theme-library .dictation-count-picker { background: rgba(235,225,207,.72); }
.theme-library .dictation-count-hint { color: #8a7b69; }
.theme-library .dictation-change-mode { color: #6f5741; }
.language-en .dictation-wrong-actions button { font-size: 22rpx; line-height: 1.3; }
.language-en .dictation-play { font-size: 26rpx; }
.language-en .complete-numbers text:last-child { font-size: 20rpx; }
