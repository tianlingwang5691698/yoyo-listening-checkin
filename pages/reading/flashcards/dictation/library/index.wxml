<view class="dictation-library-nav theme-{{theme}}" style="{{navStyle}}"><view class="dictation-library-back" bindtap="handleBack">‹</view><view class="dictation-library-nav-title">{{texts.shelfTitle}}</view></view>
<view class="theme-{{theme}} language-{{language}} dictation-library-page" style="{{pageTopStyle}}">
  <view class="dictation-library-head"><view><view class="dictation-library-kicker">LISTEN · SPELL · REVIEW</view><view class="dictation-library-title">{{title}}</view><view class="dictation-library-copy">{{subtitle}}</view></view><view class="dictation-library-record" bindtap="openHistory">{{texts.records}}</view></view>
  <view class="dictation-library-debug" wx:if="{{debugLines.length}}"><text selectable="{{true}}" wx:for="{{debugLines}}" wx:key="*this">{{item}}</text></view>
  <view class="dictation-library-list">
    <view class="dictation-library-book {{loadingKey === item.key ? 'is-loading' : ''}}" wx:for="{{items}}" wx:key="key" data-key="{{item.key}}" bindtap="chooseItem">
      <view class="dictation-library-mark">{{item.mark}}</view><view class="dictation-library-main"><view class="dictation-library-book-title">{{item.title}}</view><view class="dictation-library-meta" wx:if="{{loadingKey === item.key}}">{{texts.opening}}</view><view class="dictation-library-meta" wx:else>{{texts.learned}} {{countsLoaded ? item.learnedCount : '--'}} {{texts.wordUnit}} · {{item.meta}}</view></view><view class="dictation-library-arrow">›</view>
    </view>
  </view>
</view>
