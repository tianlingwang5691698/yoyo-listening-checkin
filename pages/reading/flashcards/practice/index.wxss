.word-practice-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 90;
  border-bottom: 1rpx solid rgba(141, 183, 212, 0.18);
  background: rgba(246, 251, 253, 0.94);
  backdrop-filter: blur(22rpx);
}
.word-practice-back {
  position: absolute;
  left: 24rpx;
  bottom: 12rpx;
  width: 56rpx;
  height: 56rpx;
  font-size: 60rpx;
  line-height: 48rpx;
  text-align: center;
}
.word-practice-nav-title {
  position: absolute;
  left: 140rpx;
  right: 140rpx;
  bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}
.word-practice-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 38rpx 28rpx calc(60rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #f6fbfd, #edf6fa);
  color: #17314f;
}
.word-practice-head {
  padding: 34rpx 34rpx 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 26rpx;
  background: linear-gradient(
    135deg,
    rgba(34, 59, 77, 0.96),
    rgba(28, 52, 72, 0.94)
  );
  box-shadow: 0 18rpx 42rpx rgba(33, 66, 89, 0.16);
}
.word-practice-kicker {
  color: #c6a167;
  font-size: 19rpx;
  letter-spacing: 2.6rpx;
}
.word-practice-title {
  margin-top: 12rpx;
  color: #fff;
  font-size: 42rpx;
  font-weight: 700;
}
.word-practice-copy {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 1.5;
}
.word-practice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 28rpx;
}
.word-practice-card {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 154rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 15rpx 34rpx rgba(71, 112, 138, 0.1);
}
.word-practice-card:active {
  opacity: 0.92;
  transform: scale(0.993);
}
.word-practice-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 86rpx;
  height: 86rpx;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #6f9fb7, #416f86);
  color: #fff;
  font-family: Georgia, serif;
  font-size: 34rpx;
  font-weight: 700;
}
.word-practice-mark.audio-mark {
  border-radius: 50%;
  font-size: 42rpx;
}
.word-practice-mark.spell-mark {
  font-size: 28rpx;
}
.word-practice-main {
  min-width: 0;
  flex: 1;
  margin-left: 24rpx;
}
.word-practice-card-title {
  font-size: 31rpx;
  font-weight: 700;
}
.word-practice-card-copy {
  margin-top: 8rpx;
  color: #718a9a;
  font-size: 23rpx;
  line-height: 1.45;
}
.word-practice-arrow {
  margin-left: 14rpx;
  color: #7894a4;
  font-size: 50rpx;
}
.word-practice-route {
  display: none;
}
.theme-library.word-practice-page {
  background: #eee7d8;
  color: #2f2924;
}
.theme-library .word-practice-head {
  border-color: rgba(115, 88, 55, 0.22);
  border-radius: 10rpx;
  background: linear-gradient(
    90deg,
    rgba(43, 33, 27, 0.96),
    rgba(20, 40, 58, 0.94)
  );
}
.theme-library .word-practice-title,
.theme-library .word-practice-card-title {
  font-family: "Songti SC", STSong, serif;
}
.theme-library .word-practice-card {
  border-color: rgba(69, 54, 42, 0.18);
  border-radius: 7rpx;
  background: #f7efdf;
  box-shadow: 0 12rpx 28rpx rgba(43, 33, 27, 0.12);
}
.theme-library .word-practice-mark {
  border-radius: 5rpx;
  background: #496b7a;
}
.theme-library .word-practice-card-copy {
  color: #766b60;
}
.theme-library .word-practice-arrow {
  color: #a7824d;
}
.language-en .word-practice-card-title {
  font-size: 28rpx;
}
.language-en .word-practice-card-copy {
  font-size: 21rpx;
}

.theme-voyage.word-practice-nav {
  border-bottom: 5rpx solid #c18a3e;
  background: linear-gradient(180deg, #1e6382, #173f57);
  box-shadow: 0 7rpx 0 #6d4021;
  color: #fff2ca;
}
.theme-voyage .word-practice-back,
.theme-voyage .word-practice-nav-title { color: #fff2ca; }
.theme-voyage.word-practice-page {
  background:
    linear-gradient(135deg, transparent 0 46%, rgba(255, 244, 214, 0.14) 46% 48%, transparent 48% 100%) 0 120rpx / 240rpx 180rpx,
    radial-gradient(circle at 84% 244rpx, rgba(255, 244, 214, 0.3) 0 5rpx, transparent 6rpx),
    linear-gradient(180deg, #54bde3 0 112rpx, #107da9 113rpx 170rpx, #e4ce9c 171rpx, #f3e6c6 100%);
  color: #173d55;
}
.theme-voyage .word-practice-head {
  position: relative;
  overflow: hidden;
  min-height: 196rpx;
  padding-right: 190rpx;
  border: 5rpx solid #8d572c;
  border-radius: 7rpx;
  background:
    linear-gradient(22deg, transparent 0 46%, rgba(130, 89, 42, 0.12) 47% 48%, transparent 49% 100%),
    repeating-linear-gradient(0deg, rgba(99,64,29,.025) 0 2rpx, transparent 2rpx 18rpx),
    linear-gradient(100deg, #e6c88b, #fff0c4 11%, #f5e2b5 91%, #d8b16c);
  box-shadow: 0 9rpx 0 #693d20, 0 20rpx 34rpx rgba(4,66,89,.22), inset 0 0 24rpx rgba(104,63,25,.12);
}
.theme-voyage .word-practice-head::before {
  content: "";
  position: absolute;
  left: 34rpx;
  right: 188rpx;
  bottom: 26rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #bf4938 0 27%, transparent 27% 34%, #176a99 34% 65%, transparent 65% 72%, #c49338 72%);
}
.theme-voyage .word-practice-head::after {
  content: "N";
  position: absolute;
  right: 34rpx;
  top: 32rpx;
  width: 116rpx;
  height: 116rpx;
  border: 7rpx double #b47a31;
  border-radius: 50%;
  background:
    conic-gradient(
      from 337.5deg,
      #bf4938 0 12.5%,
      #f5e5b7 12.5% 25%,
      #176a99 25% 37.5%,
      #f5e5b7 37.5% 50%,
      #bf4938 50% 62.5%,
      #f5e5b7 62.5% 75%,
      #176a99 75% 87.5%,
      #f5e5b7 87.5%
    );
  box-shadow: inset 0 0 0 20rpx #f5e5b7, 0 5rpx 0 rgba(104, 63, 25, 0.34);
  color: #fff0c4;
  font: 700 24rpx/54rpx Georgia, serif;
  text-align: center;
}
.theme-voyage .word-practice-kicker { color: #a36b2c; }
.theme-voyage .word-practice-title { color: #173d55; font-family: "Songti SC", STSong, serif; }
.theme-voyage .word-practice-copy { color: #705d43; }
.theme-voyage .word-practice-list {
  position: relative;
  gap: 28rpx;
  margin-top: 36rpx;
  padding-left: 28rpx;
}
.theme-voyage .word-practice-list::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 62rpx;
  bottom: 62rpx;
  width: 4rpx;
  background: repeating-linear-gradient(180deg, #c49338 0 16rpx, transparent 16rpx 28rpx);
}
.theme-voyage .word-practice-card {
  position: relative;
  min-height: 170rpx;
  padding: 44rpx 22rpx 22rpx;
  overflow: visible;
  border: 4rpx solid #176a99;
  border-radius: 6rpx;
  background:
    repeating-linear-gradient(0deg, rgba(94, 61, 27, 0.025) 0 2rpx, transparent 2rpx 18rpx),
    linear-gradient(90deg, #e6c98e, #fff0c7 18%, #f2dcb0);
  box-shadow: 0 7rpx 0 #784824;
}
.theme-voyage .word-practice-card::before {
  content: "";
  position: absolute;
  left: -35rpx;
  top: 50%;
  width: 22rpx;
  height: 22rpx;
  margin-top: -11rpx;
  border: 4rpx solid #f7e7bd;
  border-radius: 50%;
  background: #176a99;
  box-shadow: 0 0 0 4rpx #c49338;
}
.theme-voyage .word-practice-route {
  position: absolute;
  left: 20rpx;
  top: -3rpx;
  display: flex;
  align-items: center;
  height: 34rpx;
  padding: 0 18rpx;
  border-radius: 0 0 4rpx 4rpx;
  background: #176a99;
  color: #fff1c8;
  font-family: Georgia, serif;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1.6rpx;
}
.theme-voyage .word-practice-mark {
  border: 4rpx solid #d2a952;
  border-radius: 5rpx;
  background: #176a99;
  color: #fff1c8;
  box-shadow: 0 4rpx 0 #6f421f;
}
.theme-voyage .word-practice-mark.audio-mark { border-radius: 50%; }
.theme-voyage .word-practice-card-title { color: #293b3d; font-family: "Songti SC", STSong, serif; }
.theme-voyage .word-practice-card-copy { color: #796448; }
.theme-voyage .audio-route-card {
  border-color: #bf4938;
}
.theme-voyage .audio-route-card::before,
.theme-voyage .audio-route-card .word-practice-route,
.theme-voyage .audio-route-card .word-practice-mark {
  background: #bf4938;
}
.theme-voyage .spell-route-card {
  border-color: #318d7b;
}
.theme-voyage .spell-route-card::before,
.theme-voyage .spell-route-card .word-practice-route,
.theme-voyage .spell-route-card .word-practice-mark {
  background: #318d7b;
}
.theme-voyage .word-practice-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 58rpx;
  height: 58rpx;
  margin-left: 14rpx;
  border: 2rpx solid #c49338;
  border-radius: 4rpx;
  background: #bf4938;
  color: #fff1c8;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1;
  box-shadow: 0 4rpx 0 #61331d;
}

page { overflow-x: hidden; }
.word-practice-nav,
.word-practice-page,
.word-practice-head,
.word-practice-list,
.word-practice-card,
.word-practice-main { max-width: 100%; min-width: 0; box-sizing: border-box; }
.word-practice-page { overflow-x: hidden; }
.word-practice-nav-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.language-en .word-practice-title,
.language-en .word-practice-copy,
.language-en .word-practice-card-title,
.language-en .word-practice-card-copy { word-break: normal; overflow-wrap: normal; }

.theme-dragon.word-practice-nav { border-bottom: 6rpx solid #f7c843; background: #102f68; box-shadow: 0 7rpx 0 #f4511e; color: #fff8dc; }
.theme-dragon .word-practice-back,
.theme-dragon .word-practice-nav-title { color: #fff8dc; }
.theme-dragon.word-practice-page { background: #fff3c9; color: #102f68; }
.theme-dragon .word-practice-head { border: 4rpx solid #12356f; border-top: 10rpx solid #f4511e; border-radius: 8rpx; background: #fff9df; box-shadow: 0 8rpx 0 #12356f; }
.theme-dragon .word-practice-kicker { color: #d64014; }
.theme-dragon .word-practice-title { color: #102f68; }
.theme-dragon .word-practice-copy { color: #665b48; }
.theme-dragon .word-practice-card { border: 4rpx solid #12356f; border-radius: 7rpx; background: #fffdf0; box-shadow: 0 7rpx 0 #f4511e; }
.theme-dragon .word-practice-mark { border: 3rpx solid #12356f; border-radius: 50%; background: #f7cf4b; color: #102f68; box-shadow: 0 4rpx 0 #f4511e; }
.theme-dragon .word-practice-card-title { color: #102f68; }
.theme-dragon .word-practice-card-copy { color: #665b48; }
.theme-dragon .word-practice-arrow { color: #f4511e; font-weight: 800; }

@media (max-width: 340px) {
  .word-practice-page { padding-left: 20rpx; padding-right: 20rpx; }
  .word-practice-card { padding: 18rpx 16rpx; }
  .word-practice-mark { width: 72rpx; height: 72rpx; }
  .word-practice-main { margin-left: 16rpx; }
  .language-en .word-practice-card-title { font-size: 25rpx; }
}

.theme-tactical.word-practice-nav { border-bottom:3rpx solid #91a45f; background:#c3d0c1; color:#172019; box-shadow:none; }
.theme-tactical .word-practice-back,
.theme-tactical .word-practice-nav-title { color:#fff; }
.theme-tactical.word-practice-page { background:#d1dbcf; color:#172019; }
.theme-tactical .word-practice-head { border:2rpx solid #91a45f; border-radius:6rpx; background:#c3d0c1; color:#172019; box-shadow:0 10rpx 24rpx rgba(31,47,35,.1); }
.theme-tactical .word-practice-kicker { color:#c9d4c7; font-weight:800; }
.theme-tactical .word-practice-title { color:#fff; font-weight:800; }
.theme-tactical .word-practice-copy { color:#d4dbd2; }
.theme-tactical .word-practice-card { border:2rpx solid #adb7ad; border-radius:5rpx; background:#e8ede6; box-shadow:0 5rpx 0 #d5dbd2; }
.theme-tactical .word-practice-mark { border:2rpx solid #66745f; border-radius:4rpx; background:#dce4da; color:#172019; box-shadow:none; }
.theme-tactical .word-practice-card-title { color:#172019; font-weight:800; }
.theme-tactical .word-practice-card-copy { color:#4f5d53; }
.theme-tactical .word-practice-arrow { color:#4b664f; font-weight:900; }
