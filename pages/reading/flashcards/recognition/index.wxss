.recognition-nav{position:fixed;top:0;left:0;right:0;z-index:90;border-bottom:1rpx solid rgba(141,183,212,.18);background:rgba(246,251,253,.94);backdrop-filter:blur(22rpx)}
.recognition-back{position:absolute;left:24rpx;bottom:12rpx;width:56rpx;height:56rpx;font-size:60rpx;line-height:48rpx;text-align:center}
.recognition-nav-title{position:absolute;left:120rpx;right:120rpx;bottom:20rpx;font-size:31rpx;font-weight:600;text-align:center}
.recognition-page{box-sizing:border-box;min-height:100vh;padding:30rpx 28rpx calc(60rpx + env(safe-area-inset-bottom));background:linear-gradient(180deg,#f6fbfd,#edf6fa);color:#17314f}
.recognition-preview,.recognition-debug{margin-bottom:18rpx;padding:15rpx 18rpx;border-radius:14rpx;background:#fff4df;color:#876029;font-size:22rpx}
.recognition-debug{background:#fff1ef;color:#9a4038;line-height:1.6}
.recognition-debug text{display:block}
.recognition-hero{padding:28rpx 30rpx;border-radius:24rpx;background:linear-gradient(135deg,#223b4d,#1c3448);box-shadow:0 16rpx 36rpx rgba(31,66,89,.16)}
.recognition-kicker{color:#c6a167;font-size:18rpx;letter-spacing:2.4rpx}
.recognition-title{margin-top:10rpx;color:#fff;font-size:34rpx;font-weight:700}
.recognition-copy{margin-top:8rpx;color:rgba(255,255,255,.7);font-size:23rpx}
.recognition-menu,.recognition-question,.recognition-complete{margin-top:24rpx;padding:28rpx;border:1rpx solid rgba(255,255,255,.85);border-radius:24rpx;background:rgba(255,255,255,.82);box-shadow:0 16rpx 36rpx rgba(71,112,138,.1)}
.recognition-count-head,.recognition-progress{display:flex;align-items:center;justify-content:space-between;color:#698596;font-size:24rpx}
.recognition-count-controls{display:grid;grid-template-columns:86rpx 1fr 86rpx;align-items:center;gap:18rpx;margin:28rpx 0 18rpx}
.recognition-count-controls button{height:76rpx;margin:0;border:0;border-radius:18rpx;background:#dcebf1;color:#315d73;font-size:38rpx}
.recognition-count-controls button::after,.recognition-start::after,.recognition-option::after,.recognition-feedback button::after,.recognition-audio::after,.recognition-audio-failed button::after,.recognition-complete button::after{border:0}
.recognition-count-controls view{text-align:center}
.recognition-count-controls view text{display:block}
.recognition-count-controls view text:first-child{font-size:48rpx;font-weight:700}
.recognition-count-controls view text:last-child{color:#7890a0;font-size:21rpx}
.recognition-start,.recognition-feedback button,.recognition-again{height:86rpx;margin-top:28rpx;border:0;border-radius:18rpx;background:#315d73;color:#fff;font-size:28rpx}
.recognition-start[disabled]{opacity:.45}
.recognition-prompt{display:flex;min-height:190rpx;flex-direction:column;align-items:center;justify-content:center}
.recognition-word{font-family:Georgia,"Times New Roman",serif;font-size:58rpx;font-weight:600;line-height:1.15;text-align:center;overflow-wrap:normal;word-break:keep-all}
.recognition-phonetic{margin-top:12rpx;color:#7890a0;font-size:25rpx}
.recognition-audio{display:flex;align-items:center;justify-content:center;width:112rpx;height:112rpx;margin:0;border:0;border-radius:50%;background:#d9eaf1;color:#315d73;font-size:48rpx}
.recognition-audio.is-loading{animation:recognitionPulse .75s ease-in-out infinite}
.recognition-audio-failed{text-align:center;color:#8a6245;font-size:23rpx}
.recognition-audio-failed view{display:flex;gap:16rpx;margin-top:18rpx}
.recognition-audio-failed button{height:62rpx;margin:0;padding:0 26rpx;border:0;border-radius:14rpx;background:#e2edf2;color:#426a80;font-size:23rpx}
.recognition-options{display:flex;flex-direction:column;gap:15rpx}
.recognition-option{display:grid;grid-template-columns:54rpx minmax(0,1fr);align-items:center;min-height:88rpx;margin:0;padding:15rpx 18rpx;border:1rpx solid rgba(76,119,142,.14);border-radius:16rpx;background:#f7fbfd;color:#29475b;font-size:25rpx;line-height:1.45;text-align:left;white-space:normal}
.recognition-option-key{display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;border-radius:10rpx;background:#dceaf0;color:#416f86;font-size:21rpx;font-weight:700}
.recognition-option.is-correct{border-color:#75aa8c;background:#e7f4eb;color:#295c3e}
.recognition-option.is-wrong{border-color:#c88378;background:#fae9e6;color:#8a3f38}
.recognition-feedback{margin-top:22rpx;padding-top:22rpx;border-top:1rpx solid rgba(76,119,142,.13)}
.recognition-result{font-size:28rpx;font-weight:700}
.recognition-result.is-correct{color:#34704d}
.recognition-result.is-wrong{color:#a24940}
.recognition-answer{margin-top:12rpx;font-size:25rpx;font-weight:600;line-height:1.5}
.recognition-example{margin-top:12rpx;color:#657d8c;font-size:23rpx;line-height:1.55}
.recognition-example text{display:block;margin-top:5rpx}
.recognition-complete{position:relative;overflow:hidden;padding:48rpx 28rpx;text-align:center}
.recognition-complete-mark{position:relative;z-index:2;display:flex;align-items:center;justify-content:center;width:92rpx;height:92rpx;margin:0 auto;border-radius:50%;background:#5d9b78;color:#fff;font-size:48rpx;animation:vocabCompletePop .88s cubic-bezier(.2,1.35,.28,1) both}
.recognition-complete-title{margin-top:18rpx;font-size:38rpx;font-weight:700}
.recognition-score{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:28rpx}
.recognition-score view{padding:18rpx 6rpx;border-radius:15rpx;background:#edf5f8}
.recognition-score text{display:block}
.recognition-score text:first-child{font-size:36rpx;font-weight:700}
.recognition-score text:last-child{margin-top:5rpx;color:#718a99;font-size:20rpx}
.recognition-change{height:80rpx;margin-top:14rpx;border:1rpx solid rgba(76,119,142,.18);border-radius:18rpx;background:#e8f1f5;color:#426a80;font-size:26rpx}
.recognition-complete-title,.recognition-score,.recognition-complete button{position:relative;z-index:2}
.celebrate-burst{position:absolute;top:18rpx;left:50%;z-index:1;width:240rpx;height:240rpx;transform:translateX(-50%);pointer-events:none;animation:vocabBurstFade 1.5s ease-out both}
.celebrate-burst text{position:absolute;top:50%;left:50%;width:8rpx;height:76rpx;border-radius:999rpx;background:rgba(239,178,103,.58);transform-origin:50% 100%}
.celebrate-burst text:nth-child(1){transform:translate(-50%,-100%) rotate(0deg)}.celebrate-burst text:nth-child(2){transform:translate(-50%,-100%) rotate(60deg)}.celebrate-burst text:nth-child(3){transform:translate(-50%,-100%) rotate(120deg)}.celebrate-burst text:nth-child(4){transform:translate(-50%,-100%) rotate(180deg)}.celebrate-burst text:nth-child(5){transform:translate(-50%,-100%) rotate(240deg)}.celebrate-burst text:nth-child(6){transform:translate(-50%,-100%) rotate(300deg)}
.confetti-layer{position:absolute;inset:0;z-index:1;overflow:hidden;pointer-events:none}
.confetti{position:absolute;top:-36rpx;width:12rpx;height:30rpx;border-radius:4rpx;opacity:0;animation:vocabConfettiFall 2.6s ease-in-out infinite}
.confetti-1{left:8%;background:#8db7d4}.confetti-2{left:16%;background:#efb267;animation-delay:.18s}.confetti-3{left:25%;background:#86aaa1;animation-delay:.34s}.confetti-4{left:34%;background:#c57d2d;animation-delay:.08s}.confetti-5{left:43%;background:#8db7d4;animation-delay:.5s}.confetti-6{left:52%;background:#efb267;animation-delay:.26s}.confetti-7{left:60%;background:#86aaa1;animation-delay:.62s}.confetti-8{left:68%;background:#c57d2d;animation-delay:.42s}.confetti-9{left:76%;background:#8db7d4;animation-delay:.12s}.confetti-10{left:84%;background:#efb267;animation-delay:.56s}.confetti-11{left:91%;background:#86aaa1;animation-delay:.3s}.confetti-12{left:47%;background:#c57d2d;animation-delay:.72s}
.theme-library.recognition-page{background:#eee7d8;color:#2f2924}
.theme-library .recognition-hero{border-radius:8rpx;background:linear-gradient(90deg,#2b211b,#14283a)}
.theme-library .recognition-menu,.theme-library .recognition-question,.theme-library .recognition-complete{border-color:rgba(69,54,42,.18);border-radius:7rpx;background:#f7efdf;box-shadow:0 12rpx 28rpx rgba(43,33,27,.12)}
.theme-library .recognition-option{border-color:rgba(115,88,55,.18);border-radius:5rpx;background:#fffaf0;color:#3e332a}
.theme-library .recognition-option-key{border-radius:3rpx;background:#e5d7bd;color:#6b5744}
.theme-library .recognition-start,.theme-library .recognition-feedback button,.theme-library .recognition-again{border-radius:5rpx;background:#4b6571}
.theme-library .recognition-change{border-radius:5rpx;background:#eadfcd;color:#655748}
.theme-library .recognition-word,.theme-library .recognition-title,.theme-library .recognition-complete-title{font-family:"Songti SC",STSong,serif}
@keyframes recognitionPulse{0%,100%{opacity:.55;transform:scale(.94)}
50%{opacity:1;transform:scale(1.04)}
}
@keyframes vocabCompletePop{0%{opacity:0;transform:scale(.72)}70%{opacity:1;transform:scale(1.08)}100%{opacity:1;transform:scale(1)}}
@keyframes vocabBurstFade{0%{opacity:0;transform:translateX(-50%) scale(.55) rotate(-12deg)}35%{opacity:1}100%{opacity:0;transform:translateX(-50%) scale(1.25) rotate(8deg)}}
@keyframes vocabConfettiFall{0%{opacity:0;transform:translateY(-20rpx) rotate(0)}18%{opacity:1}100%{opacity:0;transform:translateY(620rpx) rotate(420deg)}}

/* Normalize native button sizing and keep practice controls centered. */
.recognition-count-controls button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:76rpx;min-width:76rpx;padding:0;justify-self:center;line-height:1;text-align:center}
.recognition-start,.recognition-feedback button,.recognition-again,.recognition-change{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;padding:0 24rpx;line-height:1.2;text-align:center}
.recognition-option{grid-template-columns:54rpx minmax(0,1fr) 36rpx;box-sizing:border-box;width:100%;transition:border-color .18s ease,background .18s ease,box-shadow .18s ease}
.recognition-option.is-correct{border:2rpx solid #3f9b6d;background:#dff2e6;color:#245b3c;box-shadow:0 8rpx 20rpx rgba(63,155,109,.14)}
.recognition-option.is-correct .recognition-option-key{background:#3f9b6d;color:#fff}
.recognition-option.is-wrong{border:2rpx solid #c96f66;background:#fae7e4;color:#883f38}
.recognition-option.is-wrong .recognition-option-key{background:#c96f66;color:#fff}
.recognition-option-status{justify-self:end;font-size:34rpx;font-weight:800;line-height:1}
.recognition-option-status.is-correct{color:#31865a}.recognition-option-status.is-wrong{color:#b6534b}
.theme-library .recognition-option.is-correct{border-color:#4f8d66;background:#e3efe3;color:#315b3e}
.theme-library .recognition-option.is-correct .recognition-option-key{background:#4f8d66;color:#fff}
.theme-library .recognition-option.is-wrong{border-color:#b96b60;background:#f5e3df;color:#7d4139}
.theme-library .recognition-option.is-wrong .recognition-option-key{background:#b96b60;color:#fff}
.recognition-word-audio{display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;margin:14rpx 0 0;padding:0;border:0;border-radius:50%;background:#e2eef3;color:#315d73;font-size:30rpx;line-height:1}
.recognition-word-audio::after{border:0}
.recognition-word-audio.is-loading{animation:recognitionPulse .75s ease-in-out infinite}
.recognition-word-audio.is-failed{background:#f4e8db;color:#976640}
.recognition-inline-audio-failed{margin-top:8rpx;color:#976640;font-size:20rpx;line-height:1.4}
.theme-library .recognition-word-audio{background:#e5d7bd;color:#655748}
.theme-library .recognition-word-audio.is-failed{background:#ead4c6;color:#8c5544}

.theme-voyage.recognition-nav{border-bottom:5rpx solid #c18a3e;background:linear-gradient(180deg,#1e6382,#173f57);box-shadow:0 7rpx 0 #6d4021;color:#fff2ca}.theme-voyage .recognition-back,.theme-voyage .recognition-nav-title{color:#fff2ca}.theme-voyage.recognition-page{background:linear-gradient(180deg,#54bde3 0 112rpx,#107da9 113rpx 170rpx,#e4ce9c 171rpx,#f3e6c6 100%);color:#173d55}.theme-voyage .recognition-hero{position:relative;padding-right:174rpx;border:5rpx solid #8d572c;border-radius:7rpx;background:#f8e8bf;box-shadow:0 9rpx 0 #693d20,0 20rpx 34rpx rgba(4,66,89,.2)}.theme-voyage .recognition-hero::after{content:"?";position:absolute;right:34rpx;top:24rpx;width:102rpx;height:102rpx;border:7rpx double #b47a31;border-radius:50%;background:#1d6381;box-shadow:inset 0 0 0 9rpx #e6c96f;color:#fff0c4;font:700 42rpx/94rpx Georgia,serif;text-align:center}.theme-voyage .recognition-kicker{color:#a36b2c}.theme-voyage .recognition-title{color:#173d55;font-family:"Songti SC",STSong,serif}.theme-voyage .recognition-copy{color:#705d43}.theme-voyage .recognition-menu,.theme-voyage .recognition-question,.theme-voyage .recognition-complete{border:4rpx solid #95602f;border-radius:7rpx;background:#f8e9c4;box-shadow:0 8rpx 0 #744622,0 17rpx 30rpx rgba(72,56,30,.15)}.theme-voyage .recognition-count-controls button{border:3rpx solid #a8753a;border-radius:5rpx;background:#d5a958;color:#633f1e}.theme-voyage .recognition-start,.theme-voyage .recognition-feedback button,.theme-voyage .recognition-again{border:4rpx solid #c0883f;border-radius:6rpx;background:linear-gradient(180deg,#c9493b,#a42e2a);box-shadow:0 7rpx 0 #74391f;color:#fff2ca}.theme-voyage .recognition-change{border:3rpx solid #9e6934;border-radius:5rpx;background:#f1d9a7;color:#65421f}.theme-voyage .recognition-audio,.theme-voyage .recognition-word-audio{border:4rpx solid #d0a64e;border-radius:50%;background:#1d6381;color:#fff1c8;box-shadow:0 6rpx 0 #704321}.theme-voyage .recognition-option{border:3rpx solid #b1844d;border-radius:5rpx;background:rgba(255,247,220,.82);box-shadow:inset 0 -3rpx rgba(112,71,31,.08)}.theme-voyage .recognition-option-key{border-radius:3rpx;background:#d4a654;color:#68441f;font-family:Georgia,serif;font-weight:800}.theme-voyage .recognition-option.is-correct{border-color:#477b60;background:#dce8d2;color:#27553d}.theme-voyage .recognition-option.is-wrong{border-color:#a64b42;background:#efd4ca;color:#7e352f}.theme-voyage .recognition-complete-mark{border:8rpx double #b87d31;background:#1d6381;box-shadow:inset 0 0 0 7rpx #f1dc9a;color:#f3cf65}.theme-voyage .recognition-complete-title{color:#a83b31;font-family:"Songti SC",STSong,serif}

page{overflow-x:hidden}
.recognition-nav,.recognition-page,.recognition-hero,.recognition-menu,.recognition-question,.recognition-complete,.recognition-prompt,.recognition-options,.recognition-option,.recognition-feedback{max-width:100%;min-width:0;box-sizing:border-box}
.recognition-page{overflow-x:hidden}
.recognition-nav-title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.recognition-option>text:nth-child(2){min-width:0}
.language-en .recognition-title,.language-en .recognition-copy,.language-en .recognition-word,.language-en .recognition-option,.language-en .recognition-answer,.language-en .recognition-example{word-break:normal;overflow-wrap:normal}
.theme-dragon.recognition-nav{border-bottom:6rpx solid #f7c843;background:#102f68;box-shadow:0 7rpx 0 #f4511e;color:#fff8dc}
.theme-dragon .recognition-back,.theme-dragon .recognition-nav-title{color:#fff8dc}
.theme-dragon.recognition-page{background:#fff3c9;color:#102f68}
.theme-dragon .recognition-hero{border:4rpx solid #12356f;border-top:10rpx solid #f4511e;border-radius:8rpx;background:#fff9df;box-shadow:0 8rpx 0 #12356f}
.theme-dragon .recognition-kicker{color:#d64014}
.theme-dragon .recognition-title{color:#102f68}
.theme-dragon .recognition-copy{color:#665b48}
.theme-dragon .recognition-menu,.theme-dragon .recognition-question,.theme-dragon .recognition-complete{border:4rpx solid #12356f;border-radius:7rpx;background:#fffdf0;box-shadow:0 7rpx 0 #f4511e}
.theme-dragon .recognition-count-head,.theme-dragon .recognition-progress{color:#665b48}
.theme-dragon .recognition-count-controls button{border:3rpx solid #12356f;border-radius:50%;background:#f7cf4b;color:#102f68}
.theme-dragon .recognition-start,.theme-dragon .recognition-feedback button,.theme-dragon .recognition-again{border:3rpx solid #12356f;border-radius:6rpx;background:#f4511e;box-shadow:0 5rpx 0 #102f68;color:#fff}
.theme-dragon .recognition-change{border:3rpx solid #12356f;border-radius:6rpx;background:#fff0ac;color:#102f68}
.theme-dragon .recognition-audio,.theme-dragon .recognition-word-audio{border:4rpx solid #12356f;background:#f7cf4b;color:#102f68;box-shadow:0 5rpx 0 #f4511e}
.theme-dragon .recognition-option{border:3rpx solid #12356f;border-radius:6rpx;background:#fff9df;color:#102f68}
.theme-dragon .recognition-option-key{border:2rpx solid #12356f;border-radius:50%;background:#f7cf4b;color:#102f68}
.theme-dragon .recognition-option.is-correct{border-color:#2f7b4f;background:#e3f1cf;color:#22593b}
.theme-dragon .recognition-option.is-wrong{border-color:#ba3f35;background:#fae1d1;color:#87352e}
.theme-dragon .recognition-complete-mark{border:6rpx solid #12356f;background:#f7cf4b;color:#102f68;box-shadow:0 6rpx 0 #f4511e}
.theme-dragon .recognition-score view{border:2rpx solid #12356f;border-radius:5rpx;background:#fff0ac}
@media(max-width:340px){.recognition-page{padding-left:20rpx;padding-right:20rpx}.recognition-menu,.recognition-question,.recognition-complete{padding-left:20rpx;padding-right:20rpx}.recognition-option{grid-template-columns:46rpx minmax(0,1fr) 30rpx;padding-left:12rpx;padding-right:12rpx;font-size:23rpx}.recognition-score{gap:6rpx}.recognition-score text:last-child{font-size:18rpx}}
