  grid-template-columns: minmax(0, 1fr);
  grid-template-rows: 300rpx 238rpx 88rpx;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 696rpx;
  margin-top: 8rpx;
  padding: 42rpx 30rpx 32rpx;
