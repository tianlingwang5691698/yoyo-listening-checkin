.vocab-practice-arrow { flex: none; margin-left: 18rpx; color: #7894a4; font-size: 52rpx; line-height: 1; }
.vocab-practice-icon { position: relative; flex: none; box-sizing: border-box; width: 104rpx; height: 104rpx; }

.folder-symbol { border-radius: 22rpx; background: linear-gradient(145deg, #dbeaf1, #aacbd9); box-shadow: inset 0 1rpx 0 rgba(255,255,255,.72); }
.folder-tab { position: absolute; left: 18rpx; top: 18rpx; width: 42rpx; height: 18rpx; border-radius: 8rpx 8rpx 0 0; background: #5d8fa7; }
.folder-body { position: absolute; left: 14rpx; right: 14rpx; top: 32rpx; bottom: 16rpx; border-radius: 9rpx; background: linear-gradient(160deg, #6f9fb7, #416f86); box-shadow: 0 8rpx 14rpx rgba(54, 97, 119, 0.18); }
.folder-body text { position: absolute; bottom: 10rpx; width: 20rpx; height: 34rpx; border: 2rpx solid rgba(255,255,255,.66); border-radius: 3rpx; }
