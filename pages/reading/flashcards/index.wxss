.flashcard-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 90;
  box-sizing: border-box;
  background: var(--bg-cream);
  border-bottom: 1rpx solid rgba(90, 78, 66, 0.08);
}

.flashcard-back {
  position: absolute;
  left: 24rpx;
  bottom: 12rpx;
  width: 56rpx;
  height: 56rpx;
  color: var(--text-strong);
  font-size: 60rpx;
  line-height: 48rpx;
  text-align: center;
}

.flashcard-nav-title {
  position: absolute;
  left: 160rpx;
  right: 160rpx;
  bottom: 20rpx;
  color: var(--text-strong);
  font-size: 32rpx;
  font-weight: var(--font-title-weight);
  line-height: 40rpx;
  text-align: center;
}

.flashcard-page {
  padding-top: 72rpx;
  min-height: 100vh;
  background: var(--bg-cream);
}

.flashcard-page.is-review {
  padding-top: 88rpx;
  padding-bottom: calc(34rpx + env(safe-area-inset-bottom));
}

.flashcard-page.is-review .vocab-summary,
.flashcard-page.is-review .review-log,
.flashcard-page.is-review .mode-tabs,
.flashcard-page.is-review .start-review,
.flashcard-page.is-review .sublevel-actions,
.flashcard-page.is-review .vocab-settings-panel,
.flashcard-page.is-review .review-metrics {
  display: none;
}

.vocab-summary {
  margin-top: 44rpx;
  padding: 0 12rpx;
  background: transparent;
  box-shadow: none;
}

.progress-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 38rpx;
}

.progress-title {
  color: var(--text-strong);
  font-size: 40rpx;
  font-weight: var(--font-title-weight);
  line-height: var(--line-section);
}

.demo-tag {
  margin-left: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill);
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
  vertical-align: middle;
}

.progress-copy {
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.35;
}

.progress-line-head {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin: 20rpx 2rpx 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.2;
}

.progress-line-head text:last-child {
  color: var(--accent-deep);
  font-weight: var(--font-title-weight);
}

.progress-bar {
  position: relative;
  height: 16rpx;
  margin: 16rpx 4rpx 0;
  border-radius: 999rpx;
  background:
    linear-gradient(90deg, rgba(105, 166, 176, 0.18), rgba(241, 185, 111, 0.2), rgba(105, 166, 176, 0.18)),
    rgba(111, 164, 178, 0.16);
  box-shadow:
    inset 0 0 0 1rpx rgba(90, 78, 66, 0.06),
    0 8rpx 18rpx rgba(111, 164, 178, 0.1);
  overflow: hidden;
  animation: progress-track-glow 2.4s ease-in-out infinite;
}

.progress-fill {
  position: relative;
  height: 100%;
  border-radius: inherit;
  background:
    linear-gradient(90deg, rgba(82, 148, 166, 0.92), rgba(146, 174, 132, 0.92), rgba(239, 178, 103, 0.95)),
    linear-gradient(90deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0));
  transition: width 360ms ease;
  overflow: hidden;
  box-shadow: 0 0 18rpx rgba(239, 178, 103, 0.28);
}

.progress-fill.is-zero {
  width: 16rpx !important;
}

.progress-fill::before {
  content: "";
  position: absolute;
  top: 50%;
  right: 0;
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 247, 230, 0.96);
  box-shadow:
    0 0 0 4rpx rgba(255, 247, 230, 0.28),
    0 0 18rpx rgba(239, 178, 103, 0.58);
  transform: translate(28%, -50%);
  animation: progress-end-pulse 1.2s ease-in-out infinite;
}

.progress-fill::after {
  content: "";
  position: absolute;
  top: -40%;
  bottom: -40%;
  left: -70%;
  width: 58%;
  background: linear-gradient(105deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.58), rgba(255, 255, 255, 0));
  transform: skewX(-18deg);
  animation: progress-flow 1.45s ease-in-out infinite;
}

@keyframes progress-track-glow {
  0%, 100% {
    opacity: 0.82;
  }

  50% {
    opacity: 1;
  }
}

@keyframes progress-flow {
  0% {
    transform: translateX(0);
  }

  100% {
    transform: translateX(360%) skewX(-18deg);
  }
}

@keyframes progress-end-pulse {
  0%, 100% {
    opacity: 0.72;
    transform: translate(28%, -50%) scale(0.82);
  }

  50% {
    opacity: 1;
    transform: translate(28%, -50%) scale(1);
  }
}

.vocab-stats,
.plan-overview,
.mode-tabs,
.flashcard-actions,
.limit-row,
.stepper {
