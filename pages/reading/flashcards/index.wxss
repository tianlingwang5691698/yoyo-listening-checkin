.library-vocab-card .library-vocab-study-word.is-word-long { font-size: 42rpx; line-height: 1.18; }
.library-vocab-card .library-vocab-study-word.is-word-extra-long { font-size: 34rpx; line-height: 1.2; }

.library-vocab-study-speak {
  grid-column: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  justify-self: end;
  width: 58rpx;
  height: 58rpx;
  border: 1rpx solid var(--lib-vocab-rule);
  border-radius: 6rpx;
  background: var(--lib-vocab-paper);
  color: var(--lib-vocab-brass);
  font-size: 30rpx;
  line-height: 1;
}

.library-vocab-study-speak.is-loading {
  animation: libraryVocabAudioPulse 0.72s ease-in-out infinite;
}

@keyframes libraryVocabAudioPulse {
  0%, 100% {
    opacity: 0.55;
    transform: scale(0.9);
  }

  50% {
    opacity: 1;
    transform: scale(1.06);
  }
}

.library-vocab-study-phonetic {
  margin-top: 18rpx;
  color: var(--lib-vocab-muted);
  font-size: 28rpx;
  line-height: 1.35;
  text-align: center;
}

.library-vocab-answer {
  position: relative;
  z-index: 1;
  width: 100%;
  min-width: 0;
  min-height: 0;
  padding-top: 18rpx;
  overflow: hidden;
}

.library-vocab-answer.is-placeholder {
  visibility: hidden;
}

.library-vocab-answer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  width: 100%;
  min-width: 0;
}

.theme-library .study-choice-tag,
.theme-library .study-easy-action {
  color: var(--lib-vocab-muted);
  font-size: 22rpx;
}

.theme-library .study-easy-action {
  flex-shrink: 0;
  padding-bottom: 2rpx;
  border-bottom: 1rpx solid var(--lib-vocab-rule);
}

.library-vocab-meaning {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
  margin-top: 12rpx;
  color: var(--lib-vocab-ink);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.46;
  text-align: left;
  overflow: hidden;
}

.library-vocab-meaning text {
  display: block;
  width: 100%;
  max-width: 100%;
  white-space: normal;
  overflow-wrap: break-word;
  word-break: break-all;
}

.library-vocab-example {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  margin-top: 10rpx;
  color: var(--lib-vocab-ink);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
  white-space: normal;
  overflow-wrap: normal;
  word-break: normal;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.library-vocab-example view + view {
  margin-top: 6rpx;
}

.library-vocab-actions {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  align-self: end;
  width: 100%;
  min-width: 0;
  height: 88rpx;
}

.library-vocab-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0;
  border: 1rpx solid var(--lib-vocab-rule);
  background: rgba(250, 245, 234, 0.72);
  color: var(--lib-vocab-muted);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.library-vocab-action.strong {
  background: var(--lib-vocab-ink);
  color: var(--lib-vocab-paper-hi);
}

.library-vocab-action.placeholder {
  visibility: hidden;
  pointer-events: none;
}

.library-vocab-action.is-disabled,
.library-vocab-action[disabled] {
  opacity: 0.46;
}

.library-vocab-complete {
  position: relative;
  min-height: 620rpx;
  margin-top: 12rpx;
  padding: 92rpx 34rpx 44rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #3A2B22, #2B211B);
  text-align: center;
}

.library-vocab-archive {
  position: relative;
  width: 280rpx;
  height: 174rpx;
  margin: 0 auto 30rpx;
  border: 1rpx solid var(--lib-vocab-rule);
  border-radius: 8rpx;
  background: #1E1713;
  box-shadow: inset 0 18rpx 0 rgba(184, 149, 98, 0.16);
  z-index: 2;
  animation: vocabCompletePop 0.88s cubic-bezier(0.2, 1.35, 0.28, 1) both;
}

.library-vocab-archive text {
  position: absolute;
  top: -36rpx;
  width: 74rpx;
  height: 118rpx;
  border: 1rpx solid var(--lib-vocab-rule);
  border-radius: 4rpx;
  background: var(--lib-vocab-paper);
}

.library-vocab-archive text:nth-child(1) {
  left: 44rpx;
  transform: rotate(-5deg);
}

.library-vocab-archive text:nth-child(2) {
  left: 104rpx;
}

.library-vocab-archive text:nth-child(3) {
  right: 44rpx;
  transform: rotate(5deg);
}

.library-vocab-complete-stamp {
  position: relative;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 62rpx;
  border: 2rpx solid var(--lib-vocab-brass);
  color: var(--lib-vocab-brass);
  font-size: 28rpx;
  font-weight: 600;
}

.library-vocab-complete-title {
  position: relative;
  z-index: 2;
  margin-top: 28rpx;
  color: var(--lib-vocab-paper);
  font-family: "Songti SC", STSong, serif;
  font-size: 42rpx;
  line-height: 1.24;
}

.library-vocab-complete-summary .complete-summary-item {
  border-color: rgba(184, 149, 98, 0.46);
  border-radius: 6rpx;
  background: rgba(30, 23, 19, 0.52);
}

.library-vocab-complete-summary .complete-summary-label {
  color: var(--lib-vocab-brass);
}

.library-vocab-complete-summary .complete-summary-value {
  color: var(--lib-vocab-paper-hi);
}

.language-en .complete-summary-label {
  font-size: 20rpx;
  white-space: nowrap;
}

.dictation-jump-mask {
  position: fixed;
  inset: 0;
  z-index: 220;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 40rpx;
  background: rgba(20, 40, 58, 0.38);
  backdrop-filter: blur(12rpx);
}

.dictation-jump-dialog {
  box-sizing: border-box;
  width: 100%;
  max-width: 620rpx;
  padding: 42rpx 34rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 30rpx;
  background: rgba(248, 252, 254, 0.96);
  color: #17314f;
  text-align: center;
  box-shadow: 0 34rpx 80rpx rgba(31, 66, 89, 0.24);
  animation: dictationPromptIn 0.34s cubic-bezier(0.2, 1.12, 0.34, 1) both;
}

.dictation-jump-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #79a8bd, #406f86);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.dictation-jump-title { font-size: 36rpx; font-weight: 700; line-height: 1.3; }
.dictation-jump-source { margin-top: 14rpx; color: #416d84; font-size: 25rpx; font-weight: 600; line-height: 1.45; }
.dictation-jump-copy { margin-top: 16rpx; color: #6f8492; font-size: 25rpx; line-height: 1.65; }
.dictation-jump-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; width: 100%; margin-top: 30rpx; }
.dictation-jump-actions button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-width: 0; height: 84rpx; margin: 0; padding: 0 12rpx; border: 0; border-radius: 18rpx; font-size: 25rpx; line-height: 1.2; text-align: center; white-space: normal; }
.dictation-jump-actions button::after { border: 0; }
.dictation-jump-later { background: #e7f0f4; color: #537386; }
.dictation-jump-go { background: #315d73; color: #fff; }
.dictation-jump-actions button[disabled] { opacity: 0.58; }
.complete-action[disabled], .library-vocab-complete-action[disabled] { opacity: 0.48; pointer-events: none; }

.theme-library.dictation-jump-mask { background: rgba(39, 31, 25, 0.46); }
.theme-library .dictation-jump-dialog { border-color: rgba(115, 88, 55, 0.24); border-radius: 10rpx; background: #f6eddd; color: #342b24; box-shadow: 0 30rpx 70rpx rgba(42, 31, 23, 0.3); }
.theme-library .dictation-jump-mark { border-radius: 5rpx; background: #496b7a; font-family: "Songti SC", STSong, serif; }
.theme-library .dictation-jump-title { font-family: "Songti SC", STSong, serif; }
.theme-library .dictation-jump-source { color: #6b5744; }
.theme-library .dictation-jump-copy { color: #786b5e; }
.theme-library .dictation-jump-later { border: 1rpx solid rgba(115, 88, 55, 0.18); background: #eadfcd; color: #655748; }
.theme-library .dictation-jump-go { background: #4b6571; color: #fffdf7; }
.language-en .dictation-jump-actions button { font-size: 23rpx; }

@keyframes dictationPromptIn {
  0% { opacity: 0; transform: translateY(24rpx) scale(0.94); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

.library-vocab-complete-action {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 260rpx;
  height: 88rpx;
  min-height: 88rpx;
  margin: 58rpx auto 0;
  padding: 0;
  border: 1rpx solid var(--lib-vocab-brass);
  background: var(--lib-vocab-ink);
  color: var(--lib-vocab-paper-hi);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.library-vocab-empty {
  border: 1rpx solid var(--lib-vocab-rule);
  border-radius: 8rpx;
  background: rgba(243, 232, 212, 0.78);
  color: var(--lib-vocab-muted);
}

.library-vocab-picker-mask {
  background: rgba(43, 33, 27, 0.42);
}

.library-vocab-picker {
  border-radius: 12rpx 12rpx 0 0;
  background: var(--lib-vocab-paper);
}

.theme-library .limit-picker-head {
  border-bottom-color: var(--lib-vocab-paper-rule);
}

.theme-library .limit-picker-title,
.theme-library .limit-picker-item.selected {
  color: var(--lib-vocab-ink);
}

.theme-library .limit-picker-action {
  color: var(--lib-vocab-muted);
}

.theme-library .limit-picker-action.confirm {
  color: var(--lib-vocab-brass);
}

.theme-library .limit-picker-wheel,
.theme-library .limit-picker-view {
  background: var(--lib-vocab-paper);
}

.theme-library .limit-picker-wheel::before,
.theme-library .limit-picker-wheel::after {
  background: var(--lib-vocab-rule);
}
.vocab-data-skeleton {
  width: 280rpx;
  height: 28rpx;
  margin-top: 12rpx;
  border-radius: 8rpx;
  background: rgba(141, 183, 212, 0.16);
}

.vocab-counts-skeleton {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.vocab-counts-skeleton view {
  height: 62rpx;
  border-radius: 10rpx;
  background: rgba(141, 183, 212, 0.14);
}

.theme-library .vocab-data-skeleton,
.theme-library .vocab-counts-skeleton view {
  background: rgba(184, 149, 98, 0.16);
}
.language-en button,
.language-en view,
.language-en text { overflow-wrap: normal; word-break: normal; }
.language-en .library-vocab-title,
.language-en .progress-title { font-size: 38rpx; line-height: 1.16; }

.book-dictation .book-cover {
  background:
    linear-gradient(150deg, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 38%),
    linear-gradient(135deg, #6f9fb7, #416f86);
}

.book-dictation .book-symbol {
  color: #f5fbfd;
}

.library-vocab-book.book-dictation {
  background:
    linear-gradient(90deg, rgba(20, 40, 58, 0.2), rgba(20, 40, 58, 0) 42rpx),
    #c9dce2;
}

.sublevel-actions,
.library-vocab-handles {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
