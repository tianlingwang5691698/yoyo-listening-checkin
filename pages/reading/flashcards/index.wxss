  margin: 72rpx auto 0;
  border-radius: 0;
  background: var(--accent);
  color: #fffaf0;
  font-size: var(--font-body-size);
  font-weight: var(--font-title-weight);
  line-height: 92rpx;
  box-shadow: 0 16rpx 32rpx rgba(214, 137, 58, 0.2);
}

.complete-action::before,
.complete-action::after {
  border: 0;
}

.celebrate-burst {
  position: absolute;
  top: 154rpx;
  left: 50%;
  z-index: 1;
  width: 260rpx;
  height: 260rpx;
  transform: translateX(-50%);
  animation: burst-fade 1.5s ease-out both;
}

.celebrate-burst text {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 10rpx;
  height: 92rpx;
  border-radius: 999rpx;
  background: rgba(239, 178, 103, 0.62);
  transform-origin: 50% 100%;
}

.celebrate-burst text:nth-child(1) { transform: translate(-50%, -100%) rotate(0deg); }
.celebrate-burst text:nth-child(2) { transform: translate(-50%, -100%) rotate(60deg); }
.celebrate-burst text:nth-child(3) { transform: translate(-50%, -100%) rotate(120deg); }
.celebrate-burst text:nth-child(4) { transform: translate(-50%, -100%) rotate(180deg); }
.celebrate-burst text:nth-child(5) { transform: translate(-50%, -100%) rotate(240deg); }
.celebrate-burst text:nth-child(6) { transform: translate(-50%, -100%) rotate(300deg); }

.confetti-layer {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
}

.confetti {
  position: absolute;
  top: -36rpx;
  width: 14rpx;
  height: 34rpx;
  border-radius: 4rpx;
  background: rgba(197, 125, 45, 0.88);
  opacity: 0;
  animation: confetti-fall 2.6s ease-in-out infinite;
}

.confetti-1 { left: 8%; background: rgba(84, 151, 166, 0.88); animation-delay: 0s; }
.confetti-2 { left: 16%; background: rgba(239, 178, 103, 0.92); animation-delay: 0.18s; }
.confetti-3 { left: 25%; background: rgba(146, 174, 132, 0.9); animation-delay: 0.34s; }
.confetti-4 { left: 34%; background: rgba(197, 125, 45, 0.9); animation-delay: 0.08s; }
.confetti-5 { left: 43%; background: rgba(84, 151, 166, 0.82); animation-delay: 0.5s; }
.confetti-6 { left: 52%; background: rgba(239, 178, 103, 0.92); animation-delay: 0.26s; }
.confetti-7 { left: 60%; background: rgba(146, 174, 132, 0.9); animation-delay: 0.62s; }
.confetti-8 { left: 68%; background: rgba(197, 125, 45, 0.88); animation-delay: 0.42s; }
.confetti-9 { left: 76%; background: rgba(84, 151, 166, 0.88); animation-delay: 0.12s; }
.confetti-10 { left: 84%; background: rgba(239, 178, 103, 0.9); animation-delay: 0.56s; }
.confetti-11 { left: 91%; background: rgba(146, 174, 132, 0.9); animation-delay: 0.3s; }
.confetti-12 { left: 47%; background: rgba(197, 125, 45, 0.9); animation-delay: 0.72s; }

.study-card {
  margin-top: 24rpx;
  min-height: 680rpx;
  padding: 48rpx 32rpx 28rpx;
  border: 1rpx solid var(--border-soft);
  border-radius: var(--radius-xl);
  background: var(--surface);
  text-align: center;
}

.study-card.is-unfamiliar {
  border-color: rgba(232, 111, 79, 0.42);
}

.is-review .study-card {
  min-height: 760rpx;
  margin-top: 0;
  padding: 72rpx 32rpx 38rpx;
  display: flex;
  flex-direction: column;
}

@keyframes complete-pop {
  0% {
    opacity: 0;
    transform: scale(0.72);
  }

  70% {
    opacity: 1;
    transform: scale(1.08);
  }

  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes burst-fade {
  0% {
    opacity: 0;
    transform: translateX(-50%) scale(0.55) rotate(-12deg);
  }

  35% {
    opacity: 1;
  }

  100% {
    opacity: 0;
    transform: translateX(-50%) scale(1.28) rotate(8deg);
  }
}

@keyframes confetti-fall {
  0% {
    opacity: 0;
    transform: translate3d(0, -20rpx, 0) rotate(0deg);
  }

  12% {
    opacity: 1;
  }

  82% {
    opacity: 1;
  }

  100% {
    opacity: 0;
    transform: translate3d(34rpx, 780rpx, 0) rotate(420deg);
  }
}

.study-card-head {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.study-card.is-unfamiliar .study-word {
  color: var(--accent-deep);
}

.study-card.is-easy .study-word {
  color: rgba(36, 42, 44, 0.62);
}

.is-review .study-card-head {
  margin-top: 48rpx;
}

.study-age {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
}

.study-word-row {
  position: relative;
  margin-top: 26rpx;
  width: 100%;
  padding: 0 112rpx;
  text-align: center;
}

.study-word {
  display: inline-block;
  max-width: 100%;
  color: var(--text-strong);
  font-size: 58rpx;
  line-height: 1.12;
  font-weight: var(--font-title-weight);
  word-break: normal;
  overflow-wrap: break-word;
}

.study-speak {
  position: absolute;
  right: 0;
  top: 50%;
  width: 56rpx;
  height: 56rpx;
  transform: translateY(-50%);
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent-deep);
  text-align: center;
  font-size: 28rpx;
  font-weight: var(--font-title-weight);
  line-height: 56rpx;
}

.study-speak.is-loading {
  animation: audioPulse 0.72s ease-in-out infinite;
}

@keyframes audioPulse {
  0% {
    opacity: 0.55;
    transform: translateY(-50%) scale(0.88);
  }
  50% {
    opacity: 1;
    transform: translateY(-50%) scale(1.08);
  }
  100% {
    opacity: 0.55;
    transform: translateY(-50%) scale(0.88);
  }
}

.study-pron {
  margin-top: 14rpx;
  color: rgba(36, 42, 44, 0.58);
  font-size: 30rpx;
}

.study-phonetic {
  display: block;
  max-width: 100%;
  text-align: center;
  line-height: 1.25;
  white-space: nowrap;
}

.study-back {
  margin-top: 52rpx;
  min-height: 210rpx;
}

.study-back.is-placeholder {
  visibility: hidden;
}

.study-choice-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.study-choice-tag,
.study-easy-action {
  min-height: 52rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
  line-height: 52rpx;
}

.study-choice-tag.remembered {
  background: rgba(39, 198, 156, 0.13);
  color: #11a982;
}

.study-choice-tag.unfamiliar {
  background: rgba(232, 111, 79, 0.14);
  color: var(--accent-deep);
}

.study-choice-tag.easy,
.study-easy-action {
  background: rgba(36, 42, 44, 0.06);
  color: rgba(36, 42, 44, 0.48);
}

.study-meaning {
  margin-top: 42rpx;
  color: var(--text-main);
  font-size: 32rpx;
  line-height: 1.55;
  font-weight: 700;
}

.study-back .study-meaning {
  margin-top: 0;
}

.study-example {
  margin: 36rpx auto 0;
  max-width: 620rpx;
  color: rgba(36, 42, 44, 0.66);
  font-size: 30rpx;
  line-height: 1.55;
  text-align: left;
}

.study-example view + view {
  margin-top: 12rpx;
}

.flashcard-actions {
  margin-top: 88rpx;
  justify-content: center;
  gap: 24rpx;
}

.choice-action {
  flex: 1;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0;
  border-radius: var(--radius-pill);
  background: var(--surface-subtle);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
  line-height: 88rpx;
  box-shadow: none;
  transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.22s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.18s ease, background-color 0.18s ease;
  will-change: transform;
}

.choice-action:active,
.choice-action.is-pressed {
  transform: translateY(1rpx) scale(0.992);
  opacity: 0.96;
}

.choice-action.weak {
  color: var(--text-muted);
}

.choice-action.strong {
  background: var(--accent);
  color: var(--accent-contrast);
}

.choice-action.placeholder {
  visibility: hidden;
  pointer-events: none;
}

.choice-action.full {
  flex: 1 1 100%;
}

.choice-action.is-disabled,
.choice-action[disabled] {
  opacity: 0.46;
}
