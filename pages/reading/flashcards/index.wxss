.library-vocab-word-wrap {
  position: relative;
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr) 58rpx;
  align-items: center;
  column-gap: 14rpx;
  width: 100%;
  min-width: 0;
  padding: 0 8rpx;
  box-sizing: border-box;
  text-align: center;
}

.library-vocab-study-word {
  grid-column: 2;
  justify-self: center;
  display: inline-block;
  min-width: 0;
  max-width: 100%;
