  font-family: Georgia, "Times New Roman", serif;
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.12;
  overflow-wrap: normal;
  word-break: keep-all;
  white-space: normal;
}

.library-vocab-card.tone-phrase .library-vocab-study-word {
  font-size: 50rpx;
  line-height: 1.18;
}

.library-vocab-card.tone-pattern .library-vocab-study-word {
