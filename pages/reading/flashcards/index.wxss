.folder-body text:nth-child(2) { left: 27rpx; height: 42rpx; }
.folder-body text:nth-child(3) { right: 9rpx; height: 30rpx; transform: rotate(6deg); }

.listen-spell-symbol { border: 1rpx solid rgba(74, 119, 141, 0.18); border-radius: 50%; background: radial-gradient(circle at 50% 46%, #f8fcfd 0 32%, #d8e9f0 33% 62%, #b8d4df 63%); box-shadow: 0 10rpx 24rpx rgba(65, 111, 134, 0.16); }
.headphone-band { position: absolute; left: 26rpx; top: 22rpx; width: 48rpx; height: 48rpx; border: 7rpx solid #416f86; border-bottom: 0; border-radius: 32rpx 32rpx 0 0; }
.headphone-ear { position: absolute; top: 58rpx; width: 12rpx; height: 24rpx; border-radius: 8rpx; background: #416f86; }
.headphone-ear.left { left: 22rpx; }.headphone-ear.right { right: 22rpx; }
.spell-wave { position: absolute; left: 38rpx; top: 52rpx; display: flex; align-items: center; gap: 5rpx; height: 28rpx; }
.spell-wave text { display: block; width: 5rpx; border-radius: 5rpx; background: #6f9fb7; }
.spell-wave text:nth-child(1) { height: 12rpx; }.spell-wave text:nth-child(2) { height: 26rpx; }.spell-wave text:nth-child(3) { height: 17rpx; }
.dictation-practice { border-color: rgba(122, 170, 191, 0.28); background: linear-gradient(135deg, rgba(244,250,252,.92), rgba(226,240,246,.88)); }

.theme-library .vocab-practice-head { border-color: var(--lib-vocab-rule); border-radius: 12rpx; background: linear-gradient(90deg, rgba(43,33,27,.96), rgba(20,40,58,.94)); box-shadow: var(--lib-vocab-shadow); }
.theme-library .vocab-practice-kicker { color: var(--lib-vocab-brass); }
.theme-library .vocab-practice-title { color: var(--lib-vocab-paper); font-family: "Songti SC", STSong, serif; }
.theme-library .vocab-practice-copy { color: rgba(243,232,212,.76); }
.theme-library .vocab-practice-card { border-color: rgba(43,33,27,.18); border-radius: 10rpx 4rpx 4rpx 10rpx; background: var(--lib-vocab-paper); box-shadow: 0 10rpx 22rpx rgba(43,33,27,.14); }
.theme-library .vocab-practice-card-title { color: var(--lib-vocab-ink); font-family: "Songti SC", STSong, serif; }
.theme-library .vocab-practice-card-copy { color: var(--lib-vocab-muted); }
.theme-library .vocab-practice-arrow { color: var(--lib-vocab-brass); }
.theme-library .folder-symbol { border: 1rpx solid rgba(115,88,55,.22); border-radius: 6rpx; background: #e4d5bb; }
.theme-library .folder-tab { background: #7a624b; }
