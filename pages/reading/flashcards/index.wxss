.flashcard-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 90;
  box-sizing: border-box;
  background: rgba(246, 251, 253, 0.94);
  border-bottom: 1rpx solid rgba(141, 183, 212, 0.18);
  backdrop-filter: blur(22rpx);
}

.flashcard-back {
  position: absolute;
  left: 24rpx;
  bottom: 12rpx;
  width: 56rpx;
  height: 56rpx;
  color: #17314f;
  font-size: 60rpx;
  line-height: 48rpx;
  text-align: center;
}

.flashcard-nav-title {
  position: absolute;
  left: 160rpx;
  right: 160rpx;
  bottom: 20rpx;
  color: #17314f;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 40rpx;
  text-align: center;
}

.flashcard-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 72rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background:
    linear-gradient(180deg, #f6fbfd 0%, #edf6fa 48%, #f7fbfd 100%);
  color: #17314f;
}

.flashcard-page.is-review {
  padding-bottom: calc(34rpx + env(safe-area-inset-bottom));
}

.flashcard-page.is-review .library-hero,
.flashcard-page.is-review .vocab-summary,
.flashcard-page.is-review .review-log,
.flashcard-page.is-review .mode-tabs,
.flashcard-page.is-review .start-review,
.flashcard-page.is-review .sublevel-actions,
.flashcard-page.is-review .vocab-settings-panel,
.flashcard-page.is-review .review-metrics {
  display: none;
}

.bookshelf-head,
.library-hero,
.review-log,
.vocab-settings-panel,
.vocab-item,
.book-card,
.study-card,
.review-complete-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 44rpx rgba(71, 112, 138, 0.11);
  backdrop-filter: blur(24rpx);
}

.bookshelf-head,
.library-hero {
  position: relative;
  overflow: hidden;
  margin-top: 24rpx;
  padding: 34rpx 32rpx 32rpx;
  border-radius: 32rpx;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.86), rgba(225, 240, 248, 0.7));
}

.bookshelf-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  min-height: 182rpx;
}

.bookshelf-head::after {
  content: "";
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 30rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.16);
  pointer-events: none;
}

.bookshelf-copy {
  min-width: 0;
}

.bookshelf-scene {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  width: 188rpx;
  height: 116rpx;
}

.shelf-book,
.shelf-card {
  position: absolute;
  bottom: 12rpx;
  display: block;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82),
    0 12rpx 24rpx rgba(83, 128, 158, 0.13);
  backdrop-filter: blur(12rpx);
}

.shelf-book {
  width: 34rpx;
  border-radius: 8rpx 5rpx 5rpx 8rpx;
}

.shelf-book::before {
  content: "";
  position: absolute;
  left: 7rpx;
  top: 10rpx;
  bottom: 10rpx;
  width: 3rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.46);
}

.spine-a {
  left: 0;
  height: 92rpx;
  background: linear-gradient(180deg, rgba(202, 224, 238, 0.96), rgba(126, 168, 196, 0.78));
}

.spine-b {
  left: 42rpx;
  height: 106rpx;
  background: linear-gradient(180deg, rgba(195, 221, 217, 0.96), rgba(127, 168, 160, 0.78));
}

.spine-c {
  left: 84rpx;
  height: 84rpx;
  background: linear-gradient(180deg, rgba(237, 247, 251, 0.98), rgba(163, 198, 219, 0.76));
}

.shelf-card {
  right: 0;
  width: 64rpx;
  height: 84rpx;
  transform: rotate(-8deg);
  border-radius: 12rpx;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(222, 239, 248, 0.72)),
    rgba(255, 255, 255, 0.76);
}

.progress-title {
  position: relative;
  z-index: 1;
  color: #17314f;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.22;
}

.progress-copy,
.phonetic-preview {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  color: #607087;
  font-size: 26rpx;
  line-height: 1.42;
}

.phonetic-preview {
  color: #728196;
}

.demo-tag {
  margin-left: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(191, 215, 232, 0.5);
  color: #607087;
  font-size: 22rpx;
  vertical-align: middle;
}

.book-list {
  margin-top: 26rpx;
}

.shelf-board {
  position: relative;
  padding: 16rpx 0 6rpx;
}

.shelf-board::before,
.shelf-board::after {
  content: "";
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.16);
  pointer-events: none;
}

.shelf-board::before {
  top: 0;
}

.shelf-board::after {
  bottom: 0;
}

.book-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 148rpx;
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background:
    linear-gradient(90deg, rgba(237, 246, 250, 0.86), rgba(255, 255, 255, 0.78) 22%),
    rgba(255, 255, 255, 0.72);
}

.book-card:first-child {
  margin-top: 0;
}

.book-cover {
  position: relative;
  flex-shrink: 0;
  width: 82rpx;
  height: 108rpx;
  overflow: hidden;
  border-radius: 12rpx 7rpx 7rpx 12rpx;
  background:
    linear-gradient(150deg, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0) 38%),
    linear-gradient(135deg, rgba(142, 184, 211, 0.88), rgba(222, 239, 248, 0.92));
  border: 1rpx solid rgba(255, 255, 255, 0.84);
  box-shadow:
    inset -10rpx 0 18rpx rgba(255, 255, 255, 0.36),
    inset 1rpx 0 0 rgba(255, 255, 255, 0.82),
    0 12rpx 24rpx rgba(83, 128, 158, 0.14);
}

.book-cover::before {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 10rpx;
  bottom: 10rpx;
  width: 1rpx;
  background: rgba(255, 255, 255, 0.42);
}

.book-cover::after {
  content: "";
  position: absolute;
  right: -18rpx;
  top: 8rpx;
  width: 42rpx;
  height: 94rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  filter: blur(1rpx);
}

.book-depth {
  position: absolute;
  left: 16rpx;
  top: 18rpx;
  width: 82rpx;
  height: 108rpx;
  border-radius: 12rpx 7rpx 7rpx 12rpx;
  background: rgba(141, 183, 212, 0.1);
  transform: translate(10rpx, 8rpx);
}

.book-library .book-cover {
  background:
    linear-gradient(150deg, rgba(255, 255, 255, 0.58) 0%, rgba(255, 255, 255, 0) 38%),
    linear-gradient(135deg, rgba(134, 170, 161, 0.86), rgba(218, 238, 241, 0.9));
}

.book-junior .book-cover {
  background:
    linear-gradient(150deg, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0) 38%),
    linear-gradient(135deg, rgba(141, 183, 212, 0.9), rgba(232, 244, 249, 0.92));
}

.book-senior .book-cover {
  background:
    linear-gradient(150deg, rgba(255, 255, 255, 0.54) 0%, rgba(255, 255, 255, 0) 38%),
    linear-gradient(135deg, rgba(96, 112, 135, 0.82), rgba(190, 215, 232, 0.9));
}

.book-spine {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 14rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0)),
    rgba(23, 49, 79, 0.1);
  box-shadow: inset -1rpx 0 0 rgba(255, 255, 255, 0.26);
}

.book-symbol {
  position: absolute;
  left: 24rpx;
  top: 18rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.38);
  color: rgba(23, 49, 79, 0.82);
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
  font-weight: 600;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.68),
    0 8rpx 18rpx rgba(83, 128, 158, 0.1);
}

.book-library .book-symbol {
  color: rgba(77, 115, 109, 0.88);
}

.book-junior .book-symbol {
  color: rgba(81, 126, 158, 0.9);
}

.book-senior .book-symbol {
  color: rgba(56, 72, 96, 0.9);
}

.book-lines {
  position: absolute;
  left: 26rpx;
  right: 14rpx;
  bottom: 24rpx;
}

.book-lines text {
  display: block;
  height: 3rpx;
  margin-top: 9rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.62);
}

.book-lines text:first-child {
  margin-top: 0;
}

.book-main {
  flex: 1;
  min-width: 0;
}

.book-title {
  color: #17314f;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.32;
}

.book-meta {
  margin-top: 8rpx;
  color: #728196;
  font-size: 24rpx;
  line-height: 1.35;
}

.book-tag {
  flex-shrink: 0;
  max-width: 108rpx;
  padding: 8rpx 12rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.22);
  border-radius: 999rpx;
  color: #728196;
  font-size: 20rpx;
  line-height: 1;
}

.book-action,
.source-back {
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(191, 215, 232, 0.5);
  color: #17314f;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.book-action.is-loading {
  opacity: 0.52;
}

.progress-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-copy {
  min-width: 0;
}

.hero-card-stack {
  position: absolute;
  right: 34rpx;
  bottom: 74rpx;
  width: 170rpx;
  height: 96rpx;
  pointer-events: none;
}

.hero-card-stack text {
  position: absolute;
  display: block;
  width: 118rpx;
  height: 74rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.58);
  box-shadow: 0 12rpx 24rpx rgba(83, 128, 158, 0.12);
}

.hero-card-stack text:nth-child(1) {
  right: 30rpx;
  bottom: 0;
  transform: rotate(-8deg);
}

.hero-card-stack text:nth-child(2) {
  right: 8rpx;
  bottom: 12rpx;
  transform: rotate(5deg);
  background: rgba(191, 215, 232, 0.44);
}

.hero-card-stack text:nth-child(3) {
  right: 52rpx;
  bottom: 22rpx;
  width: 86rpx;
  height: 54rpx;
  background: rgba(242, 161, 142, 0.18);
}

.hero-tags {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 24rpx;
  padding-right: 150rpx;
}

.hero-tags text {
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.56);
  color: #607087;
  font-size: 22rpx;
  line-height: 1;
}

.progress-bar {
  position: relative;
  z-index: 1;
  height: 14rpx;
  margin-top: 30rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.18);
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #8db7d4, #86aaa1);
  transition: width 320ms ease;
}

.progress-fill.is-zero {
  width: 12rpx !important;
  opacity: 0.55;
}

.start-review {
  display: block;
  width: auto;
  height: 104rpx;
  min-height: 104rpx;
  box-sizing: border-box;
  margin: 26rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f2a18e, #df7f68);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 104rpx;
  box-shadow: 0 18rpx 34rpx rgba(223, 127, 104, 0.24);
}

.start-review::before,
.start-review::after,
.complete-action::before,
.complete-action::after,
.choice-action::before,
.choice-action::after {
  border: 0;
}

.sublevel-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.sublevel-actions view {
  min-width: 0;
  height: 72rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.54);
  color: #607087;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 72rpx;
  text-align: center;
}

.vocab-settings-panel,
.review-log {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 26rpx;
}

.vocab-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.vocab-count {
  min-width: 0;
  padding: 16rpx 8rpx;
  border-radius: 20rpx;
  background: rgba(237, 246, 250, 0.74);
  text-align: center;
}

.vocab-count text:first-child {
  display: block;
  color: #17314f;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
}

.vocab-count text:last-child {
  display: block;
  margin-top: 6rpx;
  color: #728196;
  font-size: 22rpx;
}

.limit-panel {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.limit-row {
  display: flex;
  min-width: 0;
  min-height: 122rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 14rpx 12rpx;
  border-radius: 22rpx;
  background: rgba(237, 246, 250, 0.74);
}

.limit-label {
  color: #607087;
  font-size: 24rpx;
  line-height: 1.2;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  max-width: 210rpx;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
}

.stepper-btn {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  min-height: 44rpx;
  padding: 0;
  border-radius: 50%;
  background: rgba(191, 215, 232, 0.48);
  color: #17314f;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.stepper-btn.disabled {
  color: rgba(96, 112, 135, 0.34);
}

.stepper-picker {
  flex: 1;
  min-width: 42rpx;
}

.stepper-value {
  display: block;
  min-width: 42rpx;
  color: #17314f;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
}

.log-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(141, 183, 212, 0.18);
  color: #607087;
  font-size: 26rpx;
}

.log-row:last-child {
  border-bottom: 0;
}

.log-row text:first-child {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vocab-list {
  position: relative;
  margin-top: 26rpx;
  padding: 18rpx 0 4rpx;
}

.vocab-library-shelf::before {
  content: "";
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 0;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.15);
}

.vocab-group {
  margin-top: 28rpx;
}

.vocab-group:first-child {
  margin-top: 0;
}

.vocab-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx 14rpx;
  color: #607087;
  font-size: 25rpx;
  font-weight: 600;
}

.vocab-group-head text:first-child {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(191, 215, 232, 0.34);
}

.vocab-item {
  position: relative;
  margin-top: 12rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.vocab-item::before {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 0;
  width: 92rpx;
  height: 10rpx;
  border-radius: 0 0 10rpx 10rpx;
  background: rgba(242, 161, 142, 0.34);
}

.vocab-item::after {
  content: "";
  position: absolute;
  left: 26rpx;
  right: 26rpx;
  bottom: 0;
  height: 8rpx;
  border-radius: 999rpx 999rpx 0 0;
  background: rgba(141, 183, 212, 0.16);
}

.vocab-card-top {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.vocab-card-index {
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
  margin-top: 6rpx;
  border-radius: 9rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0)),
    #8db7d4;
  box-shadow: inset -5rpx -5rpx 0 rgba(134, 170, 161, 0.28);
}

.vocab-word-main {
  flex: 1;
  min-width: 0;
}

.vocab-light-tag {
  flex-shrink: 0;
  max-width: 132rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(237, 246, 250, 0.84);
  color: #728196;
  font-size: 20rpx;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vocab-text {
  color: #17314f;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.28;
  overflow-wrap: break-word;
}

.vocab-phonetic {
  margin-top: 6rpx;
  color: #728196;
  font-size: 24rpx;
  line-height: 1.35;
}

.vocab-meaning,
.vocab-example {
  margin-top: 12rpx;
  color: #607087;
  font-size: 27rpx;
  line-height: 1.48;
}

.vocab-example {
  color: #728196;
}

.flashcard-debug {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(237, 246, 250, 0.84);
  color: #607087;
  font-size: 22rpx;
  line-height: 1.45;
}

.flashcard-debug text {
  display: block;
  word-break: break-all;
}

.review-full-head {
  display: none;
}

.is-review .review-full-head {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  margin: 8rpx 0 22rpx;
}

.review-exit,
.review-full-progress {
  color: #607087;
  font-size: 25rpx;
  font-weight: 600;
}

.review-full-progress {
  justify-self: center;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.58);
  color: #17314f;
}

.review-metrics {
  display: none;
}

.review-complete-card {
  position: relative;
  overflow: hidden;
  min-height: 620rpx;
  padding: 108rpx 36rpx 48rpx;
  border-radius: 34rpx;
  text-align: center;
}

.complete-stack {
  position: absolute;
  left: 50%;
  top: 62rpx;
  width: 236rpx;
  height: 170rpx;
  transform: translateX(-50%);
  pointer-events: none;
}

.complete-stack text {
  position: absolute;
  display: block;
  width: 158rpx;
  height: 104rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 18rpx;
  box-shadow: 0 16rpx 30rpx rgba(83, 128, 158, 0.12);
}

.complete-stack text:nth-child(1) {
  left: 6rpx;
  top: 42rpx;
  transform: rotate(-10deg);
  background: rgba(191, 215, 232, 0.42);
}

.complete-stack text:nth-child(2) {
  right: 4rpx;
  top: 24rpx;
  transform: rotate(8deg);
  background: rgba(134, 170, 161, 0.24);
}

.complete-stack text:nth-child(3) {
  left: 42rpx;
  top: 0;
  background: rgba(255, 255, 255, 0.62);
}

.complete-badge {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  margin: 42rpx auto 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #86aaa1, #8db7d4);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 20rpx 42rpx rgba(86, 139, 151, 0.2);
}

.complete-title {
  position: relative;
  z-index: 1;
  color: #17314f;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.24;
}

.complete-action {
  position: relative;
  z-index: 1;
  display: block;
  width: 260rpx;
  height: 88rpx;
  min-height: 88rpx;
  margin: 64rpx auto 0;
  padding: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f2a18e, #df7f68);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
  box-shadow: 0 16rpx 30rpx rgba(223, 127, 104, 0.2);
}

.study-card {
  position: relative;
  display: grid;
  grid-template-rows: 226rpx 150rpx 88rpx;
  min-height: 526rpx;
  margin-top: 12rpx;
  padding: 52rpx 30rpx 34rpx;
  border-radius: 34rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.88), rgba(244, 250, 252, 0.82));
  text-align: center;
}

.study-card::before,
.study-card::after {
  content: "";
  position: absolute;
  z-index: 0;
  left: 28rpx;
  right: 28rpx;
  height: 72rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.44);
  box-shadow: 0 14rpx 26rpx rgba(71, 112, 138, 0.08);
  pointer-events: none;
}

.study-card::before {
  top: -10rpx;
  transform: rotate(-1.4deg);
}

.study-card::after {
  top: -20rpx;
  transform: rotate(1.2deg);
}

.memory-stack-mark {
  position: absolute;
  left: 34rpx;
  top: 34rpx;
  display: flex;
  gap: 7rpx;
}

.memory-stack-mark text {
  display: block;
  width: 28rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.36);
}

.memory-stack-mark text:nth-child(2) {
  background: rgba(134, 170, 161, 0.38);
}

.memory-stack-mark text:nth-child(3) {
  background: rgba(242, 161, 142, 0.32);
}

.study-card-head,
.study-back,
.flashcard-actions {
  position: relative;
  z-index: 1;
}

.study-card.is-unfamiliar {
  border-color: rgba(242, 161, 142, 0.46);
}

.study-card.is-easy .study-word {
  color: #607087;
}

.study-card-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 12rpx;
  min-height: 0;
}

.study-age {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(191, 215, 232, 0.48);
  color: #607087;
  font-size: 24rpx;
  line-height: 1.2;
}

.study-word-row {
  position: relative;
  width: 100%;
  margin-top: 30rpx;
  padding: 0 88rpx;
  box-sizing: border-box;
  text-align: center;
}

.study-word {
  display: inline-block;
  max-width: 100%;
  color: #17314f;
  font-size: 66rpx;
  font-weight: 600;
  line-height: 1.12;
  overflow-wrap: break-word;
}

.study-card.tone-phrase .study-word {
  font-size: 52rpx;
  line-height: 1.18;
}

.study-card.tone-pattern .study-word {
  font-size: 42rpx;
  line-height: 1.28;
}

.study-card.tone-phrase .study-word-row,
.study-card.tone-pattern .study-word-row {
  margin-top: 26rpx;
  padding: 0 76rpx;
}

.study-speak {
  position: absolute;
  right: 10rpx;
  top: 50%;
  width: 58rpx;
  height: 58rpx;
  transform: translateY(-50%);
  border-radius: 999rpx;
  background: rgba(191, 215, 232, 0.52);
  color: #17314f;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 58rpx;
}

.study-speak.is-loading {
  animation: audioPulse 0.72s ease-in-out infinite;
}

@keyframes audioPulse {
  0%, 100% {
    opacity: 0.55;
    transform: translateY(-50%) scale(0.9);
  }

  50% {
    opacity: 1;
    transform: translateY(-50%) scale(1.06);
  }
}

.study-pron {
  margin-top: 12rpx;
  color: #728196;
  font-size: 30rpx;
  line-height: 1.35;
}

.study-phonetic {
  display: block;
  max-width: 100%;
  text-align: center;
  white-space: normal;
}

.study-back {
  min-height: 0;
  margin-top: 20rpx;
  overflow: hidden;
}

.study-back.is-placeholder {
  visibility: hidden;
  min-height: 0;
  margin-top: 20rpx;
}

.study-choice-row {
  display: none;
}

.study-meaning {
  color: #17314f;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.42;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.study-example {
  max-width: 620rpx;
  margin: 18rpx auto 0;
  color: #607087;
  font-size: 26rpx;
  line-height: 1.45;
  text-align: left;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.study-example view + view {
  margin-top: 12rpx;
  color: #728196;
}

.flashcard-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  align-self: end;
  min-height: 88rpx;
  margin-top: 0;
  padding-top: 0;
}

.choice-action {
  flex: 1;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0;
  border-radius: 999rpx;
  background: rgba(237, 246, 250, 0.9);
  color: #607087;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 88rpx;
  box-shadow: none;
}

.choice-action.strong {
  background: linear-gradient(135deg, #f2a18e, #df7f68);
  color: #fff;
  box-shadow: 0 14rpx 26rpx rgba(223, 127, 104, 0.2);
}

.choice-action.weak {
  border: 1rpx solid rgba(141, 183, 212, 0.24);
}

.choice-action.placeholder {
  visibility: hidden;
  pointer-events: none;
}

.choice-action.is-disabled,
.choice-action[disabled] {
  opacity: 0.46;
}

.choice-action:active,
.choice-action.is-pressed,
.complete-action.is-pressed {
  transform: translateY(1rpx) scale(0.992);
  opacity: 0.96;
}

.empty-state {
  margin-top: 28rpx;
  padding: 56rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.62);
  color: #728196;
  font-size: 28rpx;
  text-align: center;
}

.limit-picker-mask {
  position: fixed;
  inset: 0;
  z-index: 99;
  display: flex;
  align-items: flex-end;
  background: rgba(23, 49, 79, 0.36);
}

.limit-picker-sheet {
  width: 100%;
  overflow: hidden;
  border-radius: 32rpx 32rpx 0 0;
  background: #f6fbfd;
}

.limit-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid rgba(141, 183, 212, 0.18);
}

.limit-picker-title {
  color: #17314f;
  font-size: 28rpx;
  font-weight: 600;
}

.limit-picker-action {
  min-width: 80rpx;
  color: #607087;
  font-size: 28rpx;
}

.limit-picker-action.confirm {
  color: #86aaa1;
  text-align: right;
  font-weight: 600;
}

.limit-picker-wheel {
  position: relative;
  background: #f6fbfd;
}

.limit-picker-wheel::before,
.limit-picker-wheel::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  z-index: 1;
  height: 1rpx;
  background: rgba(141, 183, 212, 0.18);
  pointer-events: none;
}

.limit-picker-wheel::before {
  top: 168rpx;
}

.limit-picker-wheel::after {
  top: 252rpx;
}

.limit-picker-view {
  height: 420rpx;
  background: #f6fbfd;
}

.limit-picker-list {
  padding: 168rpx 0;
}

.limit-picker-item {
  height: 84rpx;
  color: rgba(96, 112, 135, 0.42);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 84rpx;
  text-align: center;
}

.limit-picker-item.selected {
  color: #17314f;
  font-size: 38rpx;
  font-weight: 600;
}
