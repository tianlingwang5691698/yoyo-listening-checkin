<block wx:if="{{theme === 'library'}}">
  <view class="theme-{{theme}} language-{{language}} page-shell library-reading-page" bindtouchstart="onDirectoryTouchStart" bindtouchend="onDirectoryTouchEnd">
    <view class="library-room-glow"></view>

    <view class="library-catalogue-cover">
      <view class="catalogue-spine"></view>
      <view class="catalogue-pages">
        <view class="catalogue-page page-back"></view>
        <view class="catalogue-page page-mid"></view>
        <view class="catalogue-page page-front">
          <view class="catalogue-rule short"></view>
          <view class="catalogue-rule"></view>
          <view class="catalogue-rule"></view>
        </view>
      </view>
      <view class="catalogue-copy">
        <view class="catalogue-kicker">{{texts.eyebrow}}</view>
        <view class="catalogue-title">{{texts.title}}</view>
      </view>
      <view class="catalogue-page-tag">READ</view>
    </view>

    <view class="reading-history-tabs is-library">
      <view class="reading-history-tab is-active">{{texts.directory}}</view>
      <view class="reading-history-tab" bindtap="openPracticeHistory">{{texts.history}}</view>
    </view>

    <view class="library-index-panel">
      <view class="library-index-head">
        <view>
          <view class="library-index-label">{{selectedHeader}}</view>
          <view class="library-breadcrumb" wx:if="{{!isRootLevel}}">
            <text bindtap="backToRoot">{{texts.eyebrow}}</text>
            <text> / </text>
            <text bindtap="backToStage">{{selectedStageNode.label}}</text>
            <text wx:if="{{isExamLevel}}"> / {{selectedGroup.label}}</text>
            <text wx:if="{{isDistrictLevel}}"> / </text>
            <text wx:if="{{isDistrictLevel}}" bindtap="backToExam">{{selectedGroup.label}}</text>
            <text wx:if="{{isDistrictLevel}}"> / {{selectedDistrictNode.label}}</text>
          </view>
        </view>
        <view class="library-index-count" wx:if="{{isRootLevel && categoryRoot}}">{{categoryRoot.count}}{{texts.articleUnit}}</view>
        <view class="library-index-back hierarchy-back" wx:elif="{{!isRootLevel}}" bindtap="backOneLevel">{{texts.back}}</view>
      </view>

      <view class="library-skeleton" wx:if="{{loading && !categoryRoot}}">
        <view class="skeleton-title"></view>
        <view class="skeleton-slip"></view>
        <view class="skeleton-slip"></view>
        <view class="skeleton-slip short"></view>
      </view>

      <block wx:elif="{{categoryRoot}}">
        <view class="library-root-ledger" wx:if="{{isRootLevel}}">
          <view class="library-ledger-row" wx:for="{{categoryRoot.stages}}" wx:key="key" data-stage="{{item.key}}" bindtap="selectStage">
            <view class="ledger-tab">{{index + 1}}</view>
            <view class="ledger-body">
              <view class="ledger-title">{{item.label}}</view>
              <view class="ledger-meta">{{item.meta}} · {{item.count}}{{texts.articleUnit}}</view>
            </view>
            <view class="ledger-corner">{{texts.enter}}</view>
          </view>
        </view>

        <view class="library-root-ledger" wx:elif="{{isStageLevel}}">
          <view class="library-ledger-row" wx:for="{{selectedStageNode.groups}}" wx:key="key" data-exam-type="{{item.key}}" bindtap="selectExamType">
            <view class="ledger-tab">{{index + 1}}</view>
            <view class="ledger-body">
              <view class="ledger-title">{{item.label}}</view>
              <view class="ledger-meta">{{item.districts.length}}{{item.nodeUnit || texts.districtUnit}} · {{item.count}}{{texts.articleUnit}}</view>
            </view>
            <view class="ledger-corner">{{texts.enter}}</view>
          </view>
        </view>

        <view class="library-drawer-list" wx:elif="{{isExamLevel}}">
          <view class="library-drawer-row" wx:for="{{selectedGroup.districts}}" wx:key="key" data-district="{{item.key}}" bindtap="selectDistrict">
            <view class="drawer-rail"></view>
            <view class="drawer-body">
              <view class="drawer-title">{{item.label}}</view>
              <view class="drawer-meta" wx:if="{{item.completionReady}}">{{item.completedCount}} / {{item.count}} {{texts.completed}}</view>
              <view class="drawer-meta" wx:else>{{item.count}}{{texts.articleUnit}}</view>
            </view>
            <view class="drawer-arrow">›</view>
          </view>
        </view>

        <view class="library-paper-index" wx:elif="{{isDistrictLevel}}">
          <view class="library-paper-row" wx:for="{{selectedDistrictNode.passages}}" wx:key="_id" data-passage-id="{{item._id}}" bindtap="openPassage">
            <view class="paper-row-number">{{index + 1}}</view>
            <view class="paper-row-main">
              <view class="paper-row-title">{{item.title}}</view>
              <view class="paper-row-meta">{{item.meta}} · {{item.questionCount}}{{texts.questionUnit}}</view>
            </view>
            <view class="paper-row-tag {{item.completed ? 'is-done' : ''}}">{{item.completionReady ? (item.completed ? texts.review : texts.practice) : texts.enter}}</view>
          </view>
        </view>
      </block>

      <view class="library-empty-catalogue" wx:else>
        <view class="empty-book-mark"></view>
        <view>{{syncMode === 'cloud-error' ? texts.loadFailed : texts.empty}}</view>
        <button wx:if="{{syncMode === 'cloud-error'}}" bindtap="loadDirectory">{{texts.retry}}</button>
      </view>
    </view>
  </view>
</block>

<block wx:else>
  <view class="theme-{{theme}} language-{{language}} page-shell reading-page" bindtouchstart="onDirectoryTouchStart" bindtouchend="onDirectoryTouchEnd">
    <view class="reading-atmosphere">
      <view class="reading-light light-one"></view>
      <view class="reading-light light-two"></view>
      <view class="reading-line line-one"></view>
      <view class="reading-line line-two"></view>
    </view>

    <view class="reading-hero">
      <view class="hero-pages">
        <view class="hero-page hero-page-back"></view>
        <view class="hero-page hero-page-front">
          <view class="hero-page-line line-short"></view>
          <view class="hero-page-line"></view>
          <view class="hero-page-line"></view>
        </view>
      </view>
      <view class="reading-eyebrow">{{texts.eyebrow}}</view>
      <view class="reading-title">{{texts.title}}</view>
    </view>

    <view class="reading-history-tabs">
      <view class="reading-history-tab is-active">{{texts.directory}}</view>
      <view class="reading-history-tab" bindtap="openPracticeHistory">{{texts.history}}</view>
    </view>

    <block wx:if="{{categoryRoot}}">
      <view class="reading-card">
        <view class="reading-card-top">
          <view class="reading-card-label">
            <text>{{selectedHeader}}</text>
          </view>
          <view class="reading-card-state" wx:if="{{isRootLevel}}">{{categoryRoot.count}}{{texts.articleUnit}}</view>
          <view class="directory-back-icon hierarchy-back" wx:else bindtap="backOneLevel">{{texts.back}}</view>
        </view>

        <view class="reading-breadcrumb" wx:if="{{!isRootLevel}}">
          <text bindtap="backToRoot">{{texts.eyebrow}}</text>
          <text> / </text>
          <text bindtap="backToStage">{{selectedStageNode.label}}</text>
          <text wx:if="{{isExamLevel}}"> / {{selectedGroup.label}}</text>
          <text wx:if="{{isDistrictLevel}}"> / </text>
          <text wx:if="{{isDistrictLevel}}" bindtap="backToExam">{{selectedGroup.label}}</text>
          <text wx:if="{{isDistrictLevel}}"> / {{selectedDistrictNode.label}}</text>
        </view>

        <view class="paper-group-grid" wx:if="{{isRootLevel}}">
          <view class="directory-row paper-group-panel" wx:for="{{categoryRoot.stages}}" wx:key="key" data-stage="{{item.key}}" bindtap="selectStage">
            <view class="directory-mark paper-stack-mark">
              <view class="paper-stack-line"></view>
              <view class="paper-stack-line"></view>
            </view>
            <view class="directory-main">
              <view class="directory-title">{{item.label}}</view>
              <view class="directory-meta">{{item.meta}} · {{item.count}}{{texts.articleUnit}}</view>
            </view>
            <view class="directory-arrow">›</view>
          </view>
        </view>

        <view class="paper-group-grid" wx:elif="{{isStageLevel}}">
          <view class="directory-row paper-group-panel" wx:for="{{selectedStageNode.groups}}" wx:key="key" data-exam-type="{{item.key}}" bindtap="selectExamType">
            <view class="directory-mark paper-stack-mark">
              <view class="paper-stack-line"></view>
              <view class="paper-stack-line"></view>
            </view>
            <view class="directory-main">
              <view class="directory-title">{{item.label}}</view>
              <view class="directory-meta">{{item.districts.length}}{{item.nodeUnit || texts.districtUnit}} · {{item.count}}{{texts.articleUnit}}</view>
            </view>
            <view class="directory-arrow">›</view>
          </view>
        </view>

        <view class="district-drawer-list" wx:elif="{{isExamLevel}}">
          <view class="directory-row district-drawer" wx:for="{{selectedGroup.districts}}" wx:key="key" data-district="{{item.key}}" bindtap="selectDistrict">
            <view class="directory-mark drawer-tab"></view>
            <view class="directory-main">
              <view class="directory-title">{{item.label}}</view>
              <view class="directory-meta" wx:if="{{item.completionReady}}">{{item.completedCount}} / {{item.count}} {{texts.completed}}</view>
              <view class="directory-meta" wx:else>{{item.count}}{{texts.articleUnit}}</view>
            </view>
            <view class="directory-arrow">›</view>
          </view>
        </view>

        <view class="reading-sheet-list" wx:elif="{{isDistrictLevel}}">
          <view class="task-row reading-sheet" wx:for="{{selectedDistrictNode.passages}}" wx:key="_id" data-passage-id="{{item._id}}" bindtap="openPassage">
            <view class="sheet-fold"></view>
            <view class="task-index">{{index + 1}}</view>
            <view class="task-main">
              <view class="task-title">{{item.title}}</view>
              <view class="task-meta">{{item.meta}} · {{item.questionCount}}{{texts.questionUnit}}</view>
            </view>
            <view class="task-state {{item.completed ? 'is-done' : ''}}">{{item.completionReady ? (item.completed ? texts.review : texts.practice) : texts.enter}}</view>
          </view>
        </view>
      </view>

    </block>
  </view>
</block>
