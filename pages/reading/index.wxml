<view class="theme-{{theme}} page-shell reading-page" bindtouchstart="onDirectoryTouchStart" bindtouchend="onDirectoryTouchEnd">
  <view class="reading-atmosphere">
    <view class="reading-light light-one"></view>
    <view class="reading-light light-two"></view>
    <view class="reading-line line-one"></view>
    <view class="reading-line line-two"></view>
  </view>

  <view class="reading-hero">
    <view class="hero-pages">
      <view class="hero-page hero-page-back"></view>
      <view class="hero-page hero-page-front">
        <view class="hero-page-line line-short"></view>
        <view class="hero-page-line"></view>
        <view class="hero-page-line"></view>
      </view>
    </view>
    <view class="reading-eyebrow">中考阅读</view>
    <view class="reading-title">选择一篇好好读</view>
    <view class="reading-copy">一模、二模、真题卷</view>
  </view>

  <block wx:if="{{categoryRoot}}">
    <view class="reading-card">
      <view class="reading-card-top">
        <view class="reading-card-label">
          <text>{{selectedHeader}}</text>
        </view>
        <view class="reading-card-state" wx:if="{{isRootLevel}}">{{categoryRoot.count}} 篇</view>
        <view class="directory-back-icon" wx:else bindtap="backOneLevel">‹ 上一级</view>
      </view>

      <view class="reading-breadcrumb" wx:if="{{!isRootLevel}}">
        <text bindtap="backToRoot">中考阅读</text>
        <text> / </text>
        <text wx:if="{{isExamLevel}}">{{selectedGroup.label}}</text>
        <text wx:if="{{isDistrictLevel}}" bindtap="backToExam">{{selectedGroup.label}}</text>
        <text wx:if="{{isDistrictLevel}}"> / {{selectedDistrictNode.label}}</text>
      </view>

      <view class="paper-group-grid" wx:if="{{isRootLevel}}">
        <view class="directory-row paper-group-panel" wx:for="{{categoryRoot.groups}}" wx:key="key" data-exam-type="{{item.key}}" bindtap="selectExamType">
          <view class="directory-mark paper-stack-mark">
            <view class="paper-stack-line"></view>
            <view class="paper-stack-line"></view>
          </view>
          <view class="directory-main">
            <view class="directory-title">{{item.label}}</view>
            <view class="directory-meta">{{item.districts.length}} 个区 · {{item.count}} 篇</view>
          </view>
          <view class="directory-arrow">›</view>
        </view>
      </view>

      <view class="district-drawer-list" wx:elif="{{isExamLevel}}">
        <view class="directory-row district-drawer" wx:for="{{selectedGroup.districts}}" wx:key="key" data-district="{{item.key}}" bindtap="selectDistrict">
          <view class="directory-mark drawer-tab"></view>
          <view class="directory-main">
            <view class="directory-title">{{item.label}}</view>
            <view class="directory-meta" wx:if="{{item.completionReady}}">{{item.completedCount}} / {{item.count}} 已完成</view>
            <view class="directory-meta" wx:else>{{item.count}} 篇</view>
          </view>
          <view class="directory-arrow">›</view>
        </view>
      </view>

      <view class="reading-sheet-list" wx:elif="{{isDistrictLevel}}">
        <view class="task-row reading-sheet" wx:for="{{selectedDistrictNode.passages}}" wx:key="_id" data-passage-id="{{item._id}}" bindtap="openPassage">
          <view class="sheet-fold"></view>
          <view class="task-index">{{index + 1}}</view>
          <view class="task-main">
            <view class="task-title">{{item.title}}</view>
            <view class="task-meta">{{item.meta}} · {{item.questionCount}} 题</view>
          </view>
          <view class="task-state {{item.completed ? 'is-done' : ''}}">{{item.completionReady ? (item.completed ? '复习' : '练习') : '进入'}}</view>
        </view>
      </view>
    </view>

  </block>
</view>
