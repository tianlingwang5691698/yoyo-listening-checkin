.reading-page {
  position: relative;
  min-height: 100vh;
  padding-top: 72rpx;
  padding-bottom: 132rpx;
  background: linear-gradient(180deg, #f6fbfd 0%, #edf6fa 48%, #f7fbfd 100%);
  color: #17314f;
  overflow: hidden;
}

.reading-atmosphere {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  overflow: hidden;
}

.reading-light {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(191, 215, 232, 0.42);
  filter: blur(2rpx);
}

.light-one {
  top: 18rpx;
  right: -112rpx;
  width: 360rpx;
  height: 360rpx;
}

.light-two {
  top: 388rpx;
  left: -168rpx;
  width: 420rpx;
  height: 420rpx;
  background: rgba(242, 161, 142, 0.12);
}

.reading-line {
  position: absolute;
  height: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, transparent, rgba(141, 183, 212, 0.42), rgba(255, 255, 255, 0.8));
}

.line-one {
  top: 238rpx;
  left: 34rpx;
  right: 88rpx;
}

.line-two {
  top: 614rpx;
  left: 130rpx;
  right: 28rpx;
  opacity: 0.62;
}

.reading-hero,
.reading-card {
  position: relative;
  z-index: 1;
}

.reading-hero {
  min-height: 246rpx;
  padding: 42rpx 36rpx 38rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 34rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.92), rgba(229, 243, 249, 0.68));
  box-shadow: 0 24rpx 58rpx rgba(91, 132, 160, 0.16);
  overflow: hidden;
}

.reading-hero::after {
  content: "";
  position: absolute;
  right: 34rpx;
  bottom: 0;
  width: 168rpx;
  height: 22rpx;
  border-radius: 22rpx 22rpx 0 0;
  background: rgba(141, 183, 212, 0.18);
}

.reading-history-tabs {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 6rpx;
  margin-top: 20rpx;
  padding: 6rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.22);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.62);
}

.reading-history-tab {
  min-width: 0;
  padding: 16rpx 10rpx;
  border-radius: 9rpx;
  color: #607087;
  font-size: 25rpx;
  line-height: 1.2;
  text-align: center;
}

.reading-history-tab.is-active {
  background: #17314f;
  color: #fff;
  font-weight: 600;
}

.reading-history-tabs.is-library {
  border-color: rgba(184, 149, 98, 0.36);
  border-radius: 6rpx;
  background: rgba(255, 253, 247, 0.78);
}

.reading-history-tabs.is-library .reading-history-tab {
  border-radius: 3rpx;
  color: var(--lib-text-secondary);
}

.reading-history-tabs.is-library .reading-history-tab.is-active {
  background: var(--lib-panel-ink);
  color: #fffdf7;
}

.hero-pages {
  position: absolute;
  right: 38rpx;
  top: 38rpx;
  width: 170rpx;
  height: 154rpx;
}

.hero-page {
  position: absolute;
  width: 118rpx;
  height: 146rpx;
  border-radius: 18rpx 18rpx 8rpx 8rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(191, 215, 232, 0.38);
  box-shadow: 0 16rpx 28rpx rgba(91, 132, 160, 0.1);
}

.hero-page-back {
  right: 0;
  top: 8rpx;
  transform: rotate(7deg);
  background: rgba(237, 246, 250, 0.88);
}

.hero-page-front {
  right: 26rpx;
  top: 0;
  padding: 34rpx 18rpx 0;
  box-sizing: border-box;
}

.hero-page-front::after {
  content: "";
  position: absolute;
  right: -1rpx;
  top: -1rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 0 18rpx 0 12rpx;
  background: linear-gradient(135deg, rgba(191, 215, 232, 0.52), rgba(255, 255, 255, 0.96));
}

.hero-page-line {
  height: 4rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.32);
}

.hero-page-line.line-short {
  width: 58rpx;
  background: rgba(242, 161, 142, 0.35);
}

.reading-eyebrow {
  display: inline-flex;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.18);
  color: #607087;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 500;
}

.reading-title {
  margin-top: 28rpx;
  color: #17314f;
  font-size: 50rpx;
  line-height: 1.15;
  font-weight: 600;
}

.reading-card {
  margin-top: 30rpx;
  padding: 28rpx 24rpx 26rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.52);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 18rpx 46rpx rgba(91, 132, 160, 0.11);
  backdrop-filter: blur(16rpx);
}

.reading-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 8rpx;
}

.reading-card-label,
.reading-card-state,
.directory-back-icon {
  color: #607087;
  font-size: 23rpx;
  line-height: 1.35;
  font-weight: 600;
}

.directory-back-icon {
  flex-shrink: 0;
  color: #577f9d;
}

.reading-breadcrumb {
  margin-top: 16rpx;
  padding: 0 8rpx;
  color: #728196;
  font-size: 22rpx;
  line-height: 1.4;
}

.directory-list,
.task-list,
.paper-group-grid,
.district-drawer-list,
.reading-sheet-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.directory-row {
  position: relative;
  min-height: 136rpx;
  padding: 26rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(235, 247, 251, 0.72));
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  box-shadow: 0 16rpx 38rpx rgba(91, 132, 160, 0.12);
  display: flex;
  align-items: center;
  gap: 20rpx;
  overflow: hidden;
}

.directory-row::after {
  content: "";
  position: absolute;
  left: 116rpx;
  right: 76rpx;
  bottom: 24rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(141, 183, 212, 0.28), transparent);
}

.directory-mark {
  flex-shrink: 0;
  width: 48rpx;
  height: 78rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(141, 183, 212, 0.76), rgba(191, 215, 232, 0.3));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
}

.paper-group-panel {
  min-height: 160rpx;
  padding: 30rpx 24rpx;
  border-radius: 26rpx 30rpx 30rpx 26rpx;
  background:
    linear-gradient(90deg, rgba(141, 183, 212, 0.16) 0 18rpx, transparent 18rpx),
    linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(237, 246, 250, 0.72));
}

.paper-group-panel::before {
  content: "";
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  bottom: 18rpx;
  width: 1rpx;
  background: rgba(141, 183, 212, 0.3);
}

.paper-stack-mark {
  width: 62rpx;
  height: 82rpx;
  border-radius: 10rpx 14rpx 8rpx 8rpx;
  background: #ffffff;
  border: 1rpx solid rgba(191, 215, 232, 0.52);
  box-shadow: 8rpx 8rpx 0 rgba(237, 246, 250, 0.9), 14rpx 14rpx 0 rgba(191, 215, 232, 0.22);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.paper-stack-line {
  height: 3rpx;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.42);
}

.district-drawer {
  min-height: 128rpx;
  padding-left: 0;
  border-radius: 8rpx 26rpx 26rpx 8rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.96), rgba(237, 246, 250, 0.78));
}

.drawer-tab {
  align-self: stretch;
  width: 18rpx;
  height: auto;
  border-radius: 0 999rpx 999rpx 0;
  background: linear-gradient(180deg, rgba(242, 161, 142, 0.48), rgba(141, 183, 212, 0.42));
  box-shadow: none;
}

.directory-main {
  flex: 1;
  min-width: 0;
}

.directory-title {
  color: #17314f;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 600;
}

.directory-meta,
.task-meta {
  margin-top: 9rpx;
  color: #728196;
  font-size: 23rpx;
  line-height: 1.35;
}

.directory-arrow {
  flex-shrink: 0;
  color: #8db7d4;
  font-size: 42rpx;
  line-height: 1;
}

.task-row {
  position: relative;
  min-height: 118rpx;
  padding: 24rpx 20rpx 24rpx 24rpx;
  border-radius: 18rpx 26rpx 26rpx 18rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(250, 253, 254, 0.9));
  border: 1rpx solid rgba(191, 215, 232, 0.34);
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-shadow: 0 12rpx 26rpx rgba(91, 132, 160, 0.08);
  overflow: hidden;
}

.reading-sheet::before {
  content: "";
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 8rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: rgba(141, 183, 212, 0.26);
}

.sheet-fold {
  position: absolute;
  right: 0;
  top: 0;
  width: 42rpx;
  height: 42rpx;
  border-radius: 0 24rpx 0 14rpx;
  background: linear-gradient(135deg, rgba(191, 215, 232, 0.56), rgba(255, 255, 255, 0.98));
}

.task-index {
  flex-shrink: 0;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: rgba(141, 183, 212, 0.18);
  color: #577f9d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 600;
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-title {
  color: #17314f;
  font-size: 30rpx;
  line-height: 1.32;
  font-weight: 600;
}

.task-state {
  flex-shrink: 0;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.16);
  color: #577f9d;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 600;
}

.task-state.is-done {
  background: rgba(134, 170, 161, 0.18);
  color: #5f8b82;
}

.section-panel,
.empty-state {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
}

.library-reading-page {
  --lib-bg-room: #2B211B;
  --lib-bg-paper: #FAF5EA;
  --lib-bg-paper-muted: #F3E8D4;
  --lib-panel-ink: #14283A;
  --lib-accent-brass: #B89562;
  --lib-accent-moss: #7F8C78;
  --lib-text-primary: #2B211B;
  --lib-text-secondary: #6F675F;
  --lib-error: #9A5F55;
  --lib-rule: rgba(184, 149, 98, 0.42);
  position: relative;
  min-height: 100vh;
  padding-top: 58rpx;
  padding-bottom: 132rpx;
  background:
    linear-gradient(180deg, rgba(20, 40, 58, 0.88) 0, rgba(43, 33, 27, 0.74) 260rpx, rgba(250, 245, 234, 0) 520rpx),
    linear-gradient(180deg, #efe1c8 0%, #faf5ea 54%, #f3e8d4 100%);
  color: var(--lib-text-primary);
  overflow: hidden;
}

.library-room-glow {
  position: absolute;
  top: 40rpx;
  right: 32rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(184, 149, 98, 0.2);
  filter: blur(10rpx);
  pointer-events: none;
}

.library-catalogue-cover,
.library-index-panel {
  position: relative;
  z-index: 1;
}

.library-catalogue-cover {
  min-height: 286rpx;
  padding: 40rpx 34rpx 36rpx 54rpx;
  border-radius: 2rpx 8rpx 8rpx 2rpx;
  background:
    linear-gradient(90deg, rgba(20, 40, 58, 0.92) 0 26rpx, transparent 26rpx),
    linear-gradient(135deg, #f3e8d4 0%, #faf5ea 58%, #ead8b8 100%);
  border: 1rpx solid rgba(184, 149, 98, 0.4);
  box-shadow: 0 12rpx 36rpx rgba(43, 33, 27, 0.18);
  overflow: hidden;
}

.catalogue-spine {
  position: absolute;
  left: 26rpx;
  top: 26rpx;
  bottom: 26rpx;
  width: 1rpx;
  background: var(--lib-rule);
}

.catalogue-pages {
  position: absolute;
  right: 36rpx;
  top: 36rpx;
  width: 190rpx;
  height: 176rpx;
}

.catalogue-page {
  position: absolute;
  width: 128rpx;
  height: 158rpx;
  border-radius: 2rpx 8rpx 8rpx 2rpx;
  background: #faf5ea;
  border: 1rpx solid rgba(184, 149, 98, 0.34);
  box-shadow: 8rpx 8rpx 0 rgba(184, 149, 98, 0.12);
}

.page-back {
  right: 0;
  top: 16rpx;
  transform: rotate(5deg);
  background: #e8d5b4;
}

.page-mid {
  right: 22rpx;
  top: 8rpx;
  background: #f3e8d4;
}

.page-front {
  right: 44rpx;
  top: 0;
  padding: 44rpx 18rpx 0;
  box-sizing: border-box;
}

.catalogue-rule {
  height: 3rpx;
  margin-top: 14rpx;
  background: rgba(43, 33, 27, 0.2);
}

.catalogue-rule.short {
  width: 58rpx;
  background: var(--lib-accent-brass);
}

.catalogue-kicker {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--lib-rule);
  color: var(--lib-panel-ink);
  font-size: 22rpx;
  line-height: 1;
  font-weight: 600;
}

.catalogue-title {
  max-width: 390rpx;
  margin-top: 26rpx;
  color: var(--lib-text-primary);
  font-family: "Songti SC", STSong, serif;
  font-size: 52rpx;
  line-height: 1.16;
  font-weight: 600;
}

.catalogue-page-tag {
  position: absolute;
  right: 42rpx;
  bottom: 0;
  padding: 8rpx 14rpx;
  background: var(--lib-accent-brass);
  color: #faf5ea;
  font-size: 18rpx;
  line-height: 1;
  letter-spacing: 0;
}

.library-index-panel {
  margin-top: 28rpx;
  padding: 30rpx 24rpx 28rpx;
  border-radius: 2rpx 8rpx 8rpx 2rpx;
  background: rgba(250, 245, 234, 0.94);
  border: 1rpx solid rgba(184, 149, 98, 0.34);
  box-shadow: 0 8rpx 24rpx rgba(43, 33, 27, 0.12);
}

.library-index-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 0 6rpx 22rpx;
  border-bottom: 1rpx solid rgba(184, 149, 98, 0.28);
}

.library-index-label {
  color: var(--lib-text-primary);
  font-family: "Songti SC", STSong, serif;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 600;
}

.library-breadcrumb {
  margin-top: 10rpx;
  color: var(--lib-text-secondary);
  font-size: 22rpx;
  line-height: 1.4;
}

.library-index-count,
.library-index-back {
  flex-shrink: 0;
  color: var(--lib-accent-brass);
  font-size: 23rpx;
  line-height: 1.35;
  font-weight: 600;
}

.library-skeleton,
.library-root-ledger,
.library-drawer-list,
.library-paper-index {
  margin-top: 24rpx;
}

.library-skeleton {
  padding: 26rpx 22rpx;
  background: #f3e8d4;
  border-left: 6rpx solid var(--lib-accent-brass);
}

.skeleton-title {
  color: var(--lib-text-secondary);
  font-size: 24rpx;
  line-height: 1.4;
}

.skeleton-slip {
  height: 30rpx;
  margin-top: 22rpx;
  background: linear-gradient(90deg, rgba(184, 149, 98, 0.18), rgba(184, 149, 98, 0.06));
}

.skeleton-slip.short {
  width: 62%;
}

.library-root-ledger,
.library-drawer-list,
.library-paper-index {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.library-ledger-row,
.library-drawer-row,
.library-paper-row {
  position: relative;
  min-height: 126rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 18rpx;
  background: #f8efdF;
  border: 1rpx solid rgba(184, 149, 98, 0.28);
  box-shadow: 0 5rpx 14rpx rgba(43, 33, 27, 0.08);
  overflow: hidden;
}

.library-ledger-row {
  border-radius: 2rpx 8rpx 8rpx 2rpx;
  background:
    linear-gradient(90deg, rgba(20, 40, 58, 0.92) 0 18rpx, transparent 18rpx),
    #f8efdf;
  padding-left: 34rpx;
}

.ledger-tab,
.paper-row-number {
  flex-shrink: 0;
  width: 58rpx;
  color: var(--lib-accent-brass);
  font-family: "Songti SC", STSong, serif;
  font-size: 30rpx;
  line-height: 1;
  text-align: center;
}

.ledger-body,
.drawer-body,
.paper-row-main {
  flex: 1;
  min-width: 0;
}

.ledger-title,
.drawer-title,
.paper-row-title {
  color: var(--lib-text-primary);
  font-size: 31rpx;
  line-height: 1.32;
  font-weight: 600;
}

.ledger-meta,
.drawer-meta,
.paper-row-meta {
  margin-top: 8rpx;
  color: var(--lib-text-secondary);
  font-size: 23rpx;
  line-height: 1.4;
}

.ledger-corner,
.paper-row-tag {
  flex-shrink: 0;
  padding: 8rpx 12rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.46);
  color: var(--lib-accent-brass);
  font-size: 21rpx;
  line-height: 1;
  font-weight: 600;
}

.library-drawer-row {
  border-radius: 2rpx 6rpx 6rpx 2rpx;
  padding-left: 0;
  background:
    linear-gradient(180deg, rgba(184, 149, 98, 0.1), rgba(184, 149, 98, 0)),
    #faf5ea;
}

.drawer-rail {
  align-self: stretch;
  width: 18rpx;
  background: var(--lib-panel-ink);
  box-shadow: inset -1rpx 0 0 rgba(184, 149, 98, 0.54);
}

.drawer-arrow {
  flex-shrink: 0;
  color: var(--lib-accent-brass);
  font-size: 38rpx;
  line-height: 1;
}

.library-paper-row {
  border-radius: 2rpx 8rpx 8rpx 2rpx;
  background: #faf5ea;
}

.library-paper-row::before {
  content: "";
  position: absolute;
  left: 86rpx;
  top: 18rpx;
  bottom: 18rpx;
  width: 1rpx;
  background: rgba(184, 149, 98, 0.26);
}

.paper-row-tag.is-done {
  border-color: rgba(127, 140, 120, 0.56);
  color: var(--lib-accent-moss);
}

.library-empty-catalogue {
  margin-top: 24rpx;
  padding: 50rpx 24rpx;
  background: #f3e8d4;
  border: 1rpx solid rgba(184, 149, 98, 0.3);
  color: var(--lib-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}

.empty-book-mark {
  width: 72rpx;
  height: 92rpx;
  margin: 0 auto 22rpx;
  border: 1rpx solid var(--lib-rule);
  border-left: 10rpx solid var(--lib-panel-ink);
  background: #faf5ea;
}

.library-empty-catalogue button {
  width: 168rpx;
  height: 64rpx;
  margin-top: 20rpx;
  border-radius: 6rpx;
  background: var(--lib-panel-ink);
  color: #faf5ea;
  font-size: 24rpx;
  line-height: 64rpx;
}

.library-empty-catalogue button::after {
  border: 0;
}
.language-en button,
.language-en view,
.language-en text { overflow-wrap: normal; word-break: normal; }
.language-en .catalogue-title,
.language-en .reading-title { font-size: 42rpx; line-height: 1.15; }

/* Grand Voyage: reading directory as a treasure-chart archive. */
.theme-voyage.reading-page {
  --voyage-ink: #173a50;
  --voyage-muted: #6f5b40;
  --voyage-brass: #b27a31;
  --voyage-red: #a83b31;
  min-height: 100vh;
  padding: 62rpx 28rpx 150rpx;
  background:
    radial-gradient(circle at 8% 16%, rgba(255,255,255,.72) 0 42rpx, transparent 44rpx),
    linear-gradient(180deg, #69c7eb 0 250rpx, #1685b5 251rpx 326rpx, #ead5a8 327rpx, #f4e8ca 100%);
  color: var(--voyage-ink);
}

.theme-voyage .reading-atmosphere { display: none; }

.theme-voyage .reading-hero {
  min-height: 232rpx;
  padding: 38rpx 210rpx 34rpx 38rpx;
  border: 5rpx solid #875128;
  border-radius: 8rpx;
  background:
    linear-gradient(90deg, rgba(255,247,218,.96), rgba(242,220,174,.94)),
    #f4e2b7;
  box-shadow: 0 12rpx 0 #6a3d20, 0 24rpx 38rpx rgba(4,69,95,.24), inset 0 0 28rpx rgba(109,67,28,.16);
}

.theme-voyage .reading-hero::before {
  content: "N";
  position: absolute;
  right: 44rpx;
  top: 34rpx;
  width: 128rpx;
  height: 128rpx;
  border: 8rpx double var(--voyage-brass);
  border-radius: 50%;
  background: conic-gradient(from 45deg, #a83b31 0 12.5%, #f1d78d 0 25%, #1e668c 0 37.5%, #f1d78d 0 50%, #a83b31 0 62.5%, #f1d78d 0 75%, #1e668c 0 87.5%, #f1d78d 0);
  color: #63401f;
  font-size: 18rpx;
  line-height: 118rpx;
  text-align: center;
  box-shadow: inset 0 0 0 13rpx #f4e4b9;
}

.theme-voyage .reading-hero::after {
  right: 105rpx;
  top: 31rpx;
  width: 5rpx;
  height: 136rpx;
  border: 0;
  border-radius: 999rpx;
  background: #704824;
  transform: rotate(38deg);
  opacity: .84;
}

.theme-voyage .hero-pages { display: none; }
.theme-voyage .reading-eyebrow { color: var(--voyage-brass); font-weight: 800; letter-spacing: 2rpx; }
.theme-voyage .reading-title { color: var(--voyage-ink); font-family: "Songti SC", STSong, serif; font-size: 52rpx; font-weight: 800; }
.theme-voyage .reading-history-tabs {
  margin: 30rpx 0 0;
  padding: 5rpx;
  border: 3rpx solid #8f5c2d;
  border-radius: 6rpx;
  background: #d0a75f;
  box-shadow: 0 7rpx 0 #754322;
}

.theme-voyage .reading-history-tab {
  border-radius: 3rpx;
  color: #654321;
  font-weight: 700;
}

.theme-voyage .reading-history-tab.is-active { background: #183f57; color: #fff4d0; box-shadow: inset 0 0 0 2rpx #e1bd67; }

.theme-voyage .reading-card {
  position: relative;
  margin-top: 28rpx;
  padding: 30rpx 26rpx 34rpx;
  border: 4rpx solid #9a6532;
  border-radius: 7rpx;
  background:
    repeating-linear-gradient(12deg, rgba(100,67,31,.025) 0 2rpx, transparent 2rpx 18rpx),
    #f7e8c2;
  box-shadow: 0 18rpx 34rpx rgba(50,61,54,.18), inset 0 0 26rpx rgba(105,67,27,.12);
}

.theme-voyage .reading-card::before {
  content: "";
  position: absolute;
  inset: 14rpx;
  border: 2rpx dashed rgba(122,78,34,.25);
  pointer-events: none;
}

.theme-voyage .reading-card-top,
.theme-voyage .reading-breadcrumb { position: relative; z-index: 1; }
.theme-voyage .reading-card-label { color: var(--voyage-ink); font-family: "Songti SC", STSong, serif; font-size: 34rpx; }
.theme-voyage .reading-card-state,
.theme-voyage .directory-back-icon { color: var(--voyage-red); font-weight: 700; }
.theme-voyage .reading-breadcrumb { color: #765534; }

.theme-voyage .paper-group-grid,
.theme-voyage .district-drawer-list,
.theme-voyage .reading-sheet-list { position: relative; z-index: 1; gap: 16rpx; }

.theme-voyage .directory-row {
  border: 3rpx solid #a36f38;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #f1d9a8, #fff1c9 20%, #f3dfb4);
  box-shadow: 0 6rpx 0 #7e4c27;
}

.theme-voyage .paper-group-panel::before { background: var(--voyage-red); }
.theme-voyage .directory-mark { border-color: #b9843d; background: #1f688b; color: #fff2cb; }
.theme-voyage .directory-title,
.theme-voyage .task-title { color: #2c332e; font-family: "Songti SC", STSong, serif; font-weight: 800; }
.theme-voyage .directory-meta,
.theme-voyage .task-meta { color: #78654a; }
.theme-voyage .directory-arrow { color: var(--voyage-brass); font-weight: 800; }
.theme-voyage .task-state { border: 2rpx solid #9a6632; border-radius: 4rpx; background: #f3d78f; color: #6b421f; }
.theme-voyage .task-state.is-done { background: #397867; color: #fff4d5; }

.theme-voyage .empty-state {
  border: 3rpx dashed #a36f38;
  border-radius: 7rpx;
  background: #f6e4bb;
  color: #775838;
}
