.material-page {
  padding-bottom: 48rpx;
}

.material-hero {
  margin-top: 70rpx;
  padding: 30rpx 32rpx;
}

.material-title {
  margin: 8rpx 0;
}

.plan-card {
  margin-top: 22rpx;
  padding: 26rpx 28rpx;
}

.plan-row {
  display: grid;
  grid-template-columns: 190rpx 1fr;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.plan-head {
  min-width: 0;
}

.plan-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
}

.plan-label {
  color: var(--text-muted);
}

.plan-value {
  min-width: 48rpx;
  color: var(--text-main);
  text-align: center;
  font-size: 32rpx;
  font-weight: var(--font-title-weight);
}

.stepper {
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: 48rpx 60rpx 48rpx;
  align-items: center;
  gap: 8rpx;
}

.stepper.is-compact {
  grid-template-columns: 44rpx 54rpx 44rpx;
}

.step-control {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.stepper.is-compact .step-control {
  width: 44rpx;
  height: 44rpx;
}

.plan-actions {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--radius-lg);
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.action-controls {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.action-title {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.action-copy {
  margin-top: 4rpx;
}

.action-duration {
  margin-top: 4rpx;
  color: var(--accent-deep);
}

.save-action {
  min-width: 148rpx;
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.cancel-action {
  min-width: 128rpx;
  min-height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 254, 252, 0.7);
  color: var(--accent-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.save-action.is-saving {
  opacity: 0.72;
}

.cancel-action.is-saving {
  opacity: 0.72;
}

.debug-card {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-lg);
  background: rgba(47, 43, 39, 0.08);
}

.debug-title {
  color: var(--text-main);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.debug-line {
  display: block;
  margin-top: 10rpx;
  color: #5f5851;
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.task-list {
  margin-top: 22rpx;
}

.task-row {
  min-height: 112rpx;
  margin-bottom: 14rpx;
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.task-no {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-title {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.task-subtitle {
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.task-duration {
  flex-shrink: 0;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  font-weight: var(--font-section-weight);
  white-space: nowrap;
}

.task-state {
  color: var(--accent-deep);
  font-size: 34rpx;
  font-weight: var(--font-title-weight);
}
