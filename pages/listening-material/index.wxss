.material-page {
  padding-bottom: 48rpx;
}

.material-hero {
  margin-top: 70rpx;
  padding: 30rpx 32rpx;
}

.material-title {
  margin: 8rpx 0;
}

.plan-card {
  margin-top: 22rpx;
  padding: 26rpx 28rpx;
}

.plan-row {
  display: grid;
  grid-template-columns: 150rpx 1fr;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.plan-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
}

.plan-label {
  color: var(--text-muted);
}

.plan-value {
  margin-top: 4rpx;
  color: var(--text-main);
  font-size: 34rpx;
  font-weight: var(--font-title-weight);
}

.save-button {
  margin-top: 24rpx;
  height: 82rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: var(--text-inverse);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.task-list {
  margin-top: 22rpx;
}

.task-row {
  min-height: 112rpx;
  margin-bottom: 14rpx;
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.task-no {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-title {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.task-subtitle {
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.task-state {
  color: var(--accent-deep);
  font-size: 34rpx;
  font-weight: var(--font-title-weight);
}
