.material-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background:
    radial-gradient(circle at 78% 8%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0) 30%),
    linear-gradient(160deg, #f8fbfd 0%, #edf6fa 48%, #f7fbfd 100%);
}

.material-hero {
  position: relative;
  overflow: hidden;
  margin-top: 70rpx;
  padding: 38rpx 34rpx;
  border-radius: 38rpx;
  background:
    linear-gradient(140deg, rgba(255, 255, 255, 0.86), rgba(221, 238, 248, 0.64)),
    rgba(236, 247, 251, 0.84);
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  box-shadow: 0 20rpx 52rpx rgba(78, 112, 139, 0.13);
}

.material-wave-mark {
  position: absolute;
  right: 30rpx;
  top: 34rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  opacity: 0.3;
}

.material-wave-mark text {
  width: 6rpx;
  border-radius: 999rpx;
  background: #8db7d4;
}

.material-wave-mark text:nth-child(1),
.material-wave-mark text:nth-child(5) { height: 22rpx; }
.material-wave-mark text:nth-child(2),
.material-wave-mark text:nth-child(4) { height: 40rpx; }
.material-wave-mark text:nth-child(3) { height: 58rpx; }

.material-title {
  margin: 8rpx 0;
}

.plan-card {
  margin-top: 22rpx;
  padding: 26rpx 28rpx;
  border-radius: 34rpx;
  background: rgba(246, 251, 253, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 42rpx rgba(78, 112, 139, 0.1);
}

.plan-row {
  display: grid;
  grid-template-columns: 190rpx 1fr;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.plan-head {
  min-width: 0;
}

.plan-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
}

.plan-label {
  color: #607087;
}

.plan-value {
  min-width: 48rpx;
  color: #17314f;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

.stepper {
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: 48rpx 60rpx 48rpx;
  align-items: center;
  gap: 8rpx;
}

.stepper.is-compact {
  grid-template-columns: 44rpx 54rpx 44rpx;
}

.step-control {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(221, 238, 248, 0.78);
  color: #17314f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-control-size);
  font-weight: 600;
}

.stepper.is-compact .step-control {
  width: 44rpx;
  height: 44rpx;
}

.plan-actions {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 28rpx;
  background: rgba(221, 238, 248, 0.58);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.action-controls {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.action-title {
  color: #17314f;
  font-size: var(--font-control-size);
  font-weight: 600;
}

.action-copy {
  margin-top: 4rpx;
}

.action-duration {
  margin-top: 4rpx;
  color: #607087;
}

.save-action {
  min-width: 148rpx;
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f2a18e 0%, #df8068 100%);
  color: #fffafa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.cancel-action {
  min-width: 128rpx;
  min-height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(246, 251, 253, 0.72);
  color: #607087;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.save-action.is-saving {
  opacity: 0.72;
}

.cancel-action.is-saving {
  opacity: 0.72;
}

.debug-card {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(221, 238, 248, 0.38);
}

.debug-title {
  color: #17314f;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.debug-line {
  display: block;
  margin-top: 10rpx;
  color: #607087;
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.task-list {
  margin-top: 22rpx;
}

.task-row {
  position: relative;
  min-height: 112rpx;
  margin-bottom: 14rpx;
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-radius: 30rpx;
  background: rgba(246, 251, 253, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 32rpx rgba(78, 112, 139, 0.08);
}

.task-wavelet {
  flex-shrink: 0;
  width: 38rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.task-wavelet text {
  width: 4rpx;
  border-radius: 999rpx;
  background: #8db7d4;
}

.task-wavelet text:nth-child(1) { height: 12rpx; }
.task-wavelet text:nth-child(2) { height: 25rpx; }
.task-wavelet text:nth-child(3) { height: 17rpx; }

.task-no {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(221, 238, 248, 0.78);
  color: #17314f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-title {
  color: #17314f;
  font-size: var(--font-control-size);
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.task-subtitle {
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.task-duration {
  flex-shrink: 0;
  color: #607087;
  font-size: var(--font-caption-size);
  font-weight: var(--font-section-weight);
  white-space: nowrap;
}

.task-state {
  color: #df8068;
  font-size: 34rpx;
  font-weight: 600;
}
