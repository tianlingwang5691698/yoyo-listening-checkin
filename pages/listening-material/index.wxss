.material-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background:
    radial-gradient(circle at 78% 8%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0) 30%),
    linear-gradient(160deg, #f8fbfd 0%, #edf6fa 48%, #f7fbfd 100%);
}

.material-hero {
  position: relative;
  overflow: hidden;
  margin-top: 70rpx;
  padding: 38rpx 34rpx;
  border-radius: 38rpx;
  background:
    linear-gradient(140deg, rgba(255, 255, 255, 0.86), rgba(221, 238, 248, 0.64)),
    rgba(236, 247, 251, 0.84);
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  box-shadow: 0 20rpx 52rpx rgba(78, 112, 139, 0.13);
}

.material-wave-mark {
  position: absolute;
  right: 30rpx;
  top: 34rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  opacity: 0.3;
}

.material-wave-mark text {
  width: 6rpx;
  border-radius: 999rpx;
  background: #8db7d4;
}

.material-wave-mark text:nth-child(1),
.material-wave-mark text:nth-child(5) { height: 22rpx; }
.material-wave-mark text:nth-child(2),
.material-wave-mark text:nth-child(4) { height: 40rpx; }
.material-wave-mark text:nth-child(3) { height: 58rpx; }

.material-title {
  margin: 8rpx 0;
}

.plan-card {
  margin-top: 22rpx;
  padding: 26rpx 28rpx;
  border-radius: 34rpx;
  background: rgba(246, 251, 253, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 42rpx rgba(78, 112, 139, 0.1);
}

.plan-row {
  display: grid;
  grid-template-columns: 190rpx 1fr;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.plan-head {
  min-width: 0;
}

.plan-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
}

.plan-label {
  color: #607087;
}

.plan-value {
  min-width: 48rpx;
  color: #17314f;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

.stepper {
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: 48rpx 60rpx 48rpx;
  align-items: center;
  gap: 8rpx;
}

.stepper.is-compact {
  grid-template-columns: 44rpx 54rpx 44rpx;
}

.step-control {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(221, 238, 248, 0.78);
  color: #17314f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-control-size);
  font-weight: 600;
}

.stepper.is-compact .step-control {
  width: 44rpx;
  height: 44rpx;
}

.plan-actions {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 28rpx;
  background: rgba(221, 238, 248, 0.58);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.action-controls {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.action-title {
  color: #17314f;
  font-size: var(--font-control-size);
  font-weight: 600;
}

.action-copy {
  margin-top: 4rpx;
}

.action-duration {
  margin-top: 4rpx;
  color: #607087;
}

.save-action {
  min-width: 148rpx;
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f2a18e 0%, #df8068 100%);
  color: #fffafa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.cancel-action {
  min-width: 128rpx;
  min-height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(246, 251, 253, 0.72);
  color: #607087;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.save-action.is-saving {
  opacity: 0.72;
}

.cancel-action.is-saving {
  opacity: 0.72;
}

.debug-card {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(221, 238, 248, 0.38);
}

.debug-title {
  color: #17314f;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.debug-line {
  display: block;
  margin-top: 10rpx;
  color: #607087;
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.task-list {
  margin-top: 22rpx;
}

.task-row {
  position: relative;
  min-height: 112rpx;
  margin-bottom: 14rpx;
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-radius: 30rpx;
  background: rgba(246, 251, 253, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 32rpx rgba(78, 112, 139, 0.08);
}

.task-wavelet {
  flex-shrink: 0;
  width: 38rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.task-wavelet text {
  width: 4rpx;
  border-radius: 999rpx;
  background: #8db7d4;
}

.task-wavelet text:nth-child(1) { height: 12rpx; }
.task-wavelet text:nth-child(2) { height: 25rpx; }
.task-wavelet text:nth-child(3) { height: 17rpx; }

.task-no {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(221, 238, 248, 0.78);
  color: #17314f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-title {
  color: #17314f;
  font-size: var(--font-control-size);
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.task-subtitle {
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.task-duration {
  flex-shrink: 0;
  color: #607087;
  font-size: var(--font-caption-size);
  font-weight: var(--font-section-weight);
  white-space: nowrap;
}

.task-state {
  color: #df8068;
  font-size: 34rpx;
  font-weight: 600;
}

.library-material-setting-page {
  min-height: 100vh;
  padding-top: 70rpx;
  padding-bottom: 56rpx;
  background:
    linear-gradient(180deg, rgba(43, 33, 27, 0.09), rgba(43, 33, 27, 0) 170rpx),
    #faf5ea;
}

.library-volume-head {
  position: relative;
  padding: 34rpx 30rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.42);
  border-radius: 8px;
  background:
    linear-gradient(90deg, rgba(20, 40, 58, 0.08) 0, rgba(20, 40, 58, 0) 28rpx),
    #f3e8d4;
  box-shadow: 0 6rpx 18rpx rgba(43, 33, 27, 0.12);
}

.library-volume-head::after {
  content: "";
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  width: 58rpx;
  height: 92rpx;
  border-radius: 0 0 6px 6px;
  background: #14283a;
  box-shadow: inset 0 -8rpx 0 #b89562;
}

.library-eyebrow,
.library-muted,
.library-form-label,
.library-duration,
.library-debug-line,
.library-empty-slip {
  color: #6f675f;
  font-size: var(--font-caption-size);
  line-height: 1.45;
}

.library-volume-title {
  margin: 8rpx 88rpx 8rpx 0;
  color: #14283a;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.16;
  word-break: break-word;
}

.library-form-paper,
.library-record-list,
.library-debug-note {
  margin-top: 22rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.38);
  border-radius: 8px;
  background:
    repeating-linear-gradient(180deg, transparent 0, transparent 58rpx, rgba(184, 149, 98, 0.12) 59rpx, transparent 60rpx),
    #f3e8d4;
  box-shadow: 0 6rpx 18rpx rgba(43, 33, 27, 0.1);
}

.library-range-title,
.library-section-title,
.library-row-title {
  color: #14283a;
  font-size: var(--font-control-size);
  font-weight: 600;
  line-height: 1.3;
}

.library-range-summary {
  margin-top: 8rpx;
  color: #b89562;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.1;
}

.library-range-row {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(184, 149, 98, 0.24);
  display: grid;
  grid-template-columns: 132rpx 168rpx minmax(0, 1fr);
  align-items: center;
  gap: 14rpx;
}

.library-rhythm-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.library-rhythm-cell {
  min-width: 0;
  padding: 18rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.26);
  border-radius: 6px;
  background: rgba(250, 245, 234, 0.58);
}

.library-stepper {
  display: grid;
  grid-template-columns: 44rpx 54rpx 44rpx;
  align-items: center;
  gap: 8rpx;
}

.library-step,
.library-value {
  height: 44rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.54);
  border-radius: 4px;
  color: #14283a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.library-step {
  background: rgba(184, 149, 98, 0.14);
}

.library-value {
  background: #faf5ea;
}

.library-slider {
  margin: 0 -8rpx;
}

.library-signature {
  margin-top: 24rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.32);
  border-radius: 8px;
  background: rgba(250, 245, 234, 0.72);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.library-signature-actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.library-save,
.library-cancel {
  min-height: 58rpx;
  padding: 0 20rpx;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.library-save {
  border: 1rpx solid #b89562;
  background: #14283a;
  color: #faf5ea;
}

.library-cancel {
  border: 1rpx solid rgba(184, 149, 98, 0.38);
  background: #f3e8d4;
  color: #6f675f;
}

.library-save.is-saving,
.library-cancel.is-saving {
  opacity: 0.68;
}

.library-debug-note {
  border-left: 6rpx solid #9a5f55;
}

.library-debug-title {
  color: #14283a;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.library-debug-line {
  display: block;
  margin-top: 10rpx;
  word-break: break-all;
}

.library-record-row {
  min-height: 104rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(184, 149, 98, 0.24);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.library-record-row:last-child {
  border-bottom: none;
}

.library-record-no {
  flex: 0 0 54rpx;
  height: 54rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.62);
  border-radius: 50%;
  color: #b89562;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.library-row-main {
  min-width: 0;
  flex: 1;
}

.library-row-title {
  word-break: break-word;
}

.library-duration {
  flex-shrink: 0;
  white-space: nowrap;
}

.library-arrow {
  color: #b89562;
  font-size: 36rpx;
  line-height: 1;
}

.library-empty-slip {
  padding-top: 20rpx;
}
