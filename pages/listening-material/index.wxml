<view class="theme-{{theme}} page-shell voyage-material-page language-{{language}}" wx:if="{{theme === 'voyage' || theme === 'dragon'}}">
  <view class="voyage-material-head">
    <view class="voyage-material-level">{{levelId}}</view>
    <view class="voyage-material-title">{{categoryLabel}}</view>
    <view class="voyage-material-count" wx:if="{{totalCount}}">{{totalCountText}}</view>
    <view class="voyage-material-count" wx:else>{{texts.organizing}}</view>
    <view class="voyage-material-seal"><view></view></view>
  </view>

  <view class="voyage-instrument-panel">
    <view class="voyage-range-heading"><view>{{texts.rangeRuler}}</view><text>{{startNo}} - {{endNo}}</text></view>
    <view class="voyage-control-row">
      <view class="voyage-control-head"><view>{{texts.startNo}}</view><view class="voyage-stepper"><text data-field="startNo" data-delta="-1" bindtap="stepValue">−</text><view>{{startNo}}</view><text data-field="startNo" data-delta="1" bindtap="stepValue">+</text></view></view>
      <slider min="1" max="{{sliderMax}}" value="{{startNo}}" activeColor="{{themeSlider.activeColor}}" backgroundColor="{{themeSlider.backgroundColor}}" block-color="{{themeSlider.blockColor}}" block-size="18" bindchange="changeStart" />
    </view>
    <view class="voyage-control-row">
      <view class="voyage-control-head"><view>{{texts.endNo}}</view><view class="voyage-stepper"><text data-field="endNo" data-delta="-1" bindtap="stepValue">−</text><view>{{endNo}}</view><text data-field="endNo" data-delta="1" bindtap="stepValue">+</text></view></view>
      <slider min="1" max="{{sliderMax}}" value="{{endNo}}" activeColor="{{themeSlider.activeColor}}" backgroundColor="{{themeSlider.backgroundColor}}" block-color="{{themeSlider.blockColor}}" block-size="18" bindchange="changeEnd" />
    </view>
    <view class="voyage-rhythm-grid">
      <view class="voyage-control-row"><view class="voyage-control-head"><view>{{texts.dailyCount}}</view><view class="voyage-stepper"><text data-field="dailyCount" data-delta="-1" bindtap="stepValue">−</text><view>{{dailyCount}}</view><text data-field="dailyCount" data-delta="1" bindtap="stepValue">+</text></view></view><slider min="1" max="10" value="{{dailyCount}}" activeColor="{{themeSlider.activeColor}}" backgroundColor="{{themeSlider.backgroundColor}}" block-color="{{themeSlider.blockColor}}" block-size="18" bindchange="changeDailyCount" /></view>
      <view class="voyage-control-row"><view class="voyage-control-head"><view>{{texts.repeatCount}}</view><view class="voyage-stepper"><text data-field="repeatTarget" data-delta="-1" bindtap="stepValue">−</text><view>{{repeatTarget}}</view><text data-field="repeatTarget" data-delta="1" bindtap="stepValue">+</text></view></view><slider min="1" max="5" value="{{repeatTarget}}" activeColor="{{themeSlider.activeColor}}" backgroundColor="{{themeSlider.backgroundColor}}" block-color="{{themeSlider.blockColor}}" block-size="18" bindchange="changeRepeatTarget" /></view>
    </view>
    <view class="voyage-plan-signature">
      <view><view>{{texts.planRange}}</view><text>{{startNo}} - {{endNo}} · {{dailyCountText}}</text><text>{{planDurationText}}</text></view>
      <view class="voyage-signature-actions" wx:if="{{totalCount}}"><view wx:if="{{isSelected}}" class="voyage-cancel {{saving ? 'is-saving' : ''}}" bindtap="cancelPlan">{{texts.cancelPlan}}</view><view class="voyage-save {{saving ? 'is-saving' : ''}}" bindtap="savePlan">{{saving ? texts.saving : (isSelected ? texts.saveChanges : texts.savePlan)}}</view></view>
    </view>
  </view>

  <view class="voyage-debug-note" wx:if="{{debugLines.length}}"><view>{{texts.debugTitle}}</view><text wx:for="{{debugLines}}" wx:key="*this" selectable="true">{{item}}</text></view>

  <view class="voyage-episode-manifest">
    <view class="voyage-catalog-title">{{texts.catalog}}</view>
    <view class="voyage-episode-row" wx:for="{{tasks}}" wx:key="taskId" data-index="{{index}}" bindtap="openTask">
      <view class="voyage-episode-coordinate">{{item.itemNo}}</view>
      <view class="voyage-episode-main"><view>{{item.title}}</view><text>{{item.subtitle || item.durationText}}</text></view>
      <view class="voyage-episode-duration">{{item.exactDurationText}}</view><view class="voyage-episode-arrow">›</view>
    </view>
    <view class="voyage-material-empty" wx:if="{{!totalCount}}">{{texts.empty}}</view>
  </view>
</view>

<view class="theme-{{theme}} page-shell library-material-setting-page language-{{language}}" wx:elif="{{theme === 'library'}}">
  <view class="library-volume-head">
    <view class="library-eyebrow">{{levelId}}</view>
    <view class="library-volume-title">{{categoryLabel}}</view>
    <view class="library-muted" wx:if="{{totalCount}}">{{totalCountText}}</view>
    <view class="library-muted" wx:else>{{texts.organizing}}</view>
  </view>

  <view class="library-form-paper">
    <view class="library-range-title">{{texts.rangeRuler}}</view>
    <view class="library-range-summary">{{startNo}} - {{endNo}}</view>
    <view class="library-range-row">
      <view class="library-form-label">{{texts.startNo}}</view>
      <view class="library-stepper">
        <view class="library-step" data-field="startNo" data-delta="-1" bindtap="stepValue">−</view>
        <view class="library-value">{{startNo}}</view>
        <view class="library-step" data-field="startNo" data-delta="1" bindtap="stepValue">+</view>
      </view>
      <slider class="library-slider" min="1" max="{{sliderMax}}" value="{{startNo}}" activeColor="#B89562" backgroundColor="rgba(184,149,98,.22)" block-color="#14283A" block-size="18" bindchange="changeStart" />
    </view>
    <view class="library-range-row">
      <view class="library-form-label">{{texts.endNo}}</view>
      <view class="library-stepper">
        <view class="library-step" data-field="endNo" data-delta="-1" bindtap="stepValue">−</view>
        <view class="library-value">{{endNo}}</view>
        <view class="library-step" data-field="endNo" data-delta="1" bindtap="stepValue">+</view>
      </view>
      <slider class="library-slider" min="1" max="{{sliderMax}}" value="{{endNo}}" activeColor="#B89562" backgroundColor="rgba(184,149,98,.22)" block-color="#14283A" block-size="18" bindchange="changeEnd" />
    </view>

    <view class="library-rhythm-grid">
      <view class="library-rhythm-cell">
        <view class="library-form-label">{{texts.dailyCount}}</view>
        <view class="library-stepper">
          <view class="library-step" data-field="dailyCount" data-delta="-1" bindtap="stepValue">−</view>
          <view class="library-value">{{dailyCount}}</view>
          <view class="library-step" data-field="dailyCount" data-delta="1" bindtap="stepValue">+</view>
        </view>
        <slider class="library-slider" min="1" max="10" value="{{dailyCount}}" activeColor="#B89562" backgroundColor="rgba(184,149,98,.22)" block-color="#14283A" block-size="18" bindchange="changeDailyCount" />
      </view>
      <view class="library-rhythm-cell">
        <view class="library-form-label">{{texts.repeatCount}}</view>
        <view class="library-stepper">
          <view class="library-step" data-field="repeatTarget" data-delta="-1" bindtap="stepValue">−</view>
          <view class="library-value">{{repeatTarget}}</view>
          <view class="library-step" data-field="repeatTarget" data-delta="1" bindtap="stepValue">+</view>
        </view>
        <slider class="library-slider" min="1" max="5" value="{{repeatTarget}}" activeColor="#B89562" backgroundColor="rgba(184,149,98,.22)" block-color="#14283A" block-size="18" bindchange="changeRepeatTarget" />
      </view>
    </view>

    <view class="library-signature">
      <view>
        <view class="library-row-title">{{texts.planRange}}</view>
        <view class="library-muted">{{startNo}} - {{endNo}} · {{dailyCountText}}</view>
        <view class="library-muted">{{planDurationText}}</view>
      </view>
      <view class="library-signature-actions" wx:if="{{totalCount}}">
        <view wx:if="{{isSelected}}" class="library-cancel {{saving ? 'is-saving' : ''}}" bindtap="cancelPlan">{{texts.cancelPlan}}</view>
        <view class="library-save {{saving ? 'is-saving' : ''}}" bindtap="savePlan">{{saving ? texts.saving : (isSelected ? texts.saveChanges : texts.savePlan)}}</view>
      </view>
    </view>
  </view>

  <view class="library-debug-note" wx:if="{{debugLines.length}}">
    <view class="library-debug-title">{{texts.debugTitle}}</view>
    <text class="library-debug-line" wx:for="{{debugLines}}" wx:key="*this" selectable="true">{{item}}</text>
  </view>

  <view class="library-record-list">
    <view class="library-section-title">{{texts.catalog}}</view>
    <view class="library-record-row" wx:for="{{tasks}}" wx:key="taskId" data-index="{{index}}" bindtap="openTask">
      <view class="library-record-no">{{item.itemNo}}</view>
      <view class="library-row-main">
        <view class="library-row-title">{{item.title}}</view>
        <view class="library-muted">{{item.subtitle || item.durationText}}</view>
      </view>
      <view class="library-duration">{{item.exactDurationText}}</view>
      <view class="library-arrow">›</view>
    </view>
    <view class="library-empty-slip" wx:if="{{!totalCount}}">{{texts.empty}}</view>
  </view>
</view>

<view class="theme-{{theme}} page-shell material-page language-{{language}}" wx:else>
  <view class="material-hero card">
    <view class="material-wave-mark"><text></text><text></text><text></text><text></text><text></text></view>
    <view class="type-caption">{{levelId}}</view>
    <view class="material-title type-page-title">{{categoryLabel}}</view>
    <view class="type-caption">{{totalCountText}}</view>
  </view>

  <view class="plan-card card">
    <view class="plan-row">
      <view class="plan-head">
        <view class="plan-label type-caption">{{texts.startNo}}</view>
        <view class="stepper">
          <view class="step-control" data-field="startNo" data-delta="-1" bindtap="stepValue">−</view>
          <view class="plan-value">{{startNo}}</view>
          <view class="step-control" data-field="startNo" data-delta="1" bindtap="stepValue">+</view>
        </view>
      </view>
      <slider min="1" max="{{sliderMax}}" value="{{startNo}}" activeColor="{{themeSlider.activeColor}}" backgroundColor="{{themeSlider.backgroundColor}}" block-color="{{themeSlider.blockColor}}" block-size="18" bindchange="changeStart" />
    </view>
    <view class="plan-row">
      <view class="plan-head">
        <view class="plan-label type-caption">{{texts.endNo}}</view>
        <view class="stepper">
          <view class="step-control" data-field="endNo" data-delta="-1" bindtap="stepValue">−</view>
          <view class="plan-value">{{endNo}}</view>
          <view class="step-control" data-field="endNo" data-delta="1" bindtap="stepValue">+</view>
        </view>
      </view>
      <slider min="1" max="{{sliderMax}}" value="{{endNo}}" activeColor="{{themeSlider.activeColor}}" backgroundColor="{{themeSlider.backgroundColor}}" block-color="{{themeSlider.blockColor}}" block-size="18" bindchange="changeEnd" />
    </view>
    <view class="plan-grid">
      <view>
        <view class="plan-label type-caption">{{texts.dailyCount}}</view>
        <view class="stepper is-compact">
          <view class="step-control" data-field="dailyCount" data-delta="-1" bindtap="stepValue">−</view>
          <view class="plan-value">{{dailyCount}}</view>
          <view class="step-control" data-field="dailyCount" data-delta="1" bindtap="stepValue">+</view>
        </view>
        <slider min="1" max="10" value="{{dailyCount}}" activeColor="{{themeSlider.activeColor}}" backgroundColor="{{themeSlider.backgroundColor}}" block-color="{{themeSlider.blockColor}}" block-size="18" bindchange="changeDailyCount" />
      </view>
      <view>
        <view class="plan-label type-caption">{{texts.repeatCount}}</view>
        <view class="stepper is-compact">
          <view class="step-control" data-field="repeatTarget" data-delta="-1" bindtap="stepValue">−</view>
          <view class="plan-value">{{repeatTarget}}</view>
          <view class="step-control" data-field="repeatTarget" data-delta="1" bindtap="stepValue">+</view>
        </view>
        <slider min="1" max="5" value="{{repeatTarget}}" activeColor="{{themeSlider.activeColor}}" backgroundColor="{{themeSlider.backgroundColor}}" block-color="{{themeSlider.blockColor}}" block-size="18" bindchange="changeRepeatTarget" />
      </view>
    </view>
    <view class="plan-actions">
      <view>
        <view class="action-title">{{texts.planRange}}</view>
        <view class="action-copy type-caption">{{startNo}} - {{endNo}} · {{dailyCountText}}</view>
        <view class="action-duration type-caption">{{planDurationText}}</view>
      </view>
      <view class="action-controls">
        <view wx:if="{{isSelected}}" class="cancel-action {{saving ? 'is-saving' : ''}}" bindtap="cancelPlan">{{texts.cancelPlan}}</view>
        <view class="save-action {{saving ? 'is-saving' : ''}}" bindtap="savePlan">{{saving ? texts.saving : (isSelected ? texts.saveChanges : texts.savePlan)}}</view>
      </view>
    </view>
  </view>

  <view class="debug-card" wx:if="{{debugLines.length}}">
    <view class="debug-title">{{texts.debugTitle}}</view>
    <block wx:for="{{debugLines}}" wx:key="*this">
      <text class="debug-line" selectable="true">{{item}}</text>
    </block>
  </view>

  <view class="task-list">
    <block wx:for="{{tasks}}" wx:key="taskId">
      <view class="task-row card" data-index="{{index}}" bindtap="openTask">
        <view class="task-no">{{item.itemNo}}</view>
        <view class="task-wavelet"><text></text><text></text><text></text></view>
        <view class="task-main">
          <view class="task-title">{{item.title}}</view>
          <view class="task-subtitle type-caption">{{item.subtitle || item.durationText}}</view>
        </view>
        <view class="task-duration">{{item.exactDurationText}}</view>
        <view class="task-state">›</view>
      </view>
    </block>
  </view>
</view>
