  border-radius: 8rpx;
  background: linear-gradient(90deg, rgba(184, 149, 98, 0.14), rgba(255, 253, 247, 0.72), rgba(184, 149, 98, 0.14));
  animation: libraryPaperPulse 1.2s ease-in-out infinite;
}

.library-skeleton-row.is-short {
  width: 72%;
}

.library-empty-note {
  color: var(--library-grammar-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.library-empty-proof,
.library-complete-proof {
  position: relative;
  z-index: 1;
  min-height: 260rpx;
  margin-top: 28rpx;
  padding: 46rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed var(--library-grammar-rule);
  border-radius: var(--library-grammar-radius);
  background: rgba(255, 253, 247, 0.55);
  text-align: center;
}

.library-empty-stamp {
  width: 96rpx;
  height: 96rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  color: var(--library-grammar-moss);
  font-size: 26rpx;
  line-height: 92rpx;
  font-weight: 700;
  transform: rotate(-8deg);
}

.library-empty-title {
  margin-top: 20rpx;
  color: var(--library-grammar-ink);
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 600;
}

.library-empty-action {
  margin-top: 18rpx;
  padding-bottom: 6rpx;
  border-bottom: 2rpx solid var(--library-grammar-brass);
  color: var(--library-grammar-brass);
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 600;
}

.library-practice-page {
  padding: 24rpx 18rpx 30rpx;
}

.library-practice-title-wrap {
  flex: 1;
  min-width: 0;
}

.library-resume-note {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  padding-left: 18rpx;
  border-left: 4rpx solid var(--library-grammar-brass);
  color: var(--library-grammar-muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.library-proof-sheet {
  position: relative;
  margin-top: 22rpx;
  padding: 8rpx 16rpx 10rpx 28rpx;
  border: 1rpx solid var(--library-grammar-rule);
  border-radius: var(--library-grammar-radius);
  background:
    linear-gradient(180deg, transparent 67rpx, rgba(184, 149, 98, 0.12) 68rpx),
    var(--library-grammar-paper-light);
  background-size: 100% 68rpx, 100% 100%;
}

.library-question-row {
  position: relative;
  z-index: 1;
  padding: 28rpx 0 30rpx;
  border-bottom: 1rpx solid rgba(184, 149, 98, 0.28);
}

.library-question-row:last-child {
  border-bottom: 0;
}

.library-question-meta {
  color: var(--library-grammar-muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.library-question-prompt {
  margin-top: 18rpx;
  color: var(--library-grammar-ink);
  font-size: 32rpx;
  line-height: 1.7;
  font-weight: 500;
  word-break: break-word;
}

.library-token-line {
  word-break: normal;
  overflow-wrap: break-word;
}

.library-options {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.library-option {
  min-height: 104rpx;
  padding: 16rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.4);
  border-radius: 8rpx;
  background: rgba(255, 253, 247, 0.92);
  color: var(--library-grammar-ink);
  font-size: 26rpx;
  line-height: 1.55;
}

.library-option-key {
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  border-radius: 6rpx;
  background: var(--library-grammar-brass);
  color: #FFFDF7;
  font-size: 24rpx;
  line-height: 42rpx;
  text-align: center;
  font-weight: 700;
}

.library-option-text {
  flex: 1;
  min-width: 0;
  word-break: break-word;
}

.library-option.is-selected {
  border-color: rgba(154, 95, 84, 0.56);
}

.library-option.is-selected .library-option-text {
  color: var(--library-grammar-error);
  text-decoration: none;
}

.library-option.is-correct {
  border-color: rgba(65, 111, 57, 0.88);
  background: rgba(104, 148, 92, 0.34);
}

.library-option.is-correct .library-option-text {
  color: #2f5d2b;
  text-decoration: none;
}

.library-option.is-wrong {
  border-color: rgba(151, 53, 43, 0.84);
  background: rgba(181, 75, 60, 0.3);
}

.library-option.is-wrong .library-option-text {
  color: #873229;
  text-decoration: none;
}

.library-answer-line {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  border-radius: 8rpx;
  background: transparent;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 600;
}

.library-answer-line.is-correct {
  color: #4F6548;
}

.library-answer-line.is-wrong {
  color: var(--library-grammar-error);
}

.library-answer-line .answer-result,
.library-answer-line .standard-answer {
  padding: 12rpx 16rpx;
  border-radius: 6rpx;
}

.library-answer-line.is-correct .answer-result,
.library-answer-line .standard-answer {
  background: rgba(104, 148, 92, 0.34);
  color: #2f5d2b;
}

.library-answer-line.is-wrong .answer-result {
  background: rgba(181, 75, 60, 0.3);
  color: #873229;
}

.library-explain-actions {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.library-explain-action {
  padding: 14rpx 20rpx;
  border-radius: 8rpx;
  background: var(--library-grammar-brass);
  color: #FFFDF7;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 600;
}

.library-explain-action.is-secondary {
  padding-left: 0;
  padding-right: 0;
  background: transparent;
  color: var(--library-grammar-brass);
}

.library-analysis-loading {
  margin-top: 18rpx;
  padding: 20rpx;
  display: flex;
  gap: 12rpx;
  border-left: 5rpx solid var(--library-grammar-brass);
  background: rgba(243, 232, 212, 0.62);
}

.library-analysis-loading view {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--library-grammar-brass);
  animation: libraryDotPulse 0.9s ease-in-out infinite;
}

.library-analysis-loading view:nth-child(2) {
  animation-delay: 0.14s;
}

.library-analysis-loading view:nth-child(3) {
  animation-delay: 0.28s;
}

.library-explain-error {
  margin-top: 14rpx;
  color: var(--library-grammar-error);
  font-size: 23rpx;
  line-height: 1.55;
}

.library-analysis {
  margin-top: 18rpx;
  padding: 20rpx 18rpx 20rpx 22rpx;
  border-left: 5rpx solid var(--library-grammar-brass);
  border-radius: 0 8rpx 8rpx 0;
  background: rgba(243, 232, 212, 0.72);
}

.library-analysis-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  color: var(--library-grammar-ink);
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 600;
}

.library-analysis-answer {
  flex-shrink: 0;
  color: var(--library-grammar-moss);
  font-size: 22rpx;
}

.library-analysis-text {
  margin-top: 14rpx;
  color: var(--library-grammar-muted);
  font-size: 26rpx;
  line-height: 1.72;
}

.library-lookup-token {
  color: var(--library-grammar-ink);
  border-bottom: 0;
  text-decoration: none;
}

.library-complete-proof {
  margin-top: 22rpx;
}

.library-complete-clip {
  position: absolute;
  top: -12rpx;
  width: 120rpx;
  height: 26rpx;
  border-radius: 6rpx;
  background: var(--library-grammar-brass);
}

.library-dictionary-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(43, 33, 27, 0.36);
}

.library-dictionary-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 41;
  padding: 28rpx;
  border: 1rpx solid var(--library-grammar-rule);
  border-radius: var(--library-grammar-radius);
  background:
    linear-gradient(90deg, rgba(184, 149, 98, 0.12) 1rpx, transparent 1rpx),
    var(--library-grammar-paper-light);
  background-size: 38rpx 100%, 100% 100%;
  box-shadow: 0 18rpx 44rpx rgba(43, 33, 27, 0.22);
}

.library-dictionary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.library-dictionary-word {
  color: var(--library-grammar-ink);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 600;
  word-break: break-word;
}

.library-dictionary-phonetic {
  margin-top: 6rpx;
  color: var(--library-grammar-muted);
  font-size: 25rpx;
  line-height: 1.35;
}

.library-dictionary-audio,
.library-dictionary-add {
  margin: 0;
  border-radius: 8rpx;
  font-weight: 600;
}

.library-dictionary-audio {
  flex-shrink: 0;
  width: 60rpx;
  min-width: 60rpx;
  height: 60rpx;
  padding: 0;
  background: var(--library-grammar-desk);
  color: #FFFDF7;
  font-size: 28rpx;
  line-height: 60rpx;
  text-align: center;
}

.library-dictionary-add {
  width: 100%;
  height: 68rpx;
  margin-top: 22rpx;
  background: var(--library-grammar-brass);
  color: #FFFDF7;
  font-size: 26rpx;
  line-height: 68rpx;
}

.library-dictionary-audio::after,
.library-dictionary-add::after {
  border: 0;
}

.library-dictionary-audio.is-loading {
  animation: dictionaryAudioPulse 0.72s ease-in-out infinite;
}

.library-dictionary-definition,
.library-dictionary-empty {
  margin-top: 16rpx;
  color: var(--library-grammar-muted);
  font-size: 28rpx;
  line-height: 1.55;
}

.library-dictionary-loading {
  margin-top: 18rpx;
}

.library-dictionary-loading view {
  height: 26rpx;
  margin-top: 12rpx;
  border-radius: 6rpx;
  background: rgba(184, 149, 98, 0.16);
  animation: libraryPaperPulse 1.2s ease-in-out infinite;
}

.library-dictionary-loading view:nth-child(2) {
  width: 70%;
}

@keyframes libraryPaperPulse {
  0% {
    opacity: 0.44;
  }
  50% {
    opacity: 0.92;
  }
  100% {
    opacity: 0.44;
  }
}

@keyframes libraryDotPulse {
  0% {
    opacity: 0.35;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-4rpx);
  }
  100% {
    opacity: 0.35;
    transform: translateY(0);
  }
}
.language-en button,
.language-en view,
.language-en text { overflow-wrap: normal; word-break: normal; }
.language-en .library-title,
.language-en .grammar-title { font-size: 42rpx; line-height: 1.15; }
