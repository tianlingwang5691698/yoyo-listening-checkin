.grammar-page {
  padding-top: 72rpx;
}

.grammar-hero,
.grammar-card {
  background: var(--surface-raised);
}

.grammar-hero {
  padding: 38rpx 34rpx;
}

.grammar-eyebrow,
.grammar-card-label,
.grammar-card-state {
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.grammar-title {
  margin-top: 12rpx;
  color: var(--text-strong);
  font-size: var(--font-page-title-size);
  line-height: var(--line-title);
  font-weight: var(--font-title-weight);
}

.grammar-copy {
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: var(--font-body-size);
  line-height: var(--line-body);
  max-width: 560rpx;
}

.grammar-actions {
  margin-top: 22rpx;
  display: flex;
  gap: 14rpx;
}

.grammar-action {
  padding: 13rpx 24rpx;
  border-radius: 999rpx;
  background: var(--surface-subtle);
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.grammar-action.is-active {
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.grammar-card {
  margin-top: 26rpx;
  padding: 32rpx 28rpx;
}

.grammar-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.directory-list,
.question-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.directory-row,
.question-row {
  padding: 24rpx;
  border: 1rpx solid var(--border-soft);
  border-radius: var(--radius-lg);
  background: linear-gradient(180deg, var(--surface), var(--surface-subtle));
}

.directory-row {
  min-height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.directory-title {
  color: var(--text-strong);
  font-size: var(--font-card-title-size);
  line-height: 1.25;
  font-weight: var(--font-title-weight);
}

.directory-meta,
.question-meta {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.35;
}

.directory-arrow {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: 38rpx;
  line-height: 1;
}

.directory-back-icon {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  line-height: 1.4;
  font-weight: var(--font-title-weight);
}

.question-prompt {
  margin-top: 10rpx;
  color: var(--text-strong);
  font-size: 32rpx;
  line-height: 1.55;
  font-weight: var(--font-title-weight);
}

.option-grid {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.option-item {
  padding: 16rpx 18rpx;
  border-radius: var(--radius-md);
  background: var(--surface);
  color: var(--text-main);
  font-size: 30rpx;
  line-height: 1.5;
}

.option-item.is-selected {
  border: 2rpx solid var(--accent);
}

.option-item.is-correct {
  background: rgba(63, 159, 107, 0.12);
  color: var(--success, #3f9f6b);
}

.option-item.is-wrong {
  background: rgba(211, 92, 80, 0.12);
  color: #b85a4d;
}

.grammar-explain-actions {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
}

.grammar-explain-action {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--surface-subtle);
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.grammar-explain-action.is-active {
  background: rgba(63, 159, 107, 0.12);
  color: var(--success, #3f9f6b);
}

.answer-line {
  margin-top: 14rpx;
  color: var(--success, #3f9f6b);
  font-size: var(--font-body-size);
  font-weight: var(--font-title-weight);
}

.token-line {
  word-break: normal;
  overflow-wrap: break-word;
}

.lookup-token {
  color: var(--accent-deep);
  border-bottom: 1rpx solid rgba(46, 95, 168, 0.28);
}

.dictionary-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(20, 24, 31, 0.24);
}

.dictionary-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 41;
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 60rpx rgba(28, 36, 52, 0.18);
}

.dictionary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.dictionary-word {
  color: var(--text-strong);
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: var(--font-section-heading-weight);
}

.dictionary-phonetic {
  margin-top: 6rpx;
  color: var(--text-muted);
  font-size: 26rpx;
}

.dictionary-audio,
.dictionary-add {
  margin: 0;
  border-radius: 999rpx;
  font-weight: var(--font-title-weight);
}

.dictionary-audio {
  flex-shrink: 0;
  min-width: 112rpx;
  height: 56rpx;
  padding: 0 20rpx;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 24rpx;
  line-height: 56rpx;
}

.dictionary-add {
  width: 100%;
  height: 64rpx;
  margin-top: 22rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 64rpx;
}

.dictionary-audio::after,
.dictionary-add::after {
  border: 0;
}

.dictionary-loading,
.dictionary-empty,
.dictionary-definition {
  margin-top: 16rpx;
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 1.55;
}

.dictionary-loading,
.dictionary-empty {
  color: var(--text-muted);
}
