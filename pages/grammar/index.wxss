.theme-library .classroom-footer-button { border-radius: 8rpx; }
.theme-library .classroom-footer-button.is-back { border-color: var(--library-grammar-rule); background: var(--library-grammar-paper-light); color: var(--library-grammar-muted); }
.theme-library .classroom-footer-button.is-next { border-color: var(--library-grammar-desk); background: var(--library-grammar-desk); color: #FFFDF7; }
.theme-library .classroom-footer-button.is-disabled { border-color: var(--library-grammar-rule); background: rgba(243, 232, 212, 0.7); color: var(--library-grammar-muted); }
.theme-library .classroom-option { border-color: var(--library-grammar-rule); border-radius: 8rpx; background: var(--library-grammar-paper-light); color: var(--library-grammar-ink); }
.theme-library .classroom-option.is-correct { border-color: #5f806c; background: #dce8dc; color: #294e39; }
.theme-library .classroom-option.is-wrong { border-color: var(--library-grammar-error); background: #ecd9d3; color: #713f37; }

.library-index-tab {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 14rpx 4rpx 16rpx;
  color: var(--library-grammar-muted);
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 600;
  text-align: center;
}

.library-index-tab.is-active {
  color: var(--library-grammar-ink);
}

.library-index-tab.is-active::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 4rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: var(--library-grammar-brass);
}

.library-directory-page,
.library-practice-page {
  position: relative;
  margin-top: 18rpx;
  padding: 30rpx 24rpx;
  border: 1rpx solid var(--library-grammar-rule);
  border-radius: var(--library-grammar-radius);
  background:
    linear-gradient(90deg, rgba(184, 149, 98, 0.12) 1rpx, transparent 1rpx),
    linear-gradient(180deg, var(--library-grammar-paper-light), var(--library-grammar-paper));
  background-size: 44rpx 100%, 100% 100%;
  box-shadow: var(--library-grammar-shadow);
}

.library-directory-page::before,
.library-proof-sheet::before {
  content: "";
  position: absolute;
  left: 18rpx;
  top: 24rpx;
  bottom: 24rpx;
  width: 4rpx;
  border-radius: 999rpx;
  background: repeating-linear-gradient(180deg, var(--library-grammar-brass) 0rpx, var(--library-grammar-brass) 16rpx, transparent 16rpx, transparent 30rpx);
  opacity: 0.58;
}

.library-page-head,
.library-practice-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.library-page-title {
  margin-top: 6rpx;
  color: var(--library-grammar-ink);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 600;
}

.library-page-count,
.library-practice-progress {
  flex-shrink: 0;
  padding: 6rpx 0 8rpx;
  border-bottom: 3rpx solid var(--library-grammar-brass);
  color: var(--library-grammar-muted);
  font-size: 23rpx;
  line-height: 1.2;
  font-weight: 600;
}

.library-directory-list,
.library-drawer-list {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
}

.library-directory-row,
.library-topic-row,
.library-drawer-row {
  position: relative;
  min-height: 108rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0 20rpx 20rpx;
  border-bottom: 1rpx solid var(--library-grammar-rule);
}

.library-directory-row:active,
.library-topic-row:active,
.library-drawer-row:active {
  transform: translateY(1rpx);
}

.library-row-code,
.library-topic-number {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.46);
  border-radius: 8rpx;
  background: rgba(255, 253, 247, 0.74);
  color: var(--library-grammar-brass);
  font-size: 20rpx;
  line-height: 56rpx;
  text-align: center;
  font-weight: 700;
}

.library-row-main {
  flex: 1;
  min-width: 0;
}

.library-row-title {
  color: var(--library-grammar-ink);
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 600;
  word-break: break-word;
}

.library-row-meta {
  margin-top: 6rpx;
  color: var(--library-grammar-muted);
  font-size: 22rpx;
  line-height: 1.4;
}

.library-row-arrow {
  flex-shrink: 0;
  width: 42rpx;
  color: var(--library-grammar-brass);
  font-size: 34rpx;
  line-height: 1;
  text-align: center;
}

.library-back-text {
  flex-shrink: 0;
  color: var(--library-grammar-brass);
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 600;
}

.library-topic-grid {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 22rpx;
}

.library-topic-row {
  min-width: 0;
  padding-left: 0;
}

.library-topic-number {
  width: 44rpx;
  height: 44rpx;
  font-size: 21rpx;
  line-height: 44rpx;
}

.library-drawer-page {
  background:
    linear-gradient(180deg, rgba(255, 253, 247, 0.96), rgba(243, 232, 212, 0.92)),
    var(--library-grammar-paper);
}

.library-drawer-row {
  min-height: 116rpx;
  margin-left: 10rpx;
  padding: 20rpx 0 20rpx 12rpx;
}

.library-drawer-notch {
  flex-shrink: 0;
  width: 18rpx;
  height: 62rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, var(--library-grammar-brass), rgba(184, 149, 98, 0.28));
}

.library-skeleton-list {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
}

.library-skeleton-row {
  height: 96rpx;
  margin-bottom: 18rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, rgba(184, 149, 98, 0.14), rgba(255, 253, 247, 0.72), rgba(184, 149, 98, 0.14));
  animation: libraryPaperPulse 1.2s ease-in-out infinite;
}

.library-skeleton-row.is-short {
  width: 72%;
}

.library-empty-note {
  color: var(--library-grammar-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.library-empty-proof,
.library-complete-proof {
  position: relative;
  z-index: 1;
  min-height: 260rpx;
  margin-top: 28rpx;
  padding: 46rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed var(--library-grammar-rule);
  border-radius: var(--library-grammar-radius);
  background: rgba(255, 253, 247, 0.55);
  text-align: center;
}

.library-empty-stamp {
  width: 96rpx;
  height: 96rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  color: var(--library-grammar-moss);
  font-size: 26rpx;
  line-height: 92rpx;
  font-weight: 700;
  transform: rotate(-8deg);
}

.library-empty-title {
  margin-top: 20rpx;
  color: var(--library-grammar-ink);
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 600;
}

.library-empty-action {
  margin-top: 18rpx;
  padding-bottom: 6rpx;
  border-bottom: 2rpx solid var(--library-grammar-brass);
  color: var(--library-grammar-brass);
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 600;
}

.library-practice-page {
  padding: 24rpx 18rpx 30rpx;
}

.library-practice-title-wrap {
  flex: 1;
  min-width: 0;
}

.library-resume-note {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  padding-left: 18rpx;
  border-left: 4rpx solid var(--library-grammar-brass);
  color: var(--library-grammar-muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.library-proof-sheet {
  position: relative;
  margin-top: 22rpx;
  padding: 8rpx 16rpx 10rpx 28rpx;
  border: 1rpx solid var(--library-grammar-rule);
  border-radius: var(--library-grammar-radius);
  background:
    linear-gradient(180deg, transparent 67rpx, rgba(184, 149, 98, 0.12) 68rpx),
    var(--library-grammar-paper-light);
  background-size: 100% 68rpx, 100% 100%;
}

.library-question-row {
  position: relative;
  z-index: 1;
  padding: 28rpx 0 30rpx;
  border-bottom: 1rpx solid rgba(184, 149, 98, 0.28);
}

.library-question-row:last-child {
  border-bottom: 0;
}

.library-question-meta {
  color: var(--library-grammar-muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.library-question-prompt {
  margin-top: 18rpx;
  color: var(--library-grammar-ink);
  font-size: 32rpx;
  line-height: 1.7;
  font-weight: 500;
  word-break: break-word;
}

.library-token-line {
  word-break: normal;
  overflow-wrap: break-word;
}

.library-options {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.library-option {
  min-height: 104rpx;
  padding: 16rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.4);
  border-radius: 8rpx;
  background: rgba(255, 253, 247, 0.92);
  color: var(--library-grammar-ink);
  font-size: 26rpx;
  line-height: 1.55;
}

.library-option-key {
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  border-radius: 6rpx;
  background: var(--library-grammar-brass);
  color: #FFFDF7;
  font-size: 24rpx;
  line-height: 42rpx;
  text-align: center;
  font-weight: 700;
}

.library-option-text {
  flex: 1;
  min-width: 0;
  word-break: break-word;
}

.library-option.is-selected {
  border-color: rgba(154, 95, 84, 0.56);
}

.library-option.is-selected .library-option-text {
  color: var(--library-grammar-error);
  text-decoration: none;
}

.library-option.is-correct {
  border-color: rgba(65, 111, 57, 0.88);
  background: rgba(104, 148, 92, 0.34);
}

.library-option.is-correct .library-option-text {
  color: #2f5d2b;
  text-decoration: none;
}

.library-option.is-wrong {
  border-color: rgba(151, 53, 43, 0.84);
  background: rgba(181, 75, 60, 0.3);
}

.library-option.is-wrong .library-option-text {
  color: #873229;
  text-decoration: none;
}

.library-answer-line {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  border-radius: 8rpx;
  background: transparent;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 600;
}

.library-answer-line.is-correct {
  color: #4F6548;
}

.library-answer-line.is-wrong {
  color: var(--library-grammar-error);
}

.library-answer-explain-toggle {
  flex: none;
  margin-left: auto;
  padding: 10rpx 14rpx;
  border: 1rpx solid rgba(131, 91, 39, 0.36);
  border-radius: 6rpx;
  background: var(--library-grammar-paper-light);
  color: var(--library-grammar-brass);
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 600;
}

.library-answer-explain-toggle.is-active {
  background: rgba(197, 168, 100, 0.24);
  color: var(--library-grammar-ink);
}

.library-answer-line .answer-result,
.library-answer-line .standard-answer {
  padding: 12rpx 16rpx;
  border-radius: 6rpx;
}

.library-answer-line.is-correct .answer-result,
.library-answer-line .standard-answer {
  background: rgba(104, 148, 92, 0.34);
  color: #2f5d2b;
}

.library-answer-line.is-wrong .answer-result {
  background: rgba(181, 75, 60, 0.3);
  color: #873229;
}

.library-explain-actions {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.library-explain-action {
  padding: 14rpx 20rpx;
  border-radius: 8rpx;
  background: var(--library-grammar-brass);
  color: #FFFDF7;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 600;
}

.library-explain-action.is-secondary {
  padding-left: 0;
  padding-right: 0;
  background: transparent;
  color: var(--library-grammar-brass);
}

.library-analysis-loading {
  margin-top: 18rpx;
  padding: 20rpx;
  display: flex;
  gap: 12rpx;
  border-left: 5rpx solid var(--library-grammar-brass);
  background: rgba(243, 232, 212, 0.62);
}

.library-analysis-loading view {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--library-grammar-brass);
  animation: libraryDotPulse 0.9s ease-in-out infinite;
}

.library-analysis-loading view:nth-child(2) {
  animation-delay: 0.14s;
}

.library-analysis-loading view:nth-child(3) {
  animation-delay: 0.28s;
}

.library-explain-error {
  margin-top: 14rpx;
  color: var(--library-grammar-error);
  font-size: 23rpx;
  line-height: 1.55;
}

.library-analysis {
  margin-top: 18rpx;
  padding: 20rpx 18rpx 20rpx 22rpx;
  border-left: 5rpx solid var(--library-grammar-brass);
  border-radius: 0 8rpx 8rpx 0;
  background: rgba(243, 232, 212, 0.72);
}

.library-analysis-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  color: var(--library-grammar-ink);
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 600;
}

.library-analysis-answer {
  flex-shrink: 0;
  color: var(--library-grammar-moss);
  font-size: 22rpx;
}

.library-analysis-text {
  margin-top: 14rpx;
  color: var(--library-grammar-muted);
  font-size: 26rpx;
  line-height: 1.72;
}

.library-lookup-token {
  color: var(--library-grammar-ink);
  border-bottom: 0;
  text-decoration: none;
}

.library-complete-proof {
  margin-top: 22rpx;
}

.library-complete-clip {
  position: absolute;
  top: -12rpx;
  width: 120rpx;
  height: 26rpx;
  border-radius: 6rpx;
  background: var(--library-grammar-brass);
}

.library-dictionary-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(43, 33, 27, 0.36);
}

.library-dictionary-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 41;
  padding: 28rpx;
  border: 1rpx solid var(--library-grammar-rule);
  border-radius: var(--library-grammar-radius);
  background:
    linear-gradient(90deg, rgba(184, 149, 98, 0.12) 1rpx, transparent 1rpx),
    var(--library-grammar-paper-light);
  background-size: 38rpx 100%, 100% 100%;
  box-shadow: 0 18rpx 44rpx rgba(43, 33, 27, 0.22);
}

.library-dictionary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.library-dictionary-word {
  color: var(--library-grammar-ink);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 600;
  word-break: break-word;
}

.library-dictionary-phonetic {
  margin-top: 6rpx;
  color: var(--library-grammar-muted);
  font-size: 25rpx;
  line-height: 1.35;
}

.library-dictionary-audio,
.library-dictionary-add {
  margin: 0;
  border-radius: 8rpx;
  font-weight: 600;
}

.library-dictionary-audio {
  flex-shrink: 0;
  width: 60rpx;
  min-width: 60rpx;
  height: 60rpx;
  padding: 0;
  background: var(--library-grammar-desk);
  color: #FFFDF7;
  font-size: 28rpx;
  line-height: 60rpx;
  text-align: center;
}

.library-dictionary-add {
  width: 100%;
  height: 68rpx;
  margin-top: 22rpx;
  background: var(--library-grammar-brass);
  color: #FFFDF7;
  font-size: 26rpx;
  line-height: 68rpx;
}

.library-dictionary-audio::after,
.library-dictionary-add::after {
  border: 0;
}

.library-dictionary-audio.is-loading {
  animation: dictionaryAudioPulse 0.72s ease-in-out infinite;
}

.library-dictionary-definition,
.library-dictionary-empty {
  margin-top: 16rpx;
  color: var(--library-grammar-muted);
  font-size: 28rpx;
  line-height: 1.55;
}

.library-dictionary-loading {
  margin-top: 18rpx;
}

.library-dictionary-loading view {
  height: 26rpx;
  margin-top: 12rpx;
  border-radius: 6rpx;
  background: rgba(184, 149, 98, 0.16);
  animation: libraryPaperPulse 1.2s ease-in-out infinite;
}

.library-dictionary-loading view:nth-child(2) {
  width: 70%;
}

@keyframes libraryPaperPulse {
  0% {
    opacity: 0.44;
  }
  50% {
    opacity: 0.92;
  }
  100% {
    opacity: 0.44;
  }
}

@keyframes libraryDotPulse {
  0% {
    opacity: 0.35;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-4rpx);
  }
  100% {
    opacity: 0.35;
    transform: translateY(0);
  }
}
.language-en button,
.language-en view,
.language-en text { overflow-wrap: normal; word-break: normal; }
.language-en .library-title,
.language-en .grammar-title { font-size: 42rpx; line-height: 1.15; }

/* Grand Voyage: grammar charts, captain notes and brass answer controls. */
.theme-voyage.grammar-page {
  --grammar-bg: #f1e2bf;
  --grammar-bg-soft: #e7d09f;
  --grammar-card: #f8e9c4;
  --grammar-card-soft: rgba(255,241,202,.76);
  --grammar-blue: #173d55;
  --grammar-muted: #715f46;
  --grammar-soft: #806d50;
  --grammar-line: rgba(141,88,39,.28);
  --grammar-line-strong: rgba(141,88,39,.5);
  --grammar-mist: rgba(35,113,146,.16);
  --grammar-sage: #2f7767;
  --grammar-sage-soft: rgba(47,119,103,.15);
  --grammar-coral: #a83b31;
  --grammar-coral-soft: rgba(168,59,49,.14);
  min-height: 100vh;
  padding: 62rpx 26rpx 150rpx;
  background:
    linear-gradient(180deg, #62c3e7 0 210rpx, #117fac 211rpx 278rpx, #e5cf9d 279rpx, #f3e6c6 100%);
  color: var(--grammar-blue);
}

.theme-voyage .grammar-hero {
  padding: 38rpx 224rpx 34rpx 38rpx;
  border: 5rpx solid #885128;
  border-radius: 7rpx;
  background:
    repeating-linear-gradient(0deg, rgba(95,62,28,.025) 0 2rpx, transparent 2rpx 18rpx),
    #f7e6ba;
  box-shadow: 0 10rpx 0 #663b20, 0 22rpx 38rpx rgba(3,67,92,.24), inset 0 0 28rpx rgba(101,61,25,.14);
}

.theme-voyage .grammar-hero::after {
  right: 42rpx;
  top: 34rpx;
  width: 134rpx;
  height: 134rpx;
  border: 8rpx double #b47a31;
  border-radius: 50%;
  background: conic-gradient(from 45deg, #a83b31 0 12.5%, #f1db9b 0 25%, #1e668c 0 37.5%, #f1db9b 0 50%, #a83b31 0 62.5%, #f1db9b 0 75%, #1e668c 0 87.5%, #f1db9b 0);
  box-shadow: inset 0 0 0 14rpx #f5e4b7;
  opacity: 1;
}

.theme-voyage .grammar-hero-main { max-width: none; }
.theme-voyage .grammar-hero-visual { display: none; }
.theme-voyage .grammar-eyebrow { color: #a06a2d; letter-spacing: 2rpx; }
.theme-voyage .grammar-title { color: var(--grammar-blue); font-family: "Songti SC", STSong, serif; font-size: 52rpx; font-weight: 800; }
.theme-voyage .grammar-copy { color: var(--grammar-muted); }

.theme-voyage .grammar-actions {
  margin-top: 28rpx;
  padding: 5rpx;
  border: 3rpx solid #8c582c;
  border-radius: 6rpx;
  background: #d0a75c;
  box-shadow: 0 7rpx 0 #704321;
}
.theme-voyage .grammar-action { border-radius: 3rpx; color: #62401f; }
.theme-voyage .grammar-action.is-active { background: #173f57; color: #fff1c8; box-shadow: inset 0 0 0 2rpx #e3be66; }

.theme-voyage .grammar-card,
.theme-voyage .directory-card,
.theme-voyage .practice-card,
.theme-voyage .classroom-card {
  position: relative;
  border: 4rpx solid #95602f;
  border-radius: 7rpx;
  background:
    repeating-linear-gradient(14deg, rgba(102,67,30,.025) 0 2rpx, transparent 2rpx 20rpx),
    #f8e9c4;
  box-shadow: 0 9rpx 0 #744622, 0 18rpx 32rpx rgba(72,56,30,.16), inset 0 0 24rpx rgba(103,63,25,.1);
}

.theme-voyage .directory-card::after { display: none; }

.theme-voyage .grammar-card::before,
.theme-voyage .directory-card::before,
.theme-voyage .practice-card::before,
.theme-voyage .classroom-card::before {
  content: "";
  position: absolute;
  inset: 13rpx;
  border: 2rpx dashed rgba(124,79,34,.2);
  pointer-events: none;
}

.theme-voyage .grammar-card-top,
.theme-voyage .directory-content,
.theme-voyage .question-list,
.theme-voyage .classroom-card > view { position: relative; z-index: 1; }
.theme-voyage .grammar-card-label,
.theme-voyage .grammar-card-state { color: #a16b2d; font-weight: 800; }

.theme-voyage .directory-row,
.theme-voyage .classroom-topic,
.theme-voyage .verb-map-item,
.theme-voyage .micro-course-item {
  border: 3rpx solid #ae7a40;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #efd6a5, #fff0c8 18%, #f4dfb4);
  box-shadow: 0 5rpx 0 #81502a;
}

.theme-voyage .directory-mark,
.theme-voyage .micro-course-no {
  border: 3rpx solid #d3aa58;
  border-radius: 4rpx;
  background: #1d607f;
  color: #fff1c8;
}
.theme-voyage .directory-title,
.theme-voyage .classroom-topic-title,
.theme-voyage .verb-map-item-title,
.theme-voyage .micro-course-title { color: #263b3f; font-family: "Songti SC", STSong, serif; font-weight: 800; }
.theme-voyage .directory-meta,
.theme-voyage .classroom-topic-meta,
.theme-voyage .verb-map-item-copy,
.theme-voyage .micro-course-meta { color: #796548; }
.theme-voyage .directory-arrow,
.theme-voyage .classroom-topic-arrow,
.theme-voyage .verb-map-item-arrow,
.theme-voyage .micro-course-arrow { color: #aa7130; font-weight: 800; }

.theme-voyage .question-row {
  border: 4rpx solid #986332;
  border-radius: 7rpx;
  background: #f8e8c1;
