.grammar-page {
  --grammar-bg: #f6fbfd;
  --grammar-bg-soft: #edf6fa;
  --grammar-card: rgba(255, 255, 255, 0.82);
  --grammar-card-soft: rgba(255, 255, 255, 0.62);
  --grammar-blue: #17314f;
  --grammar-muted: #607087;
  --grammar-soft: #728196;
  --grammar-line: rgba(141, 183, 212, 0.26);
  --grammar-line-strong: rgba(141, 183, 212, 0.44);
  --grammar-mist: rgba(191, 215, 232, 0.38);
  --grammar-sage: #86aaa1;
  --grammar-sage-soft: rgba(134, 170, 161, 0.16);
  --grammar-coral: #df7f68;
  --grammar-coral-soft: rgba(242, 161, 142, 0.18);
  min-height: 100vh;
  padding-top: 70rpx;
  padding-bottom: 140rpx;
  background:
    linear-gradient(90deg, rgba(141, 183, 212, 0.08) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(141, 183, 212, 0.06) 1rpx, transparent 1rpx),
    linear-gradient(180deg, #f6fbfd 0%, #edf6fa 48%, #f8fbfc 100%);
  background-size: 56rpx 56rpx, 56rpx 56rpx, 100% 100%;
  color: var(--grammar-blue);
}

.grammar-render-debug { margin: 0 0 18rpx; padding: 14rpx 16rpx; border: 2rpx solid #b94f45; border-radius: 10rpx; background: #fff1ef; color: #7c2f28; font-size: 22rpx; line-height: 1.45; }

.grammar-hero {
  position: relative;
  overflow: hidden;
  padding: 40rpx 34rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 28rpx;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.92), rgba(232, 244, 250, 0.72));
  box-shadow: 0 22rpx 56rpx rgba(88, 124, 148, 0.14);
}

.grammar-hero::after {
  content: "";
  position: absolute;
  right: 22rpx;
  top: 26rpx;
  width: 190rpx;
  height: 128rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.24);
  border-radius: 24rpx;
  background:
    linear-gradient(90deg, rgba(141, 183, 212, 0.18) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(141, 183, 212, 0.14) 1rpx, transparent 1rpx);
  background-size: 38rpx 32rpx;
  opacity: 0.72;
}

.grammar-hero-main {
  position: relative;
  z-index: 1;
  max-width: 410rpx;
}

.grammar-eyebrow,
.grammar-card-label,
.grammar-card-state {
  color: #496982;
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 600;
}

.grammar-title {
  margin-top: 12rpx;
  color: var(--grammar-blue);
  font-size: 46rpx;
  line-height: 1.18;
  font-weight: 600;
}

.grammar-copy {
  margin-top: 14rpx;
  color: var(--grammar-muted);
  font-size: 26rpx;
  line-height: 1.55;
}

.grammar-hero-visual {
  position: absolute;
  right: 30rpx;
  top: 42rpx;
  z-index: 1;
  width: 210rpx;
  height: 154rpx;
}

.grammar-board {
  position: absolute;
  inset: 0;
  padding: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 72% 28%, rgba(134, 170, 161, 0.18), transparent 36%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(221, 238, 246, 0.68));
  box-shadow: 0 18rpx 36rpx rgba(88, 124, 148, 0.14);
  overflow: hidden;
}

.grammar-board::after {
  content: "";
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  top: 72rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(141, 183, 212, 0), rgba(141, 183, 212, 0.34), rgba(141, 183, 212, 0));
  z-index: 0;
}

.board-head {
  display: flex;
  gap: 7rpx;
}

.board-head view {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(73, 105, 130, 0.28);
}

.board-head view:nth-child(2) {
  background: rgba(134, 170, 161, 0.34);
}

.board-head view:nth-child(3) {
  background: rgba(223, 127, 104, 0.34);
}

.syntax-track {
  position: relative;
  z-index: 2;
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.syntax-node {
  width: 46rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(141, 183, 212, 0.28);
  color: #31516c;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(88, 124, 148, 0.1);
}

.syntax-node.is-core {
  background: rgba(242, 161, 142, 0.2);
  border-color: rgba(223, 127, 104, 0.22);
  color: #8f5b50;
}

.syntax-link {
  flex: 1;
  height: 2rpx;
  margin: 0 4rpx;
  background: linear-gradient(90deg, rgba(141, 183, 212, 0.08), rgba(141, 183, 212, 0.44), rgba(141, 183, 212, 0.08));
}

.grammar-tags {
  position: relative;
  z-index: 2;
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.grammar-tags view {
  text-align: center;
  color: rgba(73, 105, 130, 0.56);
  font-size: 14rpx;
  line-height: 1;
  font-weight: 500;
}

.grammar-tags view:nth-child(2) {
  color: rgba(157, 101, 88, 0.66);
}

.explain-card {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 10rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.2);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.58);
  z-index: 1;
}

.explain-mark {
  width: 24rpx;
  height: 24rpx;
  border-radius: 9rpx;
  background: rgba(134, 170, 161, 0.26);
}

.explain-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 7rpx;
}

.explain-lines view {
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(73, 105, 130, 0.16);
}

.explain-lines view:nth-child(2) {
  width: 70%;
}

.grammar-actions {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.52);
}

.grammar-action {
  min-width: 0;
  padding: 16rpx 18rpx;
  border-radius: 999rpx;
  color: var(--grammar-muted);
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 600;
  text-align: center;
}

.grammar-action.is-active {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(191, 215, 232, 0.5));
  color: var(--grammar-blue);
  box-shadow: 0 10rpx 24rpx rgba(88, 124, 148, 0.1);
}

.classroom-card,
.library-classroom-card { margin-top: 26rpx; }
.classroom-step { color: var(--grammar-soft); font-size: 22rpx; line-height: 1.4; }
.classroom-title { margin-top: 10rpx; color: var(--grammar-blue); font-size: 36rpx; line-height: 1.3; font-weight: 600; }
.classroom-copy { margin-top: 10rpx; color: var(--grammar-muted); font-size: 25rpx; line-height: 1.6; }
.classroom-examples { margin-top: 24rpx; padding: 22rpx; border: 1rpx solid var(--grammar-line); border-radius: 20rpx; background: rgba(255, 255, 255, 0.68); color: var(--grammar-blue); font-size: 29rpx; line-height: 1.9; }
.classroom-focus { padding: 2rpx 8rpx; border-radius: 8rpx; background: var(--grammar-coral-soft); color: #97584b; font-weight: 700; }
.classroom-notice { margin-top: 18rpx; padding: 20rpx 22rpx; border-left: 5rpx solid var(--grammar-sage); border-radius: 0 16rpx 16rpx 0; background: var(--grammar-sage-soft); color: var(--grammar-blue); font-size: 26rpx; line-height: 1.65; }
.classroom-notice-label { margin-bottom: 6rpx; color: #587970; font-size: 21rpx; font-weight: 600; }
.classroom-question { margin-top: 28rpx; color: var(--grammar-blue); font-size: 29rpx; line-height: 1.55; font-weight: 600; }
.classroom-options { margin-top: 16rpx; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.classroom-option { min-width: 0; padding: 20rpx; border: 1rpx solid var(--grammar-line-strong); border-radius: 18rpx; background: rgba(255, 255, 255, 0.72); color: var(--grammar-blue); font-size: 27rpx; text-align: center; }
.classroom-option.is-correct { border-color: #438568; background: #dcefe4; color: #20583f; }
.classroom-option.is-wrong { border-color: #bd6d60; background: #f5dcd7; color: #813f35; }
.classroom-feedback { margin-top: 16rpx; padding: 18rpx 20rpx; border-radius: 16rpx; font-size: 24rpx; line-height: 1.55; }
.classroom-feedback.correct { background: #dcefe4; color: #20583f; }
.classroom-feedback.wrong { background: #f5dcd7; color: #813f35; }
.classroom-retry { margin-top: 8rpx; text-decoration: underline; }
.classroom-back { margin-bottom: 18rpx; color: var(--grammar-soft); font-size: 23rpx; }
.classroom-topic-grid { margin-top: 24rpx; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.classroom-topic { position: relative; min-width: 0; padding: 22rpx 18rpx; border: 1rpx solid var(--grammar-line); border-radius: 18rpx; background: rgba(255, 255, 255, 0.48); opacity: 0.62; }
.classroom-topic.is-ready { background: rgba(255, 255, 255, 0.82); opacity: 1; }
.classroom-topic-title { color: var(--grammar-blue); font-size: 28rpx; line-height: 1.35; font-weight: 600; }
.classroom-topic-meta { margin-top: 8rpx; color: var(--grammar-soft); font-size: 21rpx; line-height: 1.35; }
.classroom-topic-arrow { position: absolute; right: 16rpx; top: 18rpx; color: var(--grammar-sage); font-size: 30rpx; }
.verb-map-group { margin-top: 28rpx; }
.verb-map-group-title { color: var(--grammar-soft); font-size: 22rpx; line-height: 1.4; font-weight: 600; }
.verb-map-list { margin-top: 12rpx; display: flex; flex-direction: column; gap: 12rpx; }
.verb-map-item { position: relative; padding: 20rpx 52rpx 20rpx 20rpx; border: 1rpx solid var(--grammar-line); border-radius: 18rpx; background: rgba(255, 255, 255, 0.5); opacity: 0.68; }
.verb-map-item.is-ready { border-color: var(--grammar-line-strong); background: rgba(255, 255, 255, 0.86); opacity: 1; }
.verb-map-item-title { color: var(--grammar-blue); font-size: 27rpx; line-height: 1.4; font-weight: 600; }
.verb-map-item-copy { margin-top: 6rpx; color: var(--grammar-muted); font-size: 23rpx; line-height: 1.55; }
.verb-map-item-arrow { position: absolute; right: 18rpx; top: 28rpx; color: var(--grammar-sage); font-size: 30rpx; }
.micro-course-list { margin-top: 26rpx; display: flex; flex-direction: column; gap: 13rpx; }
.micro-course-group + .micro-course-group { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid var(--grammar-line); }
.micro-course-group-title { color: var(--grammar-blue); font-size: 25rpx; line-height: 1.35; font-weight: 700; }
.micro-course-group-copy { margin: 5rpx 0 12rpx; color: var(--grammar-soft); font-size: 21rpx; line-height: 1.45; }
.micro-course-group .micro-course-item + .micro-course-item { margin-top: 12rpx; }
.micro-course-item { min-width: 0; padding: 20rpx 48rpx 20rpx 18rpx; display: flex; align-items: flex-start; gap: 16rpx; position: relative; border: 1rpx solid var(--grammar-line); border-radius: 18rpx; background: rgba(255, 255, 255, 0.76); }
.micro-course-no { flex-shrink: 0; width: 50rpx; height: 50rpx; display: flex; align-items: center; justify-content: center; border-radius: 15rpx; background: var(--grammar-sage-soft); color: #587970; font-size: 21rpx; font-weight: 700; }
.micro-course-main { min-width: 0; flex: 1; }
.micro-course-title { color: var(--grammar-blue); font-size: 27rpx; line-height: 1.4; font-weight: 600; }
.micro-course-meta { margin-top: 6rpx; color: var(--grammar-muted); font-size: 22rpx; line-height: 1.5; }
.micro-course-arrow { position: absolute; right: 18rpx; top: 26rpx; color: var(--grammar-sage); font-size: 30rpx; }
.classroom-rule + .classroom-rule { margin-top: 9rpx; }
.sentence-analysis-list { margin-top: 24rpx; display: flex; flex-direction: column; gap: 14rpx; }
.sentence-analysis { padding: 18rpx 16rpx; border: 1rpx solid var(--grammar-line); border-radius: 18rpx; background: rgba(255, 255, 255, 0.7); overflow: hidden; }
.sentence-analysis-parts { display: flex; align-items: flex-start; flex-wrap: wrap; gap: 10rpx 8rpx; }
.sentence-part { min-width: 0; padding: 8rpx 10rpx 7rpx; border-bottom: 5rpx solid transparent; border-radius: 10rpx 10rpx 4rpx 4rpx; }
.sentence-part-text { color: var(--grammar-blue); font-size: 27rpx; line-height: 1.35; font-weight: 600; white-space: normal; }
.sentence-part-label { margin-top: 6rpx; font-size: 18rpx; line-height: 1.2; white-space: normal; }
.sentence-part.role-subject { border-color: #4d8fb0; background: rgba(77, 143, 176, 0.12); }
.sentence-part.role-subject .sentence-part-label { color: #356d88; }
.sentence-part.role-predicate { border-color: #d17661; background: rgba(209, 118, 97, 0.13); }
.sentence-part.role-predicate .sentence-part-label { color: #9a4f3f; }
.sentence-part.role-object { border-color: #769b75; background: rgba(118, 155, 117, 0.14); }
.sentence-part.role-object .sentence-part-label { color: #527451; }
.sentence-part.role-modifier { border-color: #9b82b5; background: rgba(155, 130, 181, 0.13); }
.sentence-part.role-modifier .sentence-part-label { color: #715b88; }
.sentence-part.role-helper { border-color: #b99247; background: rgba(185, 146, 71, 0.14); }
.sentence-part.role-helper .sentence-part-label { color: #80632f; }
.sentence-part.role-auxiliary, .sentence-part.role-modal { border-color: #b99247; background: rgba(185, 146, 71, 0.14); }
.sentence-part.role-auxiliary .sentence-part-label, .sentence-part.role-modal .sentence-part-label { color: #80632f; }
.sentence-part.role-attribute { border-color: #9b82b5; background: rgba(155, 130, 181, 0.13); }
.sentence-part.role-attribute .sentence-part-label { color: #715b88; }
.sentence-part.role-adverbial { border-color: #6d91b8; background: rgba(109, 145, 184, 0.13); }
.sentence-part.role-adverbial .sentence-part-label { color: #4b6d91; }
.sentence-part.role-conjunction { border-color: #b07a9b; background: rgba(176, 122, 155, 0.13); }
.sentence-part.role-conjunction .sentence-part-label { color: #80556f; }
.sentence-part.role-preposition { border-color: #6d91b8; background: rgba(109, 145, 184, 0.13); }
.sentence-part.role-preposition .sentence-part-label { color: #4b6d91; }
.sentence-part.role-complement { border-color: #769b75; background: rgba(118, 155, 117, 0.14); }
.sentence-part.role-complement .sentence-part-label { color: #527451; }
.sentence-part.role-interjection { border-color: #b07a9b; background: rgba(176, 122, 155, 0.13); }
.sentence-part.role-interjection .sentence-part-label { color: #80556f; }
.sentence-translation { margin-top: 14rpx; padding-top: 12rpx; border-top: 1rpx dashed var(--grammar-line); color: var(--grammar-muted); font-size: 22rpx; line-height: 1.55; }
.sentence-translation text { color: var(--grammar-blue); font-weight: 600; }
.sentence-note-title { color: var(--grammar-blue); font-size: 20rpx; line-height: 1.3; font-weight: 700; }
.sentence-note-body { margin-top: 5rpx; }
.sentence-translation-tip { margin-top: 6rpx; color: var(--grammar-soft); }
.sentence-translation.mode-translation { border-left: 4rpx solid #9b82b5; padding-left: 12rpx; }
.sentence-translation.mode-spelling { border-left: 4rpx solid #769b75; padding-left: 12rpx; }
.sentence-translation.mode-sound { border-left: 4rpx solid #4d8fb0; padding-left: 12rpx; }
.sentence-translation.mode-structure { border-left: 4rpx solid #b99247; padding-left: 12rpx; }
.classroom-example-with-note + .classroom-example-with-note { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid var(--grammar-line); }
.classroom-exercise-count { margin-top: 26rpx; color: var(--grammar-soft); font-size: 21rpx; line-height: 1.3; font-weight: 600; }
.classroom-exercise-count + .classroom-question { margin-top: 8rpx; }
.classroom-footer-actions { margin-top: 24rpx; display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 12rpx; }
.classroom-footer-button { min-width: 0; min-height: 76rpx; padding: 16rpx 14rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; font-size: 24rpx; line-height: 1.3; font-weight: 600; text-align: center; }
.classroom-footer-button.is-back { border: 1rpx solid var(--grammar-line-strong); background: rgba(255, 255, 255, 0.66); color: var(--grammar-muted); }
.classroom-footer-button.is-next { border: 1rpx solid rgba(134, 170, 161, 0.44); background: #315b70; color: #fff; }
.classroom-footer-button.is-disabled { border-color: var(--grammar-line); background: rgba(191, 215, 232, 0.36); color: var(--grammar-soft); }

.grammar-card {
  margin-top: 26rpx;
  padding: 30rpx 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 28rpx;
  background: var(--grammar-card);
  box-shadow: 0 18rpx 44rpx rgba(88, 124, 148, 0.11);
}

.directory-card {
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.86), rgba(238, 247, 251, 0.7));
}

.directory-card::after {
  content: "";
  position: absolute;
  right: 24rpx;
  bottom: 22rpx;
  width: 154rpx;
  height: 92rpx;
  border-radius: 18rpx;
  background:
    linear-gradient(90deg, rgba(134, 170, 161, 0.18) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(134, 170, 161, 0.16) 1rpx, transparent 1rpx);
  background-size: 38rpx 30rpx;
  opacity: 0.48;
  pointer-events: none;
}

.practice-card {
  padding: 28rpx 22rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(246, 251, 253, 0.78));
}

.grammar-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.grammar-card-label {
  color: var(--grammar-blue);
}

.grammar-card-state,
.practice-progress {
  flex-shrink: 0;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: var(--grammar-mist);
  color: #496982;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 600;
}

.practice-progress {
  display: inline-flex;
  margin-top: 10rpx;
}

.directory-map,
.question-list {
  margin-top: 24rpx;
}

.directory-map {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.directory-map::before {
  content: "";
  position: absolute;
  left: 34rpx;
  top: 28rpx;
  bottom: 28rpx;
  width: 2rpx;
  background: linear-gradient(180deg, rgba(141, 183, 212, 0), rgba(141, 183, 212, 0.42), rgba(141, 183, 212, 0));
}

.question-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.directory-row {
  position: relative;
  min-height: 146rpx;
  padding: 24rpx 18rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  border: 1rpx solid var(--grammar-line);
  border-radius: 24rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.76), rgba(238, 247, 251, 0.58));
  box-shadow: 0 10rpx 26rpx rgba(88, 124, 148, 0.06);
}

.directory-row:nth-child(3n + 1) {
  grid-column: span 2;
}

.map-node::after {
  content: "";
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  width: 46rpx;
  height: 46rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.18);
  background:
    linear-gradient(90deg, rgba(141, 183, 212, 0.18) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(141, 183, 212, 0.14) 1rpx, transparent 1rpx);
  background-size: 23rpx 23rpx;
}

.directory-mark {
  position: relative;
  flex-shrink: 0;
  width: 44rpx;
  height: 66rpx;
}

.mark-dot {
  position: absolute;
  left: 0;
  top: 4rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(73, 105, 130, 0.25);
  background: rgba(255, 255, 255, 0.7);
}

.mark-branch {
  position: absolute;
  left: 33rpx;
  top: 21rpx;
  width: 24rpx;
  height: 24rpx;
  border-top: 2rpx solid rgba(141, 183, 212, 0.4);
  border-right: 2rpx solid rgba(141, 183, 212, 0.4);
  border-radius: 0 12rpx 0 0;
}

.directory-content {
  flex: 1;
  min-width: 0;
}

.directory-title {
  color: var(--grammar-blue);
  font-size: 30rpx;
  line-height: 1.28;
  font-weight: 600;
  word-break: break-word;
}

.directory-meta,
.question-meta {
  margin-top: 8rpx;
  color: var(--grammar-soft);
  font-size: 22rpx;
  line-height: 1.45;
}

.directory-arrow {
  flex-shrink: 0;
  width: 38rpx;
  height: 38rpx;
  border-radius: 14rpx;
  background: rgba(191, 215, 232, 0.32);
  color: #496982;
  font-size: 30rpx;
  line-height: 34rpx;
  text-align: center;
}

.directory-back-icon {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(191, 215, 232, 0.34);
  color: #496982;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 600;
}

.question-row {
  position: relative;
  overflow: hidden;
  padding: 28rpx 24rpx;
  border: 1rpx solid var(--grammar-line);
  border-radius: 26rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(244, 250, 252, 0.72));
  box-shadow: 0 12rpx 30rpx rgba(88, 124, 148, 0.07);
}

.question-row::before {
  content: "";
  position: absolute;
  left: 0;
  top: 34rpx;
  bottom: 34rpx;
  width: 8rpx;
  background: repeating-linear-gradient(180deg, rgba(141, 183, 212, 0.42) 0rpx, rgba(141, 183, 212, 0.42) 12rpx, transparent 12rpx, transparent 24rpx);
}

.diagnostic-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.question-meta {
  display: inline-flex;
  max-width: 100%;
  margin-top: 0;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(191, 215, 232, 0.28);
  color: #607087;
}

.diagnostic-scale {
  flex-shrink: 0;
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 42rpx;
  padding: 8rpx 10rpx;
  border-radius: 16rpx;
  background: rgba(191, 215, 232, 0.18);
}

.diagnostic-scale view {
  width: 3rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(73, 105, 130, 0.28);
}

.diagnostic-scale view:nth-child(2n) {
  height: 24rpx;
}

.diagnostic-scale view:nth-child(3) {
  height: 30rpx;
  background: rgba(223, 127, 104, 0.42);
}

.question-prompt {
  margin-top: 20rpx;
  color: var(--grammar-blue);
  font-size: 32rpx;
  line-height: 1.65;
  font-weight: 500;
}

.option-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.2);
  border-radius: 24rpx;
  background:
    linear-gradient(90deg, rgba(141, 183, 212, 0.13) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(141, 183, 212, 0.1) 1rpx, transparent 1rpx),
    rgba(255, 255, 255, 0.34);
  background-size: 50% 100%, 100% 50%, 100% 100%;
}

.option-item {
  min-height: 128rpx;
  padding: 18rpx;
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  gap: 12rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.22);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #2f4661;
  font-size: 26rpx;
  line-height: 1.55;
}

.option-key {
  flex-shrink: 0;
  width: 42rpx;
  height: 34rpx;
  border-radius: 12rpx;
  background: rgba(191, 215, 232, 0.38);
  color: #496982;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
  font-weight: 600;
}

.option-text {
  flex: 1;
  min-width: 0;
  word-break: break-word;
}

.option-item.is-selected {
  border-color: rgba(223, 127, 104, 0.55);
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 10rpx 22rpx rgba(223, 127, 104, 0.09);
}

.option-item.is-selected .option-key {
  background: var(--grammar-coral-soft);
  color: var(--grammar-coral);
}

.option-item.is-correct {
  border-color: rgba(39, 121, 101, 0.82);
  background: rgba(78, 169, 147, 0.34);
  color: #195f52;
}

.option-item.is-correct .option-key {
  background: rgba(39, 121, 101, 0.34);
  color: #195f52;
}

.option-item.is-correct .option-text {
  color: #195f52;
  text-decoration: none;
}

.option-item.is-wrong {
  border-color: rgba(180, 61, 45, 0.8);
  background: rgba(226, 96, 72, 0.32);
  color: #96382b;
}

.option-item.is-wrong .option-key {
  background: rgba(180, 61, 45, 0.3);
  color: #96382b;
}

.option-item.is-wrong .option-text {
  color: #96382b;
  text-decoration: none;
}

.answer-line {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 600;
}

.answer-summary {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.answer-explain-toggle {
  flex: none;
  margin-left: auto;
  padding: 10rpx 14rpx;
  border: 1rpx solid rgba(73, 105, 130, 0.24);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.58);
  color: #496982;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 600;
}

.answer-explain-toggle.is-active {
  border-color: rgba(65, 106, 99, 0.30);
  background: var(--grammar-sage-soft);
  color: #416a63;
}

.answer-line.is-correct {
  background: transparent;
  color: #416a63;
}

.answer-line.is-wrong {
  background: transparent;
  color: #9d6558;
}

.answer-line .answer-result,
.answer-line .standard-answer {
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
}

.answer-line.is-correct .answer-result,
.answer-line .standard-answer {
  background: rgba(78, 169, 147, 0.34);
  color: #195f52;
}

.answer-line.is-wrong .answer-result {
  background: rgba(226, 96, 72, 0.32);
  color: #96382b;
}

.grammar-explain-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.grammar-explain-action {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(191, 215, 232, 0.34);
  color: #496982;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 600;
}

.grammar-explain-action.is-active {
  background: var(--grammar-sage-soft);
  color: #416a63;
}

.grammar-explain-error {
  margin-top: 12rpx;
  color: #9d6558;
  font-size: 22rpx;
  line-height: 1.5;
}

.inline-analysis {
  margin-top: 16rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(134, 170, 161, 0.2);
  border-radius: 22rpx;
  background: rgba(246, 251, 253, 0.84);
}

.analysis-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  color: var(--grammar-blue);
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 600;
}

.analysis-state {
  flex-shrink: 0;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: var(--grammar-sage-soft);
  color: #416a63;
  font-size: 20rpx;
  line-height: 1.2;
}

.analysis-text {
  margin-top: 14rpx;
  color: #52657a;
  font-size: 26rpx;
  line-height: 1.7;
}

.theme-warm.grammar-page .inline-analysis {
  margin-top: 22rpx;
  padding: 22rpx 0 0;
  border: 0;
  border-top: 1rpx solid rgba(141, 183, 212, 0.26);
  border-radius: 0;
  background: transparent;
}

.theme-warm.grammar-page .analysis-head {
  color: #17314f;
  font-family: var(--font-body-family);
  font-size: var(--result-section-size);
  line-height: 1.4;
  font-weight: 650;
}

.theme-warm.grammar-page .analysis-state {
  padding: 7rpx 12rpx;
  font-family: var(--font-number-family);
  font-size: var(--result-meta-size);
  line-height: 1.25;
  font-weight: 600;
}

.theme-warm.grammar-page .analysis-text.is-primary {
  margin-top: 16rpx;
  color: #344f68;
  font-family: var(--font-body-family);
  font-size: var(--result-body-size);
  line-height: var(--result-line-body);
}

.theme-warm.grammar-page .analysis-text.is-support {
  margin-top: 16rpx;
  padding-left: 18rpx;
  border-left: 4rpx solid rgba(141, 183, 212, 0.48);
  color: #607087;
  font-family: var(--font-body-family);
  font-size: var(--result-support-size);
  line-height: var(--result-line-support);
}

.theme-warm.grammar-page .grammar-explain-actions {
  margin-top: 18rpx;
}

.theme-warm.grammar-page .grammar-explain-action {
  padding: 10rpx 0;
  background: transparent;
  color: #527fa1;
  font-size: var(--result-meta-size);
}

.token-line {
  word-break: normal;
  overflow-wrap: break-word;
}

.lookup-token {
  color: #477899;
  border-bottom: 0;
  text-decoration: none;
}

.dictionary-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(23, 49, 79, 0.22);
}

.dictionary-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 41;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 24rpx 72rpx rgba(23, 49, 79, 0.18);
}

.dictionary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.dictionary-word {
  color: var(--grammar-blue);
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 600;
}

.dictionary-phonetic {
  margin-top: 6rpx;
  color: var(--grammar-muted);
  font-size: 26rpx;
}

.dictionary-audio,
.dictionary-add {
  margin: 0;
  border-radius: 999rpx;
  font-weight: 600;
}

.dictionary-audio {
  flex-shrink: 0;
  width: 58rpx;
  min-width: 58rpx;
  height: 58rpx;
  padding: 0;
  background: rgba(191, 215, 232, 0.42);
  color: #496982;
  font-size: 28rpx;
  line-height: 58rpx;
  text-align: center;
}

.dictionary-add {
  width: 100%;
  height: 66rpx;
  margin-top: 22rpx;
  background: linear-gradient(135deg, #f2a18e, #df7f68);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 66rpx;
  box-shadow: 0 14rpx 26rpx rgba(223, 127, 104, 0.18);
}

.dictionary-audio::after,
.dictionary-add::after {
  border: 0;
}

.dictionary-audio.is-loading {
  animation: dictionaryAudioPulse 0.72s ease-in-out infinite;
}

@keyframes dictionaryAudioPulse {
  0% {
    opacity: 0.55;
    transform: scale(0.88);
  }
  50% {
    opacity: 1;
    transform: scale(1.08);
  }
  100% {
    opacity: 0.55;
    transform: scale(0.88);
  }
}

.dictionary-loading,
.dictionary-empty,
.dictionary-definition {
  margin-top: 16rpx;
  color: #52657a;
  font-size: 28rpx;
  line-height: 1.55;
}

.dictionary-loading,
.dictionary-empty {
  color: var(--grammar-muted);
}

.theme-library.grammar-page {
  --library-grammar-bg: #FAF5EA;
  --library-grammar-desk: #2B211B;
  --library-grammar-ink: #14283A;
  --library-grammar-paper: #F3E8D4;
  --library-grammar-paper-light: #FFFDF7;
  --library-grammar-brass: #B89562;
  --library-grammar-moss: #7F8C78;
  --library-grammar-muted: #6F675F;
  --library-grammar-error: #9A5F54;
  --library-grammar-rule: rgba(184, 149, 98, 0.34);
  --library-grammar-shadow: 0 8rpx 22rpx rgba(43, 33, 27, 0.12);
  --library-grammar-radius: 12rpx;
  min-height: 100vh;
  padding: 52rpx 24rpx 150rpx;
  background:
    linear-gradient(90deg, rgba(184, 149, 98, 0.08) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(20, 40, 58, 0.05) 1rpx, transparent 1rpx),
    linear-gradient(180deg, #FAF5EA 0%, #F3E8D4 100%);
  background-size: 56rpx 56rpx, 56rpx 56rpx, 100% 100%;
  color: var(--library-grammar-ink);
  letter-spacing: 0;
}

.library-grammar-shell {
  position: relative;
}

.library-typecase {
  position: relative;
  min-height: 276rpx;
  padding: 36rpx 28rpx 30rpx;
  overflow: hidden;
  border-radius: var(--library-grammar-radius);
  background:
    linear-gradient(90deg, rgba(184, 149, 98, 0.2) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(250, 245, 234, 0.05), rgba(43, 33, 27, 0.96)),
    var(--library-grammar-desk);
  background-size: 42rpx 100%, 100% 100%, 100% 100%;
  box-shadow: var(--library-grammar-shadow);
}

.library-typecase::after {
  content: "";
  position: absolute;
  left: 26rpx;
  right: 26rpx;
  bottom: 24rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(184, 149, 98, 0.64), transparent);
}

.library-typecase.is-compact {
  min-height: 188rpx;
  padding-bottom: 24rpx;
}

.library-typecase-copy {
  position: relative;
  z-index: 2;
  max-width: 390rpx;
}

.library-eyebrow,
.library-page-kicker {
  color: var(--library-grammar-brass);
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 600;
}

.library-title {
  margin-top: 10rpx;
  color: #FFFDF7;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 44rpx;
  line-height: 1.18;
  font-weight: 600;
}

.library-copy {
  margin-top: 12rpx;
  color: rgba(250, 245, 234, 0.74);
  font-size: 25rpx;
  line-height: 1.55;
}

.library-syntax-plate {
  position: absolute;
  right: 22rpx;
  top: 40rpx;
  z-index: 2;
  width: 246rpx;
  height: 144rpx;
  padding: 20rpx 16rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.46);
  border-radius: var(--library-grammar-radius);
  background: rgba(243, 232, 212, 0.96);
  box-shadow: 0 8rpx 18rpx rgba(20, 40, 58, 0.16);
}

.library-typecase.is-compact .library-syntax-plate {
  top: 28rpx;
  transform: scale(0.9);
  transform-origin: right top;
}

.library-syntax-line {
  position: absolute;
  left: 26rpx;
  right: 26rpx;
  top: 78rpx;
  z-index: 1;
  height: 3rpx;
  background: var(--library-grammar-brass);
}

.library-syntax-cast {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
}

.library-syntax-type {
  position: relative;
  z-index: 4;
  width: 64rpx;
  height: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.5);
  border-radius: 8rpx;
  background: var(--library-grammar-paper-light);
  color: var(--library-grammar-ink);
  box-shadow: 0 4rpx 10rpx rgba(43, 33, 27, 0.12);
}

.library-syntax-type text:first-child {
  position: relative;
  z-index: 5;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
}

.library-syntax-type text:last-child {
  color: var(--library-grammar-muted);
  font-size: 18rpx;
  line-height: 1;
}

.library-syntax-type.is-core {
  border-color: rgba(184, 149, 98, 0.82);
  background: #FAF5EA;
}

.library-index-tabs {
  margin: 22rpx 8rpx 0;
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
}

.library-classroom-card { position: relative; padding: 34rpx 30rpx; border: 1rpx solid var(--library-grammar-rule); border-radius: var(--library-grammar-radius); background: linear-gradient(180deg, var(--library-grammar-paper-light), var(--library-grammar-paper)); box-shadow: var(--library-grammar-shadow); }
.theme-library .classroom-step { color: var(--library-grammar-brass); }
.theme-library .classroom-title,
.theme-library .classroom-question { color: var(--library-grammar-ink); }
.theme-library .classroom-copy { color: var(--library-grammar-muted); }
.theme-library .classroom-examples { border-color: var(--library-grammar-rule); border-radius: 8rpx; background: rgba(255, 253, 247, 0.76); color: var(--library-grammar-ink); }
.theme-library .classroom-focus { background: rgba(184, 149, 98, 0.2); color: #765b37; }
.theme-library .classroom-notice { border-left-color: var(--library-grammar-moss); background: rgba(127, 140, 120, 0.12); color: var(--library-grammar-ink); }
.theme-library .classroom-notice-label { color: var(--library-grammar-moss); }
.theme-library .classroom-back { color: var(--library-grammar-brass); }
.theme-library .classroom-topic { border-color: var(--library-grammar-rule); border-radius: 8rpx; background: rgba(243, 232, 212, 0.52); }
.theme-library .classroom-topic.is-ready { background: var(--library-grammar-paper-light); }
.theme-library .classroom-topic-title { color: var(--library-grammar-ink); }
.theme-library .classroom-topic-meta { color: var(--library-grammar-muted); }
.theme-library .verb-map-group-title { color: var(--library-grammar-brass); }
.theme-library .verb-map-item { border-color: var(--library-grammar-rule); border-radius: 8rpx; background: rgba(243, 232, 212, 0.62); }
.theme-library .verb-map-item.is-ready { background: var(--library-grammar-paper-light); }
.theme-library .verb-map-item-title { color: var(--library-grammar-ink); }
.theme-library .verb-map-item-copy { color: var(--library-grammar-muted); }
.theme-library .verb-map-item-arrow { color: var(--library-grammar-brass); }
.theme-library .micro-course-item { border-color: var(--library-grammar-rule); border-radius: 8rpx; background: var(--library-grammar-paper-light); }
.theme-library .micro-course-group + .micro-course-group { border-top-color: var(--library-grammar-rule); }
.theme-library .micro-course-group-title { color: var(--library-grammar-ink); }
.theme-library .micro-course-group-copy { color: var(--library-grammar-muted); }
.theme-library .micro-course-no { border-radius: 4rpx; background: rgba(184, 149, 98, 0.18); color: #765b37; }
.theme-library .micro-course-title { color: var(--library-grammar-ink); }
.theme-library .micro-course-meta { color: var(--library-grammar-muted); }
.theme-library .micro-course-arrow { color: var(--library-grammar-brass); }
.theme-library .sentence-analysis { border-color: var(--library-grammar-rule); border-radius: 8rpx; background: var(--library-grammar-paper-light); }
.theme-library .sentence-part { border-radius: 4rpx; }
.theme-library .sentence-part-text { color: var(--library-grammar-ink); }
.theme-library .sentence-translation { border-top-color: var(--library-grammar-rule); color: var(--library-grammar-muted); }
.theme-library .sentence-translation text { color: var(--library-grammar-ink); }
.theme-library .sentence-note-title { color: var(--library-grammar-ink); }
.theme-library .sentence-translation-tip { color: var(--library-grammar-muted); }
