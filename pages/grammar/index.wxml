<view class="theme-{{theme}} language-{{language}} page-shell grammar-page">
  <view class="grammar-render-debug" wx:if="{{grammarRenderDebug}}">{{grammarRenderDebug}}</view>
  <block wx:if="{{theme === 'library'}}">
    <view class="library-grammar-shell">
      <view class="library-typecase {{selectedTopicId ? 'is-compact' : ''}}">
        <view class="library-typecase-copy">
          <view class="library-eyebrow">{{texts.eyebrow}}</view>
          <view class="library-title">{{texts.title}}</view>
          <view class="library-copy">{{texts.copy}}</view>
        </view>
        <view class="library-syntax-plate">
          <view class="library-syntax-line"></view>
          <view class="library-syntax-cast">
            <view class="library-syntax-type">
              <text>{{texts.subject}}</text>
              <text>S</text>
            </view>
            <view class="library-syntax-type is-core">
              <text>{{texts.predicate}}</text>
              <text>V</text>
            </view>
            <view class="library-syntax-type">
              <text>{{texts.object}}</text>
              <text>O</text>
            </view>
          </view>
        </view>
      </view>

      <view class="library-index-tabs">
        <view class="library-index-tab {{mode === 'topics' ? 'is-active' : ''}}" bindtap="openTopicBook">{{texts.topics}}</view>
        <view class="library-index-tab" bindtap="openPracticeHistory">{{texts.history}}</view>
        <view class="library-index-tab {{mode === 'classroom' ? 'is-active' : ''}}" bindtap="openGrammarClassroom">{{classroom.tab}}</view>
      </view>

      <view class="library-classroom-card" wx:if="{{mode === 'classroom'}}">
        <block wx:if="{{!selectedClassroomCategory}}">
          <view class="classroom-step">{{classroom.directory}}</view>
          <view class="classroom-title">{{classroom.directoryCopy}}</view>
          <view class="classroom-topic-grid">
            <view class="classroom-topic is-ready" wx:for="{{classroom.categories}}" wx:key="id" data-category-id="{{item.id}}" bindtap="selectClassroomCategory">
              <view class="classroom-topic-title">{{item.title}}</view>
              <view class="classroom-topic-meta">{{item.meta}}</view>
              <view class="classroom-topic-arrow">›</view>
            </view>
          </view>
        </block>
        <block wx:elif="{{!selectedClassroomTopic}}">
          <view class="classroom-back hierarchy-back" bindtap="backToClassroomCategories">{{classroom.back}}</view>
          <view class="classroom-step">{{classroom.wordTitle}}</view>
          <view class="classroom-title">{{classroom.wordCopy}}</view>
          <view class="classroom-topic-grid">
            <block wx:for="{{classroom.categories}}" wx:key="id">
              <block wx:if="{{item.id === selectedClassroomCategory}}">
                <view class="classroom-topic {{child.ready ? 'is-ready' : ''}}" wx:for="{{item.children}}" wx:for-item="child" wx:key="id" data-topic-id="{{child.id}}" bindtap="selectClassroomTopic">
                  <view class="classroom-topic-title">{{child.title}}</view>
                  <view class="classroom-topic-meta">{{child.meta}}</view>
                  <view class="classroom-topic-arrow">{{child.ready ? '›' : '·'}}</view>
                </view>
              </block>
            </block>
          </view>
        </block>
        <block wx:else>
        <block wx:if="{{!selectedVerbLesson}}">
          <view class="classroom-back hierarchy-back" bindtap="backToClassroomTopics">{{classroom.subBack}}</view>
          <view class="classroom-step">{{classroom.verbMapTitle}}</view>
          <view class="classroom-title">{{classroom.verbMapCopy}}</view>
          <view class="verb-map-group" wx:for="{{classroom.verbGroups}}" wx:key="id">
            <view class="verb-map-group-title">{{item.title}}</view>
            <view class="verb-map-list">
              <view class="verb-map-item {{lesson.ready ? 'is-ready' : ''}}" wx:for="{{item.items}}" wx:for-item="lesson" wx:key="id" data-lesson-id="{{lesson.id}}" bindtap="selectVerbLesson">
                <view class="verb-map-item-title">{{lesson.title}}</view>
                <view class="verb-map-item-copy">{{lesson.copy}}</view>
                <view class="verb-map-item-arrow">{{lesson.ready ? '›' : '·'}}</view>
              </view>
            </view>
          </view>
        </block>
        <block wx:else>
        <block wx:if="{{!selectedThirdPersonLesson}}">
          <view class="classroom-back hierarchy-back" bindtap="backToActiveCourseParent">{{classroom.returnCourse}}</view>
          <view class="classroom-step">{{activeClassroomCourseTitle}}</view>
          <view class="classroom-title">{{activeClassroomCourseCopy}}</view>
          <view class="micro-course-list">
            <view class="micro-course-group" wx:for="{{activeClassroomCourseGroups}}" wx:key="id" wx:for-item="group">
              <view class="micro-course-group-title">{{group.title}}</view>
              <view class="micro-course-group-copy">{{group.copy}}</view>
              <view class="micro-course-item" wx:for="{{group.lessons}}" wx:for-item="lesson" wx:key="id" data-lesson-id="{{lesson.id}}" bindtap="selectThirdPersonLesson">
                <view class="micro-course-no">{{lesson.no}}</view>
                <view class="micro-course-main">
                  <view class="micro-course-title">{{lesson.title}}</view>
                  <view class="micro-course-meta">{{lesson.meta}}</view>
                </view>
                <view class="micro-course-arrow">›</view>
              </view>
            </view>
          </view>
        </block>
        <block wx:else>
          <view class="classroom-back hierarchy-back" bindtap="backToThirdPersonCourse">{{classroom.lessonBack}}</view>
          <view class="classroom-step">{{activeClassroomLesson.no}} / {{activeClassroomCourse.length}}</view>
          <view class="classroom-title">{{activeClassroomLesson.title}}</view>
          <view class="classroom-copy">{{activeClassroomLesson.meta}}</view>
          <view class="sentence-analysis-list" wx:if="{{activeClassroomLesson.analyses && activeClassroomLesson.analyses.length}}">
            <view class="sentence-analysis" wx:for="{{activeClassroomLesson.analyses}}" wx:key="index" wx:for-item="sentence" wx:for-index="sentenceIndex">
              <view class="sentence-analysis-parts">
                <view class="sentence-part role-{{part.role}}" wx:for="{{sentence}}" wx:for-item="part" wx:key="text">
                  <view class="sentence-part-text">{{part.text}}</view>
                  <view class="sentence-part-label">{{part.label}}</view>
                </view>
              </view>
              <view class="sentence-translation mode-{{activeClassroomLesson.exampleNotes[sentenceIndex].mode}}" wx:if="{{activeClassroomLesson.exampleNotes[sentenceIndex].visible}}">
                <view class="sentence-note-title">{{activeClassroomLesson.exampleNotes[sentenceIndex].title}}</view>
                <view class="sentence-note-body">{{activeClassroomLesson.exampleNotes[sentenceIndex].body}}</view>
                <view class="sentence-translation-tip" wx:if="{{activeClassroomLesson.exampleNotes[sentenceIndex].detail}}">{{activeClassroomLesson.exampleNotes[sentenceIndex].detail}}</view>
              </view>
            </view>
          </view>
          <view class="classroom-examples" wx:else>
            <view class="classroom-example-with-note" wx:for="{{activeClassroomLesson.examples}}" wx:key="*this" wx:for-index="exampleIndex">
              <view>{{item}}</view>
              <view class="sentence-translation mode-{{activeClassroomLesson.exampleNotes[exampleIndex].mode}}" wx:if="{{activeClassroomLesson.exampleNotes[exampleIndex].visible}}">
                <view class="sentence-note-title">{{activeClassroomLesson.exampleNotes[exampleIndex].title}}</view>
                <view class="sentence-note-body">{{activeClassroomLesson.exampleNotes[exampleIndex].body}}</view>
                <view class="sentence-translation-tip" wx:if="{{activeClassroomLesson.exampleNotes[exampleIndex].detail}}">{{activeClassroomLesson.exampleNotes[exampleIndex].detail}}</view>
              </view>
            </view>
          </view>
          <view class="classroom-notice">
            <view class="classroom-notice-label">{{classroom.coreLabel}}</view>
            <view class="classroom-rule" wx:for="{{activeClassroomLesson.rules}}" wx:key="*this">{{index + 1}}. {{item}}</view>
          </view>
          <view class="classroom-exercise-count">{{activeClassroomExerciseIndex + 1}} / {{activeClassroomLesson.questions.length}}</view>
          <view class="classroom-question">{{activeClassroomQuestion.question}}</view>
          <view class="classroom-options">
            <view class="classroom-option {{classroomAnswer && option.key === activeClassroomQuestion.answer ? 'is-correct' : ''}} {{classroomAnswer === option.key && classroomResult === 'wrong' ? 'is-wrong' : ''}}" wx:for="{{activeClassroomQuestion.options}}" wx:for-item="option" wx:key="key" data-answer="{{option.key}}" bindtap="selectClassroomAnswer">{{option.key}} · {{option.text}}</view>
          </view>
          <view class="classroom-feedback {{classroomResult}}" wx:if="{{classroomResult}}">
            <view>{{classroomResult === 'correct' ? activeClassroomQuestion.correct : activeClassroomQuestion.wrong}}</view>
            <view class="classroom-retry" wx:if="{{classroomResult === 'wrong'}}" bindtap="retryClassroomPractice">{{classroom.retry}}</view>
          </view>
          <view class="classroom-footer-actions">
            <view class="classroom-footer-button is-back" bindtap="backToThirdPersonCourse">{{classroom.returnCourse}}</view>
            <view class="classroom-footer-button is-next {{classroomResult === 'correct' ? '' : 'is-disabled'}}" bindtap="continueThirdPersonLesson">{{classroomResult === 'correct' ? (!isLastClassroomExercise ? classroom.nextExercise : (isLastClassroomLesson ? classroom.finishCourse : classroom.nextLesson)) : classroom.answerToContinue}}</view>
          </view>
        </block>
        </block>
        </block>
      </view>

      <view class="library-directory-page" wx:elif="{{!selectedStageId && !selectedExamId && !selectedCategoryId && !selectedTopicId}}">
        <view class="library-page-head">
          <view>
            <view class="library-page-kicker">{{mode === 'wrong' ? texts.wrongDifficulty : texts.difficulty}}</view>
            <view class="library-page-title">{{texts.title}}</view>
          </view>
          <view class="library-page-count">{{stages.length}}{{texts.groupUnit}}</view>
        </view>
        <view class="library-directory-list" wx:if="{{stages.length}}">
          <view class="library-directory-row" wx:for="{{stages}}" wx:key="stageId" data-stage-id="{{item.stageId}}" bindtap="selectStage">
            <view class="library-row-code">SVO</view>
            <view class="library-row-main">
              <view class="library-row-title">{{item.stage}}</view>
              <view class="library-row-meta">{{item.count}}{{texts.questionUnit}}</view>
            </view>
            <view class="library-row-arrow">›</view>
          </view>
        </view>
        <view class="library-skeleton-list" wx:elif="{{mode !== 'wrong'}}">
          <view class="library-skeleton-row"></view>
          <view class="library-skeleton-row is-short"></view>
        </view>
        <view class="library-empty-proof" wx:else>
          <view class="library-empty-stamp">{{texts.eyebrow}}</view>
          <view class="library-empty-title">{{texts.noWrong}}</view>
          <view class="library-empty-action" bindtap="openTopicBook">{{texts.backTopics}}</view>
        </view>
      </view>

      <view class="library-directory-page" wx:elif="{{selectedStageId && !selectedExamId && !selectedCategoryId && !selectedTopicId}}">
        <view class="library-page-head">
          <view class="library-back-text hierarchy-back" bindtap="backToTopics">{{texts.backDifficulty}}</view>
          <view>
            <view class="library-page-kicker">{{selectedStage.stage}}</view>
            <view class="library-page-title">{{texts.mock}}</view>
          </view>
        </view>
        <view class="library-directory-list" wx:if="{{exams.length}}">
          <view class="library-directory-row" wx:for="{{exams}}" wx:key="examId" data-exam-id="{{item.examId}}" bindtap="selectExam">
            <view class="library-row-code">G</view>
            <view class="library-row-main">
              <view class="library-row-title">{{item.exam}}</view>
              <view class="library-row-meta">{{item.count}}{{texts.questionUnit}}</view>
            </view>
            <view class="library-row-arrow">{{em1Loading && item.examId === 'em1' ? '·' : '›'}}</view>
          </view>
        </view>
        <view class="library-empty-proof" wx:else>
          <view class="library-empty-stamp">—</view>
          <view class="library-empty-title">{{texts.emptyStage}}</view>
          <view class="library-empty-action" bindtap="backToTopics">{{texts.backDifficultyText}}</view>
        </view>
      </view>

      <view class="library-directory-page" wx:elif="{{selectedExamId && !selectedCategoryId && !selectedTopicId}}">
        <view class="library-page-head">
          <view class="library-back-text hierarchy-back" bindtap="backToStageCategories">{{texts.backMock}}</view>
          <view>
            <view class="library-page-kicker">{{selectedStage.stage}} · {{selectedExam.exam}}</view>
            <view class="library-page-title">{{texts.category}}</view>
          </view>
        </view>
        <view class="library-topic-grid" wx:if="{{topics.length}}">
          <view class="library-topic-row" wx:for="{{topics}}" wx:key="topicId" data-topic-id="{{item.topicId}}" bindtap="selectTopic">
            <view class="library-topic-number">{{index + 1}}</view>
            <view class="library-row-main">
              <view class="library-row-title">{{item.topic}}</view>
              <view class="library-row-meta">{{item.count}}{{texts.questionUnit}}</view>
            </view>
            <view class="library-row-arrow">›</view>
          </view>
        </view>
        <view class="library-empty-proof" wx:else>
          <view class="library-empty-stamp">—</view>
          <view class="library-empty-title">{{texts.emptyStage}}</view>
          <view class="library-empty-action" bindtap="backToStageCategories">{{texts.backMockText}}</view>
        </view>
      </view>

      <view class="library-directory-page library-drawer-page" wx:elif="{{selectedCategoryId && !selectedTopicId}}">
        <view class="library-page-head">
          <view class="library-back-text hierarchy-back" bindtap="backToExamCategories">{{texts.backCategory}}</view>
          <view>
            <view class="library-page-kicker">{{selectedCategory.topic}}</view>
            <view class="library-page-title">{{texts.subtopic}}</view>
          </view>
        </view>
        <view class="library-drawer-list" wx:if="{{selectedCategory.children.length}}">
          <view class="library-drawer-row" wx:for="{{selectedCategory.children}}" wx:key="topicId" data-topic-id="{{item.topicId}}" bindtap="selectTopic">
            <view class="library-drawer-notch"></view>
            <view class="library-row-main">
              <view class="library-row-title">{{item.topic}}</view>
              <view class="library-row-meta">{{item.count}}{{texts.questionUnit}}</view>
            </view>
            <view class="library-row-arrow">›</view>
          </view>
        </view>
        <view class="library-empty-proof" wx:else>
          <view class="library-empty-stamp">—</view>
          <view class="library-empty-title">{{texts.emptyCategory}}</view>
          <view class="library-empty-action" bindtap="backToExamCategories">{{texts.backCategoryText}}</view>
        </view>
      </view>

      <view class="library-practice-page" wx:else>
        <view class="library-practice-head">
          <view class="library-back-text hierarchy-back" bindtap="backToCategory">{{texts.backSubtopic}}</view>
          <view class="library-practice-title-wrap">
            <view class="library-page-kicker">{{selectedTopic.topic}}</view>
            <view class="library-practice-progress">{{answeredCount}} / {{selectedQuestions.length}}</view>
          </view>
        </view>
        <view class="library-resume-note" wx:if="{{selectedTopicOffset > 0}}">{{texts.resumePrefix}}{{selectedTopicOffset + 1}}{{texts.resumeSuffix}}</view>
        <view class="manual-mark-toolbar" wx:if="{{selectedQuestions.length}}">
          <text>{{texts.manualMarkHint}}</text>
          <text class="manual-mark-clear" wx:if="{{grammarMarkCount}}" bindtap="clearGrammarMarks">{{texts.clearManualMarks}}</text>
        </view>

        <view class="library-complete-proof" wx:if="{{selectedQuestions.length === 0}}">
          <view class="library-complete-clip"></view>
          <view class="library-empty-stamp">{{texts.topicDone}}</view>
          <view class="library-empty-title">{{texts.topicDone}}</view>
          <view class="library-empty-action" bindtap="backToCategory">{{texts.backSubtopicText}}</view>
        </view>

        <view class="library-proof-sheet" wx:else>
          <view id="grammar-question-{{index}}" class="library-question-row" wx:for="{{selectedQuestions}}" wx:key="_id">
            <view class="library-question-meta">{{texts.questionNo}}{{item.sequenceNumber}} · {{item.year}} · {{item.district}} · {{texts.originalNo}}{{item.number}}</view>
            <view class="library-question-prompt library-token-line {{grammarSentenceMarks[item.markScope] ? 'manual-mark-sentence' : ''}}" data-question-id="{{item._id}}" data-mark-scope="{{item.markScope}}" bindlongpress="handleGrammarSentenceMark">
              <text wx:for="{{item.promptTokens}}" wx:key="id" wx:for-item="token" class="{{item.isAnswered && token.word ? 'library-lookup-token' : ''}} {{grammarTokenMarks[token.markKey] ? 'manual-mark-' + grammarTokenMarks[token.markKey] : ''}}" data-question-id="{{item._id}}" data-word="{{token.word}}" data-word-index="{{token.wordIndex}}" data-mark-scope="{{item.markScope}}" catchtap="handleGrammarTokenTap">{{token.text}}</text>
            </view>
            <view class="library-options">
              <view class="library-option {{option.selected ? 'is-selected' : ''}} {{option.correct ? 'is-correct' : ''}} {{option.wrong ? 'is-wrong' : ''}}" wx:for="{{item.optionsList}}" wx:for-item="option" wx:key="key" data-question-id="{{item._id}}" data-option="{{option.key}}" bindtap="selectOption">
                <view class="library-option-key">{{option.key}}</view>
                <view class="library-option-text">
                  <block wx:if="{{!item.isAnswered}}">{{option.text}}</block>
                  <block wx:else>
                    <text wx:for="{{option.tokens}}" wx:key="id" wx:for-item="token" class="{{token.word ? 'library-lookup-token' : ''}}" data-question-id="{{item._id}}" data-word="{{token.word}}" catchtap="openDictionaryWord">{{token.text}}</text>
                  </block>
                </view>
              </view>
            </view>
            <view class="library-answer-line {{item.isCorrect ? 'is-correct' : 'is-wrong'}}" wx:if="{{item.isAnswered}}">
              <view class="answer-summary">
                <block wx:if="{{item.answer}}">
                  <text class="answer-result">{{item.isCorrect ? texts.correct : texts.wrong}}</text>
                  <text class="standard-answer">{{texts.standardAnswer}}{{item.answer}}</text>
                </block>
                <text wx:else>{{texts.noAnswer}}</text>
              </view>
              <view class="library-answer-explain-toggle {{item.explanationExpanded ? 'is-active' : ''}}" data-question-id="{{item._id}}" bindtap="toggleExplanation">{{item.explanationExpanded ? texts.collapseExplain : texts.explain}}</view>
            </view>
            <view class="library-analysis-loading" wx:if="{{item.explanationExpanded && item.explaining}}">
              <view></view>
              <view></view>
              <view></view>
            </view>
            <view class="library-explain-error" wx:if="{{item.explanationExpanded && item.explanationError}}">{{item.explanationError}}</view>
            <view class="library-analysis" wx:if="{{item.explanationExpanded && item.explanation}}">
              <view class="library-analysis-head">
                <text>{{item.explanation.topic}}</text>
                <text class="library-analysis-answer">{{texts.answer}}{{item.explanation.answer}}</text>
              </view>
              <view class="library-analysis-text is-primary">{{item.explanation.explanation}}</view>
              <view class="library-analysis-text is-support" wx:if="{{item.explanation.elimination}}">{{item.explanation.elimination}}</view>
              <view class="library-explain-actions">
                <view class="library-explain-action is-secondary" data-question-id="{{item._id}}" bindtap="regenerateExplanation">{{texts.explainAgain}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="library-dictionary-mask" wx:if="{{dictionaryVisible}}" catchtap="closeDictionary"></view>
      <view class="library-dictionary-sheet" wx:if="{{dictionaryVisible}}">
        <view class="library-dictionary-head">
          <view>
            <view class="library-dictionary-word">{{dictionaryEntry.word || dictionaryWord}}</view>
            <view class="library-dictionary-phonetic" wx:if="{{dictionaryEntry.phonetic}}">/{{dictionaryEntry.phonetic}}/</view>
          </view>
          <button class="library-dictionary-audio {{dictionaryAudioLoading ? 'is-loading' : ''}}" disabled="{{dictionaryLoading || dictionaryAudioLoading}}" bindtap="playDictionaryWord">♪</button>
        </view>
        <button class="library-dictionary-add" loading="{{dictionaryAdding}}" bindtap="addDictionaryWordToLibrary">{{texts.addLibrary}}</button>
        <block wx:if="{{!dictionaryLoading}}">
          <view class="library-dictionary-definition" wx:for="{{dictionaryEntry.definitions}}" wx:key="*this">· {{item}}</view>
          <view class="library-dictionary-empty" wx:if="{{!dictionaryEntry.definitions || !dictionaryEntry.definitions.length}}">{{texts.noDefinition}}</view>
        </block>
        <view class="library-dictionary-loading" wx:else>
          <view></view>
          <view></view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
  <view class="grammar-hero">
    <image wx:if="{{theme === 'voyage'}}" class="voyage-anime-subpage-banner" src="https://796f-youshengenglish-6glk12rd6c6e719b-1419984942.tcb.qcloud.la/_assets/themes/voyage/20260727-anime-v1/subpages/grammar-robin-zoro-map.jpg" mode="aspectFill"></image>
    <image wx:if="{{theme === 'tactical'}}" class="tactical-subpage-banner" src="https://796f-youshengenglish-6glk12rd6c6e719b-1419984942.tcb.qcloud.la/_assets/themes/tactical/20260727-subpages-v1/grammar-briefing.jpg" mode="aspectFill"></image>
    <view class="grammar-hero-main">
      <view class="grammar-eyebrow">{{texts.eyebrow}}</view>
      <view class="grammar-title">{{texts.title}}</view>
      <view class="grammar-copy">{{texts.copy}}</view>
    </view>
    <view class="grammar-hero-visual">
      <view class="grammar-board">
        <view class="board-head">
          <view></view><view></view><view></view>
        </view>
        <view class="syntax-track">
          <view class="syntax-node">{{texts.subject}}</view>
          <view class="syntax-link"></view>
          <view class="syntax-node is-core">{{texts.predicate}}</view>
          <view class="syntax-link"></view>
          <view class="syntax-node">{{texts.object}}</view>
        </view>
        <view class="grammar-tags">
          <view>Subject</view>
          <view>Verb</view>
          <view>Object</view>
        </view>
        <view class="explain-card">
          <view class="explain-mark"></view>
          <view class="explain-lines">
            <view></view>
            <view></view>
          </view>
        </view>
      </view>
    </view>
    <view class="grammar-actions">
      <view class="grammar-action {{mode === 'topics' ? 'is-active' : ''}}" bindtap="openTopicBook">{{texts.topics}}</view>
      <view class="grammar-action" bindtap="openPracticeHistory">{{texts.history}}</view>
      <view class="grammar-action {{mode === 'classroom' ? 'is-active' : ''}}" bindtap="openGrammarClassroom">{{classroom.tab}}</view>
    </view>
  </view>

  <view class="grammar-card classroom-card" wx:if="{{mode === 'classroom'}}">
    <block wx:if="{{!selectedClassroomCategory}}">
      <view class="classroom-step">{{classroom.directory}}</view>
      <view class="classroom-title">{{classroom.directoryCopy}}</view>
      <view class="classroom-topic-grid">
        <view class="classroom-topic is-ready" wx:for="{{classroom.categories}}" wx:key="id" data-category-id="{{item.id}}" bindtap="selectClassroomCategory">
          <view class="classroom-topic-title">{{item.title}}</view>
          <view class="classroom-topic-meta">{{item.meta}}</view>
          <view class="classroom-topic-arrow">›</view>
        </view>
      </view>
    </block>
    <block wx:elif="{{!selectedClassroomTopic}}">
      <view class="classroom-back hierarchy-back" bindtap="backToClassroomCategories">{{classroom.back}}</view>
      <view class="classroom-step">{{classroom.wordTitle}}</view>
      <view class="classroom-title">{{classroom.wordCopy}}</view>
      <view class="classroom-topic-grid">
        <block wx:for="{{classroom.categories}}" wx:key="id">
          <block wx:if="{{item.id === selectedClassroomCategory}}">
            <view class="classroom-topic {{child.ready ? 'is-ready' : ''}}" wx:for="{{item.children}}" wx:for-item="child" wx:key="id" data-topic-id="{{child.id}}" bindtap="selectClassroomTopic">
              <view class="classroom-topic-title">{{child.title}}</view>
              <view class="classroom-topic-meta">{{child.meta}}</view>
              <view class="classroom-topic-arrow">{{child.ready ? '›' : '·'}}</view>
            </view>
          </block>
        </block>
      </view>
    </block>
    <block wx:else>
    <block wx:if="{{!selectedVerbLesson}}">
      <view class="classroom-back hierarchy-back" bindtap="backToClassroomTopics">{{classroom.subBack}}</view>
      <view class="classroom-step">{{classroom.verbMapTitle}}</view>
      <view class="classroom-title">{{classroom.verbMapCopy}}</view>
      <view class="verb-map-group" wx:for="{{classroom.verbGroups}}" wx:key="id">
        <view class="verb-map-group-title">{{item.title}}</view>
        <view class="verb-map-list">
          <view class="verb-map-item {{lesson.ready ? 'is-ready' : ''}}" wx:for="{{item.items}}" wx:for-item="lesson" wx:key="id" data-lesson-id="{{lesson.id}}" bindtap="selectVerbLesson">
            <view class="verb-map-item-title">{{lesson.title}}</view>
            <view class="verb-map-item-copy">{{lesson.copy}}</view>
            <view class="verb-map-item-arrow">{{lesson.ready ? '›' : '·'}}</view>
          </view>
        </view>
      </view>
    </block>
    <block wx:else>
    <block wx:if="{{!selectedThirdPersonLesson}}">
      <view class="classroom-back hierarchy-back" bindtap="backToActiveCourseParent">{{classroom.returnCourse}}</view>
      <view class="classroom-step">{{activeClassroomCourseTitle}}</view>
      <view class="classroom-title">{{activeClassroomCourseCopy}}</view>
      <view class="micro-course-list">
        <view class="micro-course-group" wx:for="{{activeClassroomCourseGroups}}" wx:key="id" wx:for-item="group">
          <view class="micro-course-group-title">{{group.title}}</view>
          <view class="micro-course-group-copy">{{group.copy}}</view>
          <view class="micro-course-item" wx:for="{{group.lessons}}" wx:for-item="lesson" wx:key="id" data-lesson-id="{{lesson.id}}" bindtap="selectThirdPersonLesson">
            <view class="micro-course-no">{{lesson.no}}</view>
            <view class="micro-course-main">
              <view class="micro-course-title">{{lesson.title}}</view>
              <view class="micro-course-meta">{{lesson.meta}}</view>
            </view>
            <view class="micro-course-arrow">›</view>
          </view>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="classroom-back hierarchy-back" bindtap="backToThirdPersonCourse">{{classroom.lessonBack}}</view>
      <view class="classroom-step">{{activeClassroomLesson.no}} / {{activeClassroomCourse.length}}</view>
      <view class="classroom-title">{{activeClassroomLesson.title}}</view>
      <view class="classroom-copy">{{activeClassroomLesson.meta}}</view>
      <view class="sentence-analysis-list" wx:if="{{activeClassroomLesson.analyses && activeClassroomLesson.analyses.length}}">
        <view class="sentence-analysis" wx:for="{{activeClassroomLesson.analyses}}" wx:key="index" wx:for-item="sentence" wx:for-index="sentenceIndex">
          <view class="sentence-analysis-parts">
            <view class="sentence-part role-{{part.role}}" wx:for="{{sentence}}" wx:for-item="part" wx:key="text">
              <view class="sentence-part-text">{{part.text}}</view>
              <view class="sentence-part-label">{{part.label}}</view>
            </view>
          </view>
          <view class="sentence-translation mode-{{activeClassroomLesson.exampleNotes[sentenceIndex].mode}}" wx:if="{{activeClassroomLesson.exampleNotes[sentenceIndex].visible}}">
            <view class="sentence-note-title">{{activeClassroomLesson.exampleNotes[sentenceIndex].title}}</view>
            <view class="sentence-note-body">{{activeClassroomLesson.exampleNotes[sentenceIndex].body}}</view>
            <view class="sentence-translation-tip" wx:if="{{activeClassroomLesson.exampleNotes[sentenceIndex].detail}}">{{activeClassroomLesson.exampleNotes[sentenceIndex].detail}}</view>
          </view>
        </view>
      </view>
      <view class="classroom-examples" wx:else>
        <view class="classroom-example-with-note" wx:for="{{activeClassroomLesson.examples}}" wx:key="*this" wx:for-index="exampleIndex">
          <view>{{item}}</view>
          <view class="sentence-translation mode-{{activeClassroomLesson.exampleNotes[exampleIndex].mode}}" wx:if="{{activeClassroomLesson.exampleNotes[exampleIndex].visible}}">
            <view class="sentence-note-title">{{activeClassroomLesson.exampleNotes[exampleIndex].title}}</view>
            <view class="sentence-note-body">{{activeClassroomLesson.exampleNotes[exampleIndex].body}}</view>
            <view class="sentence-translation-tip" wx:if="{{activeClassroomLesson.exampleNotes[exampleIndex].detail}}">{{activeClassroomLesson.exampleNotes[exampleIndex].detail}}</view>
          </view>
        </view>
      </view>
      <view class="classroom-notice">
        <view class="classroom-notice-label">{{classroom.coreLabel}}</view>
        <view class="classroom-rule" wx:for="{{activeClassroomLesson.rules}}" wx:key="*this">{{index + 1}}. {{item}}</view>
      </view>
      <view class="classroom-exercise-count">{{activeClassroomExerciseIndex + 1}} / {{activeClassroomLesson.questions.length}}</view>
      <view class="classroom-question">{{activeClassroomQuestion.question}}</view>
      <view class="classroom-options">
        <view class="classroom-option {{classroomAnswer && option.key === activeClassroomQuestion.answer ? 'is-correct' : ''}} {{classroomAnswer === option.key && classroomResult === 'wrong' ? 'is-wrong' : ''}}" wx:for="{{activeClassroomQuestion.options}}" wx:for-item="option" wx:key="key" data-answer="{{option.key}}" bindtap="selectClassroomAnswer">{{option.key}} · {{option.text}}</view>
      </view>
      <view class="classroom-feedback {{classroomResult}}" wx:if="{{classroomResult}}">
        <view>{{classroomResult === 'correct' ? activeClassroomQuestion.correct : activeClassroomQuestion.wrong}}</view>
        <view class="classroom-retry" wx:if="{{classroomResult === 'wrong'}}" bindtap="retryClassroomPractice">{{classroom.retry}}</view>
      </view>
      <view class="classroom-footer-actions">
        <view class="classroom-footer-button is-back" bindtap="backToThirdPersonCourse">{{classroom.returnCourse}}</view>
        <view class="classroom-footer-button is-next {{classroomResult === 'correct' ? '' : 'is-disabled'}}" bindtap="continueThirdPersonLesson">{{classroomResult === 'correct' ? (!isLastClassroomExercise ? classroom.nextExercise : (isLastClassroomLesson ? classroom.finishCourse : classroom.nextLesson)) : classroom.answerToContinue}}</view>
      </view>
    </block>
    </block>
    </block>
  </view>

  <view class="grammar-card directory-card" wx:elif="{{!selectedStageId && !selectedExamId && !selectedCategoryId && !selectedTopicId}}">
    <view class="grammar-card-top">
      <view class="grammar-card-label">{{mode === 'wrong' ? texts.wrongDifficulty : texts.difficulty}}</view>
      <view class="grammar-card-state">{{stages.length}}{{texts.groupUnit}}</view>
    </view>
    <view class="directory-map">
      <view class="directory-row map-node" wx:for="{{stages}}" wx:key="stageId" data-stage-id="{{item.stageId}}" bindtap="selectStage">
        <view class="directory-mark">
          <view class="mark-dot"></view>
          <view class="mark-branch"></view>
        </view>
        <view class="directory-content">
          <view class="directory-title">{{item.stage}}</view>
          <view class="directory-meta">{{item.count}}{{texts.questionUnit}}</view>
        </view>
        <view class="directory-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="grammar-card directory-card" wx:elif="{{selectedStageId && !selectedExamId && !selectedCategoryId && !selectedTopicId}}">
    <view class="grammar-card-top">
      <view class="grammar-card-label">{{selectedStage.stage}}</view>
      <view class="directory-back-icon hierarchy-back" bindtap="backToTopics">{{texts.backDifficulty}}</view>
    </view>
    <view class="directory-map">
      <view class="directory-row map-node" wx:for="{{exams}}" wx:key="examId" data-exam-id="{{item.examId}}" bindtap="selectExam">
        <view class="directory-mark">
          <view class="mark-dot"></view>
          <view class="mark-branch"></view>
        </view>
        <view class="directory-content">
          <view class="directory-title">{{item.exam}}</view>
          <view class="directory-meta">{{item.count}}{{texts.questionUnit}}</view>
        </view>
        <view class="directory-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="grammar-card directory-card" wx:elif="{{selectedExamId && !selectedCategoryId && !selectedTopicId}}">
    <view class="grammar-card-top">
      <view class="grammar-card-label">{{selectedStage.stage}} · {{selectedExam.exam}}</view>
      <view class="directory-back-icon hierarchy-back" bindtap="backToStageCategories">{{texts.backMock}}</view>
    </view>
    <view class="directory-map">
      <view class="directory-row map-node" wx:for="{{topics}}" wx:key="topicId" data-topic-id="{{item.topicId}}" bindtap="selectTopic">
        <view class="directory-mark">
          <view class="mark-dot"></view>
          <view class="mark-branch"></view>
        </view>
        <view class="directory-content">
          <view class="directory-title">{{item.topic}}</view>
          <view class="directory-meta">{{item.count}}{{texts.questionUnit}}</view>
        </view>
        <view class="directory-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="grammar-card directory-card" wx:elif="{{selectedCategoryId && !selectedTopicId}}">
    <view class="grammar-card-top">
      <view class="grammar-card-label">{{selectedCategory.topic}}</view>
      <view class="directory-back-icon hierarchy-back" bindtap="backToExamCategories">{{texts.backCategory}}</view>
    </view>
    <view class="directory-map">
      <view class="directory-row map-node" wx:for="{{selectedCategory.children}}" wx:key="topicId" data-topic-id="{{item.topicId}}" bindtap="selectTopic">
        <view class="directory-mark">
          <view class="mark-dot"></view>
          <view class="mark-branch"></view>
        </view>
        <view class="directory-content">
          <view class="directory-title">{{item.topic}}</view>
          <view class="directory-meta">{{item.count}}{{texts.questionUnit}}</view>
        </view>
        <view class="directory-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="grammar-card practice-card" wx:else>
    <view class="grammar-card-top">
      <view>
        <view class="grammar-card-label">{{selectedTopic.topic}}</view>
        <view class="practice-progress">{{answeredCount}} / {{selectedQuestions.length}}</view>
      </view>
      <view class="directory-back-icon hierarchy-back" bindtap="backToCategory">{{texts.backSubtopic}}</view>
    </view>
    <view class="directory-meta" wx:if="{{selectedTopicOffset > 0}}">{{texts.resumePrefix}}{{selectedTopicOffset + 1}}{{texts.resumeSuffix}}</view>
    <view class="manual-mark-toolbar" wx:if="{{selectedQuestions.length}}">
      <text>{{texts.manualMarkHint}}</text>
      <text class="manual-mark-clear" wx:if="{{grammarMarkCount}}" bindtap="clearGrammarMarks">{{texts.clearManualMarks}}</text>
    </view>
    <view class="directory-meta" wx:if="{{selectedQuestions.length === 0}}">{{texts.topicDone}}</view>
    <view class="question-list">
      <view id="grammar-question-{{index}}" class="question-row" wx:for="{{selectedQuestions}}" wx:key="_id">
        <view class="diagnostic-head">
          <view class="question-meta">{{texts.questionNo}}{{item.sequenceNumber}} · {{item.year}} · {{item.district}} · {{texts.originalNo}}{{item.number}}</view>
          <view class="diagnostic-scale">
            <view></view><view></view><view></view><view></view><view></view>
          </view>
        </view>
        <view class="question-prompt token-line {{grammarSentenceMarks[item.markScope] ? 'manual-mark-sentence' : ''}}" data-question-id="{{item._id}}" data-mark-scope="{{item.markScope}}" bindlongpress="handleGrammarSentenceMark">
          <text wx:for="{{item.promptTokens}}" wx:key="id" wx:for-item="token" class="{{item.isAnswered && token.word ? 'lookup-token' : ''}} {{grammarTokenMarks[token.markKey] ? 'manual-mark-' + grammarTokenMarks[token.markKey] : ''}}" data-question-id="{{item._id}}" data-word="{{token.word}}" data-word-index="{{token.wordIndex}}" data-mark-scope="{{item.markScope}}" catchtap="handleGrammarTokenTap">{{token.text}}</text>
        </view>
        <view class="option-grid">
          <view class="option-item {{option.selected ? 'is-selected' : ''}} {{option.correct ? 'is-correct' : ''}} {{option.wrong ? 'is-wrong' : ''}}" wx:for="{{item.optionsList}}" wx:for-item="option" wx:key="key" data-question-id="{{item._id}}" data-option="{{option.key}}" bindtap="selectOption">
            <view class="option-key">{{option.key}}</view>
            <view class="option-text">
              <block wx:if="{{!item.isAnswered}}">{{option.text}}</block>
              <block wx:else>
                <text wx:for="{{option.tokens}}" wx:key="id" wx:for-item="token" class="{{token.word ? 'lookup-token' : ''}}" data-question-id="{{item._id}}" data-word="{{token.word}}" catchtap="openDictionaryWord">{{token.text}}</text>
              </block>
            </view>
          </view>
        </view>
        <view class="answer-line {{item.isCorrect ? 'is-correct' : 'is-wrong'}}" wx:if="{{item.isAnswered}}">
          <view class="answer-summary">
            <block wx:if="{{item.answer}}">
              <text class="answer-result">{{item.isCorrect ? texts.correct : texts.wrong}}</text>
              <text class="standard-answer">{{texts.standardAnswer}}{{item.answer}}</text>
            </block>
            <text wx:else>{{texts.noAnswer}}</text>
          </view>
          <view class="answer-explain-toggle {{item.explanationExpanded ? 'is-active' : ''}}" data-question-id="{{item._id}}" bindtap="toggleExplanation">{{item.explanationExpanded ? texts.collapseExplain : texts.explain}}</view>
        </view>
        <view class="grammar-explain-error" wx:if="{{item.explanationExpanded && item.explanationError}}">{{item.explanationError}}</view>
        <view class="analysis-item inline-analysis" wx:if="{{item.explanationExpanded && item.explanation}}">
          <view class="analysis-head">
            <text>{{item.explanation.topic}}</text>
            <text class="analysis-state is-correct">{{texts.answer}}{{item.explanation.answer}}</text>
          </view>
          <view class="analysis-text is-primary">{{item.explanation.explanation}}</view>
          <view class="analysis-text is-support" wx:if="{{item.explanation.elimination}}">{{item.explanation.elimination}}</view>
          <view class="grammar-explain-actions">
            <view class="grammar-explain-action" data-question-id="{{item._id}}" bindtap="regenerateExplanation">{{texts.explainAgain}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="dictionary-mask" wx:if="{{dictionaryVisible}}" catchtap="closeDictionary"></view>
  <view class="dictionary-sheet" wx:if="{{dictionaryVisible}}">
    <view class="dictionary-head">
      <view>
        <view class="dictionary-word">{{dictionaryEntry.word || dictionaryWord}}</view>
        <view class="dictionary-phonetic" wx:if="{{dictionaryEntry.phonetic}}">/{{dictionaryEntry.phonetic}}/</view>
      </view>
      <button class="dictionary-audio {{dictionaryAudioLoading ? 'is-loading' : ''}}" disabled="{{dictionaryLoading || dictionaryAudioLoading}}" bindtap="playDictionaryWord">♪</button>
    </view>
    <button class="dictionary-add" loading="{{dictionaryAdding}}" bindtap="addDictionaryWordToLibrary">{{texts.addLibrary}}</button>
    <block wx:if="{{!dictionaryLoading}}">
      <view class="dictionary-definition" wx:for="{{dictionaryEntry.definitions}}" wx:key="*this">· {{item}}</view>
      <view class="dictionary-empty" wx:if="{{!dictionaryEntry.definitions || !dictionaryEntry.definitions.length}}">{{texts.noDefinition}}</view>
    </block>
  </view>
  </block>
</view>
