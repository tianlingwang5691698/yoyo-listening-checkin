<view class="theme-{{theme}} page-shell completed-page">
  <view class="completed-header">
    <view class="type-page-title">今日完成</view>
    <view class="type-caption completed-subtitle">{{items.length}} 项已完成</view>
  </view>

  <view class="completed-list" wx:if="{{items.length}}">
    <view class="completed-card card" wx:for="{{items}}" wx:key="index">
      <view class="completed-row-main" data-index="{{index}}" bindtap="openItem">
        <view class="completed-index">{{item.index}}</view>
        <view class="completed-main">
          <view class="completed-title">{{item.title}}</view>
          <view class="completed-meta">{{item.typeLabel}} · {{item.meta}}</view>
          <view class="completed-copy" wx:if="{{item.type === 'reading' && item.latestAttempt}}">
            得分 {{item.latestAttempt.score || 0}} / {{item.latestAttempt.totalScore || (item.latestAttempt.totalCount * 2) || 0}} 分
          </view>
          <view class="completed-copy" wx:elif="{{item.type === 'speaking' && item.attemptCount}}">
            最近 {{item.latestAttemptScore}} 分 · {{item.attemptCount}} 次回答
          </view>
          <view class="completed-copy" wx:elif="{{item.progressText}}">{{item.progressText}}</view>
        </view>
        <view class="completed-action">{{item.actionText}}</view>
      </view>

      <view class="attempt-detail-list" wx:if="{{item.expanded}}">
        <view class="attempt-detail" wx:for="{{item.attempts}}" wx:key="attemptId" wx:for-item="attempt" wx:for-index="attemptIndex">
          <view class="attempt-head">
            <view class="attempt-title">{{attempt.displayTitle}}</view>
            <view class="attempt-score">{{attempt.scoreText}}</view>
          </view>
          <view class="attempt-subscore">发音流畅 {{attempt.pronunciationFluencyScore || 0}} / 内容语法 {{attempt.contentGrammarScore || 0}}</view>
          <view class="attempt-text" wx:if="{{attempt.questionText}}">问题：{{attempt.questionText}}</view>
          <view class="attempt-text" wx:if="{{attempt.studentTranscript}}">回答：{{attempt.studentTranscript}}</view>
          <view class="attempt-feedback">{{attempt.feedback || '暂无分析'}}</view>
          <view class="attempt-actions">
            <button class="attempt-button" data-item-index="{{index}}" data-attempt-index="{{attemptIndex}}" data-audio-type="answer" bindtap="playAttempt">播放回答</button>
            <button class="attempt-button" wx:if="{{attempt.feedbackAudioFileId}}" data-item-index="{{index}}" data-attempt-index="{{attemptIndex}}" data-audio-type="feedback" bindtap="playAttempt">播放分析</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>今天还没有完成记录。</view>

  <view class="debug-card" wx:if="{{debugLines.length}}">
    <view class="debug-title">调试断点</view>
    <view class="debug-line" wx:for="{{debugLines}}" wx:key="*this">{{item}}</view>
  </view>
</view>
