<block wx:if="{{theme === 'library'}}">
  <view class="theme-{{theme}} page-shell completed-page library-return-page language-{{language}}">
    <view class="library-return-header">
      <view>
        <view class="library-return-kicker">{{texts.returnKicker}}</view>
        <view class="library-return-title">{{texts.completedTitle}}</view>
        <view class="library-return-copy">{{items.length}} {{texts.completedSuffix}}</view>
      </view>
      <view class="library-return-seal">
        <view>{{items.length}}</view>
        <text>{{texts.itemUnit}}</text>
      </view>
    </view>

    <view class="library-return-list" wx:if="{{items.length}}">
      <view class="library-return-slip" wx:for="{{items}}" wx:key="index">
        <view class="library-return-row" data-index="{{index}}" bindtap="openItem">
          <view class="library-return-index">{{item.index}}</view>
          <view class="library-return-main">
            <view class="library-return-type">{{item.typeLabel}}</view>
            <view class="library-return-item-title">{{item.title}}</view>
            <view class="library-return-meta">{{item.meta}}</view>
            <view class="library-return-meta" wx:if="{{item.type === 'reading' && item.latestAttempt}}">
              {{texts.score}} {{item.latestAttempt.score || 0}} / {{item.latestAttempt.totalScore || (item.latestAttempt.totalCount * 2) || 0}} {{texts.points}}
            </view>
            <view class="library-return-meta" wx:elif="{{item.type === 'speaking' && item.attemptCount}}">
              {{texts.latest}} {{item.latestAttemptScore}} {{texts.points}} · {{item.attemptCount}} {{texts.attempts}}
            </view>
            <view class="library-return-meta" wx:elif="{{item.progressText}}">{{item.progressText}}</view>
          </view>
          <view class="library-return-action">{{item.actionText}}</view>
        </view>

        <view class="library-return-attempts" wx:if="{{item.expanded}}">
          <view class="library-return-attempt" wx:for="{{item.attempts}}" wx:key="attemptId" wx:for-item="attempt" wx:for-index="attemptIndex">
            <view class="library-return-attempt-head">
              <view>{{attempt.displayTitle}}</view>
              <text>{{attempt.scoreText}}</text>
            </view>
            <view class="library-return-attempt-copy">{{texts.pronunciationFluency}} {{attempt.pronunciationFluencyScore || 0}} / {{texts.contentGrammar}} {{attempt.contentGrammarScore || 0}}</view>
            <view class="library-return-attempt-copy" wx:if="{{attempt.questionText}}">{{texts.questionPrefix}}{{attempt.questionText}}</view>
            <view class="library-return-attempt-copy" wx:if="{{attempt.studentTranscript}}">{{texts.answerPrefix}}{{attempt.studentTranscript}}</view>
            <view class="library-return-attempt-feedback">{{attempt.feedback || texts.noAnalysis}}</view>
            <view class="library-return-attempt-actions">
              <button data-item-index="{{index}}" data-attempt-index="{{attemptIndex}}" data-audio-type="answer" bindtap="playAttempt">{{texts.playAnswer}}</button>
              <button wx:if="{{attempt.feedbackAudioFileId}}" data-item-index="{{index}}" data-attempt-index="{{attemptIndex}}" data-audio-type="feedback" bindtap="playAttempt">{{texts.playAnalysis}}</button>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="library-return-empty" wx:else>{{texts.empty}}</view>

    <view class="library-return-debug" wx:if="{{showCloudDebug && debugLines.length}}">
      <view class="library-return-debug-title">{{texts.debugTitle}}</view>
      <view class="library-return-debug-line" wx:for="{{debugLines}}" wx:key="*this">{{item}}</view>
    </view>
  </view>
</block>

<block wx:else>
<view class="theme-{{theme}} page-shell completed-page language-{{language}}">
  <view class="completed-hero">
    <view class="voyage-medal" wx:if="{{theme === 'voyage'}}">★</view>
    <view class="completed-hero-glow"></view>
    <view class="completed-header">
      <view>
        <view class="type-page-title">{{texts.completedTitle}}</view>
        <view class="type-caption completed-subtitle">{{items.length}} {{texts.completedSuffix}}</view>
      </view>
      <view class="completed-count">
        <view>{{items.length}}</view>
        <text>{{texts.itemUnit}}</text>
      </view>
    </view>
    <view class="completed-wave">
      <view></view>
      <view></view>
      <view></view>
      <view></view>
      <view></view>
      <view></view>
      <view></view>
    </view>
  </view>

  <view class="completed-gallery" wx:if="{{items.length}}">
    <view class="completed-card card" wx:for="{{items}}" wx:key="index">
      <view class="completed-row-main" data-index="{{index}}" bindtap="openItem">
        <view class="completed-index">
          <view>{{item.index}}</view>
        </view>
        <view class="completed-main">
          <view class="completed-type">{{item.typeLabel}}</view>
          <view class="completed-title">{{item.title}}</view>
          <view class="completed-meta">{{item.meta}}</view>
          <view class="completed-copy" wx:if="{{item.type === 'reading' && item.latestAttempt}}">
            {{texts.score}} {{item.latestAttempt.score || 0}} / {{item.latestAttempt.totalScore || (item.latestAttempt.totalCount * 2) || 0}} {{texts.points}}
          </view>
          <view class="completed-copy" wx:elif="{{item.type === 'speaking' && item.attemptCount}}">
            {{texts.latest}} {{item.latestAttemptScore}} {{texts.points}} · {{item.attemptCount}} {{texts.attempts}}
          </view>
          <view class="completed-copy" wx:elif="{{item.progressText}}">{{item.progressText}}</view>
        </view>
        <view class="completed-action">{{item.actionText}}</view>
      </view>

      <view class="attempt-detail-list" wx:if="{{item.expanded}}">
        <view class="attempt-detail" wx:for="{{item.attempts}}" wx:key="attemptId" wx:for-item="attempt" wx:for-index="attemptIndex">
          <view class="attempt-head">
            <view class="attempt-title">{{attempt.displayTitle}}</view>
            <view class="attempt-score">{{attempt.scoreText}}</view>
          </view>
          <view class="attempt-subscore">{{texts.pronunciationFluency}} {{attempt.pronunciationFluencyScore || 0}} / {{texts.contentGrammar}} {{attempt.contentGrammarScore || 0}}</view>
          <view class="attempt-text" wx:if="{{attempt.questionText}}">{{texts.questionPrefix}}{{attempt.questionText}}</view>
          <view class="attempt-text" wx:if="{{attempt.studentTranscript}}">{{texts.answerPrefix}}{{attempt.studentTranscript}}</view>
          <view class="attempt-feedback">{{attempt.feedback || texts.noAnalysis}}</view>
          <view class="attempt-actions">
            <button class="attempt-button" data-item-index="{{index}}" data-attempt-index="{{attemptIndex}}" data-audio-type="answer" bindtap="playAttempt">{{texts.playAnswer}}</button>
            <button class="attempt-button" wx:if="{{attempt.feedbackAudioFileId}}" data-item-index="{{index}}" data-attempt-index="{{attemptIndex}}" data-audio-type="feedback" bindtap="playAttempt">{{texts.playAnalysis}}</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>{{texts.empty}}</view>

  <view class="debug-card" wx:if="{{showCloudDebug && debugLines.length}}">
    <view class="debug-title">{{texts.debugTitle}}</view>
    <view class="debug-line" wx:for="{{debugLines}}" wx:key="*this">{{item}}</view>
  </view>
</view>
</block>
