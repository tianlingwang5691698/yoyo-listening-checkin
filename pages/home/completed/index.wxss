.completed-page {
  --bg-cream: #f6fbfd;
  --surface-raised: rgba(255, 255, 255, 0.84);
  --surface-glass: rgba(255, 255, 255, 0.56);
  --surface-subtle: rgba(229, 241, 248, 0.72);
  --control-muted-bg: rgba(141, 183, 212, 0.18);
  --text-main: #17314f;
  --text-strong: #17314f;
  --text-muted: #607087;
  --text-soft: #728196;
  --accent: #df7f68;
  --accent-deep: #df7f68;
  --accent-soft: rgba(242, 161, 142, 0.16);
  --border-soft: rgba(255, 255, 255, 0.86);
  --shadow-card: 0 22rpx 52rpx rgba(78, 112, 139, 0.14);
  padding-top: 34rpx;
  background:
    radial-gradient(circle at 18% 0%, rgba(191, 215, 232, 0.56), rgba(246, 251, 253, 0) 42%),
    linear-gradient(180deg, #f6fbfd 0%, #edf6fa 100%);
}

.completed-hero {
  position: relative;
  min-height: 286rpx;
  padding: 34rpx 34rpx 30rpx;
  border-radius: 44rpx;
  overflow: hidden;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.82), rgba(219, 233, 242, 0.48) 58%, rgba(255, 255, 255, 0.7)),
    rgba(231, 241, 248, 0.68);
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: var(--shadow-card);
  backdrop-filter: blur(18rpx);
}

.completed-hero::before {
  content: "";
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 22rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0));
}

.completed-hero-glow {
  position: absolute;
  right: -42rpx;
  top: -44rpx;
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  box-shadow: 0 0 72rpx rgba(191, 215, 232, 0.56);
}

.completed-header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.completed-subtitle {
  margin-top: 12rpx;
  color: #607087;
}

.completed-count {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.46);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.96), 0 14rpx 30rpx rgba(82, 115, 143, 0.1);
}

.completed-count view {
  color: #17314f;
  font-size: 46rpx;
  line-height: 1;
  font-weight: 600;
}

.completed-count text {
  margin-top: 6rpx;
  color: #728196;
  font-size: 20rpx;
}

.completed-wave {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: 30rpx;
  height: 84rpx;
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  opacity: 0.72;
}

.completed-wave view {
  flex: 1;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(141, 183, 212, 0.38));
}

.completed-wave view:nth-child(1) { height: 28rpx; }
.completed-wave view:nth-child(2) { height: 56rpx; }
.completed-wave view:nth-child(3) { height: 40rpx; }
.completed-wave view:nth-child(4) { height: 76rpx; }
.completed-wave view:nth-child(5) { height: 48rpx; }
.completed-wave view:nth-child(6) { height: 64rpx; }
.completed-wave view:nth-child(7) { height: 34rpx; }

.completed-gallery {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 4rpx 2rpx 18rpx;
}

.completed-gallery::-webkit-scrollbar {
  display: none;
}

.completed-card {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  min-height: 250rpx;
  padding: 26rpx;
  overflow: hidden;
  background:
    linear-gradient(158deg, rgba(255, 255, 255, 0.92), rgba(238, 247, 251, 0.74)),
    rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 34rpx;
  box-shadow: 0 18rpx 44rpx rgba(78, 112, 139, 0.12);
  backdrop-filter: blur(16rpx);
}

.completed-card::after {
  content: "";
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: -18rpx;
  height: 66rpx;
  background: repeating-linear-gradient(170deg, rgba(141, 183, 212, 0.16) 0 4rpx, rgba(141, 183, 212, 0) 4rpx 16rpx);
}

.completed-row-main {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 70rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 20rpx;
}

.completed-index {
  position: relative;
  width: 70rpx;
  height: 120rpx;
  display: flex;
  justify-content: center;
}

.completed-index::before {
  content: "";
  position: absolute;
  top: 12rpx;
  bottom: 0;
  width: 2rpx;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.42);
}

.completed-index view {
  position: relative;
  z-index: 1;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f2a18e 0%, #df7f68 100%);
  color: #fffafa;
  font-size: 24rpx;
  line-height: 54rpx;
  text-align: center;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(214, 119, 98, 0.24);
}

.completed-main {
  min-width: 0;
}

.completed-type {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(134, 170, 161, 0.14);
  color: #607087;
  font-size: 21rpx;
  line-height: 1;
}

.completed-title {
  margin-top: 14rpx;
  color: #17314f;
  font-size: 31rpx;
  line-height: 1.36;
  font-weight: 600;
  word-break: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.completed-meta,
.completed-copy {
  margin-top: 8rpx;
  color: #607087;
  font-size: 24rpx;
  line-height: 1.4;
}

.completed-action {
  flex-shrink: 0;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(231, 238, 244, 0.86);
  color: #264160;
  font-size: 24rpx;
  font-weight: 600;
}

.attempt-detail-list {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.attempt-detail {
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
}

.attempt-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.attempt-title,
.attempt-score {
  color: #17314f;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 600;
}

.attempt-score {
  color: #df7f68;
  white-space: nowrap;
}

.attempt-subscore,
.attempt-text,
.attempt-feedback {
  margin-top: 10rpx;
  color: #607087;
  font-size: 24rpx;
  line-height: 1.5;
}

.attempt-text,
.attempt-feedback {
  color: #17314f;
}

.attempt-actions {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.attempt-button {
  margin: 0;
  min-width: 160rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: rgba(231, 238, 244, 0.9);
  color: #264160;
  font-size: 24rpx;
  line-height: 54rpx;
  font-weight: 600;
}

.attempt-button::after {
  border: 0;
}

.debug-card {
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  color: #607087;
  font-size: 22rpx;
  line-height: 1.5;
}

.debug-title {
  margin-bottom: 10rpx;
  color: #17314f;
  font-weight: 600;
}

.debug-line {
  margin-top: 8rpx;
  word-break: break-all;
}
.theme-library.completed-page {
  --lib-return-wood: #2b211b;
  --lib-return-ink: #14283a;
  --lib-return-paper: #faf5ea;
  --lib-return-paper-muted: #f3e8d4;
  --lib-return-brass: #b89562;
  --lib-return-moss: #7f8c78;
  --lib-return-muted: #6f675f;
  --lib-return-error: #9a5e52;
  --lib-return-rule: rgba(184, 149, 98, 0.42);
  position: relative;
  min-height: 100vh;
  padding-top: 56rpx;
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 78% 8%, rgba(210, 170, 108, 0.22), transparent 26%),
    linear-gradient(180deg, #211712 0, #432e21 300rpx, #ead8b8 610rpx, #faf5ea 100%);
  color: var(--lib-return-wood);
}

.library-return-header,
.library-return-slip,
.library-return-empty,
.library-return-debug {
  position: relative;
  z-index: 1;
  border: 1rpx solid var(--lib-return-rule);
  border-radius: 8rpx;
  box-shadow: 0 4rpx 18rpx rgba(43, 33, 27, 0.16);
}

.library-return-header {
  min-height: 258rpx;
  padding: 38rpx 32rpx 34rpx 54rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  background:
    linear-gradient(90deg, rgba(74, 48, 31, 0.96) 0 22rpx, transparent 22rpx),
    linear-gradient(135deg, var(--lib-return-paper-muted), var(--lib-return-paper) 62%, #ead8b8);
  overflow: hidden;
}

.library-return-header::after {
  content: "";
  position: absolute;
  left: 54rpx;
  right: 32rpx;
  bottom: 32rpx;
  height: 1rpx;
  background: repeating-linear-gradient(90deg, var(--lib-return-rule) 0 18rpx, transparent 18rpx 30rpx);
}

.library-return-kicker,
.library-return-copy,
.library-return-meta,
.library-return-attempt-copy,
.library-return-attempt-feedback {
  color: var(--lib-return-muted);
}

.library-return-kicker {
  font-size: 22rpx;
  font-weight: 700;
}

.library-return-title {
  margin-top: 12rpx;
  color: var(--lib-return-ink);
  font-family: Georgia, "Times New Roman", "Songti SC", "SimSun", serif;
  font-size: 50rpx;
  line-height: 1.12;
  font-weight: 700;
}

.library-return-copy {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

.library-return-seal {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  border: 3rpx double var(--lib-return-brass);
  border-radius: 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--lib-return-brass);
  transform: rotate(-4deg);
}

.library-return-seal view {
  font-size: 42rpx;
  line-height: 1;
  font-weight: 700;
}

.library-return-seal text {
  margin-top: 8rpx;
  font-size: 20rpx;
}

.library-return-list {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.library-return-slip {
  background:
    linear-gradient(90deg, rgba(184, 149, 98, 0.18) 0 18rpx, transparent 18rpx),
    var(--lib-return-paper);
  overflow: hidden;
}

.library-return-row {
  min-height: 144rpx;
  padding: 24rpx 22rpx 24rpx 42rpx;
  display: grid;
  grid-template-columns: 54rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 18rpx;
}

.library-return-index {
  width: 52rpx;
  height: 52rpx;
  border: 1rpx solid var(--lib-return-rule);
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--lib-return-brass);
  font-size: 22rpx;
  font-weight: 700;
}

.library-return-main {
  min-width: 0;
}

.library-return-type {
  display: inline-flex;
  padding: 7rpx 12rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.3);
  border-radius: 4rpx;
  background: var(--lib-return-paper-muted);
  color: var(--lib-return-muted);
  font-size: 20rpx;
  line-height: 1;
  font-weight: 700;
}

.library-return-item-title {
  margin-top: 12rpx;
  color: var(--lib-return-ink);
  font-size: 30rpx;
  line-height: 1.34;
  font-weight: 700;
  word-break: break-word;
}

.library-return-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.42;
  word-break: break-word;
}

.library-return-action {
  flex-shrink: 0;
  min-width: 86rpx;
  padding: 11rpx 15rpx;
  border: 1rpx solid var(--lib-return-rule);
  border-radius: 6rpx;
  background: var(--lib-return-paper-muted);
  color: var(--lib-return-ink);
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
  text-align: center;
}

.library-return-attempts {
  padding: 0 20rpx 20rpx 42rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.library-return-attempt {
  padding: 18rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.28);
  border-radius: 6rpx;
  background: var(--lib-return-paper-muted);
}

.library-return-attempt-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.library-return-attempt-head view,
.library-return-attempt-head text {
  color: var(--lib-return-ink);
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 700;
}

.library-return-attempt-head text {
  color: var(--lib-return-brass);
  white-space: nowrap;
}

.library-return-attempt-copy,
.library-return-attempt-feedback {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.5;
}

.library-return-attempt-feedback {
  color: var(--lib-return-ink);
}

.library-return-attempt-actions {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.library-return-attempt-actions button {
  margin: 0;
  min-width: 150rpx;
  height: 54rpx;
  border-radius: 6rpx;
  background: var(--lib-return-ink);
  color: var(--lib-return-paper);
  font-size: 23rpx;
  line-height: 54rpx;
  font-weight: 700;
}

.library-return-attempt-actions button::after {
  border: 0;
}

.library-return-empty {
  margin-top: 26rpx;
  padding: 42rpx 28rpx;
  background: var(--lib-return-paper);
  color: var(--lib-return-muted);
  font-size: 24rpx;
  text-align: center;
}

.library-return-debug {
  margin-top: 24rpx;
  padding: 24rpx 26rpx 24rpx 46rpx;
  background:
    linear-gradient(90deg, rgba(154, 94, 82, 0.18) 0 18rpx, transparent 18rpx),
    var(--lib-return-paper);
  border-color: rgba(154, 94, 82, 0.42);
}

.library-return-debug-title {
  color: var(--lib-return-error);
  font-size: 24rpx;
  font-weight: 700;
}

.library-return-debug-line {
  margin-top: 10rpx;
  color: var(--lib-return-error);
  font-size: 21rpx;
  line-height: 1.5;
  word-break: break-all;
}
