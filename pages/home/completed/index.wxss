.completed-page {
  padding-top: 52rpx;
}

.completed-header {
  padding: 20rpx 20rpx 28rpx;
}

.completed-subtitle {
  margin-top: 10rpx;
}

.completed-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.completed-card {
  padding: 24rpx 24rpx;
  display: block;
  background: rgba(255, 254, 252, 0.98);
  border: 1rpx solid rgba(45, 38, 31, 0.05);
  box-shadow: 0 10rpx 24rpx rgba(44, 33, 23, 0.05);
}

.completed-row-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.completed-card:active {
  opacity: 0.72;
}

.completed-index {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 24rpx;
  line-height: 52rpx;
  text-align: center;
  font-weight: 800;
}

.completed-main {
  min-width: 0;
  flex: 1;
}

.completed-title {
  color: var(--text-strong);
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 800;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.completed-meta,
.completed-copy {
  margin-top: 6rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.35;
}

.completed-action {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.attempt-detail-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.attempt-detail {
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 247, 241, 0.9);
}

.attempt-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.attempt-title,
.attempt-score {
  color: var(--text-strong);
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 800;
}

.attempt-score {
  color: var(--accent-deep);
  white-space: nowrap;
}

.attempt-subscore,
.attempt-text,
.attempt-feedback {
  margin-top: 10rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.attempt-text,
.attempt-feedback {
  color: var(--text-strong);
}

.attempt-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}

.attempt-button {
  margin: 0;
  min-width: 160rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: var(--accent-deep);
  font-size: 24rpx;
  line-height: 54rpx;
  font-weight: 800;
}

.attempt-button::after {
  border: 0;
}

.debug-card {
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: rgba(45, 38, 31, 0.08);
  color: var(--text-main);
  font-size: 22rpx;
  line-height: 1.5;
}

.debug-title {
  margin-bottom: 10rpx;
  color: var(--text-strong);
  font-weight: 800;
}

.debug-line {
  margin-top: 8rpx;
  word-break: break-all;
}
