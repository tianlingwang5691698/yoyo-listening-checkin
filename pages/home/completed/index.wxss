.completed-page {
  padding-top: 52rpx;
}

.completed-header {
  padding: 20rpx 20rpx 28rpx;
}

.completed-subtitle {
  margin-top: 10rpx;
}

.completed-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.completed-card {
  padding: 24rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: rgba(255, 254, 252, 0.98);
  border: 1rpx solid rgba(45, 38, 31, 0.05);
  box-shadow: 0 10rpx 24rpx rgba(44, 33, 23, 0.05);
}

.completed-card:active {
  opacity: 0.72;
}

.completed-index {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 24rpx;
  line-height: 52rpx;
  text-align: center;
  font-weight: 800;
}

.completed-main {
  min-width: 0;
  flex: 1;
}

.completed-title {
  color: var(--text-strong);
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 800;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.completed-meta,
.completed-copy {
  margin-top: 6rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.35;
}

.completed-action {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: 24rpx;
  font-weight: 800;
}
