<view wx:if="{{theme === 'library'}}" class="theme-library page-shell library-home-page language-{{language}}">
  <image class="library-home-background" src="../../assets/library/library-home-user-bg.jpg" mode="widthFix" />
  <view class="library-home-header" style="{{homeNavStyle}}">
    <view>
      <view class="library-home-greeting">{{greeting}}{{texts.greetingSeparator}}{{child.nickname || texts.classmate}}</view>
      <view class="library-home-date">{{todayDisplay}} · {{planDayText}}</view>
    </view>
  </view>

  <view class="library-status-slip" wx:if="{{!homeLoading && syncMode === 'cloud-error'}}">
    <view>{{texts.syncUnavailableTitle}}</view>
    <text>{{(syncDebug && (syncDebug.publicReason || syncDebug.reason)) || texts.syncUnavailableDescription}}</text>
  </view>

  <view class="library-nickname-sheet" wx:if="{{nicknameRequired && !identityConfirmVisible && !entryPosterVisible}}">
    <view class="library-sheet-title">{{texts.nicknameRequiredTitle}}</view>
    <view class="library-sheet-copy">{{texts.nicknameRequiredDescription}}</view>
    <view class="library-sheet-edit">
      <input class="library-nickname-input" placeholder="{{texts.nicknamePlaceholder}}" value="{{nicknameInput}}" bindinput="handleNicknameInput" />
      <view class="library-sheet-save" bindtap="saveRequiredNickname">{{texts.save}}</view>
    </view>
  </view>

  <view class="library-listening-sheet {{homeDataReady ? (listeningTaskStatus.setupRequired ? 'is-empty' : '') : 'is-data-pending'}}" bindtap="openCompleted">
    <view class="library-listening-copy">
      <view class="library-listening-title">{{texts.todayListening}}</view>
      <view class="library-listening-lead">{{texts.listeningLead}}</view>
      <view class="library-listening-action" wx:if="{{homeDataReady}}">{{listeningTaskStatus.action}} <text>›</text></view>
      <view class="library-listening-action home-data-skeleton" wx:else></view>
    </view>
    <view class="library-timeline">
      <view class="library-timeline-line"></view>
      <view class="library-timeline-entry">
        <view class="library-timeline-copy">Stillness makes room for every sound.</view>
        <view class="library-timeline-time">00:18</view>
      </view>
      <view class="library-timeline-entry">
        <view class="library-timeline-copy">Listen closely; meaning follows.</view>
        <view class="library-timeline-time">00:32</view>
      </view>
      <view class="library-timeline-entry">
        <view class="library-timeline-copy">A quiet mind hears more.</view>
        <view class="library-timeline-time">00:48</view>
      </view>
    </view>
    <view class="library-listening-goal">
      <view>
        <block wx:if="{{homeDataReady}}">
          <view class="library-goal-label">{{listeningTaskStatus.setupRequired ? texts.planStatus : texts.todayGoal}}</view>
          <view wx:if="{{listeningTaskStatus.setupRequired}}" class="library-goal-value">{{texts.pendingSetup}}</view>
          <view wx:else class="library-goal-value">{{todayDoneMinutes}}<text> / {{todayGoalMinutes}} {{texts.minute}}</text></view>
        </block>
        <view class="home-goal-skeleton" wx:else></view>
      </view>
      <view class="library-goal-ring {{homeDataReady && listeningTaskStatus.setupRequired ? 'is-setup' : ''}} {{homeDataReady ? '' : 'is-pending'}}" style="{{homeDataReady && !listeningTaskStatus.setupRequired ? libraryProgressStyle : ''}}"></view>
    </view>
  </view>
  <view class="library-desk-reveal"></view>
  <view class="library-module-grid">
    <view class="library-module-tile tile-listening" bindtap="openListening"><view class="library-tile-icon icon-listening"><view></view></view><view>{{texts.listening}}</view></view>
    <view class="library-module-tile tile-reading" bindtap="openReading"><view class="library-tile-icon icon-reading"><view></view></view><view>{{texts.reading}}</view></view>
    <view class="library-module-tile tile-grammar" bindtap="openGrammar"><view class="library-tile-icon icon-grammar">A<text>≡</text></view><view>{{texts.grammar}}</view></view>
    <view class="library-module-tile tile-vocabulary" bindtap="openVocabulary"><view class="library-tile-icon icon-vocabulary">W</view><view>{{texts.vocabulary}}</view></view>
    <view class="library-module-tile tile-writing" bindtap="openWriting"><view class="library-tile-icon icon-writing"><view></view></view><view>{{texts.writing}}</view></view>
    <view class="library-module-tile tile-speaking" bindtap="openSpeaking"><view class="library-tile-icon icon-speaking"><view></view></view><view>{{texts.speaking}}</view></view>
  </view>

  <view class="library-empty-note" wx:if="{{!homeLoading && !hasGroupedTasks && syncMode !== 'cloud-error'}}">{{needsListeningPlanSetup ? texts.setupPlanFirst : texts.noTasksToday}}</view>

  <view class="library-identity-overlay is-page-{{entryPosterPage}}" wx:if="{{entryPosterVisible}}">
    <view class="library-poster-frame"></view>
    <view class="library-poster-topline">
      <view class="library-poster-spine">YOYO LISTENING ARCHIVE <text>· {{texts.posterBrandTag}}</text></view>
      <view class="library-poster-skip" bindtap="closeEntryPoster">{{texts.posterSkip}}</view>
    </view>
    <block wx:if="{{entryPosterPage === 0}}">
      <view class="library-poster-folio">VOLUME 01 <text>LISTENING FIRST</text></view>
      <view class="library-poster-hero">
        <view class="library-poster-eyebrow">THE QUIET BEGINNING</view>
        <view class="library-poster-title"><text class="library-poster-title-line">{{texts.posterPhilosophyTitle1}}</text><text class="library-poster-title-line">{{texts.posterPhilosophyTitle2}}</text></view>
        <view class="library-poster-copy">{{texts.posterPhilosophyCopy}}</view>
      </view>
      <view class="library-poster-seal">
        <view class="library-poster-seal-core">
          <view class="library-poster-wave"><text></text><text></text><text></text><text></text><text></text><text></text><text></text></view>
        </view>
        <view class="library-poster-needle"></view>
        <view class="library-poster-seal-caption">LISTEN · NOTICE · UNDERSTAND</view>
      </view>
      <view class="library-poster-note"><text>DAILY RITUAL</text><view>{{texts.posterDailyRitualCopy}}</view></view>
    </block>
    <block wx:else>
      <view class="library-poster-folio">VOLUME 02 <text>MEMBER ENTRY</text></view>
      <view class="library-poster-hero is-guide">
        <view class="library-poster-eyebrow">PRIVATE READING ROOM</view>
        <view class="library-poster-title is-guide"><text class="library-poster-title-line">{{texts.posterIdentityTitle1}}</text><text class="library-poster-title-line">{{texts.posterIdentityTitle2}}</text></view>
        <view class="library-poster-copy">{{texts.posterIdentityCopy}}</view>
        <view class="library-poster-credit"><text>{{texts.posterCreditLabel}}</text><view>{{texts.posterCreditName}}</view></view>
      </view>
      <view class="library-poster-membership">
        <view class="library-poster-membership-mark"><text>EX</text><text>LIBRIS</text></view>
        <view><text>MEMBERSHIP</text><view>{{texts.posterMembershipCopy}}</view></view>
      </view>
    </block>
    <view class="library-poster-dots"><view class="{{entryPosterPage === 0 ? 'is-active' : ''}}"></view><view class="{{entryPosterPage === 1 ? 'is-active' : ''}}"></view></view>
    <view class="library-poster-next" wx:if="{{entryPosterPage === 0}}" bindtap="showNextEntryPosterPage"><text>{{texts.posterContinue}}</text><text>→</text></view>
    <view class="library-poster-actions" wx:else>
      <button data-role="parent" bindtap="confirmStudyIdentity"><text class="library-role-index">01</text><view><text class="library-role-title">{{texts.identityIAmParent}}</text><text class="library-role-copy">{{texts.posterParentRoleCopy}}</text></view><text class="library-role-arrow">→</text></button>
      <button class="is-primary" data-role="student" bindtap="confirmStudyIdentity"><text class="library-role-index">02</text><view><text class="library-role-title">{{texts.identityIAmStudent}}</text><text class="library-role-copy">{{texts.posterStudentRoleCopy}}</text></view><text class="library-role-arrow">→</text></button>
    </view>
  </view>

  <view class="library-mode-sheet" wx:if="{{identityConfirmVisible && !entryPosterVisible}}">
    <view>{{texts.identityDevicePrompt}}</view>
    <view><button data-role="parent" bindtap="confirmStudyIdentity">{{texts.identityIAmParent}}</button><button class="is-primary" data-role="student" bindtap="confirmStudyIdentity">{{texts.identityIAmStudent}}</button></view>
  </view>
</view>

<view wx:else class="theme-{{theme}} page-shell home-page language-{{language}}">
  <view class="home-atmosphere">
    <view class="light-ray ray-one"></view>
    <view class="light-ray ray-two"></view>
    <view class="plant-line plant-one"></view>
    <view class="plant-line plant-two"></view>
  </view>

  <view class="home-titlebar" style="{{homeNavStyle}}">
    <view class="home-heading">
      <view class="home-brand type-brand">{{greeting}}{{texts.greetingSeparator}}{{child.nickname || texts.classmate}}</view>
      <view class="home-subtitle type-caption">
        <view class="calendar-mark"></view>
        <text>{{todayDisplay}} · Day {{checkinDayCount}}</text>
      </view>
    </view>
  </view>

  <view class="section-panel" wx:if="{{!homeLoading && syncMode === 'cloud-error'}}">
    <view class="section-title">{{texts.syncUnavailableTitle}}</view>
    <view class="section-copy">{{(syncDebug && (syncDebug.publicReason || syncDebug.reason)) || texts.syncUnavailableDescription}}</view>
  </view>

  <view class="mode-notice" wx:if="{{modeChangedNoticeVisible}}">
    {{texts.parentModeRestored}}
  </view>

  <view class="nickname-required section-panel" wx:if="{{nicknameRequired && !identityConfirmVisible && !entryPosterVisible}}">
    <view class="section-title type-section-title">{{texts.nicknameRequiredTitle}}</view>
    <view class="section-copy">{{texts.nicknameRequiredDescription}}</view>
    <view class="nickname-edit-row">
      <input class="nickname-input" placeholder="{{texts.nicknameExample}}" value="{{nicknameInput}}" bindinput="handleNicknameInput" />
      <view class="nickname-save" bindtap="saveRequiredNickname">{{texts.save}}</view>
    </view>
  </view>

  <view class="mode-reminder" wx:if="{{identityConfirmVisible}}">
    <view class="mode-reminder-copy">{{texts.identityDevicePrompt}}</view>
    <view class="mode-reminder-actions">
      <button class="mode-reminder-action" data-role="parent" bindtap="confirmStudyIdentity">{{texts.identityIAmParent}}</button>
      <button class="mode-reminder-action is-primary" data-role="student" bindtap="confirmStudyIdentity">{{texts.identityIAmStudent}}</button>
    </view>
  </view>

  <view class="daily-listening-card {{homeDataReady ? (listeningTaskStatus.setupRequired ? 'is-plan-empty' : 'is-plan-ready') : 'is-data-pending'}}" bindtap="openCompleted">
    <view class="daily-copy">
      <view class="daily-title">{{texts.todayListening}}</view>
      <view class="daily-action" wx:if="{{homeDataReady}}">
        <text>{{listeningTaskStatus.action}}</text>
        <text class="daily-action-arrow">›</text>
      </view>
      <view class="daily-action home-data-skeleton" wx:else></view>
    </view>
    <view class="floating-captions">
      <view class="caption-card caption-a">
        <view>It's a beautiful day</view>
        <view>to start learning.<text>00:18</text></view>
      </view>
      <view class="caption-card caption-b">
        <view>Let's listen carefully</view>
        <view>and understand.<text>00:32</text></view>
      </view>
      <view class="caption-card caption-c">{{texts.captionExample}}<text>00:48</text></view>
    </view>
    <view class="waveform">
      <view wx:for="{{waveBars}}" wx:key="*this" class="wave-bar wave-{{item}}"></view>
    </view>
    <view class="holo-disc">
      <view class="disc-ring"></view>
      <view class="disc-glow"></view>
    </view>
    <view class="goal-chip">
      <view>
        <block wx:if="{{homeDataReady}}">
          <view class="goal-label">{{listeningTaskStatus.setupRequired ? texts.planStatus : texts.todayGoal}}</view>
          <view wx:if="{{listeningTaskStatus.setupRequired}}" class="goal-value is-text">{{texts.pendingSetup}}</view>
          <view wx:else class="goal-value">{{todayDoneMinutes}}<text> / {{todayGoalMinutes}} {{texts.minute}}</text></view>
        </block>
        <view class="home-goal-skeleton" wx:else></view>
      </view>
      <view class="goal-ring {{homeDataReady ? '' : 'is-pending'}}" style="{{homeDataReady ? todayProgressStyle : ''}}"></view>
    </view>
  </view>

  <view class="study-area-grid">
    <view class="study-module-card area-listening" bindtap="openListening">
      <view class="module-icon icon-headphones"><view></view></view>
      <view class="study-area-main">
        <view class="study-area-title">{{texts.listening}}</view>
      </view>
    </view>
    <view class="study-module-card area-reading" bindtap="openReading">
      <view class="module-icon icon-book"><view></view></view>
      <view class="study-area-main">
        <view class="study-area-title">{{texts.reading}}</view>
      </view>
    </view>
    <view class="study-module-card area-grammar" bindtap="openGrammar">
      <view class="module-icon icon-grammar"><text>A</text><view></view></view>
      <view class="study-area-main">
        <view class="study-area-title">{{texts.grammar}}</view>
      </view>
    </view>
    <view class="study-module-card area-vocabulary" bindtap="openVocabulary">
      <view class="module-icon icon-word">W</view>
      <view class="study-area-main">
        <view class="study-area-title">{{texts.vocabulary}}</view>
      </view>
    </view>
    <view class="study-module-card area-writing" bindtap="openWriting">
      <view class="module-icon icon-pencil"><view></view></view>
      <view class="study-area-main">
        <view class="study-area-title">{{texts.writing}}</view>
      </view>
    </view>
    <view class="study-module-card area-speaking" bindtap="openSpeaking">
      <view class="module-icon icon-speech"><view></view></view>
      <view class="study-area-main">
        <view class="study-area-title">{{texts.speaking}}</view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!homeLoading && !hasGroupedTasks && syncMode !== 'cloud-error'}}">{{needsListeningPlanSetup ? texts.setupPlanFirst : texts.noTasksToday}}</view>

  <view class="entry-poster" wx:if="{{entryPosterVisible}}">
    <view class="entry-poster-skip" bindtap="closeEntryPoster">{{texts.posterSkip}}</view>
    <view wx:if="{{entryPosterPage === 0}}">
      <view class="entry-poster-visual">
        <view class="sound-orbit orbit-one"></view>
        <view class="sound-orbit orbit-two"></view>
        <view class="sound-core">{{texts.posterSoundMark}}</view>
        <view class="caption-line caption-one">Listen first.</view>
        <view class="caption-line caption-two">Understand more.</view>
        <view class="caption-line caption-three">Speak naturally.</view>
      </view>
      <view class="entry-poster-copy">
        <view class="entry-poster-kicker">{{texts.posterIntroKicker}}</view>
        <view class="entry-poster-title">{{texts.posterIntroTitle}}</view>
        <view class="entry-poster-lead">{{texts.posterIntroLead}}</view>
        <view class="entry-poster-text">{{texts.posterStory}}</view>
        <view class="entry-poster-tags">
          <view class="entry-poster-tag">{{texts.posterTagInput}}</view>
          <view class="entry-poster-tag">{{texts.posterTagRhythm}}</view>
          <view class="entry-poster-tag">{{texts.posterTagExpression}}</view>
        </view>
      </view>
    </view>
    <view class="entry-message" wx:else>
      <view class="entry-guide-visual">
        <view class="guide-card guide-parent">{{texts.posterParent}}</view>
        <view class="guide-link-line"></view>
        <view class="guide-card guide-child">{{texts.posterStudentId}}</view>
      </view>
      <view class="entry-message-card">
        <view class="entry-message-kicker">{{texts.posterGuideKicker}}</view>
        <view class="entry-message-title">{{texts.posterGuideTitle}}</view>
        <view class="entry-message-text">{{texts.posterGuideStep1}}</view>
        <view class="entry-message-text">{{texts.posterGuideStep2}}</view>
        <view class="entry-message-text">{{texts.posterGuideStep3}}</view>
        <view class="entry-message-sign">
          <view class="entry-message-sign-label">{{texts.posterCreditLabel}}</view>
          <view>{{texts.posterCreditName}}</view>
        </view>
      </view>
      <view class="entry-message-back" bindtap="showPrevEntryPosterPage">{{texts.posterBack}}</view>
    </view>
    <view class="entry-poster-dots">
      <view class="entry-poster-dot {{entryPosterPage === 0 ? 'is-active' : ''}}"></view>
      <view class="entry-poster-dot {{entryPosterPage === 1 ? 'is-active' : ''}}"></view>
    </view>
    <view class="entry-poster-action" wx:if="{{entryPosterPage === 0}}" bindtap="showNextEntryPosterPage">{{texts.posterNext}}</view>
    <view class="entry-poster-actions" wx:else>
      <view class="entry-poster-role-action" data-role="parent" bindtap="confirmStudyIdentity">{{texts.identityIAmParent}}</view>
      <view class="entry-poster-role-action is-primary" data-role="student" bindtap="confirmStudyIdentity">{{texts.identityIAmStudent}}</view>
    </view>
  </view>
</view>
