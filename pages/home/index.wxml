<view wx:if="{{theme === 'library'}}" class="theme-library page-shell library-home-page">
  <view class="library-home-shelf"></view>
  <view class="library-home-header">
    <view>
      <view class="library-home-kicker">同学的英语小耳朵</view>
      <view class="library-home-date">{{todayDisplay}} · Day {{planDayIndex}}</view>
    </view>
    <view class="library-home-mark">藏</view>
  </view>

  <view class="library-home-greeting">{{greeting}}，{{child.nickname || '同学'}}</view>

  <view class="library-status-slip" wx:if="{{!homeLoading && syncMode === 'cloud-error'}}">
    <view>馆藏服务暂时不可用</view>
    <text>{{(syncDebug && (syncDebug.publicReason || syncDebug.reason)) || '学习数据暂时没有同步成功，请稍后再试。'}}</text>
  </view>

  <view class="library-nickname-sheet" wx:if="{{nicknameRequired && !identityConfirmVisible && !entryPosterVisible}}">
    <view class="library-sheet-title">请设置昵称</view>
    <view class="library-sheet-copy">用一个常用昵称开始今天的学习。</view>
    <view class="library-sheet-edit">
      <input class="library-nickname-input" placeholder="输入昵称" value="{{nicknameInput}}" bindinput="handleNicknameInput" />
      <view class="library-sheet-save" bindtap="saveRequiredNickname">保存</view>
    </view>
  </view>

  <view class="library-listening-sheet {{listeningTaskStatus.setupRequired ? 'is-empty' : ''}}" bindtap="openCompleted">
    <view class="library-sheet-margin">今日卷</view>
    <view class="library-listening-copy">
      <view class="library-listening-title">今日听力</view>
      <view class="library-listening-lead">先听懂一点，<br />再继续学习</view>
      <view class="library-listening-action">{{listeningTaskStatus.action}} <text>›</text></view>
    </view>
    <view class="library-audio-notes">
      <view class="library-audio-note"><text>01</text><view>It's a beautiful day to start learning.</view></view>
      <view class="library-audio-note"><text>02</text><view>Let's listen carefully and understand.</view></view>
      <view class="library-audio-note"><text>03</text><view>让我们认真倾听并理解。</view></view>
    </view>
    <view class="library-wave-rule">
      <view wx:for="{{waveBars}}" wx:key="*this" class="library-wave-bar library-wave-{{item}}"></view>
    </view>
    <view class="library-listening-goal">
      <view class="library-goal-label">{{listeningTaskStatus.setupRequired ? '计划状态' : '今日目标'}}</view>
      <view wx:if="{{listeningTaskStatus.setupRequired}}" class="library-goal-value">待设置</view>
      <view wx:else class="library-goal-value">{{todayDoneMinutes}} / {{todayGoalMinutes}} 分钟</view>
    </view>
  </view>

  <view class="library-section-heading">
    <view>学习目录</view>
    <text>六个入口</text>
  </view>
  <view class="library-module-index">
    <view class="library-module-row is-listening" bindtap="openListening"><text class="library-module-number">01</text><view><view>听力</view><text>声音书签</text></view><text class="library-module-arrow">›</text></view>
    <view class="library-module-row is-reading" bindtap="openReading"><text class="library-module-number">02</text><view><view>阅读</view><text>馆藏文章</text></view><text class="library-module-arrow">›</text></view>
    <view class="library-module-row is-grammar" bindtap="openGrammar"><text class="library-module-number">03</text><view><view>语法</view><text>句法字模</text></view><text class="library-module-arrow">›</text></view>
    <view class="library-module-row is-vocabulary" bindtap="openVocabulary"><text class="library-module-number">04</text><view><view>词汇</view><text>索引词库</text></view><text class="library-module-arrow">›</text></view>
    <view class="library-module-row is-writing" bindtap="openWriting"><text class="library-module-number">05</text><view><view>写作</view><text>编辑稿纸</text></view><text class="library-module-arrow">›</text></view>
    <view class="library-module-row is-speaking" bindtap="openSpeaking"><text class="library-module-number">06</text><view><view>口语</view><text>阅览室录音台</text></view><text class="library-module-arrow">›</text></view>
  </view>

  <view class="library-empty-note" wx:if="{{!homeLoading && !hasGroupedTasks && syncMode !== 'cloud-error'}}">{{needsListeningPlanSetup ? '先设置听力计划。' : '暂无今日任务。'}}</view>

  <view class="library-identity-overlay" wx:if="{{entryPosterVisible}}">
    <view class="library-poster-skip" bindtap="closeEntryPoster">跳过</view>
    <view class="library-poster-spine">同学的英语小耳朵</view>
    <block wx:if="{{entryPosterPage === 0}}">
      <view class="library-poster-title">先听见，<br />再理解。</view>
      <view class="library-poster-copy">每天留一点安静时间，让声音慢慢变成听得懂的英语。</view>
    </block>
    <block wx:else>
      <view class="library-poster-title is-guide">选择使用身份</view>
      <view class="library-poster-copy">家长可绑定并查看学习档案；学生使用本机学号开始学习。</view>
    </block>
    <view class="library-poster-dots"><view class="{{entryPosterPage === 0 ? 'is-active' : ''}}"></view><view class="{{entryPosterPage === 1 ? 'is-active' : ''}}"></view></view>
    <view class="library-poster-next" wx:if="{{entryPosterPage === 0}}" bindtap="showNextEntryPosterPage">下一页</view>
    <view class="library-poster-actions" wx:else><button data-role="parent" bindtap="confirmStudyIdentity">我是家长</button><button class="is-primary" data-role="student" bindtap="confirmStudyIdentity">我是学生</button></view>
  </view>

  <view class="library-mode-sheet" wx:if="{{identityConfirmVisible && !entryPosterVisible}}">
    <view>先选择这台手机的使用身份</view>
    <view><button data-role="parent" bindtap="confirmStudyIdentity">我是家长</button><button class="is-primary" data-role="student" bindtap="confirmStudyIdentity">我是学生</button></view>
  </view>
</view>

<view wx:else class="theme-{{theme}} page-shell home-page">
  <view class="home-atmosphere">
    <view class="light-ray ray-one"></view>
    <view class="light-ray ray-two"></view>
    <view class="plant-line plant-one"></view>
    <view class="plant-line plant-two"></view>
  </view>

  <view class="home-titlebar">
    <view class="home-heading">
      <view class="home-brand type-brand">{{greeting}}，{{child.nickname || '同学'}}</view>
      <view class="home-subtitle type-caption">
        <view class="calendar-mark"></view>
        <text>{{todayDisplay}} · Day {{planDayIndex}}</text>
      </view>
    </view>
  </view>

  <view class="section-panel" wx:if="{{!homeLoading && syncMode === 'cloud-error'}}">
    <view class="section-title">服务暂时不可用</view>
    <view class="section-copy">{{(syncDebug && (syncDebug.publicReason || syncDebug.reason)) || '学习数据暂时没有同步成功，请稍后再试。'}}</view>
  </view>

  <view class="mode-notice" wx:if="{{modeChangedNoticeVisible}}">
    这台手机已切回家长模式
  </view>

  <view class="nickname-required section-panel" wx:if="{{nicknameRequired && !identityConfirmVisible && !entryPosterVisible}}">
    <view class="section-title type-section-title">请设置昵称</view>
    <view class="section-copy">第一次使用前，请设置一个常用昵称。</view>
    <view class="nickname-edit-row">
      <input class="nickname-input" placeholder="例如 佑佑123 / 小宇" value="{{nicknameInput}}" bindinput="handleNicknameInput" />
      <view class="nickname-save" bindtap="saveRequiredNickname">保存</view>
    </view>
  </view>

  <view class="mode-reminder" wx:if="{{identityConfirmVisible}}">
    <view class="mode-reminder-copy">先选择这台手机的使用身份</view>
    <view class="mode-reminder-actions">
      <button class="mode-reminder-action" data-role="parent" bindtap="confirmStudyIdentity">我是家长</button>
      <button class="mode-reminder-action is-primary" data-role="student" bindtap="confirmStudyIdentity">我是学生</button>
    </view>
  </view>

  <view class="daily-listening-card {{listeningTaskStatus.setupRequired ? 'is-plan-empty' : 'is-plan-ready'}}" bindtap="openCompleted">
    <view class="daily-copy">
      <view class="daily-title">今日听力</view>
      <view class="daily-action">
        <text>{{listeningTaskStatus.action}}</text>
        <text class="daily-action-arrow">›</text>
      </view>
    </view>
    <view class="floating-captions">
      <view class="caption-card caption-a">
        <view>It's a beautiful day</view>
        <view>to start learning.<text>00:18</text></view>
      </view>
      <view class="caption-card caption-b">
        <view>Let's listen carefully</view>
        <view>and understand.<text>00:32</text></view>
      </view>
      <view class="caption-card caption-c">让我们认真倾听并理解。<text>00:48</text></view>
    </view>
    <view class="waveform">
      <view wx:for="{{waveBars}}" wx:key="*this" class="wave-bar wave-{{item}}"></view>
    </view>
    <view class="holo-disc">
      <view class="disc-ring"></view>
      <view class="disc-glow"></view>
    </view>
    <view class="goal-chip">
      <view>
        <view class="goal-label">{{listeningTaskStatus.setupRequired ? '计划状态' : '今日目标'}}</view>
        <view wx:if="{{listeningTaskStatus.setupRequired}}" class="goal-value is-text">待设置</view>
        <view wx:else class="goal-value">{{todayDoneMinutes}}<text> / {{todayGoalMinutes}} 分钟</text></view>
      </view>
      <view class="goal-ring" style="{{todayProgressStyle}}"></view>
    </view>
  </view>

  <view class="study-area-grid">
    <view class="study-module-card area-listening" bindtap="openListening">
      <view class="module-icon icon-headphones"><view></view></view>
      <view class="study-area-main">
        <view class="study-area-title">听力</view>
      </view>
    </view>
    <view class="study-module-card area-reading" bindtap="openReading">
      <view class="module-icon icon-book"><view></view></view>
      <view class="study-area-main">
        <view class="study-area-title">阅读</view>
      </view>
    </view>
    <view class="study-module-card area-grammar" bindtap="openGrammar">
      <view class="module-icon icon-grammar"><text>A</text><view></view></view>
      <view class="study-area-main">
        <view class="study-area-title">语法</view>
      </view>
    </view>
    <view class="study-module-card area-vocabulary" bindtap="openVocabulary">
      <view class="module-icon icon-word">W</view>
      <view class="study-area-main">
        <view class="study-area-title">词汇</view>
      </view>
    </view>
    <view class="study-module-card area-writing" bindtap="openWriting">
      <view class="module-icon icon-pencil"><view></view></view>
      <view class="study-area-main">
        <view class="study-area-title">写作</view>
      </view>
    </view>
    <view class="study-module-card area-speaking" bindtap="openSpeaking">
      <view class="module-icon icon-speech"><view></view></view>
      <view class="study-area-main">
        <view class="study-area-title">口语</view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!homeLoading && !hasGroupedTasks && syncMode !== 'cloud-error'}}">{{needsListeningPlanSetup ? '先设置听力计划。' : '暂无今日任务。'}}</view>

  <view class="entry-poster" wx:if="{{entryPosterVisible}}">
    <view class="entry-poster-skip" bindtap="closeEntryPoster">跳过</view>
    <view wx:if="{{entryPosterPage === 0}}">
      <view class="entry-poster-visual">
        <view class="sound-orbit orbit-one"></view>
        <view class="sound-orbit orbit-two"></view>
        <view class="sound-core">听</view>
        <view class="caption-line caption-one">Listen first.</view>
        <view class="caption-line caption-two">Understand more.</view>
        <view class="caption-line caption-three">Speak naturally.</view>
      </view>
      <view class="entry-poster-copy">
        <view class="entry-poster-kicker">开始前想说的话</view>
        <view class="entry-poster-title">听力先行</view>
        <view class="entry-poster-lead">先把声音听懂，再让阅读、表达和写作自然长出来。</view>
        <view class="entry-poster-text">一开始只是想给侄子佑佑做一个能坚持用的小工具。如果它也适合你家的孩子，也欢迎一起使用。英语学习不急着从题目开始，先让孩子每天听懂一点，有声音、有节奏、有感觉。</view>
        <view class="entry-poster-tags">
          <view class="entry-poster-tag">听懂输入</view>
          <view class="entry-poster-tag">持续节奏</view>
          <view class="entry-poster-tag">自然表达</view>
        </view>
      </view>
    </view>
    <view class="entry-message" wx:else>
      <view class="entry-guide-visual">
        <view class="guide-card guide-parent">家长</view>
        <view class="guide-link-line"></view>
        <view class="guide-card guide-child">学号</view>
      </view>
      <view class="entry-message-card">
        <view class="entry-message-kicker">小程序使用说明</view>
        <view class="entry-message-title">先绑定学号</view>
        <view class="entry-message-text">首次使用时，先在首页选择身份：家长选“我是家长”，孩子设备选“我是学生”。</view>
        <view class="entry-message-text">家长进入“我的”，输入或复制学号完成绑定。绑定后，就能查看孩子的学习记录和每日完成情况。</view>
        <view class="entry-message-text">孩子每天先完成“今日听力任务”，再进入阅读、语法、写作和词汇复习。</view>
        <view class="entry-message-sign">
          <view class="entry-message-sign-label">设计与内容</view>
          <view>王天龙</view>
        </view>
      </view>
      <view class="entry-message-back" bindtap="showPrevEntryPosterPage">返回理念</view>
    </view>
    <view class="entry-poster-dots">
      <view class="entry-poster-dot {{entryPosterPage === 0 ? 'is-active' : ''}}"></view>
      <view class="entry-poster-dot {{entryPosterPage === 1 ? 'is-active' : ''}}"></view>
    </view>
    <view class="entry-poster-action" wx:if="{{entryPosterPage === 0}}" bindtap="showNextEntryPosterPage">下一页</view>
    <view class="entry-poster-actions" wx:else>
      <view class="entry-poster-role-action" data-role="parent" bindtap="confirmStudyIdentity">我是家长</view>
      <view class="entry-poster-role-action is-primary" data-role="student" bindtap="confirmStudyIdentity">我是学生</view>
    </view>
  </view>
</view>
