<view class="theme-{{theme}} page-shell home-page">
  <view class="home-titlebar">
    <view class="settings-dot">⚙</view>
    <view class="home-heading">
      <view class="home-brand type-brand">{{greeting}}，{{child.nickname || '佑佑'}}</view>
      <view class="home-subtitle type-caption">{{todayDisplay}} · Day {{planDayIndex}}</view>
    </view>
    <view class="profile-badge">{{profileInitial}}</view>
  </view>

  <view class="section-panel" wx:if="{{homeLoading}}">
    <view class="section-title">今日任务加载中</view>
    <view class="section-copy">正在同步学习内容。</view>
  </view>

  <view class="section-panel" wx:elif="{{syncMode === 'cloud-error'}}">
    <view class="section-title">服务暂时不可用</view>
    <view class="section-copy">{{(syncDebug && (syncDebug.publicReason || syncDebug.reason)) || '学习数据暂时没有同步成功，请稍后再试。'}}</view>
  </view>

  <view class="mode-notice" wx:if="{{modeChangedNoticeVisible}}">
    这台手机已切回家长模式
  </view>

  <view class="mode-reminder" wx:if="{{identityConfirmVisible}}">
    <view class="mode-reminder-actions">
      <button class="mode-reminder-action" data-role="parent" bindtap="confirmStudyIdentity">我是家长</button>
      <button class="mode-reminder-action is-primary" data-role="student" bindtap="confirmStudyIdentity">我是学生</button>
    </view>
  </view>

  <view class="wordbook-card card">
    <view>
      <view class="wordbook-title">今日完成</view>
      <view class="wordbook-copy">{{todayCompletedItems.length ? todayCompletedItems.length + ' 项已完成' : '暂无完成'}}</view>
    </view>
    <view class="wordbook-action">{{todayCompletedItems.length ? '已记录' : '继续学习 →'}}</view>
  </view>

  <view class="study-area-grid">
    <view class="study-area-card card" bindtap="openListening">
      <view class="study-area-icon">🎧</view>
      <view class="study-area-title">听力</view>
      <view class="study-area-meta">{{listeningSummary}}</view>
    </view>
    <view class="study-area-card card" bindtap="openReading">
      <view class="study-area-icon">📚</view>
      <view class="study-area-title">阅读</view>
      <view class="study-area-meta">{{readingSummary}}</view>
    </view>
    <view class="study-area-card card" bindtap="openGrammar">
      <view class="study-area-icon">✍</view>
      <view class="study-area-title">语法</view>
      <view class="study-area-meta">单选错词入库</view>
    </view>
    <view class="study-area-card card" bindtap="openVocabulary">
      <view class="study-area-icon">🔎</view>
      <view class="study-area-title">词汇</view>
      <view class="study-area-meta">{{vocabularySummary.due}} 到期 · {{vocabularySummary.total}} 总计</view>
    </view>
    <view class="study-area-card card" bindtap="openWriting">
      <view class="study-area-icon">📝</view>
      <view class="study-area-title">写作</view>
      <view class="study-area-meta">生词短语入库</view>
    </view>
    <view class="study-area-card card" bindtap="openSpeaking">
      <view class="study-area-icon">🎙</view>
      <view class="study-area-title">口语</view>
      <view class="study-area-meta">录音评分</view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!homeLoading && !hasGroupedTasks && syncMode !== 'cloud-error'}}">今日任务还在准备中。</view>
</view>
