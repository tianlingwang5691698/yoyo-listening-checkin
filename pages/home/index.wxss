}

.library-module-index {
  border-top: 1rpx solid rgba(184, 149, 98, 0.5);
  background: #fffdf7;
  box-shadow: 0 8rpx 18rpx rgba(43, 33, 27, 0.07);
}

.library-module-row {
  min-height: 112rpx;
