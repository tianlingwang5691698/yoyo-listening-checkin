.home-page {
  padding-bottom: 170rpx;
}

.entry-poster {
  position: fixed;
  z-index: 1200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 88rpx 40rpx calc(170rpx + env(safe-area-inset-bottom));
  background: #fff8ee;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.entry-poster-skip {
  position: absolute;
  top: 72rpx;
  right: 36rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(47, 43, 39, 0.08);
  color: #5d554d;
  font-size: 26rpx;
  line-height: 1;
}

.nickname-required {
  margin-bottom: 24rpx;
}

.nickname-edit-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 136rpx;
  gap: 16rpx;
  margin-top: 22rpx;
  align-items: center;
}

.nickname-input {
  height: 72rpx;
  min-width: 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--surface-subtle);
  color: var(--text-main);
  font-size: var(--font-body-size);
}

.nickname-save {
  height: 72rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: var(--accent-contrast);
  font-size: var(--font-caption-size);
  line-height: 72rpx;
  text-align: center;
  font-weight: var(--font-title-weight);
}

.entry-poster-visual {
  position: relative;
  height: 486rpx;
  margin-top: 34rpx;
}

.sound-orbit {
  position: absolute;
  left: 50%;
  top: 204rpx;
  width: 260rpx;
  height: 260rpx;
  margin-left: -130rpx;
  margin-top: -130rpx;
  border: 2rpx solid rgba(196, 123, 30, 0.28);
  border-radius: 50%;
  animation: soundPulse 3.4s ease-out infinite;
}

.orbit-two {
  animation-delay: 1.2s;
}

.sound-core {
  position: absolute;
  left: 50%;
  top: 204rpx;
  width: 142rpx;
  height: 142rpx;
  margin-left: -71rpx;
  margin-top: -71rpx;
  border-radius: 50%;
  background: #2f2b27;
  color: #fff8ee;
  font-size: 56rpx;
  line-height: 142rpx;
  text-align: center;
  font-weight: 800;
  box-shadow: 0 22rpx 50rpx rgba(47, 43, 39, 0.18);
}

.caption-line {
  position: absolute;
  left: 50%;
  width: 360rpx;
  margin-left: -180rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #4c453f;
  font-size: 28rpx;
  line-height: 1.2;
  text-align: center;
  box-sizing: border-box;
  box-shadow: 0 12rpx 28rpx rgba(44, 33, 23, 0.08);
  opacity: 0;
  animation: captionFloat 5.4s ease-in-out infinite;
}

.caption-one {
  top: 18rpx;
}

.caption-two {
  top: 328rpx;
  animation-delay: 0.8s;
}

.caption-three {
  top: 402rpx;
  animation-delay: 1.6s;
}

.entry-poster-copy {
  flex: 1;
  min-height: 0;
  margin-top: 18rpx;
}

.entry-poster-kicker {
  display: inline-flex;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(47, 43, 39, 0.06);
  color: #9a6412;
  font-size: 23rpx;
  line-height: 1;
  font-weight: 700;
}

.entry-poster-title {
  margin-top: 20rpx;
  color: #2f2b27;
  font-family: "PingFang SC", "Avenir Next", "Helvetica Neue", Arial, sans-serif;
  font-size: 66rpx;
  line-height: 1.12;
  font-weight: 300;
}

.entry-poster-lead {
  margin-top: 22rpx;
  color: #38332e;
  font-family: "PingFang SC", "Avenir Next", "Helvetica Neue", Arial, sans-serif;
  font-size: 32rpx;
  line-height: 1.7;
  font-weight: 400;
}

.entry-poster-text {
  margin-top: 24rpx;
  color: #6b625a;
  font-family: "PingFang SC", "Avenir Next", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.9;
  font-weight: 300;
}

.entry-poster-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 26rpx;
}

.entry-poster-tag {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(189, 106, 8, 0.08);
  color: #8f5b0d;
  font-size: 25rpx;
  line-height: 1;
  font-weight: 700;
}

.entry-message {
  flex: 1;
  min-height: 0;
  padding-top: 106rpx;
}

.entry-guide-visual {
  position: relative;
  height: 172rpx;
  margin-bottom: 26rpx;
}

.guide-card {
  position: absolute;
  top: 28rpx;
  width: 176rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #3b342e;
  font-size: 28rpx;
  line-height: 88rpx;
  text-align: center;
  font-weight: 700;
  box-shadow: 0 14rpx 32rpx rgba(44, 33, 23, 0.08);
  animation: guideFloat 3.8s ease-in-out infinite;
}

.guide-parent {
  left: 36rpx;
}

.guide-child {
  right: 36rpx;
  animation-delay: 0.7s;
}

.guide-link-line {
  position: absolute;
  left: 226rpx;
  right: 226rpx;
  top: 70rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(189, 106, 8, 0.24);
  animation: guideLine 2.8s ease-in-out infinite;
}

.entry-message-card {
  padding: 46rpx 38rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.64);
  border: 1rpx solid rgba(47, 43, 39, 0.06);
  box-shadow: 0 18rpx 44rpx rgba(44, 33, 23, 0.08);
}

.entry-message-kicker {
  display: inline-flex;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(47, 43, 39, 0.06);
  color: #9a6412;
  font-size: 23rpx;
  line-height: 1;
  font-weight: 700;
}

.entry-message-title {
  margin-top: 32rpx;
  color: #332f2a;
  font-family: "PingFang SC", "Avenir Next", "Helvetica Neue", Arial, sans-serif;
  font-size: 56rpx;
  line-height: 1.22;
  font-weight: 300;
}

.entry-message-text {
  margin-top: 32rpx;
  color: #625a52;
  font-family: "PingFang SC", "Avenir Next", "Helvetica Neue", Arial, sans-serif;
  font-size: 30rpx;
  line-height: 1.94;
  font-weight: 300;
}

.entry-message-sign {
  margin-top: 44rpx;
  color: #2f2b27;
  font-family: "PingFang SC", "Avenir Next", "Helvetica Neue", Arial, sans-serif;
  font-size: 25rpx;
  line-height: 1.2;
  text-align: right;
  font-weight: 300;
}

.entry-message-sign-label {
  margin-bottom: 8rpx;
  color: #9a8d7f;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 600;
}

.entry-message-back {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(206rpx + env(safe-area-inset-bottom));
  z-index: 2;
  color: #8a7d70;
  font-size: 26rpx;
  line-height: 1.2;
  text-align: center;
}

.entry-poster-dots {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(158rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.entry-poster-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(47, 43, 39, 0.18);
}

.entry-poster-dot.is-active {
  width: 28rpx;
  border-radius: 999rpx;
  background: #2f2b27;
}

.entry-poster-action {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(46rpx + env(safe-area-inset-bottom));
  height: 92rpx;
  border-radius: 999rpx;
  background: #2f2b27;
  color: #fff8ee;
  font-size: 31rpx;
  line-height: 92rpx;
  text-align: center;
  font-weight: 800;
  box-shadow: 0 18rpx 34rpx rgba(47, 43, 39, 0.16);
}

.entry-poster-actions {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(46rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
}

.entry-poster-role-action {
  width: 100%;
  min-width: 0;
  height: 92rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 1rpx solid rgba(47, 43, 39, 0.14);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #3b342e;
  font-size: 28rpx;
  line-height: 92rpx;
  text-align: center;
  font-weight: 700;
}

.entry-poster-role-action.is-primary {
  border-color: #2f2b27;
  background: #2f2b27;
  color: #fff8ee;
}

@keyframes soundPulse {
  0% {
    transform: scale(0.72);
    opacity: 0.62;
  }
  100% {
    transform: scale(1.86);
    opacity: 0;
  }
}

@keyframes captionFloat {
  0%,
  18% {
    transform: translateY(14rpx);
    opacity: 0;
  }
  32%,
  72% {
    transform: translateY(0);
    opacity: 1;
  }
  88%,
  100% {
    transform: translateY(-10rpx);
    opacity: 0;
  }
}

@keyframes guideFloat {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

@keyframes guideLine {
  0%,
  100% {
    opacity: 0.28;
    transform: scaleX(0.78);
  }
  50% {
    opacity: 1;
    transform: scaleX(1);
  }
}

.home-titlebar {
  padding: 72rpx 20rpx 34rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.home-heading {
  min-width: 0;
  flex: 1;
}

.home-brand {
  font-size: 44rpx;
  font-weight: var(--font-section-weight);
  letter-spacing: 0;
  line-height: 1.18;
}

.home-subtitle {
  margin-top: 10rpx;
  color: #6f6a63;
  font-size: 24rpx;
}

.settings-dot {
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #6f6a63;
  font-size: 38rpx;
  line-height: 58rpx;
  text-align: center;
}

.profile-badge {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border: 3rpx solid rgba(217, 159, 54, 0.28);
  border-radius: 50%;
  background: #fff1b9;
  color: #bd7d10;
  font-size: 34rpx;
  line-height: 72rpx;
  text-align: center;
  font-weight: 800;
}

.mode-notice {
  margin: 0 20rpx 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: var(--control-muted-bg);
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.35;
  text-align: center;
  font-weight: var(--font-title-weight);
}

.mode-reminder {
  margin: 0 20rpx 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: var(--accent-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.mode-reminder-copy {
  margin-bottom: 16rpx;
  color: var(--text-main);
  font-size: var(--font-caption-size);
  line-height: 1.35;
  font-weight: var(--font-title-weight);
}

.mode-reminder-actions {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mode-reminder-action {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--text-main);
  font-size: var(--font-caption-size);
  line-height: 60rpx;
  font-weight: var(--font-title-weight);
}

.mode-reminder-action.is-primary {
  background: var(--accent);
  color: var(--accent-contrast);
}

.mode-reminder-action::after {
  border: none;
}

.program-swiper {
  width: 100%;
  height: 660rpx;
}

.study-area-grid {
  margin: 0 20rpx 28rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.study-area-card {
  min-height: 210rpx;
  padding: 28rpx 26rpx;
  background: rgba(255, 254, 252, 0.98);
  border: 1rpx solid rgba(45, 38, 31, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(44, 33, 23, 0.06);
}

.study-area-icon {
  height: 58rpx;
  color: var(--text-main);
  font-size: 40rpx;
  line-height: 58rpx;
}

.study-area-title {
  margin-top: 24rpx;
  color: var(--text-strong);
  font-size: 38rpx;
  line-height: 1.25;
  font-weight: 800;
}

.study-area-meta {
  margin-top: 12rpx;
  color: #8a847c;
  font-size: 26rpx;
  line-height: 1.35;
}

.wordbook-card {
  margin: 0 20rpx 22rpx;
  padding: 30rpx 28rpx;
  min-height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: rgba(255, 254, 252, 0.98);
  border: 1rpx solid rgba(45, 38, 31, 0.05);
  box-shadow: 0 10rpx 24rpx rgba(44, 33, 23, 0.06);
}

.wordbook-title {
  color: var(--text-strong);
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 800;
}

.wordbook-copy {
  margin-top: 16rpx;
  color: #6f6a63;
  font-size: 27rpx;
  line-height: 1.35;
}

.wordbook-action {
  flex-shrink: 0;
  color: #bd6a08;
  font-size: 27rpx;
  font-weight: 800;
}

.home-section-heading {
  margin: 0 20rpx 18rpx;
  color: var(--text-strong);
  font-size: var(--font-section-title-size);
  line-height: 1.3;
  font-weight: var(--font-section-heading-weight);
}

.program-slide {
  min-height: 590rpx;
  margin: 0 10rpx;
  padding: 30rpx 28rpx;
  background: var(--surface-raised);
  overflow: hidden;
}

.program-slide.is-disabled {
  opacity: 0.5;
}

.slide-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.slide-name {
  color: var(--text-strong);
  font-size: var(--font-section-title-size);
  line-height: 1.3;
  font-weight: var(--font-title-weight);
}

.slide-state {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-section-title-size);
  line-height: 1;
  font-weight: var(--font-title-weight);
}

.slide-state.is-done,
.slide-state.is-waiting {
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.slide-title {
  margin-top: 44rpx;
  color: var(--text-strong);
  font-size: var(--font-page-title-size);
  line-height: 1.22;
  font-weight: var(--font-title-weight);
  word-break: break-word;
}

.slide-meta {
  margin-top: 16rpx;
}

.slide-line {
  width: 100%;
  height: 2rpx;
  margin-top: 22rpx;
  background: var(--control-muted-bg);
}

.slide-task-list {
  display: flex;
  flex-direction: column;
  margin-top: 8rpx;
}

.slide-task {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding-top: 12rpx;
  margin-top: 12rpx;
  border-top: 1rpx solid var(--border-soft);
  min-width: 0;
}

.slide-task.is-primary {
  padding-top: 14rpx;
}

.slide-task-main {
  min-width: 0;
  flex: 1;
}

.slide-task-title {
  color: var(--text-main);
  font-size: 27rpx;
  line-height: 1.25;
  font-weight: var(--font-section-weight);
  word-break: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.slide-task-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.2;
}

.slide-task-state {
  flex-shrink: 0;
  min-width: 64rpx;
  color: var(--accent-deep);
  text-align: right;
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.slide-task.is-disabled {
  opacity: 0.48;
}

.reading-entry {
  margin: 24rpx 20rpx 0;
  padding: 28rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: var(--surface-raised);
}

.reading-entry-main {
  min-width: 0;
  flex: 1;
}

.reading-entry-kicker {
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  line-height: 1.3;
  font-weight: var(--font-title-weight);
}

.reading-entry-title {
  margin-top: 10rpx;
  color: var(--text-strong);
  font-size: var(--font-section-title-size);
  line-height: 1.3;
  font-weight: var(--font-title-weight);
  word-break: break-word;
}

.reading-entry-meta {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: var(--line-caption);
}

.reading-entry-state {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-section-title-size);
  font-weight: var(--font-title-weight);
}
