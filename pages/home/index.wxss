  font-family: "Songti SC", "STSong", serif;
  font-size: 32rpx;
  line-height: 1;
}

.library-tile-icon {
  position: relative;
  width: 62rpx;
  height: 62rpx;
  color: #8f6b3c;
  font-family: "Songti SC", "STSong", serif;
  font-size: 58rpx;
  line-height: 58rpx;
  text-align: center;
}

.icon-listening::before,
.icon-listening::after {
  content: "";
  position: absolute;
  top: 4rpx;
  width: 22rpx;
  height: 42rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
}
.icon-listening::before { left: 2rpx; border-radius: 26rpx 0 0 0; }
.icon-listening::after { right: 2rpx; border-radius: 0 26rpx 0 0; }
.icon-listening view { position: absolute; left: 17rpx; top: 42rpx; width: 28rpx; height: 4rpx; background: currentColor; }

.icon-reading::before,
.icon-reading::after {
  content: "";
  position: absolute;
  top: 8rpx;
  width: 29rpx;
  height: 44rpx;
  border: 3rpx solid currentColor;
}
.icon-reading::before { left: 1rpx; border-radius: 6rpx 0 0 3rpx; }
.icon-reading::after { right: 1rpx; border-radius: 0 6rpx 3rpx 0; }
.icon-reading view { position: absolute; left: 29rpx; top: 9rpx; width: 3rpx; height: 45rpx; background: currentColor; }

.icon-grammar { font-size: 48rpx; font-weight: 600; }
.icon-grammar text { display: inline-block; margin-left: 3rpx; font-size: 33rpx; vertical-align: 8rpx; }
.icon-vocabulary { font-size: 58rpx; }
.icon-writing::before { content: ""; position: absolute; left: 28rpx; top: 3rpx; width: 8rpx; height: 52rpx; border: 3rpx solid currentColor; transform: rotate(42deg); }
.icon-writing::after { content: ""; position: absolute; left: 8rpx; right: 8rpx; bottom: 5rpx; height: 3rpx; background: currentColor; }
.icon-speaking::before { content: ""; position: absolute; left: 5rpx; top: 5rpx; width: 49rpx; height: 39rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.icon-speaking::after { content: ""; position: absolute; left: 18rpx; bottom: 4rpx; width: 16rpx; height: 16rpx; border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: skewY(-28deg); }

