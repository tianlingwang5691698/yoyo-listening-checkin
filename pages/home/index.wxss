.home-page {
  padding-bottom: 170rpx;
}

.entry-poster {
  --bg-cream: #F6FBFD;
  --surface-glass: rgba(255, 255, 255, 0.74);
  --control-muted-bg: rgba(141, 183, 212, 0.16);
  --control-strong-bg: rgba(141, 183, 212, 0.28);
  --text-main: #17314F;
  --text-strong: #17314F;
  --text-muted: #607087;
  --text-soft: #728196;
  --text-inverse: #FFFFFF;
  --accent-deep: #5C8DAF;
  --border-soft: rgba(255, 255, 255, 0.76);
  --border-strong: rgba(141, 183, 212, 0.36);
  --shadow-soft: 0 12rpx 30rpx rgba(91, 129, 157, 0.09);
  --shadow-card: 0 18rpx 42rpx rgba(64, 105, 138, 0.12);
  position: fixed;
  z-index: 1200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 88rpx 40rpx calc(170rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #F6FBFD 0%, #EDF6FA 50%, #EAF3F8 100%);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.entry-poster-skip {
  position: absolute;
  top: 72rpx;
  right: 36rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1;
}

.nickname-required {
  margin-bottom: 24rpx;
}

.nickname-edit-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 136rpx;
  gap: 16rpx;
  margin-top: 22rpx;
  align-items: center;
}

.nickname-input {
  height: 72rpx;
  min-width: 0;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--surface-subtle);
  color: var(--text-main);
  font-size: var(--font-body-size);
}

.nickname-save {
  height: 72rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: var(--accent-contrast);
  font-size: var(--font-caption-size);
  line-height: 72rpx;
  text-align: center;
  font-weight: var(--font-title-weight);
}

.entry-poster-visual {
  position: relative;
  height: 486rpx;
  margin-top: 34rpx;
}

.sound-orbit {
  position: absolute;
  left: 50%;
  top: 204rpx;
  width: 260rpx;
  height: 260rpx;
  margin-left: -130rpx;
  margin-top: -130rpx;
  border: 2rpx solid var(--control-strong-bg);
  border-radius: 50%;
  animation: soundPulse 3.4s ease-out infinite;
}

.orbit-two {
  animation-delay: 1.2s;
}

.sound-core {
  position: absolute;
  left: 50%;
  top: 204rpx;
  width: 142rpx;
  height: 142rpx;
  margin-left: -71rpx;
  margin-top: -71rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #DCECF5 0%, #8DB7D4 100%);
  color: #17314F;
  font-size: 52rpx;
  line-height: 142rpx;
  text-align: center;
  font-weight: var(--font-title-weight);
  box-shadow: var(--shadow-card);
}

.caption-line {
  position: absolute;
  left: 50%;
  width: 360rpx;
  margin-left: -180rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: var(--surface-glass);
  color: var(--text-main);
  font-size: var(--font-body-size);
  line-height: 1.2;
  text-align: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: var(--shadow-soft);
  opacity: 0;
  animation: captionFloat 5.4s ease-in-out infinite;
}

.caption-one {
  top: 18rpx;
}

.caption-two {
  top: 328rpx;
  animation-delay: 0.8s;
}

.caption-three {
  top: 402rpx;
  animation-delay: 1.6s;
}

.entry-poster-copy {
  flex: 1;
  min-height: 0;
  margin-top: 18rpx;
}

.entry-poster-kicker {
  display: inline-flex;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--accent-deep);
  font-size: var(--font-eyebrow-size);
  line-height: 1;
  font-weight: var(--font-section-weight);
}

.entry-poster-title {
  margin-top: 20rpx;
  color: var(--text-strong);
  font-family: var(--font-title-family);
  font-size: 60rpx;
  line-height: 1.12;
  font-weight: 300;
}

.entry-poster-lead {
  margin-top: 22rpx;
  color: var(--text-main);
  font-family: var(--font-body-family);
  font-size: var(--font-section-title-size);
  line-height: 1.7;
  font-weight: 400;
}

.entry-poster-text {
  margin-top: 24rpx;
  color: var(--text-muted);
  font-family: var(--font-body-family);
  font-size: var(--font-body-size);
  line-height: 1.9;
  font-weight: 300;
}

.entry-poster-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 26rpx;
}

.entry-poster-tag {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  line-height: 1;
  font-weight: var(--font-title-weight);
}

.entry-message {
  flex: 1;
  min-height: 0;
  padding-top: 106rpx;
}

.entry-guide-visual {
  position: relative;
  height: 172rpx;
  margin-bottom: 26rpx;
}

.guide-card {
  position: absolute;
  top: 28rpx;
  width: 176rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--surface-glass);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  color: var(--text-main);
  font-size: var(--font-body-size);
  line-height: 88rpx;
  text-align: center;
  font-weight: var(--font-title-weight);
  box-shadow: var(--shadow-soft);
  animation: guideFloat 3.8s ease-in-out infinite;
}

.guide-parent {
  left: 36rpx;
}

.guide-child {
  right: 36rpx;
  animation-delay: 0.7s;
}

.guide-link-line {
  position: absolute;
  left: 226rpx;
  right: 226rpx;
  top: 70rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(141, 183, 212, 0.18), rgba(134, 170, 161, 0.72), rgba(141, 183, 212, 0.18));
  animation: guideLine 2.8s ease-in-out infinite;
}

.entry-message-card {
  padding: 46rpx 38rpx;
  border-radius: var(--radius-xl);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(246, 251, 253, 0.68));
  border: 1rpx solid var(--border-soft);
  box-shadow: var(--shadow-card);
}

.entry-message-kicker {
  display: inline-flex;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--accent-deep);
  font-size: var(--font-eyebrow-size);
  line-height: 1;
  font-weight: var(--font-section-weight);
}

.entry-message-title {
  margin-top: 32rpx;
  color: var(--text-strong);
  font-family: var(--font-title-family);
  font-size: 52rpx;
  line-height: 1.22;
  font-weight: 300;
}

.entry-message-text {
  margin-top: 32rpx;
  color: var(--text-muted);
  font-family: var(--font-body-family);
  font-size: var(--font-body-size);
  line-height: 1.94;
  font-weight: 300;
}

.entry-message-sign {
  margin-top: 44rpx;
  color: var(--text-main);
  font-family: var(--font-body-family);
  font-size: var(--font-caption-size);
  line-height: 1.2;
  text-align: right;
  font-weight: 300;
}

.entry-message-sign-label {
  margin-bottom: 8rpx;
  color: var(--text-soft);
  font-size: var(--font-caption-size);
  line-height: 1;
  font-weight: 600;
}

.entry-message-back {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(206rpx + env(safe-area-inset-bottom));
  z-index: 2;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.2;
  text-align: center;
}

.entry-poster-dots {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(158rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.entry-poster-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--control-strong-bg);
}

.entry-poster-dot.is-active {
  width: 28rpx;
  border-radius: 999rpx;
  background: var(--text-strong);
}

.entry-poster-action {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(46rpx + env(safe-area-inset-bottom));
  height: 92rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #F2A18E 0%, #DF7F68 100%);
  color: var(--text-inverse);
  font-size: var(--font-control-size);
  line-height: 92rpx;
  text-align: center;
  font-weight: var(--font-title-weight);
  box-shadow: var(--shadow-card);
}

.entry-poster-actions {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(46rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
}

.entry-poster-role-action {
  width: 100%;
  min-width: 0;
  height: 92rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 1rpx solid var(--border-strong);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--text-main);
  font-size: var(--font-body-size);
  line-height: 92rpx;
  text-align: center;
  font-weight: var(--font-title-weight);
}

.entry-poster-role-action.is-primary {
  border-color: rgba(223, 127, 104, 0.2);
  background: linear-gradient(135deg, #F2A18E 0%, #DF7F68 100%);
  color: var(--text-inverse);
}

@keyframes soundPulse {
  0% {
    transform: scale(0.72);
    opacity: 0.62;
  }
  100% {
    transform: scale(1.86);
    opacity: 0;
  }
}

@keyframes captionFloat {
  0%,
  18% {
    transform: translateY(14rpx);
    opacity: 0;
  }
  32%,
  72% {
    transform: translateY(0);
    opacity: 1;
  }
  88%,
  100% {
    transform: translateY(-10rpx);
    opacity: 0;
  }
}

@keyframes guideFloat {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

@keyframes guideLine {
  0%,
  100% {
    opacity: 0.28;
    transform: scaleX(0.78);
  }
  50% {
    opacity: 1;
    transform: scaleX(1);
  }
}

.home-titlebar {
  padding: 72rpx 20rpx 34rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.home-heading {
  min-width: 0;
  flex: 1;
}

.home-brand {
  font-size: var(--font-page-title-size);
  font-weight: var(--font-section-weight);
  letter-spacing: 0;
  line-height: 1.18;
}

.home-subtitle {
  margin-top: 10rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.settings-dot {
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: var(--text-muted);
  font-size: 34rpx;
  line-height: 58rpx;
  text-align: center;
}

.profile-badge {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border: 1rpx solid var(--border-soft);
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: var(--font-section-title-size);
  line-height: 72rpx;
  text-align: center;
  font-weight: var(--font-title-weight);
}

.mode-notice {
  margin: 0 20rpx 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: var(--control-muted-bg);
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.35;
  text-align: center;
  font-weight: var(--font-title-weight);
}

.mode-reminder {
  margin: 0 20rpx 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: var(--accent-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.mode-reminder-copy {
  margin-bottom: 16rpx;
  color: var(--text-main);
  font-size: var(--font-caption-size);
  line-height: 1.35;
  font-weight: var(--font-title-weight);
}

.mode-reminder-actions {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mode-reminder-action {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--text-main);
  font-size: var(--font-caption-size);
  line-height: 60rpx;
  font-weight: var(--font-title-weight);
}

.mode-reminder-action.is-primary {
  background: var(--accent);
  color: var(--accent-contrast);
}

.mode-reminder-action::after {
  border: none;
}

.program-swiper {
  width: 100%;
  height: 660rpx;
}

.study-area-list {
  margin: 0 20rpx 28rpx;
  padding: 10rpx 24rpx;
  background: rgba(255, 254, 250, 0.76);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: var(--shadow-soft);
}

.study-area-row {
  position: relative;
  min-height: 110rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(48, 49, 58, 0.07);
}

.study-area-row:last-child {
  border-bottom: none;
}

.area-listening {
  --area-color: #5e7899;
  --area-soft: #e3e8ed;
}

.area-reading {
  --area-color: #668f84;
  --area-soft: #e3ebe7;
}

.area-grammar {
  --area-color: #bda267;
  --area-soft: #ece4d2;
}

.area-vocabulary {
  --area-color: #7f769e;
  --area-soft: #e7e4ed;
}

.area-writing {
  --area-color: #df8068;
  --area-soft: #eadbd5;
}

.area-speaking {
  --area-color: #5b8997;
  --area-soft: #e2eaec;
}

.study-area-icon {
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: var(--area-soft);
  color: var(--area-color);
  font-size: var(--font-caption-size);
  line-height: 58rpx;
  text-align: center;
  font-weight: var(--font-title-weight);
  box-shadow: inset 0 0 0 1rpx rgba(48, 49, 58, 0.055);
}

.study-area-main {
  min-width: 0;
  flex: 1;
}

.study-area-title {
  color: var(--text-strong);
  font-size: var(--font-section-title-size);
  line-height: 1.25;
  font-weight: var(--font-title-weight);
}

.study-area-arrow {
  flex-shrink: 0;
  color: var(--text-soft);
  font-size: 34rpx;
  line-height: 1;
}

.wordbook-card {
  margin: 0 20rpx 22rpx;
  padding: 30rpx 28rpx;
  min-height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.66), rgba(255, 255, 255, 0) 42%),
    linear-gradient(135deg, #e9dfca 0%, #d9e4df 58%, #dfe5eb 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 20rpx 46rpx rgba(54, 112, 104, 0.12);
}

.wordbook-title {
  color: var(--text-strong);
  font-size: var(--font-section-title-size);
  line-height: 1.25;
  font-weight: var(--font-title-weight);
}

.wordbook-copy {
  margin-top: 16rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.35;
}

.wordbook-action {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: var(--accent-contrast);
  box-shadow: var(--shadow-accent);
}

.home-section-heading {
  margin: 0 20rpx 18rpx;
  color: var(--text-strong);
  font-size: var(--font-section-title-size);
  line-height: 1.3;
  font-weight: var(--font-section-heading-weight);
}

.home-page {
  position: relative;
  min-height: 100vh;
  padding: 76rpx 32rpx 176rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 76% 8%, rgba(255, 255, 255, 0.96) 0, rgba(255, 255, 255, 0) 31%),
    radial-gradient(circle at 58% 30%, rgba(186, 213, 233, 0.54) 0, rgba(186, 213, 233, 0) 38%),
    linear-gradient(160deg, #f8fbfd 0%, #edf4f8 42%, #f8fbfb 100%);
  box-sizing: border-box;
}

.home-atmosphere {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.light-ray {
  position: absolute;
  top: -40rpx;
  width: 32rpx;
  height: 520rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  filter: blur(2rpx);
  transform: rotate(24deg);
}

.ray-one {
  right: 186rpx;
}

.ray-two {
  right: 74rpx;
  height: 420rpx;
  opacity: 0.72;
}

.plant-line {
  position: absolute;
  right: 22rpx;
  width: 4rpx;
  border-radius: 999rpx;
  background: rgba(102, 143, 132, 0.44);
  transform-origin: bottom;
}

.plant-one {
  top: 214rpx;
  height: 270rpx;
  transform: rotate(18deg);
}

.plant-two {
  top: 300rpx;
  right: 70rpx;
  height: 180rpx;
  transform: rotate(-18deg);
  opacity: 0.55;
}

.home-titlebar {
  position: relative;
  z-index: 1;
  padding: 0 6rpx 36rpx;
  display: block;
}

.home-brand {
  color: #17314f;
  font-family: "PingFang SC", "Songti SC", serif;
  font-size: 48rpx;
  line-height: 1.14;
  font-weight: 500;
  letter-spacing: 0;
}

.home-subtitle {
  margin-top: 34rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #607087;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 500;
}

.calendar-mark {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid #607087;
  border-radius: 7rpx;
  box-sizing: border-box;
}

.calendar-mark::before {
  content: "";
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  top: 8rpx;
  height: 3rpx;
  background: #607087;
  border-radius: 999rpx;
}

.calendar-mark::after {
  content: "";
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  top: -8rpx;
  height: 8rpx;
  border-left: 3rpx solid #607087;
  border-right: 3rpx solid #607087;
}

.daily-listening-card {
  position: relative;
  z-index: 1;
  height: 664rpx;
  margin-top: 8rpx;
  padding: 96rpx 48rpx 46rpx;
  border-radius: 72rpx;
  overflow: hidden;
  box-sizing: border-box;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.8), rgba(219, 233, 242, 0.42) 54%, rgba(255, 255, 255, 0.7)),
    rgba(231, 241, 248, 0.64);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.98),
    0 26rpx 70rpx rgba(78, 112, 139, 0.18);
  backdrop-filter: blur(18rpx);
}

.daily-listening-card::before {
  content: "";
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 22rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0));
}

.daily-copy {
  position: relative;
  z-index: 2;
}

.daily-title {
  color: #17314f;
  font-family: "PingFang SC", "Songti SC", serif;
  font-size: 70rpx;
  line-height: 1.1;
  font-weight: 500;
  letter-spacing: 0;
}

.daily-action {
  width: 206rpx;
  height: 76rpx;
  margin-top: 54rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.48);
  border: 1rpx solid rgba(141, 183, 212, 0.42);
  color: #17314f;
  font-size: 29rpx;
  line-height: 1;
  font-weight: 600;
  box-shadow: 0 16rpx 34rpx rgba(78, 112, 139, 0.12);
  box-sizing: border-box;
  backdrop-filter: blur(16rpx);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.daily-action-arrow {
  color: #5c8daf;
  transform: translateY(-1rpx);
}

.daily-listening-card.is-plan-ready .daily-action {
  background: linear-gradient(135deg, #f3a18e 0%, #df7f68 100%);
  border-color: rgba(255, 255, 255, 0.42);
  color: #fffafa;
  box-shadow: 0 16rpx 34rpx rgba(223, 127, 104, 0.22);
}

.daily-listening-card.is-plan-empty .daily-action {
  background: linear-gradient(135deg, #f3a18e 0%, #df7f68 100%);
  border-color: rgba(255, 255, 255, 0.42);
  color: #fffafa;
  box-shadow: 0 16rpx 34rpx rgba(223, 127, 104, 0.22);
}

.daily-listening-card.is-plan-ready .daily-action-arrow,
.daily-listening-card.is-plan-empty .daily-action-arrow {
  color: rgba(255, 250, 250, 0.9);
}

.floating-captions {
  position: absolute;
  z-index: 2;
  top: 82rpx;
  right: 28rpx;
  width: 330rpx;
  height: 280rpx;
}

.caption-card {
  position: absolute;
  right: 0;
  min-width: 270rpx;
  padding: 22rpx 26rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.34);
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  color: #4d6583;
  font-size: 21rpx;
  line-height: 1.68;
  box-shadow: 0 16rpx 36rpx rgba(82, 115, 143, 0.1);
  backdrop-filter: blur(16rpx);
  box-sizing: border-box;
}

.caption-card text {
  margin-left: 32rpx;
  color: #6c7c91;
}

.caption-a {
  top: 0;
  transform: rotate(-5deg);
}

.caption-b {
  top: 108rpx;
  right: -20rpx;
  transform: rotate(-5deg);
}

.caption-c {
  top: 214rpx;
  right: 8rpx;
  min-width: 308rpx;
  transform: rotate(-2deg);
}

.waveform {
  position: absolute;
  z-index: 1;
  left: 244rpx;
  right: 34rpx;
  top: 386rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  opacity: 0.9;
}

.wave-bar {
  width: 5rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 0 14rpx rgba(255, 255, 255, 0.65);
}

.wave-01,
.wave-18 { height: 28rpx; }
.wave-02,
.wave-17 { height: 44rpx; }
.wave-03,
.wave-16 { height: 62rpx; }
.wave-04,
.wave-15 { height: 38rpx; }
.wave-05,
.wave-14 { height: 76rpx; }
.wave-06,
.wave-13 { height: 52rpx; }
.wave-07,
.wave-12 { height: 86rpx; }
.wave-08,
.wave-11 { height: 66rpx; }
.wave-09,
.wave-10 { height: 96rpx; }

.holo-disc {
  position: absolute;
  right: 72rpx;
  bottom: 112rpx;
  width: 260rpx;
  height: 104rpx;
}

.disc-ring {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 82rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  box-shadow: inset 0 -10rpx 22rpx rgba(137, 174, 205, 0.14), 0 12rpx 26rpx rgba(94, 120, 153, 0.14);
}

.disc-glow {
  position: absolute;
  left: 50%;
  bottom: 30rpx;
  width: 84rpx;
  height: 28rpx;
  margin-left: -42rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 0 48rpx 26rpx rgba(174, 211, 235, 0.5);
}

.goal-chip {
  position: absolute;
  z-index: 3;
  left: 44rpx;
  bottom: 38rpx;
  width: 236rpx;
  height: 116rpx;
  padding: 26rpx 28rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.42);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 12rpx 30rpx rgba(82, 115, 143, 0.08);
  backdrop-filter: blur(16rpx);
}

.goal-label {
  color: #253e5d;
  font-size: 24rpx;
  line-height: 1;
}

.goal-value {
  margin-top: 14rpx;
  color: #17314f;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 600;
}

.goal-value text {
  color: #66778b;
  font-size: 22rpx;
  font-weight: 400;
}

.goal-value.is-text {
  font-size: 30rpx;
}

.goal-ring {
  position: relative;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  box-sizing: border-box;
}

.goal-ring::after {
  content: "";
  position: absolute;
  left: 9rpx;
  right: 9rpx;
  top: 9rpx;
  bottom: 9rpx;
  border-radius: 50%;
  background: rgba(246, 251, 253, 0.9);
}

.study-area-grid {
  position: relative;
  z-index: 1;
  margin-top: 56rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24rpx;
}

.study-module-card {
  min-height: 216rpx;
  padding: 34rpx 16rpx 26rpx;
  border-radius: 34rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.86), rgba(255, 255, 255, 0.56)),
    rgba(241, 247, 250, 0.74);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 20rpx 46rpx rgba(85, 111, 136, 0.12);
  box-sizing: border-box;
  backdrop-filter: blur(16rpx);
  text-align: center;
}

.module-icon {
  position: relative;
  width: 86rpx;
  height: 86rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  color: #314866;
  background:
    radial-gradient(circle at 38% 26%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.42) 70%),
    rgba(227, 238, 246, 0.72);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95),
    0 12rpx 28rpx rgba(83, 111, 137, 0.12);
  box-sizing: border-box;
}

.study-area-title {
  color: #17314f;
  font-family: "PingFang SC", "Songti SC", serif;
  font-size: 34rpx;
  line-height: 1.18;
  font-weight: 500;
}

.area-listening { --area-color: #df8068; }
.area-reading { --area-color: #789484; }
.area-grammar { --area-color: #7195b7; }
.area-vocabulary { --area-color: #6f99b4; }
.area-writing { --area-color: #c9a080; }
.area-speaking { --area-color: #7f9788; }

.icon-headphones::before {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 22rpx;
  width: 36rpx;
  height: 38rpx;
  border: 5rpx solid #314866;
  border-bottom: 0;
  border-radius: 32rpx 32rpx 0 0;
}

.icon-headphones view::before,
.icon-headphones view::after {
  content: "";
  position: absolute;
  top: 48rpx;
  width: 8rpx;
  height: 22rpx;
  border: 5rpx solid #314866;
  border-radius: 999rpx;
}

.icon-headphones view::before { left: 18rpx; }
.icon-headphones view::after { right: 18rpx; }

.icon-book::before,
.icon-book::after {
  content: "";
  position: absolute;
  top: 25rpx;
  width: 26rpx;
  height: 36rpx;
  border: 5rpx solid #314866;
  border-radius: 5rpx 14rpx 14rpx 5rpx;
}

.icon-book::before {
  left: 15rpx;
  transform: skewY(8deg);
}

.icon-book::after {
  right: 15rpx;
  transform: scaleX(-1) skewY(8deg);
}

.icon-grammar text {
  position: absolute;
  left: 22rpx;
  top: 20rpx;
  color: #314866;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 500;
}

.icon-grammar view,
.icon-grammar view::before,
.icon-grammar view::after {
  position: absolute;
  right: 18rpx;
  width: 24rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #314866;
  content: "";
}

.icon-grammar view { top: 31rpx; }
.icon-grammar view::before { top: 15rpx; right: 0; }
.icon-grammar view::after { top: 30rpx; right: 0; }

.icon-word {
  color: #5479aa;
  font-family: Georgia, serif;
  font-size: 52rpx;
  line-height: 86rpx;
  font-weight: 500;
}

.icon-pencil view {
  position: absolute;
  left: 28rpx;
  top: 24rpx;
  width: 10rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: #314866;
  transform: rotate(45deg);
}

.icon-pencil view::before {
  content: "";
  position: absolute;
  left: -7rpx;
  bottom: -11rpx;
  width: 24rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #314866;
}

.icon-speech view {
  position: absolute;
  left: 23rpx;
  top: 25rpx;
  width: 40rpx;
  height: 32rpx;
  border: 5rpx solid #314866;
  border-radius: 50%;
}

.icon-speech view::after {
  content: "";
  position: absolute;
  right: 1rpx;
  bottom: -12rpx;
  width: 16rpx;
  height: 16rpx;
  border-left: 5rpx solid #314866;
  border-bottom: 5rpx solid #314866;
  transform: rotate(-22deg);
}

.program-slide {
  min-height: 590rpx;
  margin: 0 10rpx;
  padding: 30rpx 28rpx;
  background: var(--surface-raised);
  overflow: hidden;
}

.program-slide.is-disabled {
  opacity: 0.5;
}

.slide-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.slide-name {
  color: var(--text-strong);
  font-size: var(--font-section-title-size);
  line-height: 1.3;
  font-weight: var(--font-title-weight);
}

.slide-state {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-section-title-size);
  line-height: 1;
  font-weight: var(--font-title-weight);
}

.slide-state.is-done,
.slide-state.is-waiting {
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.slide-title {
  margin-top: 44rpx;
  color: var(--text-strong);
  font-size: var(--font-page-title-size);
  line-height: 1.22;
  font-weight: var(--font-title-weight);
  word-break: break-word;
}

.slide-meta {
  margin-top: 16rpx;
}

.slide-line {
  width: 100%;
  height: 2rpx;
  margin-top: 22rpx;
  background: var(--control-muted-bg);
}

.slide-task-list {
  display: flex;
  flex-direction: column;
  margin-top: 8rpx;
}

.slide-task {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding-top: 12rpx;
  margin-top: 12rpx;
  border-top: 1rpx solid var(--border-soft);
  min-width: 0;
}

.slide-task.is-primary {
  padding-top: 14rpx;
}

.slide-task-main {
  min-width: 0;
  flex: 1;
}

.slide-task-title {
  color: var(--text-main);
  font-size: 27rpx;
  line-height: 1.25;
  font-weight: var(--font-section-weight);
  word-break: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.slide-task-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.2;
}

.slide-task-state {
  flex-shrink: 0;
  min-width: 64rpx;
  color: var(--accent-deep);
  text-align: right;
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.slide-task.is-disabled {
  opacity: 0.48;
}

.reading-entry {
  margin: 24rpx 20rpx 0;
  padding: 28rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: var(--surface-raised);
}

.reading-entry-main {
  min-width: 0;
  flex: 1;
}

.reading-entry-kicker {
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  line-height: 1.3;
  font-weight: var(--font-title-weight);
}

.reading-entry-title {
  margin-top: 10rpx;
  color: var(--text-strong);
  font-size: var(--font-section-title-size);
  line-height: 1.3;
  font-weight: var(--font-title-weight);
  word-break: break-word;
}

.reading-entry-meta {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: var(--line-caption);
}

.reading-entry-state {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-section-title-size);
  font-weight: var(--font-title-weight);
}
