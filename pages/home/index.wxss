}

.library-home-date {
  margin-top: 16rpx;
  font-size: 23rpx;
}

.library-home-greeting {
  margin-top: 0;
  color: #fffdf7;
  font-family: "Songti SC", "STSong", serif;
  font-size: 48rpx;
  font-weight: 600;
}

.library-listening-sheet {
  min-height: 480rpx;
  margin-top: 28rpx;
  padding: 38rpx 42rpx;
  overflow: hidden;
  border: 2rpx solid rgba(244, 222, 183, 0.76);
  border-radius: 34rpx 34rpx 20rpx 20rpx;
  background:
    linear-gradient(110deg, rgba(255, 253, 247, 0.84) 0%, rgba(250, 244, 232, 0.84) 66%, rgba(239, 226, 200, 0.84) 100%);
  box-shadow: 0 22rpx 46rpx rgba(0, 0, 0, 0.32);
