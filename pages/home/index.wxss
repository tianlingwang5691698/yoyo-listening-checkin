.home-titlebar {
  padding: 76rpx 20rpx 42rpx;
  text-align: center;
}

.home-brand {
  font-size: var(--font-page-title-size);
  font-weight: var(--font-section-weight);
  letter-spacing: 0;
}

.home-subtitle {
  margin-top: 12rpx;
}

.mode-notice {
  margin: 0 20rpx 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: var(--control-muted-bg);
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.35;
  text-align: center;
  font-weight: var(--font-title-weight);
}

.mode-reminder {
  margin: 0 20rpx 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mode-reminder-actions {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mode-reminder-action {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--text-main);
  font-size: var(--font-caption-size);
  line-height: 60rpx;
  font-weight: var(--font-title-weight);
}

.mode-reminder-action.is-primary {
  background: var(--accent);
  color: var(--accent-contrast);
}

.mode-reminder-action::after {
  border: none;
}

.program-swiper {
  width: 100%;
  height: 660rpx;
}

.study-area-grid {
  margin: 0 20rpx 28rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.study-area-card {
  min-height: 132rpx;
  padding: 24rpx;
  background: var(--surface-raised);
}

.study-area-kicker {
  color: var(--accent-deep);
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: var(--font-title-weight);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.study-area-title {
  color: var(--text-strong);
  font-size: var(--font-card-title-size);
  line-height: 1.25;
  font-weight: var(--font-title-weight);
}

.study-area-meta {
  margin-top: 10rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.35;
}

.today-completed {
  margin: 0 20rpx 28rpx;
  padding: 26rpx 24rpx;
  background: var(--surface-raised);
}

.today-completed-title {
  color: var(--text-strong);
  font-size: var(--font-section-title-size);
  line-height: 1.3;
  font-weight: var(--font-title-weight);
}

.completed-list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.completed-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: var(--surface-subtle);
}

.completed-main {
  min-width: 0;
  flex: 1;
}

.completed-title {
  color: var(--text-main);
  font-size: var(--font-body-size);
  line-height: 1.3;
  font-weight: var(--font-title-weight);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.completed-meta,
.completed-empty {
  margin-top: 6rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.3;
}

.completed-state {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.home-section-heading {
  margin: 0 20rpx 18rpx;
  color: var(--text-strong);
  font-size: var(--font-section-title-size);
  line-height: 1.3;
  font-weight: var(--font-section-heading-weight);
}

.program-slide {
  min-height: 590rpx;
  margin: 0 10rpx;
  padding: 30rpx 28rpx;
  background: var(--surface-raised);
  overflow: hidden;
}

.program-slide.is-disabled {
  opacity: 0.5;
}

.slide-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.slide-name {
  color: var(--text-strong);
  font-size: var(--font-section-title-size);
  line-height: 1.3;
  font-weight: var(--font-title-weight);
}

.slide-state {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-section-title-size);
  line-height: 1;
  font-weight: var(--font-title-weight);
}

.slide-state.is-done,
.slide-state.is-waiting {
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.slide-title {
  margin-top: 44rpx;
  color: var(--text-strong);
  font-size: var(--font-page-title-size);
  line-height: 1.22;
  font-weight: var(--font-title-weight);
  word-break: break-word;
}

.slide-meta {
  margin-top: 16rpx;
}

.slide-line {
  width: 100%;
  height: 2rpx;
  margin-top: 22rpx;
  background: var(--control-muted-bg);
}

.slide-task-list {
  display: flex;
  flex-direction: column;
  margin-top: 8rpx;
}

.slide-task {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding-top: 12rpx;
  margin-top: 12rpx;
  border-top: 1rpx solid var(--border-soft);
  min-width: 0;
}

.slide-task.is-primary {
  padding-top: 14rpx;
}

.slide-task-main {
  min-width: 0;
  flex: 1;
}

.slide-task-title {
  color: var(--text-main);
  font-size: 27rpx;
  line-height: 1.25;
  font-weight: var(--font-section-weight);
  word-break: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.slide-task-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.2;
}

.slide-task-state {
  flex-shrink: 0;
  min-width: 64rpx;
  color: var(--accent-deep);
  text-align: right;
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.slide-task.is-disabled {
  opacity: 0.48;
}

.reading-entry {
  margin: 24rpx 20rpx 0;
  padding: 28rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: var(--surface-raised);
}

.reading-entry-main {
  min-width: 0;
  flex: 1;
}

.reading-entry-kicker {
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  line-height: 1.3;
  font-weight: var(--font-title-weight);
}

.reading-entry-title {
  margin-top: 10rpx;
  color: var(--text-strong);
  font-size: var(--font-section-title-size);
  line-height: 1.3;
  font-weight: var(--font-title-weight);
  word-break: break-word;
}

.reading-entry-meta {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: var(--line-caption);
}

.reading-entry-state {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-section-title-size);
  font-weight: var(--font-title-weight);
}
