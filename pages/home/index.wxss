.library-module-row > view > view { color: #2b211b; font-family: "Songti SC", "STSong", serif; font-size: 29rpx; line-height: 1.2; }
.library-module-row > view > text { display: block; margin-top: 8rpx; }
.library-module-row.is-listening { border-left: 6rpx solid #14283a; }
.library-module-row.is-reading { border-left: 6rpx solid #7f8c78; }
.library-module-row.is-grammar { border-left: 6rpx solid #b89562; }
.library-module-row.is-vocabulary { border-left: 6rpx solid #786b61; }
.library-module-row.is-writing { border-left: 6rpx solid #9a5e52; }
.library-module-row.is-speaking { border-left: 6rpx solid #536f77; }

.library-empty-note { margin: 22rpx 0; color: #6f675f; font-size: 24rpx; text-align: center; }

.library-identity-overlay {
  position: fixed;
  z-index: 1200;
  inset: 0;
  box-sizing: border-box;
  padding: 102rpx 52rpx calc(54rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background:
    radial-gradient(circle at 82% 18%, rgba(184, 149, 98, 0.13), transparent 31%),
    radial-gradient(circle at 16% 74%, rgba(113, 78, 55, 0.13), transparent 28%),
    linear-gradient(145deg, #211712 0%, #2f211a 48%, #18110e 100%);
  color: #faf5ea;
}

.library-identity-overlay::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.42;
  background:
    repeating-linear-gradient(90deg, transparent 0 41rpx, rgba(241, 207, 149, 0.022) 41rpx 42rpx),
    repeating-linear-gradient(0deg, transparent 0 41rpx, rgba(241, 207, 149, 0.018) 41rpx 42rpx);
}

.library-poster-frame {
  position: absolute;
  z-index: 0;
  top: 82rpx;
  right: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  border: 1rpx solid rgba(241, 207, 149, 0.24);
  pointer-events: none;
}

.library-poster-frame::before,
.library-poster-frame::after {
  content: "";
  position: absolute;
  width: 50rpx;
  height: 50rpx;
  border-color: #d2aa6c;
}

.library-poster-frame::before { top: -1rpx; left: -1rpx; border-top: 3rpx solid; border-left: 3rpx solid; }
.library-poster-frame::after { right: -1rpx; bottom: -1rpx; border-right: 3rpx solid; border-bottom: 3rpx solid; }

.library-poster-topline {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.library-poster-spine {
  min-width: 0;
  color: #e2bb7d;
  font-family: Avenir, Helvetica, sans-serif;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  line-height: 1.3;
}

.library-poster-spine text { color: rgba(250, 245, 234, 0.5); letter-spacing: 1rpx; }
.library-poster-skip { flex-shrink: 0; padding: 8rpx 0 8rpx 18rpx; color: rgba(250, 245, 234, 0.62); font-size: 22rpx; }

.library-poster-folio {
  position: absolute;
  z-index: 2;
  top: 166rpx;
  right: 52rpx;
  color: #d2aa6c;
  font-family: Avenir, Helvetica, sans-serif;
  font-size: 17rpx;
  letter-spacing: 2rpx;
  writing-mode: vertical-rl;
}

.library-poster-folio text { margin-top: 18rpx; color: rgba(250, 245, 234, 0.34); }

.library-poster-hero {
  position: relative;
  z-index: 2;
  margin-top: 160rpx;
  padding-left: 30rpx;
  border-left: 2rpx solid rgba(210, 170, 108, 0.72);
}

.library-poster-hero.is-guide { margin-top: 142rpx; }
.library-poster-eyebrow { color: #d2aa6c; font-family: Avenir, Helvetica, sans-serif; font-size: 18rpx; letter-spacing: 4rpx; line-height: 1.2; }

.library-poster-title {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  color: #fff9ed;
  font-family: "Songti SC", "STSong", serif;
  font-size: 72rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  line-height: 1.18;
  text-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
}

.library-poster-title.is-guide { font-size: 64rpx; }
.library-poster-copy { width: 470rpx; margin-top: 34rpx; color: rgba(250, 245, 234, 0.68); font-size: 25rpx; font-weight: 300; letter-spacing: 1rpx; line-height: 1.82; }

.library-poster-seal {
  position: absolute;
  z-index: 1;
  right: -70rpx;
  bottom: 350rpx;
  width: 410rpx;
  height: 410rpx;
  border: 1rpx solid rgba(210, 170, 108, 0.34);
  border-radius: 50%;
}

.library-poster-seal::before,
.library-poster-seal::after {
  content: "";
  position: absolute;
  border: 1rpx solid rgba(210, 170, 108, 0.22);
  border-radius: 50%;
}

.library-poster-seal::before { inset: 28rpx; }
.library-poster-seal::after { inset: 72rpx; }

.library-poster-seal-core {
  position: absolute;
  z-index: 1;
  inset: 118rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(210, 170, 108, 0.5);
  border-radius: 50%;
  background: rgba(210, 170, 108, 0.07);
  box-shadow: inset 0 0 36rpx rgba(210, 170, 108, 0.08);
}

.library-poster-wave { display: flex; align-items: center; gap: 7rpx; height: 70rpx; }
.library-poster-wave text { display: block; width: 3rpx; border-radius: 99rpx; background: #e2bb7d; animation: libraryPosterWave 1.8s ease-in-out infinite; }
.library-poster-wave text:nth-child(1), .library-poster-wave text:nth-child(7) { height: 20rpx; }
.library-poster-wave text:nth-child(2), .library-poster-wave text:nth-child(6) { height: 38rpx; animation-delay: -0.2s; }
.library-poster-wave text:nth-child(3), .library-poster-wave text:nth-child(5) { height: 56rpx; animation-delay: -0.4s; }
.library-poster-wave text:nth-child(4) { height: 68rpx; animation-delay: -0.6s; }

.library-poster-needle { position: absolute; z-index: 2; top: 36rpx; right: 92rpx; width: 2rpx; height: 174rpx; transform: rotate(-28deg); transform-origin: top; background: linear-gradient(#e2bb7d, rgba(226, 187, 125, 0.24)); }
.library-poster-needle::before { content: ""; position: absolute; top: -12rpx; left: -11rpx; width: 22rpx; height: 22rpx; border: 1rpx solid #e2bb7d; border-radius: 50%; background: #2b1e18; }
.library-poster-seal-caption { position: absolute; right: 96rpx; bottom: 42rpx; color: rgba(250, 245, 234, 0.38); font-size: 14rpx; letter-spacing: 2rpx; }

.library-poster-note {
  position: absolute;
  z-index: 2;
  right: 52rpx;
  bottom: 330rpx;
  left: 52rpx;
  width: 330rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(210, 170, 108, 0.3);
  color: rgba(250, 245, 234, 0.58);
  font-size: 21rpx;
  line-height: 1.65;
}

.library-poster-note text { display: block; margin-bottom: 10rpx; color: #d2aa6c; font-size: 15rpx; letter-spacing: 3rpx; }

.library-poster-membership {
  position: absolute;
  z-index: 2;
  right: 52rpx;
  bottom: 452rpx;
  left: 52rpx;
  display: grid;
  grid-template-columns: 90rpx minmax(0, 1fr);
  align-items: center;
  gap: 22rpx;
  padding: 22rpx;
  border-top: 1rpx solid rgba(210, 170, 108, 0.36);
  border-bottom: 1rpx solid rgba(210, 170, 108, 0.2);
  background: rgba(250, 245, 234, 0.035);
}

.library-poster-membership-mark { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border: 1rpx solid rgba(210, 170, 108, 0.7); color: #d2aa6c; font-family: Georgia, serif; font-size: 15rpx; letter-spacing: 1rpx; line-height: 1.15; text-align: center; box-sizing: border-box; }
.library-poster-membership-mark text { display: block; color: #d2aa6c; font-size: 15rpx; letter-spacing: 1rpx; }
.library-poster-membership text { display: block; color: #d2aa6c; font-size: 15rpx; letter-spacing: 3rpx; }
.library-poster-membership view view { margin-top: 8rpx; color: rgba(250, 245, 234, 0.55); font-size: 21rpx; line-height: 1.45; }

.library-poster-credit {
  width: 470rpx;
  margin-top: 22rpx;
  color: rgba(250, 245, 234, 0.7);
  font-size: 18rpx;
  line-height: 1.35;
  text-align: right;
}

.library-poster-credit text {
  display: block;
  color: #d2aa6c;
  font-size: 14rpx;
  letter-spacing: 2rpx;
}

.library-poster-credit view {
  margin-top: 5rpx;
}

.library-poster-dots { position: absolute; z-index: 3; bottom: calc(224rpx + env(safe-area-inset-bottom)); left: 0; right: 0; display: flex; justify-content: center; gap: 12rpx; }
.library-poster-dots view { width: 8rpx; height: 8rpx; border: 1rpx solid rgba(250, 245, 234, 0.32); border-radius: 50%; }
.library-poster-dots view.is-active { width: 28rpx; border-radius: 99rpx; border-color: #d2aa6c; background: #d2aa6c; }
.library-identity-overlay.is-page-1 .library-poster-dots { bottom: calc(326rpx + env(safe-area-inset-bottom)); }

.library-poster-next {
  position: absolute;
  z-index: 3;
  right: 52rpx;
  bottom: calc(64rpx + env(safe-area-inset-bottom));
  left: 52rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  height: 104rpx;
  padding: 0 34rpx;
  border: 1rpx solid #d2aa6c;
  background: linear-gradient(90deg, #d2aa6c, #efce91);
  color: #1f1712;
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.library-poster-next text:last-child { font-size: 38rpx; font-weight: 300; }

.library-poster-actions {
  position: absolute;
  z-index: 3;
  right: 52rpx;
  bottom: calc(54rpx + env(safe-area-inset-bottom));
  left: 52rpx;
  display: grid;
  gap: 14rpx;
}

.library-poster-actions button {
  display: grid;
  grid-template-columns: 48rpx minmax(0, 1fr) 36rpx;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 112rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 1rpx solid rgba(210, 170, 108, 0.55);
  border-radius: 0;
  background: rgba(250, 245, 234, 0.035);
  color: #faf5ea;
  text-align: left;
}

.library-poster-actions button::after { border: 0; }
.library-poster-actions button.is-primary { border-color: #d2aa6c; background: linear-gradient(90deg, #d2aa6c, #efce91); color: #1f1712; }
.library-role-index { color: #d2aa6c; font-family: Georgia, serif; font-size: 20rpx; }
.library-poster-actions button.is-primary .library-role-index { color: rgba(31, 23, 18, 0.55); }
.library-role-title, .library-role-copy { display: block; }
.library-role-title { font-family: "Songti SC", "STSong", serif; font-size: 27rpx; font-weight: 600; line-height: 1.2; }
.library-role-copy { margin-top: 9rpx; color: rgba(250, 245, 234, 0.48); font-size: 19rpx; font-weight: 400; line-height: 1.2; }
.library-poster-actions button.is-primary .library-role-copy { color: rgba(31, 23, 18, 0.58); }
.library-role-arrow { justify-self: end; font-size: 32rpx; font-weight: 300; }

@keyframes libraryPosterWave {
  0%, 100% { transform: scaleY(0.62); opacity: 0.55; }
  50% { transform: scaleY(1); opacity: 1; }
}

.library-mode-sheet button { height: 84rpx; padding: 0; border: 1rpx solid rgba(241, 207, 149, 0.54); background: transparent; color: #faf5ea; font-size: 25rpx; line-height: 82rpx; }
.library-mode-sheet button.is-primary { background: #f1cf95; color: #14283a; }
.library-mode-sheet { color: #2b211b; font-size: 24rpx; line-height: 1.5; }
.library-mode-sheet > view:last-child { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-top: 18rpx; }
.library-mode-sheet button { height: 66rpx; border-color: rgba(184, 149, 98, 0.62); color: #14283a; font-size: 22rpx; line-height: 64rpx; }

.library-home-page {
  min-height: 100vh;
  padding: 0 44rpx calc(190rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #1c140f;
}

.library-home-background {
  position: absolute;
  z-index: 0;
  top: -300rpx;
  left: 0;
  width: 100%;
  pointer-events: none;
}

.library-home-page::before {
  content: "";
  position: absolute;
  z-index: 0;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.1), transparent 30%, rgba(0, 0, 0, 0.08) 72%, rgba(0, 0, 0, 0.32));
}

.library-home-header,
.library-home-greeting,
.library-listening-sheet,
.library-desk-reveal,
.library-module-grid,
.library-empty-note,
.library-status-slip,
.library-nickname-sheet,
.library-mode-sheet {
