.library-wave-05,.library-wave-10,.library-wave-15 { height: 16rpx; }

.library-listening-goal {
  position: absolute;
  right: 28rpx;
  bottom: 26rpx;
  left: 44rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
