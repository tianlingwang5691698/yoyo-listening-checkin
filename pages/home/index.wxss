.library-timeline-time {
  position: absolute;
  top: 50%;
  right: -10rpx;
  width: 54rpx;
  height: 54rpx;
  margin-top: -27rpx;
  border: 1rpx solid #947244;
  border-radius: 50%;
  background: #f9f0dd;
  color: #80663c;
  font-size: 16rpx;
  line-height: 52rpx;
  text-align: center;
}

.library-listening-goal {
  right: 42rpx;
  bottom: 34rpx;
  left: 46rpx;
  width: 250rpx;
  padding: 18rpx 18rpx;
  border: 1rpx solid rgba(144, 108, 59, 0.24);
  border-radius: 18rpx;
  background: rgba(255, 253, 247, 0.46);
}

.library-goal-label {
  color: #655b4d;
  font-size: 21rpx;
}

.library-goal-value {
  margin-top: 8rpx;
  color: #14283a;
  font-family: "Songti SC", "STSong", serif;
  font-size: 36rpx;
}

.library-goal-value text {
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 22rpx;
}

.library-goal-ring {
  position: relative;
  box-sizing: border-box;
  width: 74rpx;
  height: 74rpx;
  border: 1rpx solid rgba(143, 107, 60, 0.42);
  border-radius: 50%;
  box-shadow: 0 4rpx 10rpx rgba(91, 66, 35, 0.12);
}

.library-goal-ring:not(.is-setup)::before {
  content: "";
  position: absolute;
  inset: 13rpx;
  border: 1rpx solid rgba(143, 107, 60, 0.28);
  border-radius: 50%;
  background: #f5ead5;
  box-shadow: inset 0 2rpx 5rpx rgba(91, 66, 35, 0.08);
}

.library-goal-ring:not(.is-setup)::after {
  content: "";
  position: absolute;
  top: 5rpx;
  left: 50%;
  width: 3rpx;
  height: 9rpx;
  margin-left: -1rpx;
  border-radius: 999rpx;
  background: #76542f;
}

.library-goal-ring.is-setup {
  box-sizing: border-box;
  border: 2rpx solid rgba(143, 107, 60, 0.54);
  background: rgba(255, 253, 247, 0.48);
  box-shadow: inset 0 0 0 5rpx rgba(184, 149, 98, 0.1);
}

.library-goal-ring.is-setup::before,
.library-goal-ring.is-setup::after {
  content: "";
  position: absolute;
  top: 22rpx;
  width: 18rpx;
  height: 25rpx;
  border: 2rpx solid #8f6b3c;
  background: rgba(255, 253, 247, 0.56);
}

.library-goal-ring.is-setup::before {
  left: 17rpx;
  border-radius: 5rpx 0 2rpx 3rpx;
}

.library-goal-ring.is-setup::after {
  right: 17rpx;
  border-radius: 0 5rpx 3rpx 2rpx;
}

.library-module-grid {
