.record-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.record-hero {
  background: var(--surface);
}

.record-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.record-eyebrow {
  color: var(--text-muted);
  font-size: var(--font-eyebrow-size);
  font-weight: var(--font-section-weight);
}

.record-title {
  margin-top: 12rpx;
}

.metric-switch {
  display: flex;
  gap: 10rpx;
  margin-top: 28rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
}

.metric-tab {
  flex: 1;
  min-height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: var(--text-muted);
  font-size: var(--font-body-size);
  font-weight: var(--font-title-weight);
}

.metric-tab.is-active {
  background: var(--text-strong);
  color: var(--text-inverse);
}

.metric-board {
  margin-top: 28rpx;
}

.record-hero {
  position: relative;
  overflow: hidden;
}

.streak-milestone {
  position: absolute;
  top: 128rpx;
  right: 32rpx;
  z-index: 2;
  pointer-events: none;
}

.streak-milestone-ring {
  position: absolute;
  inset: -20rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(196, 122, 44, 0.38);
  animation: streakRing 1.7s ease-out forwards;
}

.streak-milestone-badge {
  position: relative;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
  box-shadow: 0 16rpx 36rpx rgba(93, 70, 48, 0.14);
  animation: streakBadge 1.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
}

@keyframes streakRing {
  0% {
    opacity: 0;
    transform: scale(0.72);
  }
  28% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: scale(1.48);
  }
}

@keyframes streakBadge {
  0% {
    opacity: 0;
    transform: translateY(12rpx) scale(0.9);
  }
  24% {
    opacity: 1;
    transform: translateY(0) scale(1.04);
  }
  100% {
    opacity: 0;
    transform: translateY(-6rpx) scale(1);
  }
}

.metric-value {
  color: var(--text-strong);
  font-size: var(--font-display-size);
  line-height: 0.9;
  font-weight: var(--font-strong-number-weight);
}

.metric-label {
  margin-top: 16rpx;
  color: var(--text-muted);
  font-size: var(--font-body-size);
  font-weight: var(--font-section-weight);
}

.summary-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 28rpx;
}

.summary-item {
  min-height: 114rpx;
  padding: 18rpx 12rpx;
  border: 1rpx solid var(--border-soft);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.summary-value-wrap {
  min-height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.summary-value {
  color: var(--text-strong);
  font-size: var(--font-section-title-size);
  font-weight: var(--font-section-heading-weight);
}

.summary-value.is-duration {
  max-width: 100%;
  font-size: var(--font-body-size);
  line-height: 1.2;
  text-align: center;
  word-break: break-all;
}

.summary-label {
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  text-align: center;
}

.month-title {
  min-width: 150rpx;
  min-height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: var(--text-main);
  font-size: var(--font-body-size);
  font-weight: var(--font-title-weight);
}

.month-arrow {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  background: var(--control-muted-bg);
  font-size: var(--font-section-title-size);
}

.week-grid,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
}

.week-grid {
  margin-top: 26rpx;
}

.week-label {
  text-align: center;
  color: var(--text-soft);
  font-size: var(--font-eyebrow-size);
  font-weight: var(--font-title-weight);
}

.calendar-grid {
  margin-top: 14rpx;
}

.calendar-slide {
  min-height: 588rpx;
  padding: 22rpx 20rpx 26rpx;
  border: 1rpx solid var(--border-soft);
  border-radius: 28rpx;
  background: var(--surface-raised);
  box-shadow: var(--shadow-card);
}

.calendar-slide.is-disabled {
  opacity: 0.36;
}

.calendar-slide-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.calendar-cell {
  min-width: 0;
  height: 76rpx;
}

.calendar-cell.is-blank {
  opacity: 0;
}

.calendar-dot {
  width: 100%;
  height: 100%;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--calendar-cell-bg);
  color: var(--calendar-cell-text);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.calendar-cell.is-completed .calendar-dot {
  background: var(--calendar-completed-bg);
  color: var(--calendar-completed-text);
}

.calendar-cell.is-selected .calendar-dot {
  box-shadow: inset 0 0 0 4rpx var(--calendar-selected-ring);
}

.calendar-cell.is-today .calendar-dot {
  color: var(--text-strong);
}

.calendar-cell.is-catchup-target .calendar-dot {
  box-shadow: inset 0 0 0 4rpx var(--calendar-catchup-ring);
}

.theme-sky .calendar-slide {
  border-color: var(--border-strong);
}

.theme-sky .calendar-dot {
  border: 1rpx solid var(--border-soft);
}

.theme-sky .calendar-cell.is-today .calendar-dot {
  background: var(--accent-soft);
  color: var(--text-strong);
}

.theme-sky .calendar-cell.is-selected .calendar-dot {
  background: var(--surface-subtle);
}

.calendar-swipe-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 10rpx;
  color: var(--text-soft);
  font-size: var(--font-eyebrow-size);
  font-weight: var(--font-title-weight);
}

.swipe-mark {
  width: 28rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: var(--control-strong-bg);
}

.day-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.day-count {
  color: var(--text-soft);
  font-size: var(--font-eyebrow-size);
  font-weight: var(--font-title-weight);
}

.recent-card {
  margin-top: 22rpx;
}

.recent-day-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.recent-day-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.recent-day-row.is-active .recent-day-title,
.recent-day-row.is-active .recent-day-meta {
  color: var(--accent-deep);
}

.recent-day-title {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.recent-day-copy {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.recent-day-meta {
  flex-shrink: 0;
  color: var(--text-soft);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.report-row,
.catchup-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.report-item-card {
  border-bottom: 1rpx solid var(--border-soft);
}

.report-item-card:last-child {
  border-bottom: none;
}

.report-item-card .report-row {
  border-bottom: none;
}

.report-row:last-child,
.catchup-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.report-title,
.catchup-title {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.report-copy,
.catchup-copy {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.report-times {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.report-time {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--text-muted);
  font-size: var(--font-eyebrow-size);
  font-weight: var(--font-title-weight);
}

.catchup-purpose {
  margin-top: 8rpx;
  color: var(--text-soft);
  font-size: var(--font-caption-size);
}

.report-state,
.catchup-state {
  flex-shrink: 0;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
  text-align: right;
}

.report-state.is-done {
  color: var(--accent-deep);
}

.report-progress {
  margin-top: 6rpx;
  color: var(--text-soft);
  font-size: var(--font-eyebrow-size);
}

.attempt-detail-list {
  padding: 0 0 18rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.attempt-detail {
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 247, 241, 0.9);
}

.attempt-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.attempt-title,
.attempt-score {
  color: var(--text-main);
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: var(--font-title-weight);
}

.attempt-score {
  color: var(--accent-deep);
  white-space: nowrap;
}

.attempt-subscore,
.attempt-text,
.attempt-feedback {
  margin-top: 10rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.attempt-text,
.attempt-feedback {
  color: var(--text-main);
}

.attempt-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}

.attempt-button {
  margin: 0;
  min-width: 160rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: var(--accent-deep);
  font-size: 24rpx;
  line-height: 54rpx;
  font-weight: var(--font-title-weight);
}

.attempt-button::after {
  border: 0;
}

.catchup-row.is-done {
  opacity: 0.56;
}

.writing-history {
  margin-top: 22rpx;
}

.writing-attempt {
  border-bottom: 1rpx solid var(--border-soft);
}

.writing-attempt:last-child {
  border-bottom: none;
}

.writing-attempt-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 0;
}

.writing-title {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.writing-meta {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.writing-score {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.writing-detail {
  padding: 0 0 22rpx;
}

.writing-detail-title {
  margin-top: 16rpx;
  color: var(--text-main);
  font-size: 26rpx;
  font-weight: var(--font-title-weight);
}

.writing-text {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}
