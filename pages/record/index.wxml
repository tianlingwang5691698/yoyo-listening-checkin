<block wx:if="{{theme === 'library'}}">
  <view class="theme-{{theme}} language-{{language}} page-shell record-page library-growth-page">
    <view class="library-growth-shelf"></view>

    <view class="library-growth-ledger">
      <view class="library-ledger-top">
        <view>
          <view class="library-growth-kicker">{{texts.archive}}</view>
          <view class="library-growth-title">{{texts.title}}</view>
        </view>
        <view class="library-sync-seal">{{syncMode === 'cloud' ? texts.synced : texts.localState}}</view>
      </view>

      <view class="library-metric-tabs">
        <view class="library-metric-tab {{metricMode === 'streak' ? 'is-active' : ''}}" data-mode="streak" bindtap="switchMetric">{{texts.streak}}</view>
        <view class="library-metric-tab {{metricMode === 'total' ? 'is-active' : ''}}" data-mode="total" bindtap="switchMetric">{{texts.total}}</view>
      </view>

      <view class="library-ledger-hero">
        <view>
          <view class="library-hero-number">{{heroMetricValue}}</view>
          <view class="library-hero-label">{{heroMetricLabel}}{{texts.daySuffix}}</view>
        </view>
        <view class="library-archive-stamp">
          <view>{{stats.completedTasks || 0}}</view>
          <text>{{texts.task}}</text>
        </view>
      </view>

      <view class="library-streak-stamp" wx:if="{{streakMilestoneVisible}}">{{streakMilestoneLabel}}</view>

      <view class="library-ledger-stats">
        <view class="library-stat-cell">
          <view>{{stats.completedDays || 0}}</view>
          <text>{{texts.totalDays}}</text>
        </view>
        <view class="library-stat-cell">
          <view>{{stats.totalDurationText || totalDurationText}}</view>
          <text>{{texts.totalDuration}}</text>
        </view>
        <view class="library-stat-cell">
          <view>{{stats.completedTasks || 0}}</view>
          <text>{{texts.completedTasks}}</text>
        </view>
      </view>
    </view>

    <view class="library-debug-slip" wx:if="{{showCloudDebug && recordDebugLines.length}}">
      <view class="library-debug-title">{{texts.debugLibrary}}</view>
      <block wx:for="{{recordDebugLines}}" wx:key="*this">
        <text class="library-debug-line" selectable="{{true}}">{{item}}</text>
      </block>
    </view>

    <view class="library-date-index">
      <view class="library-section-head">
        <view>
          <view class="library-section-title">{{texts.dateIndex}}</view>
          <view class="library-section-copy">{{syncMode === 'cloud' ? texts.calendarCopy : texts.recentContent}}</view>
        </view>
      </view>
      <view class="library-month-bar">
        <view class="library-month-arrow" data-direction="-1" catchtap="switchMonth">‹</view>
        <picker mode="date" value="{{selectedDate}}" end="{{todayDate}}" bindchange="pickDate">
          <view class="library-month-title">{{calendarTitle}}</view>
        </picker>
        <view class="library-month-arrow" data-direction="1" catchtap="switchMonth">›</view>
      </view>
      <view class="library-week-grid">
        <block wx:for="{{weekLabels}}" wx:key="*this">
          <view>{{item}}</view>
        </block>
      </view>
      <view class="library-calendar-grid">
        <block wx:for="{{monthCells}}" wx:key="key">
          <view
            class="library-calendar-cell heat-{{item.intensity}} {{item.isBlank ? 'is-blank' : ''}} {{item.completed ? 'is-completed' : ''}} {{item.isToday ? 'is-today' : ''}} {{item.isSelected ? 'is-selected' : ''}} {{item.isCatchupTarget ? 'is-catchup-target' : ''}}"
            data-date="{{item.date}}"
            bindtap="selectDate"
          >
            <view wx:if="{{!item.isBlank}}">{{item.dayText}}</view>
          </view>
        </block>
      </view>
      <view class="library-index-hint">{{texts.tapDate}}</view>
    </view>

    <view class="library-catchup-slip" wx:if="{{catchupState.canCatchup}}">
      <view class="library-section-head">
        <view>
          <view class="library-section-title">{{texts.catchupStrip}}</view>
          <view class="library-section-copy">{{catchupCopy}}</view>
        </view>
        <view class="library-sync-seal">{{catchupStatusLabel}}</view>
      </view>
      <view class="library-catchup-row" wx:if="{{!catchupTasksLoaded}}" bindtap="loadCatchupTasks">
        <view class="library-bookmark-pin"></view>
        <view>
          <view class="library-row-title">{{texts.viewCatchup}}</view>
          <view class="library-row-copy">{{texts.catchupLoadCopy}}</view>
        </view>
        <view class="library-row-action">{{texts.view}}</view>
      </view>
      <block wx:for="{{catchupTasks}}" wx:key="taskId">
        <view class="library-catchup-row {{item.completedToday ? 'is-done' : ''}}" data-category="{{item.category}}" data-task-id="{{item.taskId}}" bindtap="openCatchupTask">
          <view class="library-bookmark-pin"></view>
          <view>
            <view class="library-row-title">{{item.categoryLabel}}</view>
            <view class="library-row-copy">{{item.displayTitle || item.title}}</view>
          </view>
          <view class="library-row-action">{{item.completedToday ? texts.lit : texts.continue}}</view>
        </view>
      </block>
    </view>

    <view class="library-dossier">
      <view class="library-section-head">
        <view>
          <view class="library-section-title">{{texts.dossier}}</view>
          <view class="library-section-copy">{{selectedDateLabel}} · {{selectedDaySummary.statusText}}</view>
        </view>
        <view class="library-dossier-meta">
          <view>{{selectedDaySummary.minutesText}}</view>
          <text>{{selectedDaySummary.completedCount}} / {{selectedDaySummary.totalCount}}</text>
          <view class="library-row-action" bindtap="openDailyDetail" data-date="{{selectedDate}}">{{texts.view}}</view>
        </view>
      </view>
    </view>
  </view>
</block>

<block wx:else>
<view class="theme-{{theme}} language-{{language}} page-shell record-page">
  <view class="record-hero product-hero">
    <view class="voyage-log-ribbon" wx:if="{{theme === 'voyage'}}"><text>☸</text></view>
    <view class="growth-hero-glow"></view>
    <view class="growth-hero-pattern">
      <view></view>
      <view></view>
      <view></view>
      <view></view>
      <view></view>
    </view>
    <view class="record-hero-top">
      <view>
        <view class="record-eyebrow">{{texts.growth}}</view>
        <view class="record-title type-page-title">{{texts.title}}</view>
      </view>
      <view class="status-badge">{{syncMode === 'cloud' ? texts.synced : texts.localState}}</view>
    </view>

    <view class="metric-switch">
      <view class="metric-tab {{metricMode === 'streak' ? 'is-active' : ''}}" data-mode="streak" bindtap="switchMetric">{{texts.streak}}</view>
      <view class="metric-tab {{metricMode === 'total' ? 'is-active' : ''}}" data-mode="total" bindtap="switchMetric">{{texts.total}}</view>
    </view>

    <view class="metric-board">
      <view>
        <view class="metric-value">{{heroMetricValue}}</view>
        <view class="metric-label">{{heroMetricLabel}}{{texts.daySuffix}}</view>
      </view>
      <view class="metric-orbit">
        <view class="orbit-ring"></view>
        <view class="orbit-core">{{stats.completedTasks || 0}}</view>
      </view>
    </view>

    <view class="streak-milestone" wx:if="{{streakMilestoneVisible}}">
      <view class="streak-milestone-ring"></view>
      <view class="streak-milestone-badge">{{streakMilestoneLabel}}</view>
    </view>

    <view class="summary-row growth-summary">
      <view class="summary-item">
        <view class="summary-value-wrap">
          <view class="summary-value">{{stats.completedDays || 0}}</view>
        </view>
        <view class="summary-label">{{texts.totalDays}}</view>
      </view>
      <view class="summary-item">
        <view class="summary-value-wrap">
          <view class="summary-value is-duration">{{stats.totalDurationText || totalDurationText}}</view>
        </view>
        <view class="summary-label">{{texts.totalDuration}}</view>
      </view>
      <view class="summary-item">
        <view class="summary-value-wrap">
          <view class="summary-value">{{stats.completedTasks || 0}}</view>
        </view>
        <view class="summary-label">{{texts.completedTasks}}</view>
      </view>
    </view>
  </view>

  <view class="record-debug" wx:if="{{showCloudDebug && recordDebugLines.length}}">
    <view class="record-debug-title">{{texts.debugPoint}}</view>
    <block wx:for="{{recordDebugLines}}" wx:key="*this">
      <text class="record-debug-line" selectable="{{true}}">{{item}}</text>
    </block>
  </view>

  <view class="calendar-card section-panel heatmap-card">
    <view class="voyage-calendar-compass" wx:if="{{theme === 'voyage'}}">◈</view>
    <view class="section-head">
      <view>
        <view class="type-section-title">{{texts.calendarHeatmap}}</view>
        <view class="section-copy">{{texts.calendarCopy}}</view>
      </view>
    </view>
    <view class="calendar-slide">
      <view class="calendar-slide-head">
        <view class="month-arrow" data-direction="-1" catchtap="switchMonth">‹</view>
        <picker mode="date" value="{{selectedDate}}" end="{{todayDate}}" bindchange="pickDate">
          <view class="month-title">{{calendarTitle}}</view>
        </picker>
        <view class="month-arrow" data-direction="1" catchtap="switchMonth">›</view>
      </view>
      <view class="week-grid">
        <block wx:for="{{weekLabels}}" wx:key="*this">
          <view class="week-label">{{item}}</view>
        </block>
      </view>
      <view class="calendar-grid">
        <block wx:for="{{monthCells}}" wx:key="key">
          <view
            class="calendar-cell heat-{{item.intensity}} {{item.isBlank ? 'is-blank' : ''}} {{item.completed ? 'is-completed' : ''}} {{item.isToday ? 'is-today' : ''}} {{item.isSelected ? 'is-selected' : ''}} {{item.isCatchupTarget ? 'is-catchup-target' : ''}}"
            data-date="{{item.date}}"
            bindtap="selectDate"
          >
            <view wx:if="{{!item.isBlank}}" class="calendar-dot">{{item.dayText}}</view>
          </view>
        </block>
      </view>
    </view>
    <view class="calendar-swipe-hint">
      <view class="swipe-mark"></view>
      <view class="swipe-copy">{{texts.tapDate}}</view>
      <view class="swipe-mark"></view>
    </view>
  </view>

  <view class="catchup section-panel growth-track">
    <view class="row-between">
      <view>
        <view class="type-section-title">{{texts.learningTrack}}</view>
        <view class="section-copy">{{catchupCopy}}</view>
        <view class="catchup-purpose">{{texts.catchupPurpose}}</view>
      </view>
      <view class="status-badge {{catchupStatusClass}}">{{catchupStatusLabel}}</view>
    </view>
    <block wx:if="{{catchupState.canCatchup}}">
      <view class="track-rail">
        <view class="catchup-row track-node" wx:if="{{!catchupTasksLoaded}}" bindtap="loadCatchupTasks">
          <view class="track-pin"></view>
          <view class="track-main">
            <view class="track-label">{{texts.catchupStrip}}</view>
            <view class="catchup-title">{{texts.viewCatchup}}</view>
            <view class="catchup-copy">{{texts.catchupLoadCopy}}</view>
          </view>
          <view class="catchup-state">{{texts.view}}</view>
        </view>
        <block wx:for="{{catchupTasks}}" wx:key="taskId">
          <view class="catchup-row track-node {{item.completedToday ? 'is-done' : ''}}" data-category="{{item.category}}" data-task-id="{{item.taskId}}" bindtap="openCatchupTask">
            <view class="track-pin"></view>
            <view class="track-main">
              <view class="track-label">{{item.playStepText}}</view>
              <view class="catchup-title">{{item.categoryLabel}}</view>
              <view class="catchup-copy">{{item.displayTitle || item.title}}</view>
            </view>
            <view class="catchup-state">{{item.completedToday ? texts.lit : texts.continue}}</view>
          </view>
        </block>
      </view>
    </block>
  </view>

  <view class="day-card section-panel growth-report">
    <view class="row-between report-head">
      <view>
        <view class="type-section-title">{{texts.reportCard}}</view>
        <view class="section-copy">{{selectedDateLabel}} · {{selectedDaySummary.statusText}}</view>
      </view>
      <view class="day-meta">
        <view class="pill">{{selectedDaySummary.minutesText}}</view>
        <view class="day-count">{{selectedDaySummary.completedCount}} / {{selectedDaySummary.totalCount}}</view>
        <view class="detail-link" bindtap="openDailyDetail" data-date="{{selectedDate}}">{{texts.view}}</view>
      </view>
    </view>
  </view>
</view>
</block>
