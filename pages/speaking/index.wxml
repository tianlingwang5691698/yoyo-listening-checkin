<view class="theme-{{theme}} language-{{language}} page-shell library-speaking-page" wx:if="{{theme === 'library'}}">
  <view class="library-speaking-header">
    <view>
      <view class="library-speaking-kicker">{{texts.corner}}</view>
      <view class="library-speaking-title">{{pageTitle}}</view>
      <view class="library-speaking-copy">{{pageCopy}}</view>
    </view>
    <view class="library-speaking-seal"><view>VOICE</view><text>ROOM</text></view>
  </view>

  <block wx:if="{{viewMode === 'home'}}">
    <view class="speaking-mode-list is-library">
      <view class="speaking-mode-row is-repeat" hover-class="is-pressed" bindtap="openRepeatPractice">
        <view class="speaking-mode-icon"><view class="mode-play"></view><view class="mode-wave"><text></text><text></text><text></text></view></view>
        <view class="speaking-mode-copy">
          <view class="speaking-mode-title">{{texts.gradedRepeat}}</view>
          <view class="speaking-mode-meta">{{texts.repeatModeMeta}}</view>
          <view class="speaking-mode-detail">Pre A1–B2 · {{texts.audioParagraph}}</view>
        </view>
        <view class="speaking-mode-arrow">›</view>
      </view>

      <view class="speaking-mode-row is-ielts" hover-class="is-pressed" bindtap="openIeltsSpeaking">
        <view class="speaking-mode-icon"><view class="mode-part">P</view></view>
        <view class="speaking-mode-copy">
          <view class="speaking-mode-title">{{texts.ieltsSpeaking}}</view>
          <view class="speaking-mode-meta">Part 1 · Part 2 · Part 3</view>
          <view class="speaking-mode-detail">Cambridge IELTS 10–21</view>
        </view>
        <view class="speaking-mode-state">{{ieltsLoading ? texts.loading : (ieltsTests.length ? ieltsTests.length + texts.setUnit : '')}}</view>
        <view class="speaking-mode-arrow">{{ieltsExpanded ? '⌃' : '›'}}</view>
      </view>
    </view>
    <view class="ielts-test-list" wx:if="{{ieltsExpanded}}">
      <block wx:for="{{ieltsTests}}" wx:key="id">
        <view class="ielts-book-header" wx:if="{{item.showBookHeader}}">{{item.bookLabel}}</view>
        <view class="ielts-test-row" data-item-id="{{item.id}}" bindtap="selectIeltsTest">
          <view><view class="ielts-test-title">{{item.title}}</view><view class="ielts-test-meta">{{item.meta}} · Part 1-3</view></view>
          <view class="ielts-test-arrow">›</view>
        </view>
      </block>
    </view>
  </block>

  <block wx:elif="{{viewMode === 'repeat-select'}}">
    <view class="library-practice-nav" bindtap="backToSpeakingHome">‹ {{texts.backSpeaking}}</view>
    <view class="repeat-selector is-library">
      <view class="repeat-selector-section">
        <view class="repeat-selector-heading"><view>{{texts.selectLevel}}</view><text>{{selectedLevel}}</text></view>
        <view class="library-level-tabs">
          <view class="library-level-tab {{selectedLevel === item.id ? 'is-active' : ''}}" wx:for="{{levels}}" wx:key="id" data-level="{{item.id}}" bindtap="selectSpeakingLevel">{{item.label}}</view>
        </view>
      </view>
      <view class="repeat-selector-section">
        <view class="repeat-selector-heading"><view>{{texts.selectSeries}}</view><text>{{repeatSeries.length}}{{texts.seriesUnit}}</text></view>
        <scroll-view class="repeat-series-scroll" scroll-x="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
          <view class="repeat-series-row">
            <view class="repeat-series-tab {{selectedSeriesId === item.id ? 'is-active' : ''}}" wx:for="{{repeatSeries}}" wx:key="id" data-series-id="{{item.id}}" bindtap="selectRepeatSeries">{{item.title}}</view>
          </view>
        </scroll-view>
      </view>
      <view class="repeat-selector-section">
        <view class="repeat-selector-heading"><view>{{texts.selectAudio}}</view><text>{{repeatAudios.length}}{{texts.audioUnit}}</text></view>
        <view class="repeat-load-state" wx:if="{{repeatAudioLoading}}">{{texts.loadingAudio}}</view>
        <view wx:elif="{{repeatAudios.length}}" class="repeat-audio-picker" hover-class="is-pressed" bindtap="openRepeatAudioPicker">
          <view class="repeat-audio-play"><view></view></view>
          <view class="repeat-audio-copy"><view>{{selectedAudio.displayTitle}}</view><text>{{selectedAudio.meta}}</text></view>
          <view class="repeat-picker-arrow">⌄</view>
        </view>
        <view class="repeat-load-state" wx:else>{{texts.noAudio}}</view>
      </view>
      <view class="repeat-selector-section">
        <view class="repeat-selector-heading"><view>{{texts.selectParagraph}}</view><text>{{repeatParagraphs.length}}{{texts.paragraphUnit}}</text></view>
        <view class="repeat-load-state" wx:if="{{repeatParagraphLoading}}">{{texts.loadingParagraphs}}</view>
        <scroll-view class="repeat-paragraph-scroll" wx:elif="{{repeatParagraphs.length}}" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
          <view class="repeat-paragraph-list">
            <view class="repeat-paragraph-row {{selectedParagraphId === item.id ? 'is-active' : ''}}" wx:for="{{repeatParagraphs}}" wx:key="id" data-paragraph-id="{{item.id}}" bindtap="selectRepeatParagraph">
              <view class="repeat-paragraph-top"><view>{{item.title}}</view><text>{{item.meta}}</text></view>
              <view class="repeat-paragraph-preview">{{item.preview}}</view>
            </view>
          </view>
        </scroll-view>
        <view class="repeat-load-state is-error" wx:elif="{{repeatLoadError}}">{{repeatLoadError}}</view>
        <view class="repeat-load-state" wx:else>{{texts.noTranscript}}</view>
      </view>
      <button class="repeat-start-button {{!selectedParagraphId || repeatParagraphLoading ? 'is-disabled' : ''}}" disabled="{{!selectedParagraphId || repeatParagraphLoading}}" hover-class="is-pressed" bindtap="startSelectedRepeat">{{texts.startParagraph}}</button>
    </view>
  </block>

  <block wx:else>
    <view class="library-practice-nav" bindtap="backToSpeakingHome">‹ {{ieltsMode ? texts.backSpeaking : texts.backSelection}}</view>

    <block wx:if="{{activeExercise && exercises.length}}">
      <view class="library-prompt-sheet" wx:if="{{ieltsMode}}">
        <view class="library-sheet-rule"></view>
        <view class="ielts-session-intro" wx:if="{{!ieltsSessionStarted}}">
          <view class="ielts-intro-part">PART 1</view>
          <view class="ielts-intro-title">{{activeIeltsQuestion.topicTitle || texts.ieltsOpeningTitle}}</view>
          <view class="ielts-intro-copy">{{texts.ieltsOpeningCopy}}</view>
          <view class="ielts-intro-script prompt-replay {{ieltsIntroPlaying ? 'is-speaking' : ''}} {{ieltsIntroLoading ? 'is-loading' : ''}}" hover-class="is-pressed" bindtap="playIeltsIntro">{{ieltsIntroText}}</view>
          <button class="ielts-session-start" hover-class="is-pressed" bindtap="startIeltsSession">{{texts.startPartOne}}</button>
        </view>

        <view class="ielts-focus" wx:else>
          <view class="ielts-focus-head">
            <view><view class="ielts-focus-part">{{activeIeltsQuestion.partLabel}}</view><view class="ielts-focus-topic" wx:if="{{activeIeltsQuestion.topicTitle}}">{{activeIeltsQuestion.topicTitle}}</view></view>
            <view class="ielts-focus-count">{{activeIeltsQuestion.partQuestionIndex}} / {{activeIeltsQuestion.partQuestionTotal}}</view>
          </view>

          <view class="ielts-listen-row">
            <button class="ielts-play-button {{questionPlaying ? 'is-playing' : ''}} {{questionLoading ? 'is-loading' : ''}}" disabled="{{recording || submitting}}" aria-label="{{texts.listenQuestionShort}}" data-exercise-id="{{activeIeltsQuestion.exerciseId}}" data-view-key="{{activeIeltsQuestion.viewKey}}" data-prompt="{{activeIeltsQuestion.prompt}}" catchtap="playIeltsQuestion"><view class="ielts-play-icon"></view><view class="ielts-play-wave"><text></text><text></text><text></text></view></button>
            <view class="ielts-listen-copy"><view>{{questionLoading ? texts.preparing : (questionPlaying ? texts.questionPlaying : (ieltsPromptReady ? texts.relistenQuestion : texts.listenQuestionShort))}}</view><text>{{texts.questionListenHint}}</text></view>
            <button class="ielts-reveal-button" wx:if="{{activeIeltsQuestion.type === 'question'}}" data-exercise-id="{{activeIeltsQuestion.exerciseId}}" data-view-key="{{activeIeltsQuestion.viewKey}}" data-prompt="{{activeIeltsQuestion.prompt}}" catchtap="selectIeltsQuestion">{{ieltsQuestionRevealed ? texts.hideQuestion : texts.showQuestion}}</button>
          </view>

          <view class="ielts-focus-prompt" wx:if="{{activeIeltsQuestion.type === 'question'}}">
            <view class="ielts-focus-question prompt-replay {{ieltsQuestionRevealed && questionPlaying ? 'is-speaking' : ''}}" wx:if="{{ieltsQuestionRevealed}}">{{activeIeltsQuestion.prompt}}</view>
            <view class="ielts-focus-hidden" wx:else>{{texts.questionListenHint}}</view>
          </view>

          <view class="ielts-cue-card is-active" wx:else>
            <view class="ielts-cue-task ielts-cue-line prompt-replay {{questionPlaying && ieltsCueLineIndex === 0 ? 'is-speaking' : ''}}">{{activeIeltsQuestion.task}}</view>
            <view class="ielts-cue-label ielts-cue-line prompt-replay {{questionPlaying && ieltsCueLineIndex === 1 ? 'is-speaking' : ''}}">{{texts.youShouldSay}}</view>
            <view class="ielts-cue-point ielts-cue-line prompt-replay {{questionPlaying && ieltsCueLineIndex === cueItemIndex + 2 ? 'is-speaking' : ''}}" wx:for="{{activeIeltsQuestion.cuePoints}}" wx:for-item="cueItem" wx:for-index="cueItemIndex" wx:key="*this"><text>•</text><view>{{cueItem}}</view></view>
            <view class="ielts-cue-closing ielts-cue-line prompt-replay {{questionPlaying && ieltsCueLineIndex === activeIeltsQuestion.cuePoints.length + 2 ? 'is-speaking' : ''}}">{{activeIeltsQuestion.closingPrompt}}</view>
          </view>

          <view class="ielts-answer-zone">
            <view class="ielts-answer-zone-head"><view>{{texts.ieltsAnswerArea}}</view><text>{{ieltsPromptReady ? texts.ieltsAnswerReady : texts.ieltsAnswerLocked}}</text></view>
            <button class="ielts-focus-answer {{recording ? 'is-recording' : ''}}" disabled="{{!ieltsPromptReady || submitting || questionLoading || questionPlaying}}" data-exercise-id="{{activeIeltsQuestion.exerciseId}}" data-view-key="{{activeIeltsQuestion.viewKey}}" data-prompt="{{activeIeltsQuestion.prompt}}" catchtap="toggleIeltsAnswer">{{recording ? texts.endAnswer : (submitting ? texts.scoring : (tempFilePath ? texts.restartAnswer : texts.startAnswer))}}</button>
            <button class="ielts-score-button is-focus" wx:if="{{tempFilePath && !recording && !submitting}}" catchtap="scoreIeltsAnswer">{{texts.scoreAnswer}}</button>
            <view class="ielts-inline-state is-focus" wx:if="{{recording || tempFilePath || submitting || result || errorText}}">
              <view class="ielts-inline-error" wx:if="{{errorText}}">{{errorText}}</view>
              <view class="ielts-inline-result" wx:elif="{{result}}"><text>{{texts.result}} {{result.score || 0}}{{texts.scoreUnit}}</text><view>{{texts.accuracy}} {{result.accuracy || 0}} · {{texts.fluency}} {{result.fluency || 0}} · {{texts.completeness}} {{result.completion || 0}}</view></view>
              <view class="ielts-inline-progress" wx:else>{{submitting ? texts.scoring : (recording ? texts.recording : texts.recorded + recordDurationText)}}</view>
            </view>
          </view>

          <view class="ielts-question-nav">
            <button class="{{ieltsQuestionIndex === 0 ? 'is-disabled' : ''}}" disabled="{{ieltsQuestionIndex === 0}}" bindtap="previousIeltsQuestion">‹ {{texts.previousQuestion}}</button>
            <button class="is-next {{ieltsQuestionIndex >= ieltsQuestionSequence.length - 1 ? 'is-disabled' : ''}}" disabled="{{ieltsQuestionIndex >= ieltsQuestionSequence.length - 1}}" bindtap="nextIeltsQuestion">{{texts.nextQuestion}} ›</button>
          </view>
        </view>
        <view class="ielts-source-toggle" wx:if="{{ieltsMode && ieltsSourceImages.length}}" bindtap="toggleIeltsSource">
          <view><view class="ielts-source-title">{{texts.originalPage}}</view><view class="ielts-source-meta">{{ieltsSourceImages.length}} {{texts.pageUnit}}</view></view>
          <view class="ielts-source-arrow">{{ieltsSourceExpanded ? '⌃' : '⌄'}}</view>
        </view>
        <view class="ielts-source-pages" wx:if="{{ieltsMode && ieltsSourceExpanded && ieltsSourceImages.length}}">
          <image class="ielts-source-page" wx:for="{{ieltsSourceImages}}" wx:key="cloudPath" src="{{item.src}}" data-src="{{item.src}}" bindtap="previewIeltsSource" mode="widthFix" show-menu-by-longpress="{{true}}" />
        </view>
      </view>

      <view class="repeat-sentence-list is-library" wx:if="{{!ieltsMode}}">
        <view class="repeat-sentence-item {{activeId === item.id ? 'is-active' : ''}}" wx:for="{{exercises}}" wx:key="id">
          <view class="repeat-sentence-main" data-id="{{item.id}}" hover-class="is-pressed" bindtap="selectExercise">
            <view class="repeat-sentence-number">{{index + 1}}</view>
            <view class="repeat-sentence-text prompt-replay {{activeId === item.id && questionPlaying ? 'is-speaking' : ''}} {{activeId === item.id && questionLoading ? 'is-loading' : ''}}">{{item.prompt}}</view>
            <view class="repeat-sentence-play {{activeId === item.id && (questionPlaying || questionLoading) ? 'is-playing' : ''}}"><view></view><text></text><text></text><text></text></view>
          </view>
          <view class="repeat-inline-actions" wx:if="{{activeId === item.id && repeatPromptReady && !questionPlaying && !questionLoading}}">
            <button class="repeat-inline-record {{recording ? 'is-recording' : ''}}" wx:if="{{!tempFilePath && !result && !submitting}}" hover-class="is-pressed" bindtap="toggleRepeatRecording">{{recording ? texts.endRepeat : texts.startRepeat}}</button>
            <view class="repeat-inline-choice" wx:if="{{tempFilePath && !recording && !submitting}}">
              <button class="repeat-inline-choice-button is-secondary" hover-class="is-pressed" bindtap="restartRepeatRecording">{{texts.restartRepeat}}</button>
              <button class="repeat-inline-choice-button is-primary" hover-class="is-pressed" bindtap="replayRepeatRecording">{{answerPlaying ? texts.stopPlayback : texts.replayRecording}}</button>
            </view>
            <view class="repeat-inline-state" wx:if="{{recording || tempFilePath || submitting || result || errorText}}">
              <view class="repeat-inline-error" wx:if="{{errorText}}">{{errorText}}</view>
              <view class="repeat-inline-result" wx:elif="{{result}}"><text>{{texts.result}} {{result.score || 0}}{{texts.scoreUnit}}</text><view>{{texts.accuracy}} {{result.accuracy || 0}} · {{texts.fluency}} {{result.fluency || 0}} · {{texts.completeness}} {{result.completion || 0}}</view></view>
              <view class="repeat-inline-progress" wx:else>{{submitting ? texts.scoring : (recording ? texts.recording : texts.recorded + recordDurationText)}}</view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view class="library-speaking-empty" wx:else>
      <view class="library-empty-box"><view class="library-empty-mic"></view></view>
      <view class="library-empty-title">{{texts.empty}}</view>
    </view>
  </block>
</view>

<view class="theme-{{theme}} language-{{language}} page-shell speaking-page" wx:else>
  <view class="speaking-header">
    <view class="speaking-title">{{pageTitle}}</view>
    <view class="speaking-copy">{{pageCopy}}</view>
  </view>

  <block wx:if="{{viewMode === 'home'}}">
    <view class="speaking-mode-list">
      <view class="speaking-mode-row is-repeat" hover-class="is-pressed" bindtap="openRepeatPractice">
        <view class="speaking-mode-icon"><view class="mode-play"></view><view class="mode-wave"><text></text><text></text><text></text></view></view>
        <view class="speaking-mode-copy">
          <view class="speaking-mode-title">{{texts.gradedRepeat}}</view>
          <view class="speaking-mode-meta">{{texts.repeatModeMeta}}</view>
          <view class="speaking-mode-detail">Pre A1–B2 · {{texts.audioParagraph}}</view>
        </view>
        <view class="speaking-mode-arrow">›</view>
      </view>

      <view class="speaking-mode-row is-ielts" hover-class="is-pressed" bindtap="openIeltsSpeaking">
        <view class="speaking-mode-icon"><view class="mode-part">P</view></view>
        <view class="speaking-mode-copy">
          <view class="speaking-mode-title">{{texts.ieltsSpeaking}}</view>
          <view class="speaking-mode-meta">Part 1 · Part 2 · Part 3</view>
          <view class="speaking-mode-detail">Cambridge IELTS 10–21</view>
        </view>
        <view class="speaking-mode-state">{{ieltsLoading ? texts.loading : (ieltsTests.length ? ieltsTests.length + texts.setUnit : '')}}</view>
        <view class="speaking-mode-arrow">{{ieltsExpanded ? '⌃' : '›'}}</view>
      </view>
    </view>
    <view class="ielts-test-list" wx:if="{{ieltsExpanded}}">
      <block wx:for="{{ieltsTests}}" wx:key="id">
        <view class="ielts-book-header" wx:if="{{item.showBookHeader}}">{{item.bookLabel}}</view>
        <view class="ielts-test-row" data-item-id="{{item.id}}" bindtap="selectIeltsTest">
          <view><view class="ielts-test-title">{{item.title}}</view><view class="ielts-test-meta">{{item.meta}} · Part 1-3</view></view>
          <view class="ielts-test-arrow">›</view>
        </view>
      </block>
    </view>
  </block>

  <block wx:elif="{{viewMode === 'repeat-select'}}">
    <view class="speaking-practice-nav" bindtap="backToSpeakingHome">‹ {{texts.backSpeaking}}</view>
    <view class="repeat-selector">
      <view class="repeat-selector-section">
        <view class="repeat-selector-heading"><view>{{texts.selectLevel}}</view><text>{{selectedLevel}}</text></view>
        <view class="speaking-level-tabs">
          <view class="speaking-level-tab {{selectedLevel === item.id ? 'is-active' : ''}}" wx:for="{{levels}}" wx:key="id" data-level="{{item.id}}" bindtap="selectSpeakingLevel">{{item.label}}</view>
        </view>
      </view>
      <view class="repeat-selector-section">
        <view class="repeat-selector-heading"><view>{{texts.selectSeries}}</view><text>{{repeatSeries.length}}{{texts.seriesUnit}}</text></view>
        <scroll-view class="repeat-series-scroll" scroll-x="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
          <view class="repeat-series-row">
            <view class="repeat-series-tab {{selectedSeriesId === item.id ? 'is-active' : ''}}" wx:for="{{repeatSeries}}" wx:key="id" data-series-id="{{item.id}}" bindtap="selectRepeatSeries">{{item.title}}</view>
          </view>
        </scroll-view>
      </view>
      <view class="repeat-selector-section">
        <view class="repeat-selector-heading"><view>{{texts.selectAudio}}</view><text>{{repeatAudios.length}}{{texts.audioUnit}}</text></view>
        <view class="repeat-load-state" wx:if="{{repeatAudioLoading}}">{{texts.loadingAudio}}</view>
        <view wx:elif="{{repeatAudios.length}}" class="repeat-audio-picker" hover-class="is-pressed" bindtap="openRepeatAudioPicker">
          <view class="repeat-audio-play"><view></view></view>
          <view class="repeat-audio-copy"><view>{{selectedAudio.displayTitle}}</view><text>{{selectedAudio.meta}}</text></view>
          <view class="repeat-picker-arrow">⌄</view>
        </view>
        <view class="repeat-load-state" wx:else>{{texts.noAudio}}</view>
      </view>
      <view class="repeat-selector-section">
        <view class="repeat-selector-heading"><view>{{texts.selectParagraph}}</view><text>{{repeatParagraphs.length}}{{texts.paragraphUnit}}</text></view>
        <view class="repeat-load-state" wx:if="{{repeatParagraphLoading}}">{{texts.loadingParagraphs}}</view>
        <scroll-view class="repeat-paragraph-scroll" wx:elif="{{repeatParagraphs.length}}" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
          <view class="repeat-paragraph-list">
            <view class="repeat-paragraph-row {{selectedParagraphId === item.id ? 'is-active' : ''}}" wx:for="{{repeatParagraphs}}" wx:key="id" data-paragraph-id="{{item.id}}" bindtap="selectRepeatParagraph">
              <view class="repeat-paragraph-top"><view>{{item.title}}</view><text>{{item.meta}}</text></view>
              <view class="repeat-paragraph-preview">{{item.preview}}</view>
            </view>
          </view>
        </scroll-view>
        <view class="repeat-load-state is-error" wx:elif="{{repeatLoadError}}">{{repeatLoadError}}</view>
        <view class="repeat-load-state" wx:else>{{texts.noTranscript}}</view>
      </view>
      <button class="repeat-start-button {{!selectedParagraphId || repeatParagraphLoading ? 'is-disabled' : ''}}" disabled="{{!selectedParagraphId || repeatParagraphLoading}}" hover-class="is-pressed" bindtap="startSelectedRepeat">{{texts.startParagraph}}</button>
    </view>
  </block>

  <block wx:else>
    <view class="speaking-practice-nav" bindtap="backToSpeakingHome">‹ {{ieltsMode ? texts.backSpeaking : texts.backSelection}}</view>

      <view class="voice-cabin {{ieltsMode ? 'card' : 'is-repeat-cabin'}}">
      <view class="cabin-glow"></view>
        <view class="prompt-panel" wx:if="{{ieltsMode}}">
          <view class="ielts-exam-sheet">
            <view class="ielts-session-intro" wx:if="{{!ieltsSessionStarted}}">
              <view class="ielts-intro-part">PART 1</view>
              <view class="ielts-intro-title">{{activeIeltsQuestion.topicTitle || texts.ieltsOpeningTitle}}</view>
              <view class="ielts-intro-copy">{{texts.ieltsOpeningCopy}}</view>
              <view class="ielts-intro-script prompt-replay {{ieltsIntroPlaying ? 'is-speaking' : ''}} {{ieltsIntroLoading ? 'is-loading' : ''}}" hover-class="is-pressed" bindtap="playIeltsIntro">{{ieltsIntroText}}</view>
              <button class="ielts-session-start" hover-class="is-pressed" bindtap="startIeltsSession">{{texts.startPartOne}}</button>
            </view>

            <view class="ielts-focus" wx:else>
              <view class="ielts-focus-head">
                <view><view class="ielts-focus-part">{{activeIeltsQuestion.partLabel}}</view><view class="ielts-focus-topic" wx:if="{{activeIeltsQuestion.topicTitle}}">{{activeIeltsQuestion.topicTitle}}</view></view>
                <view class="ielts-focus-count">{{activeIeltsQuestion.partQuestionIndex}} / {{activeIeltsQuestion.partQuestionTotal}}</view>
              </view>

              <view class="ielts-listen-row">
                <button class="ielts-play-button {{questionPlaying ? 'is-playing' : ''}} {{questionLoading ? 'is-loading' : ''}}" disabled="{{recording || submitting}}" aria-label="{{texts.listenQuestionShort}}" data-exercise-id="{{activeIeltsQuestion.exerciseId}}" data-view-key="{{activeIeltsQuestion.viewKey}}" data-prompt="{{activeIeltsQuestion.prompt}}" catchtap="playIeltsQuestion"><view class="ielts-play-icon"></view><view class="ielts-play-wave"><text></text><text></text><text></text></view></button>
                <view class="ielts-listen-copy"><view>{{questionLoading ? texts.preparing : (questionPlaying ? texts.questionPlaying : (ieltsPromptReady ? texts.relistenQuestion : texts.listenQuestionShort))}}</view><text>{{texts.questionListenHint}}</text></view>
                <button class="ielts-reveal-button" wx:if="{{activeIeltsQuestion.type === 'question'}}" data-exercise-id="{{activeIeltsQuestion.exerciseId}}" data-view-key="{{activeIeltsQuestion.viewKey}}" data-prompt="{{activeIeltsQuestion.prompt}}" catchtap="selectIeltsQuestion">{{ieltsQuestionRevealed ? texts.hideQuestion : texts.showQuestion}}</button>
              </view>

              <view class="ielts-focus-prompt" wx:if="{{activeIeltsQuestion.type === 'question'}}">
                <view class="ielts-focus-question prompt-replay {{ieltsQuestionRevealed && questionPlaying ? 'is-speaking' : ''}}" wx:if="{{ieltsQuestionRevealed}}">{{activeIeltsQuestion.prompt}}</view>
                <view class="ielts-focus-hidden" wx:else>{{texts.questionListenHint}}</view>
              </view>

              <view class="ielts-cue-card is-active" wx:else>
                <view class="ielts-cue-task ielts-cue-line prompt-replay {{questionPlaying && ieltsCueLineIndex === 0 ? 'is-speaking' : ''}}">{{activeIeltsQuestion.task}}</view>
                <view class="ielts-cue-label ielts-cue-line prompt-replay {{questionPlaying && ieltsCueLineIndex === 1 ? 'is-speaking' : ''}}">{{texts.youShouldSay}}</view>
                <view class="ielts-cue-point ielts-cue-line prompt-replay {{questionPlaying && ieltsCueLineIndex === cueItemIndex + 2 ? 'is-speaking' : ''}}" wx:for="{{activeIeltsQuestion.cuePoints}}" wx:for-item="cueItem" wx:for-index="cueItemIndex" wx:key="*this"><text>•</text><view>{{cueItem}}</view></view>
                <view class="ielts-cue-closing ielts-cue-line prompt-replay {{questionPlaying && ieltsCueLineIndex === activeIeltsQuestion.cuePoints.length + 2 ? 'is-speaking' : ''}}">{{activeIeltsQuestion.closingPrompt}}</view>
              </view>

              <view class="ielts-answer-zone">
                <view class="ielts-answer-zone-head"><view>{{texts.ieltsAnswerArea}}</view><text>{{ieltsPromptReady ? texts.ieltsAnswerReady : texts.ieltsAnswerLocked}}</text></view>
                <button class="ielts-focus-answer {{recording ? 'is-recording' : ''}}" disabled="{{!ieltsPromptReady || submitting || questionLoading || questionPlaying}}" data-exercise-id="{{activeIeltsQuestion.exerciseId}}" data-view-key="{{activeIeltsQuestion.viewKey}}" data-prompt="{{activeIeltsQuestion.prompt}}" catchtap="toggleIeltsAnswer">{{recording ? texts.endAnswer : (submitting ? texts.scoring : (tempFilePath ? texts.restartAnswer : texts.startAnswer))}}</button>
                <button class="ielts-score-button is-focus" wx:if="{{tempFilePath && !recording && !submitting}}" catchtap="scoreIeltsAnswer">{{texts.scoreAnswer}}</button>
                <view class="ielts-inline-state is-focus" wx:if="{{recording || tempFilePath || submitting || result || errorText}}">
                  <view class="ielts-inline-error" wx:if="{{errorText}}">{{errorText}}</view>
                  <view class="ielts-inline-result" wx:elif="{{result}}"><text>{{texts.result}} {{result.score || 0}}{{texts.scoreUnit}}</text><view>{{texts.accuracy}} {{result.accuracy || 0}} · {{texts.fluency}} {{result.fluency || 0}} · {{texts.completeness}} {{result.completion || 0}}</view></view>
                  <view class="ielts-inline-progress" wx:else>{{submitting ? texts.scoring : (recording ? texts.recording : texts.recorded + recordDurationText)}}</view>
                </view>
              </view>

              <view class="ielts-question-nav">
                <button class="{{ieltsQuestionIndex === 0 ? 'is-disabled' : ''}}" disabled="{{ieltsQuestionIndex === 0}}" bindtap="previousIeltsQuestion">‹ {{texts.previousQuestion}}</button>
                <button class="is-next {{ieltsQuestionIndex >= ieltsQuestionSequence.length - 1 ? 'is-disabled' : ''}}" disabled="{{ieltsQuestionIndex >= ieltsQuestionSequence.length - 1}}" bindtap="nextIeltsQuestion">{{texts.nextQuestion}} ›</button>
              </view>
            </view>
          </view>
          <view class="ielts-source-toggle" wx:if="{{ieltsMode && ieltsSourceImages.length}}" bindtap="toggleIeltsSource">
            <view><view class="ielts-source-title">{{texts.originalPage}}</view><view class="ielts-source-meta">{{ieltsSourceImages.length}} {{texts.pageUnit}}</view></view>
            <view class="ielts-source-arrow">{{ieltsSourceExpanded ? '⌃' : '⌄'}}</view>
          </view>
          <view class="ielts-source-pages" wx:if="{{ieltsMode && ieltsSourceExpanded && ieltsSourceImages.length}}">
            <image class="ielts-source-page" wx:for="{{ieltsSourceImages}}" wx:key="cloudPath" src="{{item.src}}" data-src="{{item.src}}" bindtap="previewIeltsSource" mode="widthFix" show-menu-by-longpress="{{true}}" />
          </view>
        </view>

      <view class="repeat-sentence-list" wx:if="{{!ieltsMode}}">
        <view class="repeat-sentence-item {{activeId === item.id ? 'is-active' : ''}}" wx:for="{{exercises}}" wx:key="id">
          <view class="repeat-sentence-main" data-id="{{item.id}}" hover-class="is-pressed" bindtap="selectExercise">
            <view class="repeat-sentence-number">{{index + 1}}</view>
            <view class="repeat-sentence-text prompt-replay {{activeId === item.id && questionPlaying ? 'is-speaking' : ''}} {{activeId === item.id && questionLoading ? 'is-loading' : ''}}">{{item.prompt}}</view>
            <view class="repeat-sentence-play {{activeId === item.id && (questionPlaying || questionLoading) ? 'is-playing' : ''}}"><view></view><text></text><text></text><text></text></view>
          </view>
          <view class="repeat-inline-actions" wx:if="{{activeId === item.id && repeatPromptReady && !questionPlaying && !questionLoading}}">
            <button class="repeat-inline-record {{recording ? 'is-recording' : ''}}" wx:if="{{!tempFilePath && !result && !submitting}}" hover-class="is-pressed" bindtap="toggleRepeatRecording">{{recording ? texts.endRepeat : texts.startRepeat}}</button>
            <view class="repeat-inline-choice" wx:if="{{tempFilePath && !recording && !submitting}}">
              <button class="repeat-inline-choice-button is-secondary" hover-class="is-pressed" bindtap="restartRepeatRecording">{{texts.restartRepeat}}</button>
              <button class="repeat-inline-choice-button is-primary" hover-class="is-pressed" bindtap="replayRepeatRecording">{{answerPlaying ? texts.stopPlayback : texts.replayRecording}}</button>
            </view>
            <view class="repeat-inline-state" wx:if="{{recording || tempFilePath || submitting || result || errorText}}">
              <view class="repeat-inline-error" wx:if="{{errorText}}">{{errorText}}</view>
              <view class="repeat-inline-result" wx:elif="{{result}}"><text>{{texts.result}} {{result.score || 0}}{{texts.scoreUnit}}</text><view>{{texts.accuracy}} {{result.accuracy || 0}} · {{texts.fluency}} {{result.fluency || 0}} · {{texts.completeness}} {{result.completion || 0}}</view></view>
              <view class="repeat-inline-progress" wx:else>{{submitting ? texts.scoring : (recording ? texts.recording : texts.recorded + recordDurationText)}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>

<view class="repeat-audio-drawer-mask theme-{{theme}}" wx:if="{{audioPickerVisible}}" bindtap="closeRepeatAudioPicker" catchtouchmove="stopPickerEvent">
  <view class="repeat-audio-drawer" catchtap="stopPickerEvent">
    <view class="repeat-audio-drawer-handle"></view>
    <view class="repeat-audio-drawer-head">
      <view>
        <view class="repeat-audio-drawer-title">{{texts.selectAudio}}</view>
        <view class="repeat-audio-drawer-count">{{audioPickerAudios.length}}{{texts.audioUnit}}</view>
      </view>
      <view class="repeat-audio-drawer-close" hover-class="is-pressed" bindtap="closeRepeatAudioPicker">×</view>
    </view>
    <view class="repeat-audio-search">
          <input class="repeat-audio-search-input" value="{{audioPickerQuery}}" placeholder="{{texts.searchAudio}}" placeholder-class="repeat-audio-search-placeholder" confirm-type="search" bindinput="filterRepeatAudios" />
      <view class="repeat-audio-search-clear" wx:if="{{audioPickerQuery}}" hover-class="is-pressed" bindtap="clearRepeatAudioSearch">×</view>
    </view>
    <scroll-view class="repeat-audio-option-scroll" style="height: {{audioPickerListHeight}};" scroll-y="{{true}}" enhanced="{{true}}" bounces="{{true}}" show-scrollbar="{{false}}" scroll-with-animation="{{true}}" scroll-into-view="{{audioPickerScrollIntoView}}">
      <view class="repeat-audio-option {{selectedAudioId === item.id ? 'is-active' : ''}}" id="repeat-audio-option-{{item.pickerIndex}}" wx:for="{{audioPickerAudios}}" wx:key="id" data-audio-index="{{item.pickerIndex}}" hover-class="is-pressed" bindtap="selectRepeatAudio">
        <view class="repeat-audio-option-number">{{item.pickerIndex + 1}}</view>
        <view class="repeat-audio-option-copy"><view>{{item.displayTitle}}</view><text>{{item.meta}}</text></view>
        <view class="repeat-audio-option-state"><view></view></view>
      </view>
          <view class="repeat-audio-option-empty" wx:if="{{!audioPickerAudios.length}}">{{texts.noMatchingAudio}}</view>
    </scroll-view>
  </view>
</view>
