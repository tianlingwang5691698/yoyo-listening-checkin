<view class="theme-{{theme}} language-{{language}} page-shell library-speaking-page" wx:if="{{theme === 'library'}}">
  <view class="library-speaking-header">
    <view>
      <view class="library-speaking-kicker">{{texts.corner}}</view>
      <view class="library-speaking-title">{{pageTitle}}</view>
      <view class="library-speaking-copy" wx:if="{{pageCopy}}">{{pageCopy}}</view>
    </view>
    <view class="library-speaking-seal"><view>VOICE</view><text>ROOM</text></view>
  </view>

  <block wx:if="{{viewMode === 'home'}}">
    <view class="library-speaking-section-tabs">
      <view class="library-speaking-section-tab is-active">{{texts.mainPractice}}</view>
      <view class="library-speaking-section-tab" bindtap="openSpeakingHistory">{{texts.practiceHistory}}</view>
    </view>
    <view class="speaking-mode-list is-library">
      <view class="speaking-mode-row is-repeat" hover-class="is-pressed" bindtap="openRepeatPractice">
        <view class="speaking-mode-icon"><view class="mode-play"></view><view class="mode-wave"><text></text><text></text><text></text></view></view>
        <view class="speaking-mode-copy">
          <view class="speaking-mode-title">{{texts.gradedRepeat}}</view>
          <view class="speaking-mode-meta">{{texts.repeatModeMeta}}</view>
          <view class="speaking-mode-detail">Pre A1–B2 · {{texts.audioParagraph}}</view>
        </view>
        <view class="speaking-mode-arrow">›</view>
      </view>

      <view class="speaking-mode-row is-ielts" hover-class="is-pressed" bindtap="openIeltsSpeaking">
        <view class="speaking-mode-icon"><view class="mode-part">P</view></view>
        <view class="speaking-mode-copy">
          <view class="speaking-mode-title">{{texts.ieltsSpeaking}}</view>
          <view class="speaking-mode-meta">Part 1 · Part 2 · Part 3</view>
          <view class="speaking-mode-detail">Cambridge IELTS 10–21</view>
        </view>
        <view class="speaking-mode-state">{{ieltsLoading ? texts.loading : ''}}</view>
        <view class="speaking-mode-arrow">›</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{viewMode === 'ielts-books'}}">
    <view class="library-practice-nav hierarchy-back" bindtap="backToSpeakingHome">‹ 返回口语</view>
    <view class="ielts-catalog is-library">
      <view class="ielts-book-grid">
        <view class="ielts-book-card" hover-class="is-pressed" wx:for="{{ieltsBooks}}" wx:key="id" data-book-number="{{item.bookNumber}}" bindtap="selectIeltsBook">
          <view class="ielts-book-copy"><view>{{item.title}}</view></view>
          <view class="ielts-catalog-arrow">›</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:elif="{{viewMode === 'ielts-tests'}}">
    <view class="library-practice-nav hierarchy-back" bindtap="backToSpeakingHome">‹ 返回分册</view>
    <view class="ielts-catalog is-library">
      <view class="ielts-test-list is-catalog">
        <view class="ielts-test-row" hover-class="is-pressed" wx:for="{{selectedIeltsTests}}" wx:key="id" data-item-id="{{item.id}}" bindtouchstart="prefetchIeltsTest" bindtap="selectIeltsTest">
          <view class="ielts-test-copy"><view class="ielts-test-title">{{item.title}}</view></view>
          <view class="ielts-test-arrow">›</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:elif="{{viewMode === 'repeat-select'}}">
    <view class="library-practice-nav hierarchy-back" bindtap="backToSpeakingHome">‹ {{texts.backSpeaking}}</view>
    <view class="repeat-selector is-library">
      <view class="repeat-step-track">
        <view class="repeat-step is-done"><text>1</text><view>{{texts.selectLevel}}</view></view>
        <view class="repeat-step-line {{selectedSeriesId ? 'is-done' : ''}}"></view>
        <view class="repeat-step {{selectedSeriesId ? 'is-done' : 'is-current'}}"><text>2</text><view>{{texts.selectSeries}}</view></view>
        <view class="repeat-step-line {{selectedAudioId ? 'is-done' : ''}}"></view>
        <view class="repeat-step {{selectedAudioId ? 'is-done' : (selectedSeriesId ? 'is-current' : '')}}"><text>3</text><view>{{texts.selectAudio}}</view></view>
        <view class="repeat-step-line {{selectedParagraphId ? 'is-done' : ''}}"></view>
        <view class="repeat-step {{selectedParagraphId ? 'is-done' : (selectedAudioId ? 'is-current' : '')}}"><text>4</text><view>{{texts.selectParagraph}}</view></view>
      </view>
      <view class="repeat-selector-section">
        <view class="repeat-selector-heading"><view>{{texts.selectLevel}}</view><text>{{selectedLevel}}</text></view>
        <view class="library-level-tabs">
          <view class="library-level-tab {{selectedLevel === item.id ? 'is-active' : ''}}" wx:for="{{levels}}" wx:key="id" data-level="{{item.id}}" bindtap="selectSpeakingLevel">{{item.label}}</view>
        </view>
      </view>
      <view class="repeat-selector-section">
        <view class="repeat-selector-heading"><view>{{texts.selectSeries}}</view><text>{{repeatSeries.length}}{{texts.seriesUnit}}</text></view>
        <view class="repeat-audio-picker" hover-class="is-pressed" bindtap="openRepeatSeriesPicker">
          <view class="repeat-picker-step">2</view>
          <view class="repeat-audio-copy"><view>{{selectedSeries.title || texts.selectSeries}}</view><text>{{selectedSeriesId ? selectedLevel : texts.chooseSeriesHint}}</text></view>
          <view class="repeat-picker-arrow">›</view>
        </view>
      </view>
      <view class="repeat-selector-section" wx:if="{{selectedSeriesId}}">
        <view class="repeat-selector-heading"><view>{{texts.selectAudio}}</view><text>{{repeatAudios.length}}{{texts.audioUnit}}</text></view>
        <view class="repeat-load-state" wx:if="{{repeatAudioLoading}}">{{texts.loadingAudio}}</view>
        <view wx:elif="{{repeatAudios.length}}" class="repeat-audio-picker" hover-class="is-pressed" bindtap="openRepeatAudioPicker">
          <view class="repeat-picker-step">3</view>
          <view class="repeat-audio-copy"><view>{{selectedAudio.displayTitle || texts.selectAudio}}</view><text>{{selectedAudioId ? selectedAudio.meta : texts.chooseAudioHint}}</text></view>
          <view class="repeat-picker-arrow">›</view>
        </view>
        <view class="repeat-load-state is-error" wx:elif="{{repeatLoadError}}">{{repeatLoadError}}</view>
        <view class="repeat-load-state" wx:else>{{texts.noAudio}}</view>
      </view>
      <view class="repeat-selector-section" wx:if="{{selectedAudioId}}">
        <view class="repeat-selector-heading"><view>{{texts.selectParagraph}}</view><text>{{repeatParagraphs.length}}{{texts.paragraphUnit}}</text></view>
        <view class="repeat-load-state" wx:if="{{repeatParagraphLoading}}">{{texts.loadingParagraphs}}</view>
        <view wx:elif="{{repeatParagraphs.length}}" class="repeat-audio-picker" hover-class="is-pressed" bindtap="openRepeatParagraphPicker">
          <view class="repeat-picker-step">4</view>
          <view class="repeat-audio-copy"><view>{{selectedParagraph.title || texts.selectParagraph}}</view><text>{{selectedParagraphId ? selectedParagraph.meta : texts.chooseParagraphHint}}</text></view>
          <view class="repeat-picker-arrow">›</view>
        </view>
        <view class="repeat-load-state is-error" wx:elif="{{repeatLoadError}}">{{repeatLoadError}}</view>
        <view class="repeat-load-state" wx:else>{{texts.noTranscript}}</view>
      </view>
      <button class="repeat-start-button" wx:if="{{selectedParagraphId && !repeatParagraphLoading}}" hover-class="is-pressed" bindtap="startSelectedRepeat">{{texts.startParagraph}}</button>
    </view>
  </block>

  <block wx:else>
    <view class="library-practice-nav hierarchy-back" bindtap="backToSpeakingHome">‹ {{ieltsMode ? '返回 Test' : texts.backSelection}}</view>

    <block wx:if="{{activeExercise && exercises.length}}">
      <view class="library-prompt-sheet" wx:if="{{ieltsMode}}">
        <view class="library-sheet-rule"></view>
        <view class="ielts-session-intro" wx:if="{{!ieltsSessionStarted}}">
          <view class="ielts-intro-part">PART 1</view>
          <view class="ielts-intro-title">{{activeIeltsQuestion.topicTitle || texts.ieltsOpeningTitle}}</view>
          <view class="ielts-intro-copy">{{texts.ieltsOpeningCopy}}</view>
          <view class="ielts-intro-script prompt-replay {{ieltsIntroPlaying ? 'is-speaking' : ''}} {{ieltsIntroLoading ? 'is-loading' : ''}}" hover-class="is-pressed" bindtap="playIeltsIntro">{{ieltsIntroText}}</view>
          <button class="ielts-session-start" hover-class="is-pressed" bindtap="startIeltsSession">{{texts.startPartOne}}</button>
        </view>

        <view class="ielts-focus" wx:else>
          <view class="ielts-focus-head">
            <view><view class="ielts-focus-part">{{activeIeltsQuestion.partLabel}}</view><view class="ielts-focus-topic" wx:if="{{activeIeltsQuestion.topicTitle}}">{{activeIeltsQuestion.topicTitle}}</view></view>
            <view class="ielts-focus-count">{{activeIeltsQuestion.partQuestionIndex}} / {{activeIeltsQuestion.partQuestionTotal}}</view>
          </view>

          <view class="ielts-listen-row">
            <button class="ielts-play-button {{questionPlaying ? 'is-playing' : ''}} {{questionLoading ? 'is-loading' : ''}}" disabled="{{recording || submitting}}" aria-label="{{texts.listenQuestionShort}}" data-exercise-id="{{activeIeltsQuestion.exerciseId}}" data-view-key="{{activeIeltsQuestion.viewKey}}" data-prompt="{{activeIeltsQuestion.prompt}}" catchtap="playIeltsQuestion"><view class="ielts-play-icon"></view><view class="ielts-play-wave"><text></text><text></text><text></text></view></button>
            <view class="ielts-listen-copy"><view>{{questionLoading ? texts.preparing : (questionPlaying ? texts.questionPlaying : (ieltsPromptReady ? texts.relistenQuestion : texts.listenQuestionShort))}}</view><text>{{texts.questionListenHint}}</text></view>
            <button class="ielts-reveal-button" wx:if="{{activeIeltsQuestion.type === 'question'}}" data-exercise-id="{{activeIeltsQuestion.exerciseId}}" data-view-key="{{activeIeltsQuestion.viewKey}}" data-prompt="{{activeIeltsQuestion.prompt}}" catchtap="selectIeltsQuestion">{{ieltsQuestionRevealed ? texts.hideQuestion : texts.showQuestion}}</button>
          </view>

          <view class="ielts-focus-prompt" wx:if="{{activeIeltsQuestion.type === 'question'}}">
            <view class="ielts-focus-question prompt-replay {{ieltsQuestionRevealed && questionPlaying ? 'is-speaking' : ''}}" wx:if="{{ieltsQuestionRevealed}}">{{activeIeltsQuestion.prompt}}</view>
            <view class="ielts-focus-hidden" wx:else>{{texts.questionListenHint}}</view>
          </view>

          <view class="ielts-cue-card is-active" wx:else>
            <view class="ielts-cue-task ielts-cue-line prompt-replay {{questionPlaying && ieltsCueLineIndex === 0 ? 'is-speaking' : ''}}">{{activeIeltsQuestion.task}}</view>
            <view class="ielts-cue-label ielts-cue-line prompt-replay {{questionPlaying && ieltsCueLineIndex === 1 ? 'is-speaking' : ''}}">{{texts.youShouldSay}}</view>
            <view class="ielts-cue-point ielts-cue-line prompt-replay {{questionPlaying && ieltsCueLineIndex === cueItemIndex + 2 ? 'is-speaking' : ''}}" wx:for="{{activeIeltsQuestion.cuePoints}}" wx:for-item="cueItem" wx:for-index="cueItemIndex" wx:key="*this"><text>•</text><view>{{cueItem}}</view></view>
            <view class="ielts-cue-closing ielts-cue-line prompt-replay {{questionPlaying && ieltsCueLineIndex === activeIeltsQuestion.cuePoints.length + 2 ? 'is-speaking' : ''}}">{{activeIeltsQuestion.closingPrompt}}</view>
          </view>

          <view class="ielts-answer-zone">
            <view class="ielts-answer-zone-head"><view>{{texts.ieltsAnswerArea}}</view><text>{{ieltsPromptReady ? texts.ieltsAnswerReady : texts.ieltsAnswerLocked}}</text></view>
            <button class="ielts-focus-answer {{recording ? 'is-recording' : ''}}" disabled="{{!ieltsPromptReady || submitting || questionLoading || questionPlaying}}" data-exercise-id="{{activeIeltsQuestion.exerciseId}}" data-view-key="{{activeIeltsQuestion.viewKey}}" data-prompt="{{activeIeltsQuestion.prompt}}" catchtap="toggleIeltsAnswer">{{recording ? texts.endAnswer : (submitting ? texts.scoring : (tempFilePath ? texts.restartAnswer : texts.startAnswer))}}</button>
            <button class="ielts-score-button is-focus" wx:if="{{tempFilePath && !recording && !submitting}}" catchtap="scoreIeltsAnswer">{{texts.scoreAnswer}}</button>
            <view class="ielts-inline-state is-focus" wx:if="{{recording || tempFilePath || submitting || result || errorText}}">
              <view class="ielts-inline-error" wx:if="{{errorText && !recording}}">{{errorText}}</view>
              <view class="ielts-band-result" wx:elif="{{result && result.isIeltsBand}}">
                <view class="ielts-band-summary"><view><text>练习结果</text><text class="ielts-band-overall">Band {{result.overallBand}}</text></view><text>Part {{result.ieltsPart}}</text></view>
                <view class="ielts-band-grid">
                  <view><text>流利与连贯</text><text class="ielts-band-value">{{result.fluencyCoherenceBand}}</text><text class="ielts-band-en">Fluency &amp; Coherence</text></view>
                  <view><text>词汇资源</text><text class="ielts-band-value">{{result.lexicalResourceBand}}</text><text class="ielts-band-en">Lexical Resource</text></view>
                  <view><text>语法范围与准确性</text><text class="ielts-band-value">{{result.grammaticalRangeAccuracyBand}}</text><text class="ielts-band-en">Grammar</text></view>
                  <view><text>发音</text><text class="ielts-band-value">{{result.pronunciationBand}}</text><text class="ielts-band-en">Pronunciation</text></view>
                </view>
                <view class="ielts-band-feedback" wx:if="{{result.feedback}}">{{result.feedback}}</view>
                <view class="ielts-band-note">正式成绩由 IELTS 考官根据完整三部分评定</view>
                <button class="ielts-pdf-button" loading="{{ieltsPdfGenerating}}" disabled="{{ieltsPdfGenerating}}" bindtap="downloadIeltsSpeakingReportPdf">{{ieltsPdfGenerating ? '正在生成完整 PDF' : '下载完整套题 PDF'}}</button>
              </view>
              <view class="ielts-inline-result" wx:elif="{{result}}"><text>{{texts.result}} {{result.score || 0}}{{texts.scoreUnit}}</text><view>{{texts.accuracy}} {{result.accuracy || 0}} · {{texts.fluency}} {{result.fluency || 0}} · {{texts.completeness}} {{result.completion || 0}}</view></view>
              <view class="ielts-inline-progress" wx:else>{{submitting ? texts.scoring : (recording ? texts.recording : texts.recorded + recordDurationText)}}</view>
            </view>
          </view>

          <view class="ielts-question-nav">
            <button class="{{ieltsQuestionIndex === 0 ? 'is-disabled' : ''}}" disabled="{{ieltsQuestionIndex === 0}}" bindtap="previousIeltsQuestion">‹ {{texts.previousQuestion}}</button>
            <button class="is-next {{ieltsQuestionIndex >= ieltsQuestionSequence.length - 1 ? 'is-disabled' : ''}}" disabled="{{ieltsQuestionIndex >= ieltsQuestionSequence.length - 1}}" bindtap="nextIeltsQuestion">{{texts.nextQuestion}} ›</button>
          </view>
        </view>
      </view>

      <view class="repeat-sentence-list is-library" wx:if="{{!ieltsMode}}">
        <view class="repeat-sentence-item {{activeId === item.id ? 'is-active' : ''}}" wx:for="{{exercises}}" wx:key="id">
          <view class="repeat-sentence-main" data-id="{{item.id}}" hover-class="is-pressed" bindtap="selectExercise">
            <view class="repeat-sentence-number">{{item.sentenceNumber || index + 1}}</view>
            <view class="repeat-sentence-text prompt-replay {{activeId === item.id && questionPlaying ? 'is-speaking' : ''}} {{activeId === item.id && questionLoading ? 'is-loading' : ''}}"><text class="repeat-sentence-speaker" wx:if="{{item.speakerLabel}}">{{item.speakerLabel}}</text><text>{{item.prompt}}</text></view>
            <view class="repeat-sentence-score is-scoring" wx:if="{{item.repeatScoring}}">{{texts.scoring}}</view>
            <view class="repeat-sentence-score" wx:elif="{{item.repeatResult}}">{{item.repeatResult.score || 0}}</view>
            <view class="repeat-sentence-score is-error" wx:elif="{{item.repeatScoreError}}">重试</view>
            <view class="repeat-sentence-play {{activeId === item.id && (questionPlaying || questionLoading) ? 'is-playing' : ''}}"><view></view><text></text><text></text><text></text></view>
          </view>
          <view class="repeat-inline-actions" wx:if="{{activeId === item.id && repeatPromptReady && !questionPlaying && !questionLoading}}">
            <button class="repeat-inline-record {{recording ? 'is-recording' : ''}}" wx:if="{{!tempFilePath && !result && !submitting && !repeatScoring}}" hover-class="is-pressed" bindtap="toggleRepeatRecording">{{recording ? texts.endRepeat : texts.startRepeat}}</button>
            <view class="repeat-inline-choice" wx:if="{{tempFilePath && !recording && !submitting && !repeatScoring}}">
              <button class="repeat-inline-choice-button is-secondary" hover-class="is-pressed" bindtap="restartRepeatRecording">{{texts.restartRepeat}}</button>
              <button class="repeat-inline-choice-button is-primary" hover-class="is-pressed" bindtap="replayRepeatRecording">{{answerPlaying ? texts.stopPlayback : texts.replayRecording}}</button>
            </view>
            <view class="repeat-inline-state" wx:if="{{recording || tempFilePath || submitting || repeatScoring || result || errorText}}">
              <view class="repeat-inline-error" wx:if="{{errorText && !recording}}">{{errorText}}</view>
              <view class="repeat-inline-result" wx:elif="{{result}}">
                <text class="repeat-inline-result-total">{{texts.result}} {{result.score || 0}}{{texts.scoreUnit}}</text>
                <view class="repeat-inline-metrics">
                  <view class="repeat-inline-metric"><text>{{texts.accuracy}}</text><text>{{result.accuracy || 0}}</text></view>
                  <view class="repeat-inline-metric"><text>{{texts.fluency}}</text><text>{{result.fluency || 0}}</text></view>
                  <view class="repeat-inline-metric"><text>{{texts.completeness}}</text><text>{{result.completion || 0}}</text></view>
                </view>
                <view class="repeat-inline-feedback" wx:if="{{result.feedback}}">{{result.feedback}}</view>
              </view>
              <view class="repeat-inline-progress" wx:else>{{repeatScoring || submitting ? texts.scoring : (recording ? texts.recording : texts.recorded + recordDurationText)}}</view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view class="library-speaking-empty" wx:else>
      <view class="library-empty-box"><view class="library-empty-mic"></view></view>
      <view class="library-empty-title">{{texts.empty}}</view>
    </view>
  </block>
</view>

<view class="theme-{{theme}} language-{{language}} page-shell speaking-page" wx:else>
  <view class="speaking-header">
    <image wx:if="{{theme === 'tactical'}}" class="tactical-subpage-banner" src="https://796f-youshengenglish-6glk12rd6c6e719b-1419984942.tcb.qcloud.la/_assets/themes/tactical/20260727-subpages-v1/speaking-radio.jpg" mode="aspectFill"></image>
    <view class="speaking-header-copy">
      <view class="speaking-title">{{pageTitle}}</view>
      <view class="speaking-copy" wx:if="{{pageCopy}}">{{pageCopy}}</view>
    </view>
    <view class="warm-speaking-stage" wx:if="{{theme === 'warm'}}">
      <view class="warm-stage-ring"></view>
      <view class="warm-stage-mic"></view>
      <view class="warm-stage-wave"><text></text><text></text><text></text><text></text><text></text></view>
    </view>
    <view class="voyage-speaking-stage" wx:elif="{{theme === 'voyage'}}">
      <view class="voyage-stage-compass">N</view>
      <view class="voyage-stage-route"><text></text><text></text><text></text></view>
      <view class="voyage-stage-signal"><text></text><text></text><text></text></view>
    </view>
    <view class="dragon-speaking-stage" wx:elif="{{theme === 'dragon'}}">
      <view class="dragon-stage-orbit"><text></text><text></text><text></text></view>
      <view class="dragon-stage-core">声</view>
      <view class="dragon-stage-meter"><text></text><text></text><text></text></view>
    </view>
    <view class="tactical-speaking-stage" wx:elif="{{theme === 'tactical'}}" aria-hidden="true">
      <view class="tactical-stage-status"><text></text>VOICE LINK</view>
      <view class="tactical-stage-bars"><text></text><text></text><text></text><text></text><text></text></view>
      <view class="tactical-stage-code">COMMS</view>
    </view>
  </view>

  <block wx:if="{{viewMode === 'home'}}">
    <view class="warm-speaking-section-tabs" wx:if="{{theme === 'warm'}}">
      <view class="warm-speaking-section-tab is-active">{{texts.mainPractice}}</view>
      <view class="warm-speaking-section-tab" bindtap="openSpeakingHistory">{{texts.practiceHistory}}</view>
    </view>
    <view class="voyage-speaking-section-tabs" wx:elif="{{theme === 'voyage'}}">
      <view class="voyage-speaking-section-route">ROUTE</view>
      <view class="voyage-speaking-section-tab is-active">{{texts.mainPractice}}</view>
      <view class="voyage-speaking-section-tab" bindtap="openSpeakingHistory">{{texts.practiceHistory}}</view>
    </view>
    <view class="dragon-speaking-section-tabs" wx:elif="{{theme === 'dragon'}}">
      <view class="dragon-speaking-section-badge">声</view>
      <view class="dragon-speaking-section-tab is-active">{{texts.mainPractice}}</view>
      <view class="dragon-speaking-section-tab" bindtap="openSpeakingHistory">{{texts.practiceHistory}}</view>
    </view>
    <view class="tactical-speaking-section-tabs" wx:else>
      <view class="tactical-speaking-section-state"><text></text>READY</view>
      <view class="tactical-speaking-section-tab is-active">{{texts.mainPractice}}</view>
      <view class="tactical-speaking-section-tab" bindtap="openSpeakingHistory">{{texts.practiceHistory}}</view>
    </view>
    <view class="speaking-mode-list">
      <view class="speaking-mode-row is-repeat" hover-class="is-pressed" bindtap="openRepeatPractice">
        <view class="voyage-mode-route" wx:if="{{theme === 'voyage'}}">ROUTE 01</view>
        <view class="dragon-mode-rank" wx:if="{{theme === 'dragon'}}">训练 01</view>
        <view class="tactical-mode-code" wx:if="{{theme === 'tactical'}}">COMMS 01</view>
        <view class="speaking-mode-icon"><view class="mode-play"></view><view class="mode-wave"><text></text><text></text><text></text></view></view>
        <view class="speaking-mode-copy">
          <view class="speaking-mode-title">{{texts.gradedRepeat}}</view>
          <view class="speaking-mode-meta">{{texts.repeatModeMeta}}</view>
          <view class="speaking-mode-detail">Pre A1–B2 · {{texts.audioParagraph}}</view>
        </view>
        <view class="speaking-mode-arrow">›</view>
      </view>

      <view class="speaking-mode-row is-ielts" hover-class="is-pressed" bindtap="openIeltsSpeaking">
        <view class="voyage-mode-route" wx:if="{{theme === 'voyage'}}">ROUTE 02</view>
        <view class="dragon-mode-rank" wx:if="{{theme === 'dragon'}}">训练 02</view>
        <view class="tactical-mode-code" wx:if="{{theme === 'tactical'}}">COMMS 02</view>
        <view class="speaking-mode-icon"><view class="mode-part">P</view></view>
        <view class="speaking-mode-copy">
          <view class="speaking-mode-title">{{texts.ieltsSpeaking}}</view>
          <view class="speaking-mode-meta">Part 1 · Part 2 · Part 3</view>
          <view class="speaking-mode-detail">Cambridge IELTS 10–21</view>
        </view>
        <view class="speaking-mode-state">{{ieltsLoading ? texts.loading : ''}}</view>
        <view class="speaking-mode-arrow">›</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{viewMode === 'ielts-books'}}">
    <view class="speaking-practice-nav hierarchy-back" bindtap="backToSpeakingHome">‹ 返回口语</view>
    <view class="ielts-catalog">
      <view class="ielts-book-grid">
        <view class="ielts-book-card" hover-class="is-pressed" wx:for="{{ieltsBooks}}" wx:key="id" data-book-number="{{item.bookNumber}}" bindtap="selectIeltsBook">
          <view class="ielts-book-copy"><view>{{item.title}}</view></view>
          <view class="ielts-catalog-arrow">›</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:elif="{{viewMode === 'ielts-tests'}}">
    <view class="speaking-practice-nav hierarchy-back" bindtap="backToSpeakingHome">‹ 返回分册</view>
    <view class="ielts-catalog">
      <view class="ielts-test-list is-catalog">
        <view class="ielts-test-row" hover-class="is-pressed" wx:for="{{selectedIeltsTests}}" wx:key="id" data-item-id="{{item.id}}" bindtouchstart="prefetchIeltsTest" bindtap="selectIeltsTest">
          <view class="ielts-test-copy"><view class="ielts-test-title">{{item.title}}</view></view>
          <view class="ielts-test-arrow">›</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:elif="{{viewMode === 'repeat-select'}}">
    <view class="speaking-practice-nav hierarchy-back" bindtap="backToSpeakingHome">‹ {{texts.backSpeaking}}</view>
    <view class="repeat-selector">
      <view class="repeat-step-track">
        <view class="repeat-step is-done"><text>1</text><view>{{texts.selectLevel}}</view></view>
        <view class="repeat-step-line {{selectedSeriesId ? 'is-done' : ''}}"></view>
        <view class="repeat-step {{selectedSeriesId ? 'is-done' : 'is-current'}}"><text>2</text><view>{{texts.selectSeries}}</view></view>
        <view class="repeat-step-line {{selectedAudioId ? 'is-done' : ''}}"></view>
        <view class="repeat-step {{selectedAudioId ? 'is-done' : (selectedSeriesId ? 'is-current' : '')}}"><text>3</text><view>{{texts.selectAudio}}</view></view>
        <view class="repeat-step-line {{selectedParagraphId ? 'is-done' : ''}}"></view>
        <view class="repeat-step {{selectedParagraphId ? 'is-done' : (selectedAudioId ? 'is-current' : '')}}"><text>4</text><view>{{texts.selectParagraph}}</view></view>
      </view>
      <view class="repeat-selector-section">
        <view class="repeat-selector-heading"><view>{{texts.selectLevel}}</view><text>{{selectedLevel}}</text></view>
        <view class="speaking-level-tabs">
          <view class="speaking-level-tab {{selectedLevel === item.id ? 'is-active' : ''}}" wx:for="{{levels}}" wx:key="id" data-level="{{item.id}}" bindtap="selectSpeakingLevel">{{item.label}}</view>
        </view>
      </view>
      <view class="repeat-selector-section">
        <view class="repeat-selector-heading"><view>{{texts.selectSeries}}</view><text>{{repeatSeries.length}}{{texts.seriesUnit}}</text></view>
        <view class="repeat-audio-picker" hover-class="is-pressed" bindtap="openRepeatSeriesPicker">
          <view class="repeat-picker-step">2</view>
          <view class="repeat-audio-copy"><view>{{selectedSeries.title || texts.selectSeries}}</view><text>{{selectedSeriesId ? selectedLevel : texts.chooseSeriesHint}}</text></view>
          <view class="repeat-picker-arrow">›</view>
        </view>
      </view>
      <view class="repeat-selector-section" wx:if="{{selectedSeriesId}}">
        <view class="repeat-selector-heading"><view>{{texts.selectAudio}}</view><text>{{repeatAudios.length}}{{texts.audioUnit}}</text></view>
        <view class="repeat-load-state" wx:if="{{repeatAudioLoading}}">{{texts.loadingAudio}}</view>
        <view wx:elif="{{repeatAudios.length}}" class="repeat-audio-picker" hover-class="is-pressed" bindtap="openRepeatAudioPicker">
          <view class="repeat-picker-step">3</view>
          <view class="repeat-audio-copy"><view>{{selectedAudio.displayTitle || texts.selectAudio}}</view><text>{{selectedAudioId ? selectedAudio.meta : texts.chooseAudioHint}}</text></view>
          <view class="repeat-picker-arrow">›</view>
        </view>
        <view class="repeat-load-state is-error" wx:elif="{{repeatLoadError}}">{{repeatLoadError}}</view>
        <view class="repeat-load-state" wx:else>{{texts.noAudio}}</view>
      </view>
      <view class="repeat-selector-section" wx:if="{{selectedAudioId}}">
        <view class="repeat-selector-heading"><view>{{texts.selectParagraph}}</view><text>{{repeatParagraphs.length}}{{texts.paragraphUnit}}</text></view>
        <view class="repeat-load-state" wx:if="{{repeatParagraphLoading}}">{{texts.loadingParagraphs}}</view>
        <view wx:elif="{{repeatParagraphs.length}}" class="repeat-audio-picker" hover-class="is-pressed" bindtap="openRepeatParagraphPicker">
          <view class="repeat-picker-step">4</view>
          <view class="repeat-audio-copy"><view>{{selectedParagraph.title || texts.selectParagraph}}</view><text>{{selectedParagraphId ? selectedParagraph.meta : texts.chooseParagraphHint}}</text></view>
          <view class="repeat-picker-arrow">›</view>
        </view>
        <view class="repeat-load-state is-error" wx:elif="{{repeatLoadError}}">{{repeatLoadError}}</view>
        <view class="repeat-load-state" wx:else>{{texts.noTranscript}}</view>
      </view>
      <button class="repeat-start-button" wx:if="{{selectedParagraphId && !repeatParagraphLoading}}" hover-class="is-pressed" bindtap="startSelectedRepeat">{{texts.startParagraph}}</button>
    </view>
  </block>

  <block wx:else>
    <view class="speaking-practice-nav hierarchy-back" bindtap="backToSpeakingHome">‹ {{ieltsMode ? '返回 Test' : texts.backSelection}}</view>

      <view class="voice-cabin {{ieltsMode ? 'card' : 'is-repeat-cabin'}}">
      <view class="cabin-glow"></view>
        <view class="prompt-panel" wx:if="{{ieltsMode}}">
          <view class="ielts-exam-sheet">
            <view class="ielts-session-intro" wx:if="{{!ieltsSessionStarted}}">
              <view class="ielts-intro-part">PART 1</view>
              <view class="ielts-intro-title">{{activeIeltsQuestion.topicTitle || texts.ieltsOpeningTitle}}</view>
              <view class="ielts-intro-copy">{{texts.ieltsOpeningCopy}}</view>
              <view class="ielts-intro-script prompt-replay {{ieltsIntroPlaying ? 'is-speaking' : ''}} {{ieltsIntroLoading ? 'is-loading' : ''}}" hover-class="is-pressed" bindtap="playIeltsIntro">{{ieltsIntroText}}</view>
              <button class="ielts-session-start" hover-class="is-pressed" bindtap="startIeltsSession">{{texts.startPartOne}}</button>
            </view>

            <view class="ielts-focus" wx:else>
              <view class="ielts-focus-head">
                <view><view class="ielts-focus-part">{{activeIeltsQuestion.partLabel}}</view><view class="ielts-focus-topic" wx:if="{{activeIeltsQuestion.topicTitle}}">{{activeIeltsQuestion.topicTitle}}</view></view>
                <view class="ielts-focus-count">{{activeIeltsQuestion.partQuestionIndex}} / {{activeIeltsQuestion.partQuestionTotal}}</view>
              </view>

              <view class="ielts-listen-row">
                <button class="ielts-play-button {{questionPlaying ? 'is-playing' : ''}} {{questionLoading ? 'is-loading' : ''}}" disabled="{{recording || submitting}}" aria-label="{{texts.listenQuestionShort}}" data-exercise-id="{{activeIeltsQuestion.exerciseId}}" data-view-key="{{activeIeltsQuestion.viewKey}}" data-prompt="{{activeIeltsQuestion.prompt}}" catchtap="playIeltsQuestion"><view class="ielts-play-icon"></view><view class="ielts-play-wave"><text></text><text></text><text></text></view></button>
                <view class="ielts-listen-copy"><view>{{questionLoading ? texts.preparing : (questionPlaying ? texts.questionPlaying : (ieltsPromptReady ? texts.relistenQuestion : texts.listenQuestionShort))}}</view><text>{{texts.questionListenHint}}</text></view>
                <button class="ielts-reveal-button" wx:if="{{activeIeltsQuestion.type === 'question'}}" data-exercise-id="{{activeIeltsQuestion.exerciseId}}" data-view-key="{{activeIeltsQuestion.viewKey}}" data-prompt="{{activeIeltsQuestion.prompt}}" catchtap="selectIeltsQuestion">{{ieltsQuestionRevealed ? texts.hideQuestion : texts.showQuestion}}</button>
              </view>

              <view class="ielts-focus-prompt" wx:if="{{activeIeltsQuestion.type === 'question'}}">
                <view class="ielts-focus-question prompt-replay {{ieltsQuestionRevealed && questionPlaying ? 'is-speaking' : ''}}" wx:if="{{ieltsQuestionRevealed}}">{{activeIeltsQuestion.prompt}}</view>
                <view class="ielts-focus-hidden" wx:else>{{texts.questionListenHint}}</view>
              </view>

              <view class="ielts-cue-card is-active" wx:else>
                <view class="ielts-cue-task ielts-cue-line prompt-replay {{questionPlaying && ieltsCueLineIndex === 0 ? 'is-speaking' : ''}}">{{activeIeltsQuestion.task}}</view>
                <view class="ielts-cue-label ielts-cue-line prompt-replay {{questionPlaying && ieltsCueLineIndex === 1 ? 'is-speaking' : ''}}">{{texts.youShouldSay}}</view>
                <view class="ielts-cue-point ielts-cue-line prompt-replay {{questionPlaying && ieltsCueLineIndex === cueItemIndex + 2 ? 'is-speaking' : ''}}" wx:for="{{activeIeltsQuestion.cuePoints}}" wx:for-item="cueItem" wx:for-index="cueItemIndex" wx:key="*this"><text>•</text><view>{{cueItem}}</view></view>
                <view class="ielts-cue-closing ielts-cue-line prompt-replay {{questionPlaying && ieltsCueLineIndex === activeIeltsQuestion.cuePoints.length + 2 ? 'is-speaking' : ''}}">{{activeIeltsQuestion.closingPrompt}}</view>
              </view>

              <view class="ielts-answer-zone">
                <view class="ielts-answer-zone-head"><view>{{texts.ieltsAnswerArea}}</view><text>{{ieltsPromptReady ? texts.ieltsAnswerReady : texts.ieltsAnswerLocked}}</text></view>
                <button class="ielts-focus-answer {{recording ? 'is-recording' : ''}}" disabled="{{!ieltsPromptReady || submitting || questionLoading || questionPlaying}}" data-exercise-id="{{activeIeltsQuestion.exerciseId}}" data-view-key="{{activeIeltsQuestion.viewKey}}" data-prompt="{{activeIeltsQuestion.prompt}}" catchtap="toggleIeltsAnswer">{{recording ? texts.endAnswer : (submitting ? texts.scoring : (tempFilePath ? texts.restartAnswer : texts.startAnswer))}}</button>
                <button class="ielts-score-button is-focus" wx:if="{{tempFilePath && !recording && !submitting}}" catchtap="scoreIeltsAnswer">{{texts.scoreAnswer}}</button>
                <view class="ielts-inline-state is-focus" wx:if="{{recording || tempFilePath || submitting || result || errorText}}">
                  <view class="ielts-inline-error" wx:if="{{errorText && !recording}}">{{errorText}}</view>
                  <view class="ielts-band-result" wx:elif="{{result && result.isIeltsBand}}">
                    <view class="ielts-band-summary"><view><text>练习结果</text><text class="ielts-band-overall">Band {{result.overallBand}}</text></view><text>Part {{result.ieltsPart}}</text></view>
                    <view class="ielts-band-grid">
                      <view><text>流利与连贯</text><text class="ielts-band-value">{{result.fluencyCoherenceBand}}</text><text class="ielts-band-en">Fluency &amp; Coherence</text></view>
                      <view><text>词汇资源</text><text class="ielts-band-value">{{result.lexicalResourceBand}}</text><text class="ielts-band-en">Lexical Resource</text></view>
                      <view><text>语法范围与准确性</text><text class="ielts-band-value">{{result.grammaticalRangeAccuracyBand}}</text><text class="ielts-band-en">Grammar</text></view>
                      <view><text>发音</text><text class="ielts-band-value">{{result.pronunciationBand}}</text><text class="ielts-band-en">Pronunciation</text></view>
                    </view>
                    <view class="ielts-band-feedback" wx:if="{{result.feedback}}">{{result.feedback}}</view>
                    <view class="ielts-band-note">正式成绩由 IELTS 考官根据完整三部分评定</view>
                    <button class="ielts-pdf-button" loading="{{ieltsPdfGenerating}}" disabled="{{ieltsPdfGenerating}}" bindtap="downloadIeltsSpeakingReportPdf">{{ieltsPdfGenerating ? '正在生成完整 PDF' : '下载完整套题 PDF'}}</button>
                  </view>
                  <view class="ielts-inline-result" wx:elif="{{result}}"><text>{{texts.result}} {{result.score || 0}}{{texts.scoreUnit}}</text><view>{{texts.accuracy}} {{result.accuracy || 0}} · {{texts.fluency}} {{result.fluency || 0}} · {{texts.completeness}} {{result.completion || 0}}</view></view>
                  <view class="ielts-inline-progress" wx:else>{{submitting ? texts.scoring : (recording ? texts.recording : texts.recorded + recordDurationText)}}</view>
                </view>
              </view>

              <view class="ielts-question-nav">
                <button class="{{ieltsQuestionIndex === 0 ? 'is-disabled' : ''}}" disabled="{{ieltsQuestionIndex === 0}}" bindtap="previousIeltsQuestion">‹ {{texts.previousQuestion}}</button>
                <button class="is-next {{ieltsQuestionIndex >= ieltsQuestionSequence.length - 1 ? 'is-disabled' : ''}}" disabled="{{ieltsQuestionIndex >= ieltsQuestionSequence.length - 1}}" bindtap="nextIeltsQuestion">{{texts.nextQuestion}} ›</button>
              </view>
            </view>
          </view>
        </view>

      <view class="repeat-sentence-list" wx:if="{{!ieltsMode}}">
        <view class="repeat-sentence-item {{activeId === item.id ? 'is-active' : ''}}" wx:for="{{exercises}}" wx:key="id">
          <view class="repeat-sentence-main" data-id="{{item.id}}" hover-class="is-pressed" bindtap="selectExercise">
            <view class="repeat-sentence-number">{{item.sentenceNumber || index + 1}}</view>
            <view class="repeat-sentence-text prompt-replay {{activeId === item.id && questionPlaying ? 'is-speaking' : ''}} {{activeId === item.id && questionLoading ? 'is-loading' : ''}}"><text class="repeat-sentence-speaker" wx:if="{{item.speakerLabel}}">{{item.speakerLabel}}</text><text>{{item.prompt}}</text></view>
            <view class="repeat-sentence-score is-scoring" wx:if="{{item.repeatScoring}}">{{texts.scoring}}</view>
            <view class="repeat-sentence-score" wx:elif="{{item.repeatResult}}">{{item.repeatResult.score || 0}}</view>
            <view class="repeat-sentence-score is-error" wx:elif="{{item.repeatScoreError}}">重试</view>
            <view class="repeat-sentence-play {{activeId === item.id && (questionPlaying || questionLoading) ? 'is-playing' : ''}}"><view></view><text></text><text></text><text></text></view>
          </view>
          <view class="repeat-inline-actions" wx:if="{{activeId === item.id && repeatPromptReady && !questionPlaying && !questionLoading}}">
            <button class="repeat-inline-record {{recording ? 'is-recording' : ''}}" wx:if="{{!tempFilePath && !result && !submitting && !repeatScoring}}" hover-class="is-pressed" bindtap="toggleRepeatRecording">{{recording ? texts.endRepeat : texts.startRepeat}}</button>
            <view class="repeat-inline-choice" wx:if="{{tempFilePath && !recording && !submitting && !repeatScoring}}">
              <button class="repeat-inline-choice-button is-secondary" hover-class="is-pressed" bindtap="restartRepeatRecording">{{texts.restartRepeat}}</button>
              <button class="repeat-inline-choice-button is-primary" hover-class="is-pressed" bindtap="replayRepeatRecording">{{answerPlaying ? texts.stopPlayback : texts.replayRecording}}</button>
            </view>
            <view class="repeat-inline-state" wx:if="{{recording || tempFilePath || submitting || repeatScoring || result || errorText}}">
              <view class="repeat-inline-error" wx:if="{{errorText && !recording}}">{{errorText}}</view>
              <view class="repeat-inline-result" wx:elif="{{result}}">
                <text class="repeat-inline-result-total">{{texts.result}} {{result.score || 0}}{{texts.scoreUnit}}</text>
                <view class="repeat-inline-metrics">
                  <view class="repeat-inline-metric"><text>{{texts.accuracy}}</text><text>{{result.accuracy || 0}}</text></view>
                  <view class="repeat-inline-metric"><text>{{texts.fluency}}</text><text>{{result.fluency || 0}}</text></view>
                  <view class="repeat-inline-metric"><text>{{texts.completeness}}</text><text>{{result.completion || 0}}</text></view>
                </view>
                <view class="repeat-inline-feedback" wx:if="{{result.feedback}}">{{result.feedback}}</view>
              </view>
              <view class="repeat-inline-progress" wx:else>{{repeatScoring || submitting ? texts.scoring : (recording ? texts.recording : texts.recorded + recordDurationText)}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>

<view class="repeat-audio-drawer-mask theme-{{theme}}" wx:if="{{audioPickerVisible}}" bindtap="closeRepeatAudioPicker" catchtouchmove="stopPickerEvent">
  <view class="repeat-audio-drawer" catchtap="stopPickerEvent">
    <view class="repeat-audio-drawer-handle"></view>
    <view class="repeat-audio-drawer-head">
      <view>
        <view class="repeat-audio-drawer-title">{{audioPickerTitle}}</view>
        <view class="repeat-audio-drawer-count">{{audioPickerAudios.length}}{{audioPickerUnit}}</view>
      </view>
      <view class="repeat-audio-drawer-close" hover-class="is-pressed" bindtap="closeRepeatAudioPicker">×</view>
    </view>
    <view class="repeat-audio-search">
          <input class="repeat-audio-search-input" value="{{audioPickerQuery}}" placeholder="{{texts.searchContent}}" placeholder-class="repeat-audio-search-placeholder" confirm-type="search" bindinput="filterRepeatAudios" />
      <view class="repeat-audio-search-clear" wx:if="{{audioPickerQuery}}" hover-class="is-pressed" bindtap="clearRepeatAudioSearch">×</view>
    </view>
    <scroll-view class="repeat-audio-option-scroll" style="height: {{audioPickerListHeight}};" scroll-y="{{true}}" enhanced="{{true}}" bounces="{{true}}" show-scrollbar="{{false}}" scroll-with-animation="{{true}}" scroll-into-view="{{audioPickerScrollIntoView}}">
      <view class="repeat-audio-option {{audioPickerSelectedId === item.id ? 'is-active' : ''}}" id="repeat-audio-option-{{item.pickerIndex}}" wx:for="{{audioPickerAudios}}" wx:key="id" data-picker-id="{{item.id}}" data-picker-index="{{item.pickerIndex}}" hover-class="is-pressed" bindtap="selectRepeatPickerItem">
        <view class="repeat-audio-option-number">{{item.pickerIndex + 1}}</view>
        <view class="repeat-audio-option-copy"><view>{{item.displayTitle}}</view><text>{{item.meta}}</text><text class="repeat-audio-option-preview" wx:if="{{audioPickerType === 'paragraph'}}">{{item.preview}}</text></view>
        <view class="repeat-audio-option-state"><view></view></view>
      </view>
          <view class="repeat-audio-option-empty" wx:if="{{!audioPickerAudios.length}}">{{texts.noMatchingContent}}</view>
    </scroll-view>
  </view>
</view>
