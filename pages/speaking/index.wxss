.speaking-page {
  padding-top: 72rpx;
  padding-bottom: 120rpx;
}

.speaking-hero,
.speaking-card {
  background: var(--surface-raised);
}

.speaking-hero {
  padding: 38rpx 34rpx;
}

.speaking-eyebrow,
.speaking-card-label,
.speaking-card-state,
.prompt-label {
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.speaking-title {
  margin-top: 12rpx;
  color: var(--text-strong);
  font-size: var(--font-page-title-size);
  line-height: var(--line-title);
  font-weight: var(--font-title-weight);
}

.speaking-copy {
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: var(--font-body-size);
  line-height: var(--line-body);
}

.speaking-card {
  margin-top: 26rpx;
  padding: 32rpx 28rpx;
}

.speaking-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.exercise-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.exercise-row {
  min-height: 104rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--border-soft);
  border-radius: var(--radius-lg);
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.exercise-row.is-active {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.exercise-main {
  min-width: 0;
}

.exercise-title {
  color: var(--text-strong);
  font-size: var(--font-section-title-size);
  line-height: var(--line-section);
  font-weight: var(--font-title-weight);
}

.exercise-meta {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.35;
}

.exercise-check {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: 34rpx;
  line-height: 1;
}

.prompt-text {
  margin-top: 16rpx;
  color: var(--text-strong);
  font-size: 34rpx;
  line-height: 1.45;
  font-weight: var(--font-title-weight);
}

.record-line {
  margin-top: 22rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.4;
}

.record-line.is-recording {
  color: #b84d3a;
}

.record-line.is-ready {
  color: var(--accent-deep);
}

.record-actions {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.listen-button {
  margin: 0;
  margin-top: 22rpx;
  width: 220rpx;
  height: 78rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-body-size);
  line-height: 78rpx;
  font-weight: var(--font-title-weight);
  background: var(--surface);
  color: var(--accent-deep);
  border: 1rpx solid var(--border-soft);
  transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.22s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.18s ease, background-color 0.18s ease;
  will-change: transform;
}

.hold-button {
  margin: 0;
  width: 100%;
  height: 112rpx;
  border-radius: var(--radius-lg);
  background: var(--accent);
  color: #ffffff;
  font-size: 34rpx;
  line-height: 112rpx;
  font-weight: var(--font-title-weight);
  transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.22s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.18s ease, background-color 0.18s ease;
  will-change: transform;
}

.listen-button:active,
.listen-button.is-pressed,
.hold-button:active,
.hold-button.is-pressed {
  transform: translateY(1rpx) scale(0.992);
  opacity: 0.96;
}

.hold-button.is-recording {
  background: #b84d3a;
}

.hold-button.is-disabled {
  opacity: 0.62;
}

.error-text {
  margin-top: 18rpx;
  color: #b84d3a;
  font-size: var(--font-caption-size);
  line-height: 1.4;
}

.score-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.score-item {
  min-height: 112rpx;
  border-radius: var(--radius-lg);
  background: var(--surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-value {
  color: var(--text-strong);
  font-size: 42rpx;
  line-height: 1;
  font-weight: var(--font-title-weight);
}

.score-label {
  margin-top: 10rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.2;
}
