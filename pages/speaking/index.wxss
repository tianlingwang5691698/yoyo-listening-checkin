.speaking-page {
  min-height: 100vh;
  padding-top: 68rpx;
  padding-bottom: 132rpx;
  background:
    radial-gradient(circle at 82% 8%, rgba(242, 161, 142, 0.16) 0, rgba(242, 161, 142, 0) 250rpx),
    radial-gradient(circle at 12% 24%, rgba(141, 183, 212, 0.2) 0, rgba(141, 183, 212, 0) 280rpx),
    linear-gradient(180deg, #f6fbfd 0%, #edf6fa 54%, #f8fcfd 100%);
  color: #17314f;
  box-sizing: border-box;
}

.speaking-header {
  padding: 6rpx 4rpx 0;
}

.speaking-title {
  color: #17314f;
  font-size: 46rpx;
  line-height: 1.18;
  font-weight: 600;
}

.speaking-copy {
  margin-top: 14rpx;
  color: #607087;
  font-size: 26rpx;
  line-height: 1.5;
}

.voice-cabin,
.score-card {
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 34rpx;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(237, 246, 250, 0.72));
  box-shadow: 0 28rpx 64rpx rgba(89, 125, 150, 0.13);
}

.voice-cabin {
  position: relative;
  overflow: hidden;
  margin-top: 30rpx;
  padding: 28rpx 28rpx 34rpx;
}

.voice-cabin::before {
  content: "";
  position: absolute;
  left: 42rpx;
  right: 42rpx;
  top: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.96);
}

.cabin-glow {
  position: absolute;
  left: 50%;
  top: 258rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  transform: translateX(-50%);
  background:
    radial-gradient(circle, rgba(191, 215, 232, 0.5) 0, rgba(191, 215, 232, 0.24) 38%, rgba(191, 215, 232, 0) 68%);
  pointer-events: none;
}

.prompt-panel {
  position: relative;
  z-index: 2;
  padding: 26rpx 26rpx 24rpx;
  border: 1rpx solid rgba(191, 215, 232, 0.44);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
}

.prompt-label,
.speaking-card-label {
  color: #607087;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 500;
}

.prompt-text {
  margin-top: 16rpx;
  color: #17314f;
  font-size: 34rpx;
  line-height: 1.5;
  font-weight: 600;
}

.prompt-replay {
  --speaking-prompt-base: #17314f;
  --speaking-prompt-active: #df7f68;
  color: var(--speaking-prompt-base);
  transform: translateY(0);
  transform-origin: 50% 70%;
  transition: color 0.18s ease, opacity 0.18s ease, transform 0.18s ease;
  will-change: transform;
}

.prompt-replay.is-pressed {
  opacity: 0.76;
  transform: translateY(2rpx) scale(0.995);
}

.prompt-replay.is-loading {
  animation: speakingPromptLoading 0.72s ease-in-out infinite alternate;
}

.prompt-replay.is-speaking {
  animation: speakingPromptFloat 1.05s ease-in-out infinite;
}

.voice-cabin.is-repeat-cabin {
  overflow: visible;
  margin-top: 20rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.voice-cabin.is-repeat-cabin::before,
.voice-cabin.is-repeat-cabin .cabin-glow {
  display: none;
}

.repeat-sentence-list {
  position: relative;
  z-index: 2;
  margin-top: 20rpx;
  border-top: 1rpx solid rgba(141, 183, 212, 0.34);
}

.repeat-sentence-item {
  border-bottom: 1rpx solid rgba(141, 183, 212, 0.3);
  background: rgba(255, 255, 255, 0.34);
  transition: background 0.18s ease, box-shadow 0.18s ease;
}

.repeat-sentence-item.is-active {
  background: rgba(255, 255, 255, 0.78);
  box-shadow: inset 6rpx 0 0 #df7f68;
}

.repeat-sentence-main {
  min-height: 106rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 14rpx 22rpx 18rpx;
  box-sizing: border-box;
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.repeat-sentence-main.is-pressed {
  opacity: 0.72;
  transform: translateY(1rpx);
}

.repeat-sentence-number {
  flex: 0 0 42rpx;
  width: 42rpx;
  color: #86aaa1;
  font-size: 23rpx;
  line-height: 1;
  font-weight: 700;
  text-align: center;
}

.repeat-sentence-text {
  min-width: 0;
  flex: 1;
  color: #17314f;
  font-size: 29rpx;
  line-height: 1.6;
  font-weight: 600;
}

.repeat-sentence-play {
  position: relative;
  flex: 0 0 58rpx;
  width: 58rpx;
  height: 58rpx;
  border: 2rpx solid rgba(141, 183, 212, 0.4);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  box-sizing: border-box;
}

.repeat-sentence-play view {
  position: absolute;
  left: 23rpx;
  top: 17rpx;
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 15rpx solid #607087;
}

.repeat-sentence-play text {
  position: relative;
  top: 16rpx;
  display: none;
  width: 4rpx;
  height: 20rpx;
  margin-left: 5rpx;
  border-radius: 999rpx;
  background: #df7f68;
  animation: repeatSentenceWave 0.58s ease-in-out infinite alternate;
}

.repeat-sentence-play text:nth-of-type(1) { margin-left: 14rpx; }
.repeat-sentence-play text:nth-of-type(2) { height: 28rpx; top: 12rpx; animation-delay: 0.12s; }
.repeat-sentence-play text:nth-of-type(3) { animation-delay: 0.24s; }
.repeat-sentence-play.is-playing view { display: none; }
.repeat-sentence-play.is-playing text { display: inline-block; }

.repeat-inline-actions {
  width: 100%;
  padding: 0 14rpx 24rpx 78rpx;
  box-sizing: border-box;
}

.repeat-inline-record {
  width: 230rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 8rpx;
  background: #17314f;
  color: #fff;
  font-size: 24rpx;
  line-height: 64rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.repeat-inline-record::after { border: 0; }
.repeat-inline-record.is-recording { background: #c64f43; }
.repeat-inline-record.is-pressed { transform: translateY(1rpx); opacity: 0.88; }

.repeat-inline-choice {
  width: 100%;
  display: flex;
  gap: 14rpx;
  box-sizing: border-box;
}

.repeat-inline-choice-button {
  min-width: 0;
  width: 0;
  flex: 1 1 0;
  height: 64rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 2rpx solid #17314f;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 60rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.repeat-inline-choice-button::after { border: 0; }
.repeat-inline-choice-button.is-secondary { background: #fff; color: #17314f; }
.repeat-inline-choice-button.is-primary { background: #17314f; color: #fff; }
.repeat-inline-choice-button.is-pressed { opacity: 0.82; transform: translateY(1rpx); }

.repeat-inline-state {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-left: 4rpx solid #df7f68;
  border-radius: 0 8rpx 8rpx 0;
  background: rgba(255, 255, 255, 0.72);
  color: #607087;
  font-size: 22rpx;
  line-height: 1.55;
}

.repeat-inline-result text { color: #17314f; font-weight: 800; }
.repeat-inline-result view { margin-top: 4rpx; }
.repeat-inline-progress { color: #df7f68; font-weight: 700; }
.repeat-inline-error { color: #b4382f; }

.repeat-sentence-list.is-library {
  margin-top: 12rpx;
  border-color: rgba(184, 149, 98, 0.34);
}

.repeat-sentence-list.is-library .repeat-sentence-item {
  border-color: rgba(184, 149, 98, 0.28);
  background: rgba(255, 253, 247, 0.46);
}

.repeat-sentence-list.is-library .repeat-sentence-item.is-active {
  background: rgba(255, 253, 247, 0.9);
  box-shadow: inset 6rpx 0 0 var(--library-speaking-brass);
}

.repeat-sentence-list.is-library .repeat-sentence-number { color: var(--library-speaking-brass); }
.repeat-sentence-list.is-library .repeat-sentence-text { --speaking-prompt-base: var(--library-speaking-ink); --speaking-prompt-active: var(--library-speaking-brass); font-family: Georgia, "Times New Roman", serif; }
.repeat-sentence-list.is-library .repeat-sentence-play { border-color: rgba(184, 149, 98, 0.4); background: rgba(255, 253, 247, 0.82); }
.repeat-sentence-list.is-library .repeat-sentence-play view { border-left-color: var(--library-speaking-brass); }
.repeat-sentence-list.is-library .repeat-sentence-play text { background: var(--library-speaking-brass); }
.repeat-sentence-list.is-library .repeat-inline-record { background: var(--library-speaking-ink); }
.repeat-sentence-list.is-library .repeat-inline-record.is-recording { background: var(--library-speaking-error); }
.repeat-sentence-list.is-library .repeat-inline-choice-button { border-color: var(--library-speaking-ink); }
.repeat-sentence-list.is-library .repeat-inline-choice-button.is-secondary { background: rgba(255, 253, 247, 0.9); color: var(--library-speaking-ink); }
.repeat-sentence-list.is-library .repeat-inline-choice-button.is-primary { background: var(--library-speaking-ink); color: #faf5ea; }
.repeat-sentence-list.is-library .repeat-inline-state { border-left-color: var(--library-speaking-brass); background: rgba(255, 253, 247, 0.78); }

@keyframes repeatSentenceWave {
  from { transform: scaleY(0.48); opacity: 0.6; }
  to { transform: scaleY(1); opacity: 1; }
}

.prompt-actions,
.speaking-card-top,
.score-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.prompt-actions {
  margin-top: 22rpx;
}

.prompt-tag,
.speaking-card-state {
  min-width: 0;
  color: #86aaa1;
  font-size: 23rpx;
  line-height: 1.25;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-dial {
  position: relative;
  z-index: 2;
  margin-top: 26rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.task-node {
  position: relative;
  min-width: 0;
  min-height: 112rpx;
  padding: 18rpx 14rpx 16rpx;
  border: 1rpx solid rgba(191, 215, 232, 0.42);
  border-radius: 28rpx 28rpx 18rpx 18rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.76), rgba(246, 251, 253, 0.52));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  box-sizing: border-box;
}

.task-node::after {
  content: "";
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 12rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background:
    linear-gradient(90deg, rgba(141, 183, 212, 0.12), rgba(141, 183, 212, 0.5), rgba(141, 183, 212, 0.12));
}

.task-node.is-active {
  border-color: rgba(223, 127, 104, 0.42);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(242, 161, 142, 0.16));
}

.task-node.is-active::after {
  background:
    linear-gradient(90deg, rgba(223, 127, 104, 0.18), rgba(223, 127, 104, 0.72), rgba(223, 127, 104, 0.18));
}

.node-pulse {
  width: 30rpx;
  height: 30rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.46);
  border-radius: 50%;
  background:
    radial-gradient(circle, rgba(141, 183, 212, 0.72) 0%, rgba(141, 183, 212, 0.72) 32%, rgba(191, 215, 232, 0.2) 34%, rgba(191, 215, 232, 0.2) 100%);
}

.task-node.is-active .node-pulse {
  border-color: rgba(223, 127, 104, 0.48);
  background:
    radial-gradient(circle, #df7f68 0%, #df7f68 32%, rgba(242, 161, 142, 0.2) 34%, rgba(242, 161, 142, 0.2) 100%);
}

.node-copy {
  margin-top: 12rpx;
}

.exercise-title {
  color: #17314f;
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.exercise-meta {
  margin-top: 7rpx;
  color: #728196;
  font-size: 21rpx;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-orbit {
  position: relative;
  z-index: 2;
  width: 390rpx;
  height: 390rpx;
  margin: 38rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.breath-ring,
.mic-sound-circle {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.ring-outer {
  width: 360rpx;
  height: 360rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.28);
  background:
    radial-gradient(circle, rgba(255, 255, 255, 0.42) 0, rgba(191, 215, 232, 0.14) 58%, rgba(191, 215, 232, 0) 72%);
}

.ring-mid {
  width: 280rpx;
  height: 280rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.48);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.84);
}

.mic-sound-circle {
  width: 220rpx;
  height: 220rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.26);
  background:
    radial-gradient(circle at 50% 38%, rgba(255, 255, 255, 0.86) 0%, rgba(255, 255, 255, 0.86) 35%, rgba(255, 255, 255, 0) 36%),
    linear-gradient(180deg, rgba(191, 215, 232, 0.28), rgba(255, 255, 255, 0.24));
}

.mic-sound-circle::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50rpx;
  width: 46rpx;
  height: 74rpx;
  border: 6rpx solid rgba(96, 112, 135, 0.36);
  border-radius: 28rpx;
  transform: translateX(-50%);
  box-sizing: border-box;
}

.mic-sound-circle::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 122rpx;
  width: 82rpx;
  height: 42rpx;
  border-bottom: 6rpx solid rgba(96, 112, 135, 0.34);
  border-left: 6rpx solid rgba(96, 112, 135, 0.34);
  border-right: 6rpx solid rgba(96, 112, 135, 0.34);
  border-radius: 0 0 48rpx 48rpx;
  transform: translateX(-50%);
  box-sizing: border-box;
}

.mic-stem {
  position: absolute;
  left: 50%;
  top: 162rpx;
  width: 6rpx;
  height: 26rpx;
  border-radius: 999rpx;
  transform: translateX(-50%);
  background: rgba(96, 112, 135, 0.34);
}

.wave-field {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 300rpx;
  height: 118rpx;
  margin-left: -150rpx;
  margin-top: -59rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  opacity: 0.42;
  pointer-events: none;
}

.wave-bar {
  width: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #bfd7e8, #8db7d4);
}

.bar-one,
.bar-five {
  height: 42rpx;
}

.bar-two,
.bar-four {
  height: 76rpx;
}

.bar-three {
  height: 108rpx;
}

.record-orbit.is-recording .ring-outer {
  animation: speakingBreath 1.55s ease-out infinite;
}

.record-orbit.is-recording .ring-mid {
  animation: speakingBreathInner 1.55s ease-in-out infinite;
}

.record-orbit.is-recording .wave-bar {
  animation: speakingWave 0.72s ease-in-out infinite alternate;
}

.record-orbit.is-recording .bar-two {
  animation-delay: 0.08s;
}

.record-orbit.is-recording .bar-three {
  animation-delay: 0.16s;
}

.record-orbit.is-recording .bar-four {
  animation-delay: 0.24s;
}

.record-orbit.is-recording .bar-five {
  animation-delay: 0.32s;
}

.hold-button {
  position: relative;
  z-index: 3;
  margin: 0;
  width: 174rpx;
  height: 174rpx;
  padding: 0;
  border-radius: 50%;
  background: linear-gradient(145deg, #f2a18e, #df7f68);
  color: #ffffff;
  font-size: 27rpx;
  line-height: 174rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 24rpx 46rpx rgba(223, 127, 104, 0.26), inset 0 2rpx 0 rgba(255, 255, 255, 0.34);
  transition: transform 0.2s ease, opacity 0.18s ease, box-shadow 0.2s ease;
}

.hold-button.is-recording {
  transform: scale(0.96);
  box-shadow: 0 16rpx 34rpx rgba(223, 127, 104, 0.24), inset 0 2rpx 0 rgba(255, 255, 255, 0.28);
}

.hold-button.is-disabled {
  opacity: 0.68;
}

.hold-button::after {
  border: 0;
}

.hold-button:active,
.hold-button.is-pressed {
  transform: translateY(1rpx) scale(0.985);
  opacity: 0.95;
}

.record-line {
  position: relative;
  z-index: 2;
  margin-top: 0;
  color: #728196;
  font-size: 24rpx;
  line-height: 1.4;
  text-align: center;
}

.record-line.is-recording {
  color: #df7f68;
}

.record-line.is-ready {
  color: #86aaa1;
}

.error-text {
  position: relative;
  z-index: 2;
  margin-top: 18rpx;
  color: #b66358;
  font-size: 23rpx;
  line-height: 1.4;
  text-align: center;
}

.score-card {
  position: relative;
  overflow: hidden;
  margin-top: 24rpx;
  padding: 30rpx 28rpx 32rpx;
}

.score-meters {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.score-item {
  min-width: 0;
  padding: 20rpx 16rpx 18rpx;
  border: 1rpx solid rgba(191, 215, 232, 0.38);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.58);
  box-sizing: border-box;
}

.score-row {
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
}

.score-label {
  color: #607087;
  font-size: 23rpx;
  line-height: 1.25;
  font-weight: 500;
}

.score-value {
  color: #17314f;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 600;
}

.meter-track {
  position: relative;
  overflow: hidden;
  height: 92rpx;
  margin-top: 18rpx;
  border-radius: 999rpx 999rpx 20rpx 20rpx;
  background:
    linear-gradient(180deg, rgba(191, 215, 232, 0.2), rgba(191, 215, 232, 0.42));
}

.meter-track::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 14rpx;
  width: 54rpx;
  height: 54rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 50%;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.36);
  z-index: 2;
}

.meter-fill {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 100%;
  min-width: 10rpx;
  max-width: 100%;
  border-radius: inherit;
  background: linear-gradient(180deg, rgba(141, 183, 212, 0.86), rgba(134, 170, 161, 0.9));
}

.score-card.is-celebrating::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(120deg, transparent 0%, rgba(255, 255, 255, 0.7) 46%, transparent 70%);
  transform: translateX(-100%);
  animation: speakingScoreShine 1.1s ease-out forwards;
}

.score-card.is-celebrating .meter-fill {
  animation: speakingScorePop 0.62s cubic-bezier(0.2, 0.8, 0.2, 1);
}

@keyframes speakingBreath {
  0% {
    opacity: 0.8;
    transform: translate(-50%, -50%) scale(0.94);
  }
  100% {
    opacity: 0.08;
    transform: translate(-50%, -50%) scale(1.15);
  }
}

@keyframes speakingBreathInner {
  0% {
    transform: translate(-50%, -50%) scale(0.98);
  }
  100% {
    transform: translate(-50%, -50%) scale(1.05);
  }
}

@keyframes speakingWave {
  0% {
    transform: scaleY(0.66);
  }
  100% {
    transform: scaleY(1.08);
  }
}

@keyframes speakingPromptFloat {
  0%,
  100% {
    color: var(--speaking-prompt-base);
    transform: translateY(0);
    text-shadow: 0 0 0 rgba(141, 183, 212, 0);
  }
  50% {
    color: var(--speaking-prompt-active);
    transform: translateY(-7rpx);
    text-shadow: 0 10rpx 20rpx rgba(141, 183, 212, 0.22);
  }
}

@keyframes speakingPromptLoading {
  0% { opacity: 0.62; }
  100% { opacity: 1; }
}

@keyframes speakingScoreShine {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}

@keyframes speakingScorePop {
  0% {
    transform: scaleX(0.72);
  }
  54% {
    transform: scaleX(1.02);
  }
  100% {
    transform: scaleX(1);
  }
}

.library-speaking-page {
  --library-speaking-bg: #faf5ea;
  --library-speaking-wood: #2b211b;
  --library-speaking-ink: #14283a;
  --library-speaking-paper: #f3e8d4;
  --library-speaking-paper-hi: #fffdf7;
  --library-speaking-brass: #b89562;
  --library-speaking-moss: #7f8c78;
  --library-speaking-muted: #6f675f;
  --library-speaking-error: #9a5f54;
  --library-speaking-rule: rgba(184, 149, 98, 0.42);
  --library-speaking-shadow: 0 6rpx 18rpx rgba(43, 33, 27, 0.13);
