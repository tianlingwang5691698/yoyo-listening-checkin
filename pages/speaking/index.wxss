.ielts-exam-sheet .ielts-question-nav button.is-next { border-color: var(--ielts-exam-primary); background: var(--ielts-exam-primary); color: #fff; }
.ielts-exam-sheet .ielts-question-nav button.is-disabled { opacity: 0.34; }

.theme-warm .ielts-exam-sheet { --ielts-exam-paper: rgba(255, 255, 255, 0.68); }
.theme-warm .ielts-intro-script,
.theme-warm .ielts-inline-state.is-focus { box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.82); }
.theme-warm .repeat-sentence-item.is-active { background: rgba(237, 246, 250, 0.9); box-shadow: inset 6rpx 0 0 #8db7d4; }
.theme-warm .repeat-inline-record { background: #17314f; }
.theme-warm .repeat-inline-record.is-recording { background: #b4382f; }
.theme-warm .repeat-inline-state { border-left-color: #8db7d4; background: rgba(255, 255, 255, 0.72); }

.theme-voyage .ielts-exam-sheet {
  --ielts-exam-ink: #173b50;
  --ielts-exam-muted: #65533e;
  --ielts-exam-accent: #c49338;
  --ielts-exam-primary: #176a99;
  --ielts-exam-danger: #a34432;
  --ielts-exam-paper: rgba(255, 249, 226, 0.84);
  --ielts-exam-border: rgba(143, 94, 42, 0.42);
  --ielts-exam-radius: 8rpx;
}
.theme-voyage .ielts-exam-sheet .ielts-intro-title,
.theme-voyage .ielts-exam-sheet .ielts-focus-part,
.theme-voyage .ielts-exam-sheet .ielts-focus-question,
.theme-voyage .ielts-exam-sheet .ielts-cue-task { font-family: "Songti SC", "STSong", serif; }
.theme-voyage .ielts-exam-sheet .ielts-session-start,
.theme-voyage .ielts-exam-sheet .ielts-focus-answer { color: #fff8e7; box-shadow: inset 0 0 0 2rpx rgba(244, 207, 120, 0.24); }
.theme-voyage .ielts-exam-sheet .ielts-question-nav button.is-next { color: #fff8e7; }

.theme-dragon .ielts-exam-sheet {
  --ielts-exam-ink: #102e62;
  --ielts-exam-muted: #65533e;
  --ielts-exam-accent: #f4b400;
  --ielts-exam-primary: #f45a16;
  --ielts-exam-danger: #b72d24;
  --ielts-exam-paper: #fffef7;
  --ielts-exam-border: rgba(16, 46, 98, 0.38);
  --ielts-exam-radius: 8rpx;
}
.theme-dragon .ielts-exam-sheet .ielts-intro-script,
.theme-dragon .ielts-exam-sheet .ielts-reveal-button,
.theme-dragon .ielts-exam-sheet .ielts-focus-answer,
.theme-dragon .ielts-exam-sheet .ielts-score-button.is-focus,
.theme-dragon .ielts-exam-sheet .ielts-inline-state.is-focus,
.theme-dragon .ielts-exam-sheet .ielts-question-nav button { border-width: 3rpx; border-color: #102e62; }
.theme-dragon .ielts-exam-sheet .ielts-session-start,
.theme-dragon .ielts-exam-sheet .ielts-focus-answer,
.theme-dragon .ielts-exam-sheet .ielts-question-nav button.is-next { border: 3rpx solid #102e62; background: #f45a16; color: #fff; }
.theme-dragon .ielts-exam-sheet .ielts-focus-answer[disabled] { border-color: rgba(16, 46, 98, 0.34); background: #e8e1ce; color: #746c60; }
.theme-dragon .ielts-exam-sheet .ielts-focus-answer.is-recording { border-color: #102e62; background: #b72d24; }
.theme-dragon .ielts-exam-sheet .ielts-play-button { border: 3rpx solid #102e62; background: #ffd83d; }
.theme-dragon .ielts-exam-sheet .ielts-score-button.is-focus { background: #fffef7; color: #b72d24; }
