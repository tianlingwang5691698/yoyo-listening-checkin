}

.library-tick {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 3rpx;
  height: 22rpx;
  margin-left: -1.5rpx;
  margin-top: -126rpx;
  border-radius: 999rpx;
  background: rgba(184, 149, 98, 0.48);
  transform-origin: 50% 126rpx;
}

.tick-1 { transform: rotate(0deg); }
.tick-2 { transform: rotate(30deg); }
.tick-3 { transform: rotate(60deg); }
.tick-4 { transform: rotate(90deg); }
.tick-5 { transform: rotate(120deg); }
.tick-6 { transform: rotate(150deg); }
.tick-7 { transform: rotate(180deg); }
.tick-8 { transform: rotate(210deg); }
.tick-9 { transform: rotate(240deg); }
.tick-10 { transform: rotate(270deg); }
.tick-11 { transform: rotate(300deg); }
.tick-12 { transform: rotate(330deg); }

.library-brass-mic {
  position: absolute;
  left: 50%;
  top: 82rpx;
  width: 160rpx;
  height: 212rpx;
  margin-left: -80rpx;
}

.library-mic-head {
  position: absolute;
  left: 50%;
  top: 0;
  width: 82rpx;
  height: 112rpx;
  margin-left: -41rpx;
  border: 4rpx solid rgba(255, 244, 208, 0.6);
  border-radius: 42rpx;
  background:
    repeating-linear-gradient(90deg, rgba(255, 244, 208, 0.5) 0, rgba(255, 244, 208, 0.5) 2rpx, transparent 2rpx, transparent 12rpx),
    linear-gradient(180deg, #d8bc85, #a98045);
  box-sizing: border-box;
}

.library-mic-yoke {
  position: absolute;
  left: 31rpx;
  top: 72rpx;
  width: 98rpx;
  height: 62rpx;
  border-right: 5rpx solid var(--library-speaking-brass);
  border-bottom: 5rpx solid var(--library-speaking-brass);
  border-left: 5rpx solid var(--library-speaking-brass);
  border-radius: 0 0 52rpx 52rpx;
  box-sizing: border-box;
}

.library-mic-stem {
  position: absolute;
  left: 50%;
  top: 132rpx;
  width: 8rpx;
  height: 46rpx;
  margin-left: -4rpx;
  border-radius: 999rpx;
  background: var(--library-speaking-brass);
}

.library-mic-foot {
  position: absolute;
  left: 34rpx;
  top: 176rpx;
  width: 92rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8f6b35, #d8bc85, #8f6b35);
}

.library-voice-slot {
  position: absolute;
  left: 70rpx;
  right: 70rpx;
  bottom: 92rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  border-top: 1rpx solid rgba(184, 149, 98, 0.28);
  border-bottom: 1rpx solid rgba(184, 149, 98, 0.28);
}

.library-voice-line {
  width: 46rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: rgba(184, 149, 98, 0.28);
}

.library-record-desk.is-recording .library-voice-line {
  animation: librarySpeakingWave 0.7s ease-in-out infinite alternate;
}

.library-record-desk.is-recording .is-b { animation-delay: 0.08s; }
.library-record-desk.is-recording .is-c { animation-delay: 0.16s; }
.library-record-desk.is-recording .is-d { animation-delay: 0.24s; }
.library-record-desk.is-recording .is-e { animation-delay: 0.32s; }

.library-proof-ruler {
  position: absolute;
  left: 104rpx;
  right: 104rpx;
  bottom: 102rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8f6b35, #d8bc85, #8f6b35);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.18);
}

.library-hold-button {
  position: absolute;
  left: 50%;
  bottom: 24rpx;
  width: 250rpx;
  height: 58rpx;
  margin: 0 0 0 -125rpx;
  padding: 0;
  border: 1rpx solid rgba(184, 149, 98, 0.72);
  border-radius: 10rpx;
  background: linear-gradient(180deg, #1a354c, var(--library-speaking-ink));
  color: #faf5ea;
  font-size: 25rpx;
  line-height: 58rpx;
  font-weight: 600;
  box-shadow: inset 0 0 0 2rpx rgba(184, 149, 98, 0.18), 0 8rpx 16rpx rgba(0, 0, 0, 0.2);
}

.library-hold-button.is-recording {
  transform: translateY(3rpx);
}

.library-hold-button.is-disabled {
  opacity: 0.68;
}

.library-record-note,
.library-error-note {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
}

.library-record-note {
  color: var(--library-speaking-muted);
}

.library-record-note.is-recording {
  color: var(--library-speaking-brass);
}

.library-record-note.is-ready {
  color: var(--library-speaking-moss);
}

.library-error-note {
  padding: 16rpx 20rpx;
  border-left: 4rpx solid var(--library-speaking-error);
  border-radius: 8rpx;
  background: rgba(154, 95, 84, 0.08);
  color: var(--library-speaking-error);
  text-align: left;
}

.library-score-sheet {
  overflow: hidden;
  padding: 28rpx 28rpx 30rpx;
}

.library-score-value {
  margin-top: 8rpx;
  color: var(--library-speaking-ink);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 54rpx;
  line-height: 1;
  font-weight: 600;
}

.library-score-stamp {
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.45);
  border-radius: 8rpx;
  transform: rotate(2deg);
}

.library-score-rulers {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.library-score-ruler {
  min-width: 0;
  padding: 18rpx 14rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.25);
  border-radius: 10rpx;
  background: rgba(255, 253, 247, 0.58);
  box-sizing: border-box;
}

.library-ruler-head {
  align-items: center;
}

.library-ruler-label {
  color: var(--library-speaking-muted);
  font-size: 22rpx;
  line-height: 1.25;
}

.library-ruler-value {
  color: var(--library-speaking-ink);
  font-size: 28rpx;
  line-height: 1;
  font-weight: 600;
}

.library-ruler-track {
  position: relative;
  overflow: hidden;
  height: 118rpx;
  margin-top: 16rpx;
  border-radius: 8rpx;
  background:
    repeating-linear-gradient(180deg, rgba(184, 149, 98, 0.2) 0, rgba(184, 149, 98, 0.2) 1rpx, transparent 1rpx, transparent 22rpx),
    rgba(20, 40, 58, 0.08);
}

.library-ruler-fill {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 6rpx;
  max-height: 100%;
  background: linear-gradient(180deg, rgba(184, 149, 98, 0.82), rgba(127, 140, 120, 0.88));
}

.library-score-sheet.is-celebrating::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(105deg, transparent 0%, rgba(255, 244, 208, 0.5) 46%, transparent 70%);
  transform: translateX(-100%);
  animation: libraryScoreShine 1.1s ease-out forwards;
}

.library-speaking-empty {
  padding: 48rpx 28rpx;
  text-align: center;
}

.library-empty-box {
  position: relative;
  width: 180rpx;
  height: 118rpx;
  margin: 0 auto 20rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.38);
  border-radius: 10rpx;
  background: linear-gradient(180deg, #3a2b22, var(--library-speaking-wood));
}

.library-empty-box::before {
  content: "";
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 36rpx;
  height: 1rpx;
  background: rgba(184, 149, 98, 0.38);
}

.library-empty-mic {
  position: absolute;
  left: 50%;
  top: 30rpx;
  width: 38rpx;
  height: 52rpx;
  margin-left: -19rpx;
  border: 3rpx solid rgba(184, 149, 98, 0.7);
  border-radius: 22rpx;
}

.library-empty-title {
  color: var(--library-speaking-muted);
  font-size: 25rpx;
  line-height: 1.5;
}

@keyframes librarySpeakingBreath {
  0% {
    opacity: 0.72;
    transform: scale(0.98);
  }
  100% {
    opacity: 0.22;
    transform: scale(1.08);
  }
}

@keyframes librarySpeakingWave {
  0% {
    height: 2rpx;
  }
  100% {
    height: 18rpx;
  }
}

@keyframes libraryScoreShine {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}

@media (prefers-reduced-motion: reduce) {
  .prompt-replay.is-loading,
  .prompt-replay.is-speaking,
  .ielts-play-button.is-loading,
  .ielts-play-wave text,
  .repeat-audio-drawer-mask,
  .repeat-audio-drawer {
    animation: none;
  }
}

.speaking-entry-card {
