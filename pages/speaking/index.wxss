.speaking-page {
  min-height: 100vh;
  padding-top: 68rpx;
  padding-bottom: 132rpx;
  background:
    radial-gradient(circle at 82% 8%, rgba(242, 161, 142, 0.16) 0, rgba(242, 161, 142, 0) 250rpx),
    radial-gradient(circle at 12% 24%, rgba(141, 183, 212, 0.2) 0, rgba(141, 183, 212, 0) 280rpx),
    linear-gradient(180deg, #f6fbfd 0%, #edf6fa 54%, #f8fcfd 100%);
  color: #17314f;
  box-sizing: border-box;
}

.speaking-header {
  padding: 6rpx 4rpx 0;
}

.speaking-title {
  color: #17314f;
  font-size: 46rpx;
  line-height: 1.18;
  font-weight: 600;
}

.speaking-copy {
  margin-top: 14rpx;
  color: #607087;
  font-size: 26rpx;
  line-height: 1.5;
}

.voice-cabin,
.score-card {
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 34rpx;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(237, 246, 250, 0.72));
  box-shadow: 0 28rpx 64rpx rgba(89, 125, 150, 0.13);
}

.voice-cabin {
  position: relative;
  overflow: hidden;
  margin-top: 30rpx;
  padding: 28rpx 28rpx 34rpx;
}

.voice-cabin::before {
  content: "";
  position: absolute;
  left: 42rpx;
  right: 42rpx;
  top: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.96);
}

.cabin-glow {
  position: absolute;
  left: 50%;
  top: 258rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  transform: translateX(-50%);
  background:
    radial-gradient(circle, rgba(191, 215, 232, 0.5) 0, rgba(191, 215, 232, 0.24) 38%, rgba(191, 215, 232, 0) 68%);
  pointer-events: none;
}

.prompt-panel {
  position: relative;
  z-index: 2;
  padding: 26rpx 26rpx 24rpx;
  border: 1rpx solid rgba(191, 215, 232, 0.44);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
}

.prompt-label,
.speaking-card-label {
  color: #607087;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 500;
}

.prompt-text {
  margin-top: 16rpx;
  color: #17314f;
  font-size: 34rpx;
  line-height: 1.5;
  font-weight: 600;
}

.prompt-actions,
.speaking-card-top,
.score-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.prompt-actions {
  margin-top: 22rpx;
}

.prompt-tag,
.speaking-card-state {
  min-width: 0;
  color: #86aaa1;
  font-size: 23rpx;
  line-height: 1.25;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.listen-button {
  flex-shrink: 0;
  margin: 0;
  width: 160rpx;
  height: 62rpx;
  padding: 0;
  border: 1rpx solid rgba(141, 183, 212, 0.34);
  border-radius: 999rpx;
  background: rgba(246, 251, 253, 0.94);
  color: #607087;
  font-size: 24rpx;
  line-height: 62rpx;
  font-weight: 600;
  box-shadow: none;
  transition: transform 0.2s ease, opacity 0.18s ease;
}

.task-dial {
  position: relative;
  z-index: 2;
  margin-top: 26rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.task-node {
  position: relative;
  min-width: 0;
  min-height: 112rpx;
  padding: 18rpx 14rpx 16rpx;
  border: 1rpx solid rgba(191, 215, 232, 0.42);
  border-radius: 28rpx 28rpx 18rpx 18rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.76), rgba(246, 251, 253, 0.52));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  box-sizing: border-box;
}

.task-node::after {
  content: "";
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 12rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background:
    linear-gradient(90deg, rgba(141, 183, 212, 0.12), rgba(141, 183, 212, 0.5), rgba(141, 183, 212, 0.12));
}

.task-node.is-active {
  border-color: rgba(223, 127, 104, 0.42);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(242, 161, 142, 0.16));
}

.task-node.is-active::after {
  background:
    linear-gradient(90deg, rgba(223, 127, 104, 0.18), rgba(223, 127, 104, 0.72), rgba(223, 127, 104, 0.18));
}

.node-pulse {
  width: 30rpx;
  height: 30rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.46);
  border-radius: 50%;
  background:
    radial-gradient(circle, rgba(141, 183, 212, 0.72) 0%, rgba(141, 183, 212, 0.72) 32%, rgba(191, 215, 232, 0.2) 34%, rgba(191, 215, 232, 0.2) 100%);
}

.task-node.is-active .node-pulse {
  border-color: rgba(223, 127, 104, 0.48);
  background:
    radial-gradient(circle, #df7f68 0%, #df7f68 32%, rgba(242, 161, 142, 0.2) 34%, rgba(242, 161, 142, 0.2) 100%);
}

.node-copy {
  margin-top: 12rpx;
}

.exercise-title {
  color: #17314f;
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.exercise-meta {
  margin-top: 7rpx;
  color: #728196;
  font-size: 21rpx;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-orbit {
  position: relative;
  z-index: 2;
  width: 390rpx;
  height: 390rpx;
  margin: 38rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.breath-ring,
.mic-sound-circle {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.ring-outer {
  width: 360rpx;
  height: 360rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.28);
  background:
    radial-gradient(circle, rgba(255, 255, 255, 0.42) 0, rgba(191, 215, 232, 0.14) 58%, rgba(191, 215, 232, 0) 72%);
}

.ring-mid {
  width: 280rpx;
  height: 280rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.48);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.84);
}

.mic-sound-circle {
  width: 220rpx;
  height: 220rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.26);
  background:
    radial-gradient(circle at 50% 38%, rgba(255, 255, 255, 0.86) 0%, rgba(255, 255, 255, 0.86) 35%, rgba(255, 255, 255, 0) 36%),
    linear-gradient(180deg, rgba(191, 215, 232, 0.28), rgba(255, 255, 255, 0.24));
}

.mic-sound-circle::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50rpx;
  width: 46rpx;
  height: 74rpx;
  border: 6rpx solid rgba(96, 112, 135, 0.36);
  border-radius: 28rpx;
  transform: translateX(-50%);
  box-sizing: border-box;
}

.mic-sound-circle::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 122rpx;
  width: 82rpx;
  height: 42rpx;
  border-bottom: 6rpx solid rgba(96, 112, 135, 0.34);
  border-left: 6rpx solid rgba(96, 112, 135, 0.34);
  border-right: 6rpx solid rgba(96, 112, 135, 0.34);
  border-radius: 0 0 48rpx 48rpx;
  transform: translateX(-50%);
  box-sizing: border-box;
}

.mic-stem {
  position: absolute;
  left: 50%;
  top: 162rpx;
  width: 6rpx;
  height: 26rpx;
  border-radius: 999rpx;
  transform: translateX(-50%);
  background: rgba(96, 112, 135, 0.34);
}

.wave-field {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 300rpx;
  height: 118rpx;
  margin-left: -150rpx;
  margin-top: -59rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  opacity: 0.42;
  pointer-events: none;
}

.wave-bar {
  width: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #bfd7e8, #8db7d4);
}

.bar-one,
.bar-five {
  height: 42rpx;
}

.bar-two,
.bar-four {
  height: 76rpx;
}

.bar-three {
  height: 108rpx;
}

.record-orbit.is-recording .ring-outer {
  animation: speakingBreath 1.55s ease-out infinite;
}

.record-orbit.is-recording .ring-mid {
  animation: speakingBreathInner 1.55s ease-in-out infinite;
}

.record-orbit.is-recording .wave-bar {
  animation: speakingWave 0.72s ease-in-out infinite alternate;
}

.record-orbit.is-recording .bar-two {
  animation-delay: 0.08s;
}

.record-orbit.is-recording .bar-three {
  animation-delay: 0.16s;
}

.record-orbit.is-recording .bar-four {
  animation-delay: 0.24s;
}

.record-orbit.is-recording .bar-five {
  animation-delay: 0.32s;
}

.hold-button {
  position: relative;
  z-index: 3;
  margin: 0;
  width: 174rpx;
  height: 174rpx;
  padding: 0;
  border-radius: 50%;
  background: linear-gradient(145deg, #f2a18e, #df7f68);
  color: #ffffff;
  font-size: 27rpx;
  line-height: 174rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 24rpx 46rpx rgba(223, 127, 104, 0.26), inset 0 2rpx 0 rgba(255, 255, 255, 0.34);
  transition: transform 0.2s ease, opacity 0.18s ease, box-shadow 0.2s ease;
}

.hold-button.is-recording {
  transform: scale(0.96);
  box-shadow: 0 16rpx 34rpx rgba(223, 127, 104, 0.24), inset 0 2rpx 0 rgba(255, 255, 255, 0.28);
}

.hold-button.is-disabled {
  opacity: 0.68;
}

.listen-button::after,
.hold-button::after {
  border: 0;
}

.listen-button:active,
.listen-button.is-pressed,
.hold-button:active,
.hold-button.is-pressed {
  transform: translateY(1rpx) scale(0.985);
  opacity: 0.95;
}

.record-line {
  position: relative;
  z-index: 2;
  margin-top: 0;
  color: #728196;
  font-size: 24rpx;
  line-height: 1.4;
  text-align: center;
}

.record-line.is-recording {
  color: #df7f68;
}

.record-line.is-ready {
  color: #86aaa1;
}

.error-text {
  position: relative;
  z-index: 2;
  margin-top: 18rpx;
  color: #b66358;
  font-size: 23rpx;
  line-height: 1.4;
  text-align: center;
}

.score-card {
  position: relative;
  overflow: hidden;
  margin-top: 24rpx;
  padding: 30rpx 28rpx 32rpx;
}

.score-meters {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.score-item {
  min-width: 0;
  padding: 20rpx 16rpx 18rpx;
  border: 1rpx solid rgba(191, 215, 232, 0.38);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.58);
  box-sizing: border-box;
}

.score-row {
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
}

.score-label {
  color: #607087;
  font-size: 23rpx;
  line-height: 1.25;
  font-weight: 500;
}

.score-value {
  color: #17314f;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 600;
}

.meter-track {
  position: relative;
  overflow: hidden;
  height: 92rpx;
  margin-top: 18rpx;
  border-radius: 999rpx 999rpx 20rpx 20rpx;
  background:
    linear-gradient(180deg, rgba(191, 215, 232, 0.2), rgba(191, 215, 232, 0.42));
}

.meter-track::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 14rpx;
  width: 54rpx;
  height: 54rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 50%;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.36);
  z-index: 2;
}

.meter-fill {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 100%;
  min-width: 10rpx;
  max-width: 100%;
  border-radius: inherit;
  background: linear-gradient(180deg, rgba(141, 183, 212, 0.86), rgba(134, 170, 161, 0.9));
}

.score-card.is-celebrating::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(120deg, transparent 0%, rgba(255, 255, 255, 0.7) 46%, transparent 70%);
  transform: translateX(-100%);
  animation: speakingScoreShine 1.1s ease-out forwards;
}

.score-card.is-celebrating .meter-fill {
  animation: speakingScorePop 0.62s cubic-bezier(0.2, 0.8, 0.2, 1);
}

@keyframes speakingBreath {
  0% {
    opacity: 0.8;
    transform: translate(-50%, -50%) scale(0.94);
  }
  100% {
    opacity: 0.08;
    transform: translate(-50%, -50%) scale(1.15);
  }
}

@keyframes speakingBreathInner {
  0% {
    transform: translate(-50%, -50%) scale(0.98);
  }
  100% {
    transform: translate(-50%, -50%) scale(1.05);
  }
}

@keyframes speakingWave {
  0% {
    transform: scaleY(0.66);
  }
  100% {
    transform: scaleY(1.08);
  }
}

@keyframes speakingScoreShine {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}

@keyframes speakingScorePop {
  0% {
    transform: scaleX(0.72);
  }
  54% {
    transform: scaleX(1.02);
  }
  100% {
    transform: scaleX(1);
  }
}
