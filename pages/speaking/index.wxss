    repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.12) 0, rgba(0, 0, 0, 0.12) 1rpx, transparent 1rpx, transparent 54rpx);
}

.library-breath-scale {
  position: absolute;
  left: 50%;
  top: 42rpx;
  width: 260rpx;
  height: 260rpx;
  margin-left: -130rpx;
