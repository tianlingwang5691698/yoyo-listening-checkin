<view class="theme-{{theme}} language-{{language}} page-shell profile-page">
  <view wx:if="{{theme === 'library'}}" class="library-profile">
    <view class="library-bookplate">
      <view class="bookplate-stamp">
        <view class="stamp-label">EX LIBRIS</view>
        <view class="stamp-book-icon"><view></view></view>
        <view class="stamp-role">{{currentMember.studyRole === 'parent' ? texts.parent : texts.student}}</view>
      </view>
      <view class="bookplate-main" wx:if="{{profileHydrated}}">
        <view class="bookplate-kicker">{{texts.myBookplate}}</view>
        <view class="bookplate-name">{{profileNickname}}</view>
        <view class="bookplate-code" wx:if="{{currentMember && currentMember.studyRole === 'student'}}">{{texts.readerCard}} {{childCodeText}}</view>
        <view class="bookplate-code" wx:else>{{currentMember.studyRole === 'student' ? texts.student : texts.parent}}</view>
        <view class="bookplate-quote">{{dailyEncouragement.english}}</view>
        <view class="bookplate-cn" wx:if="{{language !== 'en'}}">{{dailyEncouragement.chinese}}</view>
      </view>
      <view class="bookplate-main" wx:else>
        <view class="library-skeleton title"></view>
        <view class="library-skeleton line"></view>
        <view class="library-skeleton short"></view>
      </view>
    </view>

    <view class="library-note is-error" wx:if="{{profileHydrated && syncMode === 'cloud-error'}}">{{texts.syncFailed}}</view>
    <view class="library-debug {{syncMode === 'cloud' ? 'is-cloud' : 'is-local'}}" wx:if="{{showCloudDebug && syncDebug && syncDebug.show}}">
      {{syncDebug.text}}
    </view>

    <view class="library-entries" wx:if="{{profileHydrated}}">
      <view class="library-entry entry-letter" bindtap="openParentPage">
        <view class="entry-mark">{{texts.letter}}</view>
        <view class="entry-main">
          <view class="entry-title">{{texts.dailyReport}}</view>
          <view class="entry-copy">{{texts.dailyReportDescription}}</view>
        </view>
        <view class="entry-arrow">›</view>
      </view>
      <view class="library-entry entry-dossier" bindtap="openSettingsPage">
        <view class="entry-mark">{{texts.document}}</view>
        <view class="entry-main">
          <view class="entry-title">{{texts.settings}}</view>
          <view class="entry-copy">{{texts.settingsDescription}}</view>
        </view>
        <view class="entry-arrow">›</view>
      </view>
    </view>
  </view>

  <view wx:elif="{{theme === 'voyage' || theme === 'dragon' || theme === 'tactical'}}" class="voyage-profile">
    <view class="voyage-profile-hero">
      <view class="voyage-profile-seal">
        <image wx:if="{{theme === 'voyage'}}" class="voyage-profile-photo" src="https://796f-youshengenglish-6glk12rd6c6e719b-1419984942.tcb.qcloud.la/_assets/themes/voyage/20260727-anime-v1/subpages/profile-luffy-sunny.jpg" mode="aspectFill"></image>
        <image wx:elif="{{theme === 'dragon'}}" class="dragon-classic-profile-photo" src="https://796f-youshengenglish-6glk12rd6c6e719b-1419984942.tcb.qcloud.la/_assets/themes/dragon/20260727-classic-v1/subpages/profile-kid-goku.jpg" mode="aspectFill"></image>
        <image wx:elif="{{theme === 'tactical'}}" class="tactical-profile-photo" src="https://796f-youshengenglish-6glk12rd6c6e719b-1419984942.tcb.qcloud.la/_assets/themes/tactical/20260727-subpages-v1/profile-operator.jpg" mode="aspectFill"></image>
        <view wx:else class="voyage-wheel"><view></view></view>
        <view class="voyage-role">{{currentMember.studyRole === 'parent' ? texts.parent : texts.student}}</view>
      </view>
      <view class="voyage-profile-main" wx:if="{{profileHydrated}}">
        <view class="voyage-kicker">{{theme === 'dragon' ? 'TRAINING RECORD' : (theme === 'tactical' ? 'TACTICAL DOSSIER' : 'VOYAGE LOG')}}</view>
        <view class="voyage-profile-name">{{profileNickname}}</view>
        <view class="voyage-profile-code" wx:if="{{currentMember && currentMember.studyRole === 'student'}}">{{texts.studentId}} {{childCodeText}}</view>
        <view class="voyage-profile-code" wx:else>{{currentMember.studyRole === 'student' ? texts.student : texts.parent}}</view>
        <view class="voyage-profile-quote">{{dailyEncouragement.english}}</view>
        <view class="voyage-profile-cn" wx:if="{{language !== 'en'}}">{{dailyEncouragement.chinese}}</view>
      </view>
      <view class="voyage-profile-main" wx:else>
        <view class="voyage-skeleton title"></view>
        <view class="voyage-skeleton line"></view>
        <view class="voyage-skeleton short"></view>
      </view>
    </view>

    <view class="voyage-note is-error" wx:if="{{profileHydrated && syncMode === 'cloud-error'}}">{{texts.syncFailed}}</view>
    <view class="voyage-debug {{syncMode === 'cloud' ? 'is-cloud' : 'is-local'}}" wx:if="{{showCloudDebug && syncDebug && syncDebug.show}}">
      {{syncDebug.text}}
    </view>

    <view class="voyage-profile-entries" wx:if="{{profileHydrated}}">
      <view class="voyage-profile-entry report-entry" bindtap="openParentPage">
        <view class="voyage-entry-mark report-mark"><view></view></view>
        <view class="voyage-entry-main">
          <view class="voyage-entry-title">{{texts.dailyReport}}</view>
          <view class="voyage-entry-copy">{{texts.dailyReportDescription}}</view>
        </view>
        <view class="voyage-entry-arrow">›</view>
      </view>
      <view class="voyage-profile-entry settings-entry" bindtap="openSettingsPage">
        <view class="voyage-entry-mark settings-mark"><view></view></view>
        <view class="voyage-entry-main">
          <view class="voyage-entry-title">{{texts.settings}}</view>
          <view class="voyage-entry-copy">{{texts.settingsDescription}}</view>
        </view>
        <view class="voyage-entry-arrow">›</view>
      </view>
    </view>
  </view>

  <block wx:elif="{{theme === 'warm'}}">
    <view class="profile-atmosphere">
      <view class="light-ray ray-one"></view>
      <view class="light-ray ray-two"></view>
    </view>

    <view class="profile-hero product-hero">
      <view class="identity-pattern">
        <view class="identity-ring ring-one"></view>
        <view class="identity-ring ring-two"></view>
        <view class="identity-core">{{texts.studentMark}}</view>
      </view>
      <view class="profile-name" wx:if="{{profileHydrated}}">{{profileNickname}}</view>
      <view class="profile-name-skeleton" wx:else></view>
      <view class="product-copy">{{dailyEncouragement.english}}</view>
      <view class="profile-cn" wx:if="{{language !== 'en'}}">{{dailyEncouragement.chinese}}</view>
      <view class="sync-debug {{syncMode === 'cloud' ? 'is-cloud' : 'is-local'}}" wx:if="{{showCloudDebug && syncDebug && syncDebug.show}}">
        {{syncDebug.text}}
      </view>
    </view>

    <view class="profile-board" wx:if="{{profileHydrated}}">
      <view class="student-code-card glass-panel" wx:if="{{currentMember && currentMember.studyRole === 'student'}}">
        <view class="code-label">{{texts.studentId}}</view>
        <view class="code-value {{childCodeReady ? '' : 'is-pending'}}">{{childCodeText}}</view>
      </view>

      <view class="account-orbit glass-panel">
        <view class="profile-row account-card" bindtap="openParentPage">
          <view class="account-dot"></view>
          <view class="row-main">
            <view class="row-title">{{texts.dailyReport}}</view>
            <view class="row-copy">{{texts.dailyReportDescription}}</view>
          </view>
          <view class="row-arrow">›</view>
        </view>
        <view class="profile-row account-card is-featured" bindtap="openSettingsPage">
          <view class="account-dot"></view>
          <view class="row-main">
            <view class="row-title">{{texts.settings}}</view>
            <view class="row-copy">{{texts.settingsDescription}}</view>
          </view>
          <view class="row-arrow">›</view>
        </view>
      </view>

    </view>
    <view class="profile-board profile-board-skeleton" wx:else>
      <view class="profile-skeleton-card is-primary"></view>
      <view class="profile-skeleton-card"></view>
      <view class="profile-skeleton-card is-short"></view>
    </view>
  </block>

</view>
