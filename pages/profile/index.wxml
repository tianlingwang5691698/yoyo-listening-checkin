<view class="theme-{{theme}} page-shell profile-page">
  <view class="profile-atmosphere">
    <view class="light-ray ray-one"></view>
    <view class="light-ray ray-two"></view>
  </view>

  <view class="profile-hero product-hero">
    <view class="identity-pattern">
      <view class="identity-ring ring-one"></view>
      <view class="identity-ring ring-two"></view>
      <view class="identity-core">学</view>
    </view>
    <view class="profile-name">{{profileHydrated ? (child.nickname || '同学') : ''}}</view>
    <view class="product-copy">{{dailyEncouragement.english}}</view>
    <view class="profile-cn">{{dailyEncouragement.chinese}}</view>
    <view class="sync-debug {{syncMode === 'cloud' ? 'is-cloud' : 'is-local'}}" wx:if="{{showCloudDebug && syncDebug && syncDebug.show}}">
      {{syncDebug.text}}
    </view>
  </view>

  <view class="profile-board" wx:if="{{profileHydrated}}">
    <view class="identity-card glass-panel">
      <view class="name-emblem">
        <view class="emblem-page"></view>
        <view class="emblem-line line-one"></view>
        <view class="emblem-line line-two"></view>
        <view class="emblem-dot"></view>
      </view>
      <view class="row-main">
        <view class="row-title">昵称{{nicknameRequired ? '（必填）' : ''}}</view>
        <input class="row-field profile-input" placeholder="孩子昵称" value="{{childNicknameInput}}" bindinput="handleChildNicknameInput" />
        <view class="row-copy is-required" wx:if="{{nicknameRequired}}">请更换其他名字后继续使用。</view>
      </view>
      <button class="row-action primary-action" bindtap="saveChildProfile">保存</button>
    </view>

    <view class="student-code-card glass-panel" wx:if="{{currentMember && currentMember.studyRole === 'student'}}">
      <view class="code-label">学号</view>
      <view class="code-value {{childCodeReady ? '' : 'is-pending'}}">{{childCodeText}}</view>
    </view>

    <view class="account-orbit glass-panel">
      <view class="profile-row account-card" bindtap="openParentPage">
        <view class="account-dot"></view>
        <view class="row-main">
          <view class="row-title">日报</view>
          <view class="row-copy">查看打卡</view>
        </view>
        <view class="row-arrow">›</view>
      </view>
      <view class="profile-row account-card is-featured" bindtap="openFamilyPage">
        <view class="account-dot"></view>
        <view class="row-main">
          <view class="row-title">家庭与账号</view>
          <view class="row-copy">{{currentMember.studyRole === 'student' ? '学生' : '家长'}} · {{syncMode === 'cloud' ? '已接通' : '待同步'}}</view>
        </view>
        <view class="row-arrow">›</view>
      </view>
      <view class="profile-row account-card" wx:if="{{adminVisible || (currentMember && currentMember.studyRole === 'parent')}}" bindtap="openAdminPage">
        <view class="account-dot"></view>
        <view class="row-main">
          <view class="row-title">管理</view>
          <view class="row-copy">查看学生与绑定关系</view>
        </view>
        <view class="row-arrow">›</view>
      </view>
    </view>

    <view class="profile-theme glass-panel">
      <view class="theme-head">
        <view class="row-main">
          <view class="row-title">界面风格</view>
          <view class="row-copy">{{currentThemeLabel}}</view>
        </view>
      </view>
      <view class="theme-switch">
        <view wx:for="{{themeOptions}}" wx:key="key" class="theme-chip {{theme === item.key ? 'is-active' : ''}}" data-theme="{{item.key}}" catchtap="switchTheme">{{item.label}}</view>
      </view>
    </view>
  </view>
</view>
