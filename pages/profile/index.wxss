.profile-page {
  position: relative;
  min-height: 100vh;
  padding: 76rpx 32rpx 150rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 78% 8%, rgba(255, 255, 255, 0.96) 0, rgba(255, 255, 255, 0) 30%),
    radial-gradient(circle at 18% 24%, rgba(191, 215, 232, 0.56) 0, rgba(191, 215, 232, 0) 36%),
    linear-gradient(160deg, #f8fbfd 0%, #edf6fa 45%, #f6fbfd 100%);
  color: #17314f;
}

.profile-atmosphere {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.light-ray {
  position: absolute;
  top: -46rpx;
  width: 30rpx;
  height: 470rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  filter: blur(2rpx);
  transform: rotate(24deg);
}

.ray-one {
  right: 176rpx;
}

.ray-two {
  right: 70rpx;
  height: 380rpx;
  opacity: 0.68;
}

.profile-hero {
  position: relative;
  z-index: 1;
  min-height: 520rpx;
  padding: 58rpx 42rpx 44rpx;
  border-radius: 60rpx;
  overflow: hidden;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.82), rgba(219, 233, 242, 0.46) 56%, rgba(255, 255, 255, 0.72)),
    rgba(231, 241, 248, 0.66);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.98),
    0 26rpx 70rpx rgba(78, 112, 139, 0.17);
  backdrop-filter: blur(18rpx);
}

.profile-hero::before {
  content: "";
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 22rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0));
}

.identity-pattern {
  position: relative;
  width: 214rpx;
  height: 214rpx;
  margin: 8rpx auto 34rpx;
}

.identity-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(141, 183, 212, 0.42);
}

.ring-two {
  inset: 34rpx;
  border-color: rgba(134, 170, 161, 0.34);
}

.identity-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 116rpx;
  height: 116rpx;
  margin: -58rpx 0 0 -58rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #f2a18e 0%, #df7f68 100%);
  color: #fffafa;
  font-size: 46rpx;
  line-height: 116rpx;
  text-align: center;
  font-weight: 600;
  box-shadow: 0 18rpx 34rpx rgba(214, 119, 98, 0.24);
}

.profile-name {
  color: #17314f;
  font-family: "PingFang SC", "Songti SC", serif;
  font-size: 50rpx;
  line-height: 1.14;
  font-weight: 500;
  text-align: center;
}

.profile-name-skeleton {
  width: 220rpx;
  height: 46rpx;
  margin-top: 12rpx;
  border-radius: var(--radius-md);
  background: var(--surface-soft);
  opacity: 0.68;
}

.profile-board-skeleton {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.profile-skeleton-card {
  height: 104rpx;
  border-radius: var(--radius-lg);
  background: var(--surface-glass);
  border: 1rpx solid var(--border-soft);
  box-shadow: var(--shadow-soft);
  opacity: 0.72;
}

.profile-skeleton-card.is-primary {
  height: 148rpx;
}

.profile-skeleton-card.is-short {
  width: 68%;
  opacity: 0.5;
}

.product-copy {
  margin-top: 26rpx;
  color: #607087;
  font-size: 28rpx;
  line-height: 1.45;
  text-align: center;
}

.profile-cn {
  margin-top: 12rpx;
  color: #728196;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.profile-board {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
}

.glass-panel {
  position: relative;
  overflow: hidden;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  box-shadow: 0 18rpx 48rpx rgba(78, 112, 139, 0.12);
  backdrop-filter: blur(16rpx);
}

.identity-card {
  min-height: 154rpx;
  padding: 30rpx 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.name-emblem {
  flex-shrink: 0;
  position: relative;
  width: 70rpx;
  height: 86rpx;
  margin-top: 4rpx;
}

.emblem-page {
  position: absolute;
  left: 6rpx;
  top: 4rpx;
  width: 52rpx;
  height: 66rpx;
  border-radius: 18rpx;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.82), rgba(191, 215, 232, 0.28)),
    rgba(237, 246, 250, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96),
    0 12rpx 22rpx rgba(78, 112, 139, 0.1);
}

.emblem-page::after {
  content: "";
  position: absolute;
  right: 0;
  top: 0;
  width: 18rpx;
  height: 18rpx;
  border-radius: 0 18rpx 0 18rpx;
  background: rgba(141, 183, 212, 0.2);
}

.emblem-line {
  position: absolute;
  left: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(96, 112, 135, 0.32);
}

.line-one {
  top: 30rpx;
  width: 34rpx;
}

.line-two {
  top: 44rpx;
  width: 24rpx;
}

.emblem-dot {
  position: absolute;
  right: 6rpx;
  bottom: 8rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #bfd7e8, #86aaa1);
  box-shadow: 0 8rpx 18rpx rgba(78, 112, 139, 0.12);
}

.student-code-card {
  margin-top: 18rpx;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.code-label {
  color: #607087;
  font-size: 24rpx;
}

.code-value {
  max-width: 380rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.18);
  color: #17314f;
  font-size: 28rpx;
  font-weight: 600;
}

.code-value.is-pending {
  color: #728196;
}

.account-orbit {
  margin-top: 18rpx;
  padding: 16rpx 24rpx 24rpx;
}

.section-title {
  color: #17314f;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 600;
}

.profile-row {
  min-height: 124rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.account-card {
  margin-top: 14rpx;
  padding: 22rpx 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.52);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
}

.account-card.is-featured {
  background: rgba(191, 215, 232, 0.28);
}

.account-dot {
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #86aaa1;
  box-shadow: 0 0 0 10rpx rgba(134, 170, 161, 0.14);
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  color: #17314f;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 600;
}

.row-copy {
  margin-top: 9rpx;
  color: #728196;
  font-size: 24rpx;
  line-height: 1.35;
}

.row-copy.is-required {
  color: #df7f68;
}

.profile-input {
  width: 100%;
  min-height: 62rpx;
  margin-top: 10rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.62);
  color: #17314f;
  font-size: 28rpx;
}

.row-action {
  width: 112rpx;
  height: 62rpx;
  min-width: 112rpx;
  min-height: 62rpx;
  margin: 34rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.2);
  color: #17314f;
  font-size: 24rpx;
  line-height: 62rpx;
  font-weight: 600;
}

.primary-action {
  background: linear-gradient(135deg, #f2a18e 0%, #df7f68 100%);
  color: #fffafa;
  box-shadow: 0 14rpx 28rpx rgba(214, 119, 98, 0.22);
}

.row-arrow {
  flex-shrink: 0;
  color: #8db7d4;
  font-size: 36rpx;
  line-height: 1;
}

.sync-debug {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  line-height: 1.5;
  background: rgba(255, 255, 255, 0.58);
  color: #728196;
}

.sync-debug.is-cloud {
  background: rgba(134, 170, 161, 0.16);
  color: #486d64;
}

.sync-debug.is-local {
  background: rgba(242, 161, 142, 0.18);
  color: #df7f68;
}

.theme-library.profile-page {
  padding: 56rpx 28rpx 150rpx;
  overflow: visible;
  background:
    linear-gradient(180deg, rgba(43, 33, 27, 0.86) 0, rgba(43, 33, 27, 0.86) 176rpx, transparent 176rpx),
    linear-gradient(135deg, #faf5ea 0%, #f3e8d4 100%);
  color: #14283a;
}

.library-profile {
  position: relative;
  z-index: 1;
}

.library-bookplate,
.library-signature,
.library-appearance,
.library-entry {
  border-radius: 8px;
  border: 1rpx solid rgba(184, 149, 98, 0.42);
  box-shadow: 0 6rpx 18rpx rgba(43, 33, 27, 0.12);
  box-sizing: border-box;
}

.library-bookplate {
  min-height: 360rpx;
  padding: 34rpx 30rpx;
  display: grid;
  grid-template-columns: 152rpx 1fr;
  gap: 26rpx;
  background:
    linear-gradient(90deg, rgba(184, 149, 98, 0.1) 0 2rpx, transparent 2rpx),
    #f3e8d4;
}

.bookplate-stamp {
  min-height: 238rpx;
  padding: 20rpx 14rpx;
  border: 2rpx solid #b89562;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  text-align: center;
  color: #2b211b;
}

.stamp-label,
.library-kicker,
.bookplate-kicker {
  color: #6f675f;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
}

.stamp-book-icon {
  position: relative;
  width: 76rpx;
  height: 54rpx;
  color: #8f6b3c;
}

.stamp-book-icon::before,
.stamp-book-icon::after {
  content: "";
  position: absolute;
  top: 4rpx;
  width: 36rpx;
  height: 44rpx;
  border: 3rpx solid currentColor;
  background: rgba(250, 245, 234, 0.42);
}

.stamp-book-icon::before {
  left: 0;
  border-radius: 8rpx 0 2rpx 5rpx;
}

.stamp-book-icon::after {
  right: 0;
  border-radius: 0 8rpx 5rpx 2rpx;
}

.stamp-book-icon view {
  position: absolute;
  z-index: 1;
  top: 5rpx;
  bottom: 3rpx;
  left: 50%;
  width: 3rpx;
  margin-left: -1rpx;
  background: currentColor;
}

.stamp-role {
  min-width: 82rpx;
  padding: 8rpx 12rpx;
  border-top: 1rpx solid rgba(184, 149, 98, 0.72);
  border-bottom: 1rpx solid rgba(184, 149, 98, 0.72);
  color: #2b211b;
  font-family: "Songti SC", serif;
  font-size: 27rpx;
  line-height: 1;
  letter-spacing: 4rpx;
  box-sizing: border-box;
}

.bookplate-name {
  margin-top: 14rpx;
  color: #14283a;
  font-family: "Songti SC", serif;
  font-size: 52rpx;
  line-height: 1.15;
  font-weight: 600;
}

.bookplate-code,
.bookplate-cn,
.entry-copy,
.library-note {
  margin-top: 12rpx;
  color: #6f675f;
  font-size: 24rpx;
  line-height: 1.5;
}

.bookplate-quote {
  margin-top: 30rpx;
  color: #2b211b;
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 600;
}

.library-signature,
.library-appearance {
  margin-top: 22rpx;
  padding: 26rpx;
  background: #faf5ea;
}

.library-card-head,
.library-entry,
.theme-choice-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.library-title,
.entry-title {
  color: #14283a;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 600;
}

.library-input {
  width: 100%;
  height: 74rpx;
  margin-top: 20rpx;
  padding: 0 22rpx;
  border-radius: 8px;
  background: #f3e8d4;
  color: #14283a;
  font-size: 28rpx;
  box-sizing: border-box;
}

.library-primary,
.theme-choice {
  min-width: 120rpx;
  min-height: 62rpx;
  padding: 0 22rpx;
  border-radius: 8px;
  background: #14283a;
  color: #faf5ea;
  font-size: 24rpx;
  line-height: 62rpx;
  text-align: center;
  font-weight: 600;
}

.library-primary::after {
  border: none;
}

.library-note.is-error {
  color: #9a5f55;
}

.library-debug {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 8px;
  background: rgba(243, 232, 212, 0.72);
  color: #6f675f;
  font-size: 22rpx;
  line-height: 1.5;
}

.library-entries {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.library-entry {
  min-height: 118rpx;
  padding: 24rpx;
  background: #faf5ea;
}

.entry-letter {
  background: linear-gradient(90deg, rgba(184, 149, 98, 0.16), #faf5ea 30%);
}

.entry-dossier {
  background: linear-gradient(90deg, rgba(127, 140, 120, 0.18), #faf5ea 34%);
}

.entry-ledger {
  background: linear-gradient(90deg, rgba(20, 40, 58, 0.12), #faf5ea 34%);
}

.entry-mark {
  flex-shrink: 0;
  width: 86rpx;
  color: #b89562;
  font-size: 22rpx;
  font-weight: 600;
}

.entry-main {
  flex: 1;
  min-width: 0;
}

.entry-arrow {
  flex-shrink: 0;
  color: #b89562;
  font-size: 34rpx;
  font-weight: 600;
}

.theme-choice-row {
  margin-top: 22rpx;
}

.theme-choice {
  flex: 1;
  background: #f3e8d4;
  color: #6f675f;
}

.theme-choice.is-active {
  background: #2b211b;
  color: #faf5ea;
}

.library-skeleton {
  border-radius: 8px;
  background: rgba(184, 149, 98, 0.18);
}

.library-skeleton.title {
  width: 220rpx;
  height: 46rpx;
}

.library-skeleton.line {
  width: 100%;
  height: 28rpx;
  margin-top: 22rpx;
}

.library-skeleton.short {
  width: 58%;
  height: 28rpx;
  margin-top: 16rpx;
}

.library-skeleton.input {
  height: 74rpx;
  margin-top: 20rpx;
}

.profile-theme-switcher {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.5);
}

.profile-theme-label {
  color: #607087;
  font-size: 23rpx;
  line-height: 1.2;
}

.profile-theme-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.profile-theme-option {
  min-width: 0;
  min-height: 60rpx;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.14);
  color: #728196;
  font-size: 22rpx;
  line-height: 60rpx;
  text-align: center;
}

.profile-theme-option.is-active {
  background: #17314f;
  color: #fffafa;
}

.theme-voyage.profile-page {
  padding: 56rpx 28rpx 150rpx;
  overflow: visible;
  background:
    linear-gradient(180deg, rgba(43, 142, 201, 0.96) 0, rgba(74, 177, 221, 0.94) 230rpx, transparent 230rpx),
    #dff3fb;
  color: #17334b;
}

.voyage-profile {
  position: relative;
  z-index: 1;
}

.voyage-profile-hero {
  position: relative;
  min-height: 370rpx;
  padding: 34rpx 30rpx;
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 26rpx;
  overflow: hidden;
  border: 3rpx solid #b27b34;
  border-radius: 16rpx;
  background:
    linear-gradient(110deg, rgba(175, 117, 50, 0.08) 0 2rpx, transparent 2rpx 28rpx),
    #fff6df;
  box-shadow: 0 12rpx 0 rgba(105, 66, 24, 0.2);
  box-sizing: border-box;
}

.voyage-profile-hero::after {
  content: "";
  position: absolute;
  right: -68rpx;
  bottom: -96rpx;
  width: 260rpx;
  height: 260rpx;
  border: 3rpx solid rgba(31, 112, 168, 0.13);
  border-radius: 50%;
  box-shadow: inset 0 0 0 22rpx rgba(31, 112, 168, 0.05);
  pointer-events: none;
}

.voyage-profile-seal {
  position: relative;
  z-index: 1;
  min-height: 246rpx;
  padding: 20rpx 12rpx;
  border: 3rpx solid #b8873d;
  border-radius: 76rpx 76rpx 14rpx 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  background: #f3dfb6;
  color: #17334b;
  box-shadow: inset 0 0 0 6rpx rgba(255, 248, 224, 0.72);
  box-sizing: border-box;
}

.voyage-wheel {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #1f70a8;
  color: #fff6df;
  font-size: 54rpx;
  line-height: 86rpx;
  text-align: center;
  box-shadow: 0 6rpx 0 #174d72;
}

.voyage-role {
  min-width: 82rpx;
  padding: 8rpx 10rpx;
  border-top: 2rpx solid #9b692e;
  border-bottom: 2rpx solid #9b692e;
  font-family: "Songti SC", serif;
  font-size: 26rpx;
  line-height: 1;
  text-align: center;
  box-sizing: border-box;
}

.voyage-profile-main {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.voyage-kicker {
  color: #c34b36;
  font-size: 21rpx;
  line-height: 1.3;
  font-weight: 700;
}

.voyage-profile-name {
  margin-top: 14rpx;
  color: #17334b;
  font-family: "Songti SC", serif;
  font-size: 52rpx;
  line-height: 1.15;
  font-weight: 700;
}

.voyage-profile-code,
.voyage-profile-cn,
.voyage-entry-copy,
.voyage-note {
  margin-top: 12rpx;
  color: #766047;
  font-size: 24rpx;
  line-height: 1.5;
}

.voyage-profile-quote {
  margin-top: 28rpx;
  color: #17334b;
  font-size: 27rpx;
  line-height: 1.45;
  font-weight: 600;
}

.voyage-note.is-error {
  color: #a33f31;
}

.voyage-debug {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border: 2rpx solid rgba(174, 120, 51, 0.5);
  border-radius: 10rpx;
  background: #fff6df;
  color: #766047;
  font-size: 22rpx;
  line-height: 1.5;
}

.voyage-profile-entries {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.voyage-profile-entry {
  min-height: 122rpx;
  padding: 24rpx;
  border: 3rpx solid #b27b34;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff6df;
  box-shadow: 0 8rpx 0 rgba(105, 66, 24, 0.16);
  box-sizing: border-box;
}

.voyage-profile-entry.report-entry {
  border-left: 12rpx solid #1f70a8;
}

.voyage-profile-entry.settings-entry {
  border-left: 12rpx solid #c34b36;
}

.voyage-entry-mark {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  border: 2rpx solid #b8873d;
  border-radius: 50%;
  background: #f2dfb9;
  color: #1f70a8;
  font-size: 34rpx;
  line-height: 68rpx;
  text-align: center;
}

.voyage-entry-main {
  flex: 1;
  min-width: 0;
}

.voyage-entry-title {
  color: #17334b;
  font-family: "Songti SC", serif;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 700;
}

.voyage-entry-arrow {
  flex-shrink: 0;
  color: #c34b36;
  font-size: 38rpx;
  line-height: 1;
}

.voyage-skeleton {
  border-radius: 8rpx;
  background: rgba(179, 122, 51, 0.18);
}

.voyage-skeleton.title {
  width: 220rpx;
  height: 46rpx;
}

.voyage-skeleton.line {
  width: 100%;
  height: 28rpx;
  margin-top: 22rpx;
}

.voyage-skeleton.short {
  width: 58%;
  height: 28rpx;
  margin-top: 16rpx;
}
.language-en { word-break: normal; overflow-wrap: normal; }
.language-en .bookplate-name, .language-en .entry-title, .language-en .row-title { letter-spacing: 0; }

.voyage-wheel,
.voyage-entry-mark {
  position: relative;
}

.voyage-wheel view {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 42rpx;
  height: 42rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.voyage-wheel view::before,
.voyage-wheel view::after {
  content: "";
  position: absolute;
  left: 50%;
  top: -13rpx;
  width: 4rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translateX(-50%) rotate(45deg);
}

.voyage-wheel view::after {
  transform: translateX(-50%) rotate(-45deg);
}

.voyage-entry-mark.report-mark view {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  top: 20rpx;
  bottom: 18rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
}

.voyage-entry-mark.report-mark view::after {
  content: "";
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  top: 4rpx;
  height: 20rpx;
  border-bottom: 3rpx solid currentColor;
  transform: skewY(-28deg);
}

.voyage-entry-mark.settings-mark view {
  position: absolute;
  left: 19rpx;
  top: 19rpx;
  width: 26rpx;
  height: 26rpx;
  border: 5rpx dotted currentColor;
  border-radius: 50%;
}
