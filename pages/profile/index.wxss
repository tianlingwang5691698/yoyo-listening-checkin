.profile-hero {
  background: var(--surface);
}

.profile-name {
  color: var(--text-main);
  font-size: var(--font-page-title-size);
  line-height: 1.15;
  font-weight: var(--font-section-heading-weight);
  text-align: center;
}

.profile-cn {
  margin-top: 10rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.5;
  text-align: center;
}

.product-copy {
  text-align: center;
}

.profile-list {
  margin-top: 24rpx;
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.profile-row {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.profile-row:last-child {
  border-bottom: none;
}

.profile-theme {
  min-height: 112rpx;
  padding: 20rpx 0;
  border-bottom: none;
}

.profile-role {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.role-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 18rpx;
  width: 100%;
}

.role-chip {
  width: 100%;
  min-width: 0;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  line-height: 1;
  box-sizing: border-box;
}

.role-chip::after {
  border: none;
}

.role-chip.is-active {
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-weight: var(--font-title-weight);
}

.action-row {
  align-items: flex-start;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  color: var(--text-main);
  font-size: var(--font-section-title-size);
  font-weight: var(--font-title-weight);
}

.row-copy {
  margin-top: 8rpx;
  min-height: 54rpx;
  display: flex;
  align-items: center;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.row-copy.is-pending {
  color: var(--text-muted);
}

.profile-input {
  margin-top: 8rpx;
  width: 100%;
  min-height: 54rpx;
  color: var(--text-main);
  font-size: var(--font-body-size);
}

.row-action {
  width: 112rpx;
  height: 60rpx;
  min-width: 112rpx;
  min-height: 60rpx;
  margin: 43rpx 0 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--text-main);
  font-size: var(--font-caption-size);
  line-height: 60rpx;
  font-weight: var(--font-title-weight);
  display: flex;
  align-items: center;
  justify-content: center;
}

.row-action::after {
  border: none;
}

.row-arrow {
  color: var(--accent);
  font-size: var(--font-section-title-size);
  line-height: 1;
}

.theme-switch {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.theme-chip {
  min-width: 0;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 1rpx solid var(--border-soft);
  background: var(--surface-subtle);
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  font-weight: var(--font-caption-weight);
}

.theme-chip.is-active {
  border-color: var(--border-strong);
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-weight: var(--font-badge-weight);
}

.sync-debug {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  font-size: var(--font-caption-size);
  line-height: 1.5;
  background: var(--surface-glass);
  color: var(--text-muted);
}

.sync-debug.is-cloud {
  background: var(--growth-soft);
  color: var(--growth-deep);
}

.sync-debug.is-local {
  background: var(--accent-soft);
  color: var(--accent-deep);
}
