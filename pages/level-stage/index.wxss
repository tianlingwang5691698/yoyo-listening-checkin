.level-stage-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 78% 8%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0) 30%),
    linear-gradient(160deg, #f8fbfd 0%, #edf6fa 48%, #f7fbfd 100%);
}

.stage-hero {
  position: relative;
  overflow: hidden;
  margin-top: 56rpx;
  padding: 38rpx 34rpx;
  border-radius: 38rpx;
  background:
    linear-gradient(140deg, rgba(255, 255, 255, 0.86), rgba(221, 238, 248, 0.64)),
    rgba(236, 247, 251, 0.84);
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  box-shadow: 0 20rpx 52rpx rgba(78, 112, 139, 0.13);
}

.stage-orbit {
  position: absolute;
  right: 28rpx;
  top: 30rpx;
  width: 150rpx;
  height: 92rpx;
  opacity: 0.28;
}

.stage-orbit text {
  position: absolute;
  left: 50%;
  top: 50%;
  border: 2rpx solid #8db7d4;
  border-radius: 50%;
  transform: translate(-50%, -50%) rotate(-8deg);
}

.stage-orbit text:nth-child(1) {
  width: 132rpx;
  height: 48rpx;
}

.stage-orbit text:nth-child(2) {
  width: 96rpx;
  height: 34rpx;
}

.stage-orbit text:nth-child(3) {
  width: 18rpx;
  height: 18rpx;
  background: #8db7d4;
}

.stage-title {
  margin-top: 12rpx;
}

.stage-hint {
  margin-top: 12rpx;
}

.stage-total {
  margin-top: 18rpx;
  padding: 28rpx 30rpx;
  border-radius: 30rpx;
  background: rgba(246, 251, 253, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

.total-label {
  color: #607087;
}

.total-value {
  margin-top: 10rpx;
  color: #17314f;
  font-size: var(--font-brand-size);
  line-height: 1.2;
  font-weight: var(--font-title-weight);
}

.task-group-card {
  margin-top: 18rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 34rpx;
  background: rgba(246, 251, 253, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 42rpx rgba(78, 112, 139, 0.1);
}

.task-group-card.is-disabled {
  opacity: 0.48;
}

.task-group-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 30rpx 30rpx 88rpx;
}

.group-track {
  position: absolute;
  left: 30rpx;
  top: 50%;
  width: 38rpx;
  height: 38rpx;
  margin-top: -19rpx;
  border-radius: 50%;
  background: rgba(221, 238, 248, 0.72);
}

.group-track text {
  position: absolute;
  left: 50%;
  top: 50%;
  border: 2rpx solid #8db7d4;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.group-track text:nth-child(1) {
  width: 30rpx;
  height: 30rpx;
}

.group-track text:nth-child(2) {
  width: 18rpx;
  height: 18rpx;
}

.group-track text:nth-child(3) {
  width: 6rpx;
  height: 6rpx;
  background: #8db7d4;
}

.group-name {
  color: #17314f;
  font-size: var(--font-section-title-size);
  line-height: 1.3;
  font-weight: 600;
}

.group-meta {
  margin-top: 10rpx;
}

.group-side {
  flex-shrink: 0;
  text-align: right;
}

.group-minutes {
  color: #607087;
}

.group-state {
  margin-top: 8rpx;
  color: #df8068;
  font-size: var(--font-control-size);
  font-weight: 600;
}

.episode-list {
  padding: 0 30rpx 18rpx;
  border-top: 1rpx solid rgba(141, 183, 212, 0.16);
}

.episode-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(141, 183, 212, 0.16);
}

.episode-row:first-child {
  border-top: 0;
}

.episode-row.is-done {
  opacity: 0.72;
}

.episode-order {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(221, 238, 248, 0.72);
  color: #17314f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: 600;
  flex-shrink: 0;
}

.episode-main {
  flex: 1;
  min-width: 0;
}

.episode-title {
  color: #17314f;
  font-size: var(--font-body-size);
  line-height: 1.35;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.episode-meta {
  margin-top: 6rpx;
}

.episode-state {
  color: #df8068;
  font-size: var(--font-caption-size);
  font-weight: 600;
  flex-shrink: 0;
}

.empty-combo {
  margin-top: 18rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: rgba(246, 251, 253, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

.empty-title {
  color: #17314f;
  font-size: var(--font-section-title-size);
  font-weight: 600;
}

.empty-copy {
  margin-top: 10rpx;
}

.theme-library.level-stage-page {
  --audio-bg: #FAF5EA;
  --audio-wood: #2B211B;
  --audio-ink: #14283A;
  --audio-paper: #F3E8D4;
  --audio-brass: #B89562;
  --audio-moss: #7F8C78;
  --audio-muted: #6F675F;
  --audio-error: #9A5548;
  --audio-surface: #FFFCF5;
  --audio-line: rgba(184, 149, 98, 0.44);
  min-height: 100vh;
  background:
    linear-gradient(90deg, rgba(184, 149, 98, 0.08) 1rpx, transparent 1rpx) 0 0 / 40rpx 40rpx,
    linear-gradient(180deg, #FAF5EA 0%, #F3E8D4 100%);
  color: var(--audio-ink);
}

.audio-index-cover {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 54rpx;
  padding: 34rpx 28rpx;
  border-radius: 16rpx;
  background:
    repeating-linear-gradient(90deg, rgba(250, 245, 234, 0.05) 0 2rpx, transparent 2rpx 18rpx),
    #14283A;
  box-shadow: 0 8rpx 20rpx rgba(43, 33, 27, 0.16);
}

.audio-index-cover::after {
  content: "";
  position: absolute;
  right: 26rpx;
  top: 24rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
  border: 8rpx solid rgba(184, 149, 98, 0.34);
  opacity: 0.72;
}

.audio-index-kicker {
  color: rgba(243, 232, 212, 0.72);
  font-size: 24rpx;
  line-height: 1.3;
}

.audio-index-title {
  margin-top: 14rpx;
  color: #FAF5EA;
  font-family: STSong, "Songti SC", serif;
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 600;
}

.audio-index-hint {
  margin-top: 12rpx;
  color: rgba(250, 245, 234, 0.72);
  font-size: 25rpx;
  line-height: 1.45;
}

.audio-index-stamp {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  max-width: 184rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.62);
  border-radius: 10rpx;
  color: rgba(250, 245, 234, 0.72);
  font-size: 21rpx;
  line-height: 1.3;
  text-align: center;
}

.audio-index-stamp text {
  display: block;
  margin-top: 8rpx;
  color: #B89562;
  font-size: 28rpx;
  font-weight: 700;
}

.audio-index-note {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-left: 4rpx solid var(--audio-brass);
  border-radius: 0 10rpx 10rpx 0;
  background: var(--audio-surface);
  color: var(--audio-muted);
  font-size: 24rpx;
}

.audio-index-loading,
.audio-index-empty {
  margin-top: 18rpx;
  padding: 30rpx;
  border: 1rpx solid var(--audio-line);
  border-radius: 14rpx;
  background: var(--audio-paper);
  box-shadow: 0 8rpx 20rpx rgba(43, 33, 27, 0.1);
}

.audio-index-loading-title,
.audio-index-empty-title {
  color: var(--audio-ink);
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 600;
}

.audio-index-loading-line {
  height: 28rpx;
  margin-top: 22rpx;
  border-radius: 4rpx;
  background: rgba(184, 149, 98, 0.22);
}

.audio-index-loading-line.is-short {
  width: 72%;
}

.audio-index-empty-copy {
  margin-top: 10rpx;
  color: var(--audio-muted);
  font-size: 25rpx;
  line-height: 1.45;
}

.audio-index-book {
  margin-top: 18rpx;
  border-left: 8rpx solid rgba(43, 33, 27, 0.72);
}

.audio-index-group {
  overflow: hidden;
  margin-top: 14rpx;
  border: 1rpx solid var(--audio-line);
  border-radius: 0 12rpx 12rpx 0;
  background: var(--audio-surface);
  box-shadow: 0 6rpx 16rpx rgba(43, 33, 27, 0.08);
}

.audio-index-group.is-disabled {
  opacity: 0.5;
}

.audio-index-group-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 108rpx;
  padding: 22rpx 24rpx 22rpx 72rpx;
  background:
    linear-gradient(90deg, rgba(184, 149, 98, 0.14), transparent 96rpx),
    #F3E8D4;
}

.audio-index-tabmark {
  position: absolute;
  left: 24rpx;
  top: 28rpx;
  width: 24rpx;
  height: 58rpx;
  border-radius: 4rpx;
  background: var(--audio-brass);
}

.audio-index-group-main,
.audio-track-main {
  flex: 1;
  min-width: 0;
}

.audio-index-group-name {
  color: var(--audio-ink);
  font-size: 31rpx;
  line-height: 1.3;
  font-weight: 600;
}

.audio-index-group-meta,
.audio-index-minutes,
.audio-track-meta {
  margin-top: 8rpx;
  color: var(--audio-muted);
  font-size: 24rpx;
  line-height: 1.35;
}

.audio-index-side {
  flex-shrink: 0;
  text-align: right;
}

.audio-index-state,
.audio-track-state {
  margin-top: 8rpx;
  color: var(--audio-brass);
  font-size: 25rpx;
  line-height: 1.3;
  font-weight: 700;
}

.audio-track-list {
  padding: 0 24rpx 16rpx 72rpx;
  background: var(--audio-surface);
}

.audio-track-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 88rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(184, 149, 98, 0.24);
}

.audio-track-row::before {
  content: "";
  position: absolute;
  left: -42rpx;
  top: 50%;
  width: 22rpx;
  height: 2rpx;
  background: var(--audio-brass);
}

.audio-track-row.is-done {
  opacity: 0.78;
}

.audio-track-row.is-done .audio-track-state {
  color: var(--audio-moss);
}

.audio-track-order {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid var(--audio-line);
  border-radius: 6rpx;
  color: var(--audio-ink);
  font-size: 24rpx;
  line-height: 48rpx;
  font-weight: 700;
  text-align: center;
}

.audio-track-title {
  color: var(--audio-ink);
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
