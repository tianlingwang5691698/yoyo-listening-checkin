.level-stage-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 78% 8%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0) 30%),
    linear-gradient(160deg, #f8fbfd 0%, #edf6fa 48%, #f7fbfd 100%);
}

.stage-hero {
  position: relative;
  overflow: hidden;
  margin-top: 56rpx;
  padding: 38rpx 34rpx;
  border-radius: 38rpx;
  background:
    linear-gradient(140deg, rgba(255, 255, 255, 0.86), rgba(221, 238, 248, 0.64)),
    rgba(236, 247, 251, 0.84);
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  box-shadow: 0 20rpx 52rpx rgba(78, 112, 139, 0.13);
}

.stage-orbit {
  position: absolute;
  right: 28rpx;
  top: 30rpx;
  width: 150rpx;
  height: 92rpx;
  opacity: 0.28;
}

.stage-orbit text {
  position: absolute;
  left: 50%;
  top: 50%;
  border: 2rpx solid #8db7d4;
  border-radius: 50%;
  transform: translate(-50%, -50%) rotate(-8deg);
}

.stage-orbit text:nth-child(1) {
  width: 132rpx;
  height: 48rpx;
}

.stage-orbit text:nth-child(2) {
  width: 96rpx;
  height: 34rpx;
}

.stage-orbit text:nth-child(3) {
  width: 18rpx;
  height: 18rpx;
  background: #8db7d4;
}

.stage-title {
  margin-top: 12rpx;
}

.stage-hint {
  margin-top: 12rpx;
}

.stage-total {
  margin-top: 18rpx;
  padding: 28rpx 30rpx;
  border-radius: 30rpx;
  background: rgba(246, 251, 253, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

.total-label {
  color: #607087;
}

.total-value {
  margin-top: 10rpx;
  color: #17314f;
  font-size: var(--font-brand-size);
  line-height: 1.2;
  font-weight: var(--font-title-weight);
}

.task-group-card {
  margin-top: 18rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 34rpx;
  background: rgba(246, 251, 253, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 42rpx rgba(78, 112, 139, 0.1);
}

.task-group-card.is-disabled {
  opacity: 0.48;
}

.task-group-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 30rpx 30rpx 88rpx;
}

.group-track {
  position: absolute;
  left: 30rpx;
  top: 50%;
  width: 38rpx;
  height: 38rpx;
  margin-top: -19rpx;
  border-radius: 50%;
  background: rgba(221, 238, 248, 0.72);
}

.group-track text {
  position: absolute;
  left: 50%;
  top: 50%;
  border: 2rpx solid #8db7d4;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.group-track text:nth-child(1) {
  width: 30rpx;
  height: 30rpx;
}

.group-track text:nth-child(2) {
  width: 18rpx;
  height: 18rpx;
}

.group-track text:nth-child(3) {
  width: 6rpx;
  height: 6rpx;
  background: #8db7d4;
}

.group-name {
  color: #17314f;
  font-size: var(--font-section-title-size);
  line-height: 1.3;
  font-weight: 600;
}

.group-meta {
  margin-top: 10rpx;
}

.group-side {
  flex-shrink: 0;
  text-align: right;
}

.group-minutes {
  color: #607087;
}

.group-state {
  margin-top: 8rpx;
  color: #df8068;
  font-size: var(--font-control-size);
  font-weight: 600;
}

.episode-list {
  padding: 0 30rpx 18rpx;
  border-top: 1rpx solid rgba(141, 183, 212, 0.16);
}

.episode-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(141, 183, 212, 0.16);
}

.episode-row:first-child {
  border-top: 0;
}

.episode-row.is-done {
  opacity: 0.72;
}

.episode-order {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(221, 238, 248, 0.72);
  color: #17314f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: 600;
  flex-shrink: 0;
}

.episode-main {
  flex: 1;
  min-width: 0;
}

.episode-title {
  color: #17314f;
  font-size: var(--font-body-size);
  line-height: 1.35;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.episode-meta {
  margin-top: 6rpx;
}

.episode-state {
  color: #df8068;
  font-size: var(--font-caption-size);
  font-weight: 600;
  flex-shrink: 0;
}

.empty-combo {
  margin-top: 18rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: rgba(246, 251, 253, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

.empty-title {
  color: #17314f;
  font-size: var(--font-section-title-size);
  font-weight: 600;
}

.empty-copy {
  margin-top: 10rpx;
}
