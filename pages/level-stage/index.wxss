.level-stage-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 78% 8%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0) 30%),
    linear-gradient(160deg, #f8fbfd 0%, #edf6fa 48%, #f7fbfd 100%);
}

.stage-hero {
  position: relative;
  overflow: hidden;
  margin-top: 56rpx;
  padding: 38rpx 34rpx;
  border-radius: 38rpx;
  background:
    linear-gradient(140deg, rgba(255, 255, 255, 0.86), rgba(221, 238, 248, 0.64)),
    rgba(236, 247, 251, 0.84);
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  box-shadow: 0 20rpx 52rpx rgba(78, 112, 139, 0.13);
}

.stage-orbit {
  position: absolute;
  right: 28rpx;
  top: 30rpx;
  width: 150rpx;
  height: 92rpx;
  opacity: 0.28;
}

.stage-orbit text {
  position: absolute;
  left: 50%;
  top: 50%;
  border: 2rpx solid #8db7d4;
  border-radius: 50%;
  transform: translate(-50%, -50%) rotate(-8deg);
}

.stage-orbit text:nth-child(1) {
  width: 132rpx;
  height: 48rpx;
}

.stage-orbit text:nth-child(2) {
  width: 96rpx;
  height: 34rpx;
}

.stage-orbit text:nth-child(3) {
  width: 18rpx;
  height: 18rpx;
  background: #8db7d4;
}

.stage-title {
  margin-top: 12rpx;
}

.stage-hint {
  margin-top: 12rpx;
}

.stage-total {
  margin-top: 18rpx;
  padding: 28rpx 30rpx;
  border-radius: 30rpx;
  background: rgba(246, 251, 253, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

.total-label {
  color: #607087;
}

.total-value {
  margin-top: 10rpx;
  color: #17314f;
  font-size: var(--font-brand-size);
  line-height: 1.2;
  font-weight: var(--font-title-weight);
}

.fixed-plan-outline {
  margin-top: 18rpx;
  padding: 28rpx 30rpx;
  background: rgba(246, 251, 253, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 30rpx;
}

.fixed-plan-cycle {
  padding-bottom: 24rpx;
}

.fixed-plan-cycle-label,
.fixed-plan-item-range,
.fixed-plan-item-daily {
  color: #607087;
  font-size: var(--font-caption-size);
  line-height: 1.55;
}

.fixed-plan-cycle-value {
  margin-top: 8rpx;
  color: #17314f;
  font-size: var(--font-section-title-size);
  font-weight: 600;
}

.fixed-plan-cycle-copy {
  margin-top: 10rpx;
  color: #607087;
  font-size: var(--font-body-size);
  line-height: 1.65;
}

.fixed-plan-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(141, 183, 212, 0.2);
}

.fixed-plan-item-main {
  min-width: 0;
}

.fixed-plan-item-title {
  color: #17314f;
  font-size: var(--font-control-size);
  font-weight: 600;
}

.fixed-plan-item-range,
.fixed-plan-item-daily {
  margin-top: 6rpx;
}

.fixed-plan-item-action {
  flex-shrink: 0;
  color: #df8068;
  font-size: var(--font-control-size);
  font-weight: 600;
}

.task-group-card {
  margin-top: 18rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 34rpx;
  background: rgba(246, 251, 253, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 42rpx rgba(78, 112, 139, 0.1);
}

.task-group-card.is-disabled {
  opacity: 0.48;
}

.task-group-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 30rpx 30rpx 88rpx;
}

.group-track {
  position: absolute;
  left: 30rpx;
  top: 50%;
  width: 38rpx;
  height: 38rpx;
  margin-top: -19rpx;
  border-radius: 50%;
  background: rgba(221, 238, 248, 0.72);
}

.group-track text {
  position: absolute;
  left: 50%;
  top: 50%;
  border: 2rpx solid #8db7d4;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.group-track text:nth-child(1) {
  width: 30rpx;
  height: 30rpx;
}

.group-track text:nth-child(2) {
  width: 18rpx;
  height: 18rpx;
}

.group-track text:nth-child(3) {
  width: 6rpx;
  height: 6rpx;
  background: #8db7d4;
}

.group-name {
  color: #17314f;
  font-size: var(--font-section-title-size);
  line-height: 1.3;
  font-weight: 600;
}

.group-meta {
  margin-top: 10rpx;
}

.group-side {
  flex-shrink: 0;
  text-align: right;
}

.group-minutes {
  color: #607087;
}

.group-state {
  margin-top: 8rpx;
  color: #df8068;
  font-size: var(--font-control-size);
  font-weight: 600;
}

.episode-list {
  padding: 0 30rpx 18rpx;
  border-top: 1rpx solid rgba(141, 183, 212, 0.16);
}

.episode-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(141, 183, 212, 0.16);
}

.episode-row:first-child {
  border-top: 0;
}

.episode-row.is-done {
  opacity: 0.72;
}

.episode-order {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(221, 238, 248, 0.72);
  color: #17314f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: 600;
  flex-shrink: 0;
}

.episode-main {
  flex: 1;
  min-width: 0;
}

.episode-title {
  color: #17314f;
  font-size: var(--font-body-size);
  line-height: 1.35;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.episode-meta {
  margin-top: 6rpx;
}

.episode-state {
  color: #df8068;
  font-size: var(--font-caption-size);
  font-weight: 600;
  flex-shrink: 0;
}

.empty-combo {
  margin-top: 18rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: rgba(246, 251, 253, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

.empty-title {
  color: #17314f;
  font-size: var(--font-section-title-size);
  font-weight: 600;
}

.empty-copy {
  margin-top: 10rpx;
}

.theme-library.level-stage-page {
  --audio-bg: #FAF5EA;
  --audio-wood: #2B211B;
  --audio-ink: #14283A;
  --audio-paper: #F3E8D4;
  --audio-brass: #B89562;
  --audio-moss: #7F8C78;
  --audio-muted: #6F675F;
  --audio-error: #9A5548;
  --audio-surface: #FFFCF5;
  --audio-line: rgba(184, 149, 98, 0.44);
  min-height: 100vh;
  background:
    linear-gradient(90deg, rgba(184, 149, 98, 0.08) 1rpx, transparent 1rpx) 0 0 / 40rpx 40rpx,
    linear-gradient(180deg, #FAF5EA 0%, #F3E8D4 100%);
  color: var(--audio-ink);
}

.audio-index-cover {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 54rpx;
  padding: 34rpx 28rpx;
  border-radius: 16rpx;
  background:
    linear-gradient(112deg, rgba(255, 255, 255, 0.05), transparent 42%),
    repeating-linear-gradient(90deg, rgba(241, 207, 149, 0.045) 0 2rpx, transparent 2rpx 24rpx),
    linear-gradient(135deg, #3a291f 0%, #241913 58%, #160f0c 100%);
  border: 1rpx solid rgba(184, 149, 98, 0.5);
  box-shadow: inset 0 0 0 5rpx rgba(12, 8, 6, 0.16), 0 10rpx 24rpx rgba(43, 33, 27, 0.22);
}

.audio-index-cover > view {
  position: relative;
  z-index: 1;
}

.audio-index-cover::before {
  content: "";
  position: absolute;
  top: 24rpx;
  bottom: 24rpx;
  left: 18rpx;
  width: 5rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #d2ad70, #80613c);
  box-shadow: 8rpx 0 18rpx rgba(184, 149, 98, 0.18);
}

.audio-index-cover::after {
  content: "";
  position: absolute;
  right: 36rpx;
  top: 20rpx;
  width: 126rpx;
  height: 126rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(210, 173, 112, 0.46);
  background:
    radial-gradient(circle, #c39a5f 0 7rpx, #2b211b 8rpx 15rpx, transparent 16rpx),
    repeating-radial-gradient(circle, #0c0b0a 0 5rpx, #24201d 6rpx 9rpx, #0a0908 10rpx 13rpx);
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.26);
  opacity: 0.54;
}

.audio-index-kicker {
  color: rgba(243, 232, 212, 0.72);
  font-size: 24rpx;
  line-height: 1.3;
}

.audio-index-title {
  margin-top: 14rpx;
  color: #FAF5EA;
  font-family: STSong, "Songti SC", serif;
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 600;
}

.audio-index-hint {
  margin-top: 12rpx;
  color: rgba(250, 245, 234, 0.72);
  font-size: 25rpx;
  line-height: 1.45;
}

.audio-index-stamp {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  max-width: 184rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.62);
  border-radius: 10rpx;
  color: rgba(250, 245, 234, 0.72);
  font-size: 21rpx;
  line-height: 1.3;
  text-align: center;
}

.audio-index-stamp text {
  display: block;
  margin-top: 8rpx;
  color: #B89562;
  font-size: 28rpx;
  font-weight: 700;
}

.audio-index-note {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-left: 4rpx solid var(--audio-brass);
  border-radius: 0 10rpx 10rpx 0;
  background: var(--audio-surface);
  color: var(--audio-muted);
  font-size: 24rpx;
}

.audio-index-loading,
.audio-index-empty {
  margin-top: 18rpx;
  padding: 30rpx;
  border: 1rpx solid var(--audio-line);
  border-radius: 14rpx;
  background: var(--audio-paper);
  box-shadow: 0 8rpx 20rpx rgba(43, 33, 27, 0.1);
}

.audio-index-loading-title,
.audio-index-empty-title {
  color: var(--audio-ink);
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 600;
}

.audio-index-loading-line {
  height: 28rpx;
  margin-top: 22rpx;
  border-radius: 4rpx;
  background: rgba(184, 149, 98, 0.22);
}

.audio-index-loading-line.is-short {
  width: 72%;
}

.audio-index-empty-copy {
  margin-top: 10rpx;
  color: var(--audio-muted);
  font-size: 25rpx;
  line-height: 1.45;
}

.audio-index-book {
  margin-top: 18rpx;
  border-left: 8rpx solid rgba(43, 33, 27, 0.72);
}

.audio-index-group {
  overflow: hidden;
  margin-top: 14rpx;
  border: 1rpx solid var(--audio-line);
  border-radius: 0 12rpx 12rpx 0;
  background: var(--audio-surface);
  box-shadow: 0 6rpx 16rpx rgba(43, 33, 27, 0.08);
}

.audio-index-group.is-disabled {
  opacity: 0.5;
}

.audio-index-group-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 108rpx;
  padding: 22rpx 24rpx 22rpx 72rpx;
  background:
    linear-gradient(90deg, rgba(184, 149, 98, 0.14), transparent 96rpx),
    #F3E8D4;
}

.audio-index-tabmark {
  position: absolute;
  left: 24rpx;
  top: 28rpx;
  width: 24rpx;
  height: 58rpx;
  border-radius: 4rpx;
  background: var(--audio-brass);
}

.audio-index-group-main,
.audio-track-main {
  flex: 1;
  min-width: 0;
}

.audio-index-group-name {
  color: var(--audio-ink);
  font-size: 31rpx;
  line-height: 1.3;
  font-weight: 600;
}

.audio-index-group-meta,
.audio-index-minutes,
.audio-track-meta {
  margin-top: 8rpx;
  color: var(--audio-muted);
  font-size: 24rpx;
  line-height: 1.35;
}

.audio-index-side {
  flex-shrink: 0;
  text-align: right;
}

.audio-index-state,
.audio-track-state {
  margin-top: 8rpx;
  color: var(--audio-brass);
  font-size: 25rpx;
  line-height: 1.3;
  font-weight: 700;
}

.audio-track-list {
  padding: 0 24rpx 16rpx 72rpx;
  background: var(--audio-surface);
}

.audio-track-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 88rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(184, 149, 98, 0.24);
}

.audio-track-row::before {
  content: "";
  position: absolute;
  left: -42rpx;
  top: 50%;
  width: 22rpx;
  height: 2rpx;
  background: var(--audio-brass);
}

.audio-track-row.is-done {
  opacity: 0.78;
}

.audio-track-row.is-done .audio-track-state {
  color: var(--audio-moss);
}

.audio-track-order {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid var(--audio-line);
  border-radius: 6rpx;
  color: var(--audio-ink);
  font-size: 24rpx;
  line-height: 48rpx;
  font-weight: 700;
  text-align: center;
}

.audio-track-title {
  color: var(--audio-ink);
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Voyage theme: route manifest and numbered checkpoints. */
.theme-voyage.level-stage-page { min-height: 100vh; padding: 42rpx 28rpx 150rpx; background: radial-gradient(circle at 92% 5%, rgba(213,166,75,.23) 0 100rpx, transparent 102rpx), repeating-linear-gradient(11deg, rgba(93,66,35,.025) 0 2rpx, transparent 2rpx 22rpx), #f4e7c8; color: #102f43; }
.voyage-stage-manifest { position: relative; min-height: 238rpx; padding: 32rpx 176rpx 30rpx 32rpx; border: 4rpx solid #93642f; border-radius: 6rpx; background: linear-gradient(100deg,#e7c98f,#fff4d6 9%,#f7e8c4 90%,#d8b573); box-shadow: 0 14rpx 28rpx rgba(35,70,74,.18), inset 0 0 26rpx rgba(103,66,27,.1); }
.voyage-stage-manifest::before,.voyage-stage-manifest::after { content: ""; position: absolute; top: -12rpx; bottom: -12rpx; width: 24rpx; border: 4rpx solid #67401f; border-radius: 16rpx; background: repeating-linear-gradient(90deg,#895027 0 7rpx,#bd783d 8rpx 14rpx); }
.voyage-stage-manifest::before { left: -12rpx; }.voyage-stage-manifest::after { right: -12rpx; }
.voyage-stage-kicker { color: #8b5a2d; font-size: 19rpx; font-weight: 700; letter-spacing: 0; }
.voyage-stage-title { margin-top: 15rpx; font-family: "Songti SC","STSong",serif; font-size: 45rpx; line-height: 1.2; font-weight: 800; }
.voyage-stage-hint { margin-top: 14rpx; color: #6c5d49; font-size: 22rpx; line-height: 1.5; }
.voyage-stage-seal { position: absolute; top: 38rpx; right: 36rpx; width: 120rpx; height: 120rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 7rpx double #b17a32; border-radius: 50%; background: #fff0c8; color: #6c5d49; text-align: center; transform: rotate(6deg); }
.voyage-stage-seal text { font-size: 17rpx; }.voyage-stage-seal view { margin-top: 6rpx; color: #bf4938; font-size: 23rpx; font-weight: 800; }
.voyage-stage-note { margin: 20rpx 8rpx 0; padding: 15rpx 18rpx; border-left: 6rpx solid #bf4938; background: rgba(191,73,56,.08); color: #8a342b; font-size: 21rpx; }
.voyage-fixed-manifest,.voyage-route-groups { position: relative; margin-top: 26rpx; }
.voyage-fixed-manifest::before,.voyage-route-groups::before { content: ""; position: absolute; top: 86rpx; bottom: 46rpx; left: 48rpx; border-left: 4rpx dashed rgba(23,106,153,.36); }
.voyage-cycle-plaque { position: relative; z-index: 1; margin-bottom: 18rpx; padding: 24rpx 28rpx; border: 3rpx solid #93642f; border-radius: 6rpx; background: #fff4d6; color: #6c5d49; font-size: 21rpx; line-height: 1.5; }
.voyage-cycle-plaque text { display: block; margin: 6rpx 0; color: #102f43; font-size: 30rpx; font-weight: 800; }
.voyage-fixed-item,.voyage-route-group { position: relative; z-index: 1; margin-bottom: 18rpx; border: 3rpx solid #9d713d; border-radius: 6rpx; background: #fff4d6; box-shadow: 0 9rpx 18rpx rgba(48,70,67,.12); }
.voyage-fixed-item { min-height: 118rpx; display: grid; grid-template-columns: 58rpx minmax(0,1fr) auto; align-items: center; gap: 16rpx; padding: 20rpx 22rpx; }
.voyage-checkpoint,.voyage-port-number { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border: 4rpx solid #176a99; border-radius: 50%; box-sizing: border-box; background: #fff4d6; color: #176a99; font-size: 20rpx; font-weight: 800; }
.voyage-fixed-item-main,.voyage-route-group-main,.voyage-checkpoint-main { min-width: 0; }
.voyage-fixed-item-title { font-family: "Songti SC","STSong",serif; font-size: 27rpx; font-weight: 700; }
.voyage-fixed-item-meta { margin-top: 6rpx; color: #6c5d49; font-size: 20rpx; line-height: 1.4; }
.voyage-fixed-item-action { color: #176a99; font-size: 21rpx; font-weight: 700; }
.voyage-route-group-head { min-height: 126rpx; display: grid; grid-template-columns: 58rpx minmax(0,1fr) auto; align-items: center; gap: 16rpx; padding: 22rpx; }
.voyage-route-group-name { font-family: "Songti SC","STSong",serif; font-size: 29rpx; line-height: 1.3; font-weight: 800; }
.voyage-route-group-meta { margin-top: 7rpx; color: #6c5d49; font-size: 20rpx; line-height: 1.45; word-break: normal; overflow-wrap: normal; }
.voyage-route-group-side { max-width: 145rpx; color: #176a99; font-size: 20rpx; line-height: 1.4; text-align: right; }.voyage-route-group-side text { color: #6c5d49; }
.voyage-checkpoint-list { padding: 0 20rpx 12rpx 78rpx; border-top: 2rpx dashed rgba(140,97,48,.25); }
.voyage-checkpoint-row { min-height: 104rpx; display: grid; grid-template-columns: 54rpx minmax(0,1fr) auto; align-items: center; gap: 14rpx; border-bottom: 2rpx solid rgba(140,97,48,.14); }
.voyage-checkpoint-row:last-child { border-bottom: 0; }
.voyage-checkpoint-order { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border: 3rpx solid #c49338; border-radius: 50%; box-sizing: border-box; color: #8b5a2d; font-size: 18rpx; }
.voyage-checkpoint-main view { font-size: 25rpx; line-height: 1.35; font-weight: 700; word-break: normal; overflow-wrap: normal; }.voyage-checkpoint-main text { display: block; margin-top: 5rpx; color: #6c5d49; font-size: 19rpx; line-height: 1.4; }
.voyage-checkpoint-state { max-width: 135rpx; color: #176a99; font-size: 19rpx; text-align: right; }.voyage-checkpoint-row.is-done .voyage-checkpoint-order { border-color: #318d7b; background: #318d7b; color: #fff4d6; }.voyage-checkpoint-row.is-done .voyage-checkpoint-state { color: #318d7b; }
.voyage-route-group.is-disabled { opacity: .42; }
.voyage-stage-loading,.voyage-stage-empty { margin-top: 28rpx; padding: 36rpx; border: 3rpx solid #9d713d; background: #fff4d6; }
.voyage-stage-loading view { height: 28rpx; margin: 14rpx 0; background: rgba(23,106,153,.09); }.voyage-stage-loading view.is-short { width: 66%; }
.voyage-stage-empty { text-align: center; }.voyage-stage-empty view { font-size: 28rpx; font-weight: 700; }.voyage-stage-empty text { display: block; margin-top: 10rpx; color: #6c5d49; font-size: 22rpx; }
.language-en .voyage-stage-title { font-size: 37rpx; }
