.stage-hero {
  margin-top: 56rpx;
  padding: 34rpx 30rpx;
  background: var(--surface-glass);
}

.stage-title {
  margin-top: 12rpx;
}

.stage-hint {
  margin-top: 12rpx;
}

.stage-total {
  margin-top: 18rpx;
  padding: 28rpx 30rpx;
  background: var(--surface-glass);
}

.total-label {
  color: var(--text-muted);
}

.total-value {
  margin-top: 10rpx;
  color: var(--text-strong);
  font-size: var(--font-brand-size);
  line-height: 1.2;
  font-weight: var(--font-title-weight);
}

.task-group-card {
  margin-top: 18rpx;
  padding: 0;
  overflow: hidden;
  background: var(--surface-glass);
}

.task-group-card.is-disabled {
  opacity: 0.48;
}

.task-group-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx;
}

.group-name {
  color: var(--text-strong);
  font-size: var(--font-section-title-size);
  line-height: 1.3;
  font-weight: var(--font-title-weight);
}

.group-meta {
  margin-top: 10rpx;
}

.group-side {
  flex-shrink: 0;
  text-align: right;
}

.group-minutes {
  color: var(--text-muted);
}

.group-state {
  margin-top: 8rpx;
  color: var(--accent-deep);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.episode-list {
  padding: 0 30rpx 18rpx;
  border-top: 1rpx solid var(--border-soft);
}

.episode-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(78, 70, 61, 0.08);
}

.episode-row:first-child {
  border-top: 0;
}

.episode-row.is-done {
  opacity: 0.72;
}

.episode-order {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
  flex-shrink: 0;
}

.episode-main {
  flex: 1;
  min-width: 0;
}

.episode-title {
  color: var(--text-strong);
  font-size: var(--font-body-size);
  line-height: 1.35;
  font-weight: var(--font-title-weight);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.episode-meta {
  margin-top: 6rpx;
}

.episode-state {
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
  flex-shrink: 0;
}

.empty-combo {
  margin-top: 18rpx;
  padding: 30rpx;
  background: var(--surface-glass);
}

.empty-title {
  color: var(--text-strong);
  font-size: var(--font-section-title-size);
  font-weight: var(--font-title-weight);
}

.empty-copy {
  margin-top: 10rpx;
}
