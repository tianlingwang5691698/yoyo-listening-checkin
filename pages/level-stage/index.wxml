<view class="theme-{{theme}} page-shell level-stage-page language-{{language}}">
  <block wx:if="{{theme === 'voyage' || theme === 'dragon' || theme === 'tactical'}}">
    <view class="voyage-stage-manifest">
      <view class="voyage-stage-kicker">{{stage.levelId}} · {{stage.stageText}}</view>
      <view class="voyage-stage-title">{{stage.title}}</view>
      <view class="voyage-stage-hint">{{stage.hint}}</view>
      <view class="voyage-stage-seal" wx:if="{{!fixedPlanOutline}}"><text>{{texts.estimatedTotal}}</text><view>{{totalMinutesText}}</view></view>
    </view>

    <view class="voyage-stage-note" wx:if="{{syncMode === 'cloud-error' && hasTaskGroups}}">{{texts.usingRecent}}</view>

    <view class="voyage-fixed-manifest" wx:if="{{fixedPlanOutline}}">
      <view class="voyage-cycle-plaque">
        <view>{{texts.planCycle}}</view><text>{{fixedPlanOutline.cycleDays}} {{texts.checkinDayUnit}}</text><view>{{texts.fixedPlanRule}}</view>
      </view>
      <view class="voyage-fixed-item" wx:for="{{fixedPlanOutline.items}}" wx:key="category" data-category="{{item.category}}" bindtap="openFixedPlanItem">
        <view class="voyage-checkpoint"><text>{{index + 1}}</text></view>
        <view class="voyage-fixed-item-main">
          <view class="voyage-fixed-item-title">{{item.title}}</view>
          <view class="voyage-fixed-item-meta">{{item.rangeText}} · {{item.dailyText}}</view>
          <view class="voyage-fixed-item-meta" wx:if="{{item.progressText}}">{{item.progressText}}</view>
        </view>
        <view class="voyage-fixed-item-action">{{texts.viewContent}}</view>
      </view>
    </view>

    <view class="voyage-stage-loading" wx:elif="{{!hydrated && !hasTaskGroups}}"><view></view><view></view><view class="is-short"></view></view>

    <view class="voyage-route-groups" wx:elif="{{hasTaskGroups}}">
      <block wx:for="{{taskGroups}}" wx:for-index="groupIndex" wx:key="groupKey">
        <view class="voyage-route-group {{item.disabled ? 'is-disabled' : ''}}">
          <view class="voyage-route-group-head" data-group-index="{{groupIndex}}" bindtap="toggleTaskGroup">
            <view class="voyage-port-number">{{groupIndex + 1}}</view>
            <view class="voyage-route-group-main">
              <view class="voyage-route-group-name">{{item.categoryLabel}}</view>
              <view class="voyage-route-group-meta">{{item.taskCountText}} · {{item.title}} · {{item.textType}}</view>
            </view>
            <view class="voyage-route-group-side"><text>{{item.minutesText}}</text><view>{{item.expanded ? texts.collapse : item.stateText}}</view></view>
          </view>
          <view class="voyage-checkpoint-list" wx:if="{{item.expanded}}">
            <block wx:for="{{item.tasks}}" wx:for-item="task" wx:for-index="taskIndex" wx:key="taskId">
              <view class="voyage-checkpoint-row {{task.completedToday ? 'is-done' : ''}}" data-group-index="{{groupIndex}}" data-task-index="{{taskIndex}}" catchtap="openTask">
                <view class="voyage-checkpoint-order">{{task.orderText}}</view>
                <view class="voyage-checkpoint-main"><view>{{task.title}}</view><text>{{task.meta}}</text></view>
                <view class="voyage-checkpoint-state">{{task.stateText}}</view>
              </view>
            </block>
          </view>
        </view>
      </block>
    </view>

    <view class="voyage-stage-empty" wx:else><view>{{syncMode === 'cloud-error' ? texts.syncFailed : texts.noCombo}}</view><text>{{syncMode === 'cloud-error' ? texts.retryLater : texts.moreComing}}</text></view>
  </block>

  <block wx:elif="{{theme === 'library'}}">
    <view class="audio-index-cover">
      <view>
        <view class="audio-index-kicker">{{stage.levelId}} · {{stage.stageText}}</view>
        <view class="audio-index-title">{{stage.title}}</view>
        <view class="audio-index-hint">{{stage.hint}}</view>
      </view>
      <view class="audio-index-stamp" wx:if="{{!fixedPlanOutline}}">
        <view>{{texts.estimatedTotal}}</view>
        <text>{{totalMinutesText}}</text>
      </view>
    </view>

    <view class="audio-index-note" wx:if="{{syncMode === 'cloud-error' && hasTaskGroups}}">{{texts.usingRecent}}</view>

    <view class="fixed-plan-outline" wx:if="{{fixedPlanOutline}}">
      <view class="fixed-plan-cycle">
        <view class="fixed-plan-cycle-label">{{texts.planCycle}}</view>
        <view class="fixed-plan-cycle-value">{{fixedPlanOutline.cycleDays}} {{texts.checkinDayUnit}}</view>
        <view class="fixed-plan-cycle-copy">{{texts.fixedPlanRule}}</view>
      </view>
      <view class="fixed-plan-item" wx:for="{{fixedPlanOutline.items}}" wx:key="category" data-category="{{item.category}}" bindtap="openFixedPlanItem">
        <view class="fixed-plan-item-main">
          <view class="fixed-plan-item-title">{{item.title}}</view>
          <view class="fixed-plan-item-range">{{item.rangeText}}</view>
          <view class="fixed-plan-item-daily">{{item.dailyText}}</view>
          <view class="fixed-plan-item-daily" wx:if="{{item.progressText}}">{{item.progressText}}</view>
        </view>
        <view class="fixed-plan-item-action">{{texts.viewContent}}</view>
      </view>
    </view>

    <block wx:elif="{{!hydrated && !hasTaskGroups}}">
      <view class="audio-index-loading">
        <view class="audio-index-loading-title"></view>
        <view class="audio-index-loading-line"></view>
        <view class="audio-index-loading-line is-short"></view>
        <view class="audio-index-loading-line"></view>
      </view>
    </block>

    <block wx:elif="{{hasTaskGroups}}">
      <view class="audio-index-book">
        <block wx:for="{{taskGroups}}" wx:for-index="groupIndex" wx:key="groupKey">
          <view class="audio-index-group {{item.disabled ? 'is-disabled' : ''}}">
            <view class="audio-index-group-head" data-group-index="{{groupIndex}}" bindtap="toggleTaskGroup">
              <view class="audio-index-tabmark"></view>
              <view class="audio-index-group-main">
                <view class="audio-index-group-name">{{item.categoryLabel}}</view>
                <view class="audio-index-group-meta">{{item.taskCountText}} · {{item.title}} · {{item.textType}}</view>
              </view>
              <view class="audio-index-side">
                <view class="audio-index-minutes">{{item.minutesText}}</view>
                <view class="audio-index-state">{{item.expanded ? texts.collapse : item.stateText}}</view>
              </view>
            </view>

            <view class="audio-track-list" wx:if="{{item.expanded}}">
              <block wx:for="{{item.tasks}}" wx:for-item="task" wx:for-index="taskIndex" wx:key="taskId">
                <view class="audio-track-row {{task.completedToday ? 'is-done' : ''}}" data-group-index="{{groupIndex}}" data-task-index="{{taskIndex}}" catchtap="openTask">
                  <view class="audio-track-order">{{task.orderText}}</view>
                  <view class="audio-track-main">
                    <view class="audio-track-title">{{task.title}}</view>
                    <view class="audio-track-meta">{{task.meta}}</view>
                  </view>
                  <view class="audio-track-state">{{task.stateText}}</view>
                </view>
              </block>
            </view>
          </view>
        </block>
      </view>
    </block>

    <view class="audio-index-empty" wx:else>
      <view class="audio-index-empty-title">{{syncMode === 'cloud-error' ? texts.syncFailed : texts.noCombo}}</view>
      <view class="audio-index-empty-copy">{{syncMode === 'cloud-error' ? texts.retryLater : texts.moreComing}}</view>
    </view>
  </block>

  <block wx:else>
    <view class="stage-hero card">
      <view class="stage-orbit"><text></text><text></text><text></text></view>
      <view class="type-caption">{{stage.levelId}} · {{stage.stageText}}</view>
      <view class="stage-title type-page-title">{{stage.title}}</view>
      <view class="stage-hint type-caption">{{stage.hint}}</view>
    </view>

    <view class="stage-total card" wx:if="{{!fixedPlanOutline}}">
      <view class="total-label type-caption">{{texts.estimatedTotal}}</view>
      <view class="total-value">{{totalMinutesText}}</view>
    </view>

    <view class="fixed-plan-outline card" wx:if="{{fixedPlanOutline}}">
      <view class="fixed-plan-cycle">
        <view class="fixed-plan-cycle-label type-caption">{{texts.planCycle}}</view>
        <view class="fixed-plan-cycle-value">{{fixedPlanOutline.cycleDays}} {{texts.checkinDayUnit}}</view>
        <view class="fixed-plan-cycle-copy type-caption">{{texts.fixedPlanRule}}</view>
      </view>
      <view class="fixed-plan-item" wx:for="{{fixedPlanOutline.items}}" wx:key="category" data-category="{{item.category}}" bindtap="openFixedPlanItem">
        <view class="fixed-plan-item-main">
          <view class="fixed-plan-item-title">{{item.title}}</view>
          <view class="fixed-plan-item-range type-caption">{{item.rangeText}}</view>
          <view class="fixed-plan-item-daily type-caption">{{item.dailyText}}</view>
          <view class="fixed-plan-item-daily type-caption" wx:if="{{item.progressText}}">{{item.progressText}}</view>
        </view>
        <view class="fixed-plan-item-action">{{texts.viewContent}}</view>
      </view>
    </view>

    <block wx:elif="{{hasTaskGroups}}">
      <block wx:for="{{taskGroups}}" wx:for-index="groupIndex" wx:key="groupKey">
      <view class="task-group-card card {{item.disabled ? 'is-disabled' : ''}}">
        <view class="task-group-row" data-group-index="{{groupIndex}}" bindtap="toggleTaskGroup">
          <view class="group-track"><text></text><text></text><text></text></view>
          <view>
            <view class="group-name">{{item.categoryLabel}}</view>
            <view class="group-meta type-caption">{{item.taskCountText}} · {{item.title}} · {{item.textType}}</view>
          </view>
          <view class="group-side">
            <view class="group-minutes type-caption">{{item.minutesText}}</view>
            <view class="group-state">{{item.expanded ? texts.collapse : item.stateText}}</view>
          </view>
        </view>

        <view class="episode-list" wx:if="{{item.expanded}}">
          <block wx:for="{{item.tasks}}" wx:for-item="task" wx:for-index="taskIndex" wx:key="taskId">
            <view class="episode-row {{task.completedToday ? 'is-done' : ''}}" data-group-index="{{groupIndex}}" data-task-index="{{taskIndex}}" catchtap="openTask">
              <view class="episode-order">{{task.orderText}}</view>
              <view class="episode-main">
                <view class="episode-title">{{task.title}}</view>
                <view class="episode-meta type-caption">{{task.meta}}</view>
              </view>
              <view class="episode-state">{{task.stateText}}</view>
            </view>
          </block>
        </view>
      </view>
      </block>
    </block>

    <view class="empty-combo card" wx:elif="{{hydrated}}">
      <view class="empty-title">{{texts.noCombo}}</view>
      <view class="empty-copy type-caption">{{texts.moreComing}}</view>
    </view>
  </block>
</view>
