  line-height: 1.38;
}

.writing-library-page .criterion-comment {
  color: var(--library-writing-muted);
  font-size: var(--result-body-size);
  line-height: var(--result-line-body);
}

.writing-library-page .criterion-evidence,
.writing-library-page .criterion-descriptor,
.writing-library-page .criterion-limiters,
.writing-library-page .criterion-actions,
