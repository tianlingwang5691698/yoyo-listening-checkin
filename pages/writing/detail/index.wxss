/* 作文题纸：初中、高中和 IELTS 共用语义层级，主题只替换材质与强调色。 */
.writing-prompt-structure {
  display: block;
  width: 100%;
}

.writing-prompt-section {
  padding: 28rpx 10rpx;
  border-top: 1rpx solid rgba(141, 183, 212, 0.30);
}

.writing-prompt-section:first-child {
  border-top: 0;
}

.writing-prompt-section-title {
  margin-bottom: 14rpx;
  color: #587087;
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 750;
  letter-spacing: 0;
}

.writing-prompt-lines {
  display: grid;
  gap: 6rpx;
}

.writing-prompt-line {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  align-items: flex-start;
  min-width: 0;
}

.writing-prompt-line.has-marker {
  grid-template-columns: 42rpx minmax(0, 1fr);
  gap: 16rpx;
}

.writing-prompt-line.is-paragraph-start {
  margin-top: 20rpx;
}

.writing-prompt-marker {
  width: 42rpx;
  height: 42rpx;
  margin-top: 8rpx;
  border: 2rpx solid rgba(82, 112, 135, 0.42);
  border-radius: 50%;
  color: #35546d;
  font-size: 21rpx;
  line-height: 38rpx;
  font-weight: 800;
  text-align: center;
  box-sizing: border-box;
}

.writing-prompt-line-copy.writing-mark-line {
  min-width: 0;
  padding: 6rpx 0;
  border-radius: 6rpx;
  color: #17314f;
  font-size: 28rpx;
  line-height: 1.78;
  letter-spacing: 0;
  word-break: normal;
  overflow-wrap: break-word;
}

.writing-prompt-section.type-directions {
  margin: 8rpx 0 10rpx;
  padding: 20rpx 22rpx;
  border-top: 0;
  border-left: 6rpx solid #8db7d4;
  background: rgba(141, 183, 212, 0.10);
}

.writing-prompt-section.type-directions .writing-prompt-section-title {
  margin-bottom: 8rpx;
  color: #668095;
  font-size: 21rpx;
}

.writing-prompt-section.type-directions .writing-prompt-line-copy {
  color: #4c6378;
  font-size: 25rpx;
  line-height: 1.68;
  font-style: italic;
}

.writing-prompt-section.type-task .writing-prompt-section-title {
  color: #17314f;
  font-size: 29rpx;
  line-height: 1.35;
}

.writing-prompt-section.type-task .writing-article-title {
  margin: 26rpx 0 22rpx;
  font-size: 35rpx;
  line-height: 1.42;
  letter-spacing: 0;
}

.writing-prompt-section.type-requirements .writing-prompt-section-title {
  color: #355e56;
  font-size: 27rpx;
}

.writing-prompt-section.type-requirements .writing-prompt-marker {
  border-color: rgba(79, 126, 115, 0.50);
  background: rgba(134, 170, 161, 0.14);
  color: #355e56;
}

.writing-prompt-section.type-notice {
  margin-top: 8rpx;
  padding: 22rpx 20rpx;
  border-top-color: rgba(223, 127, 104, 0.22);
  border-left: 5rpx solid rgba(223, 127, 104, 0.72);
  background: rgba(223, 127, 104, 0.06);
}

.writing-prompt-section.type-notice .writing-prompt-section-title,
.writing-prompt-section.type-starter .writing-prompt-section-title {
