/* Four-theme grading hierarchy: identical type scale, theme-specific paper and ink. */
.writing-library-page .library-review-letter {
  padding: 32rpx 28rpx 34rpx 50rpx;
}

.writing-library-page .library-review-top {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(184, 149, 98, 0.28);
}

.writing-library-page .library-review-top .library-section-title {
  font-size: var(--result-title-size);
  line-height: 1.3;
}

.writing-library-page .library-score {
