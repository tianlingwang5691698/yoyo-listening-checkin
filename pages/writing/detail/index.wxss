@import "../../../styles/writing-report.wxss";

.writing-page {
  --writing-bg: #f6fbfd;
  --writing-bg-soft: #edf6fa;
  --writing-ink: #17314f;
  --writing-muted: #607087;
  --writing-soft: #728196;
  --writing-blue: #8db7d4;
  --writing-blue-soft: #bfd7e8;
  --writing-sage: #86aaa1;
  --writing-coral: #df7f68;
  --writing-coral-light: #f2a18e;
  --writing-paper: rgba(255, 255, 255, 0.94);
  --writing-line: rgba(141, 183, 212, 0.24);
  box-sizing: border-box;
  position: relative;
  width: 100%;
  max-width: 100vw;
  min-height: 100vh;
  overflow-x: hidden;
  padding: 30rpx var(--space-page-x) 58rpx;
  background:
    linear-gradient(150deg, rgba(191, 215, 232, 0.34) 0%, rgba(246, 251, 253, 0) 34%),
    linear-gradient(180deg, #f6fbfd 0%, #edf6fa 55%, #f8fcfd 100%);
  color: var(--writing-ink);
}

.writing-page::before {
  content: "";
  position: absolute;
  top: 138rpx;
  right: -76rpx;
  width: 280rpx;
  height: 420rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.2);
  border-left: 0;
  border-radius: 0 170rpx 170rpx 0;
  opacity: 0.54;
  pointer-events: none;
}

.writing-hero,
.prompt-card,
.editor-card,
.review-card {
  box-sizing: border-box;
  position: relative;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

.writing-hero {
  padding: 8rpx 4rpx 24rpx;
}

.eyebrow {
  color: var(--writing-soft);
  font-size: var(--font-caption-size);
  line-height: var(--line-caption);
  font-weight: 500;
}

.title {
  margin-top: 10rpx;
  color: var(--writing-ink);
  font-size: 44rpx;
  line-height: 1.24;
  font-weight: 600;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
  color: var(--writing-muted);
  font-size: var(--font-caption-size);
  line-height: var(--line-caption);
}

.meta text,
.word-pill,
.level {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(191, 215, 232, 0.34);
  color: var(--writing-ink);
  font-size: var(--font-caption-size);
  font-weight: 500;
}

.prompt-card {
  margin-bottom: 22rpx;
  padding: 28rpx 30rpx 30rpx 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  background:
    linear-gradient(90deg, rgba(242, 161, 142, 0.16) 0, rgba(242, 161, 142, 0.16) 5rpx, transparent 5rpx),
    repeating-linear-gradient(180deg, transparent 0, transparent 55rpx, rgba(191, 215, 232, 0.18) 56rpx, transparent 57rpx),
    linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(250, 253, 254, 0.88));
  box-shadow: 0 16rpx 36rpx rgba(86, 119, 143, 0.1);
}

.paper-fold {
  position: absolute;
  top: 0;
  right: 0;
  width: 74rpx;
  height: 74rpx;
  pointer-events: none;
  background:
    linear-gradient(135deg, rgba(191, 215, 232, 0) 0%, rgba(191, 215, 232, 0) 49%, rgba(191, 215, 232, 0.34) 50%, rgba(255, 255, 255, 0.88) 78%);
  border-bottom-left-radius: 18rpx;
}

.prompt-paper-head {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding-right: 88rpx;
}

.section-title {
  color: var(--writing-ink);
  font-size: var(--font-section-title-size);
  line-height: var(--line-section);
  font-weight: 600;
}

.prompt-rules {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
  color: var(--writing-soft);
  font-size: 22rpx;
  line-height: 1.35;
}

.prompt-content {
  margin-top: 18rpx;
  padding-right: 28rpx;
  color: var(--writing-ink);
  font-size: var(--font-body-size);
}

.prompt-directions,
.prompt-scenario {
  line-height: 1.76;
  white-space: pre-wrap;
  word-break: normal;
  overflow-wrap: break-word;
}

.prompt-scenario {
  margin-top: 10rpx;
}

.prompt-section,
.library-prompt-section {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(236, 245, 250, 0.72);
}

.prompt-section-title,
.library-prompt-section-title {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.prompt-notice,
.library-prompt-notice {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-left: 6rpx solid var(--writing-coral);
  border-radius: 10rpx;
  background: rgba(223, 127, 104, 0.08);
  color: var(--writing-muted);
  font-size: 25rpx;
  line-height: 1.65;
}

.requirements-title {
  margin-top: 20rpx;
  font-weight: 600;
  line-height: 1.55;
}

.requirements-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 14rpx;
  padding: 2rpx 4rpx 2rpx 8rpx;
}

.requirement-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  line-height: 1.62;
}

.requirement-dot {
  width: 13rpx;
  height: 13rpx;
  margin-top: 15rpx;
  border-radius: 50%;
  background: var(--writing-ink);
  flex: 0 0 auto;
}

.prompt-table,
.library-prompt-table {
  margin-top: 24rpx;
  border: 1rpx solid rgba(31, 68, 98, 0.18);
  border-radius: 14rpx;
  overflow: hidden;
}

.prompt-table-row,
.library-prompt-table-row {
  display: grid;
  grid-template-columns: 0.8fr 1fr 1fr;
}

.prompt-table-row + .prompt-table-row,
.library-prompt-table-row + .library-prompt-table-row {
  border-top: 1rpx solid rgba(31, 68, 98, 0.14);
}

.prompt-table-cell,
.library-prompt-table-cell {
  padding: 14rpx 10rpx;
  line-height: 1.5;
  text-align: center;
  word-break: break-word;
}

.prompt-table-cell + .prompt-table-cell,
.library-prompt-table-cell + .library-prompt-table-cell {
  border-left: 1rpx solid rgba(31, 68, 98, 0.14);
}

.prompt-table-head,
.library-prompt-table-head,
.prompt-table-label,
.library-prompt-table-label {
  font-weight: 600;
  background: rgba(236, 245, 250, 0.72);
}

.requirement-text {
  min-width: 0;
  flex: 1;
}

.prompt-images,
.library-prompt-images {
  display: flex;
  justify-content: center;
  margin-top: 28rpx;
}

.prompt-image-frame {
  position: relative;
  width: 100%;
}

.prompt-image,
.library-prompt-image {
  width: 100%;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.prompt-image {
  border: 1rpx solid rgba(46, 80, 112, 0.18);
  background: #fff;
}

.prompt-image-zoom {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 54rpx;
  height: 54rpx;
  border: 1rpx solid rgba(23, 49, 79, 0.28);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 5rpx 14rpx rgba(23, 49, 79, 0.14);
}

.prompt-image-zoom::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 12rpx;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid #17314f;
  border-radius: 50%;
}

.prompt-image-zoom::after {
  content: "";
  position: absolute;
  left: 33rpx;
  top: 32rpx;
  width: 12rpx;
  height: 4rpx;
  background: #17314f;
  transform: rotate(45deg);
  transform-origin: left center;
}

.translation-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 24rpx;
}

.translation-item {
  padding: 24rpx 22rpx;
  border: 1rpx solid rgba(108, 151, 180, 0.2);
  border-left: 6rpx solid rgba(99, 151, 183, 0.52);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
}

.translation-number {
  color: var(--writing-soft);
  font-size: 22rpx;
  font-weight: 700;
}

.translation-source {
  margin-top: 8rpx;
  color: var(--writing-ink);
  font-weight: 600;
  line-height: 1.7;
}

.translation-source text {
  color: var(--writing-accent);
}

.translation-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 124rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(108, 151, 180, 0.24);
  border-radius: 16rpx;
  background: rgba(249, 252, 254, 0.9);
  color: var(--writing-ink);
  line-height: 1.62;
}

.translation-reference {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(223, 240, 229, 0.72);
  color: var(--writing-ink);
  line-height: 1.62;
}

.translation-reference-title {
  margin-bottom: 6rpx;
  color: #4d8065;
  font-size: 22rpx;
  font-weight: 700;
}

.translation-analysis,
.library-translation-analysis {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(77, 128, 101, 0.22);
}

.translation-analysis-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.translation-verdict {
  flex: 0 0 auto;
  font-size: 22rpx;
  font-weight: 700;
}

.translation-verdict.status-correct { color: #3f7c5d; }
.translation-verdict.status-partial { color: #8a6a2f; }
.translation-verdict.status-incorrect { color: #9a554f; }

.translation-analysis-row {
  margin-top: 12rpx;
  line-height: 1.65;
}

.translation-analysis-row text {
  font-weight: 700;
}

.translation-correction {
  margin-top: 12rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid rgba(99, 151, 183, 0.42);
}

.translation-correction-reason {
  margin-top: 4rpx;
  color: var(--writing-soft);
  font-size: 24rpx;
}

.translation-analysis-summary {
  margin-top: 22rpx;
  color: var(--writing-muted);
  line-height: 1.65;
}

.translation-submit {
  margin-top: 28rpx;
}

.editor-card {
  margin-bottom: 26rpx;
  padding: 28rpx 22rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 30rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(246, 251, 253, 0.78)),
    linear-gradient(135deg, rgba(141, 183, 212, 0.24), rgba(255, 255, 255, 0.32));
  box-shadow: 0 22rpx 54rpx rgba(86, 119, 143, 0.13);
}

.editor-head,
.review-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.editor-subtitle {
  margin-top: 6rpx;
  color: var(--writing-soft);
  font-size: var(--font-caption-size);
  line-height: var(--line-caption);
}

.word-pill {
  flex-shrink: 0;
  background: rgba(134, 170, 161, 0.18);
  color: #547c73;
}

.letter-editor {
  box-sizing: border-box;
  position: relative;
  width: 100%;
  min-height: 760rpx;
  margin-top: 24rpx;
  padding: 0;
  border: 1rpx solid rgba(141, 183, 212, 0.28);
  border-radius: 22rpx;
  background:
    linear-gradient(90deg, transparent 0, transparent 62rpx, rgba(242, 161, 142, 0.2) 63rpx, rgba(242, 161, 142, 0.2) 66rpx, transparent 67rpx),
    linear-gradient(180deg, var(--writing-paper), rgba(250, 253, 254, 0.98));
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96),
    0 18rpx 40rpx rgba(86, 119, 143, 0.1);
  overflow: hidden;
}

.letter-editor-focused {
  border-color: rgba(141, 183, 212, 0.66);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96),
    0 22rpx 48rpx rgba(86, 119, 143, 0.15);
}

.paper-margin {
  position: absolute;
  z-index: 1;
  top: 0;
  left: 54rpx;
  width: 18rpx;
  height: 100%;
  border-left: 1rpx solid rgba(223, 127, 104, 0.18);
  border-right: 1rpx solid rgba(223, 127, 104, 0.11);
  pointer-events: none;
}

.paragraph-tabs {
  position: absolute;
  z-index: 1;
  top: 116rpx;
  left: 88rpx;
  right: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 112rpx;
  pointer-events: none;
}

.paragraph-tabs view {
  width: 88rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(134, 170, 161, 0.18);
}

.essay-input {
  box-sizing: border-box;
  position: relative;
  z-index: 2;
  width: 100%;
  min-height: 760rpx;
  padding: 28rpx 28rpx 34rpx 88rpx;
  background:
    repeating-linear-gradient(180deg, transparent 0, transparent 66rpx, var(--writing-line) 67rpx, transparent 68rpx);
  color: var(--writing-ink);
  font-size: 28rpx;
  line-height: 68rpx;
  caret-color: var(--writing-coral);
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--writing-coral-light), var(--writing-coral));
  color: #fffdfb;
  font-size: var(--font-control-size);
  font-weight: 600;
  box-shadow: 0 18rpx 30rpx rgba(223, 127, 104, 0.22);
}

.submit-button[disabled] {
  opacity: 0.62;
}

.error-text {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(191, 215, 232, 0.22);
  color: var(--writing-muted);
  font-size: var(--font-body-size);
  line-height: var(--line-body);
}

.review-card {
  margin-bottom: 24rpx;
  padding: 28rpx 28rpx 28rpx 44rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  background:
    linear-gradient(90deg, rgba(141, 183, 212, 0.16), rgba(141, 183, 212, 0) 28%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(246, 251, 253, 0.82));
  box-shadow: 0 18rpx 44rpx rgba(86, 119, 143, 0.11);
}

.report-ruler {
  position: absolute;
  top: 24rpx;
  bottom: 24rpx;
  left: 18rpx;
  width: 12rpx;
  border-radius: 999rpx;
  background:
    repeating-linear-gradient(180deg, rgba(141, 183, 212, 0.5) 0, rgba(141, 183, 212, 0.5) 14rpx, transparent 14rpx, transparent 34rpx),
    linear-gradient(180deg, rgba(191, 215, 232, 0.24), rgba(134, 170, 161, 0.2));
}

.score {
  margin-top: 10rpx;
  color: var(--writing-sage);
  font-family: var(--font-number-family);
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 700;
}

.level {
  flex-shrink: 0;
  background: rgba(134, 170, 161, 0.18);
  color: #547c73;
}

.review-block,
.review-list {
  margin-top: 22rpx;
  color: var(--writing-ink);
  font-size: var(--font-body-size);
  line-height: var(--line-body);
}

.review-block {
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.18);
  border-radius: 18rpx;
  background:
    linear-gradient(90deg, rgba(134, 170, 161, 0.12), rgba(255, 255, 255, 0.58) 32%),
    rgba(255, 255, 255, 0.58);
}

.review-list {
  padding: 20rpx 0 0 22rpx;
  border-top: 1rpx solid rgba(141, 183, 212, 0.18);
  border-left: 4rpx solid rgba(191, 215, 232, 0.48);
}

.list-title {
  margin-bottom: 10rpx;
  color: var(--writing-muted);
  font-size: var(--font-caption-size);
  line-height: var(--line-caption);
  font-weight: 600;
}

.correction-item {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(191, 215, 232, 0.28);
  border-radius: 18rpx;
  background:
    repeating-linear-gradient(180deg, transparent 0, transparent 48rpx, rgba(141, 183, 212, 0.12) 49rpx, transparent 50rpx),
    rgba(255, 255, 255, 0.62);
}

.original {
  color: var(--writing-muted);
}

.revised {
  margin-top: 10rpx;
  color: #547c73;
}

.reason {
  margin-top: 10rpx;
  color: var(--writing-soft);
}

.polished {
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.2);
  border-radius: 18rpx;
  background:
    repeating-linear-gradient(180deg, transparent 0, transparent 58rpx, rgba(141, 183, 212, 0.14) 59rpx, transparent 60rpx),
    rgba(255, 255, 255, 0.64);
}

.writing-estimate-label {
  margin-top: 6rpx;
  color: #5d7188;
  font-size: 21rpx;
  line-height: 1.35;
  font-weight: 600;
}

.writing-weighting-note,
.writing-rubric-version {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-left: 4rpx solid #527fa1;
  background: rgba(82, 127, 161, 0.09);
  color: #425e78;
  font-size: 22rpx;
  line-height: 1.55;
}

.writing-rubric-version {
  margin-top: 8rpx;
  border-left-color: #6d9188;
  background: rgba(109, 145, 136, 0.09);
}

.writing-feedback-notice {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border: 2rpx solid rgba(181, 137, 66, 0.34);
  border-radius: 8rpx;
  background: rgba(255, 243, 207, 0.78);
  color: #6e5224;
  font-size: 22rpx;
  line-height: 1.55;
}

.writing-test-estimate {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx 18rpx;
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid rgba(109, 145, 136, 0.38);
  border-radius: 16rpx;
  background: rgba(232, 244, 239, 0.82);
}

.writing-test-estimate-label {
  color: #355e56;
  font-size: 24rpx;
  font-weight: 800;
}

.writing-test-estimate-parts,
.writing-test-estimate-formula {
  margin-top: 5rpx;
  color: #57756e;
  font-size: 21rpx;
  line-height: 1.45;
}

.writing-test-estimate-score {
  color: #2f6f62;
  font-size: 31rpx;
  font-weight: 800;
}

.writing-test-estimate-formula {
  width: 100%;
}

.criterion-detail {
  padding-bottom: 22rpx;
}

.criterion-evidence,
.criterion-descriptor,
.criterion-limiters,
.criterion-actions,
.band-sample-notes,
.band-sample-target {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.65;
}

.criterion-evidence { background: rgba(82, 127, 161, 0.1); }
.criterion-descriptor { background: rgba(109, 145, 136, 0.1); }
.criterion-limiters { background: rgba(201, 105, 79, 0.1); color: #7d3c2d; }
.criterion-actions { background: rgba(181, 137, 66, 0.12); color: #6e5224; }
.criterion-descriptor text { font-weight: 700; }

.criterion-subtitle {
  margin-bottom: 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.band-sample-panel,
.band-sample-card {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(82, 127, 161, 0.28);
  border-radius: 18rpx;
  background: rgba(246, 251, 253, 0.82);
}

.band-sample-copy {
  color: #5d7188;
  font-size: 23rpx;
  line-height: 1.55;
}

.band-sample-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.band-sample-button {
  flex: 1;
  min-width: 0;
  min-height: 70rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 2rpx solid rgba(82, 127, 161, 0.52);
  border-radius: 14rpx;
  background: #e4f0f6;
  color: #244f70;
  font-size: 24rpx;
  line-height: 66rpx;
  font-weight: 700;
}

.band-sample-button.is-strong {
  background: #2c668e;
  color: #ffffff;
}

.band-sample-button::after { border: 0; }
.band-sample-button[disabled] { opacity: 0.58; }

.band-sample-error {
  margin-top: 12rpx;
  color: #a34732;
  font-size: 22rpx;
}

.band-sample-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.band-sample-score {
  flex-shrink: 0;
  color: #2c668e;
  font-size: 25rpx;
  font-weight: 800;
}

.band-sample-essay {
  margin-top: 14rpx;
  color: var(--writing-ink);
  font-size: var(--font-body-size);
  line-height: 1.82;
  white-space: pre-wrap;
  word-break: break-word;
}

.theme-warm.writing-page .review-card {
  padding: 32rpx 30rpx 34rpx 42rpx;
  border-color: rgba(141, 183, 212, 0.28);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.88);
