.writing-page {
  box-sizing: border-box;
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden;
  padding: 28rpx 24rpx 48rpx;
}

.prompt-card,
.editor-card,
.review-card {
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  margin-bottom: 24rpx;
  padding: 28rpx;
  overflow: hidden;
}

.eyebrow,
.meta {
  color: #d9795d;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  margin-top: 8rpx;
  color: #221f1c;
  font-size: 38rpx;
  font-weight: 800;
}

.prompt-text {
  margin-top: 22rpx;
  color: #2f3747;
  font-size: 30rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.meta {
  margin-top: 18rpx;
}

.section-title {
  color: #171f2d;
  font-size: 30rpx;
  font-weight: 800;
}

.letter-editor {
  box-sizing: border-box;
  position: relative;
  width: 100%;
  min-height: 620rpx;
  margin-top: 20rpx;
  padding: 0;
  border: 0;
  border-radius: 12rpx;
  background: #fff;
  overflow: hidden;
}

.letter-editor-focused {
  box-shadow: 0 0 0 1rpx rgba(47, 55, 71, 0.08);
}

.essay-input {
  box-sizing: border-box;
  position: relative;
  z-index: 1;
  width: 100%;
  min-height: 620rpx;
  padding: 0 0 0;
  background:
    repeating-linear-gradient(180deg, transparent 0, transparent 62rpx, #566071 63rpx, transparent 64rpx);
  color: #202938;
  font-size: 30rpx;
  line-height: 64rpx;
  caret-color: #8f5b2f;
}

.editor-footer,
.review-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
  color: #7a8798;
  font-size: 26rpx;
}

.submit-button {
  min-width: 240rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0;
  border-radius: 999rpx;
  background: #e98264;
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
}

.loading-text,
.error-text {
  margin-top: 18rpx;
  font-size: 28rpx;
}

.loading-text {
  color: #8a6a43;
}

.error-text {
  color: #c95742;
}

.writing-debug {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 250, 242, 0.92);
  color: #8f5b2f;
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.writing-debug text {
  display: block;
}

.score {
  margin-top: 8rpx;
  color: #178a53;
  font-size: 44rpx;
  font-weight: 900;
}

.level {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #e9f6ef;
  color: #178a53;
  font-size: 26rpx;
  font-weight: 800;
}

.review-block,
.review-list {
  margin-top: 22rpx;
  color: #334155;
  font-size: 29rpx;
  line-height: 1.65;
}

.review-card {
  position: relative;
}

.review-card.is-celebrating {
  animation: writingReviewLift 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.review-effect {
  position: absolute;
  top: 18rpx;
  right: 26rpx;
  width: 120rpx;
  height: 90rpx;
  pointer-events: none;
}

.review-effect-dot {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #178a53;
  animation: writingReviewDot 1.2s ease-out forwards;
}

.dot-one {
  left: 8rpx;
  bottom: 10rpx;
}

.dot-two {
  left: 52rpx;
  bottom: 18rpx;
  background: #e98264;
  animation-delay: 0.08s;
}

.dot-three {
  right: 6rpx;
  bottom: 8rpx;
  background: #c47a2c;
  animation-delay: 0.14s;
}

@keyframes writingReviewLift {
  0% {
    transform: translateY(12rpx);
  }
  100% {
    transform: translateY(0);
  }
}

@keyframes writingReviewDot {
  0% {
    opacity: 0;
    transform: translateY(0) scale(0.7);
  }
  30% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translateY(-72rpx) scale(1);
  }
}

.list-title {
  margin-bottom: 8rpx;
  color: #111827;
  font-weight: 800;
}

.correction-item {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: #f8fafc;
}

.wrong {
  color: #b94b3a;
}

.right {
  margin-top: 8rpx;
  color: #168452;
}

.reason {
  margin-top: 8rpx;
  color: #64748b;
}
