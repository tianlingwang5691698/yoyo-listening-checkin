.manual-mark-phrase { border-radius: 5rpx; background: rgba(91, 169, 233, 0.34); }
.manual-mark-sentence { background: rgba(92, 177, 119, 0.20); box-shadow: inset 4rpx 0 0 rgba(46, 129, 77, 0.48); }

