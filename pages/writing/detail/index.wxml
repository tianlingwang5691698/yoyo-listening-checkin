<view class="theme-{{theme}} page-shell writing-page">
  <view class="writing-hero">
    <view class="eyebrow">{{prompt.examType}} · {{prompt.district}}</view>
    <view class="title">{{prompt.title}}</view>
    <view class="meta">
      <text>不少于 {{prompt.minWords || 60}} 词</text>
      <text>满分 {{prompt.score || 20}} 分</text>
    </view>
  </view>

  <view class="prompt-card">
    <view class="paper-fold"></view>
    <view class="prompt-paper-head">
      <view class="section-title">题目纸</view>
      <view class="prompt-rules">
        <text>不少于 {{prompt.minWords || 60}} 词</text>
        <text>{{prompt.score || 20}} 分</text>
      </view>
    </view>
    <view class="prompt-text">{{prompt.prompt}}</view>
  </view>

  <view class="editor-card">
    <view class="editor-head">
      <view>
        <view class="section-title">写作纸</view>
        <view class="editor-subtitle">把思路分成清楚的段落写下来</view>
      </view>
      <view class="word-pill">{{wordCount}} 词</view>
    </view>
    <view class="letter-editor {{editorFocused ? 'letter-editor-focused' : ''}}">
      <view class="paper-margin"></view>
      <view class="paragraph-tabs">
        <view></view>
        <view></view>
        <view></view>
      </view>
      <textarea class="essay-input" value="{{essayText}}" maxlength="5000" cursor-spacing="180" cursor-color="#DF7F68" show-confirm-bar="{{true}}" placeholder="在这里安静写下你的作文" bindinput="onEssayInput" bindfocus="onEditorFocus" bindblur="onEditorBlur"></textarea>
    </view>
    <button class="submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitEssay">提交批改</button>
    <view class="error-text" wx:if="{{errorText}}">{{errorText}}</view>
    <view class="writing-debug" wx:if="{{writingDebugLines.length}}">
      <text selectable="{{true}}" wx:for="{{writingDebugLines}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="review-card" wx:if="{{grading}}">
    <view class="report-ruler"></view>
    <view class="section-title">正在批改</view>
    <view class="review-block">作文已保存，稍后会生成批改报告。</view>
  </view>

  <view class="review-card {{reviewCelebrating ? 'is-celebrating' : ''}}" wx:if="{{review}}">
    <view class="report-ruler"></view>
    <view class="review-effect" wx:if="{{reviewCelebrating}}">
      <view class="review-effect-dot dot-one"></view>
      <view class="review-effect-dot dot-two"></view>
      <view class="review-effect-dot dot-three"></view>
    </view>
    <view class="review-top">
      <view>
        <view class="section-title">批改报告</view>
        <view class="score">{{review.score}} / {{review.totalScore || prompt.score || 20}} 分</view>
      </view>
      <view class="level">{{review.level}}</view>
    </view>
    <view class="review-block" wx:if="{{review.summary}}">{{review.summary}}</view>
    <view class="review-list" wx:if="{{review.content}}">
      <view class="list-title">内容</view>
      <view>{{review.content}}</view>
    </view>
    <view class="review-list" wx:if="{{review.structure}}">
      <view class="list-title">结构</view>
      <view>{{review.structure}}</view>
    </view>
    <view class="review-list" wx:if="{{review.language}}">
      <view class="list-title">语言</view>
      <view>{{review.language}}</view>
    </view>
    <view class="review-list" wx:if="{{review.spelling}}">
      <view class="list-title">拼写标点</view>
      <view>{{review.spelling}}</view>
    </view>
    <view class="review-list" wx:if="{{review.problems.length}}">
      <view class="list-title">可优化处</view>
      <view wx:for="{{review.problems}}" wx:key="*this">· {{item}}</view>
    </view>
    <view class="review-list" wx:if="{{review.suggestions.length}}">
      <view class="list-title">建议</view>
      <view wx:for="{{review.suggestions}}" wx:key="*this">· {{item}}</view>
    </view>
    <view class="review-list" wx:if="{{review.grammarCorrections.length}}">
      <view class="list-title">句子打磨</view>
      <view class="correction-item" wx:for="{{review.grammarCorrections}}" wx:key="original">
        <view class="original">原句：{{item.original}}</view>
        <view class="revised">改为：{{item.corrected}}</view>
        <view class="reason">原因：{{item.reason}}</view>
      </view>
    </view>
    <view class="review-list polished" wx:if="{{review.polishedVersion}}">
      <view class="list-title">参考改写</view>
      <view>{{review.polishedVersion}}</view>
    </view>
  </view>
</view>
