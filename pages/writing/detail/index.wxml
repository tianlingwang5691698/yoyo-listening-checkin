    </view>
    <view class="prompt-content">
      <block wx:if="{{isTranslation}}">
        <view class="prompt-directions">{{prompt.directions}}</view>
        <view class="translation-list">
          <view class="translation-item" wx:for="{{translationQuestions}}" wx:key="number">
            <view class="translation-number">{{item.number}}.</view>
            <view class="translation-source">{{item.sourceText}} <text>（{{item.requiredWord}}）</text></view>
            <textarea class="translation-input" value="{{item.inputValue}}" data-index="{{index}}" maxlength="800" auto-height="{{true}}" cursor-spacing="160" placeholder="请输入英文译文" bindinput="onTranslationInput"></textarea>
            <view class="translation-reference" wx:if="{{translationSubmitted}}">
              <view class="translation-reference-title">参考译文</view>
              <view wx:for="{{item.referenceAnswers}}" wx:for-item="answer" wx:key="*this">{{answer}}</view>
              <view class="translation-analysis" wx:if="{{item.analysis}}">
                <view class="translation-analysis-head">
                  <view class="translation-reference-title">模型讲解</view>
                  <view class="translation-verdict status-{{item.analysis.status}}">{{item.analysis.verdict}}</view>
                </view>
                <view class="translation-analysis-row" wx:if="{{item.analysis.recommendedTranslation}}"><text>推荐译文：</text>{{item.analysis.recommendedTranslation}}</view>
                <view class="translation-analysis-row" wx:if="{{item.analysis.analysis}}"><text>分析：</text>{{item.analysis.analysis}}</view>
                <view class="translation-analysis-row" wx:if="{{item.analysis.keyPoints.length}}"><text>关键点：</text><view wx:for="{{item.analysis.keyPoints}}" wx:key="*this">· {{item}}</view></view>
                <view class="translation-correction" wx:for="{{item.analysis.corrections}}" wx:key="original">
                  <view>{{item.original}} → {{item.corrected}}</view>
                  <view class="translation-correction-reason">{{item.reason}}</view>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view class="translation-analysis-summary" wx:if="{{translationSubmitted && translationAnalysisSummary}}">{{translationAnalysisSummary}}</view>
        <button class="submit-button translation-submit" loading="{{translationAnalyzing}}" disabled="{{translationAnalyzing}}" bindtap="submitTranslation">{{translationAnalyzing ? '分析讲解中' : '提交翻译'}}</button>
        <view class="error-text" wx:if="{{errorText}}">{{errorText}}</view>
      </block>
      <block wx:else>
        <view class="prompt-directions" wx:if="{{promptDisplay.directions}}">{{promptDisplay.directions}}</view>
        <view class="prompt-scenario" wx:if="{{promptDisplay.scenario}}">{{promptDisplay.scenario}}</view>
        <view class="requirements-title" wx:if="{{promptDisplay.requirements.length}}">{{promptDisplay.requirementsTitle}}</view>
        <view class="requirements-list" wx:if="{{promptDisplay.requirements.length}}">
          <view class="requirement-item" wx:for="{{promptDisplay.requirements}}" wx:key="*this">
            <view class="requirement-dot"></view>
            <view class="requirement-text">{{item}}</view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="editor-card" wx:if="{{!isTranslation}}">
    <view class="editor-head">
      <view>
        <view class="section-title">{{texts.editor}}</view>
        <view class="editor-subtitle">{{texts.editorCopy}}</view>
      </view>
      <view class="word-pill">{{wordCount}}{{texts.words}}</view>
    </view>
    <view class="letter-editor {{editorFocused ? 'letter-editor-focused' : ''}}">
      <view class="paper-margin"></view>
      <view class="paragraph-tabs">
        <view></view>
        <view></view>
        <view></view>
      </view>
      <textarea class="essay-input" value="{{essayText}}" maxlength="5000" cursor-spacing="180" cursor-color="#DF7F68" show-confirm-bar="{{true}}" placeholder="{{texts.placeholder}}" bindinput="onEssayInput" bindfocus="onEditorFocus" bindblur="onEditorBlur"></textarea>
    </view>
    <button class="submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitEssay">{{texts.submit}}</button>
    <view class="error-text" wx:if="{{errorText}}">{{errorText}}</view>
  </view>

  <view class="review-card" wx:if="{{!isTranslation && grading}}">
    <view class="report-ruler"></view>
    <view class="section-title">{{texts.grading}}</view>
    <view class="review-block">{{texts.gradingCopy}}</view>
  </view>

  <view class="review-card {{reviewCelebrating ? 'is-celebrating' : ''}}" wx:if="{{!isTranslation && review}}">
    <view class="report-ruler"></view>
    <view class="review-effect" wx:if="{{reviewCelebrating}}">
      <view class="review-effect-dot dot-one"></view>
      <view class="review-effect-dot dot-two"></view>
      <view class="review-effect-dot dot-three"></view>
