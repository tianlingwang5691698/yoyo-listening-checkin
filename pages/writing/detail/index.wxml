<import src="../../../templates/writing-report.wxml"/>

<view class="theme-{{theme}} language-{{language}} page-shell writing-page writing-library-page" wx:if="{{theme === 'library'}}">
  <block wx:if="{{prompt}}">
    <view class="library-writing-file-head">
      <view class="library-file-meta">{{prompt.examType}} · {{prompt.district}}</view>
      <view class="library-file-title">{{prompt.title}}</view>
      <view class="library-file-rules">
        <text wx:if="{{isTranslation}}">{{prompt.questionCount || translationQuestions.length}}{{texts.questionUnit}}</text>
        <text wx:elif="{{prompt.maxWords}}">{{texts.maxWords}}{{prompt.maxWords}}{{texts.words}}</text>
        <text wx:elif="{{prompt.minWords}}">{{texts.minWords}}{{prompt.minWords}}{{texts.words}}</text>
        <text wx:if="{{prompt.score}}">{{texts.fullScore}}{{prompt.score}}{{texts.scoreUnit}}</text>
      </view>
    </view>

    <view class="library-prompt-sheet">
      <view class="library-paper-fold"></view>
      <view class="library-sheet-binding">
        <view></view>
        <view></view>
        <view></view>
      </view>
      <view class="library-sheet-head">
        <view class="library-section-title">{{texts.promptPaper}}</view>
        <view class="library-proof-small">{{texts.original}}</view>
      </view>
      <view class="library-prompt-content">
        <view class="writing-mark-toolbar">
          <text>{{texts.manualMarkHint}}</text>
          <text class="writing-mark-clear" wx:if="{{writingMarkCount}}" bindtap="clearWritingMarks">{{texts.clearManualMarks}}</text>
        </view>
        <block wx:if="{{isTranslation}}">
          <view class="library-prompt-directions">{{prompt.directions}}</view>
          <view class="library-translation-list">
            <view class="library-translation-item" wx:for="{{translationQuestions}}" wx:key="number">
              <view class="library-translation-number">{{item.number}}.</view>
              <view class="library-translation-source {{writingSentenceMarks[item.markScope] ? 'manual-mark-sentence' : ''}}" data-mark-scope="{{item.markScope}}" bindlongpress="handleWritingSentenceMark"><text wx:for="{{item.sourceTokens}}" wx:key="id" wx:for-item="token" class="{{writingTokenMarks[token.markKey] ? 'manual-mark-' + writingTokenMarks[token.markKey] : ''}}" data-word="{{token.word}}" data-word-index="{{token.wordIndex}}" data-mark-scope="{{item.markScope}}" catchtap="handleWritingTokenTap">{{token.text}}</text> <text>（{{item.requiredWord}}）</text></view>
              <textarea class="library-translation-input" value="{{item.inputValue}}" data-index="{{index}}" maxlength="800" auto-height="{{true}}" cursor-spacing="160" placeholder="{{texts.translationPlaceholder}}" bindinput="onTranslationInput"></textarea>
              <view class="library-translation-reference" wx:if="{{translationSubmitted}}">
                <view class="library-translation-reference-title">{{texts.referenceTranslation}}</view>
                <view wx:for="{{item.referenceAnswers}}" wx:for-item="answer" wx:key="*this">{{answer}}</view>
                <view class="library-translation-analysis" wx:if="{{item.analysis}}">
                  <view class="translation-analysis-head">
                    <view class="library-translation-reference-title">{{texts.modelExplanation}}</view>
                    <view class="translation-verdict status-{{item.analysis.status}}">{{item.analysis.verdict}}</view>
                  </view>
                  <view class="translation-analysis-row" wx:if="{{item.analysis.recommendedTranslation}}"><text>{{texts.recommendedTranslation}}</text>{{item.analysis.recommendedTranslation}}</view>
                  <view class="translation-analysis-row" wx:if="{{item.analysis.analysis}}"><text>{{texts.analysisLabel}}</text>{{item.analysis.analysis}}</view>
                  <view class="translation-analysis-row" wx:if="{{item.analysis.keyPoints.length}}"><text>{{texts.keyPoints}}</text><view wx:for="{{item.analysis.keyPoints}}" wx:key="*this">· {{item}}</view></view>
                  <view class="translation-correction" wx:for="{{item.analysis.corrections}}" wx:key="original">
                    <view>{{item.original}} → {{item.corrected}}</view>
                    <view class="translation-correction-reason">{{item.reason}}</view>
                  </view>
                </view>
              </view>
            </view>
          </view>
          <view class="translation-analysis-summary" wx:if="{{translationSubmitted && translationAnalysisSummary}}">{{translationAnalysisSummary}}</view>
          <button class="library-submit-button library-translation-submit" loading="{{translationAnalyzing}}" disabled="{{translationAnalyzing}}" bindtap="submitTranslation">{{translationAnalyzing ? texts.analyzingTranslation : texts.submitTranslation}}</button>
          <view class="library-editor-note" wx:if="{{errorText}}">{{errorText}}</view>
        </block>
        <block wx:else>
          <view class="writing-prompt-structure">
            <view class="writing-prompt-section type-{{section.type}}" wx:for="{{writingPromptSections}}" wx:key="key" wx:for-item="section">
              <view class="writing-prompt-section-title">{{section.title}}</view>
              <view class="writing-article-title" wx:if="{{section.articleTitle}}">{{section.articleTitle}}</view>
              <view class="writing-prompt-lines">
                <view class="writing-prompt-line {{line.marker ? 'has-marker' : ''}} {{line.isParagraphStart ? 'is-paragraph-start' : ''}}" wx:for="{{section.lines}}" wx:key="key" wx:for-item="line">
                  <view class="writing-prompt-marker" wx:if="{{line.marker}}">{{line.marker}}</view>
                  <view class="writing-prompt-line-copy writing-mark-line {{writingSentenceMarks[line.scope] ? 'manual-mark-sentence' : ''}}" data-mark-scope="{{line.scope}}" bindlongpress="handleWritingSentenceMark">
                    <text wx:for="{{line.tokens}}" wx:key="id" wx:for-item="token" class="{{writingTokenMarks[token.markKey] ? 'manual-mark-' + writingTokenMarks[token.markKey] : ''}}" data-word="{{token.word}}" data-word-index="{{token.wordIndex}}" data-mark-scope="{{line.scope}}" catchtap="handleWritingTokenTap">{{token.text}}</text>
                  </view>
                </view>
              </view>
              <block wx:if="{{section.type === 'task'}}">
                <view class="library-prompt-table" wx:if="{{promptDisplay.promptTable}}">
                  <view class="library-prompt-table-row library-prompt-table-head">
                    <view class="library-prompt-table-cell" wx:for="{{promptDisplay.promptTable.headers}}" wx:key="*this">{{item}}</view>
                  </view>
                  <view class="library-prompt-table-row" wx:for="{{promptDisplay.promptTable.rows}}" wx:for-item="row" wx:key="label">
                    <view class="library-prompt-table-cell library-prompt-table-label">{{row.label}}</view>
                    <view class="library-prompt-table-cell" wx:for="{{row.values}}" wx:for-item="value" wx:key="*this">{{value}}</view>
                  </view>
                </view>
                <view class="library-prompt-images" wx:if="{{promptImages.length}}">
                  <view class="prompt-image-frame" wx:for="{{promptImages}}" wx:key="cloudPath" wx:for-item="promptImage" data-src="{{promptImage.src}}" bindtap="previewPromptImage">
                    <image class="library-prompt-image" src="{{promptImage.src}}" mode="widthFix" show-menu-by-longpress="{{true}}" aria-label="{{promptImage.alt}}"></image>
                    <view class="prompt-image-zoom" aria-label="{{texts.zoomChart}}"></view>
                  </view>
                </view>
              </block>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="library-manuscript-editor" wx:if="{{!isTranslation}}">
      <view class="library-editor-head">
        <view>
          <view class="library-section-title">{{texts.editor}}</view>
          <view class="library-editor-subtitle">{{texts.editorCopy}}</view>
        </view>
        <view class="library-word-tag">{{wordCount}}{{texts.words}}</view>
      </view>
      <view class="library-letter-paper {{editorFocused ? 'is-focused' : ''}}">
        <view class="library-paper-margin"></view>
        <view class="library-paragraph-rule"></view>
        <textarea class="library-essay-input" value="{{essayText}}" disabled="{{restoringAttempt || grading || submitting}}" maxlength="5000" cursor-spacing="180" cursor-color="#B89562" show-confirm-bar="{{true}}" placeholder="{{texts.placeholder}}" bindinput="onEssayInput" bindfocus="onEditorFocus" bindblur="onEditorBlur"></textarea>
      </view>
      <button class="library-submit-button" loading="{{submitting}}" disabled="{{restoringAttempt || submitting || submitLocked}}" bindtap="submitEssay">{{grading ? texts.grading : texts.submit}}</button>
      <view class="library-editor-note" wx:if="{{errorText}}">{{errorText}}</view>
    </view>

    <view class="library-review-letter library-review-pending" wx:if="{{!isTranslation && grading}}">
      <view class="library-report-ruler"></view>
      <view class="library-section-title">{{texts.grading}}</view>
      <view class="library-review-note">{{texts.gradingCopy}}</view>
      <view class="library-proof-runner"></view>
    </view>

    <view class="library-review-letter {{reviewCelebrating ? 'is-celebrating' : ''}}" wx:if="{{!isTranslation && review}}">
      <view class="library-report-ruler"></view>
      <view class="library-review-effect" wx:if="{{reviewCelebrating}}">
        <view class="library-ink-dot dot-one"></view>
        <view class="library-ink-dot dot-two"></view>
        <view class="library-ink-dot dot-three"></view>
      </view>
      <template is="writing-report" data="{{review: review, totalScore: prompt.score, texts: texts, attemptId: currentAttemptId, pdfGenerating: pdfGenerating, showBandSampleActions: true, bandSampleGeneratingDelta: bandSampleGeneratingDelta, bandSampleError: bandSampleError, reportTitle: texts.report}}"/>
    </view>
  </block>

  <view class="library-empty-file" wx:else>
    <view class="library-section-title">{{texts.loadFailed}}</view>
    <view class="library-empty-copy">{{texts.noPrompt}}</view>
  </view>
</view>

<view class="theme-{{theme}} language-{{language}} page-shell writing-page" wx:else>
  <view class="writing-hero">
    <view class="eyebrow">{{prompt.examType}} · {{prompt.district}}</view>
    <view class="title">{{prompt.title}}</view>
    <view class="meta">
      <text wx:if="{{isTranslation}}">{{prompt.questionCount || translationQuestions.length}}{{texts.questionUnit}}</text>
      <text wx:elif="{{prompt.maxWords}}">{{texts.maxWords}}{{prompt.maxWords}}{{texts.words}}</text>
      <text wx:elif="{{prompt.minWords}}">{{texts.minWords}}{{prompt.minWords}}{{texts.words}}</text>
      <text wx:if="{{prompt.score}}">{{texts.fullScore}}{{prompt.score}}{{texts.scoreUnit}}</text>
    </view>
  </view>

  <view class="prompt-card">
    <view class="paper-fold"></view>
    <view class="prompt-paper-head">
      <view class="section-title">{{texts.promptPaper}}</view>
      <view class="prompt-rules">
        <text wx:if="{{isTranslation}}">{{prompt.questionCount || translationQuestions.length}}{{texts.questionUnit}}</text>
        <text wx:elif="{{prompt.maxWords}}">{{texts.maxWords}}{{prompt.maxWords}}{{texts.words}}</text>
        <text wx:elif="{{prompt.minWords}}">{{texts.minWords}}{{prompt.minWords}}{{texts.words}}</text>
        <text wx:if="{{prompt.score}}">{{prompt.score}}{{texts.scoreUnit}}</text>
      </view>
    </view>
    <view class="prompt-content">
      <view class="writing-mark-toolbar">
        <text>{{texts.manualMarkHint}}</text>
        <text class="writing-mark-clear" wx:if="{{writingMarkCount}}" bindtap="clearWritingMarks">{{texts.clearManualMarks}}</text>
      </view>
      <block wx:if="{{isTranslation}}">
        <view class="prompt-directions">{{prompt.directions}}</view>
        <view class="translation-list">
          <view class="translation-item" wx:for="{{translationQuestions}}" wx:key="number">
            <view class="translation-number">{{item.number}}.</view>
            <view class="translation-source {{writingSentenceMarks[item.markScope] ? 'manual-mark-sentence' : ''}}" data-mark-scope="{{item.markScope}}" bindlongpress="handleWritingSentenceMark"><text wx:for="{{item.sourceTokens}}" wx:key="id" wx:for-item="token" class="{{writingTokenMarks[token.markKey] ? 'manual-mark-' + writingTokenMarks[token.markKey] : ''}}" data-word="{{token.word}}" data-word-index="{{token.wordIndex}}" data-mark-scope="{{item.markScope}}" catchtap="handleWritingTokenTap">{{token.text}}</text> <text>（{{item.requiredWord}}）</text></view>
            <textarea class="translation-input" value="{{item.inputValue}}" data-index="{{index}}" maxlength="800" auto-height="{{true}}" cursor-spacing="160" placeholder="{{texts.translationPlaceholder}}" bindinput="onTranslationInput"></textarea>
            <view class="translation-reference" wx:if="{{translationSubmitted}}">
              <view class="translation-reference-title">{{texts.referenceTranslation}}</view>
              <view wx:for="{{item.referenceAnswers}}" wx:for-item="answer" wx:key="*this">{{answer}}</view>
              <view class="translation-analysis" wx:if="{{item.analysis}}">
                <view class="translation-analysis-head">
                  <view class="translation-reference-title">{{texts.modelExplanation}}</view>
                  <view class="translation-verdict status-{{item.analysis.status}}">{{item.analysis.verdict}}</view>
                </view>
                <view class="translation-analysis-row" wx:if="{{item.analysis.recommendedTranslation}}"><text>{{texts.recommendedTranslation}}</text>{{item.analysis.recommendedTranslation}}</view>
                <view class="translation-analysis-row" wx:if="{{item.analysis.analysis}}"><text>{{texts.analysisLabel}}</text>{{item.analysis.analysis}}</view>
                <view class="translation-analysis-row" wx:if="{{item.analysis.keyPoints.length}}"><text>{{texts.keyPoints}}</text><view wx:for="{{item.analysis.keyPoints}}" wx:key="*this">· {{item}}</view></view>
                <view class="translation-correction" wx:for="{{item.analysis.corrections}}" wx:key="original">
                  <view>{{item.original}} → {{item.corrected}}</view>
                  <view class="translation-correction-reason">{{item.reason}}</view>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view class="translation-analysis-summary" wx:if="{{translationSubmitted && translationAnalysisSummary}}">{{translationAnalysisSummary}}</view>
        <button class="submit-button translation-submit" loading="{{translationAnalyzing}}" disabled="{{translationAnalyzing}}" bindtap="submitTranslation">{{translationAnalyzing ? texts.analyzingTranslation : texts.submitTranslation}}</button>
        <view class="error-text" wx:if="{{errorText}}">{{errorText}}</view>
      </block>
      <block wx:else>
        <view class="writing-prompt-structure">
          <view class="writing-prompt-section type-{{section.type}}" wx:for="{{writingPromptSections}}" wx:key="key" wx:for-item="section">
            <view class="writing-prompt-section-title">{{section.title}}</view>
            <view class="writing-article-title" wx:if="{{section.articleTitle}}">{{section.articleTitle}}</view>
            <view class="writing-prompt-lines">
              <view class="writing-prompt-line {{line.marker ? 'has-marker' : ''}} {{line.isParagraphStart ? 'is-paragraph-start' : ''}}" wx:for="{{section.lines}}" wx:key="key" wx:for-item="line">
                <view class="writing-prompt-marker" wx:if="{{line.marker}}">{{line.marker}}</view>
                <view class="writing-prompt-line-copy writing-mark-line {{writingSentenceMarks[line.scope] ? 'manual-mark-sentence' : ''}}" data-mark-scope="{{line.scope}}" bindlongpress="handleWritingSentenceMark">
                  <text wx:for="{{line.tokens}}" wx:key="id" wx:for-item="token" class="{{writingTokenMarks[token.markKey] ? 'manual-mark-' + writingTokenMarks[token.markKey] : ''}}" data-word="{{token.word}}" data-word-index="{{token.wordIndex}}" data-mark-scope="{{line.scope}}" catchtap="handleWritingTokenTap">{{token.text}}</text>
                </view>
              </view>
            </view>
            <block wx:if="{{section.type === 'task'}}">
              <view class="prompt-table" wx:if="{{promptDisplay.promptTable}}">
                <view class="prompt-table-row prompt-table-head">
                  <view class="prompt-table-cell" wx:for="{{promptDisplay.promptTable.headers}}" wx:key="*this">{{item}}</view>
                </view>
                <view class="prompt-table-row" wx:for="{{promptDisplay.promptTable.rows}}" wx:for-item="row" wx:key="label">
                  <view class="prompt-table-cell prompt-table-label">{{row.label}}</view>
                  <view class="prompt-table-cell" wx:for="{{row.values}}" wx:for-item="value" wx:key="*this">{{value}}</view>
                </view>
              </view>
              <view class="prompt-images" wx:if="{{promptImages.length}}">
                <view class="prompt-image-frame" wx:for="{{promptImages}}" wx:key="cloudPath" wx:for-item="promptImage" data-src="{{promptImage.src}}" bindtap="previewPromptImage">
                  <image class="prompt-image" src="{{promptImage.src}}" mode="widthFix" show-menu-by-longpress="{{true}}" aria-label="{{promptImage.alt}}"></image>
                  <view class="prompt-image-zoom" aria-label="{{texts.zoomChart}}"></view>
                </view>
              </view>
            </block>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="editor-card" wx:if="{{!isTranslation}}">
    <view class="editor-head">
      <view>
        <view class="section-title">{{texts.editor}}</view>
        <view class="editor-subtitle">{{texts.editorCopy}}</view>
      </view>
      <view class="word-pill">{{wordCount}}{{texts.words}}</view>
    </view>
    <view class="letter-editor {{editorFocused ? 'letter-editor-focused' : ''}}">
      <view class="paper-margin"></view>
      <view class="paragraph-tabs">
        <view></view>
        <view></view>
        <view></view>
      </view>
      <textarea class="essay-input" value="{{essayText}}" disabled="{{restoringAttempt || grading || submitting}}" maxlength="5000" cursor-spacing="180" cursor-color="#DF7F68" show-confirm-bar="{{true}}" placeholder="{{texts.placeholder}}" bindinput="onEssayInput" bindfocus="onEditorFocus" bindblur="onEditorBlur"></textarea>
    </view>
    <button class="submit-button" loading="{{submitting}}" disabled="{{restoringAttempt || submitting || submitLocked}}" bindtap="submitEssay">{{grading ? texts.grading : texts.submit}}</button>
    <view class="error-text" wx:if="{{errorText}}">{{errorText}}</view>
  </view>

  <view class="review-card" wx:if="{{!isTranslation && grading}}">
    <view class="report-ruler"></view>
    <view class="section-title">{{texts.grading}}</view>
    <view class="review-block">{{texts.gradingCopy}}</view>
  </view>

  <view class="review-card {{reviewCelebrating ? 'is-celebrating' : ''}}" wx:if="{{!isTranslation && review}}">
    <view class="report-ruler"></view>
    <view class="review-effect" wx:if="{{reviewCelebrating}}">
      <view class="review-effect-dot dot-one"></view>
      <view class="review-effect-dot dot-two"></view>
      <view class="review-effect-dot dot-three"></view>
    </view>
    <template is="writing-report" data="{{review: review, totalScore: prompt.score, texts: texts, attemptId: currentAttemptId, pdfGenerating: pdfGenerating, showBandSampleActions: true, bandSampleGeneratingDelta: bandSampleGeneratingDelta, bandSampleError: bandSampleError, reportTitle: texts.report}}"/>
  </view>
</view>
