<view class="theme-{{theme}} language-{{language}} page-shell writing-page writing-library-page" wx:if="{{theme === 'library'}}">
  <block wx:if="{{prompt}}">
    <view class="library-writing-file-head">
      <view class="library-file-meta">{{prompt.examType}} · {{prompt.district}}</view>
      <view class="library-file-title">{{prompt.title}}</view>
      <view class="library-file-rules">
        <text wx:if="{{isTranslation}}">{{prompt.questionCount || translationQuestions.length}}{{texts.questionUnit}}</text>
        <text wx:elif="{{prompt.maxWords}}">{{texts.maxWords}}{{prompt.maxWords}}{{texts.words}}</text>
        <text wx:elif="{{prompt.minWords}}">{{texts.minWords}}{{prompt.minWords}}{{texts.words}}</text>
        <text wx:if="{{prompt.score}}">{{texts.fullScore}}{{prompt.score}}{{texts.scoreUnit}}</text>
      </view>
    </view>

    <view class="library-prompt-sheet">
      <view class="library-paper-fold"></view>
      <view class="library-sheet-binding">
        <view></view>
        <view></view>
        <view></view>
      </view>
      <view class="library-sheet-head">
        <view class="library-section-title">{{texts.promptPaper}}</view>
        <view class="library-proof-small">{{texts.original}}</view>
      </view>
      <view class="library-prompt-content">
        <view class="writing-mark-toolbar">
          <text>{{texts.manualMarkHint}}</text>
          <text class="writing-mark-clear" wx:if="{{writingMarkCount}}" bindtap="clearWritingMarks">{{texts.clearManualMarks}}</text>
        </view>
        <block wx:if="{{isTranslation}}">
          <view class="library-prompt-directions">{{prompt.directions}}</view>
          <view class="library-translation-list">
            <view class="library-translation-item" wx:for="{{translationQuestions}}" wx:key="number">
              <view class="library-translation-number">{{item.number}}.</view>
              <view class="library-translation-source {{writingSentenceMarks[item.markScope] ? 'manual-mark-sentence' : ''}}" data-mark-scope="{{item.markScope}}" bindlongpress="handleWritingSentenceMark"><text wx:for="{{item.sourceTokens}}" wx:key="id" wx:for-item="token" class="{{writingTokenMarks[token.markKey] ? 'manual-mark-' + writingTokenMarks[token.markKey] : ''}}" data-word="{{token.word}}" data-word-index="{{token.wordIndex}}" data-mark-scope="{{item.markScope}}" catchtap="handleWritingTokenTap">{{token.text}}</text> <text>（{{item.requiredWord}}）</text></view>
              <textarea class="library-translation-input" value="{{item.inputValue}}" data-index="{{index}}" maxlength="800" auto-height="{{true}}" cursor-spacing="160" placeholder="{{texts.translationPlaceholder}}" bindinput="onTranslationInput"></textarea>
              <view class="library-translation-reference" wx:if="{{translationSubmitted}}">
                <view class="library-translation-reference-title">{{texts.referenceTranslation}}</view>
                <view wx:for="{{item.referenceAnswers}}" wx:for-item="answer" wx:key="*this">{{answer}}</view>
                <view class="library-translation-analysis" wx:if="{{item.analysis}}">
                  <view class="translation-analysis-head">
                    <view class="library-translation-reference-title">{{texts.modelExplanation}}</view>
                    <view class="translation-verdict status-{{item.analysis.status}}">{{item.analysis.verdict}}</view>
                  </view>
                  <view class="translation-analysis-row" wx:if="{{item.analysis.recommendedTranslation}}"><text>{{texts.recommendedTranslation}}</text>{{item.analysis.recommendedTranslation}}</view>
                  <view class="translation-analysis-row" wx:if="{{item.analysis.analysis}}"><text>{{texts.analysisLabel}}</text>{{item.analysis.analysis}}</view>
                  <view class="translation-analysis-row" wx:if="{{item.analysis.keyPoints.length}}"><text>{{texts.keyPoints}}</text><view wx:for="{{item.analysis.keyPoints}}" wx:key="*this">· {{item}}</view></view>
                  <view class="translation-correction" wx:for="{{item.analysis.corrections}}" wx:key="original">
                    <view>{{item.original}} → {{item.corrected}}</view>
                    <view class="translation-correction-reason">{{item.reason}}</view>
                  </view>
                </view>
              </view>
            </view>
          </view>
          <view class="translation-analysis-summary" wx:if="{{translationSubmitted && translationAnalysisSummary}}">{{translationAnalysisSummary}}</view>
          <button class="library-submit-button library-translation-submit" loading="{{translationAnalyzing}}" disabled="{{translationAnalyzing}}" bindtap="submitTranslation">{{translationAnalyzing ? texts.analyzingTranslation : texts.submitTranslation}}</button>
          <view class="library-editor-note" wx:if="{{errorText}}">{{errorText}}</view>
        </block>
        <block wx:else>
          <view class="writing-mark-lines">
            <block wx:for="{{writingMarkLines}}" wx:key="key" wx:for-item="line">
              <view wx:if="{{line.isArticleTitle}}">
                <view class="library-prompt-section-title">{{line.label}}</view>
                <view class="writing-article-title">{{line.text}}</view>
              </view>
              <view wx:else class="writing-mark-line {{line.isParagraphStart ? 'is-paragraph-start' : ''}} {{writingSentenceMarks[line.scope] ? 'manual-mark-sentence' : ''}}" data-mark-scope="{{line.scope}}" bindlongpress="handleWritingSentenceMark">
                <view class="library-prompt-section-title" wx:if="{{line.label}}">{{line.label}}</view>
                <text wx:for="{{line.tokens}}" wx:key="id" wx:for-item="token" class="{{writingTokenMarks[token.markKey] ? 'manual-mark-' + writingTokenMarks[token.markKey] : ''}}" data-word="{{token.word}}" data-word-index="{{token.wordIndex}}" data-mark-scope="{{line.scope}}" catchtap="handleWritingTokenTap">{{token.text}}</text>
              </view>
            </block>
          </view>
          <view class="library-prompt-table" wx:if="{{promptDisplay.promptTable}}">
            <view class="library-prompt-table-row library-prompt-table-head">
              <view class="library-prompt-table-cell" wx:for="{{promptDisplay.promptTable.headers}}" wx:key="*this">{{item}}</view>
            </view>
            <view class="library-prompt-table-row" wx:for="{{promptDisplay.promptTable.rows}}" wx:for-item="row" wx:key="label">
              <view class="library-prompt-table-cell library-prompt-table-label">{{row.label}}</view>
              <view class="library-prompt-table-cell" wx:for="{{row.values}}" wx:for-item="value" wx:key="*this">{{value}}</view>
            </view>
          </view>
          <view class="library-prompt-images" wx:if="{{promptImages.length}}">
            <view class="prompt-image-frame" wx:for="{{promptImages}}" wx:key="cloudPath" data-src="{{item.src}}" bindtap="previewPromptImage">
              <image class="library-prompt-image" src="{{item.src}}" mode="widthFix" show-menu-by-longpress="{{true}}" aria-label="{{item.alt}}"></image>
              <view class="prompt-image-zoom" aria-label="{{texts.zoomChart}}"></view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="library-manuscript-editor" wx:if="{{!isTranslation}}">
      <view class="library-editor-head">
        <view>
          <view class="library-section-title">{{texts.editor}}</view>
          <view class="library-editor-subtitle">{{texts.editorCopy}}</view>
        </view>
        <view class="library-word-tag">{{wordCount}}{{texts.words}}</view>
      </view>
      <view class="library-letter-paper {{editorFocused ? 'is-focused' : ''}}">
        <view class="library-paper-margin"></view>
        <view class="library-paragraph-rule"></view>
        <textarea class="library-essay-input" value="{{essayText}}" maxlength="5000" cursor-spacing="180" cursor-color="#B89562" show-confirm-bar="{{true}}" placeholder="{{texts.placeholder}}" bindinput="onEssayInput" bindfocus="onEditorFocus" bindblur="onEditorBlur"></textarea>
      </view>
      <button class="library-submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitEssay">{{texts.submit}}</button>
      <view class="library-editor-note" wx:if="{{errorText}}">{{errorText}}</view>
    </view>

    <view class="library-review-letter library-review-pending" wx:if="{{!isTranslation && grading}}">
      <view class="library-report-ruler"></view>
      <view class="library-section-title">{{texts.grading}}</view>
      <view class="library-review-note">{{texts.gradingCopy}}</view>
      <view class="library-proof-runner"></view>
    </view>

    <view class="library-review-letter {{reviewCelebrating ? 'is-celebrating' : ''}}" wx:if="{{!isTranslation && review}}">
      <view class="library-report-ruler"></view>
      <view class="library-review-effect" wx:if="{{reviewCelebrating}}">
        <view class="library-ink-dot dot-one"></view>
        <view class="library-ink-dot dot-two"></view>
        <view class="library-ink-dot dot-three"></view>
      </view>
      <view class="library-review-top">
        <view>
          <view class="library-section-title">{{texts.report}}</view>
          <view class="library-score">{{review.score}} / {{review.totalScore || prompt.score || 20}}{{texts.scoreUnit}}</view>
          <view class="writing-estimate-label" wx:if="{{review.estimateLabel}}">{{review.estimateLabel}}</view>
        </view>
        <view class="library-level">{{review.level}}</view>
      </view>
      <view class="writing-weighting-note" wx:if="{{review.weightingNote}}">{{review.weightingNote}}</view>
      <view class="writing-test-estimate" wx:if="{{review.writingTestEstimate}}">
        <view>
          <view class="writing-test-estimate-label">{{review.writingTestEstimate.label}}</view>
          <view class="writing-test-estimate-parts">Task 1 {{review.writingTestEstimate.task1Score}} · Task 2 {{review.writingTestEstimate.task2Score}}</view>
        </view>
        <view class="writing-test-estimate-score">Band {{review.writingTestEstimate.score}}</view>
        <view class="writing-test-estimate-formula">{{review.writingTestEstimate.formula}}</view>
      </view>
      <view class="writing-rubric-version" wx:if="{{review.rubricVersion}}">评分依据：{{review.rubricVersion}}</view>
      <view class="library-review-summary" wx:if="{{review.summary}}">{{review.summary}}</view>
      <view class="library-review-grid" wx:if="{{review.criterionDetails.length}}">
        <view class="library-review-section criterion-detail" wx:for="{{review.criterionDetails}}" wx:key="key" wx:for-item="criterion">
          <view class="library-review-label">{{criterion.label}}</view>
          <view wx:if="{{criterion.comment}}">{{criterion.comment}}</view>
          <view class="criterion-evidence" wx:if="{{criterion.evidence.length}}">
            <view class="criterion-subtitle">原文证据</view>
            <view wx:for="{{criterion.evidence}}" wx:key="*this" wx:for-item="evidence">· {{evidence}}</view>
          </view>
          <view class="criterion-descriptor" wx:if="{{criterion.descriptorMatch}}"><text>本档依据：</text>{{criterion.descriptorMatch}}</view>
          <view class="criterion-limiters" wx:if="{{criterion.limiters.length}}">
            <view class="criterion-subtitle">卡分原因</view>
            <view wx:for="{{criterion.limiters}}" wx:key="*this" wx:for-item="limiter">· {{limiter}}</view>
          </view>
          <view class="criterion-actions" wx:if="{{criterion.nextBandActions.length}}">
            <view class="criterion-subtitle">升到下一档</view>
            <view wx:for="{{criterion.nextBandActions}}" wx:key="*this" wx:for-item="action">· {{action}}</view>
          </view>
        </view>
      </view>
      <view class="library-review-grid" wx:else>
        <view class="library-review-section" wx:if="{{review.content}}">
          <view class="library-review-label">{{review.contentLabel || texts.content}}</view>
          <view>{{review.content}}</view>
        </view>
        <view class="library-review-section" wx:if="{{review.structure}}">
          <view class="library-review-label">{{review.structureLabel || texts.structure}}</view>
          <view>{{review.structure}}</view>
        </view>
        <view class="library-review-section" wx:if="{{review.language}}">
          <view class="library-review-label">{{review.languageLabel || texts.language}}</view>
          <view>{{review.language}}</view>
        </view>
        <view class="library-review-section" wx:if="{{review.spelling}}">
          <view class="library-review-label">{{review.spellingLabel || texts.spelling}}</view>
          <view>{{review.spelling}}</view>
        </view>
      </view>
      <view class="library-review-section is-list" wx:if="{{review.strengths.length}}">
        <view class="library-review-label">做得好的地方</view>
        <view wx:for="{{review.strengths}}" wx:key="*this">· {{item}}</view>
      </view>
      <view class="library-review-section is-list" wx:if="{{review.problems.length}}">
        <view class="library-review-label">{{texts.improvements}}</view>
        <view wx:for="{{review.problems}}" wx:key="*this">· {{item}}</view>
      </view>
      <view class="library-review-section is-list" wx:if="{{review.suggestions.length}}">
        <view class="library-review-label">{{texts.advice}}</view>
        <view wx:for="{{review.suggestions}}" wx:key="*this">· {{item}}</view>
      </view>
      <view class="library-review-section is-list" wx:if="{{review.grammarCorrections.length}}">
        <view class="library-review-label">{{texts.polish}}</view>
        <view class="library-correction" wx:for="{{review.grammarCorrections}}" wx:key="original">
          <view class="library-original">{{texts.originalSentence}}{{item.original}}</view>
          <view class="library-revised">{{texts.revisedSentence}}{{item.corrected}}</view>
          <view class="library-reason">{{texts.reason}}{{item.reason}}</view>
        </view>
      </view>
      <view class="library-polished-paper" wx:if="{{review.polishedVersion}}">
        <view class="library-review-label">{{review.polishedTitle || texts.rewrite}}</view>
        <view>{{review.polishedVersion}}</view>
      </view>
      <view class="band-sample-panel" wx:if="{{review.isIelts}}">
        <view class="library-review-label">分级升档范文</view>
        <view class="band-sample-copy">按需生成，分别展示比当前预估高 1 Band 和高 2 Band 的可学习版本。</view>
        <view class="band-sample-buttons">
          <button class="band-sample-button" data-delta="1" loading="{{bandSampleGeneratingDelta === 1}}" disabled="{{bandSampleGeneratingDelta > 0}}" bindtap="generateBandSample">高 1 Band 范文</button>
          <button class="band-sample-button is-strong" data-delta="2" loading="{{bandSampleGeneratingDelta === 2}}" disabled="{{bandSampleGeneratingDelta > 0}}" bindtap="generateBandSample">高 2 Band 范文</button>
        </view>
        <view class="band-sample-error" wx:if="{{bandSampleError}}">{{bandSampleError}}</view>
      </view>
      <view class="band-sample-card" wx:for="{{review.bandSamples}}" wx:key="delta" wx:for-item="sample">
        <view class="band-sample-head">
          <view class="library-review-label">{{sample.title}}</view>
          <view class="band-sample-score">Band {{sample.targetBand}}</view>
        </view>
        <view class="band-sample-essay">{{sample.essay}}</view>
        <view class="band-sample-notes" wx:if="{{sample.upgradeNotes.length}}">
          <view class="criterion-subtitle">相对原文的提升</view>
          <view wx:for="{{sample.upgradeNotes}}" wx:key="*this" wx:for-item="note">· {{note}}</view>
        </view>
        <view class="band-sample-target" wx:for="{{sample.criterionTargets}}" wx:key="label" wx:for-item="target">
          <view class="criterion-subtitle">{{target.label}}</view>
          <view wx:for="{{target.changes}}" wx:key="*this" wx:for-item="change">· {{change}}</view>
        </view>
      </view>
    </view>
  </block>

  <view class="library-empty-file" wx:else>
    <view class="library-section-title">{{texts.loadFailed}}</view>
    <view class="library-empty-copy">{{texts.noPrompt}}</view>
  </view>
</view>

<view class="theme-{{theme}} language-{{language}} page-shell writing-page" wx:else>
  <view class="writing-hero">
    <view class="eyebrow">{{prompt.examType}} · {{prompt.district}}</view>
    <view class="title">{{prompt.title}}</view>
    <view class="meta">
      <text wx:if="{{isTranslation}}">{{prompt.questionCount || translationQuestions.length}}{{texts.questionUnit}}</text>
      <text wx:elif="{{prompt.maxWords}}">{{texts.maxWords}}{{prompt.maxWords}}{{texts.words}}</text>
      <text wx:elif="{{prompt.minWords}}">{{texts.minWords}}{{prompt.minWords}}{{texts.words}}</text>
      <text wx:if="{{prompt.score}}">{{texts.fullScore}}{{prompt.score}}{{texts.scoreUnit}}</text>
    </view>
  </view>

  <view class="prompt-card">
    <view class="paper-fold"></view>
    <view class="prompt-paper-head">
      <view class="section-title">{{texts.promptPaper}}</view>
      <view class="prompt-rules">
        <text wx:if="{{isTranslation}}">{{prompt.questionCount || translationQuestions.length}}{{texts.questionUnit}}</text>
        <text wx:elif="{{prompt.maxWords}}">{{texts.maxWords}}{{prompt.maxWords}}{{texts.words}}</text>
        <text wx:elif="{{prompt.minWords}}">{{texts.minWords}}{{prompt.minWords}}{{texts.words}}</text>
        <text wx:if="{{prompt.score}}">{{prompt.score}}{{texts.scoreUnit}}</text>
      </view>
    </view>
    <view class="prompt-content">
      <view class="writing-mark-toolbar">
        <text>{{texts.manualMarkHint}}</text>
        <text class="writing-mark-clear" wx:if="{{writingMarkCount}}" bindtap="clearWritingMarks">{{texts.clearManualMarks}}</text>
      </view>
      <block wx:if="{{isTranslation}}">
        <view class="prompt-directions">{{prompt.directions}}</view>
        <view class="translation-list">
          <view class="translation-item" wx:for="{{translationQuestions}}" wx:key="number">
            <view class="translation-number">{{item.number}}.</view>
            <view class="translation-source {{writingSentenceMarks[item.markScope] ? 'manual-mark-sentence' : ''}}" data-mark-scope="{{item.markScope}}" bindlongpress="handleWritingSentenceMark"><text wx:for="{{item.sourceTokens}}" wx:key="id" wx:for-item="token" class="{{writingTokenMarks[token.markKey] ? 'manual-mark-' + writingTokenMarks[token.markKey] : ''}}" data-word="{{token.word}}" data-word-index="{{token.wordIndex}}" data-mark-scope="{{item.markScope}}" catchtap="handleWritingTokenTap">{{token.text}}</text> <text>（{{item.requiredWord}}）</text></view>
            <textarea class="translation-input" value="{{item.inputValue}}" data-index="{{index}}" maxlength="800" auto-height="{{true}}" cursor-spacing="160" placeholder="{{texts.translationPlaceholder}}" bindinput="onTranslationInput"></textarea>
            <view class="translation-reference" wx:if="{{translationSubmitted}}">
              <view class="translation-reference-title">{{texts.referenceTranslation}}</view>
              <view wx:for="{{item.referenceAnswers}}" wx:for-item="answer" wx:key="*this">{{answer}}</view>
              <view class="translation-analysis" wx:if="{{item.analysis}}">
                <view class="translation-analysis-head">
                  <view class="translation-reference-title">{{texts.modelExplanation}}</view>
                  <view class="translation-verdict status-{{item.analysis.status}}">{{item.analysis.verdict}}</view>
                </view>
                <view class="translation-analysis-row" wx:if="{{item.analysis.recommendedTranslation}}"><text>{{texts.recommendedTranslation}}</text>{{item.analysis.recommendedTranslation}}</view>
                <view class="translation-analysis-row" wx:if="{{item.analysis.analysis}}"><text>{{texts.analysisLabel}}</text>{{item.analysis.analysis}}</view>
                <view class="translation-analysis-row" wx:if="{{item.analysis.keyPoints.length}}"><text>{{texts.keyPoints}}</text><view wx:for="{{item.analysis.keyPoints}}" wx:key="*this">· {{item}}</view></view>
                <view class="translation-correction" wx:for="{{item.analysis.corrections}}" wx:key="original">
                  <view>{{item.original}} → {{item.corrected}}</view>
                  <view class="translation-correction-reason">{{item.reason}}</view>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view class="translation-analysis-summary" wx:if="{{translationSubmitted && translationAnalysisSummary}}">{{translationAnalysisSummary}}</view>
        <button class="submit-button translation-submit" loading="{{translationAnalyzing}}" disabled="{{translationAnalyzing}}" bindtap="submitTranslation">{{translationAnalyzing ? texts.analyzingTranslation : texts.submitTranslation}}</button>
        <view class="error-text" wx:if="{{errorText}}">{{errorText}}</view>
      </block>
      <block wx:else>
        <view class="writing-mark-lines">
          <block wx:for="{{writingMarkLines}}" wx:key="key" wx:for-item="line">
            <view wx:if="{{line.isArticleTitle}}">
              <view class="prompt-section-title">{{line.label}}</view>
              <view class="writing-article-title">{{line.text}}</view>
            </view>
            <view wx:else class="writing-mark-line {{line.isParagraphStart ? 'is-paragraph-start' : ''}} {{writingSentenceMarks[line.scope] ? 'manual-mark-sentence' : ''}}" data-mark-scope="{{line.scope}}" bindlongpress="handleWritingSentenceMark">
              <view class="prompt-section-title" wx:if="{{line.label}}">{{line.label}}</view>
              <text wx:for="{{line.tokens}}" wx:key="id" wx:for-item="token" class="{{writingTokenMarks[token.markKey] ? 'manual-mark-' + writingTokenMarks[token.markKey] : ''}}" data-word="{{token.word}}" data-word-index="{{token.wordIndex}}" data-mark-scope="{{line.scope}}" catchtap="handleWritingTokenTap">{{token.text}}</text>
            </view>
          </block>
        </view>
        <view class="prompt-table" wx:if="{{promptDisplay.promptTable}}">
          <view class="prompt-table-row prompt-table-head">
            <view class="prompt-table-cell" wx:for="{{promptDisplay.promptTable.headers}}" wx:key="*this">{{item}}</view>
          </view>
          <view class="prompt-table-row" wx:for="{{promptDisplay.promptTable.rows}}" wx:for-item="row" wx:key="label">
            <view class="prompt-table-cell prompt-table-label">{{row.label}}</view>
            <view class="prompt-table-cell" wx:for="{{row.values}}" wx:for-item="value" wx:key="*this">{{value}}</view>
          </view>
        </view>
        <view class="prompt-images" wx:if="{{promptImages.length}}">
          <view class="prompt-image-frame" wx:for="{{promptImages}}" wx:key="cloudPath" data-src="{{item.src}}" bindtap="previewPromptImage">
            <image class="prompt-image" src="{{item.src}}" mode="widthFix" show-menu-by-longpress="{{true}}" aria-label="{{item.alt}}"></image>
            <view class="prompt-image-zoom" aria-label="{{texts.zoomChart}}"></view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="editor-card" wx:if="{{!isTranslation}}">
    <view class="editor-head">
      <view>
        <view class="section-title">{{texts.editor}}</view>
        <view class="editor-subtitle">{{texts.editorCopy}}</view>
      </view>
      <view class="word-pill">{{wordCount}}{{texts.words}}</view>
    </view>
    <view class="letter-editor {{editorFocused ? 'letter-editor-focused' : ''}}">
      <view class="paper-margin"></view>
      <view class="paragraph-tabs">
        <view></view>
        <view></view>
        <view></view>
      </view>
      <textarea class="essay-input" value="{{essayText}}" maxlength="5000" cursor-spacing="180" cursor-color="#DF7F68" show-confirm-bar="{{true}}" placeholder="{{texts.placeholder}}" bindinput="onEssayInput" bindfocus="onEditorFocus" bindblur="onEditorBlur"></textarea>
    </view>
    <button class="submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitEssay">{{texts.submit}}</button>
    <view class="error-text" wx:if="{{errorText}}">{{errorText}}</view>
  </view>

  <view class="review-card" wx:if="{{!isTranslation && grading}}">
    <view class="report-ruler"></view>
    <view class="section-title">{{texts.grading}}</view>
    <view class="review-block">{{texts.gradingCopy}}</view>
  </view>

  <view class="review-card {{reviewCelebrating ? 'is-celebrating' : ''}}" wx:if="{{!isTranslation && review}}">
    <view class="report-ruler"></view>
    <view class="review-effect" wx:if="{{reviewCelebrating}}">
      <view class="review-effect-dot dot-one"></view>
      <view class="review-effect-dot dot-two"></view>
      <view class="review-effect-dot dot-three"></view>
    </view>
    <view class="review-top">
      <view>
        <view class="section-title">{{texts.report}}</view>
        <view class="score">{{review.score}} / {{review.totalScore || prompt.score || 20}}{{texts.scoreUnit}}</view>
        <view class="writing-estimate-label" wx:if="{{review.estimateLabel}}">{{review.estimateLabel}}</view>
      </view>
      <view class="level">{{review.level}}</view>
    </view>
    <view class="writing-weighting-note" wx:if="{{review.weightingNote}}">{{review.weightingNote}}</view>
    <view class="writing-test-estimate" wx:if="{{review.writingTestEstimate}}">
      <view>
        <view class="writing-test-estimate-label">{{review.writingTestEstimate.label}}</view>
        <view class="writing-test-estimate-parts">Task 1 {{review.writingTestEstimate.task1Score}} · Task 2 {{review.writingTestEstimate.task2Score}}</view>
      </view>
      <view class="writing-test-estimate-score">Band {{review.writingTestEstimate.score}}</view>
      <view class="writing-test-estimate-formula">{{review.writingTestEstimate.formula}}</view>
    </view>
    <view class="writing-rubric-version" wx:if="{{review.rubricVersion}}">评分依据：{{review.rubricVersion}}</view>
    <view class="review-block" wx:if="{{review.summary}}">{{review.summary}}</view>
    <block wx:if="{{review.criterionDetails.length}}">
      <view class="review-list criterion-detail" wx:for="{{review.criterionDetails}}" wx:key="key" wx:for-item="criterion">
        <view class="list-title">{{criterion.label}}</view>
        <view wx:if="{{criterion.comment}}">{{criterion.comment}}</view>
        <view class="criterion-evidence" wx:if="{{criterion.evidence.length}}">
          <view class="criterion-subtitle">原文证据</view>
          <view wx:for="{{criterion.evidence}}" wx:key="*this" wx:for-item="evidence">· {{evidence}}</view>
        </view>
        <view class="criterion-descriptor" wx:if="{{criterion.descriptorMatch}}"><text>本档依据：</text>{{criterion.descriptorMatch}}</view>
        <view class="criterion-limiters" wx:if="{{criterion.limiters.length}}">
          <view class="criterion-subtitle">卡分原因</view>
          <view wx:for="{{criterion.limiters}}" wx:key="*this" wx:for-item="limiter">· {{limiter}}</view>
        </view>
        <view class="criterion-actions" wx:if="{{criterion.nextBandActions.length}}">
          <view class="criterion-subtitle">升到下一档</view>
          <view wx:for="{{criterion.nextBandActions}}" wx:key="*this" wx:for-item="action">· {{action}}</view>
        </view>
      </view>
    </block>
    <block wx:else>
    <view class="review-list" wx:if="{{review.content}}">
      <view class="list-title">{{review.contentLabel || texts.content}}</view>
      <view>{{review.content}}</view>
    </view>
    <view class="review-list" wx:if="{{review.structure}}">
      <view class="list-title">{{review.structureLabel || texts.structure}}</view>
      <view>{{review.structure}}</view>
    </view>
    <view class="review-list" wx:if="{{review.language}}">
      <view class="list-title">{{review.languageLabel || texts.language}}</view>
      <view>{{review.language}}</view>
    </view>
    <view class="review-list" wx:if="{{review.spelling}}">
      <view class="list-title">{{review.spellingLabel || texts.spelling}}</view>
      <view>{{review.spelling}}</view>
    </view>
    </block>
    <view class="review-list" wx:if="{{review.strengths.length}}">
      <view class="list-title">做得好的地方</view>
      <view wx:for="{{review.strengths}}" wx:key="*this">· {{item}}</view>
    </view>
    <view class="review-list" wx:if="{{review.problems.length}}">
      <view class="list-title">{{texts.improvements}}</view>
      <view wx:for="{{review.problems}}" wx:key="*this">· {{item}}</view>
    </view>
    <view class="review-list" wx:if="{{review.suggestions.length}}">
      <view class="list-title">{{texts.advice}}</view>
      <view wx:for="{{review.suggestions}}" wx:key="*this">· {{item}}</view>
    </view>
    <view class="review-list" wx:if="{{review.grammarCorrections.length}}">
      <view class="list-title">{{texts.polish}}</view>
      <view class="correction-item" wx:for="{{review.grammarCorrections}}" wx:key="original">
        <view class="original">{{texts.originalSentence}}{{item.original}}</view>
        <view class="revised">{{texts.revisedSentence}}{{item.corrected}}</view>
        <view class="reason">{{texts.reason}}{{item.reason}}</view>
      </view>
    </view>
    <view class="review-list polished" wx:if="{{review.polishedVersion}}">
      <view class="list-title">{{review.polishedTitle || texts.rewrite}}</view>
      <view>{{review.polishedVersion}}</view>
    </view>
    <view class="band-sample-panel" wx:if="{{review.isIelts}}">
      <view class="list-title">分级升档范文</view>
      <view class="band-sample-copy">按需生成，分别展示比当前预估高 1 Band 和高 2 Band 的可学习版本。</view>
      <view class="band-sample-buttons">
        <button class="band-sample-button" data-delta="1" loading="{{bandSampleGeneratingDelta === 1}}" disabled="{{bandSampleGeneratingDelta > 0}}" bindtap="generateBandSample">高 1 Band 范文</button>
        <button class="band-sample-button is-strong" data-delta="2" loading="{{bandSampleGeneratingDelta === 2}}" disabled="{{bandSampleGeneratingDelta > 0}}" bindtap="generateBandSample">高 2 Band 范文</button>
      </view>
      <view class="band-sample-error" wx:if="{{bandSampleError}}">{{bandSampleError}}</view>
    </view>
    <view class="band-sample-card" wx:for="{{review.bandSamples}}" wx:key="delta" wx:for-item="sample">
      <view class="band-sample-head">
        <view class="list-title">{{sample.title}}</view>
        <view class="band-sample-score">Band {{sample.targetBand}}</view>
      </view>
      <view class="band-sample-essay">{{sample.essay}}</view>
      <view class="band-sample-notes" wx:if="{{sample.upgradeNotes.length}}">
        <view class="criterion-subtitle">相对原文的提升</view>
        <view wx:for="{{sample.upgradeNotes}}" wx:key="*this" wx:for-item="note">· {{note}}</view>
      </view>
      <view class="band-sample-target" wx:for="{{sample.criterionTargets}}" wx:key="label" wx:for-item="target">
        <view class="criterion-subtitle">{{target.label}}</view>
        <view wx:for="{{target.changes}}" wx:key="*this" wx:for-item="change">· {{change}}</view>
      </view>
    </view>
  </view>
</view>
