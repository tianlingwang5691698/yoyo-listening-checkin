<view class="theme-{{theme}} language-{{language}} page-shell family-page">
  <view wx:if="{{theme === 'library'}}" class="library-family">
    <view class="library-folder-cover">
      <view>
        <view class="library-kicker">Family Dossier</view>
        <view class="library-title">{{texts.title}}</view>
      </view>
      <view class="library-stamp {{syncMode === 'cloud' ? 'is-ok' : ''}}">{{syncMode === 'cloud' ? texts.connected : texts.pendingSync}}</view>
    </view>
    <view class="library-debug {{syncMode === 'cloud' ? 'is-cloud' : 'is-local'}}" wx:if="{{showCloudDebug && syncDebug && syncDebug.show}}">
      {{syncDebug.text}}
    </view>

    <view class="library-folder-sheet is-repair" wx:if="{{bindingProfileRequired}}">
      <view class="library-title small">{{texts.completeBinding}}</view>
      <view class="library-copy">{{texts.completeBindingCopy}}</view>
      <view class="library-field-label">{{texts.yourNickname}}</view>
      <input class="library-input" placeholder="{{texts.nicknameExample}}" value="{{bindingNicknameInput}}" bindinput="handleBindingNicknameInput" />
      <view class="library-field-label">{{texts.relation}}</view>
      <input class="library-input" placeholder="{{texts.relationExample}}" value="{{bindingRelationInput}}" bindinput="handleBindingRelationInput" />
      <button class="library-primary full" bindtap="saveBindingProfile">{{texts.save}}</button>
    </view>

    <block wx:else>
      <view class="library-folder-sheet">
        <view class="library-card-head library-identity-head" wx:if="{{!childJoinRequired}}">
          <view>
            <view class="library-kicker">{{texts.identityTab}}</view>
            <view class="library-title small">{{studyRoleLabel}}</view>
          </view>
          <button class="library-secondary" bindtap="toggleStudyRole">{{studyRoleActionText}}</button>
        </view>
        <view class="library-identity-field" wx:if="{{!childJoinRequired && currentMember}}">
          <view class="library-field-label">{{identityNicknameLabel}}{{identityNicknameRequired ? texts.required : ''}}</view>
          <input class="library-input" placeholder="{{texts.nicknamePlaceholder}}" value="{{identityNicknameInput}}" bindinput="handleIdentityNicknameInput" />
          <view class="library-copy is-required" wx:if="{{identityNicknameRequired}}">{{texts.changeNickname}}</view>
          <view class="nickname-save-debug" wx:if="{{nicknameSaveDebug}}" user-select="true">{{nicknameSaveDebug}}</view>
          <button class="library-primary full {{savingIdentityNickname ? 'is-disabled' : ''}}" bindtap="saveIdentityNickname">{{texts.saveNickname}}</button>
        </view>
        <view class="library-reader-code" wx:if="{{!childJoinRequired && currentMember && currentMember.studyRole === 'student'}}">
          <view class="library-kicker">{{texts.readerNumber}}</view>
          <view class="reader-number compact">{{child.childLoginCode || texts.pendingSync}}</view>
        </view>
      </view>

      <view class="library-folder-sheet" wx:if="{{!childJoinRequired && currentMember && currentMember.studyRole === 'parent' && studentCards.length}}">
        <view class="library-card-head">
          <view>
            <view class="library-kicker">{{texts.familyRelation}}</view>
            <view class="library-title small">{{texts.boundStudents}}</view>
          </view>
          <view class="library-stamp">{{studentCountText}}</view>
        </view>
        <view class="library-copy">{{texts.boundStudentsCopy}}</view>
        <block wx:for="{{studentCards}}" wx:key="familyId">
          <view class="borrower-card {{item.isCurrent ? 'is-current' : ''}}" data-index="{{index}}" bindtap="selectStudent">
            <view class="borrower-mark">{{texts.studentMark}}</view>
            <view class="entry-main">
              <view class="entry-title">{{item.nickname}}</view>
              <view class="entry-copy">{{texts.studentIdPrefix}}{{item.childLoginCode || texts.pendingSync}}</view>
            </view>
            <view class="student-card-actions">
              <view class="library-stamp is-ok" wx:if="{{item.isCurrent}}">{{texts.current}}</view>
              <view class="student-record-entry is-library" data-index="{{index}}" catchtap="openStudentPracticeHistory">{{texts.enterRecords}}</view>
            </view>
          </view>
        </block>
        <view class="library-copy" wx:if="{{studentCards.length === 1}}">{{texts.addMoreStudents}}</view>
      </view>

      <view class="library-reader-form" wx:if="{{currentMember}}">
        <view class="library-title small">{{currentMember.studyRole === 'student' ? texts.loginOtherStudent : texts.boundStudents}}</view>
        <input class="reader-code-input compact" type="number" maxlength="6" placeholder="{{texts.studentId}}" value="{{childCodeInput}}" bindinput="handleChildCodeInput" />
        <view wx:if="{{currentMember.studyRole !== 'student'}}">
          <view class="library-field-label">{{texts.relation}}</view>
          <input class="library-input" placeholder="{{texts.relationExample}}" value="{{joinName}}" bindinput="handleJoinNameInput" />
        </view>
        <button class="library-primary full" bindtap="joinFamilyByChildCode">{{currentMember.studyRole === 'student' ? texts.login : texts.bind}}</button>
      </view>

      <view class="library-danger" wx:if="{{!childJoinRequired && currentMember && currentMember.studyRole === 'parent'}}">
        <view class="danger-copy">
          <view class="library-title small">{{texts.fixTodayRecord}}</view>
          <view class="library-copy">{{texts.undoPlayCopy}}</view>
        </view>
        <button class="library-danger-button {{undoingLastListened ? 'is-disabled' : ''}}" bindtap="undoLastListened">{{texts.undo}}</button>
      </view>

      <view class="library-danger is-envelope" wx:if="{{currentMember && currentMember.studyRole === 'parent' && currentMember.role !== 'owner'}}">
        <view class="danger-copy">
          <view class="library-title small">{{texts.unbind}}</view>
          <view class="library-copy">{{texts.unbindCopy}}</view>
        </view>
        <button class="library-danger-button" bindtap="leaveFamily">{{texts.exit}}</button>
      </view>

      <view class="library-folder-sheet" wx:if="{{!childJoinRequired}}">
        <view class="library-title small">{{texts.members}}</view>
        <block wx:for="{{memberCards}}" wx:key="memberId">
          <view class="member-index {{item.isCurrentDevice ? 'is-current-device' : ''}}">
            <view class="entry-title">{{item.displayName}}</view>
            <view class="library-stamp is-ok" wx:if="{{item.isCurrentDevice}}">{{texts.localDevice}}</view>
          </view>
        </block>
      </view>
    </block>
  </view>

  <block wx:else>
  <view class="family-atmosphere">
    <view class="light-ray ray-one"></view>
    <view class="light-ray ray-two"></view>
  </view>

  <view class="family-hero product-hero">
    <view class="voyage-crew-badge" wx:if="{{theme === 'voyage'}}">⚓</view>
    <view class="family-map">
      <view class="family-node node-parent">{{texts.parentMark}}</view>
      <view class="family-link"></view>
      <view class="family-node node-child">{{texts.studentMark}}</view>
    </view>
    <view class="product-title type-page-title">{{texts.familyTitle}}</view>
    <view class="product-copy">{{syncMode === 'cloud' ? texts.connected : texts.pendingSync}}</view>
    <view class="sync-debug {{syncMode === 'cloud' ? 'is-cloud' : 'is-local'}}" wx:if="{{showCloudDebug && syncDebug && syncDebug.show}}">
      {{syncDebug.text}}
    </view>
  </view>

  <view class="binding-repair relation-panel glass-panel" wx:if="{{bindingProfileRequired}}">
    <view class="section-title">{{texts.completeBinding}}</view>
    <view class="student-hint">{{texts.completeBindingCopy}}</view>
    <view class="family-row action-row input-card">
      <view class="row-main">
        <view class="row-title">{{texts.yourNickname}}</view>
        <input class="row-field family-input" placeholder="{{texts.nicknameExample}}" value="{{bindingNicknameInput}}" bindinput="handleBindingNicknameInput" />
      </view>
    </view>
    <view class="family-row action-row input-card binding-save-row">
      <view class="row-main">
        <view class="row-title">{{texts.relation}}</view>
        <input class="row-field family-input" placeholder="{{texts.relationExample}}" value="{{bindingRelationInput}}" bindinput="handleBindingRelationInput" />
      </view>
      <button class="row-action row-action-wide primary-action" bindtap="saveBindingProfile">{{texts.save}}</button>
    </view>
  </view>

  <view class="relation-panel glass-panel" wx:if="{{!bindingProfileRequired}}">
    <view class="section-title">{{texts.accountIdentity}}</view>
    <view class="family-row action-row identity-strip" wx:if="{{!childJoinRequired}}">
      <view class="role-orb"></view>
      <view class="row-main">
        <view class="row-copy">{{studyRoleLabel}}</view>
      </view>
      <button class="row-action" bindtap="toggleStudyRole">{{studyRoleActionText}}</button>
    </view>
    <view class="family-row action-row input-card nickname-strip" wx:if="{{!childJoinRequired && currentMember}}">
      <view class="row-main">
        <view class="row-title">{{identityNicknameLabel}}{{identityNicknameRequired ? texts.required : ''}}</view>
        <input class="row-field family-input" placeholder="{{texts.nicknamePlaceholder}}" value="{{identityNicknameInput}}" bindinput="handleIdentityNicknameInput" />
        <view class="row-copy is-required" wx:if="{{identityNicknameRequired}}">{{texts.changeNickname}}</view>
        <view class="nickname-save-debug" wx:if="{{nicknameSaveDebug}}" user-select="true">{{nicknameSaveDebug}}</view>
      </view>
      <button class="row-action row-action-wide primary-action {{savingIdentityNickname ? 'is-disabled' : ''}}" bindtap="saveIdentityNickname">{{texts.saveNickname}}</button>
    </view>
    <view class="family-row action-row code-strip" wx:if="{{!childJoinRequired && currentMember && currentMember.studyRole === 'student'}}">
      <view class="row-main">
        <view class="row-title">{{texts.studentId}}</view>
        <view class="row-copy">{{child.childLoginCode || texts.pendingSync}}</view>
      </view>
    </view>
  </view>

  <view class="student-board glass-panel" wx:if="{{!bindingProfileRequired && !childJoinRequired && currentMember && currentMember.studyRole === 'parent' && studentCards.length}}">
    <view class="section-head">
      <view class="section-title">{{texts.boundStudents}}</view>
      <view class="section-count">{{studentCountText}}</view>
    </view>
    <view class="student-hint">{{texts.boundStudentsCopy}}</view>
    <view class="student-track">
      <block wx:for="{{studentCards}}" wx:key="familyId">
        <view class="student-row student-card {{item.isCurrent ? 'is-current' : ''}}" data-index="{{index}}" bindtap="selectStudent">
          <view class="student-avatar">{{texts.studentMark}}</view>
          <view class="row-main">
            <view class="row-title">{{item.nickname}}</view>
            <view class="row-copy">{{texts.studentIdPrefix}}{{item.childLoginCode || texts.pendingSync}}</view>
          </view>
          <view class="student-card-actions">
            <view class="student-current" wx:if="{{item.isCurrent}}">{{texts.current}}</view>
            <view class="student-record-entry" data-index="{{index}}" catchtap="openStudentPracticeHistory">{{texts.enterRecords}}</view>
          </view>
        </view>
      </block>
    </view>
    <view class="student-hint" wx:if="{{studentCards.length === 1}}">{{texts.addMoreStudents}}</view>
  </view>

  <view class="join-panel glass-panel" wx:if="{{!bindingProfileRequired && currentMember}}">
    <view class="section-title">{{currentMember.studyRole === 'student' ? texts.loginOtherStudent : texts.boundStudents}}</view>
    <view class="family-row action-row input-card join-code-row">
      <view class="row-main">
        <input class="row-field family-input" type="number" maxlength="6" placeholder="{{texts.studentId}}" value="{{childCodeInput}}" bindinput="handleChildCodeInput" />
      </view>
      <button class="row-action primary-action" bindtap="joinFamilyByChildCode">{{currentMember.studyRole === 'student' ? texts.login : texts.bind}}</button>
    </view>
    <view class="family-row action-row input-card" wx:if="{{currentMember.studyRole !== 'student'}}">
      <view class="row-main">
        <view class="row-title">{{texts.relation}}</view>
        <input class="row-field family-input" placeholder="{{texts.relationExample}}" value="{{joinName}}" bindinput="handleJoinNameInput" />
      </view>
      <view class="row-action row-action-ghost"> </view>
    </view>
  </view>

  <view class="care-actions" wx:if="{{!bindingProfileRequired && !childJoinRequired && currentMember && currentMember.studyRole === 'parent'}}">
    <view class="mini-panel glass-panel">
      <view class="section-title">{{texts.fixTodayRecord}}</view>
      <view class="family-row action-row">
        <view class="row-main">
          <view class="row-copy">{{texts.undoPlayCopy}}</view>
        </view>
        <button class="row-action row-action-wide row-action-warn {{undoingLastListened ? 'is-disabled' : ''}}" bindtap="undoLastListened">{{texts.undo}}</button>
      </view>
    </view>
  </view>

  <view class="mini-panel glass-panel" wx:if="{{!bindingProfileRequired && currentMember && currentMember.studyRole === 'parent' && currentMember.role !== 'owner'}}">
    <view class="section-title">{{texts.unbind}}</view>
    <view class="family-row action-row">
      <view class="row-main">
        <view class="row-copy">{{texts.unbindCopy}}</view>
      </view>
      <button class="row-action row-action-warn" bindtap="leaveFamily">{{texts.exit}}</button>
    </view>
  </view>

  <view class="member-card glass-panel" wx:if="{{!bindingProfileRequired && !childJoinRequired}}">
    <view class="section-title">{{texts.members}}</view>
    <view class="member-constellation">
      <block wx:for="{{memberCards}}" wx:key="memberId">
        <view class="member-row member-node {{item.isCurrentDevice ? 'is-current-device' : ''}}">
          <view class="member-dot"></view>
          <view class="row-main">
            <view class="member-name">{{item.displayName}}</view>
          </view>
          <view class="member-role type-caption" wx:if="{{item.isCurrentDevice}}">{{texts.localDevice}}</view>
        </view>
      </block>
    </view>
  </view>
  </block>
</view>
