.family-page {
  position: relative;
  min-height: 100vh;
  padding: 76rpx 32rpx 150rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 76% 8%, rgba(255, 255, 255, 0.96) 0, rgba(255, 255, 255, 0) 30%),
    radial-gradient(circle at 18% 24%, rgba(191, 215, 232, 0.56) 0, rgba(191, 215, 232, 0) 36%),
    linear-gradient(160deg, #f8fbfd 0%, #edf6fa 45%, #f6fbfd 100%);
  color: #17314f;
}

.family-atmosphere {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.light-ray {
  position: absolute;
  top: -46rpx;
  width: 30rpx;
  height: 470rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  filter: blur(2rpx);
  transform: rotate(24deg);
}

.ray-one {
  right: 176rpx;
}

.ray-two {
  right: 70rpx;
  height: 380rpx;
  opacity: 0.68;
}

.family-hero {
  position: relative;
  z-index: 1;
  min-height: 430rpx;
  padding: 54rpx 42rpx 44rpx;
  border-radius: 60rpx;
  overflow: hidden;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.82), rgba(219, 233, 242, 0.46) 56%, rgba(255, 255, 255, 0.72)),
    rgba(231, 241, 248, 0.66);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.98),
    0 26rpx 70rpx rgba(78, 112, 139, 0.17);
  backdrop-filter: blur(18rpx);
}

.family-hero::before {
  content: "";
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 22rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0));
}

.family-map {
  position: relative;
  height: 152rpx;
  margin-bottom: 24rpx;
}

.family-node {
  position: absolute;
  top: 16rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  color: #fffafa;
  font-size: 40rpx;
  line-height: 112rpx;
  text-align: center;
  font-weight: 600;
  box-shadow: 0 18rpx 34rpx rgba(78, 112, 139, 0.16);
}

.node-parent {
  left: 106rpx;
  background: linear-gradient(145deg, #8db7d4 0%, #6f9fbd 100%);
}

.node-child {
  right: 106rpx;
  background: linear-gradient(145deg, #f2a18e 0%, #df7f68 100%);
}

.family-link {
  position: absolute;
  left: 244rpx;
  right: 244rpx;
  top: 70rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(141, 183, 212, 0.72), rgba(242, 161, 142, 0.7));
}

.product-title {
  color: #17314f;
  font-family: "PingFang SC", "Songti SC", serif;
  font-size: 50rpx;
  line-height: 1.14;
  font-weight: 500;
  text-align: center;
}

.product-copy {
  margin-top: 24rpx;
  color: #607087;
  font-size: 28rpx;
  line-height: 1.45;
  text-align: center;
}

.glass-panel {
  position: relative;
  z-index: 1;
  overflow: hidden;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  box-shadow: 0 18rpx 48rpx rgba(78, 112, 139, 0.12);
  backdrop-filter: blur(16rpx);
}

.relation-panel,
.student-board,
.join-panel,
.member-card,
.mini-panel {
  margin-top: 20rpx;
  padding: 30rpx 24rpx 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  color: #17314f;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 600;
}

.section-count {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.18);
  color: #607087;
  font-size: 22rpx;
}

.family-row,
.member-row,
.student-row {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.action-row {
  align-items: flex-start;
}

.input-card,
.identity-strip,
.code-strip,
.student-card,
.member-node {
  margin-top: 16rpx;
  padding: 22rpx 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.52);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
}

.identity-strip {
  align-items: center;
  background: rgba(191, 215, 232, 0.28);
}

.identity-strip .row-action {
  align-self: center;
  margin-top: 0;
}

.role-orb {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background:
    radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0) 36%),
    #86aaa1;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title,
.member-name {
  color: #17314f;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 600;
}

.row-copy,
.member-copy {
  margin-top: 8rpx;
  color: #728196;
  font-size: 24rpx;
  line-height: 1.35;
}

.family-input {
  width: 100%;
  min-height: 62rpx;
  margin-top: 10rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.62);
  color: #17314f;
  font-size: 28rpx;
}

.row-action {
  width: 112rpx;
  height: 62rpx;
  min-width: 112rpx;
  min-height: 62rpx;
  margin: 24rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.2);
  color: #17314f;
  font-size: 24rpx;
  line-height: 62rpx;
  font-weight: 600;
}

.primary-action {
  background: linear-gradient(135deg, #f2a18e 0%, #df7f68 100%);
  color: #fffafa;
  box-shadow: 0 14rpx 28rpx rgba(214, 119, 98, 0.22);
}

.row-action-ghost {
  background: transparent;
  color: transparent;
  box-shadow: none;
}

.row-action-wide {
  width: 128rpx;
  min-width: 128rpx;
}

.row-action-warn {
  background: rgba(242, 161, 142, 0.18);
  color: #df7f68;
}

.row-action.is-disabled {
  opacity: 0.5;
}

.nickname-strip {
  align-items: flex-start;
}

.is-required {
  color: #b45e40;
}

.nickname-save-debug {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(180, 94, 64, 0.1);
  color: #9a5f55;
  font-size: 20rpx;
  line-height: 1.45;
  word-break: break-all;
}

.student-hint {
  margin-top: 14rpx;
  color: #728196;
  font-size: 24rpx;
  line-height: 1.5;
}

.student-track {
  margin-top: 18rpx;
}

.student-card {
  align-items: center;
  box-sizing: border-box;
}

.student-card.is-current {
  background: rgba(191, 215, 232, 0.3);
  border-color: rgba(141, 183, 212, 0.26);
}

.student-avatar {
  flex-shrink: 0;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: rgba(134, 170, 161, 0.18);
  color: #486d64;
  font-size: 28rpx;
  line-height: 66rpx;
  text-align: center;
  font-weight: 600;
}

.student-current {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(242, 161, 142, 0.18);
  color: #df7f68;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 600;
  white-space: nowrap;
}

.student-card-actions {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  align-items: flex-end;
  gap: 10rpx;
}

.student-record-entry {
  box-sizing: border-box;
  min-height: 58rpx;
  padding: 0 18rpx;
  border: 2rpx solid #17314f;
  border-radius: 999rpx;
  background: #17314f;
  color: #fff;
  font-size: 24rpx;
  line-height: 54rpx;
  font-weight: 600;
  white-space: nowrap;
}

.student-record-entry.is-library {
  border-color: #8c693d;
  border-radius: 8px;
  background: #8c693d;
}

.care-actions {
  position: relative;
  z-index: 1;
}

.member-constellation {
  margin-top: 18rpx;
}

.member-node {
  align-items: center;
}

.member-node.is-current-device {
  background: rgba(191, 215, 232, 0.28);
}

.member-dot {
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #8db7d4;
  box-shadow: 0 0 0 10rpx rgba(141, 183, 212, 0.14);
}

.member-role {
  flex-shrink: 0;
  align-self: center;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(134, 170, 161, 0.16);
  color: #486d64;
  text-align: right;
}

.sync-debug {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  line-height: 1.5;
  background: rgba(255, 255, 255, 0.58);
  color: #728196;
}

.sync-debug.is-cloud {
  background: rgba(134, 170, 161, 0.16);
  color: #486d64;
}

.sync-debug.is-local {
  background: rgba(242, 161, 142, 0.18);
  color: #df7f68;
}

.theme-library.family-page {
  padding: 56rpx 28rpx 150rpx;
  overflow: visible;
  background:
    linear-gradient(180deg, rgba(43, 33, 27, 0.86) 0, rgba(43, 33, 27, 0.86) 160rpx, transparent 160rpx),
    linear-gradient(135deg, #faf5ea 0%, #f3e8d4 100%);
  color: #14283a;
}

.library-folder-cover,
.library-folder-sheet,
.library-reader-form,
.library-danger,
.borrower-card,
.member-index {
  border-radius: 8px;
  border: 1rpx solid rgba(184, 149, 98, 0.42);
  box-shadow: 0 6rpx 18rpx rgba(43, 33, 27, 0.12);
  box-sizing: border-box;
}

.library-folder-cover {
  min-height: 184rpx;
  padding: 30rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  background: #2b211b;
}

.library-kicker {
  color: #b89562;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
}

.library-title {
  margin-top: 8rpx;
  color: #faf5ea;
  font-family: "Songti SC", serif;
  font-size: 44rpx;
  line-height: 1.16;
  font-weight: 600;
}

.library-title.small,
.entry-title {
  color: #14283a;
  font-family: "PingFang SC", sans-serif;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 600;
}

.library-copy,
.entry-copy {
  margin-top: 10rpx;
  color: #6f675f;
  font-size: 24rpx;
  line-height: 1.5;
}

.library-stamp {
  flex-shrink: 0;
  min-height: 48rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.72);
  border-radius: 8px;
  color: #b89562;
  font-size: 22rpx;
  line-height: 48rpx;
  font-weight: 600;
  text-align: center;
}

.library-stamp.is-ok {
  border-color: rgba(127, 140, 120, 0.75);
  color: #7f8c78;
}

.library-debug {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 8px;
  background: rgba(250, 245, 234, 0.78);
  color: #6f675f;
  font-size: 22rpx;
  line-height: 1.5;
}

.library-folder-sheet,
.library-reader-form,
.library-danger {
  margin-top: 20rpx;
  padding: 26rpx;
  background: #faf5ea;
}

.library-folder-sheet.is-repair,
.library-reader-form {
  background:
    linear-gradient(90deg, rgba(184, 149, 98, 0.12) 0 2rpx, transparent 2rpx),
    #f3e8d4;
}

.library-card-head,
.borrower-card,
.member-index,
.library-danger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.library-card-head > view:first-child {
  flex: 1;
  min-width: 0;
}

.library-card-head .library-secondary {
  flex-shrink: 0;
  white-space: nowrap;
}

.library-field-label {
  margin-top: 20rpx;
  color: #6f675f;
  font-size: 22rpx;
  font-weight: 600;
}

.library-input,
.reader-code-input {
  width: 100%;
  height: 74rpx;
  margin-top: 12rpx;
  padding: 0 22rpx;
  border-radius: 8px;
  background: #faf5ea;
  color: #14283a;
  font-size: 28rpx;
  box-sizing: border-box;
}

.reader-code-input.compact {
  background: #faf5ea;
  text-align: center;
  font-size: 38rpx;
  font-weight: 600;
}

.reader-number.compact {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 8px;
  border: 2rpx solid #b89562;
  color: #14283a;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 600;
  text-align: center;
}

.library-primary,
.library-secondary,
.library-danger-button {
  height: 66rpx;
  min-width: 116rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 8px;
  font-size: 24rpx;
  line-height: 66rpx;
  font-weight: 600;
}

.library-primary {
  background: #14283a;
  color: #faf5ea;
}

.library-primary.full {
  width: 100%;
  margin-top: 24rpx;
}

.library-secondary {
  background: #f3e8d4;
  color: #14283a;
}

.library-danger-button {
  background: rgba(154, 95, 85, 0.12);
  color: #9a5f55;
}

.library-primary::after,
.library-secondary::after,
.library-danger-button::after {
  border: none;
}

.library-primary.is-disabled {
  opacity: 0.5;
}

.library-identity-field {
  margin-top: 18rpx;
  padding-top: 4rpx;
}

.borrower-card {
  min-height: 116rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  background: #f3e8d4;
}

.borrower-card.is-current {
  border-color: rgba(127, 140, 120, 0.78);
  background: rgba(127, 140, 120, 0.12);
}

.borrower-mark {
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  border: 1rpx solid #b89562;
  border-radius: 8px;
  color: #b89562;
  font-size: 26rpx;
  line-height: 58rpx;
  text-align: center;
  font-weight: 600;
}

.entry-main,
.danger-copy {
  flex: 1;
  min-width: 0;
}

.library-danger {
  background: #faf5ea;
  border-color: rgba(154, 95, 85, 0.36);
}

.library-danger.is-envelope {
  background: rgba(154, 95, 85, 0.08);
}

.library-danger-button.is-disabled {
  opacity: 0.5;
}

.member-index {
  min-height: 86rpx;
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  background: #f3e8d4;
}

.member-index.is-current-device {
  background: rgba(127, 140, 120, 0.12);
}
.language-en { word-break: normal; overflow-wrap: normal; }
.language-en .library-title, .language-en .section-title, .language-en .row-title { letter-spacing: 0; }
.language-en button {
  box-sizing: border-box;
  font-size: 24rpx;
  text-align: center;
}
.language-en .identity-strip,
.language-en .nickname-strip,
.language-en .binding-save-row,
.language-en .join-code-row,
.language-en .mini-panel .family-row {
  flex-wrap: wrap;
}
.language-en .identity-strip .row-main {
  width: calc(100% - 66rpx);
  flex: none;
}
.language-en .nickname-strip .row-main,
.language-en .binding-save-row .row-main,
.language-en .join-code-row .row-main,
.language-en .mini-panel .family-row .row-main {
  width: 100%;
  flex: none;
}
.language-en .identity-strip .row-action,
.language-en .nickname-strip .row-action-wide,
.language-en .binding-save-row .row-action-wide,
.language-en .join-code-row .row-action,
.language-en .mini-panel .family-row .row-action {
  align-self: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 100%;
  height: 66rpx;
  min-height: 66rpx;
  margin: 16rpx 0 0;
  padding: 0 22rpx;
  line-height: 1.15;
  white-space: nowrap;
}
.language-en .join-panel .row-action-ghost {
  display: none;
}
.language-en .nickname-strip .row-action-wide {
  margin-top: 18rpx;
}
.language-en .library-identity-head,
.language-en .library-danger {
  align-items: stretch;
  flex-direction: column;
}
.language-en .library-identity-head .library-secondary,
.language-en .library-primary.full,
.language-en .library-danger .library-danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 100%;
  height: 66rpx;
  margin-top: 18rpx;
  line-height: 1.15;
  white-space: nowrap;
}
.language-en .library-primary.full {
  margin-top: 24rpx;
}
.language-en .library-stamp {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  white-space: nowrap;
}
.language-en .borrower-card .entry-title,
.language-en .student-card .row-title {
  word-break: normal;
  overflow-wrap: normal;
}

.theme-voyage.family-page {
  padding: 48rpx 28rpx 150rpx;
  overflow: visible;
  background:
    linear-gradient(180deg, #389dd0 0, #82cee8 350rpx, transparent 690rpx),
    #dff3f8;
  color: #17334b;
}

.theme-voyage .family-atmosphere {
  display: none;
}

.theme-voyage .family-hero,
.theme-voyage .glass-panel {
  border: 3rpx solid #b37c35;
  border-radius: 16rpx;
  background:
    linear-gradient(105deg, rgba(155, 102, 40, 0.06) 0 2rpx, transparent 2rpx 34rpx),
    #fff5dc;
  box-shadow: 0 9rpx 0 rgba(101, 62, 23, 0.18);
  backdrop-filter: none;
}

.theme-voyage .family-hero {
  min-height: 400rpx;
  overflow: visible;
  border-top: 12rpx solid #c84f39;
}

.theme-voyage .family-hero::before {
  top: auto;
  bottom: 24rpx;
  background: repeating-linear-gradient(90deg, #c9a365 0 16rpx, transparent 16rpx 28rpx);
}

.voyage-crew-badge {
  position: absolute;
  z-index: 3;
  top: -34rpx;
  right: 30rpx;
  width: 84rpx;
  height: 84rpx;
  border: 4rpx double #8a5a25;
  border-radius: 50%;
  background: #1f70a8;
  color: #fff5dc;
  font-size: 44rpx;
  line-height: 82rpx;
  text-align: center;
  box-shadow: 0 6rpx 0 #174f75;
}

.theme-voyage .family-map {
  height: 142rpx;
}

.theme-voyage .family-node {
  border: 4rpx double #b37c35;
  background: #1f70a8;
  box-shadow: 0 7rpx 0 #174f75;
}

.theme-voyage .node-child {
  background: #c84f39;
  box-shadow: 0 7rpx 0 #8f3528;
}

.theme-voyage .family-link {
  height: 4rpx;
  background: repeating-linear-gradient(90deg, #b37c35 0 14rpx, transparent 14rpx 24rpx);
}

.theme-voyage .product-title,
.theme-voyage .section-title,
.theme-voyage .row-title,
.theme-voyage .member-name {
  color: #17334b;
  font-family: "Songti SC", serif;
}

.theme-voyage .product-copy,
.theme-voyage .row-copy,
.theme-voyage .student-hint {
  color: #755f45;
}

.theme-voyage .relation-panel,
.theme-voyage .student-board,
.theme-voyage .join-panel,
.theme-voyage .member-card,
.theme-voyage .mini-panel {
  border-left: 10rpx solid #1f70a8;
}

.theme-voyage .binding-repair,
.theme-voyage .mini-panel {
  border-left-color: #c84f39;
}

.theme-voyage .family-row,
.theme-voyage .student-row,
.theme-voyage .member-row {
  border-bottom-color: rgba(179, 124, 53, 0.28);
}

.theme-voyage .identity-strip,
.theme-voyage .input-card,
.theme-voyage .student-card,
.theme-voyage .member-node {
  border: 2rpx solid rgba(179, 124, 53, 0.4);
  border-radius: 10rpx;
  background: #f3e2bb;
}

.theme-voyage .role-orb,
.theme-voyage .student-avatar,
.theme-voyage .member-dot {
  border-color: #b37c35;
  background: #1f70a8;
  color: #fff5dc;
}

.theme-voyage .student-card.is-current {
  border-color: #1f70a8;
  background: #e6eee1;
}

.theme-voyage .section-count,
.theme-voyage .student-current,
.theme-voyage .member-role {
  border: 1rpx solid #b37c35;
  border-radius: 7rpx;
