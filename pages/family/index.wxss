.family-hero {
  background: var(--surface);
}

.family-list {
  margin-top: 24rpx;
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.family-list .section-title,
.member-card .section-title {
  margin-bottom: 8rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-count {
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.family-row,
.member-row,
.student-row {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.family-row:last-child,
.member-row:last-child,
.student-row:last-child {
  border-bottom: none;
}

.action-row {
  align-items: flex-start;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title,
.member-name {
  color: var(--text-main);
  font-size: var(--font-section-title-size);
  font-weight: var(--font-title-weight);
}

.row-copy,
.member-copy {
  margin-top: 8rpx;
  min-height: 54rpx;
  display: flex;
  align-items: center;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.family-input {
  width: 100%;
  min-height: 54rpx;
  margin-top: 8rpx;
  color: var(--text-main);
  font-size: var(--font-body-size);
}

.row-action {
  width: 112rpx;
  height: 60rpx;
  min-width: 112rpx;
  min-height: 60rpx;
  margin: 43rpx 0 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--text-main);
  font-size: var(--font-caption-size);
  line-height: 60rpx;
  font-weight: var(--font-title-weight);
  display: flex;
  align-items: center;
  justify-content: center;
}

.row-action::after {
  border: none;
}

.row-action-ghost {
  background: transparent;
  color: transparent;
}

.row-action-wide {
  width: 128rpx;
  min-width: 128rpx;
}

.row-action-warn {
  background: var(--danger-soft);
  color: var(--danger);
}

.row-action.is-disabled {
  opacity: 0.5;
}

.member-card {
  margin-top: 24rpx;
}

.member-row.is-current-device {
  background: var(--surface-subtle);
}

.student-row.is-current {
  background: var(--surface-subtle);
}

.student-current {
  flex-shrink: 0;
  min-width: 84rpx;
  text-align: right;
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.student-hint {
  padding: 18rpx 0 10rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.5;
}

.member-role {
  flex-shrink: 0;
  align-self: center;
  color: var(--text-muted);
  text-align: right;
}

.sync-debug {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  font-size: var(--font-caption-size);
  line-height: 1.5;
  background: var(--surface-glass);
  color: var(--text-muted);
}

.sync-debug.is-cloud {
  background: var(--growth-soft);
  color: var(--growth-deep);
}

.sync-debug.is-local {
  background: var(--accent-soft);
  color: var(--accent-deep);
}
