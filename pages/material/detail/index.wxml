<view class="theme-{{theme}} language-{{language}} page-shell library-detail-page" wx:if="{{theme === 'library'}}">
  <view class="library-debug-note" wx:if="{{debugLines.length}}">
    <view class="library-debug-line" wx:for="{{debugLines}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="library-listening-desk">
    <view class="library-desk-head">
      <view class="library-desk-copy">
        <view class="library-eyebrow">{{texts.title}}</view>
        <view class="library-detail-title">{{item.title}}</view>
        <view class="library-muted">{{item.year}} · {{item.district}} · {{item.examType}}</view>
        <view class="library-audio-state">{{audioLocked ? texts.learnFirst : (audioError ? texts.audioUnavailable : texts.audio)}}</view>
      </view>
      <view class="library-time-chip">{{audioCurrentText}} / {{audioDurationText}}</view>
    </view>

    <view class="library-lock-tip" wx:if="{{audioLocked}}">{{texts.lockTip}}</view>
    <view class="library-turntable {{isPlaying ? 'is-playing' : ''}} {{audioLoading || !audioSrc ? 'is-disabled' : ''}}" wx:else>
      <view class="library-vinyl-stage">
        <view class="library-needle"></view>
        <view class="library-play-ring"></view>
        <view class="library-play-button {{audioLoading || !audioSrc ? 'is-disabled' : ''}}" hover-class="is-pressed" hover-start-time="20" hover-stay-time="180" bindtap="toggleAudio">
          {{isPlaying ? texts.pause : (audioEnded ? texts.replay : texts.play)}}
        </view>
      </view>
      <slider
        class="library-audio-slider"
        min="0"
        max="{{audioSliderMax}}"
        value="{{audioProgress}}"
        activeColor="#B89562"
        backgroundColor="rgba(250,245,234,.22)"
        block-color="#F3E8D4"
        block-size="16"
        disabled="{{audioLoading || !audioSrc}}"
        bindchanging="changingAudioProgress"
        bindchange="changeAudioProgress"
      />
      <view class="library-audio-controls">
        <view class="library-audio-step {{audioLoading || !audioSrc ? 'is-disabled' : ''}}" data-delta="-15" hover-class="is-pressed" hover-start-time="20" hover-stay-time="180" bindtap="seekAudio">-15{{texts.seconds}}</view>
        <view class="library-audio-step {{audioLoading || !audioSrc ? 'is-disabled' : ''}}" data-delta="15" hover-class="is-pressed" hover-start-time="20" hover-stay-time="180" bindtap="seekAudio">+15{{texts.seconds}}</view>
      </view>
    </view>
    <view class="library-audio-error" wx:if="{{audioError}}">{{audioError}}</view>
  </view>

  <view class="library-question-paper">
    <view class="library-paper-head">
      <view class="library-paper-title">{{texts.answerSheet}}</view>
      <view class="library-score" wx:if="{{submitted}}">{{correctCount}} / {{questions.length}}</view>
    </view>
    <view class="library-section-heading" wx:if="{{item.images && item.images.length}}">A. Listen and choose the right picture.</view>
    <view class="library-picture-composite" wx:if="{{item.imageDisplayMode === 'composite'}}">
      <image class="library-picture-composite-item" mode="aspectFit" src="{{item.images[0].src}}"></image>
    </view>
    <view class="library-picture-grid" wx:elif="{{item.images && item.images.length}}">
      <view class="library-picture-cell" wx:for="{{item.images}}" wx:key="cloudPath">
        <view class="library-picture-label">{{item.label}}</view>
        <image class="library-picture-item" mode="aspectFit" src="{{item.src}}"></image>
      </view>
    </view>
    <view class="library-question-row" wx:for="{{questions}}" wx:key="number">
      <view class="listening-source-pages" wx:if="{{item.sourceImages.length}}">
        <image class="listening-source-page" wx:for="{{item.sourceImages}}" wx:for-item="sourceImage" wx:key="cloudPath" src="{{sourceImage.src}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
      </view>
      <view class="library-section-heading in-list" wx:if="{{item.showSectionTitle}}">{{item.sectionTitle}}</view>
      <view class="library-listening-group-head" wx:if="{{item.showGroupTitle}}">
        <view class="library-listening-group-title">{{item.groupTitle}}</view>
        <view class="library-listening-group-instruction" wx:if="{{item.groupInstruction}}">{{item.groupInstruction}}</view>
      </view>
      <view class="library-listening-form" wx:if="{{item.showFormTitle || item.givenRows.length}}">
        <view class="library-listening-form-title" wx:if="{{item.showFormTitle}}">{{item.formTitle}}</view>
        <view class="library-listening-form-row" wx:for="{{item.givenRows}}" wx:for-item="given" wx:key="label">
          <view class="library-listening-form-label">{{given.label}}:</view>
          <view class="library-listening-form-value">{{given.value}}</view>
        </view>
      </view>
      <view class="library-question-title">{{item.number}}. {{item.prompt}}</view>
      <view class="library-option-list" wx:if="{{item.optionsList.length}}">
        <view class="library-option-row {{option.isWide ? 'is-wide' : ''}} {{option.selected ? 'is-selected' : ''}}" wx:for="{{item.optionsList}}" wx:for-item="option" wx:key="key" data-number="{{item.number}}" data-option="{{option.key}}" bindtap="selectOption">
          {{option.label}}
        </view>
      </view>
      <input wx:else class="library-answer-input" value="{{item.inputValue}}" data-number="{{item.number}}" bindinput="inputAnswer" placeholder="{{texts.answerPlaceholder}}" />
      <view class="library-answer-line" wx:if="{{submitted && item.answer}}">{{item.correct ? texts.correct : texts.correction}}: {{item.answer}}</view>
    </view>
    <view class="library-empty-line" wx:if="{{!questions.length}}">{{texts.noQuestions}}</view>
  </view>

  <button class="library-submit-button" wx:if="{{!submitted}}" bindtap="submit">{{texts.submit}}</button>

  <view class="library-study-margin">
    <view class="library-paper-head">
      <view class="library-paper-title">{{texts.notes}}</view>
      <view class="library-mini-button {{studyLoading ? 'is-disabled' : ''}}" wx:if="{{submitted}}" bindtap="loadStudyPack">{{studyPack ? texts.refresh : texts.generate}}</view>
    </view>
    <view class="library-empty-line" wx:if="{{!submitted && answerSummary}}">{{texts.answerAvailable}}</view>
    <view class="library-empty-line" wx:elif="{{!submitted}}">{{texts.noAnswer}}</view>
    <view class="library-transcript-box" wx:elif="{{transcriptVisible && item.transcript}}">{{item.transcript}}</view>
    <view class="library-empty-line" wx:elif="{{item.transcript}}">{{texts.generateTranscript}}</view>
    <view class="library-empty-line" wx:else>{{texts.noTranscript}}</view>
    <view class="library-answer-summary" wx:if="{{submitted && answerSummary}}">
      <view class="library-summary-title">{{texts.referenceAnswer}}</view>
      <view class="library-summary-text">{{answerSummary}}</view>
    </view>
    <view class="library-study-error" wx:if="{{studyError}}">{{studyError}}</view>
    <view class="library-study-tabs" wx:if="{{submitted && studyPack}}">
      <view class="library-study-tab {{activeStudyTab === item.key ? 'is-active' : ''}}" wx:for="{{studyTabs}}" wx:key="key" data-tab="{{item.key}}" bindtap="selectStudyTab">{{item.label}}</view>
    </view>
    <view class="library-study-list" wx:if="{{submitted && studyPack && activeStudyTab === 'vocabulary'}}">
      <view class="library-study-item" wx:for="{{vocabularyCards}}" wx:key="word">
        <view class="library-study-head">
          <view class="library-study-title">{{item.word}}</view>
          <button class="library-mini-button library-study-add" data-type="word" data-text="{{item.word}}" bindtap="addStudyCardToLibrary">{{studyDictionaryAddedMap[item.flashcardKey] || studyDictionaryAddedMap[item.word] ? texts.added : texts.add}}</button>
        </view>
        <view class="library-study-meaning">{{item.meaning}}</view>
        <view class="library-study-example" wx:if="{{item.example}}">{{item.example}}</view>
        <view class="library-study-example" wx:if="{{item.exampleMeaning}}">{{item.exampleMeaning}}</view>
      </view>
    </view>
    <view class="library-study-list" wx:elif="{{submitted && studyPack && activeStudyTab === 'phrases'}}">
      <view class="library-study-item" wx:for="{{phraseCards}}" wx:key="text">
        <view class="library-study-head">
          <view class="library-study-title">{{item.text}}</view>
          <button class="library-mini-button library-study-add" data-type="phrase" data-text="{{item.text}}" bindtap="addStudyCardToLibrary">{{studyDictionaryAddedMap[item.flashcardKey] || studyDictionaryAddedMap[item.text] ? texts.added : texts.add}}</button>
        </view>
        <view class="library-study-meaning">{{item.meaning}}</view>
        <view class="library-study-example" wx:if="{{item.example}}">{{item.example}}</view>
      </view>
    </view>
    <view class="library-study-list" wx:elif="{{submitted && studyPack}}">
      <view class="library-study-item" wx:for="{{sentencePatternCards}}" wx:key="pattern">
        <view class="library-study-head">
          <view class="library-study-title">{{item.pattern}}</view>
          <button class="library-mini-button library-study-add" data-type="pattern" data-text="{{item.pattern}}" bindtap="addStudyCardToLibrary">{{studyDictionaryAddedMap[item.flashcardKey] || studyDictionaryAddedMap[item.pattern] ? texts.added : texts.add}}</button>
        </view>
        <view class="library-study-meaning">{{item.meaning}}</view>
        <view class="library-study-example" wx:if="{{item.example}}">{{item.example}}</view>
        <view class="library-study-example" wx:if="{{item.exampleMeaning}}">{{item.exampleMeaning}}</view>
      </view>
    </view>
    <view class="library-study-complete" wx:if="{{submitted && studyPack && !studyCompleted}}" bindtap="completeStudy">{{texts.finishStudy}}</view>
    <view class="library-study-done" wx:if="{{submitted && studyCompleted}}">{{texts.studyDone}}</view>
  </view>
</view>

<view class="theme-{{theme}} language-{{language}} page-shell listening-detail-page" wx:else>
  <view class="detail-debug" wx:if="{{debugLines.length}}">
    <view class="detail-debug-line" wx:for="{{debugLines}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="audio-card card">
    <view class="audio-head">
      <view class="audio-copy">
        <view class="detail-eyebrow">{{texts.title}}</view>
        <view class="detail-title">{{item.title}}</view>
        <view class="detail-copy">{{item.year}} · {{item.district}} · {{item.examType}}</view>
        <view class="audio-title">{{audioLocked ? texts.learnFirst : texts.audio}}</view>
        <view class="audio-subtitle">{{audioLocked ? texts.studyAfter : (audioError ? texts.audioUnavailable : (isPlaying ? texts.playing : texts.audioControls))}}</view>
      </view>
      <view class="audio-time">{{audioCurrentText}} / {{audioDurationText}}</view>
    </view>
    <view class="audio-lock-tip" wx:if="{{audioLocked}}">{{texts.lockTip}}</view>
    <view class="audio-player {{audioLoading || !audioSrc ? 'is-disabled' : ''}}" wx:else>
      <view class="audio-stage">
        <view class="audio-orbit">
          <view class="audio-main {{audioLoading || !audioSrc ? 'is-disabled' : ''}}" hover-class="is-pressed" hover-start-time="20" hover-stay-time="180" bindtap="toggleAudio">
            {{audioLoading ? texts.loading : (isPlaying ? texts.pause : (audioEnded ? texts.replay : texts.play))}}
          </view>
        </view>
        <view class="audio-bars">
          <view class="{{isPlaying ? 'is-active' : ''}}"></view>
          <view class="{{isPlaying ? 'is-active' : ''}}"></view>
          <view class="{{isPlaying ? 'is-active' : ''}}"></view>
          <view class="{{isPlaying ? 'is-active' : ''}}"></view>
          <view class="{{isPlaying ? 'is-active' : ''}}"></view>
          <view class="{{isPlaying ? 'is-active' : ''}}"></view>
        </view>
      </view>
      <slider
        class="audio-slider"
        min="0"
        max="{{audioSliderMax}}"
        value="{{audioProgress}}"
        activeColor="{{themeSlider.activeColor}}"
        backgroundColor="{{themeSlider.backgroundColor}}"
        block-color="{{themeSlider.blockColor}}"
        block-size="16"
        disabled="{{audioLoading || !audioSrc}}"
        bindchanging="changingAudioProgress"
        bindchange="changeAudioProgress"
      />
      <view class="audio-controls">
        <view class="audio-step {{audioLoading || !audioSrc ? 'is-disabled' : ''}}" data-delta="-15" hover-class="is-pressed" hover-start-time="20" hover-stay-time="180" bindtap="seekAudio">-15{{texts.seconds}}</view>
        <view class="audio-step {{audioLoading || !audioSrc ? 'is-disabled' : ''}}" data-delta="15" hover-class="is-pressed" hover-start-time="20" hover-stay-time="180" bindtap="seekAudio">+15{{texts.seconds}}</view>
      </view>
    </view>
    <view class="audio-error" wx:if="{{audioError}}">{{audioError}}</view>
  </view>

  <view class="question-card paper-drawer card">
    <view class="question-top">
      <view class="question-label">{{texts.answerArea}}</view>
      <view class="question-state" wx:if="{{submitted}}">{{correctCount}} / {{questions.length}}</view>
    </view>
    <view class="section-heading" wx:if="{{item.images && item.images.length}}">A. Listen and choose the right picture.</view>
    <view class="picture-composite" wx:if="{{item.imageDisplayMode === 'composite'}}">
      <image class="picture-composite-item" mode="aspectFit" src="{{item.images[0].src}}"></image>
    </view>
    <view class="picture-grid" wx:elif="{{item.images && item.images.length}}">
      <view class="picture-cell" wx:for="{{item.images}}" wx:key="cloudPath">
        <view class="picture-label">{{item.label}}</view>
        <image class="picture-item" mode="aspectFit" src="{{item.src}}"></image>
      </view>
    </view>
    <view class="question-row" wx:for="{{questions}}" wx:key="number">
      <view class="listening-source-pages" wx:if="{{item.sourceImages.length}}">
        <image class="listening-source-page" wx:for="{{item.sourceImages}}" wx:for-item="sourceImage" wx:key="cloudPath" src="{{sourceImage.src}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
      </view>
      <view class="section-heading in-list" wx:if="{{item.showSectionTitle}}">{{item.sectionTitle}}</view>
      <view class="listening-group-head" wx:if="{{item.showGroupTitle}}">
        <view class="listening-group-title">{{item.groupTitle}}</view>
        <view class="listening-group-instruction" wx:if="{{item.groupInstruction}}">{{item.groupInstruction}}</view>
      </view>
      <view class="listening-form" wx:if="{{item.showFormTitle || item.givenRows.length}}">
        <view class="listening-form-title" wx:if="{{item.showFormTitle}}">{{item.formTitle}}</view>
        <view class="listening-form-row" wx:for="{{item.givenRows}}" wx:for-item="given" wx:key="label">
          <view class="listening-form-label">{{given.label}}:</view>
          <view class="listening-form-value">{{given.value}}</view>
        </view>
      </view>
      <view class="question-title">{{item.number}}. {{item.prompt}}</view>
      <view class="option-list" wx:if="{{item.optionsList.length}}">
        <view class="option-row {{option.isWide ? 'is-wide' : ''}} {{option.selected ? 'is-selected' : ''}}" wx:for="{{item.optionsList}}" wx:for-item="option" wx:key="key" data-number="{{item.number}}" data-option="{{option.key}}" bindtap="selectOption">
          {{option.label}}
        </view>
      </view>
      <input wx:else class="answer-input" value="{{item.inputValue}}" data-number="{{item.number}}" bindinput="inputAnswer" placeholder="{{texts.answerPlaceholder}}" />
      <view class="answer-line" wx:if="{{submitted && item.answer}}">{{item.correct ? texts.correct : texts.correction}}: {{item.answer}}</view>
    </view>
  </view>

  <button class="button-primary submit-button" bindtap="submit">{{texts.submit}}</button>

  <view class="study-card floating-study-card card">
    <view class="question-top">
      <view class="question-label">{{texts.textStudy}}</view>
      <view class="mini-button {{studyLoading ? 'is-disabled' : ''}}" wx:if="{{submitted}}" bindtap="loadStudyPack">{{studyPack ? texts.refresh : texts.generate}}</view>
    </view>
    <view class="empty-line" wx:if="{{!submitted && answerSummary}}">{{texts.answerAvailable}}</view>
    <view class="empty-line" wx:elif="{{!submitted}}">{{texts.noAnswer}}</view>
    <view class="transcript-box" wx:elif="{{transcriptVisible && item.transcript}}">{{item.transcript}}</view>
    <view class="empty-line" wx:elif="{{item.transcript}}">{{texts.generateTranscript}}</view>
    <view class="empty-line" wx:else>{{texts.noTranscript}}</view>
    <view class="answer-summary-box" wx:if="{{submitted && answerSummary}}">
      <view class="answer-summary-title">{{texts.referenceAnswer}}</view>
      <view class="answer-summary-text">{{answerSummary}}</view>
    </view>
    <view class="study-error" wx:if="{{studyError}}">{{studyError}}</view>
    <view class="study-tabs" wx:if="{{submitted && studyPack}}">
      <view class="study-tab {{activeStudyTab === item.key ? 'is-active' : ''}}" wx:for="{{studyTabs}}" wx:key="key" data-tab="{{item.key}}" bindtap="selectStudyTab">{{item.label}}</view>
    </view>
    <view class="study-list" wx:if="{{submitted && studyPack && activeStudyTab === 'vocabulary'}}">
      <view class="study-item" wx:for="{{vocabularyCards}}" wx:key="word">
        <view class="study-item-head">
          <view class="study-title">{{item.word}}</view>
          <button class="mini-button study-add" data-type="word" data-text="{{item.word}}" bindtap="addStudyCardToLibrary">{{studyDictionaryAddedMap[item.flashcardKey] || studyDictionaryAddedMap[item.word] ? texts.added : texts.add}}</button>
        </view>
        <view class="study-meaning">{{item.meaning}}</view>
        <view class="study-example" wx:if="{{item.example}}">{{item.example}}</view>
        <view class="study-example-meaning" wx:if="{{item.exampleMeaning}}">{{item.exampleMeaning}}</view>
      </view>
    </view>
    <view class="study-list" wx:elif="{{submitted && studyPack && activeStudyTab === 'phrases'}}">
      <view class="study-item" wx:for="{{phraseCards}}" wx:key="text">
        <view class="study-item-head">
          <view class="study-title">{{item.text}}</view>
          <button class="mini-button study-add" data-type="phrase" data-text="{{item.text}}" bindtap="addStudyCardToLibrary">{{studyDictionaryAddedMap[item.flashcardKey] || studyDictionaryAddedMap[item.text] ? texts.added : texts.add}}</button>
        </view>
        <view class="study-meaning">{{item.meaning}}</view>
        <view class="study-example" wx:if="{{item.example}}">{{item.example}}</view>
      </view>
    </view>
    <view class="study-list" wx:elif="{{submitted && studyPack}}">
      <view class="study-item" wx:for="{{sentencePatternCards}}" wx:key="pattern">
        <view class="study-item-head">
          <view class="study-title">{{item.pattern}}</view>
          <button class="mini-button study-add" data-type="pattern" data-text="{{item.pattern}}" bindtap="addStudyCardToLibrary">{{studyDictionaryAddedMap[item.flashcardKey] || studyDictionaryAddedMap[item.pattern] ? texts.added : texts.add}}</button>
        </view>
        <view class="study-meaning">{{item.meaning}}</view>
        <view class="study-example" wx:if="{{item.example}}">{{item.example}}</view>
        <view class="study-example-meaning" wx:if="{{item.exampleMeaning}}">{{item.exampleMeaning}}</view>
      </view>
    </view>
    <view class="study-complete-button" wx:if="{{submitted && studyPack && !studyCompleted}}" bindtap="completeStudy">{{texts.finishStudy}}</view>
    <view class="study-done" wx:if="{{submitted && studyCompleted}}">{{texts.studyDone}}</view>
  </view>
</view>
