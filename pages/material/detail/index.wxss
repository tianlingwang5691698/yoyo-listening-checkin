  align-items: center;
  justify-content: center;
  font-size: var(--font-control-size);
  font-weight: 600;
}

.library-submit-button::after,
.library-mini-button::after {
  border: none;
}

.library-mini-button {
  margin: 0;
  min-width: 112rpx;
  min-height: 54rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.42);
  border-radius: 6px;
  background: #faf5ea;
  color: #14283a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.library-mini-button.is-disabled {
  opacity: 0.45;
}

.library-transcript-box,
.library-answer-summary,
.library-study-item {
  margin-top: 16rpx;
  padding: 18rpx;
  border-left: 4rpx solid #b89562;
  background: rgba(250, 245, 234, 0.74);
  color: #14283a;
  font-size: var(--font-body-size);
  line-height: 1.6;
  word-break: break-word;
}

.library-transcript-box {
  max-height: 260rpx;
  overflow: auto;
}

.library-summary-title,
.library-study-title {
  color: #14283a;
  font-size: var(--font-body-size);
  font-weight: 600;
  line-height: 1.35;
  word-break: break-word;
}

.library-summary-text {
  margin-top: 8rpx;
  color: #6f675f;
  font-size: var(--font-caption-size);
  line-height: 1.55;
  word-break: break-word;
}

.library-study-error,
.library-empty-line {
  margin-top: 14rpx;
}

.library-study-error {
  color: #9a5f55;
}

.library-study-tabs {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.library-study-tab {
  min-width: 0;
  min-height: 58rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.36);
  border-radius: 6px 6px 0 0;
