.listening-detail-page {
  padding-top: 72rpx;
  padding-bottom: 72rpx;
}

.detail-hero,
.audio-card,
.study-card,
.question-card {
  padding: 30rpx 28rpx;
}

.audio-card,
.study-card,
.question-card {
  margin-top: 24rpx;
}

.detail-debug {
  margin-top: 20rpx;
  padding: 18rpx;
  border: 1rpx dashed rgba(144, 91, 45, 0.35);
  border-radius: var(--radius-md);
  background: rgba(255, 250, 242, 0.92);
}

.detail-debug-line {
  color: var(--accent-deep);
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.detail-eyebrow,
.detail-copy,
.question-label,
.question-state,
.empty-line,
.study-error,
.audio-lock-tip,
.study-done,
.audio-error {
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.detail-title {
  margin-top: 10rpx;
  color: var(--text-strong);
  font-size: var(--font-page-title-size);
  line-height: 1.2;
  font-weight: var(--font-title-weight);
}

.detail-copy {
  margin-top: 12rpx;
}

.audio-title {
  color: var(--text-strong);
  font-size: var(--font-card-title-size);
  font-weight: var(--font-title-weight);
}

.audio-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.audio-copy {
  min-width: 0;
}

.audio-subtitle,
.audio-time {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.25;
}

.audio-time {
  margin-top: 0;
  flex: 0 0 auto;
  color: var(--accent-deep);
  font-weight: var(--font-title-weight);
}

.audio-player {
  margin-top: 20rpx;
}

.audio-slider {
  margin: 0 -6rpx;
}

.audio-controls {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: 124rpx 180rpx 124rpx;
  gap: 22rpx;
  align-items: center;
  justify-content: center;
}

.audio-step,
.audio-main {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
  line-height: 1;
  transition: background-color 120ms ease, color 120ms ease, transform 120ms ease, box-shadow 120ms ease;
}

.audio-step {
  background: var(--accent-soft);
  color: var(--accent-deep);
  box-shadow: 0 6rpx 12rpx rgba(154, 96, 36, 0.06);
}

.audio-main {
  background: var(--accent-deep);
  color: #fff;
  font-size: var(--font-body-size);
  box-shadow: 0 10rpx 20rpx rgba(154, 96, 36, 0.18);
}

.audio-step.is-pressed,
.audio-main.is-pressed {
  transform: translateY(1rpx) scale(0.992);
}

.audio-step.is-pressed {
  background: #ead8c4;
  box-shadow: inset 0 3rpx 8rpx rgba(154, 96, 36, 0.12);
}

.audio-main.is-pressed {
  background: #8f5b25;
  box-shadow: inset 0 3rpx 8rpx rgba(68, 38, 14, 0.18);
}

.audio-player.is-disabled,
.audio-step.is-disabled,
.audio-main.is-disabled {
  opacity: 0.42;
}

.audio-lock-tip {
  margin-top: 12rpx;
}

.mini-button {
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  min-height: 56rpx;
  border-radius: var(--radius-pill);
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.mini-button.is-disabled {
  opacity: 0.45;
}

.transcript-box {
  margin-top: 18rpx;
  max-height: 240rpx;
  padding: 20rpx;
  border-radius: var(--radius-md);
  background: var(--surface-subtle);
  color: var(--text-main);
  font-size: var(--font-body-size);
  line-height: 1.55;
  overflow: auto;
}

.empty-line,
.study-error {
  margin-top: 14rpx;
}

.answer-summary-box {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: var(--radius-md);
  background: var(--surface-subtle);
}

.answer-summary-title {
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.answer-summary-text {
  margin-top: 8rpx;
  color: var(--text-main);
  font-size: var(--font-caption-size);
  line-height: 1.55;
  word-break: break-word;
}

.study-tabs {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.study-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  border-radius: var(--radius-md);
  background: var(--surface-subtle);
  color: var(--text-main);
  font-size: var(--font-caption-size);
}

.study-tab.is-active {
  background: var(--accent-deep);
  color: #fff;
}

.study-complete-button {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  border-radius: var(--radius-pill);
  background: var(--accent-deep);
  color: #fff;
  font-size: var(--font-body-size);
}

.study-done {
  margin-top: 16rpx;
  color: var(--accent-deep);
}

.study-list {
  margin-top: 16rpx;
}

.study-item {
  margin-top: 12rpx;
  padding: 18rpx;
  border-radius: var(--radius-md);
  background: var(--surface-subtle);
}

.study-item-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.study-title {
  color: var(--text-strong);
  font-size: var(--font-body-size);
  font-weight: var(--font-title-weight);
  min-width: 0;
  word-break: break-word;
}

.study-add {
  flex: 0 0 auto;
  min-width: 104rpx;
  min-height: 50rpx;
  font-size: 22rpx;
}

.study-meaning,
.study-example,
.study-example-meaning {
  margin-top: 8rpx;
  color: var(--text-main);
  font-size: var(--font-caption-size);
  line-height: 1.45;
}

.study-example,
.study-example-meaning {
  color: var(--text-muted);
}

.question-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.question-row {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: var(--radius-lg);
  background: var(--surface-subtle);
  min-width: 0;
  overflow: hidden;
}

.picture-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.picture-composite {
  margin-top: 18rpx;
  width: 100%;
  border-radius: var(--radius-md);
  background: var(--surface-subtle);
  overflow: hidden;
}

.picture-composite-item {
  width: 100%;
  height: 420rpx;
  display: block;
}

.section-heading {
  margin-top: 20rpx;
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  line-height: 1.35;
  font-weight: var(--font-title-weight);
}

.section-heading.in-list {
  margin-top: 0;
  margin-bottom: 14rpx;
}

.picture-cell {
  min-width: 0;
  border-radius: var(--radius-md);
  background: var(--surface-subtle);
  overflow: hidden;
  padding-top: 10rpx;
}

.picture-item {
  width: 100%;
  height: 220rpx;
  display: block;
}

.picture-label {
  margin-left: 12rpx;
  margin-bottom: 6rpx;
  min-width: 34rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  background: rgba(255, 255, 255, 0.92);
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  line-height: 34rpx;
  text-align: center;
  font-weight: var(--font-title-weight);
}

.question-title {
  color: var(--text-strong);
  font-size: var(--font-body-size);
  line-height: 1.4;
  font-weight: var(--font-title-weight);
  word-break: break-word;
  overflow-wrap: anywhere;
}

.option-list {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  min-width: 0;
}

.option-row {
  margin: 0;
  width: 100%;
  min-width: 0;
  min-height: 68rpx;
  padding: 14rpx 16rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background: var(--surface-raised);
  color: var(--text-main);
  font-size: var(--font-body-size);
  line-height: 1.35;
  text-align: left;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
  overflow: hidden;
}

.option-row.is-selected {
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.option-row.is-wide {
  grid-column: 1 / -1;
}

.answer-input {
  margin-top: 14rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  border-radius: var(--radius-md);
  background: var(--surface-raised);
  color: var(--text-main);
  font-size: var(--font-body-size);
}

.answer-line {
  margin-top: 12rpx;
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.submit-button {
  margin-top: 24rpx;
}
