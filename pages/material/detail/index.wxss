  background: rgba(250, 245, 234, 0.68);
  overflow: hidden;
}

.library-picture-label {
  margin-left: 12rpx;
  margin-bottom: 6rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #14283a;
  color: #f3e8d4;
  font-size: var(--font-caption-size);
  line-height: 34rpx;
  text-align: center;
  font-weight: 600;
}

.library-picture-item {
  width: 100%;
  height: 220rpx;
  display: block;
}

.library-question-row {
  margin-top: 18rpx;
  padding: 20rpx;
  border-left: 4rpx solid rgba(184, 149, 98, 0.72);
  background: rgba(250, 245, 234, 0.7);
  min-width: 0;
  overflow: hidden;
}

.library-question-title {
  color: #14283a;
  font-size: var(--font-body-size);
  line-height: 1.42;
  font-weight: 600;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.library-option-list {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.library-option-row {
  min-width: 0;
  min-height: 68rpx;
  padding: 14rpx 16rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(184, 149, 98, 0.24);
  border-radius: 4px;
  background: #faf5ea;
  color: #6f675f;
  font-size: var(--font-body-size);
  line-height: 1.35;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.library-option-row.is-selected {
  border-left: 6rpx solid #14283a;
  background: rgba(184, 149, 98, 0.18);
  color: #14283a;
}

.library-option-row.is-wide {
  grid-column: 1 / -1;
}

.library-answer-input {
  margin-top: 14rpx;
  min-height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.28);
  border-radius: 4px;
  background: #faf5ea;
  color: #14283a;
  font-size: var(--font-body-size);
}

.library-answer-line {
  margin-top: 12rpx;
  color: #7f8c78;
