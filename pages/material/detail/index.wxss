  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
}

.library-study-tab.is-active {
  background: #14283a;
  color: #faf5ea;
  border-color: #14283a;
}

.library-study-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.library-study-add {
  flex: 0 0 auto;
  min-width: 96rpx;
  min-height: 48rpx;
}

.library-study-complete {
  margin-top: 18rpx;
  min-height: 72rpx;
  border-radius: 8px;
  background: #14283a;
  color: #faf5ea;
