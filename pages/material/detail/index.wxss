  align-items: center;
  justify-content: center;
  font-size: var(--font-body-size);
  font-weight: 600;
}

.library-study-done {
  margin-top: 16rpx;
  color: #7f8c78;
  font-size: var(--font-caption-size);
  font-weight: 600;
}
.language-en button,
