}

.library-picture-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.library-picture-composite {
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(184, 149, 98, 0.24);
  border-radius: 6px;
