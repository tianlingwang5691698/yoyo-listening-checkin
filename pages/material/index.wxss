.material-page {
  padding-top: 72rpx;
}

.material-hero {
  padding: 38rpx 34rpx;
  background: var(--surface-raised);
}

.material-eyebrow {
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.material-title {
  margin-top: 12rpx;
  color: var(--text-strong);
  font-size: var(--font-page-title-size);
  line-height: var(--line-title);
  font-weight: var(--font-title-weight);
}

.material-copy {
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: var(--font-body-size);
  line-height: var(--line-body);
  max-width: 560rpx;
}

.material-card {
  margin-top: 26rpx;
  padding: 32rpx 28rpx;
}

.material-debug {
  margin-top: 20rpx;
  padding: 18rpx;
  border: 1rpx dashed rgba(144, 91, 45, 0.35);
  border-radius: var(--radius-md);
  background: rgba(255, 250, 242, 0.92);
}

.material-debug-line {
  color: var(--accent-deep);
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.material-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.material-card-label,
.material-card-state {
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.directory-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.directory-row {
  min-height: 116rpx;
  padding: 24rpx;
  border: 1rpx solid var(--border-soft);
  border-radius: var(--radius-lg);
  background: linear-gradient(180deg, var(--surface), var(--surface-subtle));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.directory-title {
  color: var(--text-strong);
  font-size: var(--font-card-title-size);
  line-height: 1.25;
  font-weight: var(--font-title-weight);
}

.directory-meta {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.35;
}

.directory-arrow {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: 38rpx;
  line-height: 1;
}

.directory-back-icon {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  line-height: 1.4;
  font-weight: var(--font-title-weight);
}

.task-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-row {
  min-height: 112rpx;
  padding: 22rpx;
  border: 1rpx solid var(--border-soft);
  border-radius: var(--radius-lg);
  background: linear-gradient(180deg, var(--surface), var(--surface-subtle));
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.task-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-title {
  color: var(--text-strong);
  font-size: var(--font-section-title-size);
  font-weight: var(--font-title-weight);
  line-height: var(--line-section);
}

.task-meta {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.35;
}

.task-state {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.material-detail {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: var(--radius-md);
  background: var(--surface-raised);
  color: var(--text-main);
  font-size: var(--font-body-size);
  line-height: 1.55;
  word-break: normal;
  overflow-wrap: break-word;
}

.empty-state {
  margin-top: 24rpx;
}
