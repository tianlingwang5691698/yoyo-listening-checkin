.material-page {
  padding-top: 72rpx;
  padding-bottom: 72rpx;
  background: linear-gradient(180deg, #f6fbfd 0%, #edf6fa 100%);
}

.material-hero {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 28rpx;
  padding: 42rpx 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(191, 215, 232, 0.42));
  box-shadow: 0 18rpx 42rpx rgba(88, 128, 153, 0.12);
}

.material-hero-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
  flex: 1;
}

.material-eyebrow {
  color: #607087;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.material-title {
  margin-top: 14rpx;
  color: #17314f;
  font-size: 46rpx;
  line-height: 1.16;
  font-weight: 600;
}

.material-copy {
  margin-top: 14rpx;
  color: #607087;
  font-size: var(--font-body-size);
  line-height: var(--line-body);
  max-width: 520rpx;
}

.material-wave {
  flex: 0 0 142rpx;
  min-height: 148rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.42);
}

.material-wave-bar {
  width: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #8db7d4, #86aaa1);
}

.material-wave-bar.is-one,
.material-wave-bar.is-five {
  height: 54rpx;
  opacity: 0.58;
}

.material-wave-bar.is-two,
.material-wave-bar.is-four {
  height: 92rpx;
  opacity: 0.78;
}

.material-wave-bar.is-three {
  height: 122rpx;
}

.material-paper-mark {
  position: relative;
  flex: 0 0 142rpx;
  min-height: 148rpx;
  border-radius: 34rpx;
  background:
    repeating-linear-gradient(180deg, transparent 0, transparent 30rpx, rgba(141, 183, 212, 0.2) 31rpx, transparent 32rpx),
    linear-gradient(180deg, rgba(255, 255, 255, 0.62), rgba(246, 251, 253, 0.72));
  overflow: hidden;
}

.paper-corner {
  position: absolute;
  right: 0;
  top: 0;
  width: 46rpx;
  height: 46rpx;
  background: linear-gradient(135deg, rgba(191, 215, 232, 0) 49%, rgba(141, 183, 212, 0.32) 50%, rgba(255, 255, 255, 0.86) 78%);
  border-bottom-left-radius: 12rpx;
}

.paper-line {
  position: absolute;
  left: 28rpx;
  right: 24rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.48);
}

.line-one { top: 52rpx; }
.line-two { top: 78rpx; right: 42rpx; }
.line-three { top: 104rpx; right: 56rpx; }

.pencil-stroke {
  position: absolute;
  left: 32rpx;
  bottom: 24rpx;
  width: 78rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(223, 128, 104, 0.66), rgba(134, 170, 161, 0.48));
  transform: rotate(-8deg);
}

.material-card {
  margin-top: 26rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  background: rgba(255, 255, 255, 0.68);
  box-shadow: 0 16rpx 36rpx rgba(88, 128, 153, 0.09);
}

.writing-history-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 6rpx;
  margin-top: 20rpx;
  padding: 6rpx;
  border: 1rpx solid rgba(141, 183, 212, 0.22);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.62);
}

.writing-history-tab {
  min-width: 0;
  padding: 16rpx 10rpx;
  border-radius: 9rpx;
  color: #607087;
  font-size: 25rpx;
  line-height: 1.2;
  text-align: center;
}

.writing-history-tab.is-active {
  background: #17314f;
  color: #fff;
  font-weight: 600;
}

.writing-history-tabs.is-library {
  margin-top: 0;
  border-color: rgba(184, 149, 98, 0.36);
  border-radius: 6rpx;
  background: rgba(255, 253, 247, 0.76);
}

.writing-history-tabs.is-library .writing-history-tab {
  border-radius: 3rpx;
  color: var(--library-writing-muted);
}

.writing-history-tabs.is-library .writing-history-tab.is-active {
  background: var(--library-writing-ink);
  color: #fffdf7;
}

.material-channel-card {
  padding-right: 0;
}

.material-debug {
  margin-top: 20rpx;
  padding: 18rpx;
  border: 1rpx dashed rgba(141, 183, 212, 0.48);
  border-radius: var(--radius-md);
  background: rgba(246, 251, 253, 0.86);
}

.material-debug-line {
  color: #607087;
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.material-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.material-card-label,
.material-card-state {
  color: #607087;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.material-entry-skeleton {
  display: flex;
  gap: 18rpx;
  width: 100%;
}

.material-skeleton-tile {
  width: 300rpx;
  height: 112rpx;
  border-radius: var(--radius-lg);
  background: var(--surface-soft);
  opacity: 0.72;
}

.material-skeleton-tile.is-short {
  width: 220rpx;
  opacity: 0.48;
}

.material-card-state {
  color: #17314f;
}

.directory-shelf,
.drawer-stack {
  margin-top: 22rpx;
  display: grid;
  gap: 14rpx;
}

.channel-rail {
  width: 100%;
  margin-top: 24rpx;
  white-space: nowrap;
}

.channel-rail .directory-row {
  display: inline-flex;
  vertical-align: top;
  white-space: normal;
}

.directory-row {
  position: relative;
  min-height: 120rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(191, 215, 232, 0.62);
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(237, 246, 250, 0.8));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.channel-tile {
  width: 360rpx;
  min-height: 192rpx;
  margin-right: 18rpx;
  align-items: flex-start;
  flex-direction: column;
}

.channel-tile .directory-arrow {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
}

.stage-list {
  width: 100%;
  margin-top: 24rpx;
  display: grid;
  gap: 14rpx;
}

.stage-row {
  width: 100%;
  min-height: 112rpx;
  box-sizing: border-box;
}

.stage-row:nth-child(3n + 1) {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(191, 215, 232, 0.72));
}

.stage-row:nth-child(3n + 2) {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.92), rgba(134, 170, 161, 0.22));
}

.stage-row:nth-child(3n) {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.92), rgba(242, 161, 142, 0.18));
}

.drawer-card {
  padding-bottom: 36rpx;
}

.drawer-row {
  min-height: 136rpx;
  box-shadow: 0 10rpx 24rpx rgba(88, 128, 153, 0.07);
}

.drawer-row:nth-child(2n) {
  transform: translateX(14rpx);
}

.drawer-row:nth-child(3n) {
  transform: translateX(28rpx);
}

.directory-row::after {
  content: "";
  position: absolute;
  left: 94rpx;
  right: 62rpx;
  bottom: 22rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(141, 183, 212, 0), rgba(141, 183, 212, 0.42), rgba(141, 183, 212, 0));
}

.directory-orb {
  flex: 0 0 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #eaf3f8, #ffffff);
  color: #607087;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.88);
}

.directory-main {
  flex: 1;
  min-width: 0;
}

.directory-title {
  color: #17314f;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 600;
}

.directory-meta {
  margin-top: 8rpx;
  color: #728196;
  font-size: var(--font-caption-size);
  line-height: 1.35;
}

.directory-arrow {
  flex-shrink: 0;
  color: #8db7d4;
  font-size: 38rpx;
  line-height: 1;
}

.directory-back-icon {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(191, 215, 232, 0.32);
  color: #17314f;
  font-size: var(--font-caption-size);
  line-height: 1.4;
  font-weight: 600;
}

.task-list {
  margin-top: 22rpx;
  display: grid;
  gap: 14rpx;
}

.program-stack {
  margin-top: 24rpx;
  display: grid;
  gap: 18rpx;
}

.task-row {
  min-height: 116rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(191, 215, 232, 0.62);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.78);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.program-drawer {
  position: relative;
  min-height: 148rpx;
  padding: 26rpx 22rpx 26rpx 24rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(237, 246, 250, 0.84));
  box-shadow: 0 12rpx 28rpx rgba(88, 128, 153, 0.08);
}

.program-drawer::before {
  content: "";
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: -8rpx;
  height: 14rpx;
  border-radius: 999rpx 999rpx 0 0;
  background: rgba(191, 215, 232, 0.28);
}

.task-wave {
  flex: 0 0 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: rgba(191, 215, 232, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
}

.task-wave view {
  width: 6rpx;
  border-radius: 999rpx;
  background: #8db7d4;
}

.task-wave view:nth-child(1) {
  height: 18rpx;
}

.task-wave view:nth-child(2) {
  height: 30rpx;
}

.task-wave view:nth-child(3) {
  height: 22rpx;
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-title {
  color: #17314f;
  font-size: var(--font-section-title-size);
  font-weight: 600;
  line-height: var(--line-section);
}

.task-meta {
  margin-top: 8rpx;
  color: #728196;
  font-size: var(--font-caption-size);
  line-height: 1.35;
}

.task-state {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(242, 161, 142, 0.18);
  color: #df7f68;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.material-detail {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: var(--radius-md);
  background: rgba(246, 251, 253, 0.9);
  color: #17314f;
  font-size: var(--font-body-size);
  line-height: 1.55;
  word-break: normal;
  overflow-wrap: break-word;
}

.empty-state {
  margin-top: 24rpx;
  color: #728196;
  font-size: var(--font-body-size);
}

.library-material-page {
  min-height: 100vh;
  padding-top: 72rpx;
  padding-bottom: 72rpx;
  background:
    linear-gradient(180deg, rgba(43, 33, 27, 0.08) 0, rgba(43, 33, 27, 0) 160rpx),
    repeating-linear-gradient(90deg, rgba(43, 33, 27, 0.035) 0, rgba(43, 33, 27, 0.035) 2rpx, transparent 2rpx, transparent 34rpx),
    #faf5ea;
}

.library-catalog-hero {
  position: relative;
  overflow: hidden;
  padding: 38rpx 34rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.38);
  border-radius: 8px;
  background:
    linear-gradient(90deg, rgba(43, 33, 27, 0.08) 0, rgba(43, 33, 27, 0) 26rpx),
    linear-gradient(180deg, #f3e8d4, #faf5ea);
  box-shadow: 0 6rpx 18rpx rgba(43, 33, 27, 0.12);
}

.library-hero-copy {
  position: relative;
  z-index: 1;
  padding-right: 118rpx;
}

.library-eyebrow,
.library-copy,
.library-row-meta,
.library-empty-text,
.library-spine-meta,
.library-book-label {
  color: #6f675f;
  font-size: var(--font-caption-size);
  line-height: 1.45;
}

.library-title {
  margin-top: 12rpx;
  color: #14283a;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.15;
}

.library-copy {
  margin-top: 12rpx;
}

.library-sound-bookmark {
  position: absolute;
  top: 0;
  right: 34rpx;
  width: 72rpx;
  height: 176rpx;
  border-radius: 0 0 8px 8px;
  background: #14283a;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  box-shadow: inset 0 -6rpx 0 rgba(184, 149, 98, 0.72);
}

.library-sound-bookmark view {
  width: 6rpx;
  border-radius: 999rpx;
  background: #b89562;
}

.library-sound-bookmark view:nth-child(1) { height: 34rpx; }
.library-sound-bookmark view:nth-child(2) { height: 62rpx; }
.library-sound-bookmark view:nth-child(3) { height: 46rpx; }

.library-listening-debug-note {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-left: 6rpx solid #9a5f55;
  border-radius: 6px;
  background: rgba(243, 232, 212, 0.82);
}

.library-listening-debug-line {
  color: #6f675f;
  font-size: var(--font-caption-size);
  line-height: 1.45;
  word-break: break-all;
}

.library-course-spine {
  margin-top: 24rpx;
  min-height: 132rpx;
  padding: 24rpx 26rpx;
  border-radius: 8px;
  background:
    linear-gradient(90deg, rgba(184, 149, 98, 0.32) 0, rgba(184, 149, 98, 0.32) 12rpx, transparent 12rpx),
    #14283a;
  color: #faf5ea;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(43, 33, 27, 0.16);
}

.library-spine-mark {
  flex: 0 0 92rpx;
  min-height: 72rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.7);
  color: #b89562;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.library-spine-main,
.library-row-main {
  flex: 1;
  min-width: 0;
}

.library-spine-title {
  color: #faf5ea;
  font-size: var(--font-section-title-size);
  font-weight: 600;
  line-height: 1.25;
}

.library-spine-arrow,
.library-row-arrow {
  flex-shrink: 0;
  color: #b89562;
  font-size: 40rpx;
  line-height: 1;
}

.library-index-book {
  margin-top: 24rpx;
  padding: 28rpx 24rpx 30rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.42);
  border-radius: 8px;
  background:
    repeating-linear-gradient(180deg, rgba(184, 149, 98, 0) 0, rgba(184, 149, 98, 0) 58rpx, rgba(184, 149, 98, 0.12) 59rpx, rgba(184, 149, 98, 0) 60rpx),
    #f3e8d4;
  box-shadow: 0 6rpx 18rpx rgba(43, 33, 27, 0.12);
}

.library-book-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid rgba(184, 149, 98, 0.42);
}

.library-book-title {
  margin-top: 6rpx;
  color: #14283a;
  font-family: Georgia, "Times New Roman", serif;
  font-size: var(--font-card-title-size);
  font-weight: 600;
  line-height: 1.2;
}

.library-book-count,
.library-practice-tag {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.52);
  border-radius: 4px;
  color: #14283a;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.library-back {
  color: #6f675f;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.library-index-list,
.library-skeleton {
  margin-top: 20rpx;
  display: grid;
  gap: 12rpx;
}

.library-index-row,
.library-set-row {
  position: relative;
  min-height: 104rpx;
  padding: 20rpx 18rpx;
  border-bottom: 1rpx solid rgba(184, 149, 98, 0.24);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.library-row-no {
  flex: 0 0 52rpx;
  height: 52rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.58);
  border-radius: 4px;
  color: #b89562;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.library-row-title {
  color: #14283a;
  font-size: var(--font-section-title-size);
  font-weight: 600;
  line-height: 1.28;
  word-break: break-word;
}

.library-row-meta {
  margin-top: 8rpx;
}

.library-set-needle {
  flex: 0 0 52rpx;
  height: 52rpx;
  border-left: 4rpx solid #b89562;
  border-bottom: 4rpx solid #b89562;
  transform: rotate(-22deg);
}

.library-set-detail {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-left: 4rpx solid #b89562;
  background: rgba(250, 245, 234, 0.78);
  color: #6f675f;
  font-size: var(--font-caption-size);
  line-height: 1.5;
  word-break: break-word;
}

.library-skeleton-line {
  height: 74rpx;
  border-radius: 4px;
  background: rgba(250, 245, 234, 0.62);
}

.library-empty-text {
  padding: 20rpx 6rpx 4rpx;
}

.material-library-writing {
  --library-writing-bg: #FAF5EA;
  --library-writing-wood: #2B211B;
  --library-writing-ink: #14283A;
  --library-writing-paper: #F3E8D4;
  --library-writing-paper-soft: #FFFDF7;
  --library-writing-brass: #B89562;
  --library-writing-moss: #7F8C78;
  --library-writing-muted: #6F675F;
  --library-writing-error: #9B5F54;
  --library-writing-border: rgba(184, 149, 98, 0.42);
  box-sizing: border-box;
  min-height: 100vh;
  padding: 40rpx var(--space-page-x) 72rpx;
  background:
    linear-gradient(180deg, rgba(43, 33, 27, 0.08), rgba(250, 245, 234, 0) 220rpx),
    var(--library-writing-bg);
  color: var(--library-writing-ink);
}

.library-writing-head {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 22rpx;
  padding: 22rpx 0 30rpx;
}

.library-writing-head-copy {
  min-width: 0;
  flex: 1;
}

.library-writing-eyebrow {
  color: var(--library-writing-muted);
  font-size: var(--font-caption-size);
  line-height: var(--line-caption);
  font-weight: 600;
}

.library-writing-title {
  margin-top: 10rpx;
  color: var(--library-writing-ink);
  font-family: Songti SC, STSong, serif;
  font-size: 46rpx;
  line-height: 1.18;
  font-weight: 600;
}

.library-writing-copy {
  margin-top: 12rpx;
  color: var(--library-writing-muted);
  font-size: var(--font-body-size);
  line-height: var(--line-body);
}

.library-writing-index-card {
  position: relative;
  flex: 0 0 148rpx;
  min-height: 154rpx;
  padding: 28rpx 18rpx 18rpx;
  border: 1rpx solid var(--library-writing-border);
  border-radius: 6rpx;
  background:
    repeating-linear-gradient(180deg, transparent 0, transparent 28rpx, rgba(20, 40, 58, 0.12) 29rpx, transparent 30rpx),
    var(--library-writing-paper-soft);
  box-shadow: 0 6rpx 16rpx rgba(43, 33, 27, 0.12);
}

.library-index-clip {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  width: 38rpx;
  height: 14rpx;
  border: 2rpx solid var(--library-writing-brass);
  border-left: 0;
  border-radius: 0 999rpx 999rpx 0;
}

.library-index-line {
  height: 4rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  background: rgba(20, 40, 58, 0.22);
}

.library-index-line.is-long {
  width: 88rpx;
}

.library-index-stamp,
.library-proof-stamp {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(155, 95, 84, 0.5);
  color: var(--library-writing-error);
  font-size: 22rpx;
  line-height: 1;
  font-weight: 600;
}

.library-index-stamp {
  position: absolute;
  right: 14rpx;
  bottom: 16rpx;
  width: 58rpx;
  height: 42rpx;
  transform: rotate(-6deg);
}

.library-cabinet {
  margin-top: 18rpx;
  padding: 28rpx 22rpx 30rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.34);
  border-radius: 6rpx;
  background:
    linear-gradient(180deg, rgba(255, 253, 247, 0.86), rgba(243, 232, 212, 0.9)),
    var(--library-writing-paper);
  box-shadow: 0 8rpx 18rpx rgba(43, 33, 27, 0.12);
}

.library-cabinet-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  color: var(--library-writing-muted);
  font-size: var(--font-caption-size);
  line-height: var(--line-caption);
  font-weight: 600;
}

.library-drawer-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.library-stage-drawer {
  position: relative;
  min-height: 176rpx;
  padding: 26rpx 22rpx 24rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.4);
  border-radius: 6rpx;
  background:
    linear-gradient(180deg, rgba(73, 54, 42, 0.08), rgba(43, 33, 27, 0.02)),
    #ead9bb;
  box-shadow: inset 0 -8rpx 0 rgba(43, 33, 27, 0.08);
}

.library-stage-drawer:active,
.library-exam-folder:active,
.library-district-tab:active,
.library-manuscript-row:active {
  transform: translateY(1rpx);
}

.library-drawer-plate {
  display: inline-flex;
  min-width: 110rpx;
  min-height: 44rpx;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.62);
  border-radius: 4rpx;
  background: rgba(255, 253, 247, 0.76);
  color: var(--library-writing-ink);
  font-family: Songti SC, STSong, serif;
  font-size: 30rpx;
  font-weight: 600;
}

.library-drawer-count {
  margin-top: 18rpx;
  color: var(--library-writing-muted);
  font-size: var(--font-caption-size);
}

.library-drawer-handle {
  position: absolute;
  left: 50%;
  bottom: 22rpx;
  width: 82rpx;
  height: 18rpx;
  border: 3rpx solid var(--library-writing-brass);
  border-top: 0;
  border-radius: 0 0 999rpx 999rpx;
  transform: translateX(-50%);
}

.library-back-tab {
  flex-shrink: 0;
  min-height: 44rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.46);
  border-radius: 4rpx;
  background: rgba(255, 253, 247, 0.72);
  color: var(--library-writing-ink);
}

.library-folder-row,
.library-district-tabs,
.library-manuscript-list {
  margin-top: 24rpx;
  display: grid;
  gap: 16rpx;
}

.library-folder-row {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.library-exam-folder {
  min-height: 150rpx;
  padding: 24rpx 20rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.36);
  border-radius: 6rpx 6rpx 4rpx 4rpx;
  background:
    linear-gradient(90deg, rgba(184, 149, 98, 0.28) 0, rgba(184, 149, 98, 0.28) 16rpx, transparent 16rpx),
    #fff8e9;
}

.library-folder-spine {
  color: var(--library-writing-ink);
  font-family: Songti SC, STSong, serif;
  font-size: 32rpx;
  font-weight: 600;
}

.library-folder-count,
.library-district-count,
.library-manuscript-meta {
  margin-top: 8rpx;
  color: var(--library-writing-muted);
  font-size: var(--font-caption-size);
  line-height: var(--line-caption);
}

.library-district-tab {
  min-height: 96rpx;
  padding: 20rpx 22rpx 18rpx 28rpx;
  border-left: 8rpx solid rgba(184, 149, 98, 0.62);
  border-radius: 4rpx;
  background: rgba(255, 253, 247, 0.82);
  box-shadow: 0 4rpx 10rpx rgba(43, 33, 27, 0.06);
}

.library-district-tab:nth-child(2n) {
  transform: translateX(10rpx);
}

.library-district-name {
  color: var(--library-writing-ink);
  font-size: var(--font-section-title-size);
  line-height: var(--line-section);
  font-weight: 600;
}

.library-manuscript-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 120rpx;
  padding: 22rpx 18rpx 22rpx 24rpx;
  border-bottom: 1rpx solid rgba(184, 149, 98, 0.24);
  background:
    repeating-linear-gradient(180deg, transparent 0, transparent 44rpx, rgba(20, 40, 58, 0.08) 45rpx, transparent 46rpx),
    rgba(255, 253, 247, 0.72);
}

.library-manuscript-main {
  flex: 1;
  min-width: 0;
}

.library-manuscript-title {
  color: var(--library-writing-ink);
  font-size: var(--font-section-title-size);
  line-height: var(--line-section);
  font-weight: 600;
  word-break: break-word;
}

.library-manuscript-prompt {
  margin-top: 14rpx;
  color: var(--library-writing-muted);
  font-size: var(--font-body-size);
  line-height: var(--line-body);
  white-space: pre-wrap;
  word-break: break-word;
}

.library-proof-stamp {
  flex: 0 0 66rpx;
  height: 46rpx;
  transform: rotate(-5deg);
}

.library-empty-slip {
  margin-top: 24rpx;
  padding: 26rpx 24rpx;
  border: 1rpx dashed rgba(184, 149, 98, 0.44);
  border-radius: 6rpx;
  background: rgba(255, 253, 247, 0.7);
  color: var(--library-writing-muted);
  font-size: var(--font-body-size);
}

.library-writing-debug {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx dashed rgba(155, 95, 84, 0.48);
  border-radius: 6rpx;
  background: rgba(255, 253, 247, 0.84);
  color: var(--library-writing-error);
}

.library-debug-title {
  margin-bottom: 8rpx;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.library-debug-line {
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}
.language-en button,
.language-en view,
.language-en text { overflow-wrap: normal; word-break: normal; }
.language-en .library-book-title,
.language-en .material-title { font-size: 42rpx; line-height: 1.15; }

/* Voyage catalogue: expedition chart and mission drawers. */
.theme-voyage.material-page {
  padding-top: 56rpx;
  padding-bottom: 96rpx;
  background:
    linear-gradient(180deg, rgba(70, 184, 228, 0.96) 0, rgba(225, 244, 239, 0.92) 300rpx, transparent 301rpx),
    repeating-linear-gradient(14deg, rgba(97, 68, 32, 0.025) 0 2rpx, transparent 2rpx 25rpx),
    #f3e3be;
}

.theme-voyage .material-hero {
  min-height: 238rpx;
  padding: 38rpx 38rpx 34rpx;
  overflow: visible;
  border: 4rpx solid #996333;
  border-radius: 8rpx;
  background:
    radial-gradient(circle at 84% 20%, rgba(39, 126, 159, 0.13), transparent 32%),
    repeating-linear-gradient(0deg, rgba(91, 61, 31, 0.026) 0 2rpx, transparent 2rpx 15rpx),
    linear-gradient(100deg, #e8cb8e, #fff2ca 9%, #f6e5b6 88%, #d6b474);
  box-shadow: 0 18rpx 34rpx rgba(7, 87, 117, 0.24), inset 0 0 26rpx rgba(108, 70, 31, 0.12);
}

.theme-voyage .material-hero::before,
.theme-voyage .material-hero::after {
  content: "";
  position: absolute;
  z-index: 2;
  top: -13rpx;
  bottom: -13rpx;
  width: 27rpx;
  border: 4rpx solid #70411f;
  border-radius: 18rpx;
  background: repeating-linear-gradient(90deg, #8b4f27 0 7rpx, #c27b3d 8rpx 14rpx);
}

.theme-voyage .material-hero::before { left: -15rpx; }
.theme-voyage .material-hero::after { right: -15rpx; }

.theme-voyage .material-eyebrow,
.theme-voyage .material-copy { color: #6d573c; }

.theme-voyage .material-title {
  color: #14384f;
  font-family: "Songti SC", "STSong", serif;
  font-size: 50rpx;
  font-weight: 800;
}

.theme-voyage .material-wave,
.theme-voyage .material-paper-mark {
  flex-basis: 154rpx;
  min-height: 154rpx;
  border: 7rpx solid #b68235;
  border-radius: 50%;
  background: radial-gradient(circle, #fff4cf 0 60%, #e4bd69 61% 68%, #176a99 69%);
  box-shadow: inset 0 0 0 4rpx rgba(255, 250, 224, 0.72), 0 8rpx 0 rgba(106, 62, 26, 0.24);
}

.theme-voyage .material-wave-bar { width: 9rpx; background: #176a99; }

.theme-voyage .material-card {
  margin-top: 28rpx;
  padding: 26rpx 24rpx;
  border: 3rpx solid rgba(142, 94, 43, 0.5);
  border-radius: 8rpx;
  background:
    repeating-linear-gradient(0deg, rgba(91, 61, 31, 0.025) 0 2rpx, transparent 2rpx 15rpx),
    #f8e9c2;
  box-shadow: 0 12rpx 24rpx rgba(40, 78, 83, 0.14);
}

.theme-voyage .material-card-label,
.theme-voyage .material-card-state { color: #684a2d; }

.theme-voyage .directory-row,
.theme-voyage .drawer-row,
.theme-voyage .task-row {
  border: 3rpx solid rgba(151, 100, 44, 0.46);
  border-radius: 7rpx;
  background:
    linear-gradient(90deg, rgba(28, 103, 149, 0.12) 0 13rpx, transparent 13rpx),
    rgba(255, 247, 219, 0.92);
  box-shadow: 0 6rpx 0 rgba(102, 63, 28, 0.2);
}

.theme-voyage .directory-row::after { background: #c49338; }

.theme-voyage .directory-orb,
.theme-voyage .directory-back-icon {
  border: 5rpx solid #c49338;
  background: #176a99;
  color: #fff7dd;
  box-shadow: inset 0 0 0 3rpx rgba(255, 247, 218, 0.38);
}

.theme-voyage .directory-title,
.theme-voyage .task-title {
  color: #173b50;
  font-family: "Songti SC", "STSong", serif;
  font-weight: 800;
}

.theme-voyage .directory-meta,
.theme-voyage .task-meta,
.theme-voyage .material-detail { color: #705b42; }

.theme-voyage .directory-arrow,
.theme-voyage .task-state { color: #a34432; font-weight: 800; }

.theme-voyage .task-wave view { background: #1d719d; }

.theme-voyage .writing-history-tabs {
  border: 3rpx solid #9a6635;
  border-radius: 7rpx;
  background: #ead09a;
  box-shadow: 0 7rpx 0 rgba(104, 62, 26, 0.2);
}

.theme-voyage .writing-history-tab { color: #68492c; }
.theme-voyage .writing-history-tab.is-active { border-radius: 5rpx; background: #176a99; color: #fff8e7; }

.theme-voyage .material-debug {
  border-color: #a93e33;
  background: #f8ded2;
  color: #8e3029;
}

/* Dragon theme: training archive and mission drawers. */
.theme-dragon.material-page {
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  padding: 54rpx 28rpx 100rpx;
  box-sizing: border-box;
  overflow-x: hidden;
  background:
    linear-gradient(180deg, rgba(94, 185, 236, 0.34), transparent 270rpx),
    repeating-linear-gradient(135deg, rgba(16, 46, 98, 0.018) 0 3rpx, transparent 3rpx 28rpx),
    #fff7dc;
}

.theme-dragon .material-hero {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  padding: 34rpx 30rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 5rpx solid #102e62;
  border-bottom: 12rpx solid #f45a16;
  border-radius: 8rpx;
  background: #ffd83d;
  box-shadow: 0 9rpx 0 rgba(16, 46, 98, 0.2);
}

.theme-dragon .material-title {
  min-width: 0;
  color: #102e62;
  font-weight: 800;
  overflow-wrap: normal;
  word-break: normal;
}

.theme-dragon .material-eyebrow,
.theme-dragon .material-copy {
  color: #5f6372;
}

.theme-dragon .material-wave,
.theme-dragon .material-paper-mark {
  flex-basis: 136rpx;
  min-width: 136rpx;
  min-height: 136rpx;
  border: 5rpx solid #102e62;
  border-radius: 50%;
  background: #ff9e19;
  box-shadow: inset 0 0 0 5rpx #ffd83d;
}

.theme-dragon .material-wave-bar {
  width: 9rpx;
  border-radius: 2rpx;
  background: #102e62;
}

.theme-dragon .material-paper-mark::after {
  content: "★";
  position: absolute;
  inset: 0;
  color: #c92e18;
  font-size: 48rpx;
  line-height: 136rpx;
  text-align: center;
}

.theme-dragon .material-paper-mark > view {
  display: none;
}

.theme-dragon .material-card,
.theme-dragon .drawer-card,
.theme-dragon .program-card {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
  border: 4rpx solid #102e62;
  border-radius: 8rpx;
  background: #fffdf1;
  box-shadow: 0 8rpx 0 rgba(16, 46, 98, 0.16);
}

.theme-dragon .material-channel-card {
  padding-right: 24rpx;
}

.theme-dragon .writing-history-tabs {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  border: 3rpx solid #102e62;
  border-radius: 7rpx;
  background: #fff4c7;
}

.theme-dragon .writing-history-tab {
  color: #102e62;
  font-weight: 700;
}

.theme-dragon .writing-history-tab.is-active {
  border-radius: 5rpx;
  background: #f45a16;
  color: #ffffff;
  box-shadow: inset 0 -5rpx 0 #a92e0a;
}

.theme-dragon .directory-shelf,
.theme-dragon .drawer-stack,
.theme-dragon .task-list,
.theme-dragon .program-stack {
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

.theme-dragon .directory-row,
.theme-dragon .drawer-row,
.theme-dragon .task-row {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
  transform: none;
  border: 4rpx solid #102e62;
  border-radius: 8rpx;
  background: #fffef7;
  box-shadow: 0 7rpx 0 rgba(16, 46, 98, 0.15);
}

.theme-dragon .directory-row::after {
  background: linear-gradient(90deg, transparent, rgba(244, 90, 22, 0.5), transparent);
}

.theme-dragon .directory-orb,
.theme-dragon .directory-back-icon {
  border: 4rpx solid #102e62;
  border-radius: 50%;
  background: #ffd83d;
  color: #102e62;
  box-shadow: inset 0 0 0 3rpx rgba(255, 255, 255, 0.42);
  font-weight: 800;
}

.theme-dragon .directory-back-icon {
  border-radius: 7rpx;
}

.theme-dragon .directory-title,
.theme-dragon .task-title,
.theme-dragon .program-title {
  min-width: 0;
  color: #102e62;
  font-weight: 800;
  overflow-wrap: normal;
  word-break: normal;
}

.theme-dragon .directory-meta,
.theme-dragon .task-meta,
.theme-dragon .material-detail,
.theme-dragon .program-meta {
  min-width: 0;
  color: #676b78;
  overflow-wrap: normal;
  word-break: normal;
}

.theme-dragon .directory-arrow,
.theme-dragon .task-state {
  color: #f45a16;
  font-weight: 800;
}

.theme-dragon .task-wave view {
  background: #f45a16;
}

.theme-dragon .channel-rail {
  width: 100%;
  max-width: 100%;
}

.theme-dragon .channel-tile {
  width: 360rpx;
  max-width: calc(100vw - 112rpx);
}

.theme-dragon .stage-row {
  border-radius: 7rpx;
  border: 3rpx solid #102e62;
  box-shadow: 0 7rpx 0 rgba(16, 46, 98, 0.14);
}

.theme-dragon .material-debug {
  max-width: 100%;
  box-sizing: border-box;
  border-color: #f45a16;
  background: #fff0c0;
  color: #8b3214;
}

@media (max-width: 360px) {
  .theme-dragon .material-hero {
    gap: 18rpx;
  }

  .theme-dragon .material-wave,
  .theme-dragon .material-paper-mark {
    flex-basis: 96rpx;
    min-width: 96rpx;
    min-height: 96rpx;
  }

  .theme-dragon .material-paper-mark::after {
    font-size: 38rpx;
    line-height: 96rpx;
  }
}
