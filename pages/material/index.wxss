.material-page {
  padding-top: 72rpx;
  padding-bottom: 72rpx;
  background: linear-gradient(180deg, #f6fbfd 0%, #edf6fa 100%);
}

.material-hero {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 28rpx;
  padding: 42rpx 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(191, 215, 232, 0.42));
  box-shadow: 0 18rpx 42rpx rgba(88, 128, 153, 0.12);
}

.material-hero-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
  flex: 1;
}

.material-eyebrow {
  color: #607087;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.material-title {
  margin-top: 14rpx;
  color: #17314f;
  font-size: 46rpx;
  line-height: 1.16;
  font-weight: 600;
}

.material-copy {
  margin-top: 14rpx;
  color: #607087;
  font-size: var(--font-body-size);
  line-height: var(--line-body);
  max-width: 520rpx;
}

.material-wave {
  flex: 0 0 142rpx;
  min-height: 148rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.42);
}

.material-wave-bar {
  width: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #8db7d4, #86aaa1);
}

.material-wave-bar.is-one,
.material-wave-bar.is-five {
  height: 54rpx;
  opacity: 0.58;
}

.material-wave-bar.is-two,
.material-wave-bar.is-four {
  height: 92rpx;
  opacity: 0.78;
}

.material-wave-bar.is-three {
  height: 122rpx;
}

.material-paper-mark {
  position: relative;
  flex: 0 0 142rpx;
  min-height: 148rpx;
  border-radius: 34rpx;
  background:
    repeating-linear-gradient(180deg, transparent 0, transparent 30rpx, rgba(141, 183, 212, 0.2) 31rpx, transparent 32rpx),
    linear-gradient(180deg, rgba(255, 255, 255, 0.62), rgba(246, 251, 253, 0.72));
  overflow: hidden;
}

.paper-corner {
  position: absolute;
  right: 0;
  top: 0;
  width: 46rpx;
  height: 46rpx;
  background: linear-gradient(135deg, rgba(191, 215, 232, 0) 49%, rgba(141, 183, 212, 0.32) 50%, rgba(255, 255, 255, 0.86) 78%);
  border-bottom-left-radius: 12rpx;
}

.paper-line {
  position: absolute;
  left: 28rpx;
  right: 24rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: rgba(141, 183, 212, 0.48);
}

.line-one { top: 52rpx; }
.line-two { top: 78rpx; right: 42rpx; }
.line-three { top: 104rpx; right: 56rpx; }

.pencil-stroke {
  position: absolute;
  left: 32rpx;
  bottom: 24rpx;
  width: 78rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(223, 128, 104, 0.66), rgba(134, 170, 161, 0.48));
  transform: rotate(-8deg);
}

.material-card {
  margin-top: 26rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  background: rgba(255, 255, 255, 0.68);
  box-shadow: 0 16rpx 36rpx rgba(88, 128, 153, 0.09);
}

.material-channel-card {
  padding-right: 0;
}

.material-debug {
  margin-top: 20rpx;
  padding: 18rpx;
  border: 1rpx dashed rgba(141, 183, 212, 0.48);
  border-radius: var(--radius-md);
  background: rgba(246, 251, 253, 0.86);
}

.material-debug-line {
  color: #607087;
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.material-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.material-card-label,
.material-card-state {
  color: #607087;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.material-card-state {
  color: #17314f;
}

.directory-shelf,
.drawer-stack {
  margin-top: 22rpx;
  display: grid;
  gap: 14rpx;
}

.channel-rail {
  width: 100%;
  margin-top: 24rpx;
  white-space: nowrap;
}

.channel-rail .directory-row {
  display: inline-flex;
  vertical-align: top;
  white-space: normal;
}

.directory-row {
  position: relative;
  min-height: 120rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(191, 215, 232, 0.62);
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(237, 246, 250, 0.8));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.channel-tile {
  width: 360rpx;
  min-height: 192rpx;
  margin-right: 18rpx;
  align-items: flex-start;
  flex-direction: column;
}

.channel-tile .directory-arrow {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
}

.stage-tile:nth-child(3n + 1) {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(191, 215, 232, 0.72));
}

.stage-tile:nth-child(3n + 2) {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.92), rgba(134, 170, 161, 0.22));
}

.stage-tile:nth-child(3n) {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.92), rgba(242, 161, 142, 0.18));
}

.drawer-card {
  padding-bottom: 36rpx;
}

.drawer-row {
  min-height: 136rpx;
  box-shadow: 0 10rpx 24rpx rgba(88, 128, 153, 0.07);
}

.drawer-row:nth-child(2n) {
  transform: translateX(14rpx);
}

.drawer-row:nth-child(3n) {
  transform: translateX(28rpx);
}

.directory-row::after {
  content: "";
  position: absolute;
  left: 94rpx;
  right: 62rpx;
  bottom: 22rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(141, 183, 212, 0), rgba(141, 183, 212, 0.42), rgba(141, 183, 212, 0));
}

.directory-orb {
  flex: 0 0 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #eaf3f8, #ffffff);
  color: #607087;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.88);
}

.directory-main {
  flex: 1;
  min-width: 0;
}

.directory-title {
  color: #17314f;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 600;
}

.directory-meta {
  margin-top: 8rpx;
  color: #728196;
  font-size: var(--font-caption-size);
  line-height: 1.35;
}

.directory-arrow {
  flex-shrink: 0;
  color: #8db7d4;
  font-size: 38rpx;
  line-height: 1;
}

.directory-back-icon {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(191, 215, 232, 0.32);
  color: #17314f;
  font-size: var(--font-caption-size);
  line-height: 1.4;
  font-weight: 600;
}

.task-list {
  margin-top: 22rpx;
  display: grid;
  gap: 14rpx;
}

.program-stack {
  margin-top: 24rpx;
  display: grid;
  gap: 18rpx;
}

.task-row {
  min-height: 116rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(191, 215, 232, 0.62);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.78);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.program-drawer {
  position: relative;
  min-height: 148rpx;
  padding: 26rpx 22rpx 26rpx 24rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(237, 246, 250, 0.84));
  box-shadow: 0 12rpx 28rpx rgba(88, 128, 153, 0.08);
}

.program-drawer::before {
  content: "";
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: -8rpx;
  height: 14rpx;
  border-radius: 999rpx 999rpx 0 0;
  background: rgba(191, 215, 232, 0.28);
}

.task-wave {
  flex: 0 0 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: rgba(191, 215, 232, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
}

.task-wave view {
  width: 6rpx;
  border-radius: 999rpx;
  background: #8db7d4;
}

.task-wave view:nth-child(1) {
  height: 18rpx;
}

.task-wave view:nth-child(2) {
  height: 30rpx;
}

.task-wave view:nth-child(3) {
  height: 22rpx;
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-title {
  color: #17314f;
  font-size: var(--font-section-title-size);
  font-weight: 600;
  line-height: var(--line-section);
}

.task-meta {
  margin-top: 8rpx;
  color: #728196;
  font-size: var(--font-caption-size);
  line-height: 1.35;
}

.task-state {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(242, 161, 142, 0.18);
  color: #df7f68;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.material-detail {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: var(--radius-md);
  background: rgba(246, 251, 253, 0.9);
  color: #17314f;
  font-size: var(--font-body-size);
  line-height: 1.55;
  word-break: normal;
  overflow-wrap: break-word;
}

.empty-state {
  margin-top: 24rpx;
  color: #728196;
  font-size: var(--font-body-size);
}
