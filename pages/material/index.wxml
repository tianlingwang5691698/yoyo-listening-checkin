<view class="theme-{{theme}} language-{{language}} page-shell library-material-page" wx:if="{{pageReady && theme === 'library' && moduleId === 'listening'}}">
  <view class="library-catalog-hero">
    <view class="library-hero-copy">
      <view class="library-eyebrow">{{eyebrow}}</view>
      <view class="library-title">{{title}}</view>
      <view class="library-copy">{{copy}}</view>
    </view>
    <view class="library-sound-bookmark">
      <view></view>
      <view></view>
      <view></view>
    </view>
  </view>

  <view class="library-listening-debug-note" wx:if="{{debugLines.length}}">
    <view class="library-listening-debug-line" wx:for="{{debugLines}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="library-course-spine" wx:if="{{showCefrEntry && !selectedStageId}}" bindtap="openCefrListening">
    <view class="library-spine-mark">A1-C2</view>
    <view class="library-spine-main">
      <view class="library-spine-title">{{texts.cefr}}</view>
      <view class="library-spine-meta">{{texts.audioLibrary}}</view>
    </view>
    <view class="library-spine-arrow">›</view>
  </view>

  <view class="library-index-book">
    <view class="library-book-head" wx:if="{{!selectedStageId}}">
      <view>
        <view class="library-book-label">{{showCefrEntry ? texts.examIndex : texts.stage}}</view>
        <view class="library-book-title">{{texts.catalogue}}</view>
      </view>
      <view class="library-book-count">{{stages.length}}{{texts.categoryUnit}}</view>
    </view>
    <view class="library-book-head" wx:elif="{{selectedStageId && !selectedExamId}}">
      <view>
        <view class="library-back hierarchy-back" bindtap="backToStages">{{texts.backStage}}</view>
        <view class="library-book-title">{{selectedStage.stage}}</view>
      </view>
      <view class="library-book-count">{{exams.length}}{{texts.itemUnit}}</view>
    </view>
    <view class="library-book-head" wx:elif="{{selectedExamId && !selectedDistrict}}">
      <view>
        <view class="library-back hierarchy-back" bindtap="backToExams">{{texts.backExam}}</view>
        <view class="library-book-title">{{selectedStage.stage}} · {{selectedExam.exam}}</view>
      </view>
      <view class="library-book-count">{{districts.length}}{{texts.districtUnit}}</view>
    </view>
    <view class="library-book-head" wx:else>
      <view>
        <view class="library-back hierarchy-back" bindtap="backToDistricts">{{texts.backDistrict}}</view>
        <view class="library-book-title">{{selectedExam.exam}} · {{selectedDistrict}}</view>
      </view>
      <view class="library-book-count">{{items.length}}{{texts.setUnit}}</view>
    </view>

    <view class="library-skeleton" wx:if="{{loading && !stages.length}}">
      <view class="library-skeleton-line"></view>
      <view class="library-skeleton-line"></view>
      <view class="library-skeleton-line"></view>
      <view class="library-empty-text"></view>
    </view>

    <view class="library-index-list" wx:elif="{{!selectedStageId}}">
      <view class="library-index-row" wx:for="{{stages}}" wx:key="stageId" data-stage-id="{{item.stageId}}" bindtap="selectStage">
        <view class="library-row-no">{{index + 1}}</view>
        <view class="library-row-main">
          <view class="library-row-title">{{item.stage}}</view>
          <view class="library-row-meta">{{item.contentSummary || (item.count + ' ' + itemUnit)}}</view>
        </view>
        <view class="library-row-arrow">›</view>
      </view>
      <view class="library-empty-text" wx:if="{{!stages.length}}">{{texts.empty}}</view>
    </view>

    <view class="library-index-list" wx:elif="{{selectedStageId && !selectedExamId}}">
      <view class="library-index-row" wx:for="{{exams}}" wx:key="examId" data-exam-id="{{item.examId}}" bindtap="selectExam">
        <view class="library-row-no">{{index + 1}}</view>
        <view class="library-row-main">
          <view class="library-row-title">{{item.exam}}</view>
          <view class="library-row-meta">{{item.count}} {{itemUnit}}</view>
        </view>
        <view class="library-row-arrow">›</view>
      </view>
      <view class="library-empty-text" wx:if="{{!exams.length}}">{{texts.empty}}</view>
    </view>

    <view class="library-index-list" wx:elif="{{selectedExamId && !selectedDistrict}}">
      <view class="library-index-row" wx:for="{{districts}}" wx:key="district" data-district="{{item.district}}" bindtap="selectDistrict">
        <view class="library-row-no">{{index + 1}}</view>
        <view class="library-row-main">
          <view class="library-row-title">{{item.district}}</view>
          <view class="library-row-meta">{{item.count}} {{itemUnit}}</view>
        </view>
        <view class="library-row-arrow">›</view>
      </view>
      <view class="library-empty-text" wx:if="{{!districts.length}}">{{texts.empty}}</view>
    </view>

    <view class="library-index-list" wx:else>
      <view class="library-set-row" wx:for="{{items}}" wx:key="stableId" data-item-id="{{item.materialItemId}}" bindtap="openItem">
        <view class="library-set-needle"></view>
        <view class="library-row-main">
          <view class="library-row-title">{{item.title}}</view>
          <view class="library-row-meta">{{item.year}} · {{item.district}} · {{item.examType}}</view>
          <view class="library-set-detail" wx:if="{{expandedItemId === item.materialItemId}}">
            <view>{{texts.audioReady}}</view>
            <view wx:if="{{item.transcript}}">{{texts.transcript}}{{item.transcript}}</view>
          </view>
        </view>
        <view class="library-practice-tag">{{texts.practice}}</view>
      </view>
      <view class="library-empty-text" wx:if="{{!items.length}}">{{texts.empty}}</view>
    </view>
  </view>
</view>

<view class="theme-{{theme}} language-{{language}} page-shell material-page material-library-writing" wx:if="{{pageReady && theme === 'library' && moduleId === 'writing'}}">
  <view class="library-writing-head">
    <view class="library-writing-head-copy">
      <view class="library-writing-eyebrow">{{eyebrow}}</view>
      <view class="library-writing-title">{{title}}</view>
      <view class="library-writing-copy">{{copy}}</view>
    </view>
    <view class="library-writing-index-card">
      <view class="library-index-clip"></view>
      <view class="library-index-line is-long"></view>
      <view class="library-index-line"></view>
      <view class="library-index-stamp">{{texts.manuscript}}</view>
    </view>
  </view>

  <view class="writing-history-tabs is-library">
    <view class="writing-history-tab is-active">{{texts.prompts}}</view>
    <view class="writing-history-tab" bindtap="openPracticeHistory">{{texts.history}}</view>
  </view>

  <view class="library-writing-debug" wx:if="{{debugLines.length}}">
    <view class="library-debug-title">{{texts.catalogue}}</view>
    <view class="library-debug-line" wx:for="{{debugLines}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="library-cabinet" wx:if="{{!selectedStageId}}">
    <view class="library-cabinet-label">
      <text>{{texts.writingCabinet}}</text>
      <text>{{stages.length}}{{texts.categoryUnit}}</text>
    </view>
    <view class="library-drawer-grid">
      <view class="library-stage-drawer" wx:for="{{stages}}" wx:key="stageId" data-stage-id="{{item.stageId}}" bindtap="selectStage">
        <view class="library-drawer-plate">{{item.stage}}</view>
        <view class="library-drawer-count">{{item.count}} {{itemUnit}}</view>
        <view class="library-drawer-handle"></view>
      </view>
    </view>
  </view>

  <view class="library-cabinet library-open-drawer" wx:elif="{{selectedStageId && !selectedExamId}}">
    <view class="library-cabinet-label">
      <text>{{selectedStage.stage}}</text>
      <view class="library-back-tab hierarchy-back" bindtap="backToStages">{{texts.backStage}}</view>
    </view>
    <view class="library-folder-row">
      <view class="library-exam-folder" wx:for="{{exams}}" wx:key="examId" data-exam-id="{{item.examId}}" bindtap="selectExam">
        <view class="library-folder-spine">{{item.exam}}</view>
        <view class="library-folder-count">{{item.count}} {{itemUnit}}</view>
      </view>
    </view>
    <view class="library-empty-slip" wx:if="{{!exams.length}}">{{texts.empty}}</view>
  </view>

  <view class="library-cabinet library-open-drawer" wx:elif="{{selectedExamId && !selectedDistrict}}">
    <view class="library-cabinet-label">
      <text>{{selectedStage.stage}} · {{selectedExam.exam}}</text>
      <view class="library-back-tab hierarchy-back" bindtap="backToExams">{{texts.backExam}}</view>
    </view>
    <view class="library-district-tabs">
      <view class="library-district-tab" wx:for="{{districts}}" wx:key="district" data-district="{{item.district}}" bindtap="selectDistrict">
        <view class="library-district-name">{{item.district}}</view>
        <view class="library-district-count">{{item.contentSummary || (item.count + ' ' + itemUnit)}}</view>
      </view>
    </view>
    <view class="library-empty-slip" wx:if="{{!districts.length}}">{{texts.empty}}</view>
  </view>

  <view class="library-cabinet library-folder-case" wx:else>
    <view class="library-cabinet-label">
      <text>{{selectedExam.exam}} · {{selectedDistrict}}</text>
      <view class="library-back-tab hierarchy-back" bindtap="backToDistricts">{{texts.backDistrict}}</view>
    </view>
    <view class="library-manuscript-list">
      <view class="library-manuscript-row" wx:for="{{items}}" wx:key="stableId" data-item-id="{{item.materialItemId}}" bindtap="openItem">
        <view class="library-manuscript-main">
          <view class="library-manuscript-title">{{item.displayTitle || item.title}}</view>
          <view class="library-manuscript-meta">{{item.taskSummary || (item.year + ' · ' + item.district + ' · ' + item.examType)}}</view>
          <view class="library-manuscript-prompt" wx:if="{{expandedItemId === item.materialItemId}}">{{item.prompt}}</view>
        </view>
        <view class="library-proof-stamp">{{texts.writing}}</view>
      </view>
    </view>
    <view class="library-empty-slip" wx:if="{{!items.length}}">{{texts.empty}}</view>
  </view>
</view>

<view class="theme-{{theme}} language-{{language}} page-shell material-page" wx:elif="{{pageReady && !(theme === 'library' && moduleId === 'listening')}}">
  <view class="material-hero card {{moduleId === 'writing' ? 'is-writing' : 'is-listening'}}">
    <view class="material-hero-copy">
      <view class="material-eyebrow">{{eyebrow}}</view>
      <view class="material-title">{{title}}</view>
      <view class="material-copy">{{copy}}</view>
    </view>
    <view class="material-wave" wx:if="{{moduleId !== 'writing'}}">
      <view class="material-wave-bar is-one"></view>
      <view class="material-wave-bar is-two"></view>
      <view class="material-wave-bar is-three"></view>
      <view class="material-wave-bar is-four"></view>
      <view class="material-wave-bar is-five"></view>
    </view>
    <view class="material-paper-mark" wx:else>
      <view class="paper-corner"></view>
      <view class="paper-line line-one"></view>
      <view class="paper-line line-two"></view>
      <view class="paper-line line-three"></view>
      <view class="pencil-stroke"></view>
    </view>
  </view>

  <view class="writing-history-tabs" wx:if="{{moduleId === 'writing'}}">
    <view class="writing-history-tab is-active">{{texts.prompts}}</view>
    <view class="writing-history-tab" bindtap="openPracticeHistory">{{texts.history}}</view>
  </view>

  <view class="material-card material-channel-card card" wx:if="{{showCefrEntry && !selectedStageId}}">
    <view class="material-card-top">
      <view class="material-card-label">{{texts.cefrListening}}</view>
      <view class="material-card-state">A1-C2</view>
    </view>
    <scroll-view class="channel-rail" scroll-x="{{true}}" enable-flex="{{true}}">
      <view class="directory-row channel-tile" bindtap="openCefrListening">
        <view class="directory-orb">A</view>
        <view class="directory-main">
          <view class="directory-title">{{texts.cefr}}</view>
          <view class="directory-meta">{{texts.audioLibrary}}</view>
        </view>
        <view class="directory-arrow">›</view>
      </view>
    </scroll-view>
  </view>

  <view class="material-debug" wx:if="{{debugLines.length}}">
    <view class="material-debug-line" wx:for="{{debugLines}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="material-card material-channel-card card" wx:if="{{!selectedStageId}}">
    <view class="material-card-top">
      <view class="material-card-label">{{showCefrEntry ? texts.examListening : texts.stage}}</view>
      <view class="material-card-state" wx:if="{{stages.length}}">{{stages.length}}{{texts.categoryUnit}}</view>
    </view>
    <view class="stage-list">
      <view class="directory-row stage-row" wx:for="{{stages}}" wx:key="stageId" data-stage-id="{{item.stageId}}" bindtap="selectStage">
        <view class="directory-orb">{{index + 1}}</view>
        <view class="directory-main">
          <view class="directory-title">{{item.stage}}</view>
          <view class="directory-meta">{{item.contentSummary || (item.count + ' ' + itemUnit)}}</view>
        </view>
        <view class="directory-arrow">›</view>
      </view>
      <view class="material-entry-skeleton" wx:if="{{loading && !stages.length}}">
        <view class="material-skeleton-tile"></view>
        <view class="material-skeleton-tile is-short"></view>
      </view>
    </view>
  </view>

  <view class="material-card drawer-card card" wx:elif="{{selectedStageId && !selectedExamId}}">
    <view class="material-card-top">
      <view class="material-card-label">{{selectedStage.stage}}</view>
      <view class="directory-back-icon hierarchy-back" bindtap="backToStages">{{texts.backStage}}</view>
    </view>
    <view class="drawer-stack">
      <view class="directory-row drawer-row" wx:for="{{exams}}" wx:key="examId" data-exam-id="{{item.examId}}" bindtap="selectExam">
        <view class="directory-orb">{{index + 1}}</view>
        <view class="directory-main">
          <view class="directory-title">{{item.exam}}</view>
          <view class="directory-meta">{{item.count}} {{itemUnit}}</view>
        </view>
        <view class="directory-arrow">›</view>
      </view>
    </view>
    <view class="empty-state" wx:if="{{!exams.length}}">{{texts.empty}}</view>
  </view>

  <view class="material-card drawer-card card" wx:elif="{{selectedExamId && !selectedDistrict}}">
    <view class="material-card-top">
      <view class="material-card-label">{{selectedStage.stage}} · {{selectedExam.exam}}</view>
      <view class="directory-back-icon hierarchy-back" bindtap="backToExams">{{texts.backExam}}</view>
    </view>
    <view class="drawer-stack">
      <view class="directory-row drawer-row" wx:for="{{districts}}" wx:key="district" data-district="{{item.district}}" bindtap="selectDistrict">
        <view class="directory-orb">{{index + 1}}</view>
        <view class="directory-main">
          <view class="directory-title">{{item.district}}</view>
          <view class="directory-meta">{{item.count}} {{itemUnit}}</view>
        </view>
        <view class="directory-arrow">›</view>
      </view>
    </view>
    <view class="empty-state" wx:if="{{!districts.length}}">{{texts.empty}}</view>
  </view>

  <view class="material-card program-card card" wx:else>
    <view class="material-card-top">
      <view class="material-card-label">{{selectedExam.exam}} · {{selectedDistrict}}</view>
      <view class="directory-back-icon hierarchy-back" bindtap="backToDistricts">{{texts.backDistrict}}</view>
    </view>
    <view class="program-stack">
      <view class="task-row program-drawer" wx:for="{{items}}" wx:key="stableId" data-item-id="{{item.materialItemId}}" bindtap="openItem">
        <view class="task-wave">
          <view></view>
          <view></view>
          <view></view>
        </view>
        <view class="task-main">
          <view class="task-title">{{item.displayTitle || item.title}}</view>
          <view class="task-meta">{{item.taskSummary || (item.year + ' · ' + item.district + ' · ' + item.examType)}}</view>
          <view class="material-detail" wx:if="{{expandedItemId === item.materialItemId}}">
            <view wx:if="{{moduleId === 'writing'}}">{{item.prompt}}</view>
            <view wx:else>
              <view>{{texts.audioReady}}</view>
              <view wx:if="{{item.transcript}}">{{texts.transcript}}{{item.transcript}}</view>
            </view>
          </view>
        </view>
        <view class="task-state">{{moduleId === 'listening' ? texts.practice : texts.writing}}</view>
      </view>
    </view>
  </view>
</view>
