.level-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 78% 8%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0) 30%),
    linear-gradient(160deg, #f8fbfd 0%, #edf6fa 48%, #f7fbfd 100%);
}

.level-header {
  padding: 76rpx 8rpx 30rpx;
}

.level-subtitle {
  margin-top: 14rpx;
  color: #607087;
}

.level-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.test-card {
  position: relative;
  overflow: hidden;
  margin: 0 0 28rpx;
  min-height: 136rpx;
  padding: 28rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 34rpx;
  background:
    linear-gradient(140deg, rgba(255, 255, 255, 0.86), rgba(221, 238, 248, 0.64)),
    rgba(236, 247, 251, 0.84);
  box-shadow: 0 20rpx 52rpx rgba(78, 112, 139, 0.13);
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 24rpx;
}

.audio-track-mark {
  position: absolute;
  right: 28rpx;
  bottom: 20rpx;
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  opacity: 0.26;
}

.audio-track-mark text {
  width: 8rpx;
  border-radius: 999rpx;
  background: #8db7d4;
}

.audio-track-mark text:nth-child(1) { height: 24rpx; }
.audio-track-mark text:nth-child(2) { height: 46rpx; }
.audio-track-mark text:nth-child(3) { height: 34rpx; }
.audio-track-mark text:nth-child(4) { height: 58rpx; }

.test-title {
  color: var(--text-strong);
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 600;
}

.test-copy {
  color: #607087;
  font-size: 26rpx;
  line-height: 1.45;
}

.test-action {
  color: #df8068;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 600;
  white-space: nowrap;
}

.level-tab {
  min-height: 62rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #728196;
  font-size: var(--font-caption-size);
  font-weight: var(--font-section-weight);
}

.level-tab.is-active {
  background: #17314f;
  color: #f6fbfd;
  box-shadow: 0 12rpx 26rpx rgba(23, 49, 79, 0.16);
}

.level-tab.is-disabled {
  opacity: 0.38;
}

.stage-channel {
  position: relative;
  margin-top: 0;
  border-radius: 34rpx;
  overflow: hidden;
  background: rgba(246, 251, 253, 0.7);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 42rpx rgba(78, 112, 139, 0.1);
}

.channel-rail {
  position: absolute;
  left: 48rpx;
  top: 34rpx;
  bottom: 34rpx;
  width: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(141, 183, 212, 0), rgba(141, 183, 212, 0.36), rgba(141, 183, 212, 0));
}

.loading-card {
  margin: 0 0 18rpx;
  padding: 24rpx 28rpx;
  border-radius: 30rpx;
  background: rgba(246, 251, 253, 0.72);
  color: #607087;
  font-size: var(--font-caption-size);
  font-weight: var(--font-section-weight);
}

.fixed-card {
  margin: 0 0 22rpx;
  padding: 24rpx 28rpx;
  border-radius: 30rpx;
  background:
    linear-gradient(140deg, rgba(255, 255, 255, 0.82), rgba(221, 238, 248, 0.64));
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.stage-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 28rpx 24rpx 84rpx;
  border-bottom: 1rpx solid rgba(141, 183, 212, 0.16);
}

.stage-wave {
  position: absolute;
  left: 28rpx;
  top: 50%;
  width: 38rpx;
  height: 34rpx;
  margin-top: -17rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 50%;
  background: rgba(221, 238, 248, 0.72);
}

.stage-wave text {
  width: 4rpx;
  border-radius: 999rpx;
  background: #8db7d4;
}

.stage-wave text:nth-child(1) { height: 12rpx; }
.stage-wave text:nth-child(2) { height: 22rpx; }
.stage-wave text:nth-child(3) { height: 16rpx; }

.stage-row:last-child {
  border-bottom: none;
}

.stage-row.is-active {
  background: rgba(221, 238, 248, 0.58);
}

.stage-row.is-disabled {
  opacity: 0.5;
}

.stage-row-title {
  color: #17314f;
  font-size: var(--font-control-size);
  font-weight: 600;
}

.stage-row-meta {
  margin-top: 8rpx;
}

.stage-row-state {
  flex-shrink: 0;
  min-width: 56rpx;
  color: #df8068;
  text-align: right;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.theme-library.level-page {
  --audio-bg: #FAF5EA;
  --audio-wood: #2B211B;
  --audio-ink: #14283A;
  --audio-paper: #F3E8D4;
  --audio-brass: #B89562;
  --audio-moss: #7F8C78;
  --audio-muted: #6F675F;
  --audio-error: #9A5548;
  --audio-surface: #FFFCF5;
  --audio-line: rgba(184, 149, 98, 0.44);
  min-height: 100vh;
  background:
    linear-gradient(90deg, rgba(43, 33, 27, 0.05) 1rpx, transparent 1rpx) 0 0 / 42rpx 42rpx,
    linear-gradient(180deg, #FAF5EA 0%, #F3E8D4 100%);
  color: var(--audio-ink);
}

.audio-library-head {
  position: relative;
  overflow: hidden;
  min-height: 206rpx;
  margin: 48rpx -8rpx 28rpx;
  padding: 34rpx 34rpx;
  border-radius: 16rpx;
  background:
    linear-gradient(112deg, rgba(255, 255, 255, 0.055), transparent 42%),
    repeating-linear-gradient(90deg, rgba(241, 207, 149, 0.04) 0 2rpx, transparent 2rpx 26rpx),
    linear-gradient(135deg, #493225 0%, #2b1e17 58%, #160f0c 100%);
  border: 1rpx solid rgba(184, 149, 98, 0.54);
  box-shadow: inset 0 0 0 6rpx rgba(12, 8, 6, 0.16), 0 10rpx 24rpx rgba(43, 33, 27, 0.24);
}

.audio-library-head::after {
  content: "";
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  left: 24rpx;
  height: 3rpx;
  background: linear-gradient(90deg, #8f6b3c, rgba(210, 173, 112, 0.18));
}

.audio-library-head > view:first-child {
  position: relative;
  z-index: 2;
}

.audio-library-kicker {
  color: rgba(243, 232, 212, 0.72);
  font-size: 24rpx;
  line-height: 1.3;
}

.audio-library-title {
  margin-top: 12rpx;
  color: #FAF5EA;
  font-family: STSong, "Songti SC", serif;
  font-size: 46rpx;
  line-height: 1.14;
  font-weight: 600;
}

.audio-library-subtitle {
  margin-top: 12rpx;
  color: rgba(250, 245, 234, 0.72);
  font-size: 26rpx;
  line-height: 1.45;
}

.audio-library-phonograph {
  position: absolute;
  z-index: 1;
  top: 18rpx;
  right: 18rpx;
  width: 214rpx;
  height: 174rpx;
  border: 1rpx solid rgba(210, 173, 112, 0.3);
  border-radius: 12rpx;
  background:
    linear-gradient(90deg, rgba(241, 207, 149, 0.04) 1rpx, transparent 1rpx) 0 0 / 22rpx 22rpx,
    rgba(15, 10, 8, 0.5);
  box-shadow: inset 0 0 18rpx rgba(0, 0, 0, 0.32);
}

.audio-library-vinyl {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  width: 138rpx;
  height: 138rpx;
  border: 2rpx solid #050504;
  border-radius: 50%;
  background:
    radial-gradient(circle, #c39a5f 0 10rpx, #5a3d25 11rpx 16rpx, transparent 17rpx),
    repeating-radial-gradient(circle, #090908 0 4rpx, #211e1b 5rpx 8rpx, #0b0a09 9rpx 12rpx);
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.3);
}

.audio-library-vinyl view {
  position: absolute;
  inset: 12rpx;
  border-radius: 50%;
  background: conic-gradient(from 210deg, transparent 0 12%, rgba(255, 255, 255, 0.08) 15%, transparent 20% 64%, rgba(255, 255, 255, 0.035) 68%, transparent 74%);
}

.audio-library-tonearm {
  position: absolute;
  top: 30rpx;
  right: 17rpx;
  width: 84rpx;
  height: 9rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #d0a969, #8f6b3c);
  transform: rotate(52deg);
  transform-origin: right center;
  box-shadow: 0 5rpx 10rpx rgba(0, 0, 0, 0.22);
}

.audio-library-tonearm::before {
  content: "";
  position: absolute;
  right: -7rpx;
  top: -7rpx;
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid #d0a969;
  border-radius: 50%;
  background: #2b211b;
}

.audio-library-tonearm::after {
  content: "";
  position: absolute;
  left: -10rpx;
  top: -7rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 4rpx;
  background: #e2cfad;
}

.audio-plan-ticket {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 22rpx;
  margin-bottom: 18rpx;
  padding: 28rpx;
  border: 1rpx solid var(--audio-line);
  border-radius: 16rpx;
  background:
    linear-gradient(90deg, rgba(184, 149, 98, 0.12) 1rpx, transparent 1rpx) 0 0 / 28rpx 28rpx,
    var(--audio-paper);
  box-shadow: 0 8rpx 20rpx rgba(43, 33, 27, 0.12);
}

.audio-plan-label,
.audio-spine-title,
.audio-bookmark-title {
  color: var(--audio-ink);
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 600;
}

.audio-plan-copy,
.audio-bookmark-meta,
.audio-spine-meta,
.audio-loading-note,
.audio-empty-title {
  margin-top: 8rpx;
  color: var(--audio-muted);
  font-size: 25rpx;
  line-height: 1.45;
}

.audio-plan-action,
.audio-bookmark-action,
.audio-spine-state {
  flex-shrink: 0;
  color: var(--audio-brass);
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: 700;
}

.audio-fixed-bookmark {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx 20rpx 30rpx;
  border-left: 8rpx solid var(--audio-brass);
  border-radius: 0 12rpx 12rpx 0;
  background: var(--audio-surface);
  box-shadow: 0 6rpx 16rpx rgba(43, 33, 27, 0.08);
}

.audio-index-tabs {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  margin: 0 -2rpx 20rpx;
  overflow-x: auto;
}

.audio-index-tab {
  flex: 1;
  min-width: 78rpx;
  height: 68rpx;
  padding-top: 18rpx;
  border: 1rpx solid var(--audio-line);
  border-bottom: 5rpx solid transparent;
  border-radius: 10rpx 10rpx 0 0;
  background: rgba(255, 252, 245, 0.78);
  color: var(--audio-muted);
  font-size: 24rpx;
  line-height: 1;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}

.audio-index-tab.is-active {
  background: var(--audio-ink);
  border-bottom-color: var(--audio-brass);
  color: #FAF5EA;
}

.audio-index-tab.is-disabled {
  opacity: 0.42;
}

.audio-catalog-cabinet {
  position: relative;
  overflow: hidden;
  padding: 24rpx 18rpx 18rpx;
  border: 1rpx solid rgba(43, 33, 27, 0.18);
  border-radius: 14rpx;
  background:
    linear-gradient(180deg, rgba(43, 33, 27, 0.12), transparent 26rpx),
    #3A2A20;
  box-shadow: inset 0 -10rpx 0 rgba(20, 40, 58, 0.18), 0 8rpx 20rpx rgba(43, 33, 27, 0.13);
}

.audio-catalog-error {
  margin: 0 0 16rpx;
  padding: 14rpx 18rpx;
  border-left: 4rpx solid var(--audio-error);
  background: rgba(243, 232, 212, 0.9);
  color: var(--audio-error);
  font-size: 24rpx;
  line-height: 1.45;
}

.audio-spine-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 94rpx;
  padding: 18rpx 22rpx 18rpx 28rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.28);
  border-radius: 10rpx;
  background:
    linear-gradient(90deg, rgba(184, 149, 98, 0.16), transparent 80rpx),
    var(--audio-surface);
  box-sizing: border-box;
}

.audio-spine-row + .audio-spine-row {
  margin-top: 12rpx;
}

.audio-spine-row.is-selected {
  border-color: rgba(127, 140, 120, 0.68);
}

.audio-spine-row.is-disabled {
  opacity: 0.48;
}

.audio-spine-row.is-skeleton {
  height: 84rpx;
  background: linear-gradient(90deg, rgba(243, 232, 212, 0.72), rgba(255, 252, 245, 0.86), rgba(243, 232, 212, 0.72));
}

.audio-spine-row.is-skeleton.is-short {
  width: 86%;
}

.audio-spine-mark {
  width: 10rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: var(--audio-brass);
  flex-shrink: 0;
}

.audio-spine-main {
  flex: 1;
  min-width: 0;
}

.audio-spine-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.audio-spine-row.is-selected .audio-spine-state {
  color: var(--audio-moss);
}

.audio-empty-drawer {
  min-height: 180rpx;
  padding: 42rpx 28rpx;
  border: 1rpx dashed rgba(184, 149, 98, 0.48);
  border-radius: 10rpx;
  background: rgba(243, 232, 212, 0.9);
}

/* Voyage theme: nautical chart and listening harbors. */
.theme-voyage.level-page { position: relative; min-height: 100vh; padding: 46rpx 28rpx 180rpx; overflow: hidden; background: linear-gradient(180deg, rgba(18,95,139,.96) 0 264rpx, rgba(226,202,151,.18) 265rpx), repeating-linear-gradient(11deg, rgba(103,73,38,.028) 0 2rpx, transparent 2rpx 22rpx), #f4e7c8; color: #102f43; }
.theme-voyage.level-page::before { content: ""; position: absolute; top: 214rpx; right: -100rpx; width: 360rpx; height: 210rpx; border: 4rpx dashed rgba(255,244,214,.32); border-radius: 50%; transform: rotate(-16deg); }
.voyage-level-head { position: relative; z-index: 1; min-height: 174rpx; display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; color: #fff4d6; }
.voyage-level-heading { min-width: 0; }
.voyage-level-kicker { font-size: 18rpx; line-height: 1.2; font-weight: 700; letter-spacing: 0; opacity: .72; }
.voyage-level-title { margin-top: 10rpx; font-family: "Songti SC", "STSong", serif; font-size: 52rpx; line-height: 1.15; font-weight: 800; }
.voyage-level-subtitle { max-width: 500rpx; margin-top: 10rpx; font-size: 23rpx; line-height: 1.5; opacity: .84; }
.voyage-level-compass { position: relative; flex: 0 0 94rpx; width: 94rpx; height: 94rpx; margin-top: 8rpx; border: 6rpx solid #d5a64b; border-radius: 50%; box-sizing: border-box; background: #fff4d6; box-shadow: inset 0 0 0 3rpx #8a642f, 0 10rpx 20rpx rgba(4,40,58,.24); }
.voyage-level-compass view { position: absolute; top: 18rpx; left: 40rpx; width: 7rpx; height: 48rpx; border-radius: 80% 20%; background: linear-gradient(180deg, #bf4938 0 50%, #176a99 50%); transform: rotate(34deg); }
.voyage-level-compass text { position: absolute; top: 6rpx; left: 39rpx; color: #6c4a25; font-family: Georgia, serif; font-size: 14rpx; }
.voyage-plan-chart,.voyage-fixed-route,.voyage-harbor-list { position: relative; z-index: 1; border: 3rpx solid #9b6b32; border-radius: 7rpx; background: repeating-linear-gradient(0deg, rgba(108,83,49,.025) 0 2rpx, transparent 2rpx 16rpx), #fff4d6; box-shadow: 0 12rpx 24rpx rgba(24,66,78,.15), inset 0 0 24rpx rgba(125,81,34,.08); }
.voyage-plan-chart { min-height: 156rpx; display: grid; grid-template-columns: 52rpx minmax(0,1fr) auto; align-items: center; gap: 18rpx; padding: 26rpx 24rpx; }
.voyage-plan-pin { position: relative; width: 40rpx; height: 40rpx; border: 5rpx solid #bf4938; border-radius: 50% 50% 50% 0; box-sizing: border-box; transform: rotate(-45deg); }
.voyage-plan-pin::after { content: ""; position: absolute; inset: 9rpx; border-radius: 50%; background: #d5a64b; }
.voyage-plan-main,.voyage-fixed-main,.voyage-harbor-main { min-width: 0; }
.voyage-plan-label { font-family: "Songti SC", "STSong", serif; font-size: 31rpx; line-height: 1.2; font-weight: 800; }
.voyage-plan-copy { margin-top: 9rpx; color: #6c5d49; font-size: 22rpx; line-height: 1.45; }
.voyage-plan-action { color: #176a99; font-size: 23rpx; font-weight: 700; white-space: nowrap; }
.voyage-plan-action text { margin-left: 6rpx; font-size: 32rpx; }
.voyage-fixed-route { min-height: 112rpx; display: grid; grid-template-columns: 58rpx minmax(0,1fr) auto; align-items: center; gap: 14rpx; margin-top: 20rpx; padding: 20rpx 24rpx; border-color: #318d7b; background: #e2f0e7; }
.voyage-fixed-mark { position: relative; width: 50rpx; height: 50rpx; border: 4rpx solid #318d7b; border-radius: 50%; }
.voyage-fixed-mark::before,.voyage-fixed-mark::after { content: ""; position: absolute; top: 21rpx; left: -10rpx; width: 66rpx; border-top: 3rpx solid #318d7b; }
.voyage-fixed-mark::after { transform: rotate(90deg); }
.voyage-fixed-mark view { position: absolute; inset: 17rpx; border-radius: 50%; background: #d5a64b; }
.voyage-fixed-title { font-size: 27rpx; font-weight: 700; }
.voyage-fixed-meta { margin-top: 7rpx; color: #567066; font-size: 21rpx; line-height: 1.4; }
.voyage-fixed-action { color: #236c60; font-size: 22rpx; font-weight: 700; }
.voyage-chart-tabs { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(6,minmax(0,1fr)); gap: 10rpx; margin: 28rpx 4rpx 22rpx; }
.voyage-chart-tab { min-width: 0; height: 72rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; border-bottom: 3rpx dashed rgba(23,79,109,.34); color: #174f6d; font-size: 22rpx; font-weight: 700; }
.voyage-chart-coordinate { width: 14rpx; height: 14rpx; border: 3rpx solid currentColor; border-radius: 50%; box-sizing: border-box; }
.voyage-chart-tab.is-active { border-bottom-style: solid; border-bottom-color: #b8873d; color: #a43e32; }
.voyage-chart-tab.is-active .voyage-chart-coordinate { border-color: #a43e32; background: #d5a64b; box-shadow: 0 0 0 5rpx rgba(184,135,61,.18); }
.voyage-chart-tab.is-disabled { border-bottom-color: rgba(111,98,80,.28); color: #6f6250; opacity: 1; }
.voyage-chart-tab.is-disabled .voyage-chart-coordinate { border-color: #6f6250; background: #efe0bd; }
.voyage-harbor-row.is-disabled { opacity: .4; }
.voyage-harbor-list { padding: 16rpx 20rpx 20rpx; }
.voyage-harbor-list::before { content: ""; position: absolute; top: 42rpx; bottom: 42rpx; left: 55rpx; border-left: 4rpx dashed rgba(23,106,153,.34); }
.voyage-harbor-row { position: relative; min-height: 118rpx; display: grid; grid-template-columns: 54rpx minmax(0,1fr) auto; align-items: center; gap: 16rpx; padding: 18rpx 14rpx; border-bottom: 2rpx solid rgba(137,94,43,.18); }
.voyage-harbor-row:last-child { border-bottom: 0; }
.voyage-harbor-point { z-index: 1; width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; border: 4rpx solid #176a99; border-radius: 50%; box-sizing: border-box; background: #fff4d6; }
.voyage-harbor-point view { width: 12rpx; height: 12rpx; border-radius: 50%; background: #d5a64b; }
.voyage-harbor-title { color: #102f43; font-family: "Songti SC", "STSong", serif; font-size: 28rpx; line-height: 1.35; font-weight: 700; word-break: normal; overflow-wrap: normal; }
.voyage-harbor-meta { margin-top: 7rpx; color: #6c5d49; font-size: 21rpx; line-height: 1.4; }
.voyage-harbor-state { max-width: 154rpx; color: #176a99; font-size: 21rpx; line-height: 1.35; text-align: right; }
.voyage-harbor-row.is-selected .voyage-harbor-point { border-color: #318d7b; }
.voyage-harbor-row.is-selected .voyage-harbor-point view { background: #318d7b; }
.voyage-harbor-row.is-skeleton { height: 100rpx; margin: 12rpx; border: 0; background: rgba(23,106,153,.08); }
.voyage-harbor-row.is-skeleton.is-short { width: 72%; }
.voyage-catalog-error { margin: 8rpx 8rpx 14rpx; padding: 16rpx; border-left: 6rpx solid #bf4938; background: rgba(191,73,56,.08); color: #8a342b; font-size: 22rpx; line-height: 1.45; }
