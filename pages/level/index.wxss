.level-header {
  padding: 70rpx 20rpx 28rpx;
}

.level-subtitle {
  margin-top: 10rpx;
}

.level-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin-bottom: 18rpx;
}

.test-card {
  margin: 0 0 28rpx;
  min-height: 136rpx;
  padding: 28rpx 28rpx;
  border: 3rpx solid rgba(196, 119, 17, 0.72);
  border-bottom-width: 8rpx;
  border-radius: 28rpx;
  background: rgba(255, 254, 252, 0.82);
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 24rpx;
}

.test-title {
  color: var(--text-strong);
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 800;
}

.test-copy {
  color: #8a847c;
  font-size: 26rpx;
  line-height: 1.45;
}

.test-action {
  color: #bd6a08;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 800;
  white-space: nowrap;
}

.level-tab {
  min-height: 62rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  font-weight: var(--font-section-weight);
}

.level-tab.is-active {
  background: var(--text-strong);
  color: var(--text-inverse);
}

.level-tab.is-disabled {
  opacity: 0.38;
}

.stage-list {
  margin-top: 0;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: var(--surface-glass);
}

.fixed-card {
  margin: 0 0 22rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-xl);
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.stage-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--border-soft);
}

.stage-row:last-child {
  border-bottom: none;
}

.stage-row.is-active {
  background: var(--accent-soft);
}

.stage-row.is-disabled {
  opacity: 0.5;
}

.stage-row-title {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.stage-row-meta {
  margin-top: 8rpx;
}

.stage-row-state {
  flex-shrink: 0;
  min-width: 56rpx;
  color: var(--accent-deep);
  text-align: right;
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.stage-debug {
  padding: 20rpx 28rpx 24rpx;
  color: var(--text-muted);
}
