.lesson-hero {
  position: relative;
  overflow: hidden;
  padding-bottom: 34rpx;
  box-shadow: var(--shadow-card);
}

.cover-variant-peppa,
.cover-variant-unlock,
.cover-variant-song,
.tone-peach {
  background: var(--surface);
}

.lesson-hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.lesson-title {
  position: relative;
  z-index: 1;
}

.lesson-copy {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: var(--font-body-size);
}

.lesson-mode {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: var(--font-body-size);
  font-weight: var(--font-title-weight);
}

.sync-debug {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  background: var(--surface-glass);
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.5;
}

.sync-debug.is-cloud {
  background: var(--growth-soft);
  color: var(--growth-deep);
}

.sync-debug.is-local {
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.sync-debug-line {
  margin-top: 8rpx;
  word-break: break-all;
}

.player-card,
.transcript-card {
  margin-top: 24rpx;
}

.pass-steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.pass-step {
  min-width: 0;
  min-height: 72rpx;
  padding: 0;
  border-radius: 999rpx;
  border: 1rpx solid var(--border-soft);
  background: var(--surface-glass);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.pass-step.is-current {
  background: var(--accent-soft);
  border-color: var(--border-strong);
}

.pass-step.is-done {
  background: var(--growth-soft);
  border-color: var(--growth);
}

.error-copy {
  color: var(--danger);
}

.player-header {
  align-items: flex-start;
  min-height: 0;
}

.custom-player {
  margin-top: 0;
}

.player-panel {
  padding: 24rpx;
  border-radius: 30rpx;
  background: transparent;
}

.player-info-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.media-title {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.player-status {
  margin-top: 10rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.player-main {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 12rpx 0 4rpx;
}

.player-toggle {
  width: 128rpx;
  min-width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent);
  color: var(--accent-contrast);
  box-shadow: var(--shadow-accent);
}

.player-toggle.is-loading {
  opacity: 0.72;
}

.player-toggle-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
}

.player-toggle-icon.is-play::before {
  content: "";
  display: block;
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-top: 22rpx solid transparent;
  border-bottom: 22rpx solid transparent;
  border-left: 32rpx solid var(--accent-contrast);
}

.player-toggle-icon.is-pause::before,
.player-toggle-icon.is-pause::after {
  content: "";
  display: block;
  width: 12rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: var(--surface);
}

.player-toggle-icon.is-pause::after {
  margin-left: 12rpx;
}

.player-progress {
  margin-top: 24rpx;
  padding-top: 6rpx;
}

.player-progress-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.player-progress-label,
.player-time {
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  font-weight: var(--font-section-weight);
}

.player-time {
  flex-shrink: 0;
}

.player-progress-track {
  background: var(--control-strong-bg);
}

.player-progress-fill {
  background: var(--accent);
}

.player-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
}

.player-action {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 18rpx;
  border: none;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--text-main);
  font-size: var(--font-body-size);
  font-weight: var(--font-title-weight);
  line-height: 68rpx;
  text-align: center;
}

.completion-card-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: var(--surface-glass);
  pointer-events: none;
}

.completion-card {
  width: 100%;
  max-width: 520rpx;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 28rpx;
  background: var(--surface-raised);
  box-shadow: var(--shadow-card);
  text-align: center;
  animation: completionCardIn 180ms ease-out;
}

.completion-card-title {
  color: var(--text-main);
  font-size: var(--font-page-title-size);
  font-weight: var(--font-title-weight);
}

.completion-card-copy {
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: var(--font-body-size);
  line-height: 1.5;
}

.completion-card-status {
  margin-top: 22rpx;
  color: var(--accent-deep);
  font-size: var(--font-body-size);
  font-weight: var(--font-title-weight);
}

@keyframes completionCardIn {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.player-action::after {
  border: none;
}

.player-rate-toggle {
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.player-action.is-disabled {
  opacity: 0.45;
}

.transcript-header {
  align-items: flex-start;
}

.transcript-pill {
  flex-shrink: 0;
}

.transcript-focus {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 28rpx;
  background: var(--surface-subtle);
}

.transcript-focus-line {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 118rpx;
  padding: 18rpx 24rpx;
  border-radius: 24rpx;
  text-align: center;
}

.transcript-focus-line + .transcript-focus-line {
  margin-top: 14rpx;
}

.transcript-focus-line.is-prev,
.transcript-focus-line.is-next {
  background: var(--surface-glass);
}

.transcript-focus-line.is-active {
  min-height: 156rpx;
  background: var(--surface);
}

.transcript-focus-line.is-empty {
  opacity: 0.35;
}

.transcript-focus-line.is-disabled {
  opacity: 0.72;
}

.transcript-focus-text {
  color: var(--text-muted);
  font-size: var(--font-body-size);
  line-height: 1.7;
}

.transcript-focus-line.is-prev .transcript-focus-text,
.transcript-focus-line.is-next .transcript-focus-text {
  color: var(--text-soft);
}

.transcript-focus-line.is-next.is-disabled .transcript-focus-text {
  color: var(--text-soft);
}

.transcript-focus-line.is-active .transcript-focus-text {
  color: var(--text-main);
  font-size: var(--font-brand-size);
  font-weight: var(--font-title-weight);
  line-height: 1.55;
}

.transcript-word {
  display: inline;
  padding: 2rpx 4rpx;
  border-radius: 10rpx;
}

.transcript-word.is-active {
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.transcript-empty {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: var(--surface-subtle);
}

.transcript-empty-title {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}
