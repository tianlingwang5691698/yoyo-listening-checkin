.lesson-hero {
  position: relative;
  overflow: hidden;
  padding-bottom: 34rpx;
  box-shadow: var(--shadow-card);
}

.lesson-page {
  overflow-x: hidden;
}

.cover-variant-peppa,
.cover-variant-unlock,
.cover-variant-song,
.tone-peach {
  background: var(--surface);
}

.lesson-hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.lesson-title {
  position: relative;
  z-index: 1;
}

.lesson-copy {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: var(--font-body-size);
}

.lesson-mode {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: var(--font-body-size);
  font-weight: var(--font-title-weight);
}

.sync-debug {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  background: var(--surface-glass);
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.5;
}

.sync-debug.is-cloud {
  background: var(--growth-soft);
  color: var(--growth-deep);
}

.sync-debug.is-local {
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.sync-debug-line {
  margin-top: 8rpx;
  word-break: break-all;
}

.player-card,
.lesson-study-card,
.transcript-card {
  margin-top: 24rpx;
}

.lesson-study-card {
  overflow: hidden;
}

.lesson-study-card .transcript-header {
  gap: 18rpx;
}

.lesson-study-card .transcript-header > view {
  min-width: 0;
  flex: 1;
}

.lesson-study-card .transcript-pill {
  width: 220rpx;
  min-width: 220rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: var(--font-body-size);
  font-weight: var(--font-title-weight);
  line-height: 64rpx;
  text-align: center;
  box-sizing: border-box;
}

.lesson-study-card .transcript-pill::after {
  border: none;
}

.study-error,
.lesson-study-done {
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.lesson-study-tabs {
  margin-top: 20rpx;
  padding: 0 10rpx;
  display: flex;
  gap: 12rpx;
  box-sizing: border-box;
}

.lesson-study-tab {
  flex: 1;
  min-width: 0;
  min-height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--text-main);
  font-size: var(--font-caption-size);
  line-height: 64rpx;
  text-align: center;
  box-sizing: border-box;
  overflow: hidden;
}

.lesson-study-tab::after {
  border: none;
}

.lesson-study-tab.is-active {
  background: var(--accent);
  color: var(--accent-contrast);
}

.lesson-study-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.lesson-study-item {
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 1rpx solid rgba(107, 118, 138, 0.08);
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

.word-head {
  display: flex;
  align-items: flex-start;
  flex-direction: row;
  justify-content: space-between;
  gap: 16rpx;
}

.word-text,
.phrase-text,
.pattern-text {
  color: var(--text-strong);
  font-size: var(--font-section-size);
  line-height: 1.35;
  font-weight: var(--font-title-weight);
  word-break: break-word;
  overflow-wrap: anywhere;
}

.phonetic {
  display: block;
  margin-top: 4rpx;
  color: var(--text-muted);
  font-size: 24rpx;
}

.word-pronounce {
  flex: 1;
  min-width: 0;
  border-radius: 18rpx;
  transition: background-color 0.16s ease, transform 0.16s ease;
}

.word-pronounce.is-speaking {
  padding: 8rpx 10rpx;
  margin: -8rpx -10rpx;
  background: rgba(46, 95, 168, 0.08);
  transform: scale(0.99);
}

.card-title-line {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.card-index {
  flex-shrink: 0;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: var(--surface-subtle);
  color: var(--accent-deep);
  font-size: 22rpx;
  line-height: 36rpx;
  font-weight: var(--font-title-weight);
  text-align: center;
}

.card-title-line .word-text,
.card-title-line .phrase-text,
.card-title-line .pattern-text {
  min-width: 0;
}

.word-pronounce:active {
  opacity: 0.9;
  transform: translateY(1rpx) scale(0.992);
}

.sound-wave {
  flex-shrink: 0;
  min-width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: var(--accent-deep);
  color: #fff;
  font-size: 18rpx;
  line-height: 34rpx;
  text-align: center;
}

.sound-wave.is-speaking {
  animation: lessonSoundPulse 0.72s ease-in-out infinite;
}

@keyframes lessonSoundPulse {
  0% {
    opacity: 0.55;
    transform: scale(0.88);
  }
  50% {
    opacity: 1;
    transform: scale(1.08);
  }
  100% {
    opacity: 0.55;
    transform: scale(0.88);
  }
}

.word-actions {
  flex-shrink: 0;
  width: 216rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.mini-action {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  margin: 0;
  padding: 0 10rpx;
  border-radius: 999rpx;
  color: var(--text-muted);
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1;
  font-weight: var(--font-title-weight);
  text-align: center;
  box-sizing: border-box;
}

.mini-action::after {
  border: 0;
}

.mini-action.strong {
  color: var(--accent-deep);
  background: var(--accent-soft);
}

.card-meaning,
.card-example,
.card-example-meaning {
  margin-top: 10rpx;
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 1.55;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.card-example,
.card-example-meaning {
  color: var(--text-muted);
}

.lesson-study-done {
  color: var(--accent-deep);
}

.dictionary-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(20, 24, 31, 0.24);
}

.dictionary-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 41;
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 60rpx rgba(28, 36, 52, 0.18);
}

.dictionary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.dictionary-word {
  color: var(--text-strong);
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: var(--font-section-heading-weight);
}

.dictionary-phonetic {
  margin-top: 6rpx;
  color: var(--text-muted);
  font-size: 26rpx;
}

.dictionary-audio {
  flex-shrink: 0;
  width: 56rpx;
  min-width: 56rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 28rpx;
  line-height: 56rpx;
  font-weight: var(--font-title-weight);
  text-align: center;
}

.dictionary-audio::after {
  border: 0;
}

.dictionary-audio.is-loading {
  animation: lessonDictionaryAudioPulse 0.72s ease-in-out infinite;
}

@keyframes lessonDictionaryAudioPulse {
  0% {
    opacity: 0.55;
    transform: scale(0.88);
  }
  50% {
    opacity: 1;
    transform: scale(1.08);
  }
  100% {
    opacity: 0.55;
    transform: scale(0.88);
  }
}

.dictionary-add {
  width: 100%;
  height: 64rpx;
  margin: 22rpx 0 0;
  border-radius: 999rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 64rpx;
  font-weight: var(--font-title-weight);
}

.dictionary-add::after {
  border: 0;
}

.dictionary-loading,
.dictionary-empty,
.dictionary-definition {
  margin-top: 16rpx;
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 1.55;
}

.dictionary-loading,
.dictionary-empty {
  color: var(--text-muted);
}

.pass-steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.pass-step {
  min-width: 0;
  min-height: 72rpx;
  padding: 0;
  border-radius: 999rpx;
  border: 1rpx solid var(--border-soft);
  background: var(--surface-glass);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.pass-step.is-current {
  background: var(--accent-soft);
  border-color: var(--border-strong);
}

.pass-step.is-done {
  background: var(--growth-soft);
  border-color: var(--growth);
}

.error-copy {
  color: var(--danger);
}

.player-header {
  align-items: flex-start;
  min-height: 0;
}

.custom-player {
  margin-top: 0;
}

.player-panel {
  padding: 24rpx;
  border-radius: 30rpx;
  background: transparent;
}

.player-info-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.media-title {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.player-status {
  margin-top: 10rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.player-main {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 12rpx 0 4rpx;
}

.player-toggle {
  width: 128rpx;
  min-width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent);
  color: var(--accent-contrast);
  box-shadow: var(--shadow-accent);
}

.player-toggle.is-loading {
  opacity: 0.72;
}

.player-toggle-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
}

.player-toggle-icon.is-play::before {
  content: "";
  display: block;
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-top: 22rpx solid transparent;
  border-bottom: 22rpx solid transparent;
  border-left: 32rpx solid var(--accent-contrast);
}

.player-toggle-icon.is-pause::before,
.player-toggle-icon.is-pause::after {
  content: "";
  display: block;
  width: 12rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: var(--surface);
}

.player-toggle-icon.is-pause::after {
  margin-left: 12rpx;
}

.player-progress {
  margin-top: 24rpx;
  padding-top: 6rpx;
}

.player-progress-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.player-progress-label,
.player-time {
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  font-weight: var(--font-section-weight);
}

.player-time {
  flex-shrink: 0;
}

.player-progress-track {
  background: var(--control-strong-bg);
}

.player-progress-fill {
  background: var(--accent);
}

.player-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
}

.player-action {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 18rpx;
  border: none;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--text-main);
  font-size: var(--font-body-size);
  font-weight: var(--font-title-weight);
  line-height: 68rpx;
  text-align: center;
  transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.22s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.18s ease, background-color 0.18s ease;
}

.player-action:active {
  transform: translateY(1rpx) scale(0.992);
  box-shadow: inset 0 3rpx 8rpx rgba(47, 43, 39, 0.08);
  opacity: 0.96;
}

.completion-card-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: var(--surface-glass);
  pointer-events: none;
}

.completion-card {
  width: 100%;
  max-width: 520rpx;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 28rpx;
  background: var(--surface-raised);
  box-shadow: var(--shadow-card);
  text-align: center;
  animation: completionCardIn 180ms ease-out;
}

.completion-card-title {
  color: var(--text-main);
  font-size: var(--font-page-title-size);
  font-weight: var(--font-title-weight);
}

.completion-card-copy {
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: var(--font-body-size);
  line-height: 1.5;
}

.completion-card-status {
  margin-top: 22rpx;
  color: var(--accent-deep);
  font-size: var(--font-body-size);
  font-weight: var(--font-title-weight);
}

@keyframes completionCardIn {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.player-action::after {
  border: none;
}

.player-rate-toggle {
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.player-action.is-disabled {
  opacity: 0.45;
}

.transcript-header {
  align-items: flex-start;
}

.transcript-pill {
  flex-shrink: 0;
}

.transcript-focus {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 28rpx;
  background: var(--surface-subtle);
}

.transcript-focus-line {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 118rpx;
  padding: 18rpx 24rpx;
  border-radius: 24rpx;
  text-align: center;
}

.transcript-focus-line + .transcript-focus-line {
  margin-top: 14rpx;
}

.transcript-focus-line.is-prev,
.transcript-focus-line.is-next {
  background: var(--surface-glass);
}

.transcript-focus-line.is-active {
  min-height: 156rpx;
  background: var(--surface);
}

.transcript-focus-line.is-empty {
  opacity: 0.35;
}

.transcript-focus-line.is-disabled {
  opacity: 0.72;
}

.transcript-focus-text {
  color: var(--text-muted);
  font-size: var(--font-body-size);
  line-height: 1.7;
}

.transcript-focus-line.is-prev .transcript-focus-text,
.transcript-focus-line.is-next .transcript-focus-text {
  color: var(--text-soft);
}

.transcript-focus-line.is-next.is-disabled .transcript-focus-text {
  color: var(--text-soft);
}

.transcript-focus-line.is-active .transcript-focus-text {
  color: var(--text-main);
  font-size: var(--font-brand-size);
  font-weight: var(--font-title-weight);
  line-height: 1.55;
}

.transcript-word {
  display: inline;
  padding: 2rpx 4rpx;
  border-radius: 10rpx;
}

.transcript-word.is-active {
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.transcript-empty {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: var(--surface-subtle);
}

.transcript-empty-title {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.speaking-card {
  display: grid;
  gap: 20rpx;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

.speaking-prompt,
.speaking-feedback {
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--surface-subtle);
  color: var(--text-main);
  line-height: 1.6;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.speaking-feedback {
  color: var(--text-muted);
}

.speaking-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  width: 100%;
  max-width: 100%;
}

.speaking-actions .player-action {
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-action.is-danger {
  color: #b42318;
}

.repeat-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.repeat-chip {
  width: 56rpx;
  height: 56rpx;
  display: grid;
  place-items: center;
  border-radius: 12rpx;
  background: var(--surface-subtle);
  color: var(--text-muted);
  font-size: 24rpx;
}

.repeat-chip.is-active {
  background: var(--accent);
  color: var(--accent-contrast);
}

.score-board {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.score-item {
  padding: 16rpx;
  border-radius: 16rpx;
  background: var(--surface-subtle);
  text-align: center;
}

.score-value {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--accent-deep);
}

.score-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.score-dimensions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  min-width: 0;
}

.score-dimension-item {
  min-width: 0;
  padding: 18rpx 14rpx;
  border-radius: 16rpx;
  background: var(--surface-subtle);
  text-align: center;
}

.score-dimension-value {
  font-size: 40rpx;
  line-height: 1.15;
  font-weight: 800;
  color: var(--accent-deep);
}

.score-dimension-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.25;
  color: var(--text-muted);
  word-break: keep-all;
}

.attempt-list {
  display: grid;
  gap: 16rpx;
  min-width: 0;
}

.attempt-card {
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--surface-subtle);
  display: grid;
  gap: 12rpx;
  min-width: 0;
  overflow: hidden;
}

.attempt-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.attempt-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
  word-break: break-word;
}

.attempt-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.attempt-score {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--accent-deep);
  flex-shrink: 0;
}

.attempt-sub-scores {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-muted);
  word-break: break-word;
}

.attempt-feedback {
  color: var(--text-muted);
  line-height: 1.6;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.attempt-transcript {
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--text-main);
  line-height: 1.55;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.record-status {
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: var(--surface-subtle);
  color: var(--text-muted);
  font-size: 24rpx;
}

.speaking-debug {
  padding: 16rpx;
  border: 1rpx dashed rgba(144, 91, 45, 0.35);
  border-radius: 14rpx;
  background: rgba(255, 250, 242, 0.92);
}

.speaking-debug-line {
  color: var(--accent-deep);
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.record-status.is-recording {
  background: rgba(246, 82, 82, 0.12);
  color: #c73333;
}

.record-status.is-ready {
  background: rgba(42, 184, 127, 0.12);
  color: #157a54;
}

.record-action.is-recording {
  background: #f65252;
  color: #fff;
}

.record-action.is-recording:active {
  transform: translateY(1rpx) scale(0.992);
  box-shadow: inset 0 3rpx 8rpx rgba(120, 20, 20, 0.14);
}

.record-action.is-ready,
.submit-action {
  box-shadow: 0 10rpx 24rpx rgba(66, 133, 244, 0.16);
}

.player-action.is-disabled {
  opacity: 0.55;
}

.attempt-play {
  justify-self: stretch;
}

@media (max-width: 360px) {
  .speaking-actions {
    grid-template-columns: 1fr;
  }
}
