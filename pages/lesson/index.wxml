<view class="theme-{{theme}} page-shell lesson-page" wx:if="{{task}}">
  <view class="lesson-hero product-hero tone-{{task.coverTone}} cover-variant-{{task.coverVariant}}">
    <view class="lesson-hero-top">
      <view class="pill">{{task.coverBadge || task.categoryLabel}}</view>
      <view class="status-badge {{studyWriteAllowed ? (task.completedToday ? '' : 'is-warn') : 'is-muted'}}">{{studyWriteAllowed ? (task.completedToday ? '完成' : '训练中') : '试听中'}}</view>
    </view>
    <view class="lesson-title type-page-title">{{(currentAudio && currentAudio.title) || task.displayTitle || task.title}}</view>
    <view class="lesson-mode" wx:if="{{!studyWriteAllowed}}">{{isPreviewMode ? '预览模式 · 不计入打卡' : '家长模式 · 不计入打卡'}}</view>
    <view class="lesson-copy" wx:if="{{task.displaySubtitle}}">{{task.displaySubtitle}}</view>
    <view class="lesson-copy" wx:elif="{{task.coverMeta}}">{{task.coverMeta}}</view>
    <view class="sync-debug {{syncMode === 'cloud' ? 'is-cloud' : 'is-local'}}" wx:if="{{showCloudDebug && syncDebug && syncDebug.show}}">
      {{syncDebug.text}}
      <block wx:if="{{syncDebug.resourceLines && syncDebug.resourceLines.length}}">
        <block wx:for="{{syncDebug.resourceLines}}" wx:key="*this">
          <view class="sync-debug-line">{{item}}</view>
        </block>
      </block>
    </view>
  </view>

  <view class="dictionary-mask" wx:if="{{dictionaryVisible}}" catchtap="closeDictionary"></view>
  <view class="dictionary-sheet" wx:if="{{dictionaryVisible}}">
    <view class="dictionary-head">
      <view>
        <view class="dictionary-word">{{dictionaryEntry.word || dictionaryWord}}</view>
        <view class="dictionary-phonetic" wx:if="{{dictionaryEntry.phonetic}}">/{{dictionaryEntry.phonetic}}/</view>
      </view>
      <button class="dictionary-audio {{dictionaryAudioLoading ? 'is-loading' : ''}}" disabled="{{dictionaryLoading || dictionaryAudioLoading}}" bindtap="playDictionaryWord">♪</button>
    </view>
    <button class="dictionary-add" loading="{{dictionaryAdding}}" bindtap="addDictionaryWordToLibrary">加入词库</button>
    <block wx:if="{{!dictionaryLoading}}">
      <view class="dictionary-definition" wx:for="{{dictionaryEntry.definitions}}" wx:key="*this">· {{item}}</view>
      <view class="dictionary-empty" wx:if="{{!dictionaryEntry.definitions || !dictionaryEntry.definitions.length}}">暂无释义。</view>
    </block>
    <view class="dictionary-loading" wx:else>查词中</view>
  </view>

  <view class="section-panel player-card">
    <view class="pass-steps">
      <block wx:for="{{passSteps}}" wx:key="key">
        <view class="pass-step {{item.done ? 'is-done' : item.current ? 'is-current' : ''}}">{{item.text}}</view>
      </block>
    </view>
    <view class="row-between player-header">
      <view wx:if="{{!task.isPendingAsset}}">
        <view class="section-copy error-copy" wx:if="{{audioErrorText}}">{{audioErrorText}}</view>
        <view class="section-copy" wx:if="{{showCloudDebug && currentAudio && currentAudio.cloudPath}}">云路径：{{currentAudio.cloudPath}}</view>
        <view class="section-copy" wx:if="{{showCloudDebug && currentAudio && currentAudio.fileID}}">fileId：{{currentAudio.fileID}}</view>
        <view class="section-copy" wx:if="{{showCloudDebug && currentAudio && currentAudio.src}}">src：{{currentAudio.src}}</view>
        <view class="section-copy error-copy" wx:if="{{showCloudDebug && audioErrorDetail}}">错误详情：{{audioErrorDetail}}</view>
      </view>
    </view>
    <view class="custom-player" wx:if="{{!task.isPendingAsset}}">
      <view class="player-panel quest-{{task.category}}">
        <view class="player-info-block">
          <view class="player-info-top">
            <view>
              <view class="media-title" wx:if="{{currentAudio && currentAudio.title}}">{{currentAudio.title}}</view>
              <view class="player-status">{{isPlaying ? '正在播放' : (audioReady ? '已暂停' : '等待播放')}}</view>
            </view>
          </view>
        </view>
        <view class="player-main">
          <view class="player-toggle {{audioResolving ? 'is-loading' : ''}}" bindtap="toggleAudio">
            <view class="player-toggle-icon {{isPlaying ? 'is-pause' : 'is-play'}}"></view>
          </view>
        </view>
        <view class="player-progress">
          <view class="player-progress-meta">
            <view class="player-progress-label">{{isPlaying ? '播放中' : audioReady ? '已暂停' : '等待播放'}}</view>
            <view class="player-time">{{currentTimeLabel}} / {{durationLabel}}</view>
          </view>
          <view class="progress-rail player-progress-track">
            <view class="progress-rail-fill player-progress-fill quest-fill-{{task.category}}" style="width: {{progressPercent}}%;"></view>
          </view>
        </view>
        <view class="player-actions action-row">
          <button class="player-action player-action-rewind {{canRewind ? '' : 'is-disabled'}}" bindtap="rewindAudio">5 秒</button>
          <button class="player-action player-rate-toggle" bindtap="togglePlaybackRate">×{{playbackRateText}}</button>
        </view>
      </view>
    </view>
  </view>

  <view id="lesson-study-card" class="section-panel lesson-study-card" wx:if="{{lessonStudyPack || lessonStudyCompleted || transcriptPendingLoad || transcriptLines.length || lessonStudyError}}">
    <view class="row-between transcript-header">
      <view>
        <view class="section-title type-section-title">文本学习</view>
        <view class="section-copy">{{lessonStudyPack ? '学习包已生成。' : (lessonStudyCompleted ? '学习包已生成，点击同步查看。' : '听完后可选择生成学习包。')}}</view>
      </view>
      <button class="pill transcript-pill" loading="{{lessonStudyLoading}}" disabled="{{lessonStudyLoading || lessonStudyPack}}" bindtap="loadLessonStudyPack">{{lessonStudyPack ? '已生成' : (lessonStudyCompleted ? '同步' : '生成')}}</button>
    </view>
    <view class="study-error" wx:if="{{lessonStudyError}}">{{lessonStudyError}}</view>
    <view class="lesson-study-tabs" wx:if="{{lessonStudyPack}}">
      <button class="lesson-study-tab {{lessonStudyTab === item.key ? 'is-active' : ''}}" wx:for="{{lessonStudyTabs}}" wx:key="key" data-tab="{{item.key}}" bindtap="selectLessonStudyTab">{{item.label}}</button>
    </view>
    <view class="lesson-study-list" wx:if="{{lessonStudyPack && lessonStudyTab === 'vocabulary'}}">
      <view class="lesson-study-item word-card" wx:for="{{lessonVocabularyCards}}" wx:key="word">
        <view class="word-head">
          <view class="word-pronounce {{speakingWord === ('word:' + item.word) ? 'is-speaking' : ''}}" data-type="word" data-text="{{item.word}}" bindtap="speakLessonStudyAudio">
            <view class="card-title-line">
              <text class="card-index">{{item.groupIndex}}</text>
              <text class="word-text">{{item.word}}</text>
              <text class="sound-wave {{speakingWord === ('word:' + item.word) ? 'is-speaking' : ''}}" wx:if="{{item.canSpeak}}">♪</text>
            </view>
            <text class="phonetic" wx:if="{{item.phonetic}}">{{item.phonetic}}</text>
          </view>
          <view class="word-actions">
            <button class="mini-action" data-word="{{item.word}}" catchtap="lookupLessonStudyWord">查词</button>
            <button class="mini-action strong" data-type="word" data-text="{{item.word}}" catchtap="addLessonStudyWordToLibrary">{{lessonDictionaryAddedMap[item.flashcardKey] || lessonDictionaryAddedMap[item.word] ? '已加入' : '加入'}}</button>
          </view>
        </view>
        <view class="card-meaning">{{item.meaning}}</view>
        <view class="card-example" wx:if="{{item.example}}">{{item.example}}</view>
        <view class="card-example-meaning" wx:if="{{item.exampleMeaning}}">{{item.exampleMeaning}}</view>
      </view>
    </view>
    <view class="lesson-study-list" wx:elif="{{lessonStudyPack && lessonStudyTab === 'phrases'}}">
      <view class="lesson-study-item phrase-card" wx:for="{{lessonPhraseCards}}" wx:key="text">
        <view class="word-head">
          <view class="word-pronounce {{speakingWord === ('phrase:' + item.text) ? 'is-speaking' : ''}}" data-type="phrase" data-text="{{item.text}}" bindtap="speakLessonStudyAudio">
            <view class="card-title-line">
              <text class="card-index">{{item.groupIndex}}</text>
              <text class="phrase-text">{{item.text}}</text>
              <text class="sound-wave {{speakingWord === ('phrase:' + item.text) ? 'is-speaking' : ''}}" wx:if="{{item.canSpeak}}">♪</text>
            </view>
          </view>
          <view class="word-actions">
            <button class="mini-action strong" data-type="phrase" data-text="{{item.text}}" catchtap="addLessonStudyWordToLibrary">{{lessonDictionaryAddedMap[item.flashcardKey] || lessonDictionaryAddedMap[item.text] ? '已加入' : '加入'}}</button>
          </view>
        </view>
        <view class="card-meaning">{{item.meaning}}</view>
        <view class="card-example" wx:if="{{item.example}}">{{item.example}}</view>
      </view>
    </view>
    <view class="lesson-study-list" wx:elif="{{lessonStudyPack}}">
      <view class="lesson-study-item pattern-card" wx:for="{{lessonPatternCards}}" wx:key="pattern">
        <view class="word-head">
          <view class="card-title-line">
            <text class="card-index">{{item.groupIndex}}</text>
            <text class="pattern-text">{{item.pattern}}</text>
          </view>
          <view class="word-actions">
            <button class="mini-action strong" data-type="pattern" data-text="{{item.pattern}}" catchtap="addLessonStudyWordToLibrary">{{lessonDictionaryAddedMap[item.flashcardKey] || lessonDictionaryAddedMap[item.pattern] ? '已加入' : '加入'}}</button>
          </view>
        </view>
        <view class="card-meaning">{{item.meaning}}</view>
        <view class="card-example" wx:if="{{item.example}}">{{item.example}}</view>
        <view class="card-example-meaning" wx:if="{{item.exampleMeaning}}">{{item.exampleMeaning}}</view>
      </view>
    </view>
    <view class="lesson-study-done" wx:if="{{lessonStudyCompleted}}">已完成文本学习</view>
  </view>

  <view class="section-panel transcript-card" wx:if="{{progress && (progress.transcriptVisible || transcriptManualVisible)}}">
    <view class="row-between transcript-header">
      <view>
        <view class="section-title type-section-title">文本</view>
      </view>
      <button class="pill transcript-pill" wx:if="{{transcriptPendingLoad && !transcriptLines.length}}" bindtap="loadTranscript">查看文本</button>
      <view class="pill transcript-pill" wx:elif="{{!transcriptLines.length}}">{{transcriptLoadFailed ? '加载失败' : '暂无文本'}}</view>
    </view>

    <view class="transcript-focus" wx:if="{{transcriptLines.length}}">
      <view
        class="transcript-focus-line is-prev {{prevLine ? 'is-ready' : 'is-empty'}}"
        wx:if="{{prevLine}}"
        data-index="{{activeLineIndex - 1}}"
        bindtap="seekToLine"
      >
        <view class="transcript-focus-text">{{prevLine.text}}</view>
      </view>
      <view class="transcript-focus-line is-prev is-empty" wx:else>
        <view class="transcript-focus-text"> </view>
      </view>

      <view
        class="transcript-focus-line is-active"
        wx:if="{{activeLine}}"
        data-index="{{activeLineIndex}}"
        bindtap="seekToLine"
      >
        <view class="transcript-focus-text" wx:if="{{transcriptSyncGranularity === 'word' && activeLine.words && activeLine.words.length}}">
          <block wx:for="{{activeLine.words}}" wx:key="wordId">
            <text class="transcript-word {{index === activeWordIndex ? 'is-active' : ''}}">{{item.text}} </text>
          </block>
        </view>
        <view class="transcript-focus-text" wx:else>{{activeLine.text}}</view>
      </view>
      <view class="transcript-focus-line is-active is-empty" wx:else>
        <view class="transcript-focus-text">音频开始后，这一句会在这里突出显示。</view>
      </view>

      <view
        class="transcript-focus-line is-next {{nextLine ? 'is-ready is-disabled' : 'is-empty'}}"
        wx:if="{{nextLine}}"
        data-index="{{activeLineIndex + 1}}"
        bindtap="seekToLine"
      >
        <view class="transcript-focus-text">{{nextLine.text}}</view>
      </view>
      <view class="transcript-focus-line is-next is-empty" wx:else>
        <view class="transcript-focus-text"> </view>
      </view>
    </view>

    <view class="transcript-empty" wx:elif="{{transcriptPendingLoad}}">
      <view class="transcript-empty-title">需要时再查看文本</view>
    </view>

    <view class="transcript-empty" wx:elif="{{transcriptLoadFailed}}">
      <view class="transcript-empty-title">文本加载失败，可稍后再试</view>
    </view>

    <view class="transcript-empty" wx:else>
      <view class="transcript-empty-title">暂无文本</view>
    </view>
  </view>

  <view class="section-panel transcript-card" wx:elif="{{task.speakingMode === 'nce-question-answer'}}">
    <view class="transcript-empty">
      <view class="transcript-empty-title">文本已隐藏</view>
      <button class="player-action record-action" bindtap="showTranscriptOnDemand">查看文本</button>
    </view>
  </view>

  <view class="section-panel transcript-card" wx:else>
    <view class="transcript-empty">
      <view class="transcript-empty-title">这一遍先盲听</view>
    </view>
  </view>

  <view class="section-panel speaking-card" wx:if="{{passQuestionVisible && !speakingPanelVisible}}">
    <view class="row-between">
      <view>
        <view class="section-title type-section-title">本遍问题</view>
        <view class="section-copy">{{passQuestionText || '听问题后准备回答'}}</view>
      </view>
      <button class="player-action record-action" bindtap="startQuestionAnswerNow">开始回答</button>
    </view>
  </view>

  <view class="section-panel speaking-card" wx:if="{{speakingPanelVisible}}">
    <view class="row-between">
      <view>
        <view class="section-title type-section-title">{{speakingMode === 'unlock-sentence-repeat' ? '跟读评分' : '回答评分'}}</view>
        <view class="section-copy" wx:if="{{speakingMode === 'nce-question-answer'}}">{{speakingQuestionText || '听问题后录音回答'}}</view>
        <view class="section-copy" wx:else>第 {{repeatActiveIndex + 1}} / {{repeatLines.length}} 句</view>
      </view>
      <view class="pill">录音</view>
    </view>

    <view class="repeat-list" wx:if="{{speakingMode === 'unlock-sentence-repeat'}}">
      <block wx:for="{{repeatLines}}" wx:key="lineId">
        <view class="repeat-chip {{index === repeatActiveIndex ? 'is-active' : ''}}" data-index="{{index}}" bindtap="switchRepeatLine">{{index + 1}}</view>
      </block>
    </view>
    <view class="speaking-prompt" wx:if="{{speakingMode === 'unlock-sentence-repeat' && activeRepeatLine}}">
      {{activeRepeatLine.text}}
    </view>
    <view class="speaking-feedback" wx:if="{{speakingPromptText}}">{{speakingPromptText}}</view>

    <view class="score-dimensions" wx:if="{{speakingMode === 'nce-question-answer' && speakingScoreDetail.visible}}">
      <view class="score-dimension-item">
        <view class="score-dimension-value">{{speakingScoreDetail.pronunciationFluencyScore}}</view>
        <view class="score-dimension-label">发音流畅</view>
      </view>
      <view class="score-dimension-item">
        <view class="score-dimension-value">{{speakingScoreDetail.contentGrammarScore}}</view>
        <view class="score-dimension-label">内容语法评分</view>
      </view>
    </view>

    <view class="action-row speaking-actions">
      <button class="player-action record-action {{speakingTempFilePath ? 'is-ready' : ''}}" wx:if="{{!speakingRecording}}" hover-class="is-pressed" hover-start-time="20" hover-stay-time="180" bindtap="startSpeakingRecord">{{speakingTempFilePath ? '重录' : '开始录音'}}</button>
      <button class="player-action record-action is-recording" wx:else hover-class="is-pressed" hover-start-time="20" hover-stay-time="180" bindtap="stopSpeakingRecord">停止录音</button>
      <button class="player-action primary" wx:if="{{speakingMode === 'nce-question-answer' && speakingCanContinue}}" hover-class="is-pressed" hover-start-time="20" hover-stay-time="180" bindtap="continueAfterSpeakingFeedback">满意，继续</button>
      <button class="player-action" wx:if="{{speakingMode === 'unlock-sentence-repeat'}}" hover-class="is-pressed" hover-start-time="20" hover-stay-time="180" bindtap="completeUnlockRepeat">完成跟读</button>
    </view>
    <view class="record-status {{speakingRecording ? 'is-recording' : (speakingTempFilePath ? 'is-ready' : '')}}">
      {{speakingSubmitting ? '录音已结束，正在自动评分' : (speakingRecording ? '正在录音，答完后点停止' : (speakingTempFilePath ? ('已录制 ' + speakingRecordDurationText) : '点开始录音，结束后自动评分'))}}
    </view>
    <view class="speaking-debug" wx:if="{{speakingDebugLines.length}}">
      <view class="speaking-debug-line" wx:for="{{speakingDebugLines}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="score-board" wx:if="{{speakingSummary.scoredCount}}">
      <view class="score-item">
        <view class="score-value">{{speakingSummary.bestScore || 0}}</view>
        <view class="score-label">最佳</view>
      </view>
      <view class="score-item">
        <view class="score-value">{{speakingSummary.latestScore || 0}}</view>
        <view class="score-label">最近</view>
      </view>
    </view>

    <view class="attempt-list" wx:if="{{speakingMode === 'nce-question-answer' && speakingAttempts.length}}">
      <view class="attempt-card" wx:for="{{speakingAttempts}}" wx:key="createdAt">
        <view class="attempt-head">
          <view>
            <view class="attempt-title">{{item.resultRole || ('第 ' + item.attemptIndex + ' 次')}}</view>
            <view class="attempt-meta" wx:if="{{item.answerDurationText}}">录音 {{item.answerDurationText}}</view>
          </view>
          <view class="attempt-score">{{item.status === 'score-pending' ? '待评分' : ((item.score || 0) + ' 分')}}</view>
        </view>
        <view class="attempt-sub-scores" wx:if="{{item.pronunciationFluencyScore || item.contentGrammarScore}}">
          发音流畅 {{item.pronunciationFluencyScore || 0}} / 内容语法 {{item.contentGrammarScore || 0}}
        </view>
        <view class="attempt-transcript" wx:if="{{item.studentTranscript}}">学生回答：{{item.studentTranscript}}</view>
        <view class="attempt-feedback">{{item.feedback || '暂无建议'}}</view>
        <view class="attempt-feedback" wx:if="{{item.scoreErrorType || item.scoreError}}">
          错误：{{item.scoreErrorType || 'unknown'}} {{item.scoreError || ''}}
        </view>
        <view class="action-row speaking-actions">
          <button class="player-action attempt-play" data-index="{{index}}" data-audio-type="answer" hover-class="is-pressed" hover-start-time="20" hover-stay-time="180" bindtap="playSpeakingAttempt">
            {{speakingPlayingAttemptKey === ('answer-' + item.attemptType + '-' + item.attemptIndex + '-' + item.sentenceIndex + '-' + index) ? (speakingPausedAttemptKey === ('answer-' + item.attemptType + '-' + item.attemptIndex + '-' + item.sentenceIndex + '-' + index) ? '继续录音' : '暂停录音') : '播放录音'}}
          </button>
          <button class="player-action attempt-play" wx:if="{{item.status === 'score-pending' && item.attemptId}}" data-index="{{index}}" hover-class="is-pressed" hover-start-time="20" hover-stay-time="180" bindtap="rescoreSpeakingAttempt">
            {{speakingRescoringKey === item.attemptId ? '评分中' : '重新评分'}}
          </button>
          <button class="player-action attempt-play" wx:if="{{item.feedbackAudioFileId || item.feedbackAudioCloudPath}}" data-index="{{index}}" data-audio-type="feedback" hover-class="is-pressed" hover-start-time="20" hover-stay-time="180" bindtap="playSpeakingAttempt">
            {{speakingPlayingAttemptKey === ('feedback-' + item.attemptType + '-' + item.attemptIndex + '-' + item.sentenceIndex + '-' + index) ? (speakingPausedAttemptKey === ('feedback-' + item.attemptType + '-' + item.attemptIndex + '-' + item.sentenceIndex + '-' + index) ? '继续建议' : '暂停建议') : '播放建议'}}
          </button>
        </view>
      </view>
    </view>
  </view>

  <view class="completion-card-mask" wx:if="{{completionCardVisible}}">
    <view class="completion-card">
      <view class="completion-card-title">Great job today!</view>
      <view class="completion-card-copy">今天也认真完成了，真不错。</view>
      <view class="completion-card-status">今天打卡完成</view>
    </view>
  </view>

</view>

<view class="theme-{{theme}} page-shell lesson-page" wx:elif="{{syncMode === 'cloud-error'}}">
  <view class="lesson-hero tone-peach cover-variant-unlock">
    <view class="lesson-hero-top">
      <view class="pill">云端</view>
    </view>
    <view class="lesson-title">课程暂时不可用</view>
    <view class="lesson-copy">学习内容暂时没有同步成功，请稍后再试。</view>
    <view class="sync-debug is-local" wx:if="{{showCloudDebug && syncDebug && syncDebug.show}}">
      {{syncDebug.text}}
      <block wx:if="{{syncDebug.resourceLines && syncDebug.resourceLines.length}}">
        <block wx:for="{{syncDebug.resourceLines}}" wx:key="*this">
          <view class="sync-debug-line">{{item}}</view>
        </block>
      </block>
    </view>
  </view>

  <view class="card result-card">
    <view class="result-badge">服务异常</view>
    <view class="result-title">请稍后再重试</view>
    <view class="result-copy">{{(syncDebug && (syncDebug.publicReason || syncDebug.reason)) || '云端服务暂时不可用，请稍后再试。'}}</view>
  </view>
</view>
