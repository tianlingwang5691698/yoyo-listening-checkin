  width: 58rpx;
  height: 58rpx;
  border: 3rpx solid var(--dragon-ink);
  border-radius: 50%;
  background: var(--dragon-yellow);
  color: var(--dragon-ink);
  font-size: 26rpx;
  line-height: 52rpx;
  text-align: center;
  font-weight: 800;
  box-sizing: border-box;
}

.theme-dragon .history-summary {
  max-width: 100%;
  box-sizing: border-box;
}

.theme-dragon .history-result,
.theme-dragon .history-entry-action {
  color: var(--dragon-orange);
}

.theme-dragon .history-entry-action { border-color: var(--dragon-orange); border-radius: 5rpx; }

.theme-dragon .history-result {
  max-width: 148rpx;
  white-space: normal;
  text-align: right;
}

.theme-dragon .history-detail {
  border-top-color: rgba(16, 46, 98, 0.24);
  background: #fff7dc;
}

.theme-dragon .history-section,
.theme-dragon .history-question {
  max-width: 100%;
  border: 3rpx solid rgba(16, 46, 98, 0.38);
  border-radius: 7rpx;
  background: var(--dragon-paper);
  box-sizing: border-box;
}

.theme-dragon .history-option {
  max-width: 100%;
  border: 2rpx solid rgba(16, 46, 98, 0.28);
  border-radius: 6rpx;
  background: #fffef7;
  color: #69728a;
  box-sizing: border-box;
}

.theme-dragon .history-option.is-answer {
  border-color: var(--dragon-green);
  background: #dff2e4;
  color: #1c744b;
}

.theme-dragon .history-option.is-selected-wrong {
  border-color: #c93c22;
  background: #ffe1d7;
}

.theme-dragon .history-ai-row,
.theme-dragon .history-explain-action,
.theme-dragon .history-wrong-action {
  border: 3rpx solid var(--dragon-ink);
  border-radius: 6rpx;
  background: var(--dragon-yellow);
  color: var(--dragon-ink);
  font-weight: 800;
}

.theme-dragon .history-wrong-action.is-added {
  background: #dff2e4;
  color: #1c744b;
}

.theme-dragon .history-record-title,
.theme-dragon .history-record-meta,
.theme-dragon .history-question-prompt,
.theme-dragon .history-passage,
.theme-dragon .history-writing-text,
.theme-dragon .history-analysis,
.theme-dragon .history-list-line,
.theme-dragon .history-correction,
.theme-dragon .history-review-row,
.theme-dragon .history-option text {
  min-width: 0;
  max-width: 100%;
}
