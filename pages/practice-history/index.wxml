<view class="theme-{{theme}} language-{{language}} page-shell practice-history-page history-{{type}}">
  <view class="history-hero">
    <view class="history-eyebrow">{{config.eyebrow}}</view>
    <view class="history-title">{{config.title}}</view>
    <view class="history-copy">{{config.copy}}</view>
    <view class="history-parent-badge" wx:if="{{isParentView}}">{{texts.parentReadOnly}}</view>
    <view class="history-archive-mark {{theme === 'voyage' ? 'is-voyage' : (theme === 'dragon' ? 'is-dragon' : '')}}" wx:if="{{theme === 'library' || theme === 'voyage' || theme === 'dragon'}}">
      <view class="history-archive-number">{{type === 'reading' ? 'R' : (type === 'grammar' ? 'G' : (type === 'vocabulary' ? 'V' : 'W'))}}</view>
      <text>ARCHIVE</text>
    </view>
  </view>

  <view class="history-tabs" wx:if="{{type === 'reading' || type === 'grammar'}}">
    <view class="history-tab {{viewMode === 'history' ? 'is-active' : ''}}" bindtap="openHistory">{{texts.history}}</view>
    <view class="history-tab {{viewMode === 'wrong' ? 'is-active' : ''}}" bindtap="openWrongBook">{{texts.wrongBook}}</view>
  </view>

  <view class="history-debug" wx:if="{{debugLines.length}}">
    <text selectable="{{true}}" wx:for="{{debugLines}}" wx:key="*this">{{item}}</text>
  </view>

  <view class="history-list" wx:if="{{records.length}}">
    <view class="history-record {{expandedId === item.id ? 'is-expanded' : ''}}" wx:for="{{records}}" wx:key="id">
      <view class="history-summary" data-id="{{item.id}}" bindtap="toggleRecord">
        <view class="history-record-stamp {{theme === 'voyage' ? 'is-voyage' : (theme === 'dragon' ? 'is-dragon' : '')}}" wx:if="{{theme === 'library' || theme === 'voyage' || theme === 'dragon'}}">{{type === 'reading' ? 'R' : (type === 'grammar' ? 'G' : (type === 'vocabulary' ? 'V' : 'W'))}}</view>
        <view class="history-summary-main">
          <view class="history-record-title">{{item.title}}</view>
          <view class="history-record-meta">{{item.dateLabel}} · {{item.meta}}<text wx:if="{{item.durationText}}"> · {{texts.durationLabel}} {{item.durationText}}</text></view>
        </view>
        <view class="history-result">{{item.summary}}</view>
        <view class="history-entry-action">{{expandedId === item.id ? texts.collapseRecord : texts.enterRecord}}</view>
      </view>

      <view class="history-detail" wx:if="{{expandedId === item.id}}">
        <view class="history-loading" wx:if="{{item.detailLoading}}">{{texts.loadingOriginal}}</view>

        <block wx:if="{{type === 'reading' && item.detailReady}}">
          <view class="history-section" wx:if="{{item.passageText}}">
            <view class="history-section-title">{{texts.original}}</view>
            <view class="history-passage">{{item.passageText}}</view>
          </view>
          <view class="history-section history-manual-marks" wx:if="{{item.manualMarkItems.length}}">
            <view class="history-section-title">{{texts.myMarks}}</view>
            <view class="history-mark-list">
              <view class="history-mark-item is-{{mark.type}}" wx:for="{{item.manualMarkItems}}" wx:key="index" wx:for-item="mark">{{mark.text}}</view>
            </view>
          </view>
          <view class="history-ai-row" data-id="{{item.id}}" bindtap="loadReadingCachedAnalysis">{{item.aiAnalysisLoaded ? texts.analysisLoaded : (item.aiAnalysisLoading ? texts.analysisLoading : texts.viewAnalysis)}}</view>
          <view class="history-ai-status" wx:if="{{item.aiAnalysisStatus}}">{{item.aiAnalysisStatus}}</view>
          <view class="history-question" wx:for="{{item.detailQuestions}}" wx:key="number" wx:for-item="question">
            <view class="history-question-no">{{texts.questionPrefix}}{{question.number}}{{texts.questionSuffix}}</view>
            <view class="history-question-prompt">{{question.prompt}}</view>
            <view class="history-option {{option.isAnswer ? 'is-answer' : ''}} {{option.isSelected && !option.isAnswer ? 'is-selected-wrong' : ''}}" wx:for="{{question.optionsList}}" wx:key="key" wx:for-item="option">
              <text>{{option.key}}. {{option.text}}</text>
              <text wx:if="{{option.isSelected}}">{{texts.childAnswer}}</text>
            </view>
            <view class="history-answer {{question.correct ? 'is-correct' : 'is-wrong'}}">
              <text class="history-answer-result">{{texts.childAnswerLabel}}{{question.selected || texts.unanswered}}</text>
              <text class="history-standard-answer">{{texts.correctAnswer}}{{question.answer || texts.none}}</text>
            </view>
            <view class="history-analysis" wx:if="{{question.analysis}}">{{question.analysis}}</view>
            <view class="history-wrong-action {{question.inWrongBook ? 'is-added' : ''}}" wx:if="{{viewMode === 'history' && !isParentView && !question.correct}}" data-record-id="{{item.id}}" data-question-id="{{question.questionId}}" bindtap="addWrongQuestion">{{question.inWrongBook ? texts.added : (question.addingWrong ? texts.adding : texts.add)}}</view>
          </view>
        </block>

        <block wx:if="{{type === 'grammar'}}">
          <view class="history-section history-manual-marks" wx:if="{{item.manualMarkItems.length}}">
            <view class="history-section-title">{{texts.myMarks}}</view>
            <view class="history-mark-list"><view class="history-mark-item is-{{mark.type}}" wx:for="{{item.manualMarkItems}}" wx:key="index" wx:for-item="mark">{{mark.text}}</view></view>
          </view>
          <view class="history-section" wx:if="{{item.isMicroLesson}}">
            <view class="history-section-title">{{texts.microLesson}}</view>
            <view class="history-analysis">{{item.summary}}</view>
          </view>
          <block wx:if="{{item.detailQuestions && item.detailQuestions.length}}">
            <view class="history-question" wx:for="{{item.detailQuestions}}" wx:key="number" wx:for-item="question">
            <view class="history-question-no">{{texts.questionPrefix}}{{question.number}}{{texts.questionSuffix}}</view>
            <view class="history-question-prompt">{{question.prompt}}</view>
            <view class="history-option {{option.isAnswer ? 'is-answer' : ''}} {{option.isSelected && !option.isAnswer ? 'is-selected-wrong' : ''}}" wx:for="{{question.optionsList}}" wx:key="key" wx:for-item="option">
              <text>{{option.key}}. {{option.text}}</text>
              <text wx:if="{{option.isSelected}}">{{texts.childAnswer}}</text>
            </view>
            <view class="history-answer {{question.correct ? 'is-correct' : 'is-wrong'}}">
              <text class="history-answer-result">{{texts.childAnswerLabel}}{{question.selected || texts.unanswered}}</text>
              <text class="history-standard-answer">{{texts.correctAnswer}}{{question.answer || texts.none}}</text>
            </view>
            <view class="history-analysis" wx:if="{{question.analysis}}">{{question.analysis}}</view>
            <view class="history-ai-status" wx:elif="{{question.analysisStatus}}">{{question.analysisStatus}}</view>
            <view class="history-explain-action" wx:else data-record-id="{{item.id}}" data-question-id="{{question.questionId}}" bindtap="loadGrammarExplanation">{{question.explaining ? texts.explanationLoading : texts.viewExplanation}}</view>
            <view class="history-wrong-action {{question.inWrongBook ? 'is-added' : ''}}" wx:if="{{viewMode === 'history' && !isParentView && !question.correct}}" data-record-id="{{item.id}}" data-question-id="{{question.questionId}}" bindtap="addWrongQuestion">{{question.inWrongBook ? texts.added : (question.addingWrong ? texts.adding : texts.add)}}</view>
            </view>
          </block>
        </block>

        <block wx:if="{{type === 'writing' && item.detailReady}}">
          <view class="history-section history-manual-marks" wx:if="{{item.manualMarkItems.length}}">
            <view class="history-section-title">{{texts.myMarks}}</view>
            <view class="history-mark-list"><view class="history-mark-item is-{{mark.type}}" wx:for="{{item.manualMarkItems}}" wx:key="index" wx:for-item="mark">{{mark.text}}</view></view>
          </view>
          <view class="history-section">
            <view class="history-section-title">{{texts.prompt}}</view>
            <view class="history-writing-text">{{item.attempt.prompt || item.title}}</view>
          </view>
          <view class="history-section">
            <view class="history-section-title">{{texts.essay}}</view>
            <view class="history-writing-text">{{item.attempt.essay}}</view>
          </view>
          <view class="history-section" wx:if="{{item.attempt.review.summary}}">
            <view class="history-section-title">{{texts.report}}</view>
            <view class="history-analysis">{{item.attempt.review.summary}}</view>
            <view class="history-review-row" wx:if="{{item.attempt.review.content}}"><text>{{item.attempt.review.contentLabel || texts.content}}</text><view>{{item.attempt.review.content}}</view></view>
            <view class="history-review-row" wx:if="{{item.attempt.review.structure}}"><text>{{item.attempt.review.structureLabel || texts.structure}}</text><view>{{item.attempt.review.structure}}</view></view>
            <view class="history-review-row" wx:if="{{item.attempt.review.language}}"><text>{{item.attempt.review.languageLabel || texts.language}}</text><view>{{item.attempt.review.language}}</view></view>
            <view class="history-review-row" wx:if="{{item.attempt.review.spelling}}"><text>{{item.attempt.review.spellingLabel || texts.spelling}}</text><view>{{item.attempt.review.spelling}}</view></view>
          </view>
          <view class="history-section" wx:if="{{item.attempt.review.problems.length}}">
            <view class="history-section-title">{{texts.improvements}}</view>
            <view class="history-list-line" wx:for="{{item.attempt.review.problems}}" wx:key="*this">· {{item}}</view>
          </view>
          <view class="history-section" wx:if="{{item.attempt.review.suggestions.length}}">
            <view class="history-section-title">{{texts.advice}}</view>
            <view class="history-list-line" wx:for="{{item.attempt.review.suggestions}}" wx:key="*this">· {{item}}</view>
          </view>
          <view class="history-section" wx:if="{{item.attempt.review.grammarCorrections.length}}">
            <view class="history-section-title">{{texts.polish}}</view>
            <view class="history-correction" wx:for="{{item.attempt.review.grammarCorrections}}" wx:key="original">
              <view>{{texts.originalSentence}}{{item.original}}</view>
              <view>{{texts.revisedSentence}}{{item.corrected}}</view>
              <view>{{texts.reason}}{{item.reason}}</view>
            </view>
          </view>
          <view class="history-section" wx:if="{{item.attempt.review.polishedVersion}}">
            <view class="history-section-title">{{item.attempt.review.polishedTitle || texts.rewrite}}</view>
            <view class="history-writing-text">{{item.attempt.review.polishedVersion}}</view>
          </view>
        </block>
        <block wx:if="{{type === 'vocabulary' && item.detailReady}}">
          <view class="history-question" wx:for="{{item.detailQuestions}}" wx:key="number" wx:for-item="question">
            <view class="history-question-no">{{question.number}}. {{question.word}}</view>
            <view class="history-answer {{question.correct ? 'is-correct' : 'is-wrong'}}"><text>{{texts.childAnswerLabel}}{{question.input || texts.unanswered}}</text><text wx:if="{{!question.correct}}">{{texts.correctAnswer}}{{question.answer}}</text></view>
            <view class="history-analysis" wx:if="{{question.phonetic || question.meaning}}">{{question.phonetic}} {{question.meaning}}</view>
          </view>
        </block>
      </view>
    </view>
  </view>

  <view class="history-loading history-empty" wx:elif="{{loading}}">{{texts.loading}}</view>
  <view class="history-empty" wx:elif="{{!debugLines.length}}">
    <view class="history-empty-title">{{viewMode === 'wrong' ? texts.noWrong : config.empty}}</view>
    <view class="history-empty-copy">{{texts.emptyCopy}}</view>
  </view>
</view>
