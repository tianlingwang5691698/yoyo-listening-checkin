.identity-hero {
  background: var(--surface);
}

.role-switch {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.role-option {
  min-height: 160rpx;
  padding: 24rpx;
  border: 2rpx solid var(--border-soft);
  border-radius: var(--radius-lg);
  background: var(--surface-glass);
}

.role-option.is-active {
  border-color: var(--border-strong);
  background: var(--control-muted-bg);
}

.role-title {
  color: var(--text-main);
  font-size: var(--font-section-title-size);
  font-weight: var(--font-title-weight);
}

.role-copy {
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.55;
}

.identity-input {
  margin-top: 22rpx;
}

.code-input {
  text-align: center;
  font-size: var(--font-section-title-size);
  font-weight: var(--font-section-heading-weight);
}

.bind-card .button-primary,
.bind-card .button-secondary {
  margin-top: 22rpx;
}

.student-code {
  margin-top: 24rpx;
  color: var(--text-strong);
  font-size: var(--font-code-size);
  line-height: 1;
  font-weight: var(--font-section-heading-weight);
  text-align: center;
  letter-spacing: 0;
}
