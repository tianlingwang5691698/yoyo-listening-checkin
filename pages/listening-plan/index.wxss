}

.plan-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 34rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--surface-raised);
  border-top: 1rpx solid var(--border-soft);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  z-index: 10;
}

.plan-action {
  min-height: 82rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.plan-action.clear {
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.plan-action.clear.is-disabled {
  opacity: 0.42;
}

.plan-action.done {
  background: var(--accent);
  color: var(--text-inverse);
}

.listening-plan-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 78% 8%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0) 30%),
    linear-gradient(160deg, #f8fbfd 0%, #edf6fa 48%, #f7fbfd 100%);
}

.plan-header {
  padding: 76rpx 8rpx 30rpx;
}

.level-tabs {
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.level-tab {
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  color: #728196;
}

.level-tab.is-active {
