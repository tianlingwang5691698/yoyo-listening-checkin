  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.library-level-tab {
  min-height: 62rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.38);
  border-radius: 6px 6px 0 0;
  background: #f3e8d4;
