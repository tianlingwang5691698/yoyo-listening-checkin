.listening-plan-page {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.plan-header {
  padding: 70rpx 20rpx 28rpx;
}

.plan-title {
  margin: 8rpx 0;
}

.level-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin-bottom: 18rpx;
}

.level-tab {
  min-height: 62rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  font-weight: var(--font-section-weight);
}

.level-tab.is-active {
  background: var(--text-strong);
  color: var(--text-inverse);
}

.level-tab.is-disabled {
  opacity: 0.38;
}

.fixed-card {
  margin: 0 0 22rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-xl);
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.selected-card {
  margin: 0 0 14rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-xl);
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.selected-title {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.selected-copy {
  margin-top: 6rpx;
}

.selected-total {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--accent);
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.selected-list {
  margin: 0 0 22rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: var(--surface-glass);
}

.selected-row {
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid var(--border-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.selected-row:last-child {
  border-bottom: none;
}

.selected-row-title {
  color: var(--text-main);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.selected-row-main {
  min-width: 0;
}

.selected-row-action {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.selected-row-meta {
  margin-top: 6rpx;
}

.stage-list {
  margin-top: 0;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: var(--surface-glass);
}

.loading-card {
  margin: 0 0 18rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-xl);
  background: var(--surface-glass);
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  font-weight: var(--font-section-weight);
}

.stage-row {
  min-height: 110rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--border-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.stage-row:last-child {
  border-bottom: none;
}

.stage-row.is-disabled {
  opacity: 0.5;
}

.stage-row-main {
  min-width: 0;
}

.stage-row-title {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.stage-row-meta {
  margin-top: 8rpx;
}

.stage-row-state {
  flex-shrink: 0;
  min-width: 62rpx;
  color: var(--accent-deep);
  text-align: right;
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.section-label {
  margin: 28rpx 0 14rpx;
  color: var(--text-main);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.empty-plan,
.empty-add {
  margin: 0 0 22rpx;
  padding: 26rpx 28rpx;
  border-radius: var(--radius-xl);
  background: var(--surface-glass);
}

.empty-add {
  margin-top: 16rpx;
}

.empty-plan-title {
  color: var(--text-main);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.empty-plan-copy {
  margin-top: 6rpx;
}

.plan-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 34rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--surface-raised);
  border-top: 1rpx solid var(--border-soft);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  z-index: 10;
}

.plan-action {
  min-height: 82rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.plan-action.clear {
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.plan-action.clear.is-disabled {
  opacity: 0.42;
}

.plan-action.done {
  background: var(--accent);
  color: var(--text-inverse);
}

.listening-plan-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 78% 8%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0) 30%),
    linear-gradient(160deg, #f8fbfd 0%, #edf6fa 48%, #f7fbfd 100%);
}

.plan-header {
  padding: 76rpx 8rpx 30rpx;
}

.level-tabs {
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.level-tab {
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  color: #728196;
}

.level-tab.is-active {
  background: #17314f;
  color: #f6fbfd;
  box-shadow: 0 12rpx 26rpx rgba(23, 49, 79, 0.16);
}

.fixed-card,
.selected-card {
  position: relative;
  overflow: hidden;
  border-radius: 34rpx;
  background:
    linear-gradient(140deg, rgba(255, 255, 255, 0.86), rgba(221, 238, 248, 0.64)),
    rgba(236, 247, 251, 0.84);
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 42rpx rgba(78, 112, 139, 0.1);
}

.plan-wave-mark {
  position: absolute;
  right: 106rpx;
  bottom: 26rpx;
  display: flex;
  align-items: flex-end;
  gap: 7rpx;
  opacity: 0.28;
}

.plan-wave-mark text {
  width: 7rpx;
  border-radius: 999rpx;
  background: #8db7d4;
}

.plan-wave-mark text:nth-child(1) { height: 22rpx; }
.plan-wave-mark text:nth-child(2) { height: 44rpx; }
.plan-wave-mark text:nth-child(3) { height: 31rpx; }

.selected-title,
.selected-row-title,
.stage-row-title,
.section-label,
.empty-plan-title {
  color: #17314f;
  font-weight: 600;
}

.selected-total {
  background: #17314f;
  color: #f6fbfd;
  font-weight: 600;
}

.selected-list,
.stage-list,
.loading-card,
.empty-plan,
.empty-add {
  border-radius: 34rpx;
  background: rgba(246, 251, 253, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 42rpx rgba(78, 112, 139, 0.1);
}

.loading-card {
  color: #607087;
}

.selected-row,
.stage-row {
  border-bottom: 1rpx solid rgba(141, 183, 212, 0.16);
}

.selected-row-action,
.stage-row-state {
  color: #df8068;
  font-weight: 600;
}

.plan-actions {
  background: rgba(246, 251, 253, 0.9);
  border-top: 1rpx solid rgba(141, 183, 212, 0.16);
}

.plan-action {
  font-weight: 600;
}

.plan-action.clear {
  background: rgba(221, 238, 248, 0.72);
  color: #17314f;
}

.plan-action.done {
  background: linear-gradient(135deg, #f2a18e 0%, #df8068 100%);
  color: #fffafa;
}
