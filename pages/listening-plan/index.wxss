.listening-plan-page {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.plan-header {
  padding: 70rpx 20rpx 28rpx;
}

.plan-title {
  margin: 8rpx 0;
}

.level-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin-bottom: 18rpx;
}

.level-tab {
  min-height: 62rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  font-weight: var(--font-section-weight);
}

.level-tab.is-active {
  background: var(--text-strong);
  color: var(--text-inverse);
}

.level-tab.is-disabled {
  opacity: 0.38;
}

.fixed-card {
  margin: 0 0 22rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-xl);
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.selected-card {
  margin: 0 0 14rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-xl);
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.selected-title {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.selected-copy {
  margin-top: 6rpx;
}

.selected-total {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--accent);
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.selected-list {
  margin: 0 0 22rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: var(--surface-glass);
}

.selected-row {
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid var(--border-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.selected-row:last-child {
  border-bottom: none;
}

.selected-row-title {
  color: var(--text-main);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.selected-row-main {
  min-width: 0;
}

.selected-row-action {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.selected-row-meta {
  margin-top: 6rpx;
}

.stage-list {
  margin-top: 0;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: var(--surface-glass);
}

.loading-card {
  margin: 0 0 18rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-xl);
  background: var(--surface-glass);
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  font-weight: var(--font-section-weight);
}

.stage-row {
  min-height: 110rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--border-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.stage-row:last-child {
  border-bottom: none;
}

.stage-row.is-disabled {
  opacity: 0.5;
}

.stage-row-main {
  min-width: 0;
}

.stage-row-title {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.stage-row-meta {
  margin-top: 8rpx;
}

.stage-row-state {
  flex-shrink: 0;
  min-width: 62rpx;
  color: var(--accent-deep);
  text-align: right;
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.section-label {
  margin: 28rpx 0 14rpx;
  color: var(--text-main);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.empty-plan,
.empty-add {
  margin: 0 0 22rpx;
  padding: 26rpx 28rpx;
  border-radius: var(--radius-xl);
  background: var(--surface-glass);
}

.empty-add {
  margin-top: 16rpx;
}

.empty-plan-title {
  color: var(--text-main);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.empty-plan-copy {
  margin-top: 6rpx;
}

.plan-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 34rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--surface-raised);
  border-top: 1rpx solid var(--border-soft);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  z-index: 10;
}

.plan-action {
  min-height: 82rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.plan-action.clear {
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.plan-action.clear.is-disabled {
  opacity: 0.42;
}

.plan-action.done {
  background: var(--accent);
  color: var(--text-inverse);
}
