  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.selected-title {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.selected-copy {
  margin-top: 6rpx;
}

.selected-total {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--accent);
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.selected-list {
  margin: 0 0 22rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: var(--surface-glass);
}

.selected-row {
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid var(--border-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.selected-row:last-child {
  border-bottom: none;
}

.selected-row-title {
  color: var(--text-main);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.selected-row-main {
  min-width: 0;
}

.selected-row-action {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.selected-row-meta {
  margin-top: 6rpx;
}

.stage-list {
  margin-top: 0;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: var(--surface-glass);
}

.loading-card {
  margin: 0 0 18rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-xl);
  background: var(--surface-glass);
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  font-weight: var(--font-section-weight);
}

.stage-row {
  min-height: 110rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--border-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.stage-row:last-child {
  border-bottom: none;
}

.stage-row.is-disabled {
  opacity: 0.5;
}

.stage-row-main {
  min-width: 0;
}

.stage-row-title {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.stage-row-meta {
  margin-top: 8rpx;
}

.stage-row-state {
  flex-shrink: 0;
  min-width: 62rpx;
