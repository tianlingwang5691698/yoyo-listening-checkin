<view class="theme-{{theme}} page-shell voyage-plan-page language-{{language}}" wx:if="{{theme === 'voyage' || theme === 'dragon' || theme === 'tactical'}}">
  <view class="voyage-logbook-head">
    <view class="voyage-logbook-kicker">{{texts.eyebrow}}</view>
    <view class="voyage-logbook-title">{{texts.title}}</view>
    <view class="voyage-logbook-subtitle">{{selectedLevel}} · {{texts.subtitle}}</view>
    <view class="voyage-logbook-compass"><view></view></view>
  </view>

  <view class="voyage-plan-fixed" wx:if="{{isYoyoFixedPlan}}" bindtap="openFixedStage">
    <view><view class="voyage-plan-row-title">{{texts.currentPlan}}</view><view class="voyage-plan-muted">A1 · {{fixedPlan.planPhaseLabel || texts.phase2}} · {{texts.fixedPlanKept}}</view></view>
    <view class="voyage-plan-link">{{texts.view}}</view>
  </view>

  <view class="voyage-current-route">
    <view><view class="voyage-plan-row-title">{{texts.todayRuler}}</view><view class="voyage-plan-muted">{{planSummaryText}}</view></view>
    <view class="voyage-daily-seal">{{dailyTotal}}</view>
  </view>

  <view class="voyage-selected-route" wx:if="{{selectedRows.length}}">
    <view class="voyage-selected-row" wx:for="{{selectedRows}}" wx:key="category" data-category="{{item.category}}" data-level-id="{{item.levelId}}" bindtap="openMaterial">
      <view class="voyage-selected-point"></view>
      <view class="voyage-selected-main"><view>{{item.title}}</view><text>{{item.meta}}</text></view>
      <view class="voyage-plan-link">{{texts.edit}}</view>
    </view>
  </view>

  <view class="voyage-plan-empty" wx:if="{{!selectedRows.length}}"><view>{{texts.empty}}</view><text>{{texts.emptyHint}}</text></view>

  <view class="voyage-plan-section">{{texts.addMaterial}}</view>
  <view class="voyage-plan-tabs">
    <view class="voyage-plan-tab {{item.active ? 'is-active' : ''}} {{item.enabled ? '' : 'is-disabled'}}" wx:for="{{levelTabs}}" wx:key="levelId" data-enabled="{{item.enabled}}" data-level-id="{{item.levelId}}" bindtap="chooseLevel"><view></view><text>{{item.levelId}}</text></view>
  </view>

  <view class="voyage-plan-catalog">
    <view class="voyage-plan-material {{item.disabled ? 'is-disabled' : ''}}" wx:for="{{materials}}" wx:key="category" data-category="{{item.category}}" data-level-id="{{item.levelId}}" data-disabled="{{item.disabled}}" bindtap="openMaterial">
      <view class="voyage-material-port"><view></view></view>
      <view class="voyage-selected-main"><view>{{item.title}}</view><text>{{item.countText}}</text></view>
      <view class="voyage-plan-link">{{item.stateText}}</view>
    </view>
  </view>

  <view class="voyage-plan-empty" wx:if="{{!levelLoading && !materials.length}}"><view>{{texts.allAdded}}</view><text>{{texts.allAddedHint}}</text></view>

  <view class="voyage-plan-actions">
    <view class="voyage-plan-clear {{selectedRows.length ? '' : 'is-disabled'}}" bindtap="clearPlan">{{texts.clear}}</view>
    <view class="voyage-plan-done" bindtap="finishPlan">{{texts.done}}</view>
  </view>
</view>

<view class="theme-{{theme}} page-shell library-plan-page language-{{language}}" wx:elif="{{theme === 'library'}}">
  <view class="library-plan-header">
    <view class="library-eyebrow">{{texts.eyebrow}}</view>
    <view class="library-plan-title">{{texts.title}}</view>
    <view class="library-muted">{{selectedLevel}} · {{texts.subtitle}}</view>
  </view>

  <view class="library-fixed-slip" wx:if="{{isYoyoFixedPlan}}" bindtap="openFixedStage">
    <view>
      <view class="library-row-title">{{texts.currentPlan}}</view>
      <view class="library-muted">A1 · {{fixedPlan.planPhaseLabel || texts.phase2}} · {{texts.fixedPlanKept}}</view>
    </view>
    <view class="library-brass-state">{{texts.view}}</view>
  </view>

  <view class="library-summary-sheet">
    <view class="library-summary-main">
      <view class="library-row-title">{{texts.todayRuler}}</view>
      <view class="library-muted">{{planSummaryText}}</view>
    </view>
    <view class="library-daily-seal">{{dailyTotal}}</view>
  </view>

  <view class="library-timeline" wx:if="{{selectedRows.length}}">
    <view class="library-timeline-row" wx:for="{{selectedRows}}" wx:key="category" data-category="{{item.category}}" data-level-id="{{item.levelId}}" bindtap="openMaterial">
      <view class="library-timeline-dot"></view>
      <view class="library-timeline-card">
        <view class="library-row-title">{{item.title}}</view>
        <view class="library-muted">{{item.meta}}</view>
      </view>
      <view class="library-brass-state">{{texts.edit}}</view>
    </view>
  </view>

  <view class="library-empty-slip" wx:if="{{!selectedRows.length}}">
    <view class="library-row-title">{{texts.empty}}</view>
    <view class="library-muted">{{texts.emptyHint}}</view>
  </view>

  <view class="library-section-title">{{texts.addMaterial}}</view>

  <view class="library-level-tabs">
    <view class="library-level-tab {{item.active ? 'is-active' : ''}} {{item.enabled ? '' : 'is-disabled'}}" wx:for="{{levelTabs}}" wx:key="levelId" data-enabled="{{item.enabled}}" data-level-id="{{item.levelId}}" bindtap="chooseLevel">
      {{item.levelId}}
    </view>
  </view>

  <view class="library-catalog-list">
    <view class="library-material-row {{item.disabled ? 'is-disabled' : ''}}" wx:for="{{materials}}" wx:key="category" data-category="{{item.category}}" data-level-id="{{item.levelId}}" data-disabled="{{item.disabled}}" bindtap="openMaterial">
      <view class="library-book-spine"></view>
      <view class="library-row-main">
        <view class="library-row-title">{{item.title}}</view>
        <view class="library-muted">{{item.countText}}</view>
      </view>
      <view class="library-brass-state">{{item.stateText}}</view>
    </view>
  </view>

  <view class="library-empty-slip" wx:if="{{!levelLoading && !materials.length}}">
    <view class="library-row-title">{{texts.allAdded}}</view>
    <view class="library-muted">{{texts.allAddedHint}}</view>
  </view>

  <view class="library-plan-actions">
    <view class="library-clear-action {{selectedRows.length ? '' : 'is-disabled'}}" bindtap="clearPlan">{{texts.clear}}</view>
    <view class="library-done-action" bindtap="finishPlan">{{texts.done}}</view>
  </view>
</view>

<view class="theme-{{theme}} page-shell listening-plan-page language-{{language}}" wx:else>
  <view class="plan-header">
    <view class="type-caption">{{texts.eyebrow}}</view>
    <view class="plan-title type-page-title">{{texts.title}}</view>
    <view class="type-caption">{{selectedLevel}} · {{texts.subtitle}}</view>
  </view>

  <view class="fixed-card" wx:if="{{isYoyoFixedPlan}}" bindtap="openFixedStage">
    <view>
      <view class="stage-row-title">{{texts.currentPlan}}</view>
      <view class="stage-row-meta type-caption">A1 · {{fixedPlan.planPhaseLabel || texts.phase2}} · {{texts.fixedPlanKept}}</view>
    </view>
    <view class="stage-row-state">{{texts.view}}</view>
  </view>

  <view class="selected-card">
    <view class="plan-wave-mark"><text></text><text></text><text></text></view>
    <view>
      <view class="selected-title">{{texts.eyebrow}}</view>
      <view class="selected-copy type-caption">{{planSummaryText}}</view>
    </view>
    <view class="selected-total">{{dailyTotal}}</view>
  </view>

  <view class="selected-list" wx:if="{{selectedRows.length}}">
    <block wx:for="{{selectedRows}}" wx:key="category">
      <view class="selected-row" data-category="{{item.category}}" data-level-id="{{item.levelId}}" bindtap="openMaterial">
        <view class="selected-row-main">
          <view class="selected-row-title">{{item.title}}</view>
          <view class="selected-row-meta type-caption">{{item.meta}}</view>
        </view>
        <view class="selected-row-action">{{texts.edit}}</view>
      </view>
    </block>
  </view>

  <view class="empty-plan" wx:if="{{!selectedRows.length}}">
    <view class="empty-plan-title">{{texts.empty}}</view>
    <view class="empty-plan-copy type-caption">{{texts.emptyHint}}</view>
  </view>

  <view class="section-label">{{texts.addMaterial}}</view>

  <view class="level-tabs">
    <block wx:for="{{levelTabs}}" wx:key="levelId">
      <view class="level-tab {{item.active ? 'is-active' : ''}} {{item.enabled ? '' : 'is-disabled'}}" data-enabled="{{item.enabled}}" data-level-id="{{item.levelId}}" bindtap="chooseLevel">
        {{item.levelId}}
      </view>
    </block>
  </view>

  <view class="stage-list">
    <block wx:for="{{materials}}" wx:key="category">
      <view class="stage-row {{item.disabled ? 'is-disabled' : ''}}" data-category="{{item.category}}" data-level-id="{{item.levelId}}" data-disabled="{{item.disabled}}" bindtap="openMaterial">
        <view class="stage-row-main">
          <view class="stage-row-title">{{item.title}}</view>
          <view class="stage-row-meta type-caption">{{item.countText}}</view>
        </view>
        <view class="stage-row-state">{{item.stateText}}</view>
      </view>
    </block>
  </view>

  <view class="empty-add" wx:if="{{!levelLoading && !materials.length}}">
    <view class="empty-plan-title">{{texts.allAdded}}</view>
    <view class="empty-plan-copy type-caption">{{texts.allAddedHint}}</view>
  </view>

  <view class="plan-actions">
    <view class="plan-action clear {{selectedRows.length ? '' : 'is-disabled'}}" bindtap="clearPlan">{{texts.clear}}</view>
    <view class="plan-action done" bindtap="finishPlan">{{texts.done}}</view>
  </view>
</view>
