<view class="theme-{{theme}} page-shell parent-detail-page">
  <view class="product-hero detail-hero">
    <view class="product-title type-page-title">{{report.dateLabel || '日报详情'}}</view>
    <view class="product-copy">{{report.completedCount}} / {{report.totalCount}} 项 · {{report.totalMinutes}} 分钟</view>
    <view class="sync-debug {{syncMode === 'cloud' ? 'is-cloud' : 'is-local'}}" wx:if="{{showCloudDebug && syncDebug && syncDebug.show}}">
      {{syncDebug.text}}
    </view>
  </view>

  <view class="section-panel">
    <view class="section-title type-section-title">任务完成情况</view>
    <block wx:if="{{report.items.length}}">
      <block wx:for="{{report.items}}" wx:key="category">
        <view class="detail-row task-cell">
          <view class="detail-main">
            <view class="detail-title">{{item.categoryLabel}}</view>
            <view class="detail-copy">{{item.title}}</view>
            <block wx:if="{{item.timeLines.length}}">
              <block wx:for="{{item.timeLines}}" wx:key="key" wx:for-item="time">
                <view class="detail-time-row">
                  <view class="detail-time-label">{{time.label}}</view>
                  <view class="detail-time-value">{{time.timeText}}</view>
                </view>
              </block>
            </block>
            <view class="detail-empty-time" wx:else>还没有完成时间记录</view>
          </view>
          <view class="detail-side">
            <view class="detail-status {{item.completedToday ? 'is-done' : ''}}">{{item.completedToday ? '完成' : '未完成'}}</view>
            <view class="detail-progress">{{item.playCount}} / {{item.repeatTarget}}</view>
          </view>
        </view>
      </block>
    </block>
    <view class="empty-state" wx:else>这一天还没有记录。</view>
  </view>

  <view class="section-panel">
    <view class="section-title type-section-title">录音记录</view>
    <block wx:if="{{report.speakingAttempts.length}}">
      <view class="recording-summary">
        <view class="recording-summary-item">
          <view class="recording-summary-value">{{report.speakingSummary.averageScore || 0}}</view>
          <view class="recording-summary-label">平均分</view>
        </view>
        <view class="recording-summary-item">
          <view class="recording-summary-value">{{report.speakingSummary.latestScore || 0}}</view>
          <view class="recording-summary-label">最近得分</view>
        </view>
        <view class="recording-summary-item">
          <view class="recording-summary-value">{{report.speakingSummary.scoredCount || 0}}/{{report.speakingSummary.totalCount || 0}}</view>
          <view class="recording-summary-label">已评分</view>
        </view>
      </view>
      <block wx:for="{{report.speakingAttempts}}" wx:key="key">
        <view class="recording-row">
          <view class="row-between recording-head">
            <view>
              <view class="detail-title">{{item.title}}</view>
              <view class="detail-copy">{{item.questionText}}</view>
            </view>
            <view class="recording-score">{{item.scoreText}}</view>
          </view>
          <view class="recording-score-detail" wx:if="{{item.scoreDetailText}}">{{item.scoreDetailText}}</view>
          <view class="recording-meta">
            <text wx:if="{{item.answerDurationText}}">录音 {{item.answerDurationText}}</text>
            <text wx:if="{{item.createdTimeText}}"> · {{item.createdTimeText}}</text>
          </view>
          <view class="recording-text" wx:if="{{item.studentTranscript}}">孩子回答：{{item.studentTranscript}}</view>
          <view class="recording-text" wx:if="{{item.feedback}}">建议：{{item.feedback}}</view>
          <button class="player-action attempt-play {{loadingAttemptKey === item.key && playingAttemptKey !== item.key ? 'is-disabled' : ''}}" data-index="{{index}}" bindtap="playSpeakingAttempt">
            {{playingAttemptKey === item.key ? (pausedAttemptKey === item.key ? '继续播放' : '暂停录音') : '播放录音'}}
          </button>
        </view>
      </block>
    </block>
    <view class="empty-state" wx:else>这一天还没有录音。</view>
  </view>

  <view class="section-panel">
    <view class="section-title type-section-title">阅读/语法/写作</view>
    <block wx:if="{{report.completionItems.length}}">
      <block wx:for="{{report.completionItems}}" wx:key="key">
        <view class="study-record-row">
          <view class="row-between recording-head">
            <view>
              <view class="detail-title">{{item.typeLabel}} · {{item.title}}</view>
              <view class="detail-copy">{{item.meta}}</view>
            </view>
            <view class="recording-score">{{item.scoreText || item.progressText}}</view>
          </view>
          <view class="recording-meta" wx:if="{{item.correctText}}">答题：{{item.correctText}}</view>
          <button class="detail-toggle" data-key="{{item.key}}" catchtap="toggleCompletionDetail">{{item.expanded ? '收起详情' : '查看原题和分析'}}</button>
          <block wx:if="{{item.expanded}}">
            <view class="source-passage" wx:if="{{item.passage && item.passage.passage}}">
              <view class="question-review-title">原文</view>
              <view class="recording-text">{{item.passage.passage}}</view>
            </view>
            <view class="source-passage" wx:if="{{item.writingPrompt && item.writingPrompt.prompt}}">
              <view class="question-review-title">作文题目</view>
              <view class="recording-text">{{item.writingPrompt.prompt}}</view>
            </view>
            <view class="source-passage" wx:if="{{item.essay}}">
              <view class="question-review-title">学生作文</view>
              <view class="recording-text">{{item.essay}}</view>
            </view>
            <view class="recording-text" wx:if="{{item.reviewSummary}}">分析：{{item.reviewSummary}}</view>
            <view class="recording-text" wx:if="{{item.reviewContent}}">内容：{{item.reviewContent}}</view>
            <view class="recording-text" wx:if="{{item.reviewLanguage}}">语言：{{item.reviewLanguage}}</view>
            <view class="recording-text" wx:if="{{item.reviewStructure}}">结构：{{item.reviewStructure}}</view>
            <view class="recording-text" wx:if="{{item.reviewSpelling}}">拼写：{{item.reviewSpelling}}</view>
            <view class="recording-text" wx:if="{{item.reviewProblemsText}}">问题：{{item.reviewProblemsText}}</view>
            <view class="recording-text" wx:if="{{item.reviewSuggestionsText}}">建议：{{item.reviewSuggestionsText}}</view>
            <view class="source-passage" wx:if="{{item.polishedVersion}}">
              <view class="question-review-title">参考范文</view>
              <view class="recording-text">{{item.polishedVersion}}</view>
            </view>
            <block wx:if="{{item.grammarQuestions.length}}">
              <view class="question-review" wx:for="{{item.grammarQuestions}}" wx:key="key" wx:for-item="question">
                <view class="question-review-title">第 {{question.number}} 题 · {{question.isCorrect ? '正确' : '订正'}} · 答案 {{question.answer}}</view>
                <view class="recording-text">{{question.prompt}}</view>
                <view class="recording-text" wx:for="{{question.optionsList}}" wx:key="key" wx:for-item="option">{{option.key}}. {{option.text}}</view>
                <view class="recording-text">孩子选择：{{question.selectedAnswer || '旧记录未保存选择'}}</view>
                <view class="recording-text" wx:if="{{question.explanation && question.explanation.explanation}}">分析：{{question.explanation.explanation}}</view>
                <view class="recording-text" wx:if="{{question.explanation && question.explanation.elimination}}">{{question.explanation.elimination}}</view>
              </view>
            </block>
            <block wx:if="{{item.readingQuestions.length}}">
              <view class="question-review" wx:for="{{item.readingQuestions}}" wx:key="key" wx:for-item="question">
                <view class="question-review-title">第 {{question.number}} 题 · {{question.correct ? '正确' : '订正'}} · 答案 {{question.answer}}</view>
                <view class="recording-text" wx:if="{{question.prompt}}">{{question.prompt}}</view>
                <view class="recording-text" wx:for="{{question.optionsList}}" wx:key="key" wx:for-item="option">{{option.key}}. {{option.text}}</view>
                <view class="recording-text" wx:if="{{question.selectedAnswer}}">孩子选择：{{question.selectedAnswer}}</view>
                <view class="recording-text" wx:if="{{question.analysis}}">{{question.analysis}}</view>
                <view class="recording-text" wx:if="{{question.answerSentence && question.answerSentence.text}}">定位句：{{question.answerSentence.text}}</view>
                <view class="recording-text" wx:if="{{question.answerSentence && question.answerSentence.translation}}">译文：{{question.answerSentence.translation}}</view>
              </view>
            </block>
          </block>
        </view>
      </block>
    </block>
    <view class="empty-state" wx:else>这一天还没有阅读、语法、写作记录。</view>
  </view>
</view>
