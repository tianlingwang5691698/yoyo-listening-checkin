<view class="theme-{{theme}} page-shell parent-detail-page">
  <view class="product-hero detail-hero">
    <view class="product-title type-page-title">{{report.dateLabel || '日报详情'}}</view>
    <view class="product-copy">{{report.completedCount}} / {{report.totalCount}} 项 · {{report.totalMinutes}} 分钟</view>
    <view class="sync-debug {{syncMode === 'cloud' ? 'is-cloud' : 'is-local'}}" wx:if="{{showCloudDebug && syncDebug && syncDebug.show}}">
      {{syncDebug.text}}
    </view>
  </view>

  <view class="section-panel">
    <view class="section-title type-section-title">任务完成情况</view>
    <block wx:if="{{report.items.length}}">
      <block wx:for="{{report.items}}" wx:key="category">
        <view class="detail-row task-cell">
          <view class="detail-main">
            <view class="detail-title">{{item.categoryLabel}}</view>
            <view class="detail-copy">{{item.title}}</view>
            <block wx:if="{{item.timeLines.length}}">
              <block wx:for="{{item.timeLines}}" wx:key="key" wx:for-item="time">
                <view class="detail-time-row">
                  <view class="detail-time-label">{{time.label}}</view>
                  <view class="detail-time-value">{{time.timeText}}</view>
                </view>
              </block>
            </block>
            <view class="detail-empty-time" wx:else>还没有完成时间记录</view>
          </view>
          <view class="detail-side">
            <view class="detail-status {{item.completedToday ? 'is-done' : ''}}">{{item.completedToday ? '完成' : '未完成'}}</view>
            <view class="detail-progress">{{item.playCount}} / {{item.repeatTarget}}</view>
          </view>
        </view>
      </block>
    </block>
    <view class="empty-state" wx:else>这一天还没有记录。</view>
  </view>

  <view class="section-panel">
    <view class="section-title type-section-title">录音记录</view>
    <block wx:if="{{report.speakingAttempts.length}}">
      <view class="recording-summary">
        <view class="recording-summary-item">
          <view class="recording-summary-value">{{report.speakingSummary.averageScore || 0}}</view>
          <view class="recording-summary-label">平均分</view>
        </view>
        <view class="recording-summary-item">
          <view class="recording-summary-value">{{report.speakingSummary.latestScore || 0}}</view>
          <view class="recording-summary-label">最近得分</view>
        </view>
        <view class="recording-summary-item">
          <view class="recording-summary-value">{{report.speakingSummary.scoredCount || 0}}/{{report.speakingSummary.totalCount || 0}}</view>
          <view class="recording-summary-label">已评分</view>
        </view>
      </view>
      <block wx:for="{{report.speakingAttempts}}" wx:key="key">
        <view class="recording-row">
          <view class="row-between recording-head">
            <view>
              <view class="detail-title">{{item.title}}</view>
              <view class="detail-copy">{{item.questionText}}</view>
            </view>
            <view class="recording-score">{{item.scoreText}}</view>
          </view>
          <view class="recording-score-detail" wx:if="{{item.scoreDetailText}}">{{item.scoreDetailText}}</view>
          <view class="recording-meta">
            <text wx:if="{{item.answerDurationText}}">录音 {{item.answerDurationText}}</text>
            <text wx:if="{{item.createdTimeText}}"> · {{item.createdTimeText}}</text>
          </view>
          <view class="recording-text" wx:if="{{item.studentTranscript}}">孩子回答：{{item.studentTranscript}}</view>
          <view class="recording-text" wx:if="{{item.feedback}}">建议：{{item.feedback}}</view>
          <button class="player-action attempt-play {{loadingAttemptKey === item.key && playingAttemptKey !== item.key ? 'is-disabled' : ''}}" data-index="{{index}}" bindtap="playSpeakingAttempt">
            {{playingAttemptKey === item.key ? (pausedAttemptKey === item.key ? '继续播放' : '暂停录音') : (loadingAttemptKey === item.key ? '加载中' : '播放录音')}}
          </button>
        </view>
      </block>
    </block>
    <view class="empty-state" wx:else>这一天还没有录音。</view>
  </view>
</view>
