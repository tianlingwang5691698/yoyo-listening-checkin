.detail-hero {
  background: var(--surface);
}

.detail-row {
  margin-top: 18rpx;
  align-items: center;
}

.detail-main {
  flex: 1;
  min-width: 0;
}

.detail-title {
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
  color: var(--text-main);
}

.detail-copy {
  margin-top: 8rpx;
  font-size: var(--font-caption-size);
  line-height: 1.6;
  color: var(--text-muted);
}

.detail-time-row {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.detail-time-label {
  font-size: var(--font-caption-size);
  color: var(--text-muted);
}

.detail-time-value {
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
  color: var(--text-main);
}

.detail-empty-time {
  margin-top: 10rpx;
  font-size: var(--font-caption-size);
  color: var(--text-light);
}

.detail-side {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.detail-status,
.detail-progress {
  min-width: 120rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.detail-status {
  background: var(--control-muted-bg);
  color: var(--text-muted);
}

.detail-status.is-done {
  background: var(--growth-soft);
  color: var(--growth-deep);
}

.detail-progress {
  background: var(--control-muted-bg);
  color: var(--text-main);
}

.sync-debug {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  font-size: var(--font-caption-size);
  line-height: 1.5;
  background: var(--surface-glass);
  color: var(--text-muted);
}

.sync-debug.is-cloud {
  background: var(--growth-soft);
  color: var(--growth-deep);
}

.sync-debug.is-local {
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.recording-row {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--border-soft);
}

.study-record-row {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid var(--border-soft);
  border-radius: 20rpx;
  background: var(--surface-subtle);
}

.lazy-load-row {
  margin-top: 18rpx;
  align-items: center;
}

.lazy-load-side {
  margin-left: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.lazy-load-badge {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.lazy-load-arrow {
  font-size: 34rpx;
  color: var(--text-muted);
}

.question-review {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--border-soft);
}

.source-passage {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: var(--surface);
}

.detail-toggle {
  width: 100%;
  height: 64rpx;
  margin: 16rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  line-height: 64rpx;
  font-weight: var(--font-title-weight);
}

.detail-toggle::after {
  border: none;
}

.question-review-title {
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
  color: var(--text-main);
}

.recording-summary {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.recording-summary-item {
  padding: 18rpx 12rpx;
  border-radius: 20rpx;
  background: var(--control-muted-bg);
  text-align: center;
}

.recording-summary-value {
  font-size: 32rpx;
  font-weight: var(--font-title-weight);
  color: var(--text-main);
}

.recording-summary-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.recording-head {
  align-items: flex-start;
  gap: 18rpx;
}

.recording-score {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.recording-meta,
.recording-score-detail,
.recording-text {
  margin-top: 10rpx;
  font-size: var(--font-caption-size);
  line-height: 1.6;
  color: var(--text-muted);
}

.recording-text {
  color: var(--text-main);
}

.attempt-play {
  margin-top: 16rpx;
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 1rpx solid var(--border-soft);
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--text-main);
  font-size: var(--font-body-size);
  font-weight: var(--font-title-weight);
  line-height: 72rpx;
  box-shadow: 0 10rpx 24rpx rgba(42, 32, 22, 0.06);
}

.attempt-play::after {
  border: none;
}

.attempt-play.is-playing {
  background: var(--accent-soft);
  color: var(--accent-deep);
  border-color: transparent;
}

.attempt-play.is-loading {
  opacity: 0.7;
}

.attempt-play-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent);
  color: var(--accent-contrast);
  font-size: 18rpx;
  line-height: 32rpx;
}

.attempt-play-icon::before {
  content: "";
  width: 0;
  height: 0;
  margin-left: 3rpx;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 11rpx solid var(--accent-contrast);
}

.attempt-play.is-playing:not(.is-paused) .attempt-play-icon::before {
  width: 4rpx;
  height: 14rpx;
  margin-left: 0;
  border: none;
  background: var(--accent-contrast);
  box-shadow: 8rpx 0 0 var(--accent-contrast);
}
