.parent-page {
  min-height: 100vh;
  padding-bottom: 150rpx;
  background:
    radial-gradient(circle at 80% 6%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0) 32%),
    linear-gradient(160deg, #f8fbfd 0%, #edf6fa 52%, #f7fbfd 100%);
}

.parent-hero,
.daily-brief,
.insight-panel,
.today-archive,
.trend-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 36rpx;
  background: rgba(246, 251, 253, 0.74);
  box-shadow: 0 18rpx 44rpx rgba(78, 112, 139, 0.1);
  box-sizing: border-box;
}

.parent-hero {
  margin-top: 56rpx;
  padding: 38rpx 34rpx 34rpx;
  background:
    linear-gradient(138deg, rgba(255, 255, 255, 0.88), rgba(221, 238, 248, 0.64)),
    rgba(236, 247, 251, 0.86);
}

.parent-identity,
.child-line,
.brief-head,
.panel-head,
.trend-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.parent-kicker,
.brief-kicker {
  color: #607087;
  font-size: var(--font-caption-size);
  line-height: var(--line-caption);
  font-weight: 600;
}

.parent-title {
  margin-top: 10rpx;
  color: #17314f;
  font-size: 50rpx;
  line-height: 1.12;
  font-weight: 600;
}

.family-orbit {
  position: relative;
  flex-shrink: 0;
  width: 112rpx;
  height: 82rpx;
  opacity: 0.45;
}

.family-orbit text {
  position: absolute;
  left: 50%;
  top: 50%;
  border: 2rpx solid #8db7d4;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.family-orbit text:nth-child(1) {
  width: 104rpx;
  height: 42rpx;
}

.family-orbit text:nth-child(2) {
  width: 68rpx;
  height: 28rpx;
}

.family-orbit text:nth-child(3) {
  width: 16rpx;
  height: 16rpx;
  background: #8db7d4;
}

.child-line {
  margin-top: 34rpx;
  align-items: center;
}

.child-name {
  color: #17314f;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 600;
}

.child-code {
  margin-top: 10rpx;
  color: #607087;
  font-size: var(--font-caption-size);
}

.student-switch,
.brief-action,
.archive-link,
.detail-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(221, 238, 248, 0.72);
  color: #17314f;
  font-size: var(--font-caption-size);
  font-weight: 600;
  white-space: nowrap;
}

.daily-brief {
  margin-top: 24rpx;
  padding: 34rpx;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.88), rgba(229, 243, 241, 0.62)),
    rgba(246, 251, 253, 0.78);
}

.brief-date {
  flex-shrink: 0;
  color: #728196;
  font-size: var(--font-caption-size);
  line-height: 1.4;
}

.brief-title {
  margin-top: 12rpx;
  color: #17314f;
  font-size: 40rpx;
  line-height: 1.22;
  font-weight: 600;
}

.brief-copy {
  margin-top: 24rpx;
  color: #17314f;
  font-size: 30rpx;
  line-height: 1.62;
  font-weight: 500;
}

.brief-note {
  margin-top: 12rpx;
  color: #607087;
  font-size: var(--font-body-size);
  line-height: var(--line-body);
}

.brief-progress {
  margin: 30rpx 0 26rpx;
  display: grid;
  grid-template-columns: 28rpx 1fr 28rpx 1fr 28rpx;
  align-items: center;
  gap: 10rpx;
}

.progress-node {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(141, 183, 212, 0.22);
}

.progress-node.is-active {
  background: #86aaa1;
  box-shadow: 0 0 0 10rpx rgba(134, 170, 161, 0.12);
}

.progress-line {
  height: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(141, 183, 212, 0.56), rgba(141, 183, 212, 0.12));
}

.brief-action {
  background: linear-gradient(135deg, #f2a18e, #df8068);
  color: #fffafa;
  box-shadow: 0 16rpx 30rpx rgba(223, 128, 104, 0.18);
}

.insight-panel,
.trend-card {
  margin-top: 24rpx;
  padding: 32rpx 28rpx;
}

.section-title {
  color: #17314f;
  font-weight: 600;
}

.section-copy {
  margin-top: 8rpx;
  color: #607087;
  font-size: var(--font-caption-size);
  line-height: var(--line-caption);
}

.insight-map {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.insight-card {
  position: relative;
  min-height: 150rpx;
  padding: 20rpx;
  border-radius: 26rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.82), rgba(221, 238, 248, 0.42)),
    rgba(246, 251, 253, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  overflow: hidden;
  box-sizing: border-box;
}

.module-reading,
.module-speaking {
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.82), rgba(229, 243, 241, 0.54)),
    rgba(246, 251, 253, 0.78);
}

.module-writing {
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.82), rgba(242, 161, 142, 0.16)),
    rgba(246, 251, 253, 0.78);
}

.insight-symbol {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  display: flex;
  align-items: flex-end;
  gap: 5rpx;
  opacity: 0.26;
}

.insight-symbol text {
  width: 6rpx;
  border-radius: 999rpx;
  background: #8db7d4;
}

.insight-symbol text:nth-child(1) { height: 16rpx; }
.insight-symbol text:nth-child(2) { height: 30rpx; }
.insight-symbol text:nth-child(3) { height: 22rpx; }

.module-label {
  color: #17314f;
  font-size: var(--font-body-size);
  font-weight: 600;
}

.module-count {
  margin-top: 16rpx;
  color: #17314f;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 600;
}

.module-unit {
  margin-left: 6rpx;
  color: #607087;
  font-size: var(--font-caption-size);
  font-weight: 500;
}

.module-copy {
  margin-top: 14rpx;
  color: #607087;
  font-size: var(--font-caption-size);
  line-height: 1.38;
}

.today-archive {
  margin-top: 24rpx;
  padding: 28rpx 28rpx 28rpx 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.archive-ribbon {
  position: absolute;
  left: 30rpx;
  top: 28rpx;
  bottom: 28rpx;
  width: 30rpx;
  border-radius: 999rpx;
  background:
    repeating-linear-gradient(180deg, #8db7d4 0, #8db7d4 12rpx, transparent 12rpx, transparent 24rpx),
    rgba(221, 238, 248, 0.72);
}

.archive-title {
  color: #17314f;
  font-size: var(--font-control-size);
  line-height: 1.2;
  font-weight: 600;
}

.archive-copy {
  margin-top: 10rpx;
  color: #607087;
  font-size: var(--font-caption-size);
  line-height: 1.45;
}

.trend-head {
  align-items: center;
}

.rhythm-strip {
  margin-top: 24rpx;
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
  padding-bottom: 4rpx;
}

.rhythm-day {
  flex: 0 0 150rpx;
  min-height: 158rpx;
  padding: 18rpx 16rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  box-sizing: border-box;
}

.rhythm-day.is-active {
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.86), rgba(221, 238, 248, 0.58));
}

.rhythm-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: rgba(141, 183, 212, 0.32);
}

.rhythm-day.is-active .rhythm-dot {
  background: #86aaa1;
}

.rhythm-date {
  margin-top: 18rpx;
  color: #17314f;
  font-size: var(--font-caption-size);
  font-weight: 600;
}

.rhythm-copy,
.rhythm-minutes {
  margin-top: 8rpx;
  color: #607087;
  font-size: 22rpx;
  line-height: 1.35;
}

.sync-debug {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  font-size: var(--font-caption-size);
  line-height: 1.5;
  background: rgba(246, 251, 253, 0.72);
  color: #607087;
}

.sync-debug.is-cloud {
  background: rgba(221, 238, 248, 0.72);
  color: #17314f;
}

.sync-debug.is-local {
  background: rgba(242, 161, 142, 0.16);
  color: #17314f;
}
