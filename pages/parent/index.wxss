.parent-hero {
  background: var(--surface);
}

.parent-id {
  margin-top: 12rpx;
  text-align: center;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.student-switch {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  margin-top: 18rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--text-main);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.module-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.module-card {
  min-height: 112rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: var(--surface-subtle);
  box-sizing: border-box;
}

.module-count {
  margin-top: 10rpx;
  color: var(--text-main);
  font-size: 38rpx;
  line-height: 1.1;
  font-weight: var(--font-section-heading-weight);
}

.module-unit {
  margin-left: 6rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.module-label {
  color: var(--text-main);
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
}

.module-copy {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.4;
}

.report-head {
  align-items: flex-start;
}

.report-item,
.trend-row {
  margin-top: 18rpx;
}

.detail-link {
  padding: 10rpx 0 10rpx 20rpx;
  font-size: var(--font-body-size);
  font-weight: var(--font-title-weight);
  color: var(--text-muted);
}

.report-title,
.trend-date {
  font-size: var(--font-control-size);
  font-weight: var(--font-title-weight);
  color: var(--text-main);
}

.report-copy,
.trend-copy {
  margin-top: 8rpx;
  font-size: var(--font-caption-size);
  line-height: 1.6;
  color: var(--text-muted);
}

.report-progress,
.trend-badge {
  flex-shrink: 0;
  min-width: 112rpx;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  text-align: center;
  background: var(--control-muted-bg);
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.report-progress.is-done {
  background: var(--growth-soft);
  color: var(--growth-deep);
}

.is-link {
  align-items: center;
}

.trend-side {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.trend-arrow {
  color: var(--text-muted);
  font-size: var(--font-section-title-size);
  line-height: 1;
}

.sync-debug {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  font-size: var(--font-caption-size);
  line-height: 1.5;
  background: var(--surface-glass);
  color: var(--text-muted);
}

.sync-debug.is-cloud {
  background: var(--growth-soft);
  color: var(--growth-deep);
}

.sync-debug.is-local {
  background: var(--accent-soft);
  color: var(--accent-deep);
}
