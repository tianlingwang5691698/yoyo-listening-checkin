<view class="theme-{{theme}} language-{{language}} page-shell admin-page">
  <view wx:if="{{theme === 'library'}}" class="library-admin">
    <view class="library-ledger-head">
      <view>
        <view class="library-kicker">Admin Ledger</view>
        <view class="library-title">{{texts.archiveTitle}}</view>
        <view class="library-copy">{{texts.defaultCopy}}</view>
      </view>
      <view class="ledger-total">{{activeTotal}} {{texts.activeUsers}}</view>
    </view>

    <view class="library-ledger">
      <view class="library-card-head">
        <view class="library-title small">{{listMode === 'inactive' ? texts.inactiveUsers : texts.activeUsers}}</view>
        <view class="ledger-tabs">
          <view class="ledger-tab {{listMode === 'active' ? 'is-active' : ''}}" data-mode="active" bindtap="switchListMode">{{texts.active}} {{activeTotal}}</view>
          <view class="ledger-tab {{listMode === 'inactive' ? 'is-active' : ''}}" data-mode="inactive" bindtap="switchListMode">{{texts.inactive}} {{inactiveTotal}}</view>
        </view>
      </view>
      <view class="admin-skeleton" wx:if="{{loading}}">
        <view></view><view></view><view></view>
      </view>
      <view class="library-admin-error" wx:elif="{{errorText}}">
        <view class="entry-title">{{texts.unavailable}}</view>
        <view class="entry-copy">{{errorText}}</view>
        <view class="library-link" bindtap="loadAdminData">{{texts.retry}}</view>
      </view>
      <view class="library-empty" wx:elif="{{!visibleRows.length}}">{{texts.noUsers}}</view>
      <block wx:else>
        <view class="ledger-row" wx:for="{{visibleRows}}" wx:key="childId" wx:for-index="rowIndex">
          <view class="library-card-head">
            <view class="entry-main">
              <view class="entry-title">{{item.childDisplayNickname}}</view>
              <view class="entry-copy">{{item.activityText}}</view>
            </view>
            <view class="ledger-side">
              <view class="library-stamp">{{item.userRole === 'parent' ? texts.parent : texts.student}}</view>
              <view class="entry-copy" wx:if="{{item.parentCount}}">{{item.parentCount}} {{texts.parent}}</view>
              <view class="library-link" data-index="{{rowIndex}}" bindtap="toggleRowExpanded">{{item.expanded ? texts.collapse : texts.expand}}</view>
            </view>
          </view>
          <view wx:if="{{item.expanded}}">
            <view class="ledger-detail-row">
              <view>ID</view>
              <text>{{item.childLoginCode || texts.notGenerated}}</text>
            </view>
            <view class="ledger-detail-row" wx:if="{{item.parentNames}}">
              <view>{{texts.parent}}</view>
              <text>{{item.parentNames}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <block wx:else>
    <view class="admin-hero product-hero">
      <view class="voyage-captain-badge" wx:if="{{theme === 'voyage'}}">☸</view>
      <view class="product-title type-page-title">{{texts.navTitle}}</view>
      <view class="product-copy">{{texts.defaultCopy}}</view>
      <view class="admin-total">{{activeTotal}} {{texts.activeUsers}}</view>
    </view>

    <view class="section-panel">
      <view class="section-head">
        <view class="section-title type-section-title">{{listMode === 'inactive' ? texts.inactiveUsers : texts.activeUsers}}</view>
        <view class="admin-tabs">
          <view class="admin-tab {{listMode === 'active' ? 'is-active' : ''}}" data-mode="active" bindtap="switchListMode">{{texts.active}} {{activeTotal}}</view>
          <view class="admin-tab {{listMode === 'inactive' ? 'is-active' : ''}}" data-mode="inactive" bindtap="switchListMode">{{texts.inactive}} {{inactiveTotal}}</view>
        </view>
      </view>
    <view class="admin-skeleton" wx:if="{{loading}}">
      <view></view><view></view><view></view>
    </view>
      <view class="admin-error" wx:elif="{{errorText}}">
        <view class="admin-error-title">{{texts.unavailable}}</view>
        <view class="admin-error-copy">{{errorText}}</view>
        <view class="admin-retry" bindtap="loadAdminData">{{texts.retry}}</view>
      </view>
      <view class="empty-state" wx:elif="{{!visibleRows.length}}">{{texts.noUsers}}</view>
      <block wx:else>
        <view class="admin-card" wx:for="{{visibleRows}}" wx:key="childId" wx:for-index="rowIndex">
          <view class="admin-head">
            <view>
              <view class="admin-name">{{item.childDisplayNickname}}</view>
              <view class="admin-activity">{{item.activityText}}</view>
            </view>
            <view class="admin-side">
              <view class="member-role">{{item.userRole === 'parent' ? texts.parent : texts.student}}</view>
              <view class="admin-count" wx:if="{{item.parentCount}}">{{item.parentCount}} {{texts.parent}}</view>
              <view class="detail-toggle" data-index="{{rowIndex}}" bindtap="toggleRowExpanded">{{item.expanded ? texts.collapse : texts.expand}}</view>
            </view>
          </view>

          <view wx:if="{{item.expanded}}">
            <view class="admin-simple-row">
              <view class="admin-simple-label">ID</view>
              <view class="admin-simple-value">{{item.childLoginCode || texts.notGenerated}}</view>
            </view>
            <view class="admin-simple-row" wx:if="{{item.parentNames}}">
              <view class="admin-simple-label">{{texts.parent}}</view>
              <view class="admin-simple-value">{{item.parentNames}}</view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </block>
</view>
