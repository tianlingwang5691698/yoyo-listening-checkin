.admin-hero {
  background: var(--surface);
}

.admin-total {
  margin-top: 14rpx;
  color: var(--accent-deep);
  font-size: var(--font-section-title-size);
  font-weight: var(--font-title-weight);
}

.admin-card {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.admin-card:last-child {
  border-bottom: none;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.admin-tabs {
  flex-shrink: 0;
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 8rpx;
  background: var(--surface-subtle);
}

.admin-tab {
  padding: 10rpx 14rpx;
  border-radius: 6rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1;
}

.admin-tab.is-active {
  background: var(--surface);
  color: var(--accent-deep);
  font-weight: var(--font-caption-weight);
}

.admin-head,
.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.admin-name {
  color: var(--text-main);
  font-size: var(--font-card-title-size);
  font-weight: var(--font-title-weight);
}

.admin-activity {
  margin-top: 6rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.45;
}

.admin-code,
.admin-family,
.member-id {
  margin-top: 6rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.45;
  word-break: break-all;
}

.admin-code {
  color: var(--text-main);
  font-weight: var(--font-caption-weight);
}

.detail-toggle {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-caption-weight);
}

.detail-toggle.is-inline {
  display: inline-block;
  margin-top: 8rpx;
}

.admin-count,
.member-role {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
}

.admin-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.admin-subtitle {
  margin-top: 24rpx;
  color: var(--text-main);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.admin-simple-row {
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 16rpx;
}

.admin-simple-label {
  flex-shrink: 0;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.admin-simple-value {
  min-width: 0;
  color: var(--text-main);
  font-size: var(--font-caption-size);
  font-weight: var(--font-caption-weight);
  text-align: right;
  word-break: break-all;
}

.empty-inline {
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.admin-error {
  padding: 28rpx 0 10rpx;
}

.admin-error-title {
  color: var(--text-main);
  font-size: var(--font-section-title-size);
  font-weight: var(--font-title-weight);
}

.admin-error-copy {
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.7;
  word-break: break-all;
}

.diagnostic-row {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.diagnostic-row:last-child {
  border-bottom: none;
}

.diagnostic-label {
  flex-shrink: 0;
  color: var(--text-main);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.diagnostic-value {
  min-width: 0;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.45;
  text-align: right;
  word-break: break-all;
}

.admin-retry {
  margin-top: 22rpx;
  width: 160rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--text-main);
  font-size: var(--font-caption-size);
  line-height: 60rpx;
  text-align: center;
  font-weight: var(--font-title-weight);
}

.member-row {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  background: var(--surface-subtle);
}

.member-row.is-muted {
  background: rgba(47, 43, 39, 0.035);
}

.member-name {
  color: var(--text-main);
  font-size: var(--font-body-size);
  font-weight: var(--font-caption-weight);
}
