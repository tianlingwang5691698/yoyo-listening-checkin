.admin-hero {
  background: var(--surface);
}

.admin-total {
  margin-top: 14rpx;
  color: var(--accent-deep);
  font-size: var(--font-section-title-size);
  font-weight: var(--font-title-weight);
}

.admin-card {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.admin-card:last-child {
  border-bottom: none;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.admin-tabs {
  flex-shrink: 0;
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 8rpx;
  background: var(--surface-subtle);
}

.admin-tab {
  padding: 10rpx 14rpx;
  border-radius: 6rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1;
}

.admin-tab.is-active {
  background: var(--surface);
  color: var(--accent-deep);
  font-weight: var(--font-caption-weight);
}

.admin-head,
.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.admin-name {
  color: var(--text-main);
  font-size: var(--font-card-title-size);
  font-weight: var(--font-title-weight);
}

.admin-activity {
  margin-top: 6rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.45;
}

.admin-code,
.admin-family,
.member-id {
  margin-top: 6rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.45;
  word-break: break-all;
}

.admin-code {
  color: var(--text-main);
  font-weight: var(--font-caption-weight);
}

.detail-toggle {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
  font-weight: var(--font-caption-weight);
}

.detail-toggle.is-inline {
  display: inline-block;
  margin-top: 8rpx;
}

.admin-count,
.member-role {
  flex-shrink: 0;
  color: var(--accent-deep);
  font-size: var(--font-caption-size);
}

.admin-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.admin-subtitle {
  margin-top: 24rpx;
  color: var(--text-main);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.admin-simple-row {
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 16rpx;
}

.admin-simple-label {
  flex-shrink: 0;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.admin-simple-value {
  min-width: 0;
  color: var(--text-main);
  font-size: var(--font-caption-size);
  font-weight: var(--font-caption-weight);
  text-align: right;
  word-break: break-all;
}

.empty-inline {
  margin-top: 14rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
}

.admin-error {
  padding: 28rpx 0 10rpx;
}

.admin-skeleton {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 12rpx 0;
}

.admin-skeleton view {
  height: 112rpx;
  border-radius: var(--radius-lg);
  background: var(--surface-soft);
  opacity: 0.65;
}

.admin-error-title {
  color: var(--text-main);
  font-size: var(--font-section-title-size);
  font-weight: var(--font-title-weight);
}

.admin-error-copy {
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.7;
  word-break: break-all;
}

.diagnostic-row {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.diagnostic-row:last-child {
  border-bottom: none;
}

.diagnostic-label {
  flex-shrink: 0;
  color: var(--text-main);
  font-size: var(--font-caption-size);
  font-weight: var(--font-title-weight);
}

.diagnostic-value {
  min-width: 0;
  color: var(--text-muted);
  font-size: var(--font-caption-size);
  line-height: 1.45;
  text-align: right;
  word-break: break-all;
}

.admin-retry {
  margin-top: 22rpx;
  width: 160rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: var(--control-muted-bg);
  color: var(--text-main);
  font-size: var(--font-caption-size);
  line-height: 60rpx;
  text-align: center;
  font-weight: var(--font-title-weight);
}

.member-row {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  background: var(--surface-subtle);
}

.member-row.is-muted {
  background: rgba(47, 43, 39, 0.035);
}

.member-name {
  color: var(--text-main);
  font-size: var(--font-body-size);
  font-weight: var(--font-caption-weight);
}

.theme-library.admin-page {
  padding: 56rpx 28rpx 150rpx;
  background:
    linear-gradient(180deg, rgba(43, 33, 27, 0.86) 0, rgba(43, 33, 27, 0.86) 166rpx, transparent 166rpx),
    linear-gradient(135deg, #faf5ea 0%, #f3e8d4 100%);
  color: #14283a;
}

.library-ledger-head,
.library-ledger,
.ledger-row,
.library-admin-error,
.library-empty {
  border-radius: 8px;
  border: 1rpx solid rgba(184, 149, 98, 0.42);
  box-shadow: 0 6rpx 18rpx rgba(43, 33, 27, 0.12);
  box-sizing: border-box;
}

.library-ledger-head {
  min-height: 184rpx;
  padding: 30rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  background: #2b211b;
}

.library-kicker {
  color: #b89562;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
}

.library-title {
  margin-top: 8rpx;
  color: #faf5ea;
  font-family: "Songti SC", serif;
  font-size: 44rpx;
  line-height: 1.16;
  font-weight: 600;
}

.library-title.small,
.entry-title {
  color: #14283a;
  font-family: "PingFang SC", sans-serif;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 600;
}

.library-copy,
.entry-copy {
  margin-top: 10rpx;
  color: #6f675f;
  font-size: 24rpx;
  line-height: 1.5;
}

.ledger-total {
  flex-shrink: 0;
  padding: 12rpx 16rpx;
  border-radius: 8px;
  border: 1rpx solid rgba(184, 149, 98, 0.72);
  color: #f3e8d4;
  font-size: 22rpx;
  font-weight: 600;
}

.library-ledger {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #faf5ea;
}

.library-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.ledger-tabs {
  flex-shrink: 0;
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 8px;
  background: #f3e8d4;
}

.ledger-tab {
  min-height: 48rpx;
  padding: 0 14rpx;
  border-radius: 6px;
  color: #6f675f;
  font-size: 22rpx;
  line-height: 48rpx;
  font-weight: 600;
}

.ledger-tab.is-active {
  background: #14283a;
  color: #faf5ea;
}

.ledger-row {
  margin-top: 18rpx;
  padding: 22rpx;
  background: #f3e8d4;
}

.entry-main {
  flex: 1;
  min-width: 0;
}

.ledger-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.library-stamp {
  min-height: 44rpx;
  padding: 0 14rpx;
  border: 1rpx solid rgba(184, 149, 98, 0.72);
  border-radius: 8px;
  color: #b89562;
  font-size: 22rpx;
  line-height: 44rpx;
  font-weight: 600;
}

.library-link {
  color: #14283a;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 600;
}

.ledger-detail-row {
  min-height: 58rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-top: 1rpx solid rgba(184, 149, 98, 0.24);
  color: #6f675f;
  font-size: 24rpx;
}

.ledger-detail-row text {
  min-width: 0;
  color: #14283a;
  font-weight: 600;
  text-align: right;
  word-break: break-all;
}

.library-empty,
.library-admin-error {
  margin-top: 20rpx;
  padding: 26rpx;
  background: #f3e8d4;
  color: #6f675f;
  font-size: 26rpx;
  line-height: 1.55;
}

.library-admin-error {
  border-color: rgba(154, 95, 85, 0.36);
  background: rgba(154, 95, 85, 0.08);
}
.language-en { word-break: normal; overflow-wrap: normal; }
.language-en .library-title, .language-en .product-title, .language-en .section-title { letter-spacing: 0; }
.language-en .admin-tab, .language-en .ledger-tab { font-size: 21rpx; }

.theme-voyage.admin-page {
  padding-top: 48rpx;
  background:
    linear-gradient(180deg, #389dd0 0, #82cee8 310rpx, transparent 620rpx),
    #dff3f8;
  color: #17334b;
}

.theme-voyage .admin-hero,
.theme-voyage .section-panel,
.theme-voyage .admin-error,
.theme-voyage .empty-state {
  border: 3rpx solid #b37c35;
  border-radius: 16rpx;
  background:
    linear-gradient(105deg, rgba(155, 102, 40, 0.06) 0 2rpx, transparent 2rpx 34rpx),
    #fff5dc;
  box-shadow: 0 9rpx 0 rgba(101, 62, 23, 0.18);
}

.theme-voyage .admin-hero {
  position: relative;
  min-height: 220rpx;
  padding-right: 146rpx;
  overflow: visible;
  border-top: 12rpx solid #c84f39;
}

.voyage-captain-badge {
  position: absolute;
  top: 30rpx;
  right: 28rpx;
  width: 82rpx;
  height: 82rpx;
  border: 4rpx double #8a5a25;
  border-radius: 50%;
  background: #1f70a8;
  color: #fff5dc;
  font-size: 48rpx;
  line-height: 80rpx;
  text-align: center;
  box-shadow: 0 6rpx 0 #174f75;
}

.theme-voyage .admin-hero .product-title,
.theme-voyage .section-title,
.theme-voyage .admin-name,
.theme-voyage .admin-error-title,
.theme-voyage .admin-simple-value {
  color: #17334b;
  font-family: "Songti SC", serif;
}

.theme-voyage .admin-hero .product-copy,
.theme-voyage .admin-activity,
.theme-voyage .admin-error-copy,
.theme-voyage .admin-simple-label {
  color: #755f45;
}

.theme-voyage .admin-total,
.theme-voyage .detail-toggle,
.theme-voyage .admin-count,
.theme-voyage .member-role {
  color: #c84f39;
}

.theme-voyage .admin-tabs {
  border: 2rpx solid #b37c35;
  border-radius: 10rpx;
  background: #f1dfb8;
}

.theme-voyage .admin-tab {
  border-radius: 7rpx;
  color: #755f45;
}

.theme-voyage .admin-tab.is-active {
  background: #1f70a8;
  color: #fff5dc;
}

.theme-voyage .admin-card {
  margin-top: 16rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(179, 124, 53, 0.4);
  border-radius: 10rpx;
  background: #f3e2bb;
}

.theme-voyage .admin-simple-row {
  border-top: 1rpx dashed rgba(179, 124, 53, 0.42);
}

.theme-voyage .admin-retry {
  border: 2rpx solid #b37c35;
  border-radius: 8rpx;
  background: #1f70a8;
  color: #fff5dc;
}

.theme-voyage .admin-skeleton view {
  border: 2rpx solid rgba(179, 124, 53, 0.3);
  border-radius: 10rpx;
  background: #f1dfb8;
}

.theme-voyage.language-en .section-head {
  align-items: stretch;
  flex-direction: column;
}

.theme-voyage.language-en .admin-tabs {
  width: 100%;
  box-sizing: border-box;
}

.theme-voyage.language-en .admin-tab {
  flex: 1;
  min-width: 0;
  text-align: center;
}
