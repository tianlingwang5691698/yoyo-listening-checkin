<template name="writing-report">
  <view class="shared-writing-report">
    <view class="shared-writing-report-head">
      <view>
        <view class="shared-writing-report-title">{{reportTitle || texts.report}}</view>
        <view class="shared-writing-report-score">{{review.score}} / {{review.totalScore || totalScore || 20}}</view>
        <view class="shared-writing-report-estimate" wx:if="{{review.estimateLabel}}">{{review.estimateLabel}}</view>
      </view>
      <view class="shared-writing-report-level">{{review.level}}</view>
    </view>
    <view class="shared-writing-report-note" wx:if="{{review.weightingNote}}">{{review.weightingNote}}</view>
    <view class="shared-writing-test-estimate" wx:if="{{review.writingTestEstimate}}">
      <view>{{review.writingTestEstimate.label}}</view>
      <view>Task 1 {{review.writingTestEstimate.task1Score}} · Task 2 {{review.writingTestEstimate.task2Score}}</view>
      <view class="shared-writing-test-score">Band {{review.writingTestEstimate.score}}</view>
    </view>
    <view class="shared-writing-report-rubric" wx:if="{{review.rubricVersion}}">{{texts.rubricLabel}}{{review.rubricVersion}}</view>
    <view class="shared-writing-report-summary" wx:if="{{review.summary}}">{{review.summary}}</view>
    <view class="shared-writing-report-notice" wx:if="{{review.feedbackNotice}}">{{review.feedbackNotice}}</view>

    <block wx:if="{{review.criterionDetails.length}}">
      <view class="shared-writing-criterion" wx:for="{{review.criterionDetails}}" wx:key="key" wx:for-item="criterion">
        <view class="shared-writing-section-title">{{criterion.label}}</view>
        <view class="shared-writing-comment" wx:if="{{criterion.comment}}">{{criterion.comment}}</view>
        <view class="shared-writing-evidence" wx:if="{{criterion.evidence.length}}">
          <view class="shared-writing-subtitle">{{texts.evidenceLabel}}</view>
          <view wx:for="{{criterion.evidence}}" wx:key="*this" wx:for-item="evidence">· {{evidence}}</view>
        </view>
        <view class="shared-writing-descriptor" wx:if="{{criterion.descriptorMatch}}"><text>{{texts.descriptorLabel}}</text>{{criterion.descriptorMatch}}</view>
        <view class="shared-writing-limiters" wx:if="{{criterion.limiters.length}}">
          <view class="shared-writing-subtitle">{{texts.limitersLabel}}</view>
          <view wx:for="{{criterion.limiters}}" wx:key="*this" wx:for-item="limiter">· {{limiter}}</view>
        </view>
        <view class="shared-writing-actions" wx:if="{{criterion.nextBandActions.length}}">
          <view class="shared-writing-subtitle">{{texts.nextBandLabel}}</view>
          <view wx:for="{{criterion.nextBandActions}}" wx:key="*this" wx:for-item="action">· {{action}}</view>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="shared-writing-criterion" wx:if="{{review.content}}">
        <view class="shared-writing-section-title">{{review.contentLabel || texts.content}}</view>
        <view>{{review.content}}</view>
      </view>
      <view class="shared-writing-criterion" wx:if="{{review.structure}}">
        <view class="shared-writing-section-title">{{review.structureLabel || texts.structure}}</view>
        <view>{{review.structure}}</view>
      </view>
      <view class="shared-writing-criterion" wx:if="{{review.language}}">
        <view class="shared-writing-section-title">{{review.languageLabel || texts.language}}</view>
        <view>{{review.language}}</view>
      </view>
      <view class="shared-writing-criterion" wx:if="{{review.spelling}}">
        <view class="shared-writing-section-title">{{review.spellingLabel || texts.spelling}}</view>
        <view>{{review.spelling}}</view>
      </view>
    </block>

    <view class="shared-writing-list" wx:if="{{review.strengths.length}}">
      <view class="shared-writing-section-title">{{texts.strengthsLabel}}</view>
      <view wx:for="{{review.strengths}}" wx:key="*this">· {{item}}</view>
    </view>
    <view class="shared-writing-list" wx:if="{{review.problems.length}}">
      <view class="shared-writing-section-title">{{texts.improvements}}</view>
      <view wx:for="{{review.problems}}" wx:key="*this">· {{item}}</view>
    </view>
    <view class="shared-writing-list" wx:if="{{review.suggestions.length}}">
      <view class="shared-writing-section-title">{{texts.advice}}</view>
      <view wx:for="{{review.suggestions}}" wx:key="*this">· {{item}}</view>
    </view>
    <view class="shared-writing-list" wx:if="{{review.grammarCorrections.length}}">
      <view class="shared-writing-section-title">{{texts.polish}}</view>
      <view class="shared-writing-correction" wx:for="{{review.grammarCorrections}}" wx:key="original">
        <view>{{texts.originalSentence}}{{item.original}}</view>
        <view class="is-revised">{{texts.revisedSentence}}{{item.corrected}}</view>
        <view class="is-reason">{{texts.reason}}{{item.reason}}</view>
      </view>
    </view>
    <view class="shared-writing-polished" wx:if="{{review.polishedVersion}}">
      <view class="shared-writing-section-title">{{review.polishedTitle || texts.rewrite}}</view>
      <view>{{review.polishedVersion}}</view>
    </view>

    <view class="shared-writing-band-panel" wx:if="{{showBandSampleActions && review.isIelts}}">
      <view class="shared-writing-section-title">{{texts.bandSampleTitle}}</view>
      <view class="shared-writing-band-copy">{{texts.bandSampleCopy}}</view>
      <view class="shared-writing-band-buttons">
        <button data-delta="1" loading="{{bandSampleGeneratingDelta === 1}}" disabled="{{bandSampleGeneratingDelta > 0}}" bindtap="generateBandSample">{{texts.bandOneButton}}</button>
        <button class="is-strong" data-delta="2" loading="{{bandSampleGeneratingDelta === 2}}" disabled="{{bandSampleGeneratingDelta > 0}}" bindtap="generateBandSample">{{texts.bandTwoButton}}</button>
      </view>
      <view class="shared-writing-report-notice" wx:if="{{bandSampleError}}">{{bandSampleError}}</view>
    </view>
    <view class="shared-writing-band-sample" wx:for="{{review.bandSamples}}" wx:key="delta" wx:for-item="sample">
      <view class="shared-writing-band-head">
        <view class="shared-writing-section-title">{{sample.title}}</view>
        <view>Band {{sample.targetBand}}</view>
      </view>
      <view>{{sample.essay}}</view>
      <view class="shared-writing-evidence" wx:if="{{sample.upgradeNotes.length}}">
        <view class="shared-writing-subtitle">{{texts.upgradesLabel}}</view>
        <view wx:for="{{sample.upgradeNotes}}" wx:key="*this" wx:for-item="note">· {{note}}</view>
      </view>
      <view class="shared-writing-target" wx:for="{{sample.criterionTargets}}" wx:key="label" wx:for-item="target">
        <view class="shared-writing-subtitle">{{target.label}}</view>
        <view wx:for="{{target.changes}}" wx:key="*this" wx:for-item="change">· {{change}}</view>
      </view>
    </view>

    <button class="shared-writing-download" data-attempt-id="{{attemptId}}" loading="{{pdfGenerating}}" disabled="{{pdfGenerating || !attemptId}}" bindtap="downloadWritingReportPdf">
      {{pdfGenerating ? texts.pdfGenerating : texts.pdfDownload}}
    </button>
  </view>
</template>
